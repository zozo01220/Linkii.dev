<Project Sdk="WixToolset.Sdk/5.0.2">
  <PropertyGroup>
    <OutputName>LinkiiPlayer-$(ProductVersion)-x64</OutputName>
    <Platform>x64</Platform>
    <InstallerPlatform>x64</InstallerPlatform>
    <!-- installation par utilisateur : les composants de fichiers sous le profil n'ont pas de clé de registre -->
    <SuppressIces>ICE38;ICE64;ICE91</SuppressIces>
    <DefineConstants>$(DefineConstants);PublishDir=$(PublishDir);ProductVersion=$(ProductVersion)</DefineConstants>
  </PropertyGroup>
</Project>
