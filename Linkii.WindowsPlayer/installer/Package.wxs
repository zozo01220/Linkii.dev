<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs">
  <!-- Linkii Player pour Windows : installation pour l'utilisateur courant (sans droits d'administrateur).
       Options en ligne de commande : SERVERURL=https://… (adresse du serveur) et AUTOSTART=1 (démarrage avec la session). -->
  <Package Name="Linkii Player" Manufacturer="Linkii" Version="$(ProductVersion)" UpgradeCode="6B3E0F52-7C0E-4A55-9C2B-1E4D6A9D8F31"
           Scope="perUser" Language="1036" InstallerVersion="500">
    <MajorUpgrade DowngradeErrorMessage="Une version plus récente de Linkii Player est déjà installée." />
    <MediaTemplate EmbedCab="yes" CompressionLevel="high" />

    <StandardDirectory Id="LocalAppDataFolder">
      <Directory Id="ProgramsSubFolder" Name="Programs">
        <Directory Id="INSTALLFOLDER" Name="Linkii Player" />
      </Directory>
    </StandardDirectory>
    <StandardDirectory Id="ProgramMenuFolder" />

    <Component Id="MainExe" Directory="INSTALLFOLDER">
      <File Id="LinkiiPlayerExe" Source="$(PublishDir)LinkiiPlayer.exe" KeyPath="yes">
        <Shortcut Id="StartMenuShortcut" Directory="ProgramMenuFolder" Name="Linkii Player" Advertise="no" WorkingDirectory="INSTALLFOLDER" />
      </File>
    </Component>

    <ComponentGroup Id="PlayerFiles" Directory="INSTALLFOLDER">
      <Files Include="$(PublishDir)**">
        <Exclude Files="$(PublishDir)LinkiiPlayer.exe" />
        <Exclude Files="$(PublishDir)*.pdb" />
      </Files>
    </ComponentGroup>

    <!-- adresse du serveur : lue par toutes les instances de la session (une adresse donnée en ligne de commande l'emporte) -->
    <Component Id="ServerUrlValue" Directory="INSTALLFOLDER" Condition="SERVERURL">
      <RegistryValue Root="HKCU" Key="Software\Linkii\Player" Name="ServerUrl" Type="string" Value="[SERVERURL]" KeyPath="yes" />
    </Component>

    <!-- démarrage avec la session pour l'instance par défaut -->
    <Component Id="AutoStartValue" Directory="INSTALLFOLDER" Condition="AUTOSTART = &quot;1&quot;">
      <RegistryValue Root="HKCU" Key="Software\Microsoft\Windows\CurrentVersion\Run" Name="LinkiiPlayer-default" Type="string"
                     Value="&quot;[INSTALLFOLDER]LinkiiPlayer.exe&quot;" KeyPath="yes" />
    </Component>

    <Feature Id="Main" Title="Linkii Player" Level="1">
      <ComponentRef Id="MainExe" />
      <ComponentGroupRef Id="PlayerFiles" />
      <ComponentRef Id="ServerUrlValue" />
      <ComponentRef Id="AutoStartValue" />
    </Feature>
  </Package>
</Wix>
