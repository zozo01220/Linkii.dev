<Project Sdk="Microsoft.NET.Sdk.Worker">
  <!-- Relais Linkii (DEV-POC.md §139, lot 4) : service Windows ou Linux installé dans le réseau du client. Il lit les bases de données et les API
       internes pour le serveur Linkii, qu'il appelle en HTTPS (connexion sortante seulement). Voir README.md. -->
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <OutputType>Exe</OutputType>
    <AssemblyName>Linkii.Relay</AssemblyName>
    <RootNamespace>Linkii.Relay</RootNamespace>
    <Version>1.2.0</Version>
    <InvariantGlobalization>false</InvariantGlobalization>
    <UserSecretsId>linkii-relay</UserSecretsId>
  </PropertyGroup>
  <ItemGroup>
    <!-- Lecture des bases et protocole : les mêmes fichiers que le serveur -->
    <Compile Include="..\Linkii.Poc\DataSql.cs" Link="Shared\DataSql.cs" />
    <Compile Include="..\Linkii.Poc\RelayProtocol.cs" Link="Shared\RelayProtocol.cs" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.Data.SqlClient" Version="5.2.2" />
    <PackageReference Include="MySqlConnector" Version="2.6.2" />
    <PackageReference Include="Npgsql" Version="8.0.5" />
    <PackageReference Include="Microsoft.Extensions.Hosting" Version="8.0.1" />
    <PackageReference Include="Microsoft.Extensions.Hosting.WindowsServices" Version="8.0.1" />
    <PackageReference Include="Microsoft.Extensions.Hosting.Systemd" Version="8.0.1" />
  </ItemGroup>
</Project>
