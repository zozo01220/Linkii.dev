# Relais Linkii comme service systemd (Linux). Copiez le dossier dans /opt/linkii-relay, appairez-le, puis :
#   sudo cp linkii-relay.service /etc/systemd/system/ && sudo systemctl enable --now linkii-relay
[Unit]
Description=Relais Linkii (lit les bases et API internes pour Linkii)
After=network-online.target
Wants=network-online.target

[Service]
Type=notify
WorkingDirectory=/opt/linkii-relay
ExecStart=/opt/linkii-relay/Linkii.Relay run
Restart=always
RestartSec=10
User=linkii-relay
NoNewPrivileges=true
ProtectSystem=strict
ReadWritePaths=/opt/linkii-relay

[Install]
WantedBy=multi-user.target
