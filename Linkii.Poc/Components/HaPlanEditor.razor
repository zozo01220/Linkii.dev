    private static string IconKey(HomeAssistantEntity? e)
    {
        if (e == null) return "alert";
        var dc = e.DeviceClass; var u = e.Unit;
        return e.Domain switch
        {
            "light" => "bulb", "switch" => "plug", "input_boolean" => "toggle", "fan" => "fan", "climate" => "thermo", "lock" => "lock",
            "cover" => dc == "window" ? "window" : dc is "door" or "garage" or "gate" ? "door" : "cover",
            "binary_sensor" => dc switch
            {
                "door" or "garage_door" or "opening" => "door", "window" => "window", "motion" => "motion", "occupancy" or "presence" => "person",
                "moisture" => "drop", "smoke" or "gas" or "problem" or "safety" => "alert", "battery" => "battery", "lock" => "lock", "plug" => "plug", "power" => "bolt", "light" => "sun",
                _ => "gauge",
            },
            _ => dc switch
            {
                "temperature" => "thermo", "humidity" or "moisture" => "drop", "power" or "energy" or "current" or "voltage" or "apparent_power" => "bolt", "battery" => "battery",
                "illuminance" or "irradiance" => "sun", "carbon_dioxide" or "pm25" or "pm10" or "aqi" or "volatile_organic_compounds" => "air",
                _ => u.EndsWith("°C") || u.EndsWith("°F") ? "thermo" : u is "W" or "kW" or "kWh" or "Wh" or "V" or "A" or "mA" ? "bolt" : u is "lx" or "lm" ? "sun" : "gauge",
            },
        };
    }

    private static MarkupString Icon(HomeAssistantEntity? e) =>
        new($"<svg class='hpe-i' viewBox='0 0 24 24' aria-hidden='true'>{Paths[IconKey(e)]}</svg>");
}
