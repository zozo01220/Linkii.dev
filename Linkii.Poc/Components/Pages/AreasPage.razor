@page "/areas"
@attribute [Microsoft.AspNetCore.Authorization.Authorize(Policy = "ClientAdmin")]
@inject TenantStore Store
@inject NavigationManager Nav
@inject Toaster Toast

<div class="page-head">
    <div>
        <h1>Aires de gestion</h1>
        <p class="sub">Chaque aire a ses écrans, ses listes de lecture, ses médias et ses membres. Ses zones classent ses écrans.</p>
    </div>
    <button class="btn" data-fab="Nouvelle aire" @onclick="OpenNew"><Ico Name="plus" Size="16" /> Nouvelle aire</button>
</div>

<table class="tbl">
    <thead><tr><th>Aire</th><th>Zones</th><th class="num ctr">Écrans</th><th class="num ctr">Listes</th><th class="num ctr">Médias</th><th>Membres</th><th></th></tr></thead>
    <tbody>
    @foreach (var r in rows)
    {
        var row = r;
        var open = expanded.Contains(row.Area.Id);
        <tr>
            <td>
                <button type="button" class="area-toggle" aria-expanded="@(open ? "true" : "false")" @onclick="() => ToggleExpanded(row.Area.Id)">
                    <span class="area-av" aria-hidden="true">@AreaInitials(row.Area.Name)</span>
                    <svg class="area-chev @(open ? "open" : "")" viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M9 6l6 6-6 6"/></svg>
                    <b>@row.Area.Name</b> @if (row.Area.Id == currentId) { <span class="pill blue">ouverte</span> }
                </button>
            </td>
            <td>@(row.Area.Zones.Count == 0 ? "—" : $"{row.Area.Zones.Count} zone{(row.Area.Zones.Count > 1 ? "s" : "")}")</td>
            <td class="num ctr">@row.Screens</td>
            <td class="num ctr">@row.Playlists</td>
            <td class="num ctr">@row.Media</td>
            <td>
                @if (row.Members.Count == 0) { <span class="muted">Administrateurs de l'organisation</span> }
                else
                {
                    <span class="avatars">
                        @foreach (var m in row.Members.Take(4)) { <span class="avatar" title="@m.Label (@LevelName(m))">@Initials(m)</span> }
                        <small class="muted">@row.Members.Count membre@(row.Members.Count > 1 ? "s" : "")</small>
                    </span>
                }
            </td>
            <td @onclick:stopPropagation="true">
                <div class="kebab">
                    <button type="button" class="kebab-btn" aria-label="Actions pour @row.Area.Name" aria-haspopup="menu" aria-expanded="@(menuFor == row.Area.Id ? "true" : "false")" @onclick="() => menuFor = menuFor == row.Area.Id ? null : row.Area.Id"><Ico Name="dots-v" Size="18" /></button>
                    @if (menuFor == row.Area.Id)
                    {
                        <div class="kebab-backdrop" @onclick="() => menuFor = null"></div>
                        <div class="kebab-menu" role="menu">
                            <button type="button" role="menuitem" @onclick="() => Open(row.Area)"><Ico Name="monitor" Size="16" /> Ouvrir ses écrans</button>
                            <button type="button" role="menuitem" @onclick="() => OpenEdit(row)"><Ico Name="edit" Size="16" /> Renommer, zones</button>
                            <a role="menuitem" href="/members"><Ico Name="users" Size="16" /> Membres</a>
                            <button type="button" role="menuitem" class="danger" @onclick="() => { menuFor = null; deleting = row; deleteError = null; }"><Ico Name="trash" Size="16" /> Supprimer</button>
                        </div>
                    }
                </div>
            </td>
        </tr>
        @if (open)
        {
            <tr class="area-det">
                <td colspan="7">
                    <ul class="zlist-det">
                        @foreach (var z in OrderedZones(row.Area))
                        {
                            var n = row.ZoneScreens.GetValueOrDefault(z.Id);
                            <li>
                                <span class="zd-name">@z.Name@if (z.IsDefault) { <small>zone par défaut</small> }</span>
                                <span class="zd-cnt">@n écran@(n > 1 ? "s" : "")</span>
                                <span class="zd-sy">
                                    @if (z.IsWall)
                                    {
                                        <span class="badge sync">Mur @z.WallCols × @z.WallRows</span>
                                        <span class="sm">Synchro toujours active</span>
                                    }
                                    else
                                    {
                                        <span class="badge neutre">Zone libre</span>
                                        @if (z.Sync) { <span class="sm on">Synchronisée</span> }
                                    }
                                </span>
                            </li>
                        }
                    </ul>
                    <div class="zd-foot">
                        <span class="hint">Les zones se modifient dans la fenêtre de l'aire.</span>
                        <button type="button" class="btn" @onclick="() => OpenEdit(row)">Gérer l'aire</button>
                    </div>
                </td>
            </tr>
        }
    }
    </tbody>
</table>
<p class="hint" style="margin-top:12px">Les administrateurs de l'organisation voient toutes les aires. Pour donner accès à une aire, créez un niveau de droits dans <a href="/members">Membres</a>, puis donnez-le à une personne.</p>

@if (creating)
{
    <div class="modal-backdrop" @onclick="() => creating = false"></div>
    <div class="modal app-modal sm" role="dialog" aria-modal="true" aria-labelledby="na-title">
        <div class="modal-head">
            <div class="grow"><h3 id="na-title">Nouvelle aire de gestion</h3></div>
            <button type="button" class="modal-x" aria-label="Fermer" @onclick="() => creating = false"><Ico Name="x" Size="20" /></button>
        </div>
        <EditForm Model="this" OnSubmit="Create" class="modal-form">
            <div class="modal-body">
                <label class="lbl" for="na-name" style="margin-top:0">Nom</label>
                <input id="na-name" class="full" maxlength="60" @bind="newName" @bind:event="oninput" placeholder="Ex. : Site de Genève, Bâtiment B" />
                <p class="hint" style="margin:12px 0 0">L'aire démarre vide : connectez-y des écrans, créez-y des listes de lecture et des médias, ou déplacez-en depuis une autre aire.</p>
                @if (formError != null) { <div class="err">@formError</div> }
            </div>
            <div class="modal-foot">
                <button type="button" class="btn ghost" @onclick="() => creating = false">Annuler</button>
                <button type="submit" class="btn">Créer l'aire</button>
            </div>
        </EditForm>
    </div>
}

@if (editing is { } ed)
{
    <div class="modal-backdrop" @onclick="CloseEdit"></div>
    <div class="modal app-modal area-dlg" role="dialog" aria-modal="true" aria-labelledby="ea-title">
        <div class="modal-head">
            <div class="grow">
                <h3 id="ea-title">Aire « @ed.Area.Name » @if (ed.Area.Id == currentId) { <span class="pill blue">ouverte</span> }</h3>
                <small class="hint">@Pl(ed.Screens, "écran", "écrans") · @Pl(ed.Playlists, "liste de lecture", "listes de lecture") · @Pl(ed.Media, "média", "médias") · @Pl(ed.Members.Count, "membre", "membres")</small>
            </div>
            <button type="button" class="modal-x" aria-label="Fermer" @onclick="CloseEdit"><Ico Name="x" Size="20" /></button>
        </div>
        <div class="modal-body">
            <label class="lbl" for="ea-name" style="margin-top:0">Nom</label>
            <div class="row" style="flex-wrap:nowrap"><input id="ea-name" class="full" maxlength="60" @bind="editName" @bind:event="oninput" @onkeydown="OnRenameKey" /><button type="button" class="btn ghost" @onclick="Rename">Renommer</button></div>
            <label class="lbl">Zones <small>(elles classent les écrans de l'aire, sans effet sur les droits)</small></label>
            <AreaZones AreaId="ed.Area.Id" OnChanged="Load" />
            @if (sleepOn)
            {
                <label class="lbl">Mise en veille <small>(plages et fuseau de l'aire)</small></label>
                <AreaSleep AreaId="ed.Area.Id" />
            }
            @if (dimOn)
            {
                <label class="lbl">Luminosité et contraste <small>(écrans Android, selon l'heure)</small></label>
                <AreaDim AreaId="ed.Area.Id" />
            }
            @if (formError != null) { <div class="err">@formError</div> }
        </div>
        <div class="modal-foot">
            <button type="button" class="btn danger" @onclick="() => { deleting = ed; deleteError = null; }">Supprimer l'aire</button>
            <span class="grow"></span>
            <button type="button" class="btn" @onclick="CloseEdit">Fermer</button>
        </div>
    </div>
}

@if (deleting is { } del)
{
    <div class="modal-backdrop" @onclick="() => deleting = null"></div>
    <div class="modal" role="alertdialog" aria-modal="true" aria-labelledby="da-title">
        <h3 id="da-title">Supprimer l'aire « @del.Area.Name » ?</h3>
        <p class="hint">Une aire ne se supprime que vide. Ses zones disparaissent, et ses membres perdent cet accès.</p>
        @if (deleteError != null) { <div class="err">@deleteError</div> }
        <div class="modal-actions">
            <button class="btn ghost" @onclick="() => deleting = null">Annuler</button>
            <button class="btn danger-solid" @onclick="Delete">Supprimer</button>
        </div>
    </div>
}

@code {
    private record Row(Area Area, int Screens, int Playlists, int Media, List<User> Members, Dictionary<Guid, int> ZoneScreens);
    private List<Row> rows = new();
    private List<AccessLevel> levels = new();
    private HashSet<Guid> expanded = new();
    private Guid? currentId, menuFor;
    private bool creating, sleepOn, dimOn;
    private string newName = "", editName = "";
    private string? formError, deleteError;
    private Row? editing, deleting;

    [SupplyParameterFromQuery(Name = "created")] public string? Created { get; set; }
    [SupplyParameterFromQuery(Name = "deleted")] public string? Deleted { get; set; }

    protected override void OnInitialized()
    {
        if (Created != null) Toast.Ok($"Aire « {Created} » créée.");
        if (Deleted != null) Toast.Ok($"Aire « {Deleted} » supprimée.");
        (sleepOn, dimOn) = Store.Read(d => (d.Tenant.SleepEnabled, d.Tenant.DimEnabled));
        Load();
    }

    private void Load()
    {
        (rows, levels, currentId) = Store.Read(d =>
        {
            var users = d.Users.ToList();
            var screens = d.Root.Screens.Where(s => s.ClientId == d.ClientId && s.Token != null).ToList();
            var list = d.Areas.OrderBy(a => a.CreatedUtc).ToList().Select(a =>
            {
                var (s, p, m) = AreaOps.Contents(d, a.Id);
                var zoneScreens = screens.Where(x => x.AreaId == a.Id && x.ZoneId != null).GroupBy(x => x.ZoneId!.Value).ToDictionary(g => g.Key, g => g.Count());
                return new Row(a, s, p, m, users.Where(u => u.Role == Roles.ClientMember && d.Tenant.Levels.FirstOrDefault(l => l.Id == u.LevelId) is { } l && AccessLevels.Reaches(l, a, screens)).ToList(), zoneScreens);
            }).ToList();
            return (list, d.Tenant.Levels.ToList(), d.Area?.Id);
        });
        if (editing != null) editing = rows.FirstOrDefault(r => r.Area.Id == editing.Area.Id);
    }

    private static string Pl(int n, string one, string many) => $"{n} {(n == 1 ? one : many)}";

    private void ToggleExpanded(Guid id) { if (!expanded.Add(id)) expanded.Remove(id); }

    // zone par défaut d'abord, puis les autres par nom
    private static List<Zone> OrderedZones(Area a) => a.Zones.OrderByDescending(z => z.IsDefault).ThenBy(z => z.Name, StringComparer.CurrentCultureIgnoreCase).ToList();

    // deux premières lettres des deux premiers mots (« Site de Genève » → « SG »), ou deux lettres pour un seul mot
    private static string AreaInitials(string name)
    {
        var words = name.Split(' ', StringSplitOptions.RemoveEmptyEntries);
        var s = words.Length >= 2 ? string.Concat(words.Take(2).Select(w => w[0])) : words.Length == 1 ? words[0][..Math.Min(2, words[0].Length)] : "?";
        return s.ToUpperInvariant();
    }

    private static string Initials(User u) => string.Concat(u.Label.Split(' ', '.', '@').Where(w => w.Length > 0).Take(2).Select(w => char.ToUpperInvariant(w[0])));

    private string LevelName(User u) => levels.FirstOrDefault(l => l.Id == u.LevelId)?.Name ?? "Aucun niveau";

    private void OpenNew() { formError = null; newName = ""; creating = true; }

    private void Create()
    {
        var name = newName;
        Area? created = null;
        formError = Store.Write(d =>
        {
            var (a, err) = AreaOps.Create(d, name);
            if (a == null) return err;
            created = a;
            return null;
        });
        if (formError != null) return;
        creating = false;
        Nav.NavigateTo("/areas?created=" + Uri.EscapeDataString(created!.Name), forceLoad: true);   // le menu affiche le sélecteur d'aire dès la deuxième
    }

    private void OpenEdit(Row r) { menuFor = null; formError = null; editing = r; editName = r.Area.Name; }

    private void CloseEdit() { editing = null; Nav.NavigateTo("/areas", forceLoad: true); }   // le sélecteur d'aire du menu se met à jour

    private void Rename()
    {
        if (editing is not { } ed) return;
        var n = editName;
        formError = Store.Write(d => AreaOps.Rename(d, ed.Area.Id, n));
        if (formError == null) Toast.Ok($"Aire renommée en « {n.Trim()} ».");
        Load();
    }

    private void OnRenameKey(KeyboardEventArgs e) { if (e.Key == "Enter") Rename(); }

    private void Open(Area a)
    {
        menuFor = null;
        if (Store.SwitchArea(a.Id)) Nav.NavigateTo("/", forceLoad: true);
    }

    private void Delete()
    {
        if (deleting is not { } del) return;
        deleteError = Store.Write(d => AreaOps.Delete(d, del.Area.Id));
        if (deleteError != null) return;
        deleting = null;
        Nav.NavigateTo("/areas?deleted=" + Uri.EscapeDataString(del.Area.Name), forceLoad: true);
    }
}
