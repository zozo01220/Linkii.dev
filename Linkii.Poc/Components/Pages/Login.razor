@page "/login"
@layout AuthLayout
@inject JsonStore Store
@inject NavigationManager Nav
@inject Mailer Mail
@inject ExternalLogin Sso
@inject IWebHostEnvironment Env
@inject ILogger<Login> Log

<PageTitle>@(Host?.DisplayName ?? "Linkivi") · @(signup ? "Créer un espace" : "Connexion")</PageTitle>

@if (Host == null || !Host.Active)
{
    <h1>Service suspendu</h1>
    <p class="lead">Ce service est momentanément indisponible. Contactez votre administrateur.</p>
}
else
{
    @* Page en deux parties : connexion par e-mail à gauche, connexion rapide (Microsoft, Google, LinkedIn, GitHub) dans un panneau à droite.
       La création d'un espace s'ouvre dans une fenêtre par-dessus (?signup=1) ; on la ferme en revenant sur /login. *@
    var anySso = ShowGoogle || ShowMicrosoft || ShowLinkedIn || ShowGitHub;
    <div class="auth-split @(anySso ? "with-side" : "")" inert="@signup">
        <div class="split-main">
            <h1>Bon retour</h1>
            <p class="lead">Connectez-vous à votre espace @Host.DisplayName.</p>
            @if (ssoError != null && !signup) { <div class="err">@ssoError</div> }

            <EditForm Model="Credentials" FormName="login" OnValidSubmit="DoLogin" method="post" class="auth-form">
                <label>E-mail</label>
                <InputText @bind-Value="Credentials!.Email" type="email" placeholder="vous@organisation.ch" autocomplete="username" />
                <label>Mot de passe</label>
                <InputText @bind-Value="Credentials.Password" type="password" autocomplete="current-password" />
                @if (error != null && !signup) { <div class="err">@error</div> }
                <button class="btn" type="submit">Se connecter</button>
            </EditForm>
            @if (Host.AllowsSignupWith(SignupSources.Email))
            {
                <p class="auth-alt left">Pas encore d'espace ? <a href="/login?signup=1@(trialCode != null ? "&code=" + Uri.EscapeDataString(trialCode) : "")">Créer un espace</a></p>
            }
        </div>
        @if (anySso)
        {
            <aside class="split-side" aria-label="Connexion rapide">
                <h2>Connexion rapide</h2>
                <p>@(Host.AllowsSignup ? "Connectez-vous avec un compte que vous avez déjà. Pas encore d'espace ? Il est créé en une étape." : "Connectez-vous avec un compte que vous avez déjà.")</p>
                <SsoButtons Mode="login" WithGoogle="@ShowGoogle" WithMicrosoft="@ShowMicrosoft" WithLinkedIn="@ShowLinkedIn" WithGitHub="@ShowGitHub" />
            </aside>
        }
    </div>

    @if (signup)
    {
        <a class="auth-modal-backdrop" href="/login" aria-label="Fermer" tabindex="-1"></a>
        <div class="auth-modal" role="dialog" aria-modal="true" aria-labelledby="signup-title">
            <a class="auth-close modal-x" href="/login" aria-label="Fermer"><Ico Name="x" Size="20" /></a>
            @if (ticket != null)
            {
                @* Retour de Microsoft / Google / LinkedIn / GitHub : l'adresse est prouvée, il ne manque que l'organisation et les consentements. *@
                <h1 id="signup-title">Dernière étape</h1>
                <p class="lead">Nommez votre organisation pour créer votre espace.</p>

                <div class="sso-who">
                    <ProviderLogo Provider="@ticket.Identity.Provider" />
                    <div class="grow"><b>@(ticket.Identity.Name is { Length: > 0 } n ? n : ticket.Identity.Email)</b><small>@ticket.Identity.Email</small></div>
                    <span class="pill ok">Adresse vérifiée</span>
                </div>

                <EditForm Model="SsoSignup" FormName="signup-sso" OnSubmit="DoSsoSignup" method="post" class="auth-form" id="signup-form">
                    <div class="auth-cols">
                        <div><label>Organisation</label><InputText @bind-Value="SsoSignup!.Organisation" placeholder="Ex. : Horizon SA" autofocus /></div>
                        <div><label>Votre nom</label><InputText @bind-Value="SsoSignup.Name" placeholder="Prénom Nom" /></div>
                    </div>
                    <div class="mode-pick">
                        <span class="lbl">Mode d'utilisation</span>
                        <InputRadioGroup @bind-Value="SsoSignup.Mode">
                            <label><InputRadio Value="@("simple")" /> Simple</label>
                            <label><InputRadio Value="@("expert")" /> Expert</label>
                        </InputRadioGroup>
                        <small>Simple par défaut. Expert ajoute planning, aires, membres, intégrations et widgets ; vous pourrez changer plus tard.</small>
                    </div>
                    <ConsentSwitches Model="SsoSignup!" Prefix="SsoSignup" />
                    @if (error != null) { <div class="err">@error</div> }
                    <button class="btn" type="submit" data-needs-terms>Créer mon espace</button>
                </EditForm>
                <p class="auth-alt"><a href="/login" data-enhance-nav="false">Utiliser un autre compte</a></p>
            }
            else
            {
                <div class="auth-modal-head">
                    <h1 id="signup-title">Créez votre espace</h1>
                    <span class="trial-tag">Essai gratuit · @trialDays jours · sans carte bancaire</span>
                </div>
                <p class="hint" style="margin:-4px 0 12px">Toutes les fonctions pendant l'essai. Sans plan choisi ensuite, vos contenus sont conservés @retentionDays jours puis supprimés ; nous vous préviendrons par e-mail avant chaque étape.</p>

                @if (ssoError != null) { <div class="err">@ssoError</div> }

                <EditForm Model="EmailSignup" FormName="signup" OnSubmit="DoSignup" method="post" class="auth-form" id="signup-form">
                    <div class="auth-cols">
                        <div><label>Organisation</label><InputText @bind-Value="EmailSignup!.Organisation" placeholder="Ex. : Horizon SA" autofocus /></div>
                        <div><label>Votre nom</label><InputText @bind-Value="EmailSignup.Name" placeholder="Prénom Nom" /></div>
                        <div class="span-2"><label>E-mail professionnel</label><InputText @bind-Value="EmailSignup.Email" type="email" placeholder="vous@organisation.ch" autocomplete="username" /></div>
                        <div><label>Mot de passe <small>(8 car. min.)</small></label><InputText @bind-Value="EmailSignup.Password" type="password" autocomplete="new-password" minlength="8" data-pwd /></div>
                        <div><label>Confirmation</label><InputText @bind-Value="EmailSignup.PasswordConfirm" type="password" autocomplete="new-password" data-pwd-confirm aria-describedby="pwd-match" /></div>
                        <small class="pwd-match span-2" id="pwd-match" aria-live="polite"></small>
                    </div>
                    <div class="mode-pick">
                        <span class="lbl">Mode d'utilisation</span>
                        <InputRadioGroup @bind-Value="EmailSignup.Mode">
                            <label><InputRadio Value="@("simple")" /> Simple</label>
                            <label><InputRadio Value="@("expert")" /> Expert</label>
                        </InputRadioGroup>
                        <small>Simple par défaut. Expert ajoute planning, aires, membres, intégrations et widgets ; vous pourrez changer plus tard.</small>
                    </div>
                    <ConsentSwitches Model="EmailSignup!" Prefix="EmailSignup" />
                    @if (error != null) { <div class="err">@error</div> }
                    <button class="btn" type="submit" data-needs-terms>Créer mon espace</button>
                    <p class="terms-hint">Acceptez les conditions générales pour continuer.</p>
                </EditForm>
                <p class="auth-alt"><a href="/login">J'ai déjà un compte</a></p>
            }
        </div>
        <TermsDialog />
    }
}

@code {
    [CascadingParameter] private HttpContext? Http { get; set; }
    [SupplyParameterFromForm(FormName = "login")] private LoginModel? Credentials { get; set; }
    [SupplyParameterFromForm(FormName = "signup")] private SignupModel? EmailSignup { get; set; }
    [SupplyParameterFromForm(FormName = "signup-sso")] private SignupModel? SsoSignup { get; set; }
    [SupplyParameterFromQuery(Name = "signup")] private string? SignupQuery { get; set; }
    [SupplyParameterFromQuery(Name = "ext")] private string? Ext { get; set; }
    [SupplyParameterFromQuery(Name = "sso")] private string? SsoQuery { get; set; }
    [SupplyParameterFromQuery(Name = "p")] private string? ProviderQuery { get; set; }
    [SupplyParameterFromQuery(Name = "why")] private string? WhyQuery { get; set; }

    private Reseller? Host => Http?.Items["reseller"] as Reseller;
    // La fenêtre de création s'ouvre si le revendeur propose l'inscription par e-mail, ou pour la dernière étape d'une inscription par un fournisseur qu'il propose.
    private bool signup => SignupQuery != null && Host is { Active: true } h && (h.AllowsSignupWith(SignupSources.Email) || Ext != null && h.AllowsSignup);
    [SupplyParameterFromQuery(Name = "code")] private string? CodeQuery { get; set; }
    private ExternalLogin.Ticket? ticket;
    private string? error, ssoError;
    private int trialDays, retentionDays;
    // Code d'essai (lien ?code=…) : gardé dans un cookie pour survivre au passage par Microsoft / Google
    private string? trialCode;
    private const string CodeCookie = "lk_trial_code";

    // Boutons Microsoft / Google : proposés quand l'application OAuth de la plateforme est configurée (toujours en développement, pour essayer l'écran).
    // Un fournisseur est proposé s'il est configuré sur la plateforme ET que le revendeur l'offre à l'inscription, ou que des personnes de ce revendeur
    // se connectent déjà avec lui : le désactiver ne ferme l'inscription qu'aux nouveaux, personne n'est enfermé dehors.
    private HashSet<string> usedProviders = new();
    private bool Offered(string p) => (Sso.IsConfigured(p) || Env.IsDevelopment()) && Host is { } h && (h.AllowsSignupWith(p) || usedProviders.Contains(p));
    private bool ShowGoogle => Offered(SignupSources.Google);
    private bool ShowMicrosoft => Offered(SignupSources.Microsoft);
    private bool ShowLinkedIn => Offered(SignupSources.LinkedIn);
    private bool ShowGitHub => Offered(SignupSources.GitHub);

    public class LoginModel
    {
        public string Email { get; set; } = "";
        public string Password { get; set; } = "";
    }

    public class SignupModel
    {
        public string Organisation { get; set; } = "";
        public string Name { get; set; } = "";
        public string Email { get; set; } = "";
        public string Password { get; set; } = "";
        public string PasswordConfirm { get; set; } = "";
        public bool Terms { get; set; }
        public bool Marketing { get; set; }
        public bool News { get; set; }
        /// <summary>« simple » (par défaut) ou « expert ».</summary>
        public string Mode { get; set; } = "simple";
    }

    protected override void OnInitialized()
    {
        Credentials ??= new();
        EmailSignup ??= new();
        if (Http?.User.Identity?.IsAuthenticated == true) { Nav.NavigateTo(Claims.Home(Http.User), forceLoad: true); return; }
        var code = CodeQuery ?? Http?.Request.Cookies[CodeCookie];
        trialCode = Store.Read(d => Billing.FindCode(d, code)?.Code);
        if (trialCode != null && CodeQuery != null && Http is { Response.HasStarted: false })
            Http.Response.Cookies.Append(CodeCookie, trialCode, new() { MaxAge = TimeSpan.FromDays(7), HttpOnly = true, SameSite = SameSiteMode.Lax, IsEssential = true });
        (trialDays, retentionDays) = Store.Read(d => (Billing.TrialDaysFor(d, trialCode), Math.Max(1, d.Platform.RetentionDays)));
        if (Host is { } hh) usedProviders = Store.Read(d => d.Users.Where(u => u.ResellerId == hh.Id && u.ExternalProvider != null).Select(u => u.ExternalProvider!).ToHashSet());
        if (signup && Ext != null)
        {
            ticket = Sso.Peek(Ext);   // connexion ou inscription : les mêmes boutons servent aux deux
            if (ticket == null) ssoError = "La connexion a expiré. Recommencez.";
            else if (SsoSignup == null)
            {
                SsoSignup = new() { Name = ticket.Identity.Name, Organisation = OrgFromDomain(ticket.Identity.Email) };
            }
        }
        SsoSignup ??= new();
        var provider = SignupSources.Label(ProviderQuery is SignupSources.Google or SignupSources.Microsoft or SignupSources.LinkedIn or SignupSources.GitHub ? ProviderQuery : null);
        provider = provider == SignupSources.Label(null) ? "ce fournisseur" : provider;
        ssoError ??= SsoQuery switch
        {
            null => null,
            "denied" => "Connexion annulée.",
            "refused" => $"{provider} a refusé la connexion" + (string.IsNullOrWhiteSpace(WhyQuery) ? "." : $" ({WhyQuery})."),
            "noemail" => $"{provider} n'a pas transmis d'adresse e-mail vérifiée. Utilisez votre e-mail.",
            "expired" => "La connexion a expiré. Recommencez.",
            "nolink" => $"Aucun espace n'est associé à ce compte {provider}. Demandez une invitation à votre administrateur ou connectez-vous avec votre e-mail.",   // inscription libre fermée
            "taken" => "Cette adresse a déjà un espace : connectez-vous avec votre e-mail et votre mot de passe.",
            "suspended" => "Cet espace est suspendu. Contactez votre revendeur.",
            "unconfigured" => "Cette connexion n'est pas encore disponible sur ce serveur. Utilisez votre e-mail.",
            _ => $"La connexion avec {provider} a échoué. Réessayez."
        };
    }

    /// <summary>« marie@horizon-sa.ch » → « Horizon Sa » (suggestion modifiable) ; rien pour une messagerie grand public.</summary>
    private static string OrgFromDomain(string email)
    {
        var domain = email.Split('@').LastOrDefault() ?? "";
        var label = domain.Split('.').FirstOrDefault() ?? "";
        if (label is "gmail" or "googlemail" or "outlook" or "hotmail" or "live" or "msn" or "yahoo" or "icloud" or "me" or "bluewin" or "gmx" or "protonmail" or "proton") return "";
        return string.Join(' ', label.Split('-', StringSplitOptions.RemoveEmptyEntries).Select(w => char.ToUpperInvariant(w[0]) + w[1..]));
    }

    private Consents ConsentsOf(SignupModel m) => new(m.Terms, m.Marketing, m.News);

    private async Task DoSignup()
    {
        error = null;
        var m = EmailSignup!;
        if (Host?.AllowsSignupWith(SignupSources.Email) != true) { error = "La création d'un espace par e-mail n'est pas proposée ici."; return; }
        if (string.IsNullOrWhiteSpace(m.Organisation) || string.IsNullOrWhiteSpace(m.Email)) { error = "Organisation et e-mail obligatoires."; return; }
        if (m.Password != m.PasswordConfirm) { error = "Les deux mots de passe ne correspondent pas."; m.Password = m.PasswordConfirm = ""; return; }
        var now = DateTime.UtcNow;
        var (client, admin, token, err) = Store.Write(d => Signup.Create(d, Host!, m.Organisation, m.Name, m.Email, m.Password, null, ConsentsOf(m), now, m.Mode == "expert", trialCode));
        if (client == null) { error = err; return; }
        var link = $"{Http!.Request.Scheme}://{Http.Request.Host}/login/verify/confirm?t={Uri.EscapeDataString(token!)}";
        var mailErr = await Mail.SendVerification(Host!, link, admin!.Name, admin.Email, client.Name, Store.Read(d => d.Platform.VerifyLinkHours));
        if (mailErr != null) Log.LogWarning("Lien de confirmation non envoyé à {Email} : {Error}", admin.Email, mailErr);
        else await SendWelcome(client, admin, pending: true);
        Nav.NavigateTo(await SessionCookie.SignIn(Http, Store, admin.Id) + (mailErr != null ? "?mail=failed" : ""), forceLoad: true);
    }

    /// <summary>E-mail de bienvenue de l'administrateur, une seule fois par compte. pending : adresse pas encore confirmée (inscription par e-mail).</summary>
    private async Task SendWelcome(Tenant client, User admin, bool pending)
    {
        var mailErr = await Mail.SendSignupWelcome(Host!, $"{Http!.Request.Scheme}://{Http.Request.Host}/", admin.Name, admin.Email, client.Name,
            Store.Read(d => Signup.TrialDaysOf(d, client)), client.TrialEndsUtc is { } end ? Signup.Day(client, end) : null, Signup.SignInHint(admin), pending,
            Store.Read(d => Lifecycle.WelcomeDeleteNote(d, client)));
        if (mailErr != null) { Log.LogWarning("E-mail de bienvenue non envoyé à {Email} : {Error}", admin.Email, mailErr); return; }
        Store.Write(d => { if (d.Users.FirstOrDefault(u => u.Id == admin.Id) is { } u) u.WelcomeSentUtc = DateTime.UtcNow; });
    }

    private async Task DoSsoSignup()
    {
        error = null;
        var m = SsoSignup!;
        if (ticket == null) { error = "La connexion a expiré. Recommencez."; return; }
        if (Host?.AllowsSignupWith(ticket.Identity.Provider) != true) { error = "La création d'un espace avec ce compte n'est pas proposée ici."; return; }
        if (string.IsNullOrWhiteSpace(m.Organisation)) { error = "Le nom de l'organisation est obligatoire."; return; }
        var now = DateTime.UtcNow;
        var id = ticket.Identity;
        var (client, admin, _, err) = Store.Write(d => Signup.Create(d, Host!, m.Organisation, string.IsNullOrWhiteSpace(m.Name) ? id.Name : m.Name, id.Email, null, id, ConsentsOf(m), now, m.Mode == "expert", trialCode));
        if (client == null) { error = err; return; }
        if (admin == null || Http == null) { error = "Connexion impossible. Réessayez."; return; }
        Sso.Consume(Ext);
        await SendWelcome(client, admin!, pending: false);
        await SessionCookie.SignIn(Http, Store, admin.Id);
        Nav.NavigateTo("/login/verify/done", forceLoad: true);
    }

    private async Task DoLogin()
    {
        error = null;
        var host = Host!;
        var email = Credentials!.Email.Trim().ToLowerInvariant();
        var pwd = Credentials.Password;
        var (userId, result) = Store.Read(d =>
        {
            var u = d.Users.FirstOrDefault(x => x.Email == email && Tenancy.HostAllows(x, host));
            if (u is { Disabled: false, HasPassword: false, ExternalProvider: { } p })
                return ((Guid?)null, (string?)$"Ce compte se connecte avec le bouton « Continuer avec {SignupSources.Label(p)} ».");
            // Un mot de passe copié depuis un e-mail traîne souvent un espace ou un retour à la ligne : on accepte aussi la version nettoyée.
            if (u == null || u.Disabled || !(Passwords.Verify(u.PasswordHash, pwd) || pwd.Trim() != pwd && Passwords.Verify(u.PasswordHash, pwd.Trim()))) return (null, "E-mail ou mot de passe incorrect.");
            if (u.ClientId != null && d.Clients.FirstOrDefault(c => c.Id == u.ClientId) is not { Blocked: false }) return (null, "Cet espace est bloqué. Contactez votre revendeur.");
            return (u.Id, (string?)null);
        });
        if (result != null) { error = result; return; }
        Nav.NavigateTo(await SessionCookie.SignIn(Http!, Store, userId!.Value), forceLoad: true);   // adresse à confirmer, mot de passe provisoire, ou accueil
    }
}
