@page "/stats"
@attribute [Microsoft.AspNetCore.Authorization.Authorize(Policy = "ClientSpace")]
@implements IDisposable
@inject TenantStore Store
@inject PlayLog PlayLog
@inject ScanLog ScanLog
@inject AdLog AdLog

@* Statistiques (mode expert). Maquette validée : maquettes/statistiques.html. Plan Essential : seule la vue d'ensemble est ouverte, les autres onglets sont verrouillés. *@
<div class="page-head">
    <div>
        <h1>Statistiques</h1>
        <p class="sub">Ce que diffusent vos écrans, et s'ils sont bien en ligne.</p>
    </div>
    <div class="seg" role="group" aria-label="Période">
        @foreach (var (key, label) in Periods)
        {
            var k = key;
            <button type="button" class="@(period == k ? "on" : "")" @onclick="() => { period = k; Load(); }">@label</button>
        }
    </div>
</div>

<div class="tabs" role="tablist">
    @foreach (var (key, label) in Tabs)
    {
        var k = key;
        <button type="button" role="tab" class="@(tab == k ? "on" : "")" aria-selected="@(tab == k ? "true" : "false")" @onclick="() => tab = k">
            @label
            @if (k != "vue" && !growth) { <span class="badge neutre"><Ico Name="lock" Size="12" /> Pro</span> }
        </button>
    }
</div>

@if (!growth && tab != "vue")
{
    <section class="card empty">
        <div class="big"><Ico Name="lock" Size="18" /> Disponible avec le plan Pro</div>
        <p>Comptez les scans de vos QR codes : combien de personnes scannent, et combien de visiteurs distincts par jour.</p>
    </section>
}
else if (tab == "vue")
{
    <div class="stats">
        <div class="stat"><div class="n">@allPlays.Count.ToString("N0", Fr)</div><div class="l">Passages diffusés</div></div>
        <div class="stat"><div class="n">@Human(allPlays.Sum(p => p.Seconds))</div><div class="l">Temps d'affichage</div></div>
        <div class="stat"><div class="n ok">@online<small> / @screens.Count</small></div><div class="l">Écrans en ligne</div></div>
        <div class="stat"><div class="n @(offline > 0 ? "bad" : "")">@offline</div><div class="l">Hors ligne maintenant</div></div>
    </div>

    <div class="st-grid">
        <section class="card">
            <h3>Passages @(period == "today" ? "par heure" : "par jour")</h3>
            <StatBars Data="buckets" Label="Passages" />
        </section>
        <section class="card">
            <h3>Contenus les plus diffusés</h3>
            @if (topRows.Count == 0) { <p class="hint">Aucune diffusion sur cette période.</p> }
            else
            {
                <table class="tbl st-tbl">
                    <thead><tr><th>Contenu</th><th class="num">Passages</th></tr></thead>
                    <tbody>
                    @foreach (var c in topRows.Take(5))
                    {
                        <tr><td><b>@c.Name</b></td><td class="num">@c.Count</td></tr>
                    }
                    </tbody>
                </table>
            }
        </section>
    </div>
}
else if (tab == "diff")
{
    <section class="card">
        <header>
            <h3>Diffusion par contenu</h3>
            <small>passages, temps d'affichage et part de la diffusion</small>
            <span class="sp"></span>
            <select @bind="screenFilter" @bind:after="Load" aria-label="Écran">
                <option value="">Tous les écrans</option>
                @foreach (var s in screens) { <option value="@s.Id">@s.Name</option> }
            </select>
        </header>
        @if (rows.Count == 0)
        {
            <p class="hint" style="padding:14px 18px">Aucune diffusion enregistrée sur cette période. Les écrans envoient leur historique chaque minute ; un écran hors ligne l'envoie à son retour.</p>
        }
        else
        {
            var total = Math.Max(1, rows.Sum(c => c.Seconds));
            <table class="tbl st-tbl">
                <thead><tr><th>Contenu</th><th>Type</th><th class="num">Passages</th><th class="num">Temps</th><th>Part</th></tr></thead>
                <tbody>
                @foreach (var c in rows)
                {
                    <tr>
                        <td><span class="st-content"><AppIcon Id="@c.AppId" Small="true" /> <b>@c.Name</b></span></td>
                        <td>@c.Type</td>
                        <td class="num">@c.Count</td>
                        <td class="num">@Human(c.Seconds)</td>
                        <td><div class="st-bar" style="min-width:120px"><span style="width:@Math.Max(3, c.Seconds * 100 / total)%"></span></div></td>
                    </tr>
                }
                </tbody>
            </table>
        }
    </section>
    <p class="hint">Un passage est un contenu affiché en entier. Une veille, une coupure ou une pause réduit le temps compté.</p>
}
else if (tab == "ecr")
{
    <section class="card">
        <header><h3>Écrans</h3><small>état actuel</small></header>
        @if (screens.Count == 0) { <p class="hint" style="padding:14px 18px">Aucun écran connecté pour l'instant.</p> }
        else
        {
            <table class="tbl st-tbl">
                <thead><tr><th>Écran</th><th>Aire</th><th>État</th><th>Liste de lecture</th><th class="num">Passages</th><th>Dernier contact</th><th>Publié</th></tr></thead>
                <tbody>
                @foreach (var s in screens)
                {
                    var st = Status(s);
                    <tr>
                        <td><b>@s.Name</b></td>
                        <td>@(areaNames.GetValueOrDefault(s.AreaId) ?? "—")</td>
                        <td><span class="badge @(st == "En ligne" ? "en-ligne" : st == "Mise à jour" ? "mise-a-jour" : "hors-ligne")">@st</span></td>
                        <td>@(string.Join(" · ", s.ZonePlaylists().OfType<Guid>().Select(id => playlistNames.GetValueOrDefault(id)).OfType<string>()) is { Length: > 0 } names ? names : "—")</td>
                        <td class="num">@playsByScreen.GetValueOrDefault(s.Id)</td>
                        <td>@Ago(s.LastSeenUtc)</td>
                        <td>@Ago(s.PublishedUtc)@if (Helpers.HasPending(s, playlists)) { <span class="badge mise-a-jour st-pending">À publier</span> }</td>
                    </tr>
                }
                </tbody>
            </table>
        }
    </section>
    <p class="hint">Disponibilité sur 30 jours et historique des pannes : non encore enregistrés. Cette page montre l'état actuel.</p>
}
else if (tab == "qr")
{
    @if (!growth)
    {
        <section class="card empty">
            <div class="big"><Ico Name="lock" Size="18" /> Disponible avec le plan Pro</div>
            <p>Comptez les scans de vos QR codes : combien de personnes scannent, et combien de visiteurs distincts par jour.</p>
        </section>
    }
    else
    {
        <div class="stats">
            <div class="stat"><div class="n">@scanCount.ToString("N0", Fr)</div><div class="l">Scans</div></div>
            <div class="stat"><div class="n">@visitorCount.ToString("N0", Fr)</div><div class="l">Visiteurs estimés</div></div>
            <div class="stat"><div class="n">@(scanRate is { } r ? r.ToString("0.0", Fr) + " %" : "—")</div><div class="l">Taux de scan</div></div>
            <div class="stat"><div class="n" style="font-size:20px;padding-top:6px">@(topHost ?? "—")</div><div class="l">Destination la plus visitée</div></div>
        </div>

        <div class="st-grid">
            <section class="card">
                <h3>Scans @(period == "today" ? "par heure" : "par jour")</h3>
                <StatBars Data="scanBuckets" Label="Scans" />
            </section>
            <section class="card">
                <h3>Par contenu</h3>
                @if (qrRows.Count == 0) { <p class="hint">Aucun contenu avec un QR code actif.</p> }
                else
                {
                    <table class="tbl st-tbl">
                        <thead><tr><th>Contenu</th><th class="num">Scans</th><th class="num">Taux</th></tr></thead>
                        <tbody>
                        @foreach (var q in qrRows)
                        {
                            <tr>
                                <td><b>@q.Name</b></td>
                                <td class="num">@q.Scans</td>
                                <td class="num">@(q.Rate is { } rr ? rr.ToString("0.0", Fr) + " %" : "—")</td>
                            </tr>
                        }
                        </tbody>
                    </table>
                }
            </section>
        </div>
        <p class="hint">Taux de scan = scans ÷ passages du contenu sur la période. Le comptage ignore les robots et les doubles scans dans les 10 secondes. Aucune adresse IP n'est conservée.</p>
    }
}
else if (tab == "pub" && adsOn)
{
    @* Publicité (§45) : onglet présent seulement si la publicité est activée dans Réglages › Publicité. Revenus = part du propriétaire, passages complets seulement. *@
    <div class="stats">
        <div class="stat"><div class="n">@adComplete.ToString("N0", Fr)</div><div class="l">Passages complets</div></div>
        <div class="stat"><div class="n">@Ads.Human(adSeconds)</div><div class="l">Temps d'affichage complet</div></div>
        <div class="stat"><div class="n">@Ads.Chf(adRevenue)</div><div class="l">Revenus de la période</div></div>
        <div class="stat"><div class="n">@Ads.Chf(adMonth)</div><div class="l">Cumul du mois</div></div>
    </div>
    <div class="st-grid">
        <section class="card">
            <h3>Passages complets @(period == "today" ? "par heure" : "par jour")</h3>
            <StatBars Data="adBuckets" Label="Passages complets" />
        </section>
        <section class="card">
            <h3>Par campagne</h3>
            @if (adCampaignRows.Count == 0) { <p class="hint">Aucun spot diffusé sur cette période.</p> }
            else
            {
                <table class="tbl st-tbl">
                    <thead><tr><th>Annonceur</th><th class="num">Complets</th><th class="num">Revenus</th></tr></thead>
                    <tbody>@foreach (var r in adCampaignRows) { <tr><td><b>@r.Name</b></td><td class="num">@r.Complete</td><td class="num">@Ads.Chf(r.Owner)</td></tr> }</tbody>
                </table>
            }
        </section>
    </div>
    <section class="card">
        <header><h3>Relevés</h3><small>un relevé par mois, avec son numéro et son empreinte</small></header>
        <table class="tbl st-tbl">
            <thead><tr><th>Mois</th><th class="num">Passages complets</th><th class="num">Temps d'affichage</th><th class="num">Montant</th><th>Statut</th><th></th></tr></thead>
            <tbody>
                @foreach (var m in adMonths)
                {
                    <tr>
                        <td>@m.Label</td><td class="num">@m.Complete.ToString("N0", Fr)</td><td class="num">@Ads.Human(m.Seconds)</td><td class="num">@Ads.Chf(m.Owner)</td>
                        <td><span class="badge @(m.Status is AdStatementStates.Paid or AdStatementStates.Validated ? "en-ligne" : m.Status == AdStatementStates.ToValidate ? "mise-a-jour" : "neutre")">@AdStatementStates.Label(m.Status)</span></td>
                        <td><a href="/stats/publicite/releve/@m.Month">Relevé</a></td>
                    </tr>
                }
            </tbody>
        </table>
    </section>
    <p class="hint">Les chiffres sont ceux de la preuve de diffusion de Linkivi : seuls les passages affichés en entier comptent, selon la part de chaque campagne. Conservation 13 mois. Les spots ne figurent ni dans vos listes de lecture ni dans votre planning.</p>
}

@code {
    private static readonly (string Key, string Label)[] Periods = { ("today", "Aujourd'hui"), ("7", "7 jours"), ("30", "30 jours") };
    private static readonly (string Key, string Label)[] BaseTabs = { ("vue", "Vue d'ensemble"), ("diff", "Diffusion"), ("ecr", "Écrans"), ("qr", "Scans QR") };
    // « Publicité » : seulement si la publicité est activée dans Réglages › Publicité (licence Pro), pour garder la page épurée
    private IEnumerable<(string Key, string Label)> Tabs => adsOn ? BaseTabs.Append(("pub", "Publicité")) : BaseTabs;
    [SupplyParameterFromQuery(Name = "tab")] public string? TabParam { get; set; }

    // Publicité
    private bool adsOn;
    private int adComplete;
    private long adSeconds;
    private decimal adRevenue, adMonth;
    private List<(string Label, string Short, int Count)> adBuckets = new();
    private List<(string Name, int Complete, decimal Owner)> adCampaignRows = new();
    private record AdMonth(string Month, string Label, int Complete, long Seconds, decimal Owner, string Status);
    private List<AdMonth> adMonths = new();
    private static readonly System.Globalization.CultureInfo Fr = System.Globalization.CultureInfo.GetCultureInfo("fr-CH");

    private string period = "7", tab = "vue", screenFilter = "";
    private bool growth;
    private TimeZoneInfo zone = TimeZoneInfo.Local;
    private System.Threading.Timer? timer;

    // Parc
    private List<Screen> screens = new();
    private List<Playlist> playlists = new();
    private List<MediaItem> media = new();
    private Dictionary<Guid, string> areaNames = new(), playlistNames = new();
    private int online, offline;

    // Diffusion
    private List<PlayEntry> allPlays = new();
    private Dictionary<Guid, int> playsByScreen = new();
    private List<Row> rows = new(), topRows = new();
    private List<(string Label, string Short, int Count)> buckets = new();

    // Scans QR (Pro)
    private int scanCount, visitorCount;
    private double? scanRate;
    private string? topHost;
    private List<(string Name, int Scans, double? Rate)> qrRows = new();
    private List<(string Label, string Short, int Count)> scanBuckets = new();

    private record Row(Guid? MediaId, string? AppId, string Name, string Type, int Count, int Seconds, DateTime Last);

    protected override void OnInitialized()
    {
        if (TabParam is "vue" or "diff" or "ecr" or "qr" or "pub") tab = TabParam;
        Load();
        if (tab == "pub" && !adsOn) tab = "vue";
        // l'état des écrans évolue tout seul
        timer = new System.Threading.Timer(_ => InvokeAsync(() => { Load(); StateHasChanged(); }), null, 15000, 15000);
    }

    private void Load()
    {
        var tzId = Store.Read(d => d.Tenant.Timezone);
        try { zone = TimeZoneInfo.FindSystemTimeZoneById(tzId); } catch (Exception) { zone = TimeZoneInfo.Local; }

        growth = Store.Read(d => d.Tenant.IsGrowth);
        screens = Store.Read(d => d.Screens.Where(s => s.Token != null).OrderBy(s => s.Name).ToList());
        playlists = Store.Read(d => d.Playlists.ToList());
        media = Store.Read(d => d.Media.ToList());
        areaNames = Store.Read(d => d.Areas.ToDictionary(a => a.Id, a => a.Name));
        playlistNames = playlists.ToDictionary(p => p.Id, p => p.Name);

        var statuses = screens.Select(Status).ToList();
        online = statuses.Count(s => s != "Hors ligne");
        offline = statuses.Count(s => s == "Hors ligne");

        var (firstDay, since) = Window();
        var inArea = screens.Select(s => s.Id).ToHashSet();   // seuls les écrans de l'aire ouverte
        allPlays = PlayLog.Read(Store.ClientId, since).Where(p => inArea.Contains(p.ScreenId)).ToList();
        playsByScreen = allPlays.GroupBy(p => p.ScreenId).ToDictionary(g => g.Key, g => g.Count());

        var shown = Guid.TryParse(screenFilter, out var sid) ? allPlays.Where(p => p.ScreenId == sid).ToList() : allPlays;
        topRows = Rows(allPlays);
        rows = Rows(shown);
        buckets = Buckets(allPlays.Select(p => p.StartUtc).ToList(), firstDay);

        if (growth) LoadScans(since, firstDay);
        else { scanCount = visitorCount = 0; scanRate = null; topHost = null; qrRows = new(); scanBuckets = new(); }

        adsOn = Store.Read(d => Ads.On(d.Tenant));
        if (adsOn) LoadAds(since, firstDay);
    }

    /// <summary>Revenus publicitaires : part du propriétaire sur les passages complets (période choisie, mois en cours, relevés des 13 derniers mois).</summary>
    private void LoadAds(DateTime since, DateTime firstDay)
    {
        var nowLocal = Local(DateTime.UtcNow);
        var yearAgo = TimeZoneInfo.ConvertTimeToUtc(DateTime.SpecifyKind(new DateTime(nowLocal.Year, nowLocal.Month, 1).AddMonths(-12), DateTimeKind.Unspecified), zone);
        var all = AdLog.Read(Store.ClientId, yearAgo);
        var camps = Store.Read(d => d.Root.AdCampaigns.ToList());
        decimal Owner(IEnumerable<AdPlay> l) => AdReports.Rows(l, camps).Sum(r => r.Owner);
        var inPeriod = all.Where(p => p.StartUtc >= since).ToList();
        adComplete = inPeriod.Count(p => p.Complete);
        adSeconds = inPeriod.Where(p => p.Complete).Sum(p => (long)p.PlannedMs) / 1000;
        adRevenue = Owner(inPeriod);
        var monthKey = nowLocal.ToString("yyyy-MM");
        adMonth = Owner(all.Where(p => Local(p.StartUtc).ToString("yyyy-MM") == monthKey));
        adBuckets = Buckets(inPeriod.Where(p => p.Complete).Select(p => p.StartUtc).ToList(), firstDay);
        adCampaignRows = inPeriod.GroupBy(p => p.CampaignId).Select(g => (camps.FirstOrDefault(c => c.Id == g.Key)?.Advertiser ?? "(campagne supprimée)", g.Count(p => p.Complete), Owner(g)))
            .OrderByDescending(r => r.Item3).ToList();
        var cid = Store.ClientId;
        // le mois en cours, puis chaque mois qui a des passages
        adMonths = all.Select(p => Local(p.StartUtc).ToString("yyyy-MM")).Append(monthKey).Distinct().OrderByDescending(m => m).Select(m =>
        {
            var l = all.Where(p => Local(p.StartUtc).ToString("yyyy-MM") == m).ToList();
            var label = Fr.TextInfo.ToTitleCase(DateTime.ParseExact(m + "-01", "yyyy-MM-dd", null).ToString("MMMM yyyy", Fr)) + (m == monthKey ? " (en cours)" : "");
            return new AdMonth(m, label, l.Count(p => p.Complete), l.Where(p => p.Complete).Sum(p => (long)p.PlannedMs) / 1000, Owner(l),
                Store.Read(d => Ads.StatementStatus(d.Root, cid, m, nowLocal)));
        }).ToList();
    }

    /// <summary>Scans des QR codes actifs de l'aire ouverte (licence Pro).</summary>
    private void LoadScans(DateTime since, DateTime firstDay)
    {
        var items = playlists.SelectMany(p => p.Draft).Where(i => i.QrOn).ToList();
        var itemIds = items.Select(i => i.Id).ToHashSet();
        var scans = ScanLog.Read(Store.ClientId, since).Where(s => itemIds.Contains(s.ItemId)).ToList();

        var names = media.ToDictionary(m => m.Id, m => m.Name);
        var scansByItem = scans.GroupBy(s => s.ItemId).ToDictionary(g => g.Key, g => g.Count());
        var passagesByMedia = allPlays.Where(p => p.MediaId != null).GroupBy(p => p.MediaId!.Value).ToDictionary(g => g.Key, g => g.Count());

        scanCount = scans.Count;
        visitorCount = scans.Select(s => s.Visitor).Distinct().Count();   // l'empreinte change chaque jour : un visiteur par jour

        topHost = scans.GroupBy(s => items.FirstOrDefault(i => i.Id == s.ItemId)?.QrUrl)
            .Select(g => (Host: Uri.TryCreate(g.Key, UriKind.Absolute, out var u) ? u.Host : null, Count: g.Count()))
            .Where(h => h.Host != null)
            .GroupBy(h => h.Host)
            .Select(g => (Host: g.Key, Count: g.Sum(x => x.Count)))
            .OrderByDescending(h => h.Count).FirstOrDefault().Host;

        var passagesQr = items.Where(i => passagesByMedia.ContainsKey(i.MediaId)).Sum(i => passagesByMedia[i.MediaId]);
        scanRate = passagesQr > 0 ? Math.Round(scanCount * 100.0 / passagesQr, 1) : null;

        qrRows = items.Select(i =>
            {
                var sc = scansByItem.GetValueOrDefault(i.Id);
                var pm = passagesByMedia.GetValueOrDefault(i.MediaId);
                return (Name: names.GetValueOrDefault(i.MediaId) ?? "Contenu", Scans: sc,
                    Rate: pm > 0 ? Math.Round(sc * 100.0 / pm, 1) : (double?)null);
            })
            .OrderByDescending(r => r.Scans).ThenBy(r => r.Name)
            .ToList();

        scanBuckets = Buckets(scans.Select(s => s.AtUtc).ToList(), firstDay);
    }

    /// <summary>Diffusions regroupées par contenu. Le nom courant d'un contenu renommé prime sur celui noté à la diffusion.</summary>
    private List<Row> Rows(List<PlayEntry> list)
    {
        var byId = media.ToDictionary(m => m.Id);
        return list.GroupBy(p => (p.MediaId, p.AppId))
            .Select(g =>
            {
                var m = g.Key.MediaId is { } id && byId.TryGetValue(id, out var mi) ? mi : null;
                return new Row(g.Key.MediaId, g.Key.AppId, m?.Name ?? g.Last().Name, TypeOf(m, g.Key.AppId),
                    g.Count(), g.Sum(p => p.Seconds), g.Max(p => p.StartUtc));
            })
            .OrderByDescending(r => r.Count).ThenByDescending(r => r.Last)
            .ToList();
    }

    private static string TypeOf(MediaItem? m, string? appId) => appId != null ? "App" : m?.Type switch
    {
        "image" => "Image", "video" => "Vidéo", "pdf" => "PDF", _ => m?.Type ?? "Contenu"
    };

    private (DateTime FirstDay, DateTime SinceUtc) Window()
    {
        var today = Local(DateTime.UtcNow).Date;
        var firstDay = period == "today" ? today : today.AddDays(1 - int.Parse(period));
        var since = TimeZoneInfo.ConvertTimeToUtc(DateTime.SpecifyKind(firstDay, DateTimeKind.Unspecified), zone);
        return (firstDay, since);
    }

    private DateTime Local(DateTime utc) => TimeZoneInfo.ConvertTimeFromUtc(utc, zone);

    /// <summary>Répartition par heure (aujourd'hui) ou par jour de la période.</summary>
    private List<(string Label, string Short, int Count)> Buckets(List<DateTime> stamps, DateTime firstDay)
    {
        if (period == "today")
            return Enumerable.Range(0, 24).Select(h => ($"{h:00}h", h % 3 == 0 ? $"{h}h" : "", stamps.Count(t => Local(t).Hour == h))).ToList();
        var days = int.Parse(period);
        return Enumerable.Range(0, days).Select(i => firstDay.AddDays(i)).Select(d => (
            d.ToString("dddd d MMMM", Fr),
            days <= 7 ? d.ToString("ddd", Fr) : d.Day == 1 || d == firstDay || d.Day % 7 == 1 ? d.ToString("d.M") : "",
            stamps.Count(t => Local(t).Date == d))).ToList();
    }

    private string Status(Screen s) => Store.Read(d => d.Status(s));

    // 45 s, 12 min, 3 h 05
    private static string Human(int sec) =>
        sec < 60 ? $"{sec} s" : sec < 3600 ? $"{sec / 60} min" : $"{sec / 3600} h {sec % 3600 / 60:00}";

    private static string Ago(DateTime? utc)
    {
        if (utc is not { } at) return "Jamais";
        var ago = DateTime.UtcNow - at;
        return ago.TotalMinutes < 1 ? "À l'instant"
            : ago.TotalHours < 1 ? $"Il y a {(int)ago.TotalMinutes} min"
            : ago.TotalDays < 1 ? $"Il y a {(int)ago.TotalHours} h"
            : ago.TotalDays < 2 ? "Hier"
            : at.ToLocalTime().ToString("dd.MM.yyyy");
    }

    public void Dispose() => timer?.Dispose();
}
