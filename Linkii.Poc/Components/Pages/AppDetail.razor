@page "/apps/{AppId}"
@attribute [Microsoft.AspNetCore.Authorization.Authorize(Policy = "ClientAdmin")]
@inject AppService Svc
@inject TenantStore Store
@inject NavigationManager Nav
@inject Toaster Toast
@inject CloudFileService Cloud
@inject ModeService Modes
@inject GoogleConnector Google
@inject RoomStatusService RoomStatus
@inject Notifier Notifier

@* Page d'une application : ouverte par son entrée du menu « Applications » (applications du catalogue, Drives, calendriers partagés, Home Assistant).
   Onglets : Contenus (seulement s'il y a des contenus ou des fichiers importés : liste), Configuration (compte, bouton Configurer, menu), Infos.
   En haut : Synchroniser (compte cloud) et Désinstaller. Configurer, retrait et synchronisation s'ouvrent ici (Integrations en Mode="app"). *@
@if (app == null)
{
    <div class="empty"><div class="big">Application introuvable</div><a class="btn" href="/applications">Retour aux applications</a></div>
}
else if (!installed)
{
    <div class="page-head">
        <div class="row" style="gap:16px">
            <AppIcon Id="@app.Id" />
            <div>
                <h1>@app.Name</h1>
                <p class="sub">@app.Category@(app.Version.Length > 0 ? " · version " + app.Version : "")</p>
            </div>
        </div>
        <div class="row">
            <a class="btn ghost" href="@Back">@(app.ScreenWidget ? "Retour aux widgets" : "Retour aux applications")</a>
            @if (isVirtual) { <a class="btn" href="/store">Ouvrir le Store</a> }
            else if (IsRooms) { <button class="btn" @onclick="() => integ?.WizardById(AppId, 1)">Installer</button> }   @* l'installation passe par son assistant (agendas, salles, règles) *@
            else { <button class="btn" @onclick="Install">@(app.ScreenWidget ? "Activer le widget" : "Activer l'application")</button> }
        </div>
    </div>
    <div class="card">@if (isVirtual) { <p>@app.Summary</p> } else { <AppDetailBody App="app" /> }</div>
}
else
{
    <div class="page-head">
        <div class="row" style="gap:16px">
            <AppIcon Id="@app.Id" />
            <div>
                <h1>@app.Name</h1>
                @if (SimplePage) { <p class="sh-meta"><span>@(items.Count == 0 ? "Aucun contenu" : $"{items.Count} contenu{(items.Count > 1 ? "s" : "")} · {items.Count(i => i.On)} actif{(items.Count(i => i.On) > 1 ? "s" : "")}")</span></p> }
                else { <p class="sub">@app.Category@(app.Version.Length > 0 ? " · version " + app.Version : "")@(installedOn is { } on ? $" · installée le {on.ToLocalTime():dd.MM.yyyy}" : "")</p> }
            </div>
        </div>
        @if (SimplePage)
        {
            @* mode Simple allégé (maquette applications-simple-allegee.html) : plus d'onglets ; Configurer en icône, le reste dans ⋯ *@
            <div class="row head-actions">
                @if (app.ScreenWidget) { <a class="btn" href="/">Placer sur un écran</a> }
                @if (HasSync) { <button type="button" class="sh-ib" disabled="@(!CanSync || syncing)" data-tip="@(CanSync ? "Synchroniser" : "Le compte n'est pas connecté")" aria-label="Synchroniser" @onclick="Sync"><Ico Name="refresh" Size="18" /></button> }
                <button type="button" class="sh-ib" data-tip="Configurer" aria-label="Configurer" @onclick="Configure"><Ico Name="sliders" Size="18" /></button>
                <div class="kebab">
                    <button type="button" class="sh-ib" aria-haspopup="menu" aria-expanded="@(headMenu ? "true" : "false")" aria-label="Plus d'actions" @onclick="() => headMenu = !headMenu"><Ico Name="dots-v" Size="18" /></button>
                    @if (headMenu)
                    {
                        <div class="kebab-backdrop" @onclick="() => headMenu = false"></div>
                        <div class="kebab-menu" role="menu">
                            <button type="button" role="menuitem" @onclick="() => { headMenu = false; ToggleMenu(); }"><Ico Name="@(inMenu ? "check" : "eye")" Size="16" /> @(inMenu ? "Affichée dans le menu" : "Afficher dans le menu")</button>
                            <button type="button" role="menuitem" @onclick="() => { headMenu = false; aboutOpen = true; }"><Ico Name="info" Size="16" /> À propos</button>
                            @if (!app.DefaultOn) { <hr /><button type="button" role="menuitem" class="danger" @onclick="() => { headMenu = false; _ = Uninstall(); }"><Ico Name="trash" Size="16" /> Désinstaller</button> }
                        </div>
                    }
                </div>
            </div>
        }
        else
        {
        <div class="row head-actions">
            @if (IsPlans && Modes.Expert && haOn) { <a class="btn" href="/plans/nouveau?back=@PlanBack"><Ico Name="plus" Size="16" /> Nouveau plan</a> }
            @if (app.ScreenWidget) { <a class="btn" href="/">Placer sur un écran</a> }
            @if (IsRooms) { <button type="button" class="btn ghost" disabled="@syncing" title="Relit vos agendas : nouvelles salles, droits, états" @onclick="SyncRooms"><Ico Name="refresh" Size="16" /> Synchroniser</button> }
            @if (HasSync) { <button type="button" class="btn ghost" disabled="@(!CanSync || syncing)" title="@(CanSync ? "Récupère les nouveaux contenus du compte connecté" : "Le compte n'est pas connecté")" @onclick="Sync"><Ico Name="refresh" Size="16" /> Synchroniser</button> }
            @if (!app.DefaultOn) { <button type="button" class="btn ghost danger-text" @onclick="Uninstall">Désinstaller</button> }
        </div>
        }
    </div>

    @if (SimplePage && aboutOpen)
    {
        <div class="modal-backdrop" @onclick="() => aboutOpen = false"></div>
        <div class="modal" role="dialog" aria-modal="true" aria-label="À propos de @app.Name">
            <div class="modal-head"><h3>À propos de @app.Name</h3></div>
            <div class="modal-body">@InfoCard</div>
            <div class="modal-foot"><button type="button" class="btn ghost" @onclick="() => aboutOpen = false">Fermer</button></div>
        </div>
    }

    <nav class="tabs int-tabs @(SimplePage ? "sh-hide" : "")" role="tablist" aria-label="Contenus, configuration et infos">
        @if (items.Count > 0 || IsPlans) { <button type="button" role="tab" class="@(tab == "contenus" ? "on" : "")" aria-selected="@(tab == "contenus" ? "true" : "false")" @onclick='() => tab = "contenus"'>Contenus <span class="cat-count">@items.Count</span></button> }
        @if (IsRooms && items.Count > 0) { <button type="button" role="tab" class="@(tab == "resa" ? "on" : "")" aria-selected="@(tab == "resa" ? "true" : "false")" @onclick='() => tab = "resa"'>Réservations <span class="badge neutre">statut seul</span></button> }
        <button type="button" role="tab" class="@(tab == "config" ? "on" : "")" aria-selected="@(tab == "config" ? "true" : "false")" @onclick='() => tab = "config"'>Configuration</button>
        <button type="button" role="tab" class="@(tab == "infos" ? "on" : "")" aria-selected="@(tab == "infos" ? "true" : "false")" @onclick='() => tab = "infos"'>Infos</button>
    </nav>

    @if (IsRooms && tab == "contenus" && items.Count > 0)
    {
        <RoomContentsTab OnChanged="Reload" />
    }
    else if (IsRooms && tab == "resa")
    {
        <RoomStatusTab />
    }
    else if (IsRooms && tab == "config")
    {
        <RoomConfigTab OnManage="ManageRooms" OnChanged="Reload" />
        <div class="card apd-card">
            <div class="apd-row">
                <span class="grow"><b>Dans le menu</b><small>L'application apparaît dans le groupe « Applications » du menu de gauche.</small></span>
                <button type="button" class="switch @(inMenu ? "on" : "")" role="switch" aria-checked="@(inMenu ? "true" : "false")" aria-label="Afficher dans le menu" @onclick="ToggleMenu"><span></span></button>
            </div>
        </div>
    }
    else if (tab == "contenus" && IsPlans && items.Count == 0)
    {
        <div class="card empty">
            @if (!Modes.Expert) { <div class="big">Disponible en mode expert</div> }
            else if (!haOn) { <div class="big">Home Assistant n'est pas connecté</div><p>Connectez-le pour dessiner vos plans du bâtiment.</p> }
            else
            {
                <div class="big">Aucun plan</div>
                <p>Un plan réunit vos étages et les appareils de Home Assistant. Créez-le une fois, affichez-le sur autant d'écrans que vous voulez.</p>
                <a class="btn" href="/plans/nouveau?back=@PlanBack"><Ico Name="plus" Size="16" /> Créer un plan</a>
            }
        </div>
    }
    else if (tab == "contenus" && items.Count > 0)
    {
        var shown = Shown;
        var types = Types;
        var grouped = Grouped;
        var narrowed = shown.Count != items.Count;
        @if (items.Count > 12 || types.Count > 1)
        {
            <div class="apd-tools">
                @if (items.Count > 12) { <div class="search-box"><Ico Name="search" Size="16" /><input placeholder="Rechercher" aria-label="Rechercher un contenu" @bind="filter" @bind:event="oninput" /></div> }
                else { <span class="grow"></span> }
                @if (types.Count > 1)
                {
                    <div class="kebab dd">
                        <button type="button" class="dd-btn @(hidden.Count > 0 ? "act" : "")" aria-haspopup="menu" aria-expanded="@(typeMenu ? "true" : "false")" @onclick="() => typeMenu = !typeMenu">
                            <Ico Name="filter" Size="16" /> <span>Filtrer par type</span>
                            @if (hidden.Count > 0) { <span class="c">@(types.Count - hidden.Count)/@types.Count</span> } <Ico Name="chevron" Size="14" />
                        </button>
                        @if (typeMenu)
                        {
                            <div class="kebab-backdrop" @onclick="() => typeMenu = false"></div>
                            <div class="kebab-menu dd-menu right apd-types" role="menu">
                                <div class="apd-types-h"><span class="dd-h">Types de contenus</span><span class="grow"></span><button type="button" class="apd-link" @onclick="() => hidden.Clear()">Tous</button><button type="button" class="apd-link" @onclick="() => hidden = types.Select(t => t.Name).ToHashSet()">Aucun</button></div>
                                <div class="apd-types-l">
                                    @foreach (var t in types)
                                    {
                                        var name = t.Name;
                                        <button type="button" role="menuitemcheckbox" aria-checked="@(hidden.Contains(name) ? "false" : "true")" class="@(hidden.Contains(name) ? "" : "sel")" @onclick="() => ToggleType(name)">
                                            <span class="apd-chk"><Ico Name="check" Size="12" /></span>@Cap(name)<span class="n">@t.Count</span>
                                        </button>
                                    }
                                </div>
                            </div>
                        }
                    </div>
                }
            </div>
        }
        <div class="apd-bar @(SimplePage ? "sh-hide" : "")">
            @if (IsPlans) { <span class="apd-sum">@items.Count plan@(items.Count > 1 ? "s" : "") · @items.Count(i => i.Screens > 0) affiché@(items.Count(i => i.Screens > 0) > 1 ? "s" : "")</span> }
            else { <span class="apd-sum">@(narrowed ? $"{shown.Count} sur " : "")@items.Count contenu@(items.Count > 1 ? "s" : "") · @shown.Count(i => i.On) actif@(shown.Count(i => i.On) > 1 ? "s" : "")</span> }
            <span class="grow"></span>
            @if (grouped && filter.Length == 0) { <button type="button" class="apd-link" @onclick="ToggleAllGroups">@(open.Count > 0 ? "Tout replier" : "Tout déplier")</button> }
            @if (!IsPlans)
            {
            <button type="button" class="btn ghost sm" disabled="@(shown.All(i => i.On))" title="@(narrowed ? "Active les contenus affichés" : "Active tous les contenus")" @onclick="() => SetAll(shown, true)">@(narrowed ? "Activer les affichés" : "Tout activer")</button>
            <button type="button" class="btn ghost sm" disabled="@(shown.All(i => !i.On))" title="@(narrowed ? "Désactive les contenus affichés" : "Désactive tous les contenus")" @onclick="() => SetAll(shown, false)">@(narrowed ? "Désactiver les affichés" : "Tout désactiver")</button>
            }
        </div>
        @if (shown.Count == 0)
        {
            <div class="empty compact"><div class="big">Aucun contenu trouvé</div></div>
        }
        else
        {
            @if (SimplePage)
            {
                @* mode Simple allégé (§235) : plus de tableau ni d'activation en lot ; une ligne par contenu, avec son interrupteur *@
                <div class="sr-list">@foreach (var it in shown.Take(300)) { @SimpleRow(it) }</div>
            }
            else
            {
            <div class="lx-tbl-wrap">
                <table class="lx-tbl apd-tbl">
                    @if (IsPlans) { <thead><tr><th>Plan</th><th>Étages</th><th>Appareils</th><th class="num">Affiché</th><th>Modifié le</th><th>État</th><th></th></tr></thead> }
                    else { <thead><tr><th>Contenu</th><th>Type</th><th>Listes de lecture</th><th class="num">Écrans</th><th>Ajouté le</th><th>État</th><th>Actif</th></tr></thead> }
                    @if (grouped)
                    {
                        @foreach (var g in shown.GroupBy(i => i.Type))
                        {
                            var grp = g.ToList();
                            var key = g.Key;
                            var isOpen = filter.Length > 0 || open.Contains(key);
                            var nOn = grp.Count(i => i.On);
                            <tbody class="apd-grp @(isOpen ? "open" : "")">
                                <tr class="apd-grp-h">
                                    <td colspan="6">
                                        <button type="button" class="apd-grp-btn" aria-expanded="@(isOpen ? "true" : "false")" @onclick="() => ToggleGroup(key)">
                                            <Ico Name="chevron" Size="16" /><b>@Cap(key)</b><span class="apd-grp-n">@grp.Count</span><small>@nOn actif@(nOn > 1 ? "s" : "")</small>
                                        </button>
                                    </td>
                                    <td><button type="button" class="switch sm @(nOn == grp.Count ? "on" : "") @(nOn > 0 && nOn < grp.Count ? "mixed" : "")" role="switch" aria-checked="@(nOn == grp.Count ? "true" : nOn == 0 ? "false" : "mixed")" title="@(nOn == grp.Count ? "Tout désactiver" : "Tout activer") : @key" aria-label="@(nOn == grp.Count ? "Désactiver" : "Activer") tous les @key" @onclick="() => SetAll(grp, nOn < grp.Count)"><span></span></button></td>
                                </tr>
                                @if (isOpen)
                                {
                                    @foreach (var it in grp.Take(300)) { @RowView(it) }
                                    @if (grp.Count > 300) { <tr><td colspan="7"><small class="apd-sum">@grp.Count contenus : les 300 premiers sont affichés, utilisez la recherche.</small></td></tr> }
                                }
                            </tbody>
                        }
                    }
                    else
                    {
                        <tbody>@foreach (var it in shown.Take(300)) { @RowView(it) }</tbody>
                    }
                </table>
            </div>
            }
            @if (!grouped && shown.Count > 300) { <p class="apd-sum" style="margin-top:8px">@shown.Count contenus : les 300 premiers sont affichés, utilisez la recherche.</p> }
        }
    }
    else if (tab == "config")
    {
        <div class="card apd-card">
            @if (account is { } kind)
            {
                var acc = accounts.FirstOrDefault(a => a.Id == kind);
                <div class="cvs-account">
                    <AccountLogo Kind="@kind" />
                    <div class="grow">
                        <b>@(acc?.User ?? $"Aucun compte {ConnectedAccounts.Kind(kind).Name} connecté")</b>
                        <small>@(acc == null ? $"Nécessaire pour utiliser {app.Name}." : acc.Lost ? "Connexion expirée : reconnectez le compte." : "Compte de l'organisation, partagé avec les autres applications qui l'utilisent.")</small>
                    </div>
                    <a class="btn ghost sm" href="/settings?tab=connexions">Voir dans Connexions</a>
                </div>
            }
            <div class="apd-row">
                <span class="grow"><b>Configuration de l'application</b><small>@ConfigHint</small></span>
                <button type="button" class="btn sm" @onclick="Configure">Configurer</button>
            </div>
            <div class="apd-row">
                <span class="grow"><b>Dans le menu</b><small>L'application apparaît dans le groupe « Applications » du menu de gauche.</small></span>
                <button type="button" class="switch @(inMenu ? "on" : "")" role="switch" aria-checked="@(inMenu ? "true" : "false")" aria-label="Afficher dans le menu" @onclick="ToggleMenu"><span></span></button>
            </div>
            @if (AppId == AppMenu.Home && Modes.Expert)
            {
                <div class="apd-row">
                    <span class="grow"><b>Plans du bâtiment</b><small>Dessiner vos plans et choisir où ils s'affichent.</small></span>
                    <a class="btn sm" href="/apps/@AppMenu.Plans">Ouvrir</a>
                </div>
            }
            @if (!isVirtual && app.Settings.Count > 0)
            {
                <div class="apd-row apd-fields">
                    <span class="grow"><b>Paramètres de ses contenus</b><small>@string.Join(" · ", app.Settings.Select(f => f.Label))</small></span>
                </div>
            }
        </div>
    }
    else
    {
        @InfoCard
    }
}

@code {
    /// <summary>Mode Simple, application ordinaire : page sans onglets (les salles gardent leurs onglets propres).</summary>
    private bool SimplePage => Modes.Simple && !IsRooms && !IsPlans;
    private bool headMenu, aboutOpen;

    /// <summary>Fiche « Infos » : onglet en mode expert, fenêtre « À propos » en mode Simple.</summary>
    private RenderFragment InfoCard => __builder =>
    {
        if (app == null) return;
        <div class="card apd-card">
            @if (isVirtual) { <p>@app.Summary</p> } else { <AppDetailBody App="app" /> }
            <dl class="int-kv">
                <dt>Catégorie</dt><dd>@app.Category</dd>
                @if (app.Version.Length > 0) { <dt>Version</dt><dd>@app.Version</dd> }
                <dt>Installée</dt><dd>@(installedOn is { } d ? d.ToLocalTime().ToString("dd.MM.yyyy") : "—")@(app.DefaultOn ? " · application de base" : "")</dd>
                @if (IsRooms)
                {
                    <dt>Plans</dt><dd>Tous les plans</dd>
                    <dt>Agendas utilisés</dt><dd>@(string.Join(", ", roomSources.Select(s => SharedCalendarSources.Find(s)?.Name ?? s)) is { Length: > 0 } us ? us : "Aucun")</dd>
                    <dt>Type d'écran</dt><dd>Ajoute « Écran de salle » (@roomScreens écran@(roomScreens > 1 ? "s" : ""))</dd>
                    <dt>Salles</dt><dd>@items.Count · @items.Count(i => i.On) active@(items.Count(i => i.On) > 1 ? "s" : "")</dd>
                }
                else
                {
                <dt>Compte requis</dt><dd>@(account is { } k ? ConnectedAccounts.Kind(k).Name : "Aucun")</dd>
                <dt>Contenus</dt><dd>@items.Count · @items.Count(i => i.Screens > 0) diffusé@(items.Count(i => i.Screens > 0) > 1 ? "s" : "")</dd>
                }
            </dl>
        </div>
    };
}

@if (app != null)
{
    <Integrations Mode="app" @ref="integ" OnChanged="Reload" />
}

@code {
    [Parameter] public string AppId { get; set; } = "";
    private string PlanBack => Uri.EscapeDataString($"/apps/{AppId}");
    private AppManifest? app;
    private bool installed, inMenu, isVirtual, syncing, haOn;
    /// <summary>« Vue du bâtiment » : l'onglet Contenus montre les plans du bâtiment, et « Nouveau plan » est en haut de la page.</summary>
    private bool IsPlans => AppId == AppMenu.Plans;
    /// <summary>« Réservation de salle » : ses contenus sont les salles ; onglet Réservations propre ; Configuration et Synchroniser propres.</summary>
    private bool IsRooms => AppId == RoomRules.AppId;
    private List<string> roomSources = new();
    private int roomScreens;
    private DateTime? installedOn;
    private string tab = "config";
    private string? account;   // type de compte demandé (Google, Microsoft…), ou null
    private List<ConnectedAccount> accounts = new();
    private record Item(string Kind, string Key, string Name, string Type, bool Instance, List<string> Lists, int Screens, DateTime? Added, string? Error, bool On);
    private string filter = "";
    private List<Item> items = new();
    private Integrations? integ;

    private string Back => app?.ScreenWidget == true ? "/widgets" : "/applications";
    private static bool IsCloudFiles(string id) => id is "google-docs" or "google-slides" or "ms-powerpoint";
    private bool HasSync => Integrations.HasSync(AppId) || IsCloudFiles(AppId);
    private bool CanSync => account is { } k && accounts.FirstOrDefault(a => a.Id == k) is { Lost: false };
    private string ConfigHint => AppId.StartsWith("drv-") || AppId == "canva" ? "Les dossiers synchronisés et la connexion."
        : AppId.StartsWith("cal-") ? "La connexion et les calendriers."
        : IsCloudFiles(AppId) ? "Le compte et les fichiers importés."
        : "Les réglages de l'application.";

    private AppManifest? Resolve()
    {
        if (Svc.Find(AppId) is { } m) return m;
        if (AppId.StartsWith("drv-") && DriveSources.Find(AppId[4..]) is { } dr) return new AppManifest { Id = AppId, Name = dr.Name, Category = "Drive", Version = "", Summary = dr.Summary };
        if (AppId.StartsWith("cal-") && SharedCalendarSources.Find(AppId[4..]) is { } ca) return new AppManifest { Id = AppId, Name = ca.Name, Category = "Calendrier partagé", Version = "", Summary = ca.Summary };
        if (AppId == AppMenu.Home) return new AppManifest { Id = AppId, Name = "Home Assistant", Category = "Maison connectée", Version = "", Summary = "Capteurs, interrupteurs, lumières, thermostats, volets, scènes et serrures de votre Home Assistant." };
        return null;
    }

    protected override void OnParametersSet()
    {
        app = Resolve();
        if (app == null) return;
        if (shownId != AppId) { shownId = AppId; filter = ""; hidden.Clear(); open.Clear(); typeMenu = false; }
        Reload();
        tab = items.Count > 0 || IsPlans ? "contenus" : "config";
    }

    private void Reload()
    {
        app = Resolve();
        if (app == null) return;
        isVirtual = Svc.Find(AppId) == null;
        installed = isVirtual ? Store.Read(d => AppMenu.Installed(d, AppId)) : Svc.IsInstalled(app.Id);
        account = ConnectedAccounts.For(app.Id);
        (installedOn, inMenu, accounts, items) = Store.Read(d =>
        {
            var driveKeys = AppId.StartsWith("drv-") ? d.Tenant.DriveFolders.Where(f => f.Source == AppId[4..]).Select(f => f.Id.ToString()).ToHashSet() : null;
            var rows = new List<Item>();
            // fichiers importés et contenus de l'application (désactivés compris)
            rows.AddRange(d.AllMedia.Where(m => driveKeys != null ? m.Info.TryGetValue("drive", out var dk) && driveKeys.Contains(dk) : !isVirtual && !IsPlans && Pres.Belongs(m, AppId))
                .Select(m =>
                {
                    var lists = d.Playlists.Where(p => p.Draft.Any(i => i.MediaId == m.Id)).ToList();
                    var ids = lists.Select(p => p.Id).ToHashSet();
                    var type = m.Type switch { "presentation" => "Présentation", "image" => "Image", "video" => "Vidéo", _ => app!.Name };
                    return new Item("media", m.Id.ToString(), m.Name.Length > 0 ? m.Name : "Sans nom", type, m.AppId == AppId, lists.Select(p => p.Name).ToList(),
                        d.Screens.Count(s => s.PlaylistId is { } pid && ids.Contains(pid)), m.AddedUtc, m.Error, !m.Off);
                }));
            // ce que le compte donne : calendriers, Pages Facebook, entités Home Assistant
            if (AppId.StartsWith("cal-"))
                rows.AddRange(d.Tenant.SharedCalendars.Where(c => c.Source == AppId[4..]).Select(c => new Item("calendar", c.Id.ToString(), c.Name, "Calendrier", false, new(), 0, null, null, !c.Off)));
            else if (AppId == "facebook")
                rows.AddRange(d.Tenant.FacebookPages.Select(p => new Item("page", p.Id, p.Name, "Page", false, new(), 0, null, null, !p.Off)));
            else if (IsPlans)
            {
                // Vue du bâtiment : ses contenus sont les plans du bâtiment (Lists porte « n étages » et « n appareils », Screens le nombre d'endroits où le plan s'affiche)
                var uses = HaPlanUses.CountByPlan(d);
                rows.AddRange(d.Tenant.HaPlans.Select(pl =>
                {
                    var parsed = HomeAssistantRules.ParsePlan(pl.Json);
                    var info = new List<string> { $"{parsed.Floors.Count} étage{(parsed.Floors.Count > 1 ? "s" : "")}", $"{parsed.Devices.Count} appareil{(parsed.Devices.Count > 1 ? "s" : "")}" };
                    return new Item("plan", pl.Id.ToString(), pl.Name.Length > 0 ? pl.Name : "Sans nom", "Plan", false, info, uses.GetValueOrDefault(pl.Id), pl.UpdatedUtc, null, true);
                }));
            }
            else if (IsRooms)
            {
                rows.AddRange(RoomSetup.Rooms(d.Tenant).Select(c => new Item("calendar", c.Id.ToString(), SharedCalendarSources.RoomName(c), "Salle", false, new(), 0, null, null, !c.Off)));
                roomSources = SharedCalendarSources.All.Select(s => s.Id).Where(s => d.Tenant.SharedCalendars.Any(c => c.Room && c.Source == s)).ToList();
                roomScreens = d.AllScreens.Count(s => s.Room != null);
            }
            else if (AppId == AppMenu.Home && d.Tenant.HomeAssistant is { } ha)
                rows.AddRange(ha.Entities.Select(e => new Item("entity", e.Id, e.Name.Length > 0 ? e.Name : e.Id, HomeAssistantRules.FamilyOfDomain(e.Domain)?.Noun ?? e.Domain, false, new(), 0, null, null, !e.Off)));
            haOn = d.Tenant.HomeAssistant is { Url.Length: > 0 };
            return (
                d.AppInstalls.FirstOrDefault(a => a.AppId == AppId)?.InstalledUtc,
                AppMenu.Has(d.Tenant, AppId),
                ConnectedAccounts.Of(d.Tenant),
                rows.OrderBy(r => r.Type, StringComparer.CurrentCultureIgnoreCase).ThenBy(r => r.Name, StringComparer.CurrentCultureIgnoreCase).ToList());
        });
        if (tab is "contenus" or "resa" && items.Count == 0 && !IsPlans) tab = "config";
        if (SimplePage) tab = items.Count > 0 ? "contenus" : "config";   // mode Simple : pas d'onglets, les contenus d'abord
    }

    // ---- Réservation de salle ----

    private void ManageRooms(int step) => integ?.WizardById(AppId, step);

    /// <summary>Relit les agendas : accès Google de chaque salle, modes d'écriture, états ; les tablettes relisent leur salle.</summary>
    private async Task SyncRooms()
    {
        syncing = true;
        var t = Store.Read(d => d.Tenant);
        Dictionary<string, string>? roles = null;
        if (t.SharedCalendars.Any(c => c.Room && c.Source == "google") && GoogleAuth.Has(t, GoogleAuth.CalendarScope))
        {
            try { roles = (await Google.ListCalendars(t)).GroupBy(g => g.Id).ToDictionary(g => g.Key, g => g.First().Role); }
            catch (InvalidOperationException ex) { Toast.Error(ex.Message); }
        }
        var ids = Store.Write(d =>
        {
            if (roles != null) foreach (var c in d.Tenant.SharedCalendars.Where(c => c.Room && c.Source == "google")) if (roles.TryGetValue(c.Ref, out var r) && r.Length > 0) c.RoomAccess = r;
            RoomSetup.Recompute(d.Tenant);
            return d.Tenant.SharedCalendars.Where(c => c.Room).Select(c => c.Id).ToList();
        });
        foreach (var id in ids) RoomStatus.Forget(id);
        await Notifier.NotifyClient(Store.ClientId);
        syncing = false;
        Reload();
        Toast.Ok("Salles synchronisées : droits et états relus.");
    }

    private void Install()
    {
        Svc.Install(AppId);
        OnParametersSet();   // elle apparaît maintenant dans le panneau Apps des listes de lecture (ou dans l'édition des écrans)
    }

    private void Configure() => integ?.ConfigureById(AppId);

    private async Task Sync()
    {
        if (!IsCloudFiles(AppId)) { integ?.SyncById(AppId); return; }
        syncing = true;
        var tenant = Store.Read(d => d.Tenant);
        var files = Store.Read(d => d.AllMedia.Where(m => Pres.Belongs(m, AppId)).ToList());
        var updated = 0;
        string? error = null;
        foreach (var p in files)
        {
            if (CloudFileKind.ForPresentation(p) is not { } kind || CloudFileKind.RefOf(p) is not { Length: > 0 } fileRef) continue;
            var src = p.Info.GetValueOrDefault("src") ?? "pdf";
            var (done, err) = await Cloud.Import(tenant, p.ClientId, p.AreaId == Guid.Empty ? null : p.AreaId, kind, fileRef, p.Info.GetValueOrDefault("pdfId"), new PdfService.Options("", "none", "landscape", Pres.Unit(src), src));
            if (done == null) error ??= err ?? "Conversion impossible."; else updated++;
        }
        syncing = false;
        Reload();
        if (error != null) Toast.Error(error); else Toast.Ok(updated == 0 ? "Rien à synchroniser." : "Synchronisation terminée : les fichiers sont à jour.");
    }

    private void ToggleContent(Item row)
    {
        Svc.SetContentOn(row.Kind, row.Key, !row.On);
        Reload();
    }

    // ---- Contenus : recherche, filtre par type, blocs pliables par type (pliés par défaut), tout activer / désactiver ----
    private HashSet<string> hidden = new();   // types masqués par le filtre
    private HashSet<string> open = new();     // blocs dépliés
    private bool typeMenu;
    private string? shownId;

    private List<(string Name, int Count)> Types => items.GroupBy(i => i.Type).Select(g => (g.Key, g.Count())).ToList();
    /// <summary>Blocs par type dès qu'il y a beaucoup de contenus de plusieurs types (Home Assistant : des centaines d'entités).</summary>
    private bool Grouped => items.Count > 12 && items.Select(i => i.Type).Distinct().Skip(1).Any();
    private List<Item> Shown => items.Where(i => !hidden.Contains(i.Type)
        && (filter.Length == 0 || i.Name.Contains(filter, StringComparison.CurrentCultureIgnoreCase) || i.Type.Contains(filter, StringComparison.CurrentCultureIgnoreCase) || i.Key.Contains(filter, StringComparison.CurrentCultureIgnoreCase))).ToList();

    private static string Cap(string s) => s.Length == 0 ? s : char.ToUpper(s[0]) + s[1..];

    private void ToggleType(string t) { if (!hidden.Remove(t)) hidden.Add(t); }
    private void ToggleGroup(string t) { if (filter.Length > 0) return; if (!open.Remove(t)) open.Add(t); }
    private void ToggleAllGroups() { if (open.Count > 0) open.Clear(); else open = Shown.Select(i => i.Type).ToHashSet(); }

    private void SetAll(List<Item> rows, bool on)
    {
        var todo = rows.Where(r => r.On != on).Select(r => (r.Kind, r.Key)).ToList();
        if (todo.Count == 0) return;
        Svc.SetContentsOn(todo, on);
        Reload();
        Toast.Ok($"{todo.Count} contenu{(todo.Count > 1 ? "s" : "")} {(on ? "activé" : "désactivé")}{(todo.Count > 1 ? "s" : "")}.");
    }

    /// <summary>Mode Simple : un contenu = une ligne (nom, où il sert, interrupteur Actif).</summary>
    private RenderFragment SimpleRow(Item row) => __builder =>
    {
        var use = !row.On ? "Désactivé : n'apparaît plus nulle part"
            : row.Error is { Length: > 0 } er ? "Erreur : " + er
            : row.Kind != "media" ? "Disponible"
            : row.Lists.Count == 0 ? "Pas encore diffusé"
            : $"Dans {row.Lists.Count} liste{(row.Lists.Count > 1 ? "s" : "")} · sur {row.Screens} écran{(row.Screens > 1 ? "s" : "")}";
        <div class="sr-item @(row.On ? "" : "off")">
            <AppIcon Id="@AppId" Small="true" />
            <div class="sr-in">
                @if (row.Instance) { <a href="/apps/instance/@row.Key" title="Ouvrir @row.Name">@row.Name</a> } else { <b>@row.Name</b> }
                <small>@use</small>
            </div>
            <button type="button" class="switch @(row.On ? "on" : "")" role="switch" aria-checked="@(row.On ? "true" : "false")" aria-label="@(row.On ? "Désactiver" : "Activer") @row.Name" @onclick="() => ToggleContent(row)"><span></span></button>
        </div>
    };

    private RenderFragment RowView(Item row) => __builder =>
    {
        if (row.Kind == "plan")
        {
            <tr>
                <td><div class="nm"><AppIcon Id="@AppId" Small="true" /><a href="/plans/@(row.Key)?back=@PlanBack" title="Ouvrir @row.Name">@row.Name</a></div></td>
                <td><small>@row.Lists.ElementAtOrDefault(0)</small></td>
                <td><small>@row.Lists.ElementAtOrDefault(1)</small></td>
                <td class="num">@row.Screens</td>
                <td><small>@(row.Added is { } md ? md.ToLocalTime().ToString("dd.MM.yyyy") : "—")</small></td>
                <td>@if (row.Screens > 0) { <span class="int-pill ok"><i></i>Affiché</span> } else { <span class="int-pill off"><i></i>Pas affiché</span> }</td>
                <td><a class="btn ghost sm" href="/plans/@(row.Key)?back=@PlanBack">Ouvrir</a></td>
            </tr>
            return;
        }
        <tr class="@(row.On ? "" : "off")">
            <td><div class="nm"><AppIcon Id="@AppId" Small="true" />@if (row.Instance) { <a href="/apps/instance/@row.Key" title="Ouvrir @row.Name">@row.Name</a> } else { <span>@row.Name</span> }</div></td>
            <td><small>@row.Type</small></td>
            <td>@if (row.Kind != "media") { <small>—</small> } else if (row.Lists.Count == 0) { <small>Aucune</small> } else { @string.Join(", ", row.Lists.Take(2))@if (row.Lists.Count > 2) { <small> +@(row.Lists.Count - 2)</small> } }</td>
            <td class="num">@(row.Kind == "media" ? row.Screens.ToString() : "—")</td>
            <td><small>@(row.Added is { } ad ? ad.ToLocalTime().ToString("dd.MM.yyyy") : "—")</small></td>
            <td>@if (!row.On) { <span class="int-pill off"><i></i>Désactivé</span> } else if (row.Error is { Length: > 0 } er) { <span class="int-pill bad" title="@er"><i></i>Erreur</span> } else if (row.Kind != "media") { <span class="int-pill ok"><i></i>Disponible</span> } else if (row.Lists.Count == 0) { <span class="int-pill off"><i></i>Inutilisé</span> } else if (row.Screens == 0) { <span class="int-pill off"><i></i>Pas diffusé</span> } else { <span class="int-pill ok"><i></i>Diffusé</span> }</td>
            <td><button type="button" class="switch sm @(row.On ? "on" : "")" role="switch" aria-checked="@(row.On ? "true" : "false")" aria-label="@(row.On ? "Désactiver" : "Activer") @row.Name" @onclick="() => ToggleContent(row)"><span></span></button></td>
        </tr>
    };

