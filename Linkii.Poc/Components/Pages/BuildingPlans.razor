@page "/plans"
@page "/plans/nouveau"
@page "/plans/{PlanId:guid}"
@attribute [Microsoft.AspNetCore.Authorization.Authorize(Policy = "Page:widgets")]
@inject TenantStore Store
@inject Toaster Toast
@inject ModeService Modes
@inject NavigationManager Nav

@* Plans du bâtiment (§194) : la liste. Un plan s'ouvre dans un tiroir sur toute la largeur à droite du menu (§203, /plans/{id}) : plan, affichages et
   « où il s'affiche » (HaPlanPanel). Un plan modifié se met à jour sur tous les écrans qui l'affichent. La page n'existe que si Home Assistant est connecté
   (onglet de Contenus, mode expert). *@
<div class="page-head">
    <div>
        <h1>Plans du bâtiment<span class="lx-cntpill">@plans.Count</span></h1>
        <p class="sub sc-intro">Vos plans de bâtiment. Ouvrez un plan pour le dessiner, régler ses affichages (diffusion, borne, compact) et choisir où il s'affiche.</p>
    </div>
    @if (account != null) { <div class="head-actions"><button type="button" class="btn" @onclick="NewPlan"><Ico Name="plus" Size="16" /> Nouveau plan</button></div> }
</div>

@if (!Modes.Expert)
{
    <div class="card empty"><div class="big">Disponible en mode expert</div></div>
}
else if (account == null)
{
    <div class="card empty"><div class="big">Home Assistant n'est pas connecté</div><p>Connectez-le dans <a href="/integrations">Intégrations</a> pour dessiner vos plans.</p></div>
}
else if (plans.Count == 0)
{
    <div class="card empty">
        <div class="big">Aucun plan</div>
        <p>Un plan réunit vos étages et les appareils de Home Assistant. Créez-le une fois, affichez-le sur autant d'écrans que vous voulez.</p>
        <button type="button" class="btn" @onclick="NewPlan"><Ico Name="plus" Size="16" /> Créer un plan</button>
    </div>
}
else
{
    <div class="hpp-grid">
        @foreach (var p in plans)
        {
            var plan = HomeAssistantRules.ParsePlan(p.Json);
            var id = p.Id;
            var n = used.GetValueOrDefault(id);
            <article class="hpp-card">
                <button type="button" class="hpp-th" aria-label="Ouvrir « @p.Name »" @onclick="() => Open(p)">
                    @if (HaPlanThumb.Best(plan) is { } df) { <HaPlanThumb Floor="df" Devices="plan.Devices" /> }
                    else if (plan.Floors.FirstOrDefault(f => f.Img != null)?.Img is { } img) { <span style="background-image:url('@img')"></span> }
                    else { <Ico Name="home" Size="34" /> }
                </button>
                <div class="hpp-t">
                    <b>@p.Name</b>
                    <small>@plan.Floors.Count étage@(plan.Floors.Count > 1 ? "s" : "") · @plan.Devices.Count appareil@(plan.Devices.Count > 1 ? "s" : "")</small>
                    <small class="hpp-used"><Ico Name="monitor" Size="13" /> @Math.Max(p.Views.Count, 3) affichages · @(n == 0 ? "affiché nulle part" : $"affiché {n} fois")</small>
                </div>
                <div class="hpp-a">
                    @if (confirmDelete == id)
                    {
                        <span class="hpp-ask">Supprimer ce plan ?</span>
                        <button type="button" class="btn sm danger" @onclick="() => Delete(p)">Supprimer</button>
                        <button type="button" class="btn ghost sm" @onclick="() => confirmDelete = null">Annuler</button>
                    }
                    else
                    {
                        <button type="button" class="btn sm" @onclick="() => Open(p)">Ouvrir le plan</button>
                        <button type="button" class="btn ghost sm" @onclick="() => Duplicate(p)">Dupliquer</button>
                        <button type="button" class="btn ghost sm icon" title="Supprimer « @p.Name »" aria-label="Supprimer « @p.Name »" @onclick="() => confirmDelete = id"><Ico Name="trash" Size="14" /></button>
                    }
                </div>
            </article>
        }
    </div>
}

@if (Modes.Expert && account != null && (PlanId != null || NewOpen))
{
    <div class="lx-drawer-veil" @onclick="CloseDrawer"></div>
    <aside class="lx-drawer hpd" role="dialog" aria-label="Plan du bâtiment">
        <HaPlanPanel @key="@(PlanId?.ToString() ?? "nouveau")" PlanId="PlanId" Onglet="@Onglet" OnChanged="Load" />
    </aside>
}

@code {
    /// <summary>Plan ouvert dans le tiroir (/plans/{id}) ; /plans/nouveau : un nouveau plan.</summary>
    [Parameter] public Guid? PlanId { get; set; }
    [SupplyParameterFromQuery(Name = "onglet")] public string? Onglet { get; set; }
    private bool NewOpen => Nav.ToBaseRelativePath(Nav.Uri).Split('?')[0].TrimEnd('/') == "plans/nouveau";
    private void CloseDrawer() => Nav.NavigateTo("/plans");
    private List<HaPlan> plans = new();
    private HomeAssistantAccount? account;
    private Dictionary<Guid, int> used = new();
    private Guid? confirmDelete;

    protected override void OnInitialized() => Load();

    private void Load()
    {
        var t = Store.Read(d => (d.Tenant.HomeAssistant, d.Tenant.HaPlans.ToList()));
        account = t.HomeAssistant;
        plans = t.Item2.OrderBy(p => p.Name, StringComparer.CurrentCultureIgnoreCase).ToList();
        used = UsageOf();
    }

    /// <summary>Plan → nombre d'utilisations : contenus de liste, tuiles de borne, widgets des écrans et des bornes (toute l'organisation, §202).</summary>
    private Dictionary<Guid, int> UsageOf() => Store.Read(d => HaPlanUses.CountByPlan(d));

    private void NewPlan() => Nav.NavigateTo("/plans/nouveau");

    private void Open(HaPlan p) => Nav.NavigateTo($"/plans/{p.Id}");

    private void Duplicate(HaPlan p)
    {
        var name = $"{p.Name} (copie)";
        var copy = new HaPlan { Name = name, Json = p.Json, ViewsVersion = p.ViewsVersion, Views = p.Views.Select(v => { var c = HaViews.Normalize(v, HomeAssistantRules.ParsePlan(p.Json)); c.Id = Guid.NewGuid(); return c; }).ToList() };
        Store.Write(d => d.Tenant.HaPlans.Add(copy));
        Toast.Ok($"Plan « {name} » créé.");
        Load();
    }

    private void Delete(HaPlan p)
    {
        confirmDelete = null;
        if (used.GetValueOrDefault(p.Id) is var n && n > 0) { Toast.Error($"« {p.Name} » est affiché {n} fois : retirez-le de ces écrans, listes et bornes d'abord (onglet « Où il s'affiche » du plan)."); return; }
        Store.Write(d => d.Tenant.HaPlans.RemoveAll(x => x.Id == p.Id));
        Toast.Ok($"Plan « {p.Name} » supprimé.");
        Load();
    }
}
