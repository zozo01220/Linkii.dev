@code {
    private List<Screen> screens = new();
    private List<Playlist> playlists = new();
    private List<MediaItem> media = new();
    private Tenant tenant = new();
    private string code = "", name = "";
    private Guid? playlistId;
    private string? error;
    private bool showPair;
    private Timer? timer;
    private Guid? menuFor, editing;
    private Guid? simScreen, simWall;   // simulateur ouvert : un écran, ou un mur entier
    private List<Screen>? deleting;   // écrans en attente de confirmation de suppression
    private string view = "cards";   // cards | list (mémorisé dans le navigateur)
    private bool ListView => Modes.Expert && view == "list";   // la vue en liste est une fonction du mode expert
    private readonly HashSet<Guid> expandedWalls = new();   // murs dont la liste d'écrans est dépliée (vignettes)
    private void ToggleWallMembers(Guid id) { if (!expandedWalls.Remove(id)) expandedWalls.Add(id); }

    protected override void OnInitialized()
    {
        tenant = Store.Read(d => d.Tenant);
        Reload();
        timer = new Timer(_ => InvokeAsync(() => { Reload(); StateHasChanged(); }), null, 3000, 3000);   // état en ligne / hors ligne
    }

    private string Status(Screen s) => Store.Read(d => d.Status(s));

    // ---------- Contrôle du direct (Growth) ----------
    private bool Growth => tenant.IsGrowth;
    private Guid? liveFor;
    private string? liveAction;
    private static readonly MarkupString LockIcon = new("<svg class=\"lk\" width=\"12\" height=\"12\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" aria-hidden=\"true\"><rect x=\"5\" y=\"11\" width=\"14\" height=\"9\" rx=\"2\"/><path d=\"M8 11V8a4 4 0 0 1 8 0v3\"/></svg>");

    // En licence de base le bouton ne fait rien (il est verrouillé : la bulle explique pourquoi).
    private void OpenLive(Screen s, string? action) { if (Growth) { liveFor = s.Id; liveAction = action; } }

    private Guid? liveWall;
    private void OpenWallLive(Zone wall, string? action) { if (Growth) { liveWall = wall.Id; liveAction = action; } }

    private void CloseLive() { liveFor = null; liveWall = null; liveAction = null; Reload(); }

    private string LocalTime(DateTime utc)
    {
        try { utc = TimeZoneInfo.ConvertTimeFromUtc(DateTime.SpecifyKind(utc, DateTimeKind.Utc), TimeZoneInfo.FindSystemTimeZoneById(tenant.Timezone)); }
        catch (Exception ex) when (ex is TimeZoneNotFoundException or InvalidTimeZoneException) { }
        return utc.ToString("HH:mm");
    }

    // Libellé du bandeau d'un écran hors ligne : « Hors ligne depuis 3 h » (ou « Jamais connecté »)
    private static string OfflineSince(Screen s, DateTime now)
    {
        if (s.LastSeenUtc is not { } seen) return "Jamais connecté";
        var d = now - seen;
        return "Hors ligne depuis " + (d.TotalMinutes < 60 ? $"{Math.Max(1, (int)d.TotalMinutes)} min" : d.TotalHours < 24 ? $"{(int)d.TotalHours} h" : $"{(int)d.TotalDays} j");
    }

    // Premier contenu plein écran d'une liste de lecture : vignette de sa zone sur la carte.
    private MediaItem? ZoneThumb(Playlist? p) =>
        p?.Draft.Where(i => i.Placement == "full").Select(i => media.FirstOrDefault(m => m.Id == i.MediaId)).FirstOrDefault(m => m != null);

    // « Accueil · Menus · — » : playlist de chaque zone, dans l'ordre.
    private string ZonesSummary(Screen s)
    {
        var names = s.ZonePlaylists().Select(id => playlists.FirstOrDefault(p => p.Id == id)?.Name ?? "—").ToList();
        return names.All(n => n == "—") ? "Aucune liste de lecture" : string.Join(" · ", names);
    }

    // ---------- Aire de gestion ouverte, zones, déplacements ----------
    private Area? area;
    private List<Zone> zones = new();
    private List<Area> otherAreas = new();   // déplacement : administrateur de l'organisation, vers une autre aire
    private bool manageZones, zoneMove, noArea;
    private string? zoneFilter;   // null : toutes les zones ; sinon l'Id de la zone
    private string pairZone = "", zoneTo = "";
    private ScreenSpec pairSpec = new();
    private List<(Guid Id, string Name)>? areaMove;   // écrans à déplacer vers une autre aire

    private Zone? ZoneOf(Screen s) => zones.FirstOrDefault(z => z.Id == s.ZoneId) ?? zones.FirstOrDefault(z => z.IsDefault);

    // La barre des zones n'apparaît que s'il y a de quoi choisir : une zone en plus de la zone par défaut, ou une synchro active.
    private bool ShowZones => zones.Count > 1 || zones.Any(z => z.Sync);
    private HashSet<Guid> synced = new();   // écrans alignés avec au moins un autre (zone synchronisée, même liste publiée)

    private string statusFilter = "", search = "", sort = "name";   // statusFilter : "" | online | offline | pending

    private bool IsOffline(Screen s) => Status(s) is not ("En ligne" or "Mise à jour");

    // Écrans de la zone ouverte : base des compteurs du filtre d'état.
    private List<Screen> InZone => zoneFilter == null ? screens : screens.Where(x => ZoneOf(x)?.Id.ToString() == zoneFilter).ToList();

    private List<Screen> Shown
    {
        get
        {
            var q = InZone.Where(s => statusFilter switch
            {
                "online" => !IsOffline(s),
                "offline" => IsOffline(s),
                "pending" => Helpers.HasPending(s, playlists),
                _ => true
            }).Where(s => search.Length == 0 || s.Name.Contains(search, StringComparison.OrdinalIgnoreCase));
            return (sort switch
            {
                "status" => q.OrderBy(s => IsOffline(s)).ThenBy(s => s.Name, StringComparer.CurrentCultureIgnoreCase),
                "pending" => q.OrderByDescending(s => Helpers.HasPending(s, playlists)).ThenBy(s => s.Name, StringComparer.CurrentCultureIgnoreCase),
                _ => q.OrderBy(s => s.Name, StringComparer.CurrentCultureIgnoreCase)
            }).ToList();
        }
    }

