@code {
    private List<Screen> screens = new();
    private List<Playlist> playlists = new();
    private List<MediaItem> media = new();
    private Tenant tenant = new();
    private string code = "", name = "";
    private Guid? playlistId;
    private string? error;
    private bool showPair;

    // ---------- Premier écran (assistant, voir FirstScreen) ----------
    private bool wizardOpen, wizardPairing, firstLater, firstReady;
    private int wizardStart = 1;
    private FirstScreenWizard? wizard;

    private void LoadFirstScreen() => (firstLater, firstReady) = Store.Read(d => (d.Tenant.FirstScreen == FirstScreen.Later && !FirstScreen.HasScreen(d),
        d.Tenant.FirstScreenListId is { } id && d.Playlists.Any(p => p.Id == id)));

    private void OpenWizard(int step) { wizardStart = step; wizardOpen = true; }

    private void CloseWizard() { wizardOpen = false; wizardPairing = false; Reload(); }

    /// <summary>Appairage demandé par l'assistant : mêmes règles que le tiroir (code vérifié, facturation, publication). Null si l'écran est relié.</summary>
    private async Task<string?> PairFromWizard(string c, Guid listId)
    {
        OpenPair();   // valeurs par défaut du tiroir (zone, format, plein écran), sans l'afficher
        showPair = false;
        code = c; name = "Mon écran"; playlistId = listId;
        wizardPairing = true;
        await Pair();
        if (screenPay != null) return "Validez le paiement de l'écran pour le relier.";   // la fenêtre de paiement s'affiche ; PairNow préviendra l'assistant
        wizardPairing = false;
        return error;
    }

    private Timer? timer;
    private Guid? menuFor, editing;
    private bool cleanQuery;   // paramètre « edit » à retirer de l'adresse
    private Guid? simScreen, simWall;   // simulateur ouvert : un écran, ou un mur entier
    private List<Screen>? deleting;   // écrans en attente de confirmation de suppression
    private string view = "cards";   // tree | cards | list (mémorisé dans le navigateur) ; l'arborescence est un choix (mode expert), plus l'affichage par défaut
    private bool ListView => Modes.Expert && view == "list";   // la vue en liste est une fonction du mode expert
    private readonly HashSet<Guid> expandedWalls = new();   // murs dont la liste d'écrans est dépliée (vignettes)
    private void ToggleWallMembers(Guid id) { if (!expandedWalls.Remove(id)) expandedWalls.Add(id); }

    protected override void OnInitialized()
    {
        tenant = Store.Read(d => d.Tenant);
        tab = Store.Read(d => d.Users.FirstOrDefault(u => u.Id == d.Access.UserId)?.LibraryTabs.GetValueOrDefault("screens")) ?? LibraryTab.Mine;   // onglet retenu (corrigé par LoadTabs selon la personne)
        Reload();
        wizardOpen = canAdd && !noArea && Store.Read(FirstScreen.ShouldOpen);   // nouveau compte sans écran : l'assistant du premier écran
        areaFilter = Store.Read(d => d.Users.FirstOrDefault(u => u.Id == d.Access.UserId)?.LibraryTabs.GetValueOrDefault("screens-area")) == "one" ? area?.Id.ToString() ?? "" : "";   // filtre « Aire » retenu (par défaut : toutes)
        // « Ouvrir cette aire » depuis un écran d'une autre aire : après le changement d'aire, l'écran choisi s'ouvre directement en édition
        var qs = System.Web.HttpUtility.ParseQueryString(new Uri(Nav.Uri).Query);
        if (Guid.TryParse(qs["edit"], out var wanted)) { cleanQuery = true; if (screens.Any(s => s.Id == wanted)) editing = wanted; }
        // arborescence : nœud choisi dans une autre aire, rouvert après le changement d'aire
        if (Guid.TryParse(qs["arbre"], out var ta)) { cleanQuery = true; if (ta == area?.Id) { treeArea = ta; treeZone = Guid.TryParse(qs["zone"], out var tz) && zones.Any(z => z.Id == tz) ? tz : null; } }
        if (area != null) treeOpen.Add(area.Id);
        timer = new Timer(_ => InvokeAsync(() => { Reload(); StateHasChanged(); }), null, 3000, 3000);   // état en ligne / hors ligne
    }

    private string Status(Screen s) => Store.Read(d => d.Status(s));

    // ---------- Onglets : Mes écrans / Partagés avec moi / Toute l'organisation ----------
    // Un écran appartient à la personne qui l'a connecté (Screen.OwnerId). Il n'y a pas de partage d'écran : « Partagés avec moi » rassemble
    // ceux d'un collègue que la personne voit (attribués par un administrateur). Sans propriétaire connu (écrans d'avant), l'écran est à l'administrateur.
    private string tab = LibraryTab.All;
    private record TabItem(string Key, string Label, int Count);
    private List<TabItem> Tabs = new();
    private Guid? meId;
    private bool isAdminUser, multiUser, readAllScreens;
    private HashSet<Guid> orgUsers = new();

    private void LoadTabs()
    {
        (meId, isAdminUser, multiUser, readAllScreens, orgUsers) = Store.Read(d => (d.Access.UserId, d.Access.IsOrgAdmin, d.Users.Count(u => !u.Disabled) > 1,
            !d.Access.IsOrgAdmin && d.Access.ModeOf(LevelPages.Screens) == PageMode.Read, d.Access.OrgUserIds.ToHashSet()));
        if (!multiUser || readAllScreens) tab = LibraryTab.All;   // seul dans l'organisation, ou en lecture seule : tout est affiché
        else if (tab == LibraryTab.All && !isAdminUser) tab = LibraryTab.Mine;
    }

    private bool InTab(string t, Screen s)
    {
        Guid? owner = s.OwnerId is { } x && orgUsers.Contains(x) ? x : null;   // un propriétaire hors de l'organisation (équipe Linkivi) vaut « l'organisation »
        return LibraryTab.InTab(t, new LibraryTab.Info(owner, owner, false), meId, isAdminUser);
    }

    // Les écrans de l'onglet ; un mur reste entier : il apparaît dès qu'un de ses écrans est dans l'onglet
    private List<Screen> TabFilter(IEnumerable<Screen> list, IEnumerable<Zone> areaZones)
    {
        var l = list.ToList();
        if (tab == LibraryTab.All) return l;
        var walls = areaZones.Where(z => z.IsWall).Select(z => z.Id).ToHashSet();
        var kept = l.Where(s => s.ZoneId is { } z && walls.Contains(z) && InTab(tab, s)).Select(s => s.ZoneId!.Value).ToHashSet();
        return l.Where(s => s.ZoneId is { } z && kept.Contains(z) || InTab(tab, s)).ToList();
    }

    // Les écrans des autres aires suivent le même onglet ; les onglets sont dressés avec ce qui n'est pas encore filtré
    private void BuildTabs()
    {
        var sharedCount = groupAreas.SelectMany(g => g.Screens).Count(s => InTab(LibraryTab.Shared, s));
        groupAreas = groupAreas.Select(g => g.Area.Id == area?.Id ? g : g with { Screens = TabFilter(g.Screens, g.Area.Zones) }).ToList();
        Tabs = !multiUser || readAllScreens ? new()
            : new List<TabItem> { new(LibraryTab.Mine, "Mes écrans", 0), new(LibraryTab.Shared, "Partagés avec moi", sharedCount) }
                .Concat(isAdminUser ? [new TabItem(LibraryTab.All, "Toute l'organisation", 0)] : Array.Empty<TabItem>()).ToList();
    }

    // Dossiers de l'onglet : ceux qui contiennent un de ses écrans (et leurs parents) ; dans « Mes écrans », aussi les siens, même vides
    private void FilterFolders()
    {
        if (tab == LibraryTab.All) return;
        var byId = folderRows.ToDictionary(r => r.Folder.Id);
        var keep = new HashSet<Guid>();
        void Up(Guid? id) { for (var cur = id; cur is { } f && byId.TryGetValue(f, out var r) && keep.Add(f); cur = r.Folder.ParentId) { } }
        foreach (var s in screens) Up(s.FolderId);
        if (tab == LibraryTab.Mine) foreach (var r in folderRows.Where(r => r.Folder.OwnerId == meId || isAdminUser && r.Folder.OwnerId == null)) Up(r.Folder.Id);
        folderRows = folderRows.Where(r => keep.Contains(r.Folder.Id)).ToList();
    }

    private void SetTab(string t)
    {
        tab = t; folderId = null; selectedIds.Clear(); pickOrder.Clear(); menuFor = null;
        try { Store.Write(d => { if (d.Users.FirstOrDefault(u => u.Id == d.Access.UserId) is { } u) u.LibraryTabs["screens"] = t; }); }
        catch (Exception) { }   // l'onglet retenu est un confort : sans lui, la page s'ouvre sur « Mes écrans »
        Reload();
    }

    // ---------- Contrôle du direct (Pro) ----------
    private bool Growth => tenant.IsGrowth;
    private Guid? liveFor;
    private string? liveAction;
    private static readonly MarkupString LockIcon = new("<svg class=\"lk\" width=\"12\" height=\"12\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" aria-hidden=\"true\"><rect x=\"5\" y=\"11\" width=\"14\" height=\"9\" rx=\"2\"/><path d=\"M8 11V8a4 4 0 0 1 8 0v3\"/></svg>");

    // En licence Essential le bouton ne fait rien (il est verrouillé : la bulle explique pourquoi).
    private void OpenLive(Screen s, string? action) { if (Growth) { liveFor = s.Id; liveAction = action; } }

    private Guid? liveWall;
    private void OpenWallLive(Zone wall, string? action) { if (Growth) { liveWall = wall.Id; liveAction = action; } }

    private void CloseLive() { liveFor = null; liveWall = null; liveAction = null; Reload(); }

    /// <summary>Pastille de planning d'une carte écran : le créneau en cours (jusqu'à quand) ou le prochain ; null si l'écran n'a aucun créneau à venir.</summary>
    private (bool Live, string Text, string Tip)? PlanPill(Screen s)
    {
        var eff = Planning.Effective(area, s);
        if (eff.Count == 0) return null;
        var l = Planning.LocalNow(tenant, area, DateTime.UtcNow);
        var date = DateOnly.FromDateTime(l);
        var min = l.Hour * 60 + l.Minute;
        string Name(Slot x) => playlists.FirstOrDefault(p => p.Id == x.PlaylistId)?.Name ?? "liste supprimée";
        if (Planning.Pick(eff, date, min) is { } hit)
        {
            var end = Planning.Hm(hit.To % Planning.Day);
            return (true, "Jusqu'à " + end, "Planning : « " + Name(hit) + " » jusqu'à " + end);
        }
        if (Planning.Next(eff, date, min) is { } n)
        {
            var when = n.Date == date ? Planning.Hm(n.Slot.From) : Planning.DayNames[((int)n.Date.DayOfWeek + 6) % 7] + " " + Planning.Hm(n.Slot.From);
            return (false, "Prochain : " + Name(n.Slot) + " à " + when, "Planning : prochain créneau « " + Name(n.Slot) + " » à " + when);
        }
        return null;
    }

    private string LocalTime(DateTime utc)
    {
        try { utc = TimeZoneInfo.ConvertTimeFromUtc(DateTime.SpecifyKind(utc, DateTimeKind.Utc), TimeZoneInfo.FindSystemTimeZoneById(tenant.Timezone)); }
        catch (Exception ex) when (ex is TimeZoneNotFoundException or InvalidTimeZoneException) { }
        return utc.ToString("HH:mm");
    }

    // Libellé du bandeau d'un écran hors ligne : « Hors ligne depuis 3 h » (ou « Jamais connecté »)
    private static string OfflineSince(Screen s, DateTime now)
    {
        if (s.LastSeenUtc is not { } seen) return "Jamais connecté";
        var d = now - seen;
        return "Hors ligne depuis " + (d.TotalMinutes < 60 ? $"{Math.Max(1, (int)d.TotalMinutes)} min" : d.TotalHours < 24 ? $"{(int)d.TotalHours} h" : $"{(int)d.TotalDays} j");
    }

