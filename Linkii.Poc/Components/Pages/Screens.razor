    // ---------- Mise en veille (action groupée) ----------
    private bool sleepDlg;
    private string sleepMode = Sleep.Inherit;
    private string? sleepGrid;

    private string SleepNames => string.Join(", ", screens.Where(s => selectedIds.Contains(s.Id)).Select(s => s.Name).Take(6)) + (selectedIds.Count > 6 ? "…" : "");

    private void OpenSleep()
    {
        // les écrans d'un mur suivent la mise en veille de leur aire : ils ne se règlent pas un par un
        if (screens.FirstOrDefault(s => selectedIds.Contains(s.Id) && ZoneOf(s) is { IsWall: true }) is { } inWall)
        {
            Toast.Error($"« {inWall.Name} » fait partie du mur « {ZoneOf(inWall)!.Name} » : il suit la mise en veille de son aire.");
            return;
        }
        (sleepMode, sleepGrid) = (Sleep.Inherit, null);
        sleepDlg = true;
    }

    /// <summary>L'écran est-il en veille en ce moment ? (menu ⋮ : « Réveiller »)</summary>
    private bool IsAsleep(Screen s, bool inWall = false) => Sleep.State(tenant, area, s, inWall, DateTime.UtcNow).Asleep;

    /// <summary>Mise en veille manuelle : l'écran dort jusqu'à « Réveiller », quelles que soient ses plages.</summary>
    private async Task SleepNow(IEnumerable<Screen> list)
    {
        var ids = list.Select(s => s.Id).ToList();
        Store.Write(d => { foreach (var sc in d.Screens.Where(x => ids.Contains(x.Id))) { sc.ForcedSleep = true; sc.WakeUntilUtc = null; } });
        foreach (var id in ids) await Notifier.NotifyScreen(id);   // un écran éveillé s'éteint aussitôt
        Toast.Ok(ids.Count > 1 ? $"{ids.Count} écrans mis en veille jusqu'au réveil." : "Écran mis en veille jusqu'au réveil.");
        Reload();
    }

    /// <summary>Réveil manuel : les écrans restent éveillés une heure malgré leurs plages (Sleep.WakeMinutes), puis reprennent leur veille.</summary>
    private async Task Wake(IEnumerable<Screen> list)
    {
        var ids = list.Select(s => s.Id).ToList();
        var until = DateTime.UtcNow.AddMinutes(Sleep.WakeMinutes);
        Store.Write(d => { foreach (var sc in d.Screens.Where(x => ids.Contains(x.Id))) { sc.WakeUntilUtc = until; sc.ForcedSleep = false; } });
        foreach (var id in ids) await Notifier.NotifyScreen(id);   // les écrans éveillés reçoivent le réveil ; ceux qui dorment le relèvent à la minute suivante
        Toast.Ok(ids.Count > 1 ? $"{ids.Count} écrans réveillés pour {Sleep.WakeMinutes} min." : $"Écran réveillé pour {Sleep.WakeMinutes} min.");
        Reload();
    }

    private async Task ApplySleep()
    {
        var ids = selectedIds.ToList();
        var (mode, grid) = (sleepMode, Sleep.Valid(sleepGrid) ? sleepGrid : null);
        if (mode == Sleep.Own && !Sleep.Any(grid)) { Toast.Error("Peignez au moins une plage de veille, ou choisissez « Jamais en veille »."); return; }
        Store.Write(d => { foreach (var sc in d.Screens.Where(x => ids.Contains(x.Id))) { sc.SleepMode = mode; sc.SleepGrid = mode == Sleep.Own ? grid : null; } });
        Toast.Ok($"Mise en veille appliquée à {ids.Count} écran{(ids.Count > 1 ? "s" : "")}.");
        sleepDlg = false;
        foreach (var id in ids) await Notifier.NotifyScreen(id);   // les écrans rechargent leur configuration
        selectedIds.Clear();
        Reload();
    }

    private async Task MoveToZone()
    {
        var zid = Guid.TryParse(zoneTo, out var g) && FreeZones.Any(z => z.Id == g) ? g : zones.First(z => z.IsDefault).Id;
        var ids = selectedIds.ToList();
        Store.Write(d => { foreach (var sc in d.Screens.Where(x => ids.Contains(x.Id))) sc.ZoneId = zid; });
        Toast.Ok($"{ids.Count} écran{(ids.Count > 1 ? "s" : "")} dans la zone « {zones.First(z => z.Id == zid).Name} ».");
        zoneMove = false;
        await Notifier.PublishPlanning(ids);   // leur zone change : elles reçoivent les listes du planning de la nouvelle zone (et la synchro peut changer)
        foreach (var id in ids) await Notifier.NotifyScreen(id);
        selectedIds.Clear();
        Reload();
    }

