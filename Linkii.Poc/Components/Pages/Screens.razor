    // Glisser-déposer : un écran (ou tous ceux qui sont cochés), ou un dossier, vers un dossier ou la racine (null)
    private bool CanDragScreen(Screen s) => canAdd && !isApp && ZoneOf(s) is not { IsWall: true };
    private void StartDrag(Screen s) => dragIds = selectedIds.Contains(s.Id) ? selectedIds.ToList() : new List<Guid> { s.Id };
    private void EndDrag() { dragIds = new(); dragFolder = null; dropOver = null; }

    private void DropOn(Guid? target)
    {
        if (dragFolder is { } df)   // un dossier glissé sur un autre : il y entre
        {
            EndDrag();
            if (target is { } t && t != df) { var err = Folders.MoveFolder(df, t); if (err != null) Toast.Error(err); else Toast.Ok("Dossier déplacé."); Reload(); }
            return;
        }
        var ids = dragIds.ToList();
        EndDrag();
        if (ids.Count == 0) return;
        var (moved, refused) = Folders.MoveScreens(ids, target);
        if (refused.Count > 0) Toast.Error(refused[0] + (refused.Count > 1 ? $" (et {refused.Count - 1} autre{(refused.Count > 2 ? "s" : "")})" : ""));
        if (moved > 0) { selectedIds.Clear(); pickOrder.Clear(); Toast.Ok(moved > 1 ? $"{moved} écrans rangés." : "Écran rangé."); }
        Reload();
    }

