    // ---------- Affichage « Arborescence » (mode expert) : aires › zones › écrans ----------
    // Arbre des aires et zones à gauche, compteurs cliquables, une section repliable par aire (vignettes ou lignes).
    // Une aire choisie dans l'arbre montre les cartes habituelles ; une autre aire que celle ouverte s'ouvre d'abord (changement d'aire).
    private bool isApp;   // look app : l'arborescence n'est pas proposée
    private bool TreeView => Modes.Expert && view == "tree" && !isApp;
    private Guid? treeArea, treeZone;   // nœud choisi (aucun : toutes les aires)
    private readonly HashSet<Guid> treeOpen = new(), treeFolded = new();   // aires dépliées dans l'arbre, sections repliées
    private string treeFilter = "";   // compteur choisi : "" | on | off | sleep | pend
    private string treeDens = "tiles";   // tiles | rows
    private List<TArea> treeData = new();

    private record TScreen(Screen S, string Kind, bool Pending, string? Wake);   // Kind : on | off | sleep | pause
    private record TZone(Zone Zone, List<TScreen> Screens);
    private record TArea(Area Area, bool Own, List<TZone> Zones, GroupArea Group)
    {
        public IEnumerable<TScreen> All => Zones.SelectMany(z => z.Screens);
    }
    private record TCount(int N, int On, int Off, int Sleep, int Pend);

    private List<Screen> AllScreens => screens.Concat(groupAreas.Where(g => g.Area.Id != area?.Id).SelectMany(g => g.Screens)).ToList();

    private List<TArea> TreeData()
    {
        var now = DateTime.UtcNow;
        return groupAreas.Select(g =>
        {
            var own = g.Area.Id == area?.Id;
            var list = own ? screens : g.Screens;
            var zs = own ? zones : g.Area.Zones.OrderByDescending(z => z.IsDefault).ThenBy(z => z.Name, StringComparer.CurrentCultureIgnoreCase).ToList();
            var def = zs.FirstOrDefault(z => z.IsDefault);
            var lists = g.Lists.Values.ToList();
            var tz = zs.Select(z => new TZone(z, list.Where(s => (zs.FirstOrDefault(x => x.Id == s.ZoneId) ?? def)?.Id == z.Id)
                    .OrderBy(s => z.IsWall ? s.WallPos ?? int.MaxValue : 0).ThenBy(s => s.Name, StringComparer.CurrentCultureIgnoreCase)
                    .Select(s =>
                    {
                        var sl = Sleep.State(tenant, g.Area, s, z.IsWall, now);
                        var kind = sl.Asleep ? "sleep" : s.IsPaused(now) ? "pause" : IsOffline(s) ? "off" : "on";
                        return new TScreen(s, kind, Helpers.HasPending(s, own ? playlists : lists), sl.Wake);
                    }).ToList()))
                .Where(z => z.Screens.Count > 0).ToList();
            return new TArea(g.Area, own, tz, g);
        }).Where(a => a.Own || a.Zones.Count > 0).ToList();
    }

    // aires retenues par le filtre « Aire de gestion »
    private List<TArea> TreeScope => treeData.Where(a => areaFilter == "" || areaFilter == a.Area.Id.ToString()).ToList();
    private static List<Guid> TreePending(IEnumerable<TArea> data) => data.SelectMany(a => a.All).Where(t => t.Pending).Select(t => t.S.Id).ToList();

    private static TCount TCountOf(IEnumerable<TScreen> src)
    {
        var l = src.ToList();
        return new(l.Count, l.Count(t => t.Kind == "on"), l.Count(t => t.Kind == "off"), l.Count(t => t.Kind is "sleep" or "pause"), l.Count(t => t.Pending));
    }

    private bool TMatch(TScreen t, TZone z, TArea a) =>
        (search.Length == 0 || $"{t.S.Name} {z.Zone.Name} {a.Area.Name}".Contains(search, StringComparison.OrdinalIgnoreCase))
        && treeFilter switch { "on" => t.Kind == "on", "off" => t.Kind == "off", "sleep" => t.Kind is "sleep" or "pause", "pend" => t.Pending, _ => true }
        && statusFilter switch { "online" => !IsOffline(t.S), "offline" => IsOffline(t.S), "pending" => t.Pending, _ => true };

    private static string TDot(string kind) => kind switch { "off" => "hors-ligne", "sleep" => "veille", "pause" => "pause", _ => "en-ligne" };

    private string TState(TScreen t) => t.Kind switch
    {
        "off" => OfflineSince(t.S, DateTime.UtcNow),
        "sleep" => "En veille" + (t.Wake is { } w ? " · réveil " + w : ""),
        "pause" => "En pause" + (t.S.PausedUntilUtc is { } pu ? " · reprise " + LocalTime(pu) : ""),
        _ => "En ligne"
    };

    private string? TListName(TArea a, Guid? id) => id is not { } pid ? null : a.Own ? playlists.FirstOrDefault(p => p.Id == pid)?.Name : a.Group.Lists.TryGetValue(pid, out var p) ? p.Name : null;

    private string TPl(TArea a, Screen s) => s.ZoneCount == 1 ? TListName(a, s.PlaylistId) ?? "Aucune liste de lecture"
        : string.Join(" · ", s.ZonePlaylists().Select(id => TListName(a, id) ?? "—")) + $" · {s.ZoneCount} zones";

    private static MediaItem? FirstFull(Playlist? p, List<MediaItem> all) =>
        p?.Draft.Where(i => i.Placement == "full").Select(i => all.FirstOrDefault(m => m.Id == i.MediaId)).FirstOrDefault(m => m != null);

    private void SelectNode(TArea? a, Guid? zoneId)
    {
        CloseMenu();
        if (a == null) { treeArea = null; treeZone = null; return; }
        if (!a.Own)
        {
            // une autre aire : on l'ouvre (comme « Ouvrir cette aire »), le nœud est rouvert après le rechargement
            if (Store.SwitchArea(a.Area.Id))
                Nav.NavigateTo(Nav.GetUriWithQueryParameters(new Dictionary<string, object?> { ["arbre"] = a.Area.Id.ToString(), ["zone"] = zoneId?.ToString() }), forceLoad: true);
            return;
        }
        treeArea = a.Area.Id; treeZone = zoneId; treeOpen.Add(a.Area.Id);
    }

    private void OpenTreeScreen(TArea a, Screen s) { if (a.Own) Edit(s); else OpenAreaPage(a.Area.Id, s.Id); }

    private void ToggleTreeOpen(Guid id) { if (!treeOpen.Remove(id)) treeOpen.Add(id); }

    private void ToggleFold(Guid id) { if (!treeFolded.Remove(id)) treeFolded.Add(id); treeFilter = ""; }

    private void TreeAll(bool open, List<TArea> data)
    {
        foreach (var a in data)
        {
            if (open) { treeOpen.Add(a.Area.Id); treeFolded.Remove(a.Area.Id); }
            else { treeOpen.Remove(a.Area.Id); treeFolded.Add(a.Area.Id); }
        }
    }

    private void PickTreeFilter(string f) => treeFilter = f == "" || treeFilter == f ? "" : f;

    private async Task SetDens(string d)
    {
        treeDens = d;
        try { await JS.InvokeVoidAsync("linkiiPrefs.set", "screens-densite", d); } catch (JSException) { }
    }

    private void SelectPane(IEnumerable<Screen> list)
    {
        CloseMenu();
        foreach (var s in list.Where(s => !selectedIds.Contains(s.Id))) { selectedIds.Add(s.Id); pickOrder.Add(s.Id); }
    }

    private RenderFragment TreeBody() => __builder =>
    {
        var data = TreeScope;
        var sel = data.FirstOrDefault(a => a.Own && a.Area.Id == treeArea);
        <div class="tr-wrap">
            @TreeNav(data, sel)
            <div class="tr-pane">@if (sel != null) { @TreePaneArea(sel) } else { @TreePaneAll(data) }</div>
        </div>
    };

    private RenderFragment TreeNav(List<TArea> data, TArea? sel) => __builder =>
    {
        var all = TCountOf(data.SelectMany(a => a.All));
        <nav class="tr-tree" aria-label="Aires et zones">
            <h5>Aires de gestion · @data.Count</h5>
            <button type="button" class="tr-node root @(sel == null ? "on" : "")" @onclick="() => SelectNode(null, null)"><Ico Name="layers" Size="16" /><span class="lbl">Toutes les aires</span>@if (all.Off > 0) { <span class="bad" title="Hors ligne">@all.Off</span> }<span class="n">@all.N</span></button>
            <div class="tr-sep"></div>
            @foreach (var a in data)
            {
                var ta = a;
                var c = TCountOf(ta.All);
                var op = treeOpen.Contains(ta.Area.Id);
                <button type="button" class="tr-node @(op ? "open" : "") @(sel == ta && treeZone == null ? "on" : "")" title="@(ta.Own ? null : "Ouvrir l'aire « " + ta.Area.Name + " »")" @onclick="() => SelectNode(ta, null)">
                    <span class="tw" role="button" aria-label="@(op ? "Replier" : "Déplier") @ta.Area.Name" @onclick="() => ToggleTreeOpen(ta.Area.Id)" @onclick:stopPropagation="true"><Ico Name="chevron" Size="14" /></span>
                    <span class="lbl">@ta.Area.Name</span>
                    @if (ta.Own) { <span class="open-tag" title="Aire ouverte dans le back-office">ouverte</span> }
                    @if (c.Pend > 0) { <span class="pdot" title="Modifications à publier"></span> }
                    @if (c.Off > 0) { <span class="bad" title="Hors ligne">@c.Off</span> }
                    <span class="n">@c.N</span>
                </button>
                @if (op)
                {
                    <div class="tr-kids">
                        @foreach (var z in ta.Zones)
                        {
                            var tz = z;
                            var zc = TCountOf(tz.Screens);
                            <button type="button" class="tr-node @(sel == ta && treeZone == tz.Zone.Id ? "on" : "")" @onclick="() => SelectNode(ta, tz.Zone.Id)"><Ico Name="@(tz.Zone.IsWall ? "grid" : "box")" Size="14" /><span class="lbl">@tz.Zone.Name</span>@if (zc.Off > 0) { <span class="bad">@zc.Off</span> }<span class="n">@zc.N</span></button>
                        }
                    </div>
                }
            }
            <div class="tr-sep"></div>
            <div class="tr-foot"><button type="button" class="linklike" @onclick="() => TreeAll(true, data)">Tout déplier</button> · <button type="button" class="linklike" @onclick="() => TreeAll(false, data)">Tout replier</button></div>
        </nav>
    };

    private RenderFragment TreeKpis(IEnumerable<TScreen> list) => __builder =>
    {
        var c = TCountOf(list);
        <div class="tr-kpis">
            <button type="button" class="tr-kpi" title="Tout afficher" @onclick='() => PickTreeFilter("")'><b>@c.N</b><small><Ico Name="layers" Size="13" />Écrans</small></button>
            <button type="button" class="tr-kpi @(treeFilter == "on" ? "on" : "")" aria-pressed="@(treeFilter == "on" ? "true" : "false")" @onclick='() => PickTreeFilter("on")'><b>@c.On</b><small><span class="sc-dot en-ligne"></span>En ligne</small></button>
            <button type="button" class="tr-kpi @(c.Off > 0 ? "danger" : "") @(treeFilter == "off" ? "on" : "")" aria-pressed="@(treeFilter == "off" ? "true" : "false")" @onclick='() => PickTreeFilter("off")'><b>@c.Off</b><small><span class="sc-dot hors-ligne"></span>Hors ligne</small></button>
            <button type="button" class="tr-kpi @(treeFilter == "sleep" ? "on" : "")" aria-pressed="@(treeFilter == "sleep" ? "true" : "false")" @onclick='() => PickTreeFilter("sleep")'><b>@c.Sleep</b><small><span class="gd-sleep"></span>En veille ou en pause</small></button>
            <button type="button" class="tr-kpi @(c.Pend > 0 ? "warn" : "") @(treeFilter == "pend" ? "on" : "")" aria-pressed="@(treeFilter == "pend" ? "true" : "false")" @onclick='() => PickTreeFilter("pend")'><b>@c.Pend</b><small><span class="sc-dot mise-a-jour"></span>À publier</small></button>
        </div>
    };

    private RenderFragment TreePaneAll(List<TArea> data) => __builder =>
    {
        var hits = data.Sum(a => a.Zones.Sum(z => z.Screens.Count(t => TMatch(t, z, a))));
        <div class="tr-crumb"><b>Toutes les aires</b><span>· @Plural(data.Count, "aire", "aires") · @Plural(data.Sum(a => a.Zones.Count), "zone", "zones")</span></div>
        @TreeKpis(data.SelectMany(a => a.All))
        <div class="tr-tools">
            <span>
                @if (treeFilter != "") { @($"{hits} écran{(hits > 1 ? "s" : "")} correspondant{(hits > 1 ? "s" : "")} · ")<button type="button" class="linklike" @onclick='() => PickTreeFilter("")'>Tout afficher</button> }
                else { <text>Groupés par aire puis par zone. Cliquez sur une aire pour la déplier dans l'arbre.</text> }
            </span>
            <span class="grow"></span>
            <div class="seg" role="group" aria-label="Densité">
                <button type="button" class="@(treeDens == "tiles" ? "on" : "")" aria-pressed="@(treeDens == "tiles" ? "true" : "false")" @onclick='() => SetDens("tiles")'><Ico Name="grid" Size="14" /> Vignettes</button>
                <button type="button" class="@(treeDens == "rows" ? "on" : "")" aria-pressed="@(treeDens == "rows" ? "true" : "false")" @onclick='() => SetDens("rows")'><Ico Name="menu" Size="14" /> Lignes</button>
            </div>
        </div>
        @foreach (var a in data) { @TreeSection(a) }
    };

    private RenderFragment TreeSection(TArea a) => __builder =>
    {
        var c = TCountOf(a.All);
        var hit = a.Zones.Any(z => z.Screens.Any(t => TMatch(t, z, a)));
        var calm = treeFilter != "" && !hit;
        var closed = calm || treeFolded.Contains(a.Area.Id);
        var pend = a.All.Where(t => t.Pending).Select(t => t.S.Id).ToList();
        <section class="tr-area @(closed ? "closed" : "") @(calm ? "calm" : "")" aria-label="Aire @a.Area.Name">
            <header class="tr-ah">
                <button type="button" class="tr-tg" aria-expanded="@(closed ? "false" : "true")" aria-label="@(closed ? "Déplier" : "Replier") @a.Area.Name" @onclick="() => ToggleFold(a.Area.Id)"><Ico Name="chevron" Size="16" /></button>
                <span class="ap"><Ico Name="map-pin" Size="16" /></span>
                <h2><button type="button" title="@(a.Own ? null : "Ouvrir l'aire « " + a.Area.Name + " »")" @onclick="() => SelectNode(a, null)">@a.Area.Name</button></h2>
                @if (a.Own) { <span class="lx-chip">Aire ouverte</span> }
                <span class="tr-sum">
                    @if (calm) { <span>Rien à signaler</span> }
                    else
                    {
                        <span>@Plural(c.N, "écran", "écrans")</span>
                        <span><span class="sc-dot en-ligne"></span>@c.On en ligne</span>
                        @if (c.Off > 0) { <span class="bad">@c.Off hors ligne</span> }
                        @if (c.Pend > 0) { <span class="pend">@c.Pend à publier</span> }
                    }
                </span>
                <span class="grow"></span>
                @if (!calm && pend.Count > 0) { <button type="button" class="btn ghost sm" @onclick="() => AskPublish(pend)"><Ico Name="upload" Size="14" /> Publier (@pend.Count)</button> }
                @if (!calm) { <button type="button" class="tb-btn" @onclick="() => SelectNode(a, null)">Détail <Ico Name="arrow-right" Size="14" /></button> }
            </header>
            @if (!closed)
            {
                <div class="tr-zones @treeDens">@foreach (var z in a.Zones) { @TreeZoneBlock(a, z) }</div>
            }
        </section>
    };

    private RenderFragment TreeZoneBlock(TArea a, TZone z) => __builder =>
    {
        var hits = z.Screens.Where(t => TMatch(t, z, a)).ToList();
        if (hits.Count == 0) return;
        <div class="tr-zg" data-nid="@(z.Zone.IsWall ? null : z.Zone.Id.ToString())">
            <div class="tr-zh"><Ico Name="@(z.Zone.IsWall ? "grid" : "box")" Size="13" /> @z.Zone.Name <span class="cnt">· @Plural(z.Screens.Count, "écran", "écrans")</span>@if (z.Zone.Sync) { <span class="sy"><Ico Name="link" Size="12" /> synchronisée</span> }<span class="grow"></span></div>
            @if (treeDens == "rows")
            {
                <div class="tr-rows">
                    @if (z.Zone.IsWall) { @TreeWallRow(a, z, hits) }
                    else { foreach (var t in hits) { @TreeRow(a, t, false) } }
                </div>
            }
            else
            {
                <div class="tr-tiles">
                    @if (z.Zone.IsWall) { @TreeWallTile(a, z) }
                    else { foreach (var t in hits) { @TreeTile(a, t) } }
                </div>
            }
        </div>
    };

    // aperçu d'une vignette : veille, pause, ou une vignette par zone du découpage (comme les cartes)
    private RenderFragment TreePreview(TArea a, TScreen t) => __builder =>
    {
        var s = t.S;
        if (t.Kind == "sleep") { <span class="sc-pause-art sc-sleep-art"><small>Écran éteint</small></span> }
        else if (t.Kind == "pause") { <span class="sc-pause-art"><b>☕</b><small>Petite pause</small></span> }
        else if (!a.Own) { @LightPreview(s, a.Group) }
        else
        {
            <span class="sc-zones @(s.Orientation == "portrait" ? "dir-col" : "dir-row")">
                @for (var z = 0; z < s.ZoneCount; z++)
                {
                    var zp = playlists.FirstOrDefault(p => p.Id == s.ZonePlaylist(z));
                    var zt = ZoneThumb(zp);
                    <span class="sc-zone" style="flex:@(ScreenLayouts.Find(s.Layout).Sizes[z].ToString("0.##", System.Globalization.CultureInfo.InvariantCulture)) 1 0">
                        @if (zt != null) { <MediaThumb Media="zt" All="media" /> }
                        else { <span class="sc-empty">@(zp == null ? (s.ZoneCount > 1 ? "+" : "Aucune liste de lecture") : zp.Name)</span> }
                    </span>
                }
            </span>
        }
    };

    private RenderFragment TreeTile(TArea a, TScreen t) => __builder =>
    {
        var s = t.S;
        <div class="tr-tile @(t.Kind == "off" ? "is-off" : "")" role="button" tabindex="0" title="Paramètres de l'écran « @s.Name »@(a.Own ? "" : $" (ouvre l'aire {a.Area.Name})")"
             @onclick="() => OpenTreeScreen(a, s)" @onkeydown='e => { if (e.Key == "Enter") OpenTreeScreen(a, s); }'>
            <div class="th">
                @if (a.Own) { <input type="checkbox" class="sc-check ck" aria-label="Sélectionner @s.Name" checked="@selectedIds.Contains(s.Id)" @onchange="() => ToggleSelect(s.Id)" @onclick:stopPropagation="true" /> }
                <div class="gc-mon @(s.Orientation == "portrait" ? "portrait" : "")">@TreePreview(a, t)</div>
                @if (t.Pending) { <span class="tp">À publier</span> }
            </div>
            <div class="tb">
                <div class="nm"><span class="sc-dot @TDot(t.Kind)"></span><span class="t">@s.Name</span>@if (s.DeviceKind != null) { <DeviceLogo Kind="@s.DeviceKind" Size="16" /> }</div>
                @if (t.Kind == "off") { <div class="ln bad">@TState(t)</div> }
                else if (t.Kind != "on") { <div class="ln sl"><Ico Name="@(t.Kind == "sleep" ? "moon" : "pause")" Size="12" /><span>@TState(t)</span></div> }
                else { <div class="ln"><Ico Name="play-box" Size="12" /><span>@TPl(a, s)</span></div> }
            </div>
        </div>
    };

    private RenderFragment TreeWallTile(TArea a, TZone z) => __builder =>
    {
        var w = z.Zone;
        var members = z.Screens.Select(x => x.S).ToList();
        var cells = WallCells(w, members);
        var c = TCountOf(z.Screens);
        var port = members.Count > 0 && members.All(x => x.Orientation == "portrait");
        var all = a.Own ? media : a.Group.MediaAll;
        var wpl = a.Own ? playlists.FirstOrDefault(p => p.Id == w.PlaylistId) : w.PlaylistId is { } wp && a.Group.Lists.TryGetValue(wp, out var gp) ? gp : null;
        var thumb = FirstFull(wpl, all);
        var ar = ((double)w.WallCols * (port ? 9 : 16) / ((double)w.WallRows * (port ? 16 : 9))).ToString("0.####", System.Globalization.CultureInfo.InvariantCulture);
        <div class="tr-tile wall @(c.Off == c.N ? "is-off" : "")" style="--cols:@w.WallCols;--rows:@w.WallRows;--ar:@ar" role="button" tabindex="0" title="Mur d'écrans « @w.Name »"
             @onclick="() => SelectNode(a, w.Id)" @onkeydown='e => { if (e.Key == "Enter") SelectNode(a, w.Id); }'>
            <div class="th">
                <div class="gc-frame @(port ? "portrait" : "")">
                    @foreach (var cell in cells)
                    {
                        var cx = (cell.Number - 1) % w.WallCols;
                        var cy = (cell.Number - 1) / w.WallCols;
                        <span class="gc-tile @cell.Css" title="@cell.Title">
                            @if (thumb != null) { <span class="wc-img" style="width:@(w.WallCols * 100)%;height:@(w.WallRows * 100)%;left:-@(cx * 100)%;top:-@(cy * 100)%"><MediaThumb Media="thumb" All="all" /></span> }
                            <span class="gc-tn">@cell.Number</span>
                            @if (cell.Screen == null) { <span class="gc-toff">Place libre</span> }
                            else if (cell.Css == "off") { <span class="gc-toff">Hors ligne</span> }
                        </span>
                    }
                    @if (thumb == null) { <span class="wc-label">@(wpl?.Name ?? "Aucune liste de lecture")</span> }
                </div>
            </div>
            <div class="tb">
                <div class="nm"><span class="sc-dot @(c.Off > 0 ? "mise-a-jour" : "en-ligne")"></span><span class="t">@w.Name</span><span class="wl">@w.WallCols × @w.WallRows</span></div>
                @if (c.Off > 0) { <div class="ln bad">Mur incomplet · @(c.N - c.Off) sur @c.N en ligne</div> }
                else { <div class="ln"><Ico Name="play-box" Size="12" /><span>@(wpl?.Name ?? "Aucune liste de lecture")</span></div> }
            </div>
        </div>
    };

    private RenderFragment TreeRow(TArea a, TScreen t, bool sub) => __builder =>
    {
        var s = t.S;
        <div data-nid="@s.Id" class="tr-row @(sub ? "sub" : "")" role="button" tabindex="0" title="Paramètres de l'écran « @s.Name »@(a.Own ? "" : $" (ouvre l'aire {a.Area.Name})")"
             @onclick="() => OpenTreeScreen(a, s)" @onkeydown='e => { if (e.Key == "Enter") OpenTreeScreen(a, s); }'>
