@page "/"
@attribute [Microsoft.AspNetCore.Authorization.Authorize(Policy = "ClientSpace")]
@implements IDisposable
@inject TenantStore Store
@inject Notifier Notifier
@inject Toaster Toast

<div class="page-head">
    <div>
        <h1>Vos écrans</h1>
        <p class="sub">Choisissez la liste de lecture et les widgets de chaque écran, puis publiez : chaque écran se met à jour indépendamment.</p>
    </div>
    <div class="row head-actions">
        <button class="btn ghost" disabled="@(selectedIds.Count == 0 || bulkPublishing)" title="@(selectedIds.Count == 0 ? "Cochez un ou plusieurs écrans" : null)" @onclick="() => AskPublish(selectedIds.ToList())">
            <Ico Name="upload" Size="16" /> @(bulkPublishing ? "Publication…" : "Publier")
        </button>
        @if (area != null && manageZones)
        {
            <div class="kebab add-menu">
                <button class="btn" aria-haspopup="menu" aria-expanded="@(addMenu ? "true" : "false")" @onclick="() => addMenu = !addMenu"><Ico Name="plus" Size="16" /> Ajouter <Ico Name="chevron" Size="14" /></button>
                @if (addMenu)
                {
                    <div class="kebab-backdrop" @onclick="() => addMenu = false"></div>
                    <div class="kebab-menu" role="menu">
                        <button type="button" role="menuitem" @onclick="() => { addMenu = false; OpenPair(); }"><Ico Name="monitor" Size="20" /><span><b>Connecter un écran</b><small>Saisir le code à 6 chiffres affiché</small></span></button>
                        <button type="button" role="menuitem" @onclick="() => { addMenu = false; showZones = true; }"><Ico Name="box" Size="20" /><span><b>@(zones.Count == 0 ? "Créer des zones" : "Gérer les zones")</b><small>Classer vos écrans : salle, bar, vitrine</small></span></button>
                    </div>
                }
            </div>
        }
        else
        {
            <button class="btn" @onclick="OpenPair"><Ico Name="plus" Size="16" /> Connecter un écran</button>
        }
    </div>
</div>

@if (noArea)
{
    <div class="card empty"><div class="big">Aucune aire de gestion ne vous est confiée</div><p>Demandez à un administrateur de votre organisation de vous donner un rôle dans une aire.</p></div>
}
@if (area != null && zones.Count > 0)
{
    <div class="zone-bar" role="group" aria-label="Zones">
        <button type="button" class="chip @(zoneFilter == null ? "on" : "")" @onclick="() => zoneFilter = null">Toutes les zones <small>@screens.Count</small></button>
        @foreach (var z in zones)
        {
            var zone = z;
            <button type="button" class="chip @(zoneFilter == zone.Id.ToString() ? "on" : "")" @onclick="() => zoneFilter = zone.Id.ToString()"><Ico Name="box" Size="14" /> @zone.Name <small>@screens.Count(x => x.ZoneId == zone.Id)</small></button>
        }
        @if (zones.Count > 0 && screens.Any(x => ZoneOf(x) == null))
        {
            <button type="button" class="chip @(zoneFilter == "none" ? "on" : "")" @onclick='() => zoneFilter = "none"'>Sans zone <small>@screens.Count(x => ZoneOf(x) == null)</small></button>
        }
    </div>
}
@if (screens.Count > 0)
{
    <div class="lib-tools" role="region" aria-label="Filtres et sélection" aria-live="polite">
        <label class="lib-all">
            <input type="checkbox" class="sc-check" checked="@(Shown.Count > 0 && Shown.All(s => selectedIds.Contains(s.Id)))" @onchange="ToggleAll" aria-label="Tout sélectionner" />
            @if (selectedIds.Count > 0) { <span>@selectedIds.Count sélectionné@(selectedIds.Count > 1 ? "s" : "")</span> }
        </label>
        @if (selectedIds.Count > 0)
        {
            @if (zones.Count > 0) { <button type="button" class="btn ghost sm" @onclick="OpenZoneMove"><Ico Name="box" Size="14" /> Changer de zone…</button> }
            @if (otherAreas.Count > 0) { <button class="btn ghost sm" @onclick="OpenBulkAreaMove"><Ico Name="move" Size="14" /> Déplacer vers une autre aire…</button> }
            <button class="btn danger sm" @onclick="() => deleting = screens.Where(s => selectedIds.Contains(s.Id)).ToList()"><Ico Name="trash" Size="14" /> Supprimer</button>
        }
        <div class="seg" role="tablist" aria-label="État des écrans">
            <button type="button" class="@(statusFilter == "" ? "on" : "")" @onclick='() => statusFilter = ""'>Tous <small>@InZone.Count</small></button>
            <button type="button" class="@(statusFilter == "online" ? "on" : "")" @onclick='() => statusFilter = "online"'>En ligne <small>@InZone.Count(s => !IsOffline(s))</small></button>
            <button type="button" class="@(statusFilter == "offline" ? "on" : "")" @onclick='() => statusFilter = "offline"'>Hors ligne <small>@InZone.Count(IsOffline)</small></button>
            <button type="button" class="@(statusFilter == "pending" ? "on" : "")" @onclick='() => statusFilter = "pending"'>À publier <small>@InZone.Count(s => Helpers.HasPending(s, playlists))</small></button>
        </div>
        <div class="search-box grow" style="margin:0">
            <Ico Name="search" Size="16" />
            <input placeholder="Rechercher des écrans" aria-label="Rechercher des écrans" @bind="search" @bind:event="oninput" />
        </div>
        <select @bind="sort" aria-label="Trier">
            <option value="name">Nom</option>
            <option value="status">État</option>
            <option value="pending">À publier d'abord</option>
        </select>
        <ViewToggle StorageKey="screens" @bind-Value="view" />
    </div>
    @if (Shown.Count == 0) { <div class="empty"><div class="big">Aucun écran trouvé</div></div> }
}

<div class="pl-grid @(view == "list" ? "list" : "")">
    @foreach (var s in Shown)
    {
        var sc = s;
        var st = Status(sc);
        var cls = st == "En ligne" ? "en-ligne" : st == "Mise à jour" ? "mise-a-jour" : "hors-ligne";
        var pending = Helpers.HasPending(sc, playlists);
        <div class="pl-card sc-card @(selectedIds.Contains(sc.Id) ? "picked" : "")">
            <div class="sc-head">
                <div class="pl-title">
                    <input type="checkbox" class="sc-check" aria-label="Sélectionner @sc.Name" checked="@selectedIds.Contains(sc.Id)" @onchange="() => ToggleSelect(sc.Id)" />
                    <span class="sc-dot @cls" title="@st"><span class="sr-only">@st</span></span>
                    <button type="button" class="pl-name linklike-name" title="Paramètres de l'écran « @sc.Name »" @onclick="() => Edit(sc)">@sc.Name</button>
                    <div class="kebab">
                        <button type="button" class="kebab-btn" aria-label="Actions pour @sc.Name" aria-haspopup="menu" aria-expanded="@(menuFor == sc.Id ? "true" : "false")"
                                @onclick="() => menuFor = menuFor == sc.Id ? null : sc.Id"><Ico Name="dots-v" Size="18" /></button>
                        @if (menuFor == sc.Id)
                        {
                            <div class="kebab-backdrop" @onclick="() => menuFor = null"></div>
                            <div class="kebab-menu" role="menu">
                                <button type="button" role="menuitem" @onclick="() => Edit(sc)"><Ico Name="pencil-square" Size="16" /> Éditer</button>
                                <button type="button" role="menuitem" @onclick="() => OpenRename(sc)"><Ico Name="edit" Size="16" /> Renommer</button>
                                <button type="button" role="menuitem" @onclick="() => AskPublish(new() { sc.Id })"><Ico Name="upload" Size="16" /> Publier</button>
                                @if (otherAreas.Count > 0) { <button type="button" role="menuitem" @onclick="() => OpenAreaMove(sc)"><Ico Name="move" Size="16" /> Déplacer vers une autre aire…</button> }
                                <button type="button" role="menuitem" class="danger" @onclick="() => { menuFor = null; deleting = new() { sc }; }"><Ico Name="trash" Size="16" /> Supprimer</button>
                            </div>
                        }
                    </div>
                </div>
                @if (zones.Count > 0 && zoneFilter == null)
                {
                    <div class="sc-zone-name">@(ZoneOf(sc)?.Name ?? "Sans zone")</div>
                }
            </div>
            <button type="button" class="sc-visual" tabindex="-1" aria-hidden="true" @onclick="() => Edit(sc)">
                <span class="sc-monitor @(sc.Orientation == "portrait" ? "portrait" : "")">
                    @* une vignette par zone du découpage, à ses proportions *@
                    <span class="sc-zones @(sc.Orientation == "portrait" ? "dir-col" : "dir-row")">
                        @for (var z = 0; z < sc.ZoneCount; z++)
                        {
                            var zp = playlists.FirstOrDefault(p => p.Id == sc.ZonePlaylist(z));
                            var zt = ZoneThumb(zp);
                            <span class="sc-zone" style="flex:@(ScreenLayouts.Find(sc.Layout).Sizes[z].ToString("0.##", System.Globalization.CultureInfo.InvariantCulture)) 1 0">
                                @if (zt != null) { <MediaThumb Media="zt" All="media" /> }
                                else { <span class="sc-empty">@(zp == null ? (sc.ZoneCount > 1 ? "+" : "Aucune liste de lecture") : zp.Name)</span> }
                            </span>
                        }
                    </span>
                </span>
                <span class="sc-stand"></span>
                @if (pending) { <span class="badge mise-a-jour sc-pending" title="Liste de lecture, widgets ou choix de liste de lecture modifiés depuis la dernière publication">À publier</span> }
            </button>
            <div class="sc-foot">
                @if (sc.ZoneCount == 1)
                {
                    <label class="sc-lbl" for="pl-@sc.Id">Défaut</label>
                    <select id="pl-@sc.Id" class="sc-select" @onchange="e => Assign(sc, e)">
                    <option value="" selected="@(sc.PlaylistId == null)">— Aucune liste de lecture —</option>
                    @foreach (var p in playlists) { <option value="@p.Id" selected="@(p.Id == sc.PlaylistId)">@p.Name</option> }
                    </select>
                }
                else
                {
                    @* écran découpé : une liste de lecture par zone, choisie dans l'édition de l'écran *@
                    <span class="sc-lbl">@sc.ZoneCount zones</span>
                    <button type="button" class="sc-select sc-zones-btn" title="Choisir la liste de lecture de chaque zone" @onclick="() => Edit(sc)">@ZonesSummary(sc)</button>
                }
            </div>
        </div>
    }
    <button class="pl-card pl-add" @onclick="OpenPair">
        <span class="pl-plus"><Ico Name="plus" Size="28" /></span>
        <span>Connecter un écran</span>
    </button>
</div>

@if (showPair)
{
    <div class="modal-backdrop" @onclick="() => showPair = false"></div>
    <div class="modal" role="dialog" aria-modal="true" aria-labelledby="pair-title">
        <h3 id="pair-title">Connecter un écran</h3>
        <p class="hint">Allumez l'écran, puis saisissez le code à 6 chiffres affiché. <a href="/player/" target="_blank">Ouvrir un écran de test</a></p>
        <div class="dw">
            <div class="dw-field"><label for="pair-code">Code</label><input id="pair-code" class="pair-code" @bind="code" placeholder="000000" maxlength="6" inputmode="numeric" autocomplete="off" /></div>
            <div class="dw-field"><label for="pair-name">Nom de l'écran</label><input id="pair-name" @bind="name" placeholder="Ex. Accueil, salle de pause" /></div>
            <div class="dw-field">
                <label for="pair-pl">Liste de lecture</label>
                <select id="pair-pl" @bind="playlistId">
                    <option value="">— Aucune liste de lecture —</option>
                    @foreach (var p in playlists) { <option value="@p.Id">@p.Name</option> }
                </select>
            </div>
            @if (zones.Count > 0)
            {
                <div class="dw-field">
                    <label for="pair-zone">Zone</label>
                    <select id="pair-zone" @bind="pairZone">
                        <option value="">— Sans zone —</option>
                        @foreach (var z in zones) { <option value="@z.Id">@z.Name</option> }
                    </select>
                </div>
            }
        </div>
        <p class="hint" style="margin:12px 0 0">Format par défaut : celui des Réglages, modifiable ensuite dans l'édition de l'écran.</p>
        @if (error != null) { <div class="err">@error</div> }
        <div class="modal-actions">
            <button class="btn ghost" @onclick="() => showPair = false">Annuler</button>
            <button class="btn" @onclick="Pair">Connecter</button>
        </div>
    </div>
}

@if (renamingScreen != null)
{
    <div class="modal-backdrop" @onclick="() => renamingScreen = null"></div>
    <div class="modal" role="dialog" aria-modal="true" aria-labelledby="ren-title">
        <h3 id="ren-title">Renommer l'écran</h3>
        <p class="hint">Le nom sert à repérer l'écran dans le back-office ; il n'est pas affiché sur l'écran.</p>
        <input style="width:100%;margin-top:10px" maxlength="80" @ref="renameInput" @bind="renameValue" @bind:event="oninput" @onkeydown="OnRenameKey" aria-label="Nom de l'écran" />
        <div class="modal-actions">
            <button class="btn ghost" @onclick="() => renamingScreen = null">Annuler</button>
            <button class="btn" disabled="@string.IsNullOrWhiteSpace(renameValue)" @onclick="RenameScreen">Renommer</button>
        </div>
    </div>
}

@if (deleting is { Count: > 0 } del)
{
    var many = del.Count > 1;
    <div class="modal-backdrop" @onclick="() => deleting = null"></div>
    <div class="modal" role="alertdialog" aria-modal="true" aria-labelledby="del-title">
        <h3 id="del-title">Supprimer @(many ? $"{del.Count} écrans" : $"« {del[0].Name} »") ?</h3>
        @if (many) { <p class="hint"><b>@string.Join(", ", del.Select(s => s.Name))</b></p> }
        <p class="hint">@(many ? "Les écrans seront déconnectés et afficheront" : "L'écran sera déconnecté et affichera") de nouveau un code d'appairage. @(many ? "Leurs listes de lecture ne sont pas supprimées." : "Sa liste de lecture n'est pas supprimée.")</p>
        <div class="modal-actions">
            <button class="btn ghost" @onclick="() => deleting = null">Annuler</button>
            <button class="btn danger-solid" @onclick="() => Remove(del)">Supprimer</button>
        </div>
    </div>
}

@if (confirmIds is { } cids)
{
    var targets = screens.Where(s => cids.Contains(s.Id)).ToList();
    <div class="modal-backdrop" @onclick="() => confirmIds = null"></div>
    <div class="modal" role="alertdialog" aria-modal="true" aria-labelledby="pub-title" aria-describedby="pub-desc">
        <h3 id="pub-title">Publier sur @(targets.Count > 1 ? $"{targets.Count} écrans" : "cet écran") ?</h3>
        <p class="hint" id="pub-desc">Chaque écran affichera immédiatement sa liste de lecture et ses widgets dans leur état actuel.</p>
        <ul class="pub-list">
            @foreach (var t in targets)
            {
                var tp = ZonesSummary(t);
                <li>
                    <b>@t.Name</b>
                    <span>@tp@(t.Widgets.Count > 0 ? $" · {t.Widgets.Count} widget{(t.Widgets.Count > 1 ? "s" : "")}" : "")</span>
                    @if (!Helpers.HasPending(t, playlists)) { <small>déjà à jour</small> }
                </li>
            }
        </ul>
        <div class="modal-actions">
            <button class="btn ghost" @onclick="() => confirmIds = null">Annuler</button>
            <button class="btn" disabled="@bulkPublishing" @onclick="ConfirmPublish"><Ico Name="upload" Size="16" /> @(bulkPublishing ? "Publication…" : "Publier")</button>
        </div>
    </div>
}

@if (showZones && area != null)
{
    <div class="modal-backdrop" @onclick="CloseZones"></div>
    <div class="modal app-modal sm" role="dialog" aria-modal="true" aria-labelledby="zones-title">
        <div class="modal-head">
            <div class="grow"><h3 id="zones-title">Zones de l'aire « @area.Name »</h3><small class="muted">Elles classent les écrans de l'aire, sans effet sur les droits.</small></div>
            <button type="button" class="modal-x" aria-label="Fermer" @onclick="CloseZones"><Ico Name="x" Size="20" /></button>
        </div>
        <div class="modal-body"><AreaZones AreaId="area.Id" OnChanged="Reload" /></div>
        <div class="modal-foot"><button type="button" class="btn" @onclick="CloseZones">Fermer</button></div>
    </div>
}

@if (zoneMove)
{
    <div class="modal-backdrop" @onclick="() => zoneMove = false"></div>
    <div class="modal" role="dialog" aria-modal="true" aria-labelledby="zm-title">
        <h3 id="zm-title">Changer la zone de @selectedIds.Count écran@(selectedIds.Count > 1 ? "s" : "")</h3>
        <p class="hint">La zone sert seulement à classer : rien n'est republié.</p>
        <div class="dw"><div class="dw-field"><label for="zm-zone">Zone</label>
            <select id="zm-zone" @bind="zoneTo"><option value="">— Sans zone —</option>@foreach (var z in zones) { <option value="@z.Id">@z.Name</option> }</select>
        </div></div>
        <div class="modal-actions">
            <button class="btn ghost" @onclick="() => zoneMove = false">Annuler</button>
            <button class="btn" @onclick="MoveToZone">Enregistrer</button>
        </div>
    </div>
}

@if (areaMove is { Count: > 0 } am)
{
    <AreaMoveDialog Kind="screen" Items="am" OnClose="AreaMoved" />
}

@if (editing is { } eid)
{
    <ScreenEditor ScreenId="eid" OnClose="CloseEdit" />
}

@code {
    private List<Screen> screens = new();
    private List<Playlist> playlists = new();
    private List<MediaItem> media = new();
    private Tenant tenant = new();
    private string code = "", name = "";
    private Guid? playlistId;
    private string? error;
    private bool showPair;
    private Timer? timer;
    private Guid? menuFor, editing;
    private List<Screen>? deleting;   // écrans en attente de confirmation de suppression
    private string view = "cards";   // cards | list (mémorisé dans le navigateur)

    protected override void OnInitialized()
    {
        tenant = Store.Read(d => d.Tenant);
        Reload();
        timer = new Timer(_ => InvokeAsync(() => { Reload(); StateHasChanged(); }), null, 3000, 3000);   // état en ligne / hors ligne
    }

    private string Status(Screen s) => Store.Read(d => d.Status(s));

    // Premier contenu plein écran d'une liste de lecture : vignette de sa zone sur la carte.
    private MediaItem? ZoneThumb(Playlist? p) =>
        p?.Draft.Where(i => i.Placement == "full").Select(i => media.FirstOrDefault(m => m.Id == i.MediaId)).FirstOrDefault(m => m != null);

    // « Accueil · Menus · — » : playlist de chaque zone, dans l'ordre.
    private string ZonesSummary(Screen s)
    {
        var names = s.ZonePlaylists().Select(id => playlists.FirstOrDefault(p => p.Id == id)?.Name ?? "—").ToList();
        return names.All(n => n == "—") ? "Aucune liste de lecture" : string.Join(" · ", names);
    }

    // ---------- Aire de gestion ouverte, zones, déplacements ----------
    private Area? area;
    private List<Zone> zones = new();
    private List<Area> otherAreas = new();   // déplacement : administrateur de l'organisation, vers une autre aire
    private bool manageZones, showZones, zoneMove, noArea, addMenu;
    private string? zoneFilter;   // null : toutes les zones ; "none" : sans zone ; sinon l'Id de la zone
    private string pairZone = "", zoneTo = "";
    private List<(Guid Id, string Name)>? areaMove;   // écrans à déplacer vers une autre aire

    private Zone? ZoneOf(Screen s) => zones.FirstOrDefault(z => z.Id == s.ZoneId);

    private string statusFilter = "", search = "", sort = "name";   // statusFilter : "" | online | offline | pending

    private bool IsOffline(Screen s) => Status(s) is not ("En ligne" or "Mise à jour");

    // Écrans de la zone ouverte : base des compteurs du filtre d'état.
    private List<Screen> InZone => zoneFilter == null ? screens
        : zoneFilter == "none" ? screens.Where(x => ZoneOf(x) == null).ToList()
        : screens.Where(x => x.ZoneId?.ToString() == zoneFilter).ToList();

    private List<Screen> Shown
    {
        get
        {
            var q = InZone.Where(s => statusFilter switch
            {
                "online" => !IsOffline(s),
                "offline" => IsOffline(s),
                "pending" => Helpers.HasPending(s, playlists),
                _ => true
            }).Where(s => search.Length == 0 || s.Name.Contains(search, StringComparison.OrdinalIgnoreCase));
            return (sort switch
            {
                "status" => q.OrderBy(s => IsOffline(s)).ThenBy(s => s.Name, StringComparer.CurrentCultureIgnoreCase),
                "pending" => q.OrderByDescending(s => Helpers.HasPending(s, playlists)).ThenBy(s => s.Name, StringComparer.CurrentCultureIgnoreCase),
                _ => q.OrderBy(s => s.Name, StringComparer.CurrentCultureIgnoreCase)
            }).ToList();
        }
    }

    private void ToggleAll()
    {
        var vis = Shown.Select(s => s.Id).ToList();
        if (vis.All(selectedIds.Contains)) selectedIds.ExceptWith(vis); else selectedIds.UnionWith(vis);
    }

    private void CloseZones() { showZones = false; Reload(); }

    private void OpenZoneMove() { zoneTo = zoneFilter is { } z && z != "none" ? z : ""; zoneMove = true; }

    private void MoveToZone()
    {
        Guid? zid = Guid.TryParse(zoneTo, out var g) && zones.Any(z => z.Id == g) ? g : null;
        var ids = selectedIds.ToList();
        Store.Write(d => { foreach (var sc in d.Screens.Where(x => ids.Contains(x.Id))) sc.ZoneId = zid; });
        Toast.Ok($"{ids.Count} écran{(ids.Count > 1 ? "s" : "")} {(zid == null ? "sans zone" : "dans la zone « " + zones.First(z => z.Id == zid).Name + " »")}.");
        zoneMove = false;
        selectedIds.Clear();
        Reload();
    }

    private void OpenAreaMove(Screen s) { menuFor = null; areaMove = new() { (s.Id, s.Name) }; }

    private void OpenBulkAreaMove() => areaMove = screens.Where(s => selectedIds.Contains(s.Id)).Select(s => (s.Id, s.Name)).ToList();

    private void AreaMoved(bool moved)
    {
        areaMove = null;
        if (moved) Reload();   // les écrans déplacés ne sont plus de cette aire : ils sortent aussi de la sélection
    }

    private void Reload()
    {
        (area, manageZones, noArea) = Store.Read(d => (d.Area, d.Access.ManagesCurrent, d.Access.OrgAreaCount > 0 && d.Area == null));
        zones = area?.Zones.OrderBy(z => z.Name, StringComparer.CurrentCultureIgnoreCase).ToList() ?? new();
        otherAreas = Store.Read(d => d.Access.IsOrgAdmin && d.Area is { } cur ? d.Areas.Where(a => a.Id != cur.Id).OrderBy(a => a.Name).ToList() : new());
        if (zoneFilter != null && zoneFilter != "none" && !zones.Any(z => z.Id.ToString() == zoneFilter)) zoneFilter = null;
        screens = Store.Read(d => d.Screens.Where(s => s.Token != null).OrderBy(s => s.Name).ToList());
        selectedIds.IntersectWith(screens.Select(s => s.Id));
        playlists = Store.Read(d => d.Playlists.OrderBy(p => p.Name).ToList());
        media = Store.Read(d => d.Media.Where(m => m.Status == null).ToList());
    }

    private void OpenPair() { code = name = ""; playlistId = null; error = null; pairZone = zoneFilter is { } z && z != "none" ? z : ""; showPair = true; }

    private void Edit(Screen s) { menuFor = null; editing = s.Id; }

    private void CloseEdit() { editing = null; Reload(); }

    private async Task Pair()
    {
        error = null;
        var spec = ScreenSpec.From(tenant);
        var pid = playlistId;
        var screenName = name;
        Guid? zid = Guid.TryParse(pairZone, out var zg) && zones.Any(z => z.Id == zg) ? zg : null;
        if (noArea) { error = "Aucune aire de gestion ne vous est confiée."; return; }
        var id = Store.Write(d =>
        {
            var s = d.ClaimScreen(code.Trim());
            if (s == null) return (Guid?)null;
            s.Name = string.IsNullOrWhiteSpace(screenName) ? "Écran " + code : screenName.Trim();
            s.PlaylistId = pid;
            s.ZoneId = zid;
            s.ScreenType = spec.Type; s.Orientation = spec.Orientation; s.Resolution = spec.Resolution;
            s.Token = Guid.NewGuid().ToString("N");
            s.PairingCode = null;
            return s.Id;
        });
        if (id == null) { error = "Code inconnu."; return; }
        await Notifier.PublishScreen(id.Value);   // l'écran appairé diffuse aussitôt sa liste de lecture
        showPair = false;
        Toast.Ok($"Écran « {(string.IsNullOrWhiteSpace(screenName) ? "Écran " + code : screenName.Trim())} » connecté.");
        Reload();
    }

    // ---------- Sélection multiple et publication ----------
    private readonly HashSet<Guid> selectedIds = new();
    private bool bulkPublishing;
    private List<Guid>? confirmIds;   // écrans à publier, en attente de confirmation

    private void ToggleSelect(Guid id) { if (!selectedIds.Remove(id)) selectedIds.Add(id); }


    private void AskPublish(List<Guid> ids)
    {
        menuFor = null;
        if (ids.Count > 0) confirmIds = ids;
    }

    // Chaque écran reçoit sa propre publication (sa liste de lecture et ses widgets, dans leur état actuel). Les autres écrans ne changent pas.
    private async Task ConfirmPublish()
    {
        if (confirmIds is not { } ids) return;
        bulkPublishing = true;
        try { foreach (var id in ids) await Notifier.PublishScreen(id); }
        finally { bulkPublishing = false; }
        confirmIds = null;
        foreach (var id in ids) selectedIds.Remove(id);
        Toast.Ok($"Publié sur {ids.Count} écran{(ids.Count > 1 ? "s" : "")} à {DateTime.Now:HH:mm}.");
        Reload();
    }

    // Playlist par défaut de l'écran : enregistrée tout de suite, diffusée à la prochaine publication (confirmée) de l'écran.
    private void Assign(Screen s, ChangeEventArgs e)
    {
        var pid = Guid.TryParse(e.Value?.ToString(), out var g) ? g : (Guid?)null;
        Store.Write(d => { if (d.Screens.FirstOrDefault(x => x.Id == s.Id) is { } sc) sc.PlaylistId = pid; });
        Toast.Ok(pid == null ? $"Aucune liste de lecture pour « {s.Name} ». Publiez l'écran pour l'appliquer." : $"Liste de lecture « {playlists.FirstOrDefault(p => p.Id == pid)?.Name} » choisie pour « {s.Name} ». Publiez l'écran pour la diffuser.");
        Reload();
    }

    // ---------- Renommer (menu ⋮) ----------
    private Screen? renamingScreen;
    private string renameValue = "";
    private ElementReference renameInput;
    private bool focusRename;

    private void OpenRename(Screen s) { menuFor = null; renamingScreen = s; renameValue = s.Name; focusRename = true; }

    private void OnRenameKey(KeyboardEventArgs e)
    {
        if (e.Key == "Enter") RenameScreen();
        else if (e.Key == "Escape") renamingScreen = null;
    }

    // Le nom n'est pas diffusé : rien à publier.
    private void RenameScreen()
    {
        if (renamingScreen is not { } s || string.IsNullOrWhiteSpace(renameValue)) return;
        var name = renameValue.Trim();
        if (name.Length > 80) name = name[..80];
        Store.Write(d => { if (d.Screens.FirstOrDefault(x => x.Id == s.Id) is { } sc) sc.Name = name; });
        renamingScreen = null;
        Toast.Ok($"Écran renommé en « {name} ».");
        Reload();
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (focusRename && renamingScreen != null) { focusRename = false; await renameInput.FocusAsync(); }
    }

    private void Remove(List<Screen> list)
    {
        var ids = list.Select(x => x.Id).ToHashSet();
        selectedIds.ExceptWith(ids);
        Store.Write(d => { d.Screens.RemoveAll(x => ids.Contains(x.Id)); });
        Toast.Ok(list.Count > 1 ? $"{list.Count} écrans supprimés." : $"Écran « {list[0].Name} » supprimé.");
        deleting = null;
        Reload();
    }

    public void Dispose() => timer?.Dispose();
}
