            <span class="nm">@s.Name</span>
            <span class="mu">@if (s.DeviceKind != null) { <DeviceLogo Kind="@s.DeviceKind" Size="16" /> }@(s.DeviceKind != null ? s.DeviceOs ?? "Appareil" : "En attente")</span>
            <span class="mu"><Ico Name="play-box" Size="13" />@TPl(a, s)</span>
            <span class="mu @(t.Kind == "off" ? "bad" : "")">@TState(t)</span>
