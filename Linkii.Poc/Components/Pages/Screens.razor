@page "/"
@attribute [Microsoft.AspNetCore.Authorization.Authorize(Policy = "Page:screens")]
@implements IDisposable
@inject TenantStore Store
@inject Notifier Notifier
@inject Toaster Toast
@inject NavigationManager Nav
@inject ModeService Modes
@inject IJSRuntime JS
@inject ScreenFolderLibrary Folders
@inject LifecycleMail Mails
@using Microsoft.JSInterop

<div class="page-head">
    <div>
        <h1 class="cmp-h1">@if (!TreeView && currentRow is { } cur) { @FolderCrumbs(cur) } else { <span>Vos écrans</span> }<span class="scr-count" aria-label="@(Shown.Count + OtherShown.Count) écran@(Shown.Count + OtherShown.Count > 1 ? "s" : "")">@(Shown.Count + OtherShown.Count)</span></h1>
        <p class="sub sc-intro">Choisissez la liste de lecture et les widgets de chaque écran, puis publiez : chaque écran se met à jour indépendamment.</p>
    </div>
    <div class="row head-actions">
        @* Publier : seulement s'il y a des modifications à publier (écrans affichés), en couleur avec leur nombre *@
        @{ var pendHead = TreeView ? TreePending(TreeScope) : PendingShown; }
        @if (pendHead.Count > 0)
        {
            <button class="btn publish-btn" disabled="@bulkPublishing" title="Publier les modifications en attente sur @pendHead.Count écran@(pendHead.Count > 1 ? "s" : "")" @onclick="() => AskPublish(pendHead)">
                <Ico Name="upload" Size="16" /> @(bulkPublishing ? "Publication…" : "Publier") <span class="cnt">@pendHead.Count</span>
            </button>
        }
        @if (canAdd)
        {
            @* Un seul bouton « Ajouter » (même menu que la médiathèque). Look « app » : le bouton est masqué, le bouton flottant reprend les mêmes choix (sources [data-fab] cachées). *@
            <div class="lx-add">
                <button type="button" class="btn lx-add-btn" aria-haspopup="menu" aria-expanded="@(newMenu ? "true" : "false")" @onclick="() => newMenu = !newMenu"><Ico Name="plus" Size="16" /> Ajouter <Ico Name="chevron" Size="14" /></button>
                @if (newMenu)
                {
                    <div class="kebab-backdrop" @onclick="() => newMenu = false"></div>
                    <div class="kebab-menu lx-add-menu" role="menu">
                        <button type="button" role="menuitem" @onclick="() => { newMenu = false; OpenPair(); }"><Ico Name="monitor" Size="18" /><span><b>Connecter un écran</b><small>Avec le code affiché sur l'écran</small></span></button>
                        <button type="button" role="menuitem" @onclick="() => { newMenu = false; OpenPairKiosk(); }"><Ico Name="hand" Size="18" /><span><b>Borne interactive <span class="kiosk-new">Nouveau</span></b><small>PC Windows à écran tactile</small></span></button>
                        <span class="sep" role="separator"></span>
                        <button type="button" role="menuitem" @onclick="OpenNewFolder"><Ico Name="folder" Size="18" /><span><b>Nouveau dossier@(currentRow is { } cf ? $" dans « {cf.Folder.Name} »" : "")</b></span></button>
                    </div>
                }
                <span class="lx-fabsrc" aria-hidden="true">
                    <button type="button" tabindex="-1" data-fab="Connecter un écran" @onclick="OpenPair"><Ico Name="plus" Size="16" /></button>
                    <button type="button" tabindex="-1" data-fab="Nouveau dossier" @onclick="OpenNewFolder"><Ico Name="folder" Size="16" /></button>
                </span>
            </div>
        }
        else if (!noArea)
        {
            @* pas le droit d'ajouter un écran dans cette aire : bouton verrouillé *@
            <button class="btn" disabled title="Vous êtes en lecture seule sur les écrans : un administrateur peut changer cela dans votre fiche membre."><Ico Name="lock" Size="16" /> Connecter un écran</button>
        }
    </div>
</div>

@* Deux familles d'écrans, jamais mélangées : les écrans de diffusion et les bornes interactives (écran tactile, menu de tuiles). *@
<nav class="tabs int-tabs lx-utabs lx-ktabs" role="tablist" aria-label="Type d'écran">
    <button type="button" role="tab" class="@(kindFilter == "" ? "on" : "")" aria-selected="@(kindFilter == "" ? "true" : "false")" @onclick='() => kindFilter = ""'>Tous <span class="cnt">@screens.Count</span></button>
    <button type="button" role="tab" class="@(kindFilter == "broadcast" ? "on" : "")" aria-selected="@(kindFilter == "broadcast" ? "true" : "false")" @onclick='() => kindFilter = "broadcast"'>Écrans de diffusion <span class="cnt">@screens.Count(x => x.Kiosk == null)</span></button>
    <button type="button" role="tab" class="@(kindFilter == "kiosk" ? "on" : "")" aria-selected="@(kindFilter == "kiosk" ? "true" : "false")" @onclick='() => kindFilter = "kiosk"'>Bornes interactives <span class="cnt">@screens.Count(x => x.Kiosk != null)</span></button>
</nav>
@if (kindFilter == "kiosk" && !screens.Any(x => x.Kiosk != null) && canAdd)
{
    <div class="card empty"><div class="big">Aucune borne interactive</div><p>Une borne est un écran tactile : le visiteur choisit ce qu'il veut voir dans un menu de tuiles. Sans toucher, elle diffuse comme un écran ordinaire.</p><button type="button" class="btn" @onclick="OpenPairKiosk"><Ico Name="hand" Size="16" /> Connecter une borne</button></div>
}

@if (Tabs.Count > 1)
{
    @* Onglets (25 octobre 2026) : les écrans qu'on a connectés, ceux d'un collègue qu'on voit, et pour l'administrateur toute l'organisation. Jamais mélangés. *@
    <nav class="tabs int-tabs lx-utabs" role="tablist" aria-label="Écrans affichés">
        @foreach (var t in Tabs)
        {
            var key = t.Key;
            <button type="button" role="tab" class="@(tab == key ? "on" : "")" aria-selected="@(tab == key ? "true" : "false")" @onclick="() => SetTab(key)">@t.Label@if (t.Count > 0) { <span class="cat-count">@t.Count</span> }<TabNew Family="screens" Tab="@key" /></button>
        }
    </nav>
}

@if (noArea)
{
    <div class="card empty"><div class="big">Aucune aire de gestion ne vous est confiée</div><p>Demandez à un administrateur de votre organisation de vous donner un rôle dans une aire.</p></div>
}
@if (Has && !TreeView && (subfolders.Count > 0 || canAdd))
{
    <section class="lx-fzone" aria-label="Dossiers">
    @* Dossiers de la position ouverte : mêmes formes, aperçus et actions que la Médiathèque (FolderShape, .lx-fcard), cibles du glisser-déposer. *@
    @if (subfolders.Count > 0 || canAdd)
    {
        <div class="lx-fstrip lx-fgrid" role="list" aria-label="Dossiers">
            @foreach (var row in subfolders)
            {
                var r = row;
                var mine = r.Folder.OwnerId == Store.UserId;
                var preview = FolderPreview(r.Folder.Id);
                <div data-nid="@r.Folder.Id" class="lx-fcard @(dropOver == r.Folder.Id ? "drop-target" : "")" role="listitem" tabindex="0" draggable="@(r.CanManage && !isApp ? "true" : null)" @ondragstart="() => { dragFolder = r.Folder.Id; }" @ondragend="EndDrag" title="@(mine ? "Votre dossier" : "Dossier de " + r.OwnerName)" aria-label="Ouvrir le dossier @r.Folder.Name"
                     @onclick="() => OpenFolder(r.Folder.Id)" @onkeydown='e => { if (e.Key == "Enter") OpenFolder(r.Folder.Id); }'
                     @ondragover="() => { }" @ondragover:preventDefault="true" @ondragenter="() => { if (dragIds.Count > 0 || (dragFolder != null && dragFolder != r.Folder.Id)) dropOver = r.Folder.Id; }" @ondragleave="() => { if (dropOver == r.Folder.Id) dropOver = null; }" @ondrop:preventDefault="true" @ondrop="() => DropOn(r.Folder.Id)"
                     @oncontextmenu="() => { if (r.CanManage) menuFor = r.Folder.Id; }" @oncontextmenu:preventDefault="isApp && r.CanManage">
                    <FolderShape Preview="preview" All="media" Count="ChildCount(r.Folder.Id)" Unit="@FolderUnit(r.Folder.Id)">
                        <Badge>
                            @if (!mine && r.Folder.OwnerId != null) { <span class="fbadge sh" title="Dossier de @r.OwnerName">@First(r.OwnerName)</span> }
                        </Badge>
                    </FolderShape>
                    <div class="fn"><span>@r.Folder.Name</span><small>@FolderDate(r)</small></div>
                    @if (r.CanManage)
                    {
                        <button type="button" class="fk" aria-label="Actions pour le dossier @r.Folder.Name" aria-haspopup="menu" aria-expanded="@(menuFor == r.Folder.Id ? "true" : "false")"
                                @onclick:stopPropagation="true" @onclick="() => menuFor = menuFor == r.Folder.Id ? null : r.Folder.Id"><Ico Name="dots-v" Size="16" /></button>
                    }
                    @if (menuFor == r.Folder.Id)
                    {
                        <div class="kebab-backdrop" @onclick:stopPropagation="true" @onclick="() => menuFor = null"></div>
                        <div class="kebab-menu" role="menu" @onclick:stopPropagation="true">
                            <span class="kebab-note">@r.Folder.Name · @(mine ? "votre dossier" : $"dossier de {r.OwnerName}")</span>
                            <button type="button" role="menuitem" @onclick="() => { menuFor = null; renamingFolder = r; renameFolderValue = r.Folder.Name; folderError = null; }"><Ico Name="edit" Size="16" /> Renommer</button>
                            <button type="button" role="menuitem" @onclick="() => { menuFor = null; reparenting = (r.Folder.Id, r.Folder.Name); }"><Ico Name="move" Size="16" /> Déplacer…</button>
                            <button type="button" role="menuitem" class="danger" @onclick="() => { menuFor = null; deletingFolder = r; }"><Ico Name="trash" Size="16" /> Supprimer</button>
                        </div>
                    }
                </div>
            }
            @if (canAdd)
            {
                <button type="button" class="lx-fcard add" @onclick="OpenNewFolder">
                    <div class="fv"><span class="fbk"></span><span class="ffr"><Ico Name="plus" Size="22" /></span></div>
                    <div class="fn"><span>Nouveau dossier</span></div>
                </button>
            }
        </div>
    }
    </section>
}

<section class="lx-blk lx-blk-main @(Has ? "" : "bare")" aria-label="Écrans">
@if (Has)
{
    <div class="lx-bh"><Ico Name="monitor" Size="16" /> <span>Écrans</span> <small>@(Shown.Count + OtherShown.Count)</small></div>
    @* Une seule barre : tout sélectionner, actions de la sélection, zone, état, recherche, tri, affichage *@
    <div class="lx-tools sc-bar" role="region" aria-label="Filtres et sélection" aria-live="polite">
        @if (selectedIds.Count > 0 && !ListView)
        {
            <label class="lib-all" title="Tout sélectionner">
                <input type="checkbox" class="sc-check" checked="@(Shown.Count > 0 && Shown.All(s => selectedIds.Contains(s.Id)))" @onchange="ToggleAll" aria-label="Tout sélectionner" />
            </label>
            }
        <div class="search-box grow" style="margin:0">
            <Ico Name="search" Size="16" />
            <input placeholder="Rechercher des écrans" aria-label="Rechercher des écrans" @bind="search" @bind:event="oninput" />
        </div>
        <AreaFilter Value="@areaFilter" AllowAll="true" OnPick="PickAreaFilter" />
        <FilterMenu Groups="FilterGroups" OnPick="PickFilter" OnReset="ResetFilters">
            <Footer>
                @if (area != null && ShowZones && manageZones)
                {
                    <div class="fm-note"><span>Zones</span><button type="button" class="linklike" @onclick='() => Nav.NavigateTo("zones")'>Gérer les zones…</button></div>
                }
            </Footer>
        </FilterMenu>
        @if (area != null && ShowZones && OpenZone is { } pz)
        {
            <a class="tb-btn" href="planning?zone=@pz.Id" title="Planning de diffusion de @(pz.IsWall ? "ce mur" : "cette zone")"><Ico Name="calendar" Size="14" /> Planning @if (pz.Slots.Count > 0) { <span class="tb-n">@pz.Slots.Count</span> }</a>
        }
        @if (Modes.Expert) { <ViewToggle StorageKey="screens-arbre" Tree="!isApp" @bind-Value="view" /> }
    </div>
    <FilterChips Groups="FilterGroups" OnClear="ClearFilter" OnResetAll="ResetFilters" />

    @* Zone libre choisie : une ligne d'information et un menu d'actions (un mur a tout cela dans sa carte) *@
    @if (!TreeView && OpenZone is { IsWall: false } oz)
    {
        var inZ = InZone;
        <div class="zline" role="region" aria-label="Zone @oz.Name">
            <span><b>@oz.Name</b> · zone libre</span>
            @if (oz.Sync)
            {
                <span class="zstate sync"><Ico Name="link" Size="13" /> Lecture synchronisée · @inZ.Count(x => synced.Contains(x.Id)) sur @inZ.Count alignés</span>
            }
            <div class="grow"></div>
            @if (manageZones)
            {
                <div class="kebab dd">
                    <button type="button" class="dd-btn" aria-haspopup="menu" aria-expanded="@(openMenu == "zact" ? "true" : "false")" @onclick='() => Toggle("zact")'>Actions de la zone <Ico Name="chevron" Size="14" /></button>
                    @if (openMenu == "zact")
                    {
                        <div class="kebab-backdrop" @onclick="CloseMenu"></div>
                        <div class="kebab-menu dd-menu right" role="menu">
                            <button type="button" role="menuitem" @onclick="async () => { CloseMenu(); await ToggleSync(oz); }"><Ico Name="link" Size="16" /> @(oz.Sync ? "Couper la synchronisation" : "Synchroniser la lecture")</button>
                            <button type="button" role="menuitem" @onclick='() => { CloseMenu(); Nav.NavigateTo("zones"); }'><Ico Name="gear" Size="16" /> Gérer les zones…</button>
                        </div>
                    }
                </div>
            }
        </div>
    }
    @if (Shown.Count + OtherShown.Count == 0 && !NothingToShow)
    {
        @if (Filtering) { <div class="empty"><div class="big">Aucun écran trouvé</div></div> }
        else if (currentRow is { } fe) { <div class="empty compact"><div class="big">Ce dossier est vide</div><p>Glissez-y des écrans, ou rangez-en depuis leur menu ⋮ « Ranger dans un dossier… ».</p>@if (canAdd && OwnAreaVisible) { <button class="btn" @onclick="OpenPair"><Ico Name="plus" Size="16" /> Connecter un écran</button> }</div> }
        else { <div class="empty compact"><div class="big">Aucun écran à la racine</div><p>Vos écrans sont rangés dans les dossiers ci-dessus.</p>@if (canAdd && OwnAreaVisible) { <button class="btn" @onclick="OpenPair"><Ico Name="plus" Size="16" /> Connecter un écran</button> }</div> }
    }
}
else if (Modes.Expert && !noArea)
{
    @* Aucun écran : le choix de l'affichage (arborescence, cartes, liste) reste disponible *@
    <div class="lx-tools sc-bar" role="region" aria-label="Affichage">
        <div class="grow"></div>
        <ViewToggle StorageKey="screens-arbre" Tree="!isApp" @bind-Value="view" />
    </div>
}

@if (!noArea && NothingToShow && tab == LibraryTab.Shared)
{
    <div class="empty"><div class="big">Aucun écran n'est partagé avec vous</div><p>Quand un administrateur vous attribue un écran, il apparaît ici. Vous pouvez le gérer, mais il reste à son propriétaire.</p></div>
}
else if (!noArea && NothingToShow)
{
    @* Rien n'est affiché (aucun filtre) : avec le droit d'ajouter un écran dans l'aire, on explique comment en connecter un ; sinon simple constat, sans bouton *@
    @if (canAdd && OtherAll.Count == 0 && firstLater)
    {
        @* Assistant du premier écran remis à plus tard : on reprend là où la personne s'est arrêtée *@
        <div class="fs-resume">
            <span class="fs-resume-ic"><Ico Name="monitor" Size="26" /></span>
            <div class="grow">
                @if (firstReady)
                {
                    <h3>Votre contenu est prêt, il ne manque que l'écran</h3>
                    <p>Allumez l'écran, ouvrez <b>@(new Uri(Nav.BaseUri).Authority)/player</b> et recopiez le code. Ça prend une minute.</p>
                }
                else
                {
                    <h3>Votre premier écran en deux minutes</h3>
                    <p>Choisissez ce qu'il affiche, puis reliez-le avec le code qu'il montre.</p>
                }
            </div>
            @if (firstReady) { <button class="btn ghost" @onclick="() => OpenWizard(1)">Modifier le contenu</button> }
            <button class="btn" @onclick="() => OpenWizard(firstReady ? 2 : 1)">@(firstReady ? "Relier mon écran" : "Commencer")</button>
        </div>
    }
    else if (canAdd)
    {
        <div class="empty @(OtherAll.Count > 0 ? "compact" : "")">
            @if (OtherAll.Count == 0)
            {
                <div class="big">Aucun écran connecté</div>
                <p>Installez l'app Linkivi sur l'écran (TV, boîtier, PC) : il affiche un code. Saisissez ce code ici pour relier l'écran à votre organisation.</p>
            }
            else
            {
                <div class="big">Aucun écran dans « @area?.Name »</div>
                <p>Connectez ici un écran qui appartiendra à « @area?.Name ».</p>
            }
            <button class="btn" @onclick="OpenPair"><Ico Name="plus" Size="16" /> Connecter un écran</button>
        </div>
    }
    else
    {
        <div class="empty"><div class="big">Aucun écran à afficher</div></div>
    }
}

@* Grille à plat des écrans de l'aire ouverte (cartes habituelles), puis ceux des autres aires que le filtre « Aire de gestion » laisse voir (« Tous » par défaut) :
   cartes de consultation, un clic ouvre l'aire de l'écran pour le modifier. *@
@if (TreeView)
{
    @* Mode Expert : écrans rangés par aire puis par zone, arbre à gauche *@
    @TreeBody()
}
else
{
<div class="pl-grid @(ListView ? "list" : "")">
    @if (ListView)
    {
        @* en-têtes des colonnes (PC) ; masqués au téléphone *@
        <div class="sc-listhead"><span class="sc-lh-check"><input type="checkbox" class="sc-check" checked="@(Shown.Count > 0 && Shown.All(s => selectedIds.Contains(s.Id)))" @onchange="ToggleAll" aria-label="Tout sélectionner" title="Tout sélectionner" /></span><span>Aperçu</span><span></span><span>Écran</span><span>État</span><span>Partage</span><span>En diffusion</span><span></span><span></span></div>
    }
    @foreach (var entry in Entries) { @Card(entry) }
    @foreach (var os in OtherShown) { if (ListView) { @LightRow(os.Screen, os.Area) } else { @LightCard(os.Screen, os.Area) } }
</div>
}
</section>

@if (selectedIds.Count > 0)
{
    @* Barre de sélection flottante, comme sur Médiathèque et Listes de lecture *@
    <div class="lx-selbar" role="region" aria-label="Sélection">
        <b>@selectedIds.Count sélectionné@(selectedIds.Count > 1 ? "s" : "")</b>
        <button type="button" @onclick="ToggleAll">@(Shown.Count > 0 && Shown.All(s => selectedIds.Contains(s.Id)) ? "Tout désélectionner" : $"Tout sélectionner ({Shown.Count})")</button>
        <span class="vr"></span>
        <button type="button" @onclick="() => AskPublish(selectedIds.ToList())"><Ico Name="upload" Size="15" /><span class="lx-lbl">Publier</span></button>
        @if (canAdd) { <button type="button" @onclick="() => folderMove = screens.Where(s => selectedIds.Contains(s.Id)).Select(s => (s.Id, s.Name)).ToList()"><Ico Name="folder" Size="15" /><span class="lx-lbl">Ranger…</span></button> }
        @if (zones.Count > 1) { <button type="button" @onclick="OpenZoneMove"><Ico Name="box" Size="15" /><span class="lx-lbl">Zone…</span></button> }
        @if (tenant.SleepEnabled) { <button type="button" @onclick="OpenSleep"><Ico Name="moon" Size="15" /><span class="lx-lbl">Veille…</span></button> }
        @if (canAssign) { <button type="button" @onclick="OpenAssignSelection"><Ico Name="users" Size="15" /><span class="lx-lbl">Attribuer…</span></button> }
        @if (CanAssemble) { <button type="button" @onclick="OpenWall"><Ico Name="grid" Size="15" /><span class="lx-lbl">Mur…</span></button> }
        @if (otherAreas.Count > 0) { <button type="button" @onclick="OpenBulkAreaMove"><Ico Name="move" Size="15" /><span class="lx-lbl">Autre aire…</span></button> }
        <span class="vr"></span>
        <button type="button" class="del" @onclick="() => deleting = screens.Where(s => selectedIds.Contains(s.Id)).ToList()"><Ico Name="trash" Size="15" /> Supprimer</button>
        <span class="vr"></span>
        <button type="button" title="Tout désélectionner" aria-label="Tout désélectionner" @onclick="() => { selectedIds.Clear(); pickOrder.Clear(); }"><Ico Name="x" Size="15" /></button>
    </div>
}

@* Premier écran d'un nouveau compte : l'assistant couvre la page (masqué pendant une fenêtre de paiement, sans perdre son état) *@
@if (wizardOpen)
{
    <div style="@(screenPay != null ? "display:none" : null)">
        <FirstScreenWizard @ref="wizard" StartStep="wizardStart" Pair="PairFromWizard" OnClose="CloseWizard" />
    </div>
}

@* Connecter un écran : un tiroir qui vient du bas (comme « Importer » de la médiathèque) ; la page reste visible derrière. *@
@if (screenPay != null)
{
    <PayDialog Request="screenPay" OnDone="ScreenPayDone" />
}
@if (showPair)
{
    <div class="modal-backdrop" @onclick="() => showPair = false"></div>
    <div class="imp-bottom lx-pair" role="dialog" aria-modal="true" aria-labelledby="pair-title">
        <div class="imp-head">
            <h3 id="pair-title">@(pairKiosk ? "Connecter une borne interactive" : "Connecter un écran")</h3>
            <button type="button" class="modal-x" aria-label="Fermer" @onclick="() => showPair = false"><Ico Name="x" Size="20" /></button>
        </div>
        <div class="imp-body">
            <p class="hint" style="margin-top:0">Allumez l'écran, puis saisissez le code à 6 chiffres affiché. <a href="/player/" target="_blank">Ouvrir un écran de test</a> · <a href="/download/windows" download>Télécharger le player Windows</a></p>
            @if (pairKiosk)
            {
                <div class="kiosk-info"><Ico Name="hand" Size="16" /> <span>La borne s'installe sur un PC Windows à écran tactile (Windows 10 ou 11). Sans toucher, elle diffuse comme un écran ordinaire ; le menu de tuiles se compose ensuite dans la page de la borne. Format portrait d'office, modifiable ensuite.</span></div>
            }
            <div class="dw pair-grid">
                <div class="dw-field wide"><label for="pair-code">Code</label><input id="pair-code" class="pair-code" @bind="code" placeholder="000000" maxlength="6" inputmode="numeric" autocomplete="off" /></div>
                <div class="dw-field wide"><label for="pair-name">Nom de l'écran</label><input id="pair-name" @bind="name" placeholder="Ex. Accueil, salle de pause" /></div>
                <div class="dw-field wide">
                    <label for="pair-pl">@(pairKiosk ? "Liste de lecture en inactivité" : "Liste de lecture")</label>
                    <select id="pair-pl" @bind="playlistId">
                        <option value="">— Aucune liste de lecture —</option>
                        @foreach (var p in playlists) { <option value="@p.Id">@p.Name</option> }
                    </select>
                </div>
                @if (pairAreas.Count > 1)
                {
                    @* l'aire se choisit ici (plus d'aire ouverte dans le menu) : pré-remplie avec le filtre en cours, ou la dernière aire utilisée *@
                    <div class="dw-field wide">
                        <label for="pair-area">Aire</label>
                        <select id="pair-area" value="@area?.Id" @onchange="PairAreaChanged">
                            @foreach (var a in pairAreas) { <option value="@a.Id">@a.Name</option> }
                        </select>
                    </div>
                }
                @if (FreeZones.Count > 1)
                {
                    <div class="dw-field wide">
                        <label for="pair-zone">Zone</label>
                        <select id="pair-zone" @bind="pairZone">
                            @foreach (var z in FreeZones) { <option value="@z.Id">@z.Name</option> }
                        </select>
                    </div>
                }
