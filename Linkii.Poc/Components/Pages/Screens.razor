    private async Task DropOnZone(Guid areaId, Guid? zoneId)
    {
        var ids = dragIds.ToList();
        dragIds = new(); dropArea = dropZone = null;
        if (ids.Count == 0) return;
        var zone = zoneId ?? groupAreas.First(g => g.Area.Id == areaId).Zones.First(z => z.IsDefault).Id;
        var undo = new List<AreaOps.ScreenPlace>();
        string? error = null;
        var changedArea = 0; var lostList = 0; string? lastName = null;
        Store.Write(d =>
        {
            foreach (var id in ids)
            {
                if (d.Root.Screens.FirstOrDefault(x => x.Id == id && x.ClientId == d.ClientId) is not { } sc) continue;
                if (sc.AreaId == areaId && sc.ZoneId == zone) continue;
                var before = AreaOps.PlaceOf(sc);
                if (AreaOps.PlaceScreen(d, id, areaId, zone) is { } err) { error = err; break; }
                undo.Add(before);
                lastName = sc.Name;
                if (before.AreaId != areaId) { changedArea++; if (before.PlaylistId != null && sc.PlaylistId == null) lostList++; }
            }
        });
        if (error != null) Toast.Error(error);
        if (undo.Count > 0)
        {
            var target = groupAreas.First(g => g.Area.Id == areaId);
            var where = $"{target.Area.Name} › {target.Zones.First(z => z.Id == zone).Name}";
            groupNotice = undo.Count == 1 ? $"« {lastName} » déplacé vers {where}." : $"{undo.Count} écrans déplacés vers {where}.";
            groupWarn = changedArea == 0 ? null
                : lostList > 0 ? $"Changement d'aire : leur liste de lecture n'est pas disponible dans « {target.Area.Name} ». Ils gardent leur contenu publié, sans liste choisie ; leur planning propre est retiré. Choisissez-leur une liste de cette aire."
                : "Changement d'aire : leur planning propre est retiré.";
            lastUndo = undo;
            var moved = undo.Select(u => u.ScreenId).ToList();
            await Notifier.PublishPlanning(moved);
            foreach (var id in moved) await Notifier.NotifyScreen(id);
        }
        selectedIds.Clear();
        Reload();
        LoadGroups();
    }

    private async Task UndoMove()
    {
        if (lastUndo.Count == 0) return;
        var undo = lastUndo.ToList();
        lastUndo = new();
        Store.Write(d => { foreach (var p in undo) AreaOps.Restore(d, p); });
        groupNotice = "Déplacement annulé."; groupWarn = null;
        var ids = undo.Select(u => u.ScreenId).ToList();
        await Notifier.PublishPlanning(ids);
        foreach (var id in ids) await Notifier.NotifyScreen(id);
        Reload();
        LoadGroups();
    }

