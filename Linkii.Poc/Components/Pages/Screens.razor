    private void LoadGroups()
    {
        // les aires du périmètre de la personne et leurs écrans (listes et médias lus dans toute l'organisation, pour l'aperçu)
        groupAreas = Store.Read(d =>
        {
            var lists = d.Root.Playlists.Where(p => p.ClientId == d.ClientId).ToDictionary(p => p.Id);
            var allMedia = d.Root.Media.Where(m => m.ClientId == d.ClientId && m.Status == null).ToList();
            return d.Access.Areas.OrderBy(a => a.Name, StringComparer.CurrentCultureIgnoreCase).Select(a => new GroupArea(a,
                d.Root.Screens.Where(s => s.ClientId == d.ClientId && s.AreaId == a.Id && s.Token != null && (d.Access.Sees == null || d.Access.Sees(s))).ToList(), lists, allMedia)).ToList();
        });
        BuildTabs();
        if (areaFilter != "" && !groupAreas.Any(g => g.Area.Id.ToString() == areaFilter)) areaFilter = "";
    }

