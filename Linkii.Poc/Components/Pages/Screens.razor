    // Aire ouverte choisie dans l'arbre (ou une de ses zones) : les cartes habituelles, rangées par zone
    private RenderFragment TreePaneArea(TArea a) => __builder =>
    {
        var zz = treeZone is { } zid ? a.Zones.FirstOrDefault(z => z.Zone.Id == zid) : null;
        var zs = zz != null ? new List<TZone> { zz } : a.Zones;
        var c = TCountOf(zs.SelectMany(z => z.Screens));
        var pend = zs.SelectMany(z => z.Screens).Where(t => t.Pending).Select(t => t.S.Id).ToList();
        var shown = 0;
        <div class="tr-crumb">
            <button type="button" @onclick="() => SelectNode(null, null)">Toutes les aires</button><Ico Name="chevron-right" Size="13" />
            @if (zz != null) { <button type="button" @onclick="() => SelectNode(a, null)">@a.Area.Name</button><Ico Name="chevron-right" Size="13" /><b>@zz.Zone.Name</b> }
            else { <b>@a.Area.Name</b> }
        </div>
        <div class="tr-head">
            <h2><Ico Name="@(zz != null ? (zz.Zone.IsWall ? "grid" : "box") : "map-pin")" Size="20" /> @(zz?.Zone.Name ?? a.Area.Name)</h2>
            <span class="lx-chip">Aire ouverte</span>
            <span class="tr-sum">
                <span>@Plural(c.N, "écran", "écrans")</span>
                <span><span class="sc-dot en-ligne"></span>@c.On en ligne</span>
                @if (c.Off > 0) { <span class="bad">@c.Off hors ligne</span> }
                @if (c.Pend > 0) { <span class="pend">@c.Pend à publier</span> }
            </span>
            <span class="grow"></span>
            <a class="tb-btn" href="@(zz != null ? $"planning?zone={zz.Zone.Id}" : "planning")"><Ico Name="calendar" Size="14" /> Planning</a>
            @if (pend.Count > 0) { <button type="button" class="btn sm" @onclick="() => AskPublish(pend)"><Ico Name="upload" Size="14" /> Publier (@pend.Count)</button> }
            <div class="kebab">
                <button type="button" class="kebab-btn" aria-label="Actions" aria-haspopup="menu" aria-expanded="@(openMenu == "tree" ? "true" : "false")" @onclick='() => Toggle("tree")'><Ico Name="dots-v" Size="18" /></button>
                @if (openMenu == "tree")
                {
                    <div class="kebab-backdrop" @onclick="CloseMenu"></div>
                    <div class="kebab-menu" role="menu">
                        <button type="button" role="menuitem" @onclick="() => SelectPane(zs.SelectMany(z => z.Screens).Select(t => t.S))"><Ico Name="check" Size="16" /> Tout sélectionner</button>
                        @if (manageZones) { <button type="button" role="menuitem" @onclick='() => { CloseMenu(); Nav.NavigateTo("zones"); }'><Ico Name="gear" Size="16" /> Gérer les zones…</button> }
                    </div>
                }
            </div>
        </div>
        @foreach (var z in zs)
        {
            var hits = z.Screens.Where(t => TMatch(t, z, a)).ToList();
            if (hits.Count == 0) continue;
            shown++;
            var tz = z;
            <section class="tr-zsec">
                @if (zz == null)
                {
                    <div class="zline">
                        <span><b>@tz.Zone.Name</b> · @(tz.Zone.IsWall ? $"mur d'écrans {tz.Zone.WallCols} × {tz.Zone.WallRows}" : "zone libre") · @Plural(tz.Screens.Count, "écran", "écrans")</span>
                        @if (tz.Zone.Sync) { <span class="zstate sync"><Ico Name="link" Size="13" /> Lecture synchronisée</span> }
                        <div class="grow"></div>
                        <button type="button" class="linklike" @onclick="() => SelectNode(a, tz.Zone.Id)">Voir la zone seule</button>
                    </div>
                }
                <div class="pl-grid tr-grid">
                    @if (tz.Zone.IsWall) { @Card(new Entry(tz.Zone, null)) }
                    else { foreach (var t in hits) { @Card(new Entry(null, t.S)) } }
                </div>
            </section>
        }
        @if (shown == 0) { <div class="tr-empty">Aucun écran ne correspond.</div> }
    };

    // ---------- Mur d'écrans ----------
    private readonly List<Guid> pickOrder = new();   // ordre dans lequel les écrans ont été cochés : ordre des places du mur
    private bool wallCreate;
    private Guid? wallEdit, dissolveFor;

    private List<Zone> FreeZones => zones.Where(z => !z.IsWall).ToList();
    private Zone? OpenZone => zoneFilter == null ? null : zones.FirstOrDefault(z => z.Id.ToString() == zoneFilter);

    // « Assembler en mur… » : au moins 2 écrans cochés, aucun déjà dans un mur, gestion des zones permise.
    private bool CanAssemble => Growth && manageZones && area != null && selectedIds.Count >= 2   // les murs d'écrans : licence Pro
        && !screens.Any(s => selectedIds.Contains(s.Id) && ZoneOf(s) is { IsWall: true });

    private record WallCell(int Number, Screen? Screen, string Css, string Title);

    // Cases du mur, dans l'ordre des places : l'écran qui l'occupe (ou une place libre) et son état.
    private List<WallCell> WallCells(Zone wall, List<Screen> inWall) =>
        Enumerable.Range(0, wall.WallCols * wall.WallRows).Select(pos =>
        {
            var at = inWall.FirstOrDefault(x => x.WallPos == pos);
            var label = Helpers.WallLabel(pos, wall.WallCols, wall.WallRows);
            return at == null ? new WallCell(pos + 1, null, "empty", label + " : place libre")
                : new WallCell(pos + 1, at, IsOffline(at) ? "off" : "", label + " : " + at.Name + (IsOffline(at) ? " (hors ligne)" : ""));
        }).ToList();

    // Cartes affichées : un mur prend une seule carte, à la place de son premier écran retenu par les filtres et le tri.
    private record Entry(Zone? Wall, Screen? Screen);

    private List<Entry> Entries
    {
        get
        {
            var list = new List<Entry>();
            var walls = new HashSet<Guid>();
            foreach (var s in Shown)
            {
                if (ZoneOf(s) is { IsWall: true } w) { if (walls.Add(w.Id)) list.Add(new(w, null)); }
                else list.Add(new(null, s));
            }
            return list;
        }
    }

    private List<Screen> WallMembers(Zone wall) => screens.Where(x => ZoneOf(x)?.Id == wall.Id).OrderBy(x => x.WallPos ?? int.MaxValue).ToList();

    // Case du mur : coche ou décoche tous ses écrans, dans l'ordre de leurs places.
    private void ToggleWall(List<Screen> members)
    {
        var ids = members.Select(x => x.Id).ToList();
        if (ids.All(selectedIds.Contains)) { selectedIds.ExceptWith(ids); pickOrder.RemoveAll(ids.Contains); }
        else foreach (var id in ids.Where(id => !selectedIds.Contains(id))) { selectedIds.Add(id); pickOrder.Add(id); }
    }

    private List<Guid> PickedInOrder() =>
        pickOrder.Where(selectedIds.Contains).Concat(screens.Select(s => s.Id).Where(selectedIds.Contains)).Distinct().ToList();   // chaque écran une seule fois

    private void OpenWall() => wallCreate = true;

    private void WallClosed(bool done)
    {
        if (done && wallCreate) { selectedIds.Clear(); pickOrder.Clear(); }
        wallCreate = false;
        wallEdit = null;
        Reload();
        if (done && zones.Where(z => z.IsWall).OrderByDescending(z => z.SyncEpochUtc).FirstOrDefault() is { } last && zoneFilter == null)
            zoneFilter = last.Id.ToString();   // on ouvre le mur qui vient d'être créé
    }

    // ---------- Barre de filtres : listes déroulantes ----------
    private string? openMenu;   // sel | zone | state | sort | zact | wall:<id du mur>
    private void Toggle(string menu) => openMenu = openMenu == menu ? null : menu;
    private void CloseMenu() => openMenu = null;

    // Menu « Filtres » : aire de gestion (si la personne en voit plusieurs), zone (si l'aire en a plusieurs) et état
    private IReadOnlyList<FilterGroup> FilterGroups
    {
        get
        {
            var list = new List<FilterGroup>();
            if (area != null && ShowZones && OwnAreaVisible)
                list.Add(new("zone", "Zone", zoneFilter ?? "", new[] { new FilterOption("", "Toutes", screens.Count) }
                    .Concat(zones.Select(z => new FilterOption(z.Id.ToString(), (z.IsWall ? "Mur " : "") + z.Name, screens.Count(x => ZoneOf(x)?.Id == z.Id)))).ToList()));
            var others = OtherScope;
            list.Add(new("state", "État", statusFilter, new[] { "", "online", "offline", "pending" }
                .Select(k => new FilterOption(k, StateLabel(k), k switch { "online" => InZone.Count(s => !IsOffline(s)) + others.Count(o => !IsOffline(o.Screen)), "offline" => InZone.Count(IsOffline) + others.Count(o => IsOffline(o.Screen)), "pending" => InZone.Count(s => Helpers.HasPending(s, playlists)), _ => InZone.Count + others.Count })).ToList()));
            return list;
        }
    }
    private void PickFilter((string Key, string Value) p)
    {
        if (p.Key == "area") PickArea(p.Value);
        else if (p.Key == "zone") PickZone(p.Value == "" ? null : zones.FirstOrDefault(z => z.Id.ToString() == p.Value)); else statusFilter = p.Value;
    }
    private void ClearFilter(string key) => PickFilter((key, ""));
    private void ResetFilters() { areaFilter = ""; PickZone(null); statusFilter = ""; }
    private void PickArea(string id) { areaFilter = id; if (!OwnAreaVisible) zoneFilter = null; dissolveFor = null; CloseMenu(); }   // les zones sont celles de l'aire ouverte

    // Filtre « Aire » (24 octobre 2026) : une aire choisie est ouverte (ses zones, la connexion d'un écran) ; « Toutes » montre toutes les aires, groupées. Mémorisé par personne.
    private void PickAreaFilter(string id)
    {
        try { Store.Write(d => { if (d.Users.FirstOrDefault(u => u.Id == d.Access.UserId) is { } u) u.LibraryTabs["screens-area"] = id == "" ? "" : "one"; }); }
        catch (UnauthorizedAccessException) { }   // lecture seule : le choix n'est pas retenu
        zoneFilter = null; treeArea = null; treeZone = null;
        Reload();
        areaFilter = id == "" ? "" : area?.Id.ToString() ?? "";
        if (area != null) treeOpen.Add(area.Id);
    }
    private void PickZone(Zone? z) { zoneFilter = z?.Id.ToString(); dissolveFor = null; CloseMenu(); }

    private static string ZoneIcon(Zone z) => z.IsWall ? "grid" : z.Sync ? "link" : "box";

    private static string StateLabel(string key) => key switch { "online" => "En ligne", "offline" => "Hors ligne", "pending" => "À publier", _ => "Tous" };
    private static string SortLabel(string key) => key switch { "status" => "État", "pending" => "À publier d'abord", _ => "Nom" };

    // Écrans affichés (zone ouverte) qui ont des modifications à publier : le bouton Publier n'apparaît que s'il y en a.
    private List<Guid> PendingShown => InZone.Where(s => Helpers.HasPending(s, playlists)).Select(s => s.Id).ToList();

    private async Task IdentifyWall(Zone wall, List<Screen> inWall)
    {
        CloseMenu();
        await Notifier.Identify(inWall.OrderBy(s => s.WallPos ?? int.MaxValue).Select(s => s.Id).ToList());
        Toast.Ok("Chaque écran du mur affiche son numéro pendant 5 secondes.");
    }

    private void SetWallPlaylist(Zone wall, Guid? pid)
    {
        if (area == null) return;
        var aid = area.Id;
        var err = Store.Write(d => AreaOps.SetWallPlaylist(d, aid, wall.Id, pid));
        if (err != null) { Toast.Error(err); return; }
        Toast.Ok("Liste du mur choisie : publiez le mur pour l'afficher.");
        Reload();
    }

    private async Task Dissolve(Zone wall)
    {
        if (area == null) return;
        var aid = area.Id;
        var ids = screens.Where(s => s.ZoneId == wall.Id).Select(s => s.Id).ToList();
        var err = Store.Write(d => AreaOps.DissolveWall(d, aid, wall.Id));
        dissolveFor = null;
        if (err != null) { Toast.Error(err); return; }
        foreach (var id in ids) await Notifier.NotifyScreen(id);   // chaque écran rejoue la liste en entier
        zoneFilter = null;
        Toast.Ok($"Mur « {wall.Name} » dissous.");
        Reload();
    }

    // Synchro d'une zone (bandeau de la zone ouverte) : les écrans de la zone rechargent leur configuration.
    private async Task ToggleSync(Zone z)
    {
        if (area == null) return;
        var on = !z.Sync;
        var aid = area.Id;
        var err = Store.Write(d => AreaOps.SetZoneSync(d, aid, z.Id, on));
        if (err != null) { Toast.Error(err); return; }
        await Notifier.NotifyZone(z.Id);
        Toast.Ok(on ? $"Lecture synchronisée dans la zone « {z.Name} »." : $"Synchronisation coupée dans la zone « {z.Name} ».");
        Reload();
    }

    private void OpenAreaMove(Screen s) { menuFor = null; areaMove = new() { (s.Id, s.Name) }; }

    private void OpenBulkAreaMove() => areaMove = screens.Where(s => selectedIds.Contains(s.Id)).Select(s => (s.Id, s.Name)).ToList();

    private void AreaMoved(bool moved)
    {
        areaMove = null;
        if (moved) Reload();   // les écrans déplacés ne sont plus de cette aire : ils sortent aussi de la sélection
    }

    private void Reload()
    {
        tenant = Store.Read(d => d.Tenant);   // licence : peut changer pendant que la page est ouverte
        (area, manageZones, noArea) = Store.Read(d => (d.Area, d.Access.ManagesCurrent, d.Access.OrgAreaCount > 0 && d.Area == null));
        zones = Store.Read(d => d.Area?.Zones.Where(z => d.Access.SeesZone(z.Id)).OrderByDescending(z => z.IsDefault).ThenBy(z => z.Name, StringComparer.CurrentCultureIgnoreCase).ToList()) ?? new();   // seules les zones du périmètre
        // connecter un écran : administrateur, ou utilisateur qui gère ses écrans (l'écran lui est attribué d'office) ; pas en lecture seule
        canAdd = Store.Read(d => d.Area != null && d.Access.CanWrite(LevelPages.Screens));
        canAssign = Store.Read(d => d.Access.IsOrgAdmin && d.Users.Any(u => u.Role == Roles.ClientMember));
        screenShares = !canAssign ? new() : Store.Read(d => d.AllScreens.ToDictionary(s => s.Id, s => MemberOps.ManagersOf(d, s)).Where(x => x.Value.Count > 0)
            .ToDictionary(x => x.Key, x => new ShareSummary(x.Value.Count, null, x.Value.Select(u => (u.Label, true)).OrderBy(n => n.Item1, StringComparer.CurrentCultureIgnoreCase).ToList())));
        otherAreas = Store.Read(d => d.Access.IsOrgAdmin && d.Area is { } cur ? d.Areas.Where(a => a.Id != cur.Id).OrderBy(a => a.Name).ToList() : new());
        if (zoneFilter != null && !zones.Any(z => z.Id.ToString() == zoneFilter)) zoneFilter = null;
        var rawScreens = Store.Read(d => d.Screens.Where(s => s.Token != null).OrderBy(s => s.Name).ToList());
        LoadTabs();
        screens = TabFilter(rawScreens, zones);
        folderRows = Store.Read(ScreenFolderOps.Rows);
        FilterFolders();
        BuildFolders();
        selectedIds.IntersectWith(screens.Select(s => s.Id));
        synced = zones.Where(z => z.Sync).SelectMany(z => Helpers.SyncedScreens(screens.Where(s => ZoneOf(s)?.Id == z.Id))).ToHashSet();
        playlists = Store.Read(d => PlaylistOps.Choosable(d));   // listes que la personne voit, et celles déjà en place
        media = Store.Read(d => d.Media.Where(m => m.Status == null).ToList());
        LoadGroups();
        treeData = TreeData();
        LoadFirstScreen();
    }

    private List<Area> pairAreas = new();

    // Aire du nouvel écran : elle devient l'aire ouverte (ses zones), et le filtre suit s'il était sur une aire
    private void PairAreaChanged(ChangeEventArgs e)
    {
        if (!Guid.TryParse(e.Value?.ToString(), out var id) || id == area?.Id || !Store.SwitchArea(id)) return;
        Reload();
        if (areaFilter != "") areaFilter = id.ToString();
        pairZone = (zones.FirstOrDefault(z => z.IsDefault) ?? FreeZones.FirstOrDefault())?.Id.ToString() ?? "";
    }

    private string? pairPrice;   // abonné : ce que coûte un écran de plus (rappel dans la fenêtre)
    private void SetPairPrice()
    {
        var prorata = ScreenProrata();
        if (prorata <= 0) { pairPrice = null; return; }
        var unit = Store.Read(d => Billing.PeriodAmount(d.Root, d.Tenant.Plan, d.Tenant.BillingPeriod, 1));
        pairPrice = Store.Read(d => d.Access.IsOrgAdmin)
            ? $"Cet écran s'ajoute à votre abonnement : +{Lifecycle.Chf(unit)} {(tenant.BillingPeriod == "annual" ? "par an" : "par mois")}, {Lifecycle.Chf(prorata)} aujourd'hui au prorata."
            : "Cet écran s'ajoute à l'abonnement de l'organisation : les administrateurs en sont prévenus.";
    }

    private bool pairKiosk;   // « Borne interactive » : l'écran connecté reçoit un menu de tuiles (Screen.Kiosk)
    private void OpenPairKiosk() { OpenPair(); pairKiosk = true; pairSpec.Orientation = "portrait"; }
    private void OpenPair() { pairKiosk = false; SetPairPrice(); pairAreas = Store.Read(AreaFilter.Visible); code = name = ""; pairFull = true; playlistId = null; error = null; pairSpec = ScreenSpec.From(tenant); pairSpec.Resolution = "auto"; pairZone = (FreeZones.FirstOrDefault(z => z.Id.ToString() == zoneFilter) ?? zones.FirstOrDefault(z => z.IsDefault) ?? FreeZones.FirstOrDefault())?.Id.ToString() ?? ""; showPair = true; }

    private Guid? kioskOpen;   // tiroir de la borne ouverte (KioskDrawer)
    private void CloseKiosk() { kioskOpen = null; Reload(); }
    private void Edit(Screen s) { menuFor = null; if (s.Kiosk != null) { kioskOpen = s.Id; return; } editing = s.Id; }   // une borne s'ouvre dans son tiroir

    // ---------- Paramètres de l'écran, plusieurs écrans sur un même PC ----------
    private Guid? settingsFor;
    private Screen? addPcFrom;
    private string addPcName = "";
    private string addPcRes = "1920x1080";
    private int addPcMonitor = 1;
    private bool addPcWindowed, addPcBusy;
    private string? addPcError;
    private Dictionary<int, string> addPcTaken = new();

    // Menu ⋮ : paramètres de l'écran ; sur un PC Windows, ajouter un écran déjà appairé
    private RenderFragment PcItems(Screen s) => @<text>
        <button type="button" role="menuitem" @onclick="() => { menuFor = null; settingsFor = s.Id; }"><Ico Name="sliders" Size="16" /> Paramètres de l'écran</button>
        @if (DeviceConfig.IsPc(s))
        {
            <button type="button" role="menuitem" class="hl" @onclick="() => OpenAddOnPc(s)"><Ico Name="plus" Size="16" /> <span>Ajouter un écran sur ce PC<small>Nouvel écran déjà appairé, sans code</small></span></button>
        }
    </text>;

    /// <summary>Écrans du PC de cet écran, lui compris (1 : seul sur son PC, ou pas un PC).</summary>
    private int PcCount(Screen s) => DeviceConfig.IsPc(s) ? 1 + DeviceConfig.SamePc(screens, s).Count() : 1;

    private string PcTitle(Screen s) => "Sur le même PC : " + string.Join(", ", screens.Where(x => x.Id == s.Id || DeviceConfig.SamePc(screens, s).Contains(x)).Select(x => x.Name));

    /// <summary>« moniteur 2 » : seulement pour un PC qui a plusieurs moniteurs ou plusieurs écrans.</summary>
    private string? MonitorText(Screen s) =>
        DeviceConfig.IsPc(s) && (s.DeviceMonitors.Count > 1 || PcCount(s) > 1) ? (s.Windowed ? $"fenêtre, moniteur {s.Monitor}" : $"moniteur {s.Monitor}") : null;

    private void OpenAddOnPc(Screen s)
    {
        menuFor = null; addPcError = null; addPcBusy = false;
        var mates = DeviceConfig.SamePc(screens, s).Append(s).ToList();
        addPcTaken = mates.Where(x => !x.Windowed).GroupBy(x => x.Monitor).ToDictionary(g => g.Key, g => g.First().Name);
        var n = 2;
        while (screens.Any(x => x.Name == $"{s.Name} {n}")) n++;
        addPcName = $"{s.Name} {n}";
        addPcRes = s.Resolution;
        var free = s.DeviceMonitors.OrderBy(m => m.N).FirstOrDefault(m => !addPcTaken.ContainsKey(m.N));
        addPcMonitor = free?.N ?? s.Monitor;
        addPcWindowed = free == null || s.Windowed;   // tous les moniteurs sont pris, ou l'écran d'origine est déjà en fenêtre (tests) : une fenêtre
        addPcFrom = s;
    }

    private async Task AddOnPc()
    {
        if (addPcFrom is not { } from) return;
        var n = addPcName.Trim();
        if (n.Length == 0) return;
        if (n.Length > 80) n = n[..80];
        if (!addPcWindowed && addPcTaken.ContainsKey(addPcMonitor)) { addPcError = $"Le moniteur {addPcMonitor} est déjà pris par « {addPcTaken[addPcMonitor]} » : choisissez-en un autre, ou une fenêtre."; return; }
        var (mon, win, res) = (addPcMonitor, addPcWindowed, addPcRes);
        await WithScreenCharge(n, async () =>   // un écran de plus sur le PC : facturé comme tout écran ajouté
        {
            addPcBusy = true;
            var id = Store.Write(d => d.Screens.FirstOrDefault(x => x.Id == from.Id) is { } src ? DeviceConfig.AddOnSamePc(d, src, n, mon, win, res).Id : (Guid?)null);
            if (id == null) { addPcBusy = false; addPcError = "Écran introuvable."; return false; }
            await Notifier.PublishScreen(id.Value);   // il diffuse aussitôt la liste héritée
            await Notifier.NotifyScreen(from.Id);     // le PC reçoit l'écran à ouvrir avec sa configuration
            addPcFrom = null;
            Toast.Ok($"Écran « {n} » ajouté : le PC l'ouvre dans quelques secondes.");
            Reload();
            return true;
        });
    }

    private void CloseEdit() { editing = null; Reload(); }

    // ---------- Écran ajouté chez un abonné : facturé au prorata ----------
    private PayRequest? screenPay;
    private Func<Task>? afterScreenPay;

    /// <summary>Supplément au prorata d'un écran de plus (0 pendant l'essai ou sans abonnement).</summary>
    private decimal ScreenProrata() { var now = DateTime.UtcNow; return Store.Read(d => Billing.ScreenProrata(d.Root, d.Tenant, now)); }

    /// <summary>Un administrateur paie le prorata dans la fenêtre de paiement avant que l'écran soit connecté ; un utilisateur connecte l'écran
    /// (prélevé d'office sur la carte enregistrée) et les administrateurs sont prévenus.</summary>
    private async Task WithScreenCharge(string screenName, Func<Task<bool>> connect)
    {
        var prorata = ScreenProrata();
        if (prorata > 0 && Store.Read(d => d.Access.IsOrgAdmin))
        {
            var now = DateTime.UtcNow;
            var (unit, next) = Store.Read(d => (Billing.PeriodAmount(d.Root, d.Tenant.Plan, d.Tenant.BillingPeriod, 1), d.Tenant.NextRenewalUtc));
            screenPay = new(prorata, $"+1 écran : « {screenName} »", $"Prorata jusqu'au {Signup.Day(tenant, next!.Value)} ({Billing.DaysToRenewal(tenant, now)} jours), puis {Lifecycle.Chf(unit)} {(tenant.BillingPeriod == "annual" ? "par an" : "par mois")}.");
            afterScreenPay = async () => { if (await connect()) await ChargeScreen(screenName, prorata); };
            return;
        }
        if (await connect() && prorata > 0) await ChargeScreen(screenName, prorata);
    }

    private async Task ChargeScreen(string screenName, decimal prorata)
    {
        var now = DateTime.UtcNow;
        var by = Store.Read(d => d.Access.IsOrgAdmin) ? "" : Store.Read(d => d.Root.Users.FirstOrDefault(u => u.Id == d.Access.UserId)?.Name ?? "");
        var n = Store.Write(d => { Billing.ChargeScreen(d.Root, d.Tenant, screenName, now, simulated: true); return Lifecycle.ScreenAdded(d.Root, d.Tenant, screenName, by, prorata, now); });
        await Mails.Send(Store.ClientId, n, allAdmins: true);
    }

    private async Task ScreenPayDone(PayDialog.Outcome o)
    {
        var then = afterScreenPay;
        screenPay = null; afterScreenPay = null;
        if (o.Cancelled || then == null) return;
        if (!o.Paid) { Toast.Error("Paiement refusé (simulation) : l'écran n'a pas été connecté."); return; }
        await then();
    }

    private async Task Pair()
    {
        error = null;
        if (noArea) { error = "Aucune aire de gestion ne vous est confiée."; return; }
        if (!canAdd) { error = "Vous êtes en lecture seule sur les écrans : vous ne pouvez pas en connecter."; return; }
        var c0 = code.Trim();
        if (!Store.Read(d => d.Root.Screens.Any(x => x.Token == null && x.PairingCode == c0))) { error = "Code inconnu."; return; }   // vérifié avant tout paiement
        await WithScreenCharge(string.IsNullOrWhiteSpace(name) ? "Écran " + c0 : name.Trim(), PairNow);
    }

    private async Task<bool> PairNow()
    {
        error = null;
        var spec = pairSpec;
        var full = pairFull;
        var pid = playlistId;
        var screenName = name;
        var kiosk = pairKiosk;
        Guid? zid = Guid.TryParse(pairZone, out var zg) && zones.Any(z => z.Id == zg) ? zg : (zones.FirstOrDefault(z => z.IsDefault) ?? FreeZones.FirstOrDefault())?.Id;
        var id = Store.Write(d =>
        {
            var s = d.ClaimScreen(code.Trim());
            if (s == null) return (Guid?)null;
            s.Name = string.IsNullOrWhiteSpace(screenName) ? "Écran " + code : screenName.Trim();
            s.PlaylistId = pid;
            if (zid != null) s.ZoneId = zid;   // sinon la zone par défaut de l'aire (ClaimScreen)
            MemberOps.AdoptScreen(d, s.Id);   // un utilisateur gère l'écran qu'il connecte
            s.ScreenType = spec.Type; s.Orientation = spec.Orientation; s.Resolution = spec.Resolution;
            s.AutoStart = d.Tenant.DefaultAutoStart;
            s.Windowed = !full;
            s.Token = Guid.NewGuid().ToString("N");
            s.PairingCode = null;
            if (kiosk) { s.Kiosk = KioskConfig.Starter(); s.KioskRevision = 1; }   // borne interactive : menu vide, à composer dans la page de la borne
            d.Tenant.FirstScreen = FirstScreen.Done;   // un écran relié : l'assistant du premier écran ne revient plus
            return s.Id;
        });
        if (id == null) { error = "Code inconnu."; return false; }
        await Notifier.PublishScreen(id.Value);   // l'écran appairé diffuse aussitôt sa liste de lecture
        showPair = false;
        Toast.Ok($"{(kiosk ? "Borne" : "Écran")} « {(string.IsNullOrWhiteSpace(screenName) ? "Écran " + code : screenName.Trim())} » connecté{(kiosk ? "e" : "")}.");
        if (kiosk) { showPair = false; Reload(); kioskOpen = id.Value; return true; }   // la borne s'ouvre dans son tiroir : on compose son menu
        if (tab == LibraryTab.Shared) tab = LibraryTab.Mine;   // l'écran connecté est le sien
        if (wizardPairing) { wizardPairing = false; wizard?.Connected(); }   // relié depuis l'assistant (après un paiement) : « C'est en ligne »
        Reload();
        return true;
    }

    // ---------- Sélection multiple et publication ----------
    private readonly HashSet<Guid> selectedIds = new();
    private bool bulkPublishing;
    private List<Guid>? confirmIds;   // écrans à publier, en attente de confirmation

    private void ToggleSelect(Guid id) { pickOrder.RemoveAll(x => x == id); if (!selectedIds.Remove(id)) { selectedIds.Add(id); pickOrder.Add(id); } }


    private void AskPublish(List<Guid> ids)
    {
        menuFor = null;
        if (ids.Count > 0) confirmIds = ids;
    }

    // Chaque écran reçoit sa propre publication (sa liste de lecture et ses widgets, dans leur état actuel). Les autres écrans ne changent pas.
    private async Task ConfirmPublish()
    {
        if (confirmIds is not { } ids) return;
        bulkPublishing = true;
        try { foreach (var id in ids) await Notifier.PublishScreen(id); }
        finally { bulkPublishing = false; }
        confirmIds = null;
        foreach (var id in ids) selectedIds.Remove(id);
        Toast.Ok($"Publié sur {ids.Count} écran{(ids.Count > 1 ? "s" : "")} à {DateTime.Now:HH:mm}.");
        Reload();
    }

    // Playlist par défaut de l'écran : enregistrée tout de suite, diffusée à la prochaine publication (confirmée) de l'écran.
    private void Assign(Screen s, ChangeEventArgs e)
    {
        var pid = Guid.TryParse(e.Value?.ToString(), out var g) ? g : (Guid?)null;
        Store.Write(d => { if (d.Screens.FirstOrDefault(x => x.Id == s.Id) is { } sc) sc.PlaylistId = pid; });
        Toast.Ok(pid == null ? $"Aucune liste de lecture pour « {s.Name} ». Publiez l'écran pour l'appliquer." : $"Liste de lecture « {playlists.FirstOrDefault(p => p.Id == pid)?.Name} » choisie pour « {s.Name} ». Publiez l'écran pour la diffuser.");
        Reload();
    }

    // Écran découpé (vue cartes) : liste de lecture d'une zone, même règle que dans l'éditeur (diffusée à la prochaine publication).
    private Guid? plPop;
    private void AssignZone(Screen s, int zone, ChangeEventArgs e)
    {
        var pid = Guid.TryParse(e.Value?.ToString(), out var g) ? g : (Guid?)null;
        Store.Write(d => { if (d.Screens.FirstOrDefault(x => x.Id == s.Id) is { } sc) sc.SetZonePlaylist(zone, pid); });
        Toast.Ok($"Zone {zone + 1} de « {s.Name} » : {(pid == null ? "aucune liste de lecture" : "« " + playlists.FirstOrDefault(p => p.Id == pid)?.Name + " »")}. Publiez l'écran pour l'appliquer.");
        Reload();
    }

    // ---------- Renommer (menu ⋮) ----------
    private Screen? renamingScreen;
    private string renameValue = "";
    private ElementReference renameInput;
    private bool focusRename;

    private void OpenRename(Screen s) { menuFor = null; renamingScreen = s; renameValue = s.Name; focusRename = true; }

    private void OnRenameKey(KeyboardEventArgs e)
    {
        if (e.Key == "Enter") RenameScreen();
        else if (e.Key == "Escape") renamingScreen = null;
    }

    // Le nom n'est pas diffusé : rien à publier.
    private void RenameScreen()
    {
        if (renamingScreen is not { } s || string.IsNullOrWhiteSpace(renameValue)) return;
        var name = renameValue.Trim();
        if (name.Length > 80) name = name[..80];
        Store.Write(d => { if (d.Screens.FirstOrDefault(x => x.Id == s.Id) is { } sc) sc.Name = name; });
        renamingScreen = null;
        Toast.Ok($"Écran renommé en « {name} ».");
        Reload();
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (cleanQuery && !firstRender) { cleanQuery = false; Nav.NavigateTo(Nav.GetUriWithQueryParameters(new Dictionary<string, object?> { ["edit"] = null, ["arbre"] = null, ["zone"] = null }), replace: true); }
        if (firstRender)
        {
            // look app : pas d'arborescence ; densité Vignettes / Lignes mémorisée dans le navigateur
            string? dens = null;
            try { isApp = await JS.InvokeAsync<bool>("linkiiPrefs.isApp"); dens = await JS.InvokeAsync<string?>("linkiiPrefs.get", "screens-densite"); } catch (JSException) { } catch (InvalidOperationException) { }
            if (isApp || dens == "rows") { if (dens == "rows") treeDens = "rows"; StateHasChanged(); }
        }
        if (focusRename && renamingScreen != null) { focusRename = false; await renameInput.FocusAsync(); }
    }

    private void Remove(List<Screen> list)
    {
        var ids = list.Select(x => x.Id).ToHashSet();
        selectedIds.ExceptWith(ids);
        Store.Write(d => { d.Screens.RemoveAll(x => ids.Contains(x.Id)); });
        Toast.Ok(list.Count > 1 ? $"{list.Count} écrans supprimés." : $"Écran « {list[0].Name} » supprimé.");
        deleting = null;
        Reload();
    }

    public void Dispose() => timer?.Dispose();
