            s.ScreenType = spec.Type; s.Orientation = spec.Orientation; s.Resolution = spec.Resolution;
            s.Token = Guid.NewGuid().ToString("N");
            s.PairingCode = null;
            return s.Id;
        });
        if (id == null) { error = "Code inconnu."; return; }
        await Notifier.PublishScreen(id.Value);   // l'écran appairé diffuse aussitôt sa liste de lecture
        showPair = false;
        Toast.Ok($"Écran « {(string.IsNullOrWhiteSpace(screenName) ? "Écran " + code : screenName.Trim())} » connecté.");
