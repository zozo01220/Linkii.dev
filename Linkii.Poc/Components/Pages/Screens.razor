    private void BuildFolders()
    {
        if (folderId is { } open && !folderRows.Any(r => r.Folder.Id == open)) folderId = null;   // dossier retiré entre-temps
        subfolders = folderRows.Where(r => r.Folder.ParentId == folderId || folderId == null && r.Folder.ParentId is { } p && folderRows.All(x => x.Folder.Id != p)).ToList();
        crumbs = new();
        for (var cur = currentRow; cur != null && crumbs.Count < FolderAccess.MaxDepth; cur = cur.Folder.ParentId is { } p ? folderRows.FirstOrDefault(r => r.Folder.Id == p) : null)
            crumbs.Insert(0, cur);
    }

