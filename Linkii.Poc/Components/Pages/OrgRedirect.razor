@page "/areas"
@page "/members"
@inject NavigationManager Nav

@* Anciennes adresses : Aires de gestion et Membres sont dans la page Organisation. *@

@code {
    protected override void OnInitialized()
    {
        var members = new Uri(Nav.Uri).AbsolutePath.TrimEnd('/') == "/members";
        Nav.NavigateTo(members ? "/organisation?tab=members" : "/organisation", replace: true);
    }
}
