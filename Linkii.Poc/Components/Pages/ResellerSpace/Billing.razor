@page "/reseller/billing"
@attribute [Microsoft.AspNetCore.Authorization.Authorize(Policy = "ResellerSpace")]
@implements IDisposable
@inject JsonStore Root
@inject TenantContext Ctx
@inject Toaster Toast

<div class="page-head">
    <div>
        <h1>Facturation</h1>
        <p class="sub sc-intro">Linkivi encaisse vos clients au tarif Linkivi et vous verse votre commission le dernier jour du mois. Les montants se mettent à jour à chaque paiement.</p>
    </div>
    <span class="adm-st ok" title="Actualisé toutes les 30 secondes">En direct · @updated.ToLocalTime().ToString("HH:mm:ss")</span>
</div>

<div class="adm-k4">
    <div class="adm-card"><div class="kl">À toucher fin @MonthName</div><div class="kn" style="color:var(--ok)">@Subscriptions.Fmt(share.Commission) <small class="muted" style="font-size:12px">CHF</small></div>
        <div class="ks">Versement le @Subscriptions.PayoutDate(year, month).ToString("d MMMM", Fr) · commission de Linkivi @pct %</div></div>
    <div class="adm-card"><div class="kl">Encore attendu d'ici fin de mois</div><div class="kn">@Subscriptions.Fmt(expectedSum) <small class="muted" style="font-size:12px">CHF</small></div>
        <div class="ks">@expected.Count renouvellement@(expected.Count > 1 ? "s" : "") à venir · prévision, pas un acquis</div></div>
    <div class="adm-card"><div class="kl">Prévision fin @MonthName</div><div class="kn">@Subscriptions.Fmt(share.Commission + expectedSum) <small class="muted" style="font-size:12px">CHF</small></div>
        <div class="ks">acquis + attendu</div></div>
    <div class="adm-card"><div class="kl">Encaissé par Linkivi ce mois</div><div class="kn">@Subscriptions.Fmt(share.Gross) <small class="muted" style="font-size:12px">CHF</small></div>
        <div class="ks">frais −@Subscriptions.Fmt(share.Fees) · net @Subscriptions.Fmt(share.Net)</div></div>
</div>
<div class="adm-note" style="margin:-4px 0 14px">Votre part = (montant payé par le client − frais de paiement) moins la commission de Linkivi (@pct %). Un paiement annuel est commissionné d'un coup, à sa réception. Un client en essai ne rapporte rien tant qu'il n'a pas payé.</div>

<div class="adm-sec" style="margin-top:0"><span class="lb">Vos clients</span></div>
<div class="adm-card" style="padding:0;overflow:hidden"><div class="tbl-scroll">
<table class="adm-tbl">
    <thead><tr><th>Client</th><th>Licence</th><th class="r">Écrans</th><th>Paiement</th><th class="r">Montant client</th><th>Renouvellement</th><th class="r">Ma part ce mois</th></tr></thead>
    <tbody style="cursor:default">
    @foreach (var c in clients)
    {
        <tr style="cursor:default">
            <td><b>@c.C.Name</b><small class="adm-sub"><span class="adm-st @ClientStates.Css(c.State)">@c.State</span></small></td>
            <td><span class="adm-plan @(c.C.IsGrowth ? "g" : "")">@Plans.Label(c.C.Plan)</span></td>
            <td class="r m">@c.Screens</td>
            <td>@(c.C.BillingPeriod == "annual" ? "Annuel" : "Mensuel")</td>
            <td class="r m">@(c.Amount > 0 ? Subscriptions.Fmt(c.Amount) : "—")</td>
            <td>@Renewal(c)</td>
            <td class="r m">@if (c.Earned > 0) { <b>@Subscriptions.Fmt(c.Earned)</b> } else if (c.Expected > 0) { <span class="muted" title="Attendu : prévision">(@Subscriptions.Fmt(c.Expected))</span> } else { <span class="muted">—</span> }</td>
        </tr>
    }
    @if (clients.Count == 0) { <tr><td colspan="7" style="text-align:center;color:var(--muted);padding:26px">Aucun client pour l'instant.</td></tr> }
    </tbody>
</table></div></div>
<div class="adm-note">Un client dont le renouvellement n'est pas payé à sa date anniversaire est bloqué automatiquement, puis débloqué dès que son paiement est enregistré. Entre parenthèses : part attendue, pas encore encaissée.</div>

<div class="adm-sec"><span class="lb">Paiements reçus en @MonthName</span></div>
<div class="adm-card" style="padding:0;overflow:hidden"><div class="tbl-scroll">
<table class="adm-tbl">
    <thead><tr><th>Date</th><th>Client</th><th class="r">Payé</th><th class="r">Frais</th><th class="r">Net</th><th class="r">Ma part</th></tr></thead>
    <tbody style="cursor:default">
    @foreach (var p in payments)
    {
        <tr style="cursor:default">
            <td>@Subscriptions.ToLocal(p.PaidUtc).ToString("d MMM HH:mm", Fr)</td>
            <td><b>@p.Name</b><small class="adm-sub">@(p.First ? "premier paiement" : p.Period == "annual" ? "renouvellement annuel" : "renouvellement mensuel") · jusqu'au @p.ToUtc.ToString("d MMM yyyy", Fr)</small></td>
            <td class="r m">@Subscriptions.Fmt(p.Amount)</td>
            <td class="r m">−@Subscriptions.Fmt(p.Fee)</td>
            <td class="r m">@Subscriptions.Fmt(p.Amount - p.Fee)</td>
            <td class="r m"><b>@Subscriptions.Fmt(p.Commission)</b> <small class="muted">Linkivi @p.CommissionPct %</small></td>
        </tr>
    }
    @if (payments.Count == 0) { <tr><td colspan="6" style="text-align:center;color:var(--muted);padding:24px">Aucun paiement reçu ce mois-ci pour le moment.</td></tr> }
    </tbody>
</table></div></div>

<div class="adm-sec"><span class="lb">Versements</span></div>
<div class="adm-card" style="padding:0;overflow:hidden"><div class="tbl-scroll">
<table class="adm-tbl">
    <thead><tr><th>Mois</th><th class="r">Paiements</th><th class="r">Net</th><th class="r">Ma part</th><th>Statut</th></tr></thead>
    <tbody style="cursor:default">
    @foreach (var h in history)
    {
        <tr style="cursor:default">
            <td>@h.Label</td>
            <td class="r m">@h.Share.Payments</td>
            <td class="r m">@Subscriptions.Fmt(h.Share.Net)</td>
            <td class="r m"><b>@Subscriptions.Fmt(h.Payout?.Amount ?? h.Share.Commission)</b></td>
            <td><span class="adm-st @(h.State == Subscriptions.PayoutDone ? "ok" : h.State == Subscriptions.PayoutDue ? "warn" : "mute")">@h.State</span>
                @if (h.Payout is { } po) { <small class="adm-sub">le @Subscriptions.ToLocal(po.PaidUtc).ToString("d MMM yyyy", Fr)@(po.Reference != "" ? " · " + po.Reference : "")</small> }
                else if (h.State == Subscriptions.PayoutOpen) { <small class="adm-sub">versement le @Subscriptions.PayoutDate(h.Year, h.Month).ToString("d MMM", Fr)</small> }</td>
        </tr>
    }
    </tbody>
</table></div></div>

<div class="adm-sec"><span class="lb">Coordonnées de versement</span></div>
<div class="adm-card">
    <div class="form-grid">
        <div><label class="lbl">IBAN</label><input class="full mono" @bind="iban" placeholder="CH93 0076 2011 6238 5295 7" autocomplete="off" spellcheck="false" /></div>
        <div><label class="lbl">Numéro de TVA <small>(facultatif)</small></label><input class="full mono" @bind="vat" placeholder="CHE-123.456.789 TVA" autocomplete="off" spellcheck="false" /></div>
    </div>
    <div class="row" style="gap:10px;margin-top:12px"><button type="button" class="btn" @onclick="SaveBank">Enregistrer</button>
        @if (string.IsNullOrWhiteSpace(savedIban)) { <span class="adm-st warn">IBAN manquant : aucun versement possible</span> } else { <span class="adm-st ok">IBAN enregistré</span> }</div>
</div>

@code {
    private record CRow(Tenant C, string State, int Screens, decimal Amount, DateTime? Next, string Sub, bool BlockedForPayment, decimal Earned, decimal Expected);
    private record HRow(int Year, int Month, string Label, Subscriptions.Share Share, Payout? Payout, string State);

    private static readonly System.Globalization.CultureInfo Fr = new("fr-CH");
    private Timer? timer;
    private DateTime updated = DateTime.UtcNow;
    private int year, month, pct;
    private Subscriptions.Share share = Subscriptions.Share.None;
    private decimal expectedSum;
    private List<Subscriptions.Expected> expected = new();
    private List<CRow> clients = new();
    private List<Payment> payments = new();
    private List<HRow> history = new();
    private string iban = "", vat = "", savedIban = "";

    private string MonthName => Fr.DateTimeFormat.GetMonthName(month);

    private RenderFragment Renewal(CRow c) => builder =>
    {
        var css = c.BlockedForPayment || c.Sub == Subscriptions.Unpaid ? "bad" : c.Sub == Subscriptions.Soon || c.Sub == Subscriptions.FirstDue ? "warn" : c.Sub == Subscriptions.Current ? "ok" : "mute";
        builder.OpenElement(0, "span"); builder.AddAttribute(1, "class", "adm-st " + css);
        builder.AddContent(2, c.BlockedForPayment ? "Bloqué : non payé" : c.Sub == Subscriptions.NotBilled ? "Pas encore facturé" : c.Sub);
        builder.CloseElement();
        if (c.Next is { } n) { builder.OpenElement(3, "small"); builder.AddAttribute(4, "class", "adm-sub"); builder.AddContent(5, (c.Sub == Subscriptions.Current ? "jusqu'au " : "échéance le ") + n.ToString("d MMM yyyy", Fr)); builder.CloseElement(); }
    };

    protected override void OnInitialized()
    {
        Load();
        timer = new Timer(_ => InvokeAsync(() => { Load(); StateHasChanged(); }), null, 30000, 30000);
    }

    public void Dispose() => timer?.Dispose();

    private void Load()
    {
        var rid = Ctx.RequireResellerId();
        var now = DateTime.UtcNow;
        updated = now;
        var local = Subscriptions.ToLocal(now);
        (year, month) = (local.Year, local.Month);
        Root.Read(db =>
        {
            var r = db.Resellers.First(x => x.Id == rid);
            pct = Subscriptions.CommissionPct(db, r);
            share = Subscriptions.ShareOf(db, r, year, month);
            expected = Subscriptions.ExpectedOf(db, r, now);
            expectedSum = expected.Sum(e => e.Commission);
            payments = db.Payments.Where(p => p.ResellerId == rid && Subscriptions.InMonth(p.PaidUtc, year, month)).OrderByDescending(p => p.PaidUtc).ToList();
            clients = db.Clients.Where(c => c.ResellerId == rid).OrderBy(c => c.Name).Select(c =>
            {
                var billable = Subscriptions.Billable(db, c, now);
                var earned = payments.Where(p => p.ClientId == c.Id).Sum(p => p.Commission);
                var exp = expected.Where(e => e.Client.Id == c.Id).Sum(e => e.Commission);
                return new CRow(c, ClientStates.Of(c, Signup.OwnerOf(db, c), now), Subscriptions.ScreensOf(db, c), billable || c.NextRenewalUtc != null ? Subscriptions.ClientAmount(db, c) : 0,
                    c.NextRenewalUtc, Subscriptions.StateOf(c.NextRenewalUtc, billable || c.TrialEndsUtc != null, now), c.Blocked && c.BlockedReason == Subscriptions.PaymentReason, earned, exp);
            }).ToList();
            history = Enumerable.Range(0, 6).Select(i =>
            {
                var d = new DateTime(year, month, 1).AddMonths(-i);
                return new HRow(d.Year, d.Month, char.ToUpper(Fr.DateTimeFormat.GetMonthName(d.Month)[0]) + Fr.DateTimeFormat.GetMonthName(d.Month)[1..] + " " + d.Year,
                    Subscriptions.ShareOf(db, r, d.Year, d.Month), Subscriptions.PayoutOf(db, rid, d.Year, d.Month), Subscriptions.PayoutState(db, r, d.Year, d.Month, now));
            }).ToList();
            if (savedIban == "" && iban == "") { iban = r.Iban; vat = r.VatNumber; }
            savedIban = r.Iban;
            return 0;
        });
    }

    // IBAN : 15 à 34 caractères, clé de contrôle (modulo 97) exacte.
    private static bool ValidIban(string s)
    {
        if (!System.Text.RegularExpressions.Regex.IsMatch(s, "^[A-Z]{2}[0-9]{2}[A-Z0-9]{11,30}$")) return false;
        var r = s[4..] + s[..4];
        var rem = 0;
        foreach (var ch in r) { var v = char.IsDigit(ch) ? ch - '0' : ch - 'A' + 10; rem = (v > 9 ? rem * 100 + v : rem * 10 + v) % 97; }
        return rem == 1;
    }

    private void SaveBank()
    {
        var cleaned = new string(iban.Where(ch => !char.IsWhiteSpace(ch)).ToArray()).ToUpperInvariant();
        if (cleaned != "" && !ValidIban(cleaned)) { Toast.Error("Cet IBAN n'est pas valide : vérifiez-le."); return; }
        var rid = Ctx.RequireResellerId();
        Root.Write(db => { var r = db.Resellers.First(x => x.Id == rid); r.Iban = cleaned; r.VatNumber = vat.Trim(); });
        iban = cleaned == "" ? "" : string.Join(' ', Enumerable.Range(0, (cleaned.Length + 3) / 4).Select(i => cleaned.Substring(i * 4, Math.Min(4, cleaned.Length - i * 4))));
        savedIban = cleaned;
        Toast.Ok("Coordonnées de versement enregistrées.");
    }
}
