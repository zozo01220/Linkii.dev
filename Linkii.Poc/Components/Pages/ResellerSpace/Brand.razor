@page "/reseller/brand"
@attribute [Microsoft.AspNetCore.Authorization.Authorize(Policy = "ResellerSpace")]
@inject JsonStore Root
@inject TenantContext Ctx
@inject Notifier Notifier
@inject IConfiguration Config
@inject ExternalLogin Sso
@inject IWebHostEnvironment Env
@inject ResellerResolver Resolver
@inject NavigationManager Nav
@inject Toaster Toast


<div class="page-head">
    <div>
        <h1>Marque</h1>
        <p class="sub sc-intro">Le back-office et le player (écran d'appairage compris) sont habillés à vos couleurs.</p>
    </div>
    <button class="btn adm-save" @onclick="Save">Enregistrer</button>
</div>

<div class="adm-set">
    <nav aria-label="Sections">
        @foreach (var (id, label, icon) in Sections)
        {
            var sid = id;
            <button type="button" class="@(section == sid ? "on" : "")" @onclick="() => section = sid"><Ico Name="@icon" Size="18" /> @label</button>
        }
    </nav>

    <div class="adm-card" style="padding:4px 22px">
    @* Look « app » : les trois sections sont affichées l'une sous l'autre ; sur PC, seule la section choisie se voit. *@
    <div class="adm-pane @(section == "identity" ? "on" : "")"><h4 class="adm-pt">Identité</h4>
        <div class="adm-row">
            <div>Nom affiché<small>Le nom de votre marque, visible par vos clients dans le back-office, les e-mails et sur les écrans.</small></div>
            <div class="val"><input style="width:240px" aria-label="Nom affiché" @bind="brandName" /></div>
        </div>
        <div class="adm-row">
            <div>Couleur principale<small>Boutons, liens et accents du back-office de vos clients.</small></div>
            <div class="val"><input type="color" aria-label="Couleur principale" @bind="color" style="padding:2px;width:52px;height:38px" /><span class="m muted">@color</span></div>
        </div>
        <div class="adm-row">
            <div>Logo<small>PNG, JPEG ou WebP, 1 Mo maximum.</small></div>
            <div class="val" style="flex-direction:column;align-items:flex-end">
                @if (logoUrl != null) { <img class="logo-prev" src="@logoUrl" alt="Logo" /> }
                <InputFile OnChange="OnLogo" accept="image/png,image/jpeg,image/webp" />
                @if (logoUrl != null) { <button type="button" class="btn ghost sm" @onclick="RemoveLogo">Retirer le logo</button> }
            </div>
        </div>
        <div class="adm-row">
            <div>Mention « Propulsé par Linkivi »<small>Affichée en bas du menu de vos clients.</small></div>
            <div class="val"><button type="button" class="switch @(powered ? "on" : "")" role="switch" aria-checked="@(powered ? "true" : "false")" aria-label="Mention Propulsé par Linkivi" @onclick="() => powered = !powered"><span></span></button></div>
        </div>
    </div>
    <div class="adm-pane @(section == "signup" ? "on" : "")"><h4 class="adm-pt">Connexion et inscription</h4>
        <div style="padding:16px 0 4px" class="muted adm-intro">Choisissez comment vos clients peuvent créer leur espace. Désactiver une méthode la retire de l'inscription : les personnes déjà inscrites avec elle peuvent continuer à l'utiliser pour se connecter.</div>
        @foreach (var m in SignupSources.SignupMethodIds)
        {
            var id = m;
            var available = id == SignupSources.Email || Sso.IsConfigured(id) || Env.IsDevelopment();
            <div class="adm-row">
                <div style="display:flex;gap:12px;align-items:center">
                    @if (id == SignupSources.Email) { <Ico Name="mail" Size="20" /> } else { <ProviderLogo Provider="@id" Size="20" /> }
                    <div>@(id == SignupSources.Email ? "E-mail et mot de passe" : SignupSources.Label(id))
                        <small>@(id == SignupSources.Email ? "Créer un espace avec une adresse e-mail et un mot de passe." : "Continuer avec " + SignupSources.Label(id) + ".")@(available ? "" : " Non disponible : à activer par Linkivi.")</small></div>
                </div>
                <div class="val"><button type="button" class="switch @(methods.Contains(id) ? "on" : "")" role="switch" aria-checked="@(methods.Contains(id) ? "true" : "false")" aria-label="@id" disabled="@(!available)" @onclick="() => ToggleMethod(id)"><span></span></button></div>
            </div>
        }
        <div class="adm-note" style="margin:4px 0 14px">@(methods.Count == 0 ? "Aucune méthode : seuls vos clients déjà créés se connectent, vous les ajoutez vous-même." : "Les changements s'appliquent après « Enregistrer ».")</div>
    </div>
    <div class="adm-pane @(section == "addr" ? "on" : "")"><h4 class="adm-pt">Adresse et e-mails</h4>
        <div class="adm-row">
            <div>Adresse du back-office<small>L'adresse à laquelle vos clients et votre équipe se connectent.</small></div>
            <div class="val"><span class="m">@Resolver.HostFor(slug)</span></div>
        </div>
        <div class="adm-row">
            <div>Domaine propre
                @if (!string.IsNullOrEmpty(domain)) { <small>Créez chez votre hébergeur DNS un enregistrement <b>CNAME</b> : <code>@domain</code> → <code>@CnameTarget</code>. Le certificat HTTPS est généré automatiquement.</small> }
                else { <small>Pour utiliser votre propre domaine (ex. affichage.votre-entreprise.ch), demandez à Linkivi de l'activer.</small> }</div>
            <div class="val">@if (!string.IsNullOrEmpty(domain)) { <span class="m">@domain</span> } else { <span class="adm-st mute">Non activé</span> }</div>
        </div>
        <div class="adm-row">
            <div>Adresse e-mail d'envoi<small>Expéditeur des e-mails envoyés à vos clients (invitations, mots de passe provisoires).</small></div>
            <div class="val"><input type="email" style="width:260px" aria-label="Adresse e-mail d'envoi" @bind="sender" placeholder="no-reply@votre-entreprise.ch" /></div>
        </div>
    </div>
    </div>
</div>

@code {
    private string section = "identity";
    private static readonly (string Id, string Label, string Icon)[] Sections =
    {
        ("identity", "Identité", "palette"), ("signup", "Connexion et inscription", "users"), ("addr", "Adresse et e-mails", "mail"),
    };
    private string brandName = "", color = "#0B1F3A", sender = "", slug = "", domain = "";
    private string? logoUrl;
    private bool powered = true;
    private HashSet<string> methods = new();
    private void ToggleMethod(string id) { if (!methods.Remove(id)) methods.Add(id); }
    private string BaseDomain => Config["Linkii:BaseDomain"] ?? "linkii.com";
    private string CnameTarget => Config["Linkii:CnameTarget"] ?? "app." + BaseDomain;
    private static readonly string[] Allowed = { "image/png", "image/jpeg", "image/webp" };

    protected override void OnInitialized()
    {
        var r = Ctx.Reseller!;
        brandName = r.DisplayName; color = r.BrandColor; sender = r.SenderEmail; powered = r.ShowPoweredBy;
        slug = r.Slug; domain = r.CustomDomain ?? ""; logoUrl = r.LogoUrl;
        methods = r.SignupOn.ToHashSet();
        if (Nav.Uri.Contains("saved=1")) Toast.Ok("Marque enregistrée.");
    }

    private async Task OnLogo(InputFileChangeEventArgs e)
    {
        var f = e.File;
        if (!Allowed.Contains(f.ContentType)) { Toast.Error("Format non pris en charge (PNG, JPEG ou WebP)."); return; }
        if (f.Size > 1_000_000) { Toast.Error("Logo trop lourd (1 Mo maximum)."); return; }
        var ext = f.ContentType switch { "image/png" => ".png", "image/jpeg" => ".jpg", _ => ".webp" };
        var rid = Ctx.RequireResellerId();
        var file = $"{rid:N}-{Guid.NewGuid():N}{ext}";
        await using (var fs = File.Create(Path.Combine(AppPaths.BrandDir, file)))
            await f.OpenReadStream(1_000_000).CopyToAsync(fs);
        var old = Root.Write(d => { var r = d.Resellers.First(x => x.Id == rid); var o = r.LogoFile; r.LogoFile = file; return o; });
        DeleteLogoFile(old);
        logoUrl = "/brand/" + file;
        await Notifier.NotifyReseller(rid);
    }

    private async Task RemoveLogo()
    {
        var rid = Ctx.RequireResellerId();
        var old = Root.Write(d => { var r = d.Resellers.First(x => x.Id == rid); var o = r.LogoFile; r.LogoFile = null; return o; });
        DeleteLogoFile(old);
        logoUrl = null;
        await Notifier.NotifyReseller(rid);
    }

    private static void DeleteLogoFile(string? f)
    {
        if (!string.IsNullOrEmpty(f) && f == Path.GetFileName(f)) try { File.Delete(Path.Combine(AppPaths.BrandDir, f)); } catch { }
    }

    private async Task Save()
    {
        if (string.IsNullOrWhiteSpace(brandName)) { Toast.Error("Le nom affiché est obligatoire."); return; }
        if (!System.Text.RegularExpressions.Regex.IsMatch(color, "^#[0-9a-fA-F]{6}$")) { Toast.Error("Couleur invalide."); return; }
        var rid = Ctx.RequireResellerId();
        Root.Write(d =>
        {
            var r = d.Resellers.First(x => x.Id == rid);
            r.BrandName = brandName.Trim(); r.BrandColor = color; r.SenderEmail = sender.Trim(); r.ShowPoweredBy = powered;
            r.SignupMethods = SignupSources.SignupMethodIds.Where(methods.Contains).ToList();
        });
        await Notifier.NotifyReseller(rid);   // les écrans de tous les clients reprennent la nouvelle marque
        Nav.NavigateTo("/reseller/brand?saved=1", forceLoad: true);
    }
}
