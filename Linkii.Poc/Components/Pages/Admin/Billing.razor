@page "/admin/billing"
@attribute [Microsoft.AspNetCore.Authorization.Authorize(Policy = "PlatformAdmin")]
@inject JsonStore Root
@inject Toaster Toast
@inject Notifier Screens

<div class="page-head">
    <div>
        <h1>Facturation</h1>
        <p class="sub sc-intro">Tous les clients paient Linkii au tarif unique, à leur date anniversaire ; sans paiement, le compte est bloqué. Les revendeurs reçoivent leur commission le dernier jour du mois.</p>
    </div>
    <div class="row adm-month" style="gap:8px">
        <button type="button" class="btn ghost icon" aria-label="Mois précédent" @onclick="() => Shift(-1)"><Ico Name="chevron" Size="16" /></button>
        <b style="min-width:120px;text-align:center">@MonthLabel</b>
        <button type="button" class="btn ghost icon" aria-label="Mois suivant" @onclick="() => Shift(1)"><Ico Name="chevron-right" Size="16" /></button>
    </div>
</div>

<div class="adm-k4">
    <div class="adm-card"><div class="kl">Chiffre d'affaires mensuel</div><div class="kn">@Subscriptions.Fmt(mrr) <small class="muted" style="font-size:12px">CHF</small></div>
        <div class="adm-stk"><i style="flex:@Math.Max(1, (double)grossBase);background:#9DB6D3"></i><i style="flex:@Math.Max(1, (double)grossGrowth);background:#2F6FB5"></i></div>
        <div class="ks"><span class="adm-dot" style="background:#9DB6D3"></span>Base @Subscriptions.Fmt(grossBase) · <span class="adm-dot" style="background:#2F6FB5"></span>Growth @Subscriptions.Fmt(grossGrowth)<br />Remises annuelles : −@Subscriptions.Fmt(Math.Max(0, grossBase + grossGrowth - mrr))</div></div>
    <div class="adm-card"><div class="kl">Encaissé en @MonthLabel.ToLowerInvariant()</div><div class="kn" style="color:var(--ok)">@Subscriptions.Fmt(paidSum) <small class="muted" style="font-size:12px">CHF</small></div><div class="ks">@monthPayments.Count paiement@(monthPayments.Count > 1 ? "s" : "") · frais −@Subscriptions.Fmt(feeSum) · net @Subscriptions.Fmt(paidSum - feeSum)</div></div>
    <div class="adm-card"><div class="kl">Part des revendeurs</div><div class="kn">@Subscriptions.Fmt(commissionSum) <small class="muted" style="font-size:12px">CHF</small></div><div class="ks">à verser le @Subscriptions.PayoutDate(year, month).ToString("d MMM", Fr) · net Linkii <b>@Subscriptions.Fmt(paidSum - feeSum - commissionSum)</b></div></div>
    <div class="adm-card"><div class="kl">Bloqués faute de paiement</div><div class="kn" style="color:@(blockedCount > 0 ? "var(--danger)" : "inherit")">@blockedCount</div><div class="ks">@(blockedCount > 0 ? Subscriptions.Fmt(blockedSum) + " CHF dus" : "aucun")</div></div>
</div>

<div class="adm-card adm-cnt">
    <span><b>@resellerCount</b>revendeurs</span>
    <span><b>@clientCount</b>clients <small>(@billedClients actifs)</small></span>
    <span><b>@billedScreens</b>écrans facturés</span>
    <span><b>@userCount</b>utilisateurs</span>
    <span><b>@dueCount</b>renouvellements sous 30 jours <small>(@Subscriptions.Fmt(dueSum) CHF)</small></span>
    <span class="grow"></span>
    <span class="muted">Base @Subscriptions.Fmt(prices.Base) · Growth @Subscriptions.Fmt(prices.Growth) CHF / écran / mois · annuel −@prices.AnnualPct %</span>
</div>

<div class="adm-tabs seg" role="tablist" aria-label="Vue">
    @foreach (var (id, n) in new[] { ("Clients", crows.Count), ("Revendeurs", rrows.Count), ("Paiements", renewals.Count + monthPayments.Count), ("Versements", rrows.Count(r => r.PayState is Subscriptions.PayoutDue or Subscriptions.PayoutOpen)) })
    {
        var t = id;
        <button type="button" class="@(tab == t ? "on" : "")" @onclick="() => SetTab(t)">@t <b>@n</b></button>
    }
</div>

@if (tab == "Clients")
{
    <div class="adm-chips">
        @foreach (var f in new[] { "Tous", "Directs", "Via un revendeur", "À renouveler" })
        {
            var ff = f;
            <button type="button" class="@(filter == ff ? "on" : "")" @onclick="() => filter = ff">@ff</button>
        }
    </div>
    <div class="adm-card" style="padding:0;overflow:hidden"><div class="tbl-scroll">
    <table class="adm-tbl">
        <thead><tr><th>Client</th><th>Revendeur</th><th>Licence</th><th class="r">Écrans</th><th class="r">Util.</th><th>Paiement</th><th class="r">CHF / mois</th><th>Renouvellement</th></tr></thead>
        <tbody>
        @foreach (var c in FilteredClients)
        {
            var row = c;
            <tr class="@(selC == c.C.Id ? "sel" : "")" @onclick="() => OpenC(row)">
                <td><div class="adm-who"><div class="adm-av" style="background:@AvatarColor(c.R.Name)">@Initials(c.C.Name)</div><div><b>@c.C.Name</b><small><span class="adm-st @ClientStates.Css(c.State)">@c.State</span></small></div></div></td>
                <td>@(c.Direct ? "Linkii (direct)" : c.R.Name)</td>
                <td><span class="adm-plan @(c.C.IsGrowth ? "g" : "")">@Plans.Label(c.C.Plan)</span></td>
                <td class="r m">@c.Screens</td>
                <td class="r m">@c.Users</td>
                <td>@(c.C.BillingPeriod == "annual" ? "Annuel" : "Mensuel")</td>
                <td class="r m">@(c.Billable ? Subscriptions.Fmt(c.Monthly) : "—")</td>
                <td>@Renewal(c.Sub, c.C.NextRenewalUtc, c.C.Blocked && c.C.BlockedReason == Subscriptions.PaymentReason)
                    @if (Subscriptions.CanRecord(c.C.NextRenewalUtc, now) && (c.C.NextRenewalUtc != null || c.Billable || c.C.TrialEndsUtc != null)) { <button type="button" class="btn ok-o sm" style="margin-left:6px" @onclick:stopPropagation="true" @onclick="() => PayClient(row)">@(c.C.NextRenewalUtc == null ? "Premier paiement" : "Paiement reçu")</button> }</td>
            </tr>
        }
        </tbody>
    </table></div></div>
    <div class="adm-note">Le premier paiement d'un client fixe sa date anniversaire et met fin à son essai. Un client d'un revendeur paie Linkii comme un client direct ; le revendeur en reçoit une commission.</div>
}
else if (tab == "Revendeurs")
{
    <div class="adm-card" style="padding:0;overflow:hidden"><div class="tbl-scroll">
    <table class="adm-tbl">
        <thead><tr><th>Revendeur</th><th class="r">Clients</th><th class="r">Écrans</th><th class="r">Util.</th><th class="r">CA mensuel</th><th class="r">Commission Linkii</th><th class="r">Part acquise (@MonthLabel.Split(' ')[0].ToLowerInvariant())</th><th>IBAN</th></tr></thead>
        <tbody>
        @foreach (var r in rrows)
        {
            var row = r;
            <tr class="@(selR == r.R.Id ? "sel" : "")" @onclick="() => OpenR(row)">
                <td><div class="adm-who"><div class="adm-av" style="background:@AvatarColor(r.R.Name)">@Initials(r.R.Name)</div><div><b>@r.R.Name</b><small>@(r.R.Active ? (r.R.Suspended ? "Suspendu" : "Actif") : "Bloqué")</small></div></div></td>
                <td class="r m">@r.Clients</td>
                <td class="r m">@r.Screens</td>
                <td class="r m">@r.Users</td>
                <td class="r m">@Subscriptions.Fmt(r.Mrr)</td>
                <td class="r m">@r.Pct %@(r.R.CommissionPct == null ? "" : "*")</td>
                <td class="r m"><b>@Subscriptions.Fmt(r.Share.Commission)</b></td>
                <td>@if (r.HasIban) { <span class="adm-st ok">Renseigné</span> } else { <span class="adm-st warn">Manquant</span> }</td>
            </tr>
        }
        @if (rrows.Count == 0) { <tr><td colspan="8" style="text-align:center;color:var(--muted);padding:28px">Aucun revendeur.</td></tr> }
        </tbody>
    </table></div></div>
    <div class="adm-note">Part du revendeur = (montant payé − frais) − commission de Linkii (taux), sur les paiements reçus dans le mois. * : taux particulier (taux par défaut : @prices.DefaultPct %). Le taux se règle dans la fiche du revendeur.</div>
}
else if (tab == "Paiements")
{
    <div class="adm-sec" style="margin-top:0"><span class="lb">À encaisser</span></div>
    <div class="adm-card" style="padding:0;overflow:hidden"><div class="tbl-scroll">
    <table class="adm-tbl">
        <thead><tr><th>Client</th><th>Revendeur</th><th>Paiement</th><th>Renouvellement</th><th class="r">Montant CHF</th><th></th></tr></thead>
        <tbody>
        @foreach (var x in renewals)
        {
            var rn = x;
            <tr style="cursor:default">
                <td><b>@rn.Name</b><small class="adm-sub">@rn.Detail</small></td>
                <td>@rn.Reseller</td>
                <td>@rn.Period</td>
                <td>@Renewal(rn.State, rn.Next, rn.Blocked)</td>
                <td class="r m">@Subscriptions.Fmt(rn.Amount)</td>
                <td class="r"><button type="button" class="btn ok-o sm" @onclick="() => PayRenewal(rn)">@(rn.Next == null ? "Premier paiement" : "Paiement reçu")</button></td>
            </tr>
        }
        @if (renewals.Count == 0) { <tr><td colspan="6" style="text-align:center;color:var(--muted);padding:24px">Rien à encaisser pour le moment.</td></tr> }
        </tbody>
    </table></div></div>

    <div class="adm-sec"><span class="lb">Paiements enregistrés en @MonthLabel.ToLowerInvariant()</span></div>
    <div class="adm-card" style="padding:0;overflow:hidden"><div class="tbl-scroll">
    <table class="adm-tbl">
        <thead><tr><th>Date</th><th>Client</th><th>Période couverte</th><th class="r">Payé</th><th class="r">Frais</th><th class="r">Commission</th><th></th></tr></thead>
        <tbody>
        @foreach (var p in monthPayments)
        {
            var pay = p;
            <tr style="cursor:default">
                <td>@Subscriptions.ToLocal(pay.PaidUtc).ToString("d MMM", Fr)</td>
                <td><b>@pay.Name</b><small class="adm-sub">@ResellerName(pay.ResellerId) · @(pay.First ? "premier paiement" : pay.Period == "annual" ? "annuel" : "mensuel") · @pay.Screens écran@(pay.Screens > 1 ? "s" : "")</small></td>
                <td>@pay.FromUtc.ToString("d MMM", Fr) → @pay.ToUtc.ToString("d MMM yyyy", Fr)</td>
                <td class="r m">@Subscriptions.Fmt(pay.Amount)</td>
                <td class="r m">−@Subscriptions.Fmt(pay.Fee)</td>
                <td class="r m">@(pay.Commission > 0 ? Subscriptions.Fmt(pay.Commission) + " (" + pay.CommissionPct + " %)" : "—")</td>
                <td class="r">@if (IsLatest(pay)) { <button type="button" class="btn ghost sm" @onclick="() => Undo(pay)">Annuler</button> }</td>
            </tr>
        }
        @if (monthPayments.Count == 0) { <tr><td colspan="7" style="text-align:center;color:var(--muted);padding:24px">Aucun paiement enregistré ce mois-ci.</td></tr> }
        </tbody>
    </table></div></div>
    <div class="adm-note">« Paiement reçu » enregistre à la main le renouvellement (en attendant Stripe) : la prochaine date anniversaire avance d'un mois ou d'un an, un compte bloqué faute de paiement est débloqué et la commission du revendeur est calculée sur le net.</div>
}
else
{
    <div class="adm-card" style="padding:0;overflow:hidden"><div class="tbl-scroll">
    <table class="adm-tbl">
        <thead><tr><th>Revendeur</th><th class="r">Paiements</th><th class="r">Payé</th><th class="r">Frais</th><th class="r">Net</th><th class="r">Taux</th><th class="r">À verser CHF</th><th>IBAN</th><th>Statut</th><th></th></tr></thead>
        <tbody>
        @foreach (var r in rrows)
        {
            var row = r;
            <tr style="cursor:default">
                <td><b>@r.R.Name</b></td>
                <td class="r m">@r.Share.Payments</td>
                <td class="r m">@Subscriptions.Fmt(r.Share.Gross)</td>
                <td class="r m">−@Subscriptions.Fmt(r.Share.Fees)</td>
                <td class="r m">@Subscriptions.Fmt(r.Share.Net)</td>
                <td class="r m">@r.Pct %</td>
                <td class="r m"><b>@Subscriptions.Fmt(r.Payout?.Amount ?? r.Share.Commission)</b></td>
                <td>@if (r.HasIban) { <span class="adm-st ok">Renseigné</span> } else { <span class="adm-st warn">Manquant</span> }</td>
                <td><span class="adm-st @(r.PayState == Subscriptions.PayoutDone ? "ok" : r.PayState == Subscriptions.PayoutDue ? "warn" : "mute")">@r.PayState</span>
                    @if (r.Payout is { } po) { <small class="adm-sub">le @Subscriptions.ToLocal(po.PaidUtc).ToString("d MMM yyyy", Fr)@(po.Reference != "" ? " · " + po.Reference : "")</small> }
                    else if (r.PayState == Subscriptions.PayoutOpen) { <small class="adm-sub">le @Subscriptions.PayoutDate(year, month).ToString("d MMM", Fr)</small> }</td>
                <td class="r">
                    @if (r.Payout != null) { <button type="button" class="btn ghost sm" @onclick="() => Unpay(row)">Annuler</button> }
                    else if (r.Share.Commission > 0) { <button type="button" class="btn ok-o sm" @onclick="() => OpenPay(row)">Marquer versé</button> }
                </td>
            </tr>
        }
        </tbody>
        <tfoot><tr><td>Total</td><td class="r m">@rrows.Sum(r => r.Share.Payments)</td><td class="r m">@Subscriptions.Fmt(rrows.Sum(r => r.Share.Gross))</td><td class="r m">−@Subscriptions.Fmt(rrows.Sum(r => r.Share.Fees))</td><td class="r m">@Subscriptions.Fmt(rrows.Sum(r => r.Share.Net))</td><td></td><td class="r m">@Subscriptions.Fmt(rrows.Sum(r => r.Payout?.Amount ?? r.Share.Commission))</td><td colspan="3"></td></tr></tfoot>
    </table></div></div>
    <div class="adm-note">Versement le dernier jour du mois, sur les paiements reçus dans le mois. Une fois le virement fait, « Marquer versé » fige le montant ; un paiement annulé après le versement n'est plus possible.</div>
}

@if (payOf is { } po2)
{
    <div class="modal-backdrop" style="z-index:110" @onclick="() => payOf = null"></div>
    <div class="modal app-modal sm" style="z-index:111" role="dialog" aria-modal="true" aria-labelledby="pay-title">
        <div class="modal-head"><div class="grow"><h3 id="pay-title">Versement à @po2.R.Name</h3><small class="muted">@MonthLabel · @Subscriptions.Fmt(po2.Share.Commission) CHF</small></div>
            <button type="button" class="modal-x" aria-label="Fermer" @onclick="() => payOf = null"><Ico Name="x" Size="20" /></button></div>
        <div class="modal-body">
            @if (!po2.HasIban) { <div class="err" style="margin-bottom:10px">Ce revendeur n'a pas encore saisi son IBAN.</div> }
            else { <p class="hint">IBAN : <span class="mono">@po2.R.Iban</span></p> }
            <label class="lbl">Référence du virement <small>(facultatif)</small></label>
            <input class="full" @bind="payRef" placeholder="Ex. : virement du 31 octobre" autocomplete="off" />
        </div>
        <div class="modal-foot"><button type="button" class="btn ghost" @onclick="() => payOf = null">Annuler</button><button type="button" class="btn" @onclick="() => ConfirmPay(po2)">Marquer versé</button></div>
    </div>
}

@if (SelRow is { } sr)
{
    <div class="adm-veil" @onclick="Close"></div>
    <aside class="adm-drawer" role="dialog" aria-label="Commission de @sr.R.Name">
        <div class="dh"><div class="top">
            <div class="adm-av lg" style="background:@AvatarColor(sr.R.Name)">@Initials(sr.R.Name)</div>
            <div class="grow"><h2>@sr.R.Name</h2><span class="adm-st @(sr.PayState == Subscriptions.PayoutDone ? "ok" : sr.PayState == Subscriptions.PayoutDue ? "warn" : "mute")">@sr.PayState</span> <span class="adm-sub" style="display:inline">commission de Linkii @sr.Pct %@(sr.R.CommissionPct == null ? " (par défaut)" : "")</span></div>
            <button type="button" class="btn ghost icon" aria-label="Fermer" @onclick="Close"><Ico Name="x" Size="18" /></button>
        </div></div>
        <div class="db">
            <div class="adm-sec"><span class="lb">@MonthLabel</span>
                <div class="adm-ln"><span>Paiements reçus</span><span class="m">@sr.Share.Payments</span></div>
                <div class="adm-ln"><span>Payé par les clients</span><span class="m">@Subscriptions.Fmt(sr.Share.Gross)</span></div>
                <div class="adm-ln"><span>Frais de paiement</span><span class="m">−@Subscriptions.Fmt(sr.Share.Fees)</span></div>
                <div class="adm-ln"><span>Net</span><span class="m">@Subscriptions.Fmt(sr.Share.Net)</span></div>
                <div class="adm-tot g"><span>À verser (100 − @sr.Pct %)</span><span class="m">@Subscriptions.Fmt(sr.Payout?.Amount ?? sr.Share.Commission)</span></div>
                @if (sr.ExpectedSum > 0) { <div class="adm-note">Encore attendu d'ici fin de mois : @Subscriptions.Fmt(sr.ExpectedSum) CHF (prévision).</div> }
            </div>
            <div class="adm-sec"><span class="lb">Versement</span>
                @if (sr.Payout is { } p)
                {
                    <div class="adm-note">Versé le @Subscriptions.ToLocal(p.PaidUtc).ToString("d MMM yyyy", Fr) : @Subscriptions.Fmt(p.Amount) CHF@(p.Reference != "" ? " · " + p.Reference : "").</div>
                    <div class="adm-acts"><button type="button" class="btn ghost sm" @onclick="() => Unpay(sr)">Annuler le versement</button></div>
                }
                else
                {
                    <div class="adm-note">@(sr.PayState == Subscriptions.PayoutEmpty ? "Rien à verser ce mois-ci." : "Versement le " + Subscriptions.PayoutDate(year, month).ToString("d MMMM", Fr) + ".")</div>
                    @if (sr.Share.Commission > 0) { <div class="adm-acts"><button type="button" class="btn ok-o sm" @onclick="() => OpenPay(sr)">Marquer versé</button></div> }
                }
            </div>
            <div class="adm-sec"><span class="lb">Coordonnées</span>
                <div class="adm-ln"><span>IBAN</span><span class="m">@(sr.HasIban ? sr.R.Iban : "manquant")</span></div>
                <div class="adm-ln"><span>N° de TVA</span><span class="m">@(sr.R.VatNumber == "" ? "—" : sr.R.VatNumber)</span></div>
                <div class="adm-note">Saisies par le revendeur dans son espace. Le taux de commission se règle dans Revendeurs.</div>
            </div>
            <div class="adm-sec"><span class="lb">Paiements du mois</span>
                @foreach (var hp in history)
                {
                    <div class="adm-ln"><span style="color:var(--ink)">@hp.Name<span class="adm-sub">@Subscriptions.ToLocal(hp.PaidUtc).ToString("d MMM", Fr) · @Subscriptions.Fmt(hp.Amount) payé · frais @Subscriptions.Fmt(hp.Fee)</span></span><span class="m">@Subscriptions.Fmt(hp.Commission)</span></div>
                }
                @if (history.Count == 0) { <div class="adm-note">Aucun paiement ce mois-ci.</div> }
            </div>
        </div>
    </aside>
}
else if (SelClient is { } sc)
{
    <div class="adm-veil" @onclick="Close"></div>
    <aside class="adm-drawer" role="dialog" aria-label="Abonnement de @sc.C.Name">
        <div class="dh"><div class="top">
            <div class="adm-av lg" style="background:@AvatarColor(sc.R.Name)">@Initials(sc.C.Name)</div>
            <div class="grow"><h2>@sc.C.Name</h2><span class="adm-st @ClientStates.Css(sc.State)">@sc.State</span> <span class="adm-sub" style="display:inline">@(sc.Direct ? "client direct" : "via " + sc.R.Name)</span></div>
            <button type="button" class="btn ghost icon" aria-label="Fermer" @onclick="Close"><Ico Name="x" Size="18" /></button>
        </div></div>
        <div class="db">
            <div class="adm-sec"><span class="lb">Calcul</span>
                <div class="adm-ln"><span>Écrans</span><span class="m">@sc.Screens</span></div>
                <div class="adm-ln"><span>Licence</span><span><span class="adm-plan @(sc.C.IsGrowth ? "g" : "")">@Plans.Label(sc.C.Plan)</span> <span class="m">@Subscriptions.Fmt(sc.Unit) CHF</span></span></div>
                <div class="adm-ln"><span>Utilisateurs</span><span class="m">@sc.Users</span></div>
                <div class="adm-tot"><span class="muted">@sc.Screens × @Subscriptions.Fmt(sc.Unit) CHF / mois</span><span class="m">@Subscriptions.Fmt(sc.Gross)</span></div>
                @if (sc.C.BillingPeriod == "annual") { <div class="adm-tot"><span class="muted">12 mois, remise annuelle −@prices.AnnualPct %</span><span class="m">@Subscriptions.Fmt(sc.PeriodAmount)</span></div> }
                <div class="adm-tot g"><span>@(sc.C.BillingPeriod == "annual" ? "CHF / an" : "CHF / mois")</span><span class="m">@Subscriptions.Fmt(sc.PeriodAmount)</span></div>
                @if (!sc.Direct) { <div class="adm-note">Commission de Linkii : @sc.ResellerPct % du net ; @sc.R.Name reçoit environ @Subscriptions.Fmt(sc.ResellerShare) CHF sur ce paiement.</div> }
                @if (!sc.Billable) { <div class="adm-note">@NotBilledReason(sc)</div> }
            </div>
            <div class="adm-sec"><span class="lb">Périodicité de paiement</span>
                <div class="adm-seg">
                    <button type="button" class="@(sc.C.BillingPeriod != "annual" ? "on" : "")" @onclick='() => SetPeriod(sc, "monthly")'>Mensuel</button>
                    <button type="button" class="@(sc.C.BillingPeriod == "annual" ? "on" : "")" @onclick='() => SetPeriod(sc, "annual")'>Annuel · −@prices.AnnualPct %</button>
                </div>
                <div class="adm-note" style="margin-top:6px">Le changement s'applique au prochain renouvellement, à la même date anniversaire.</div></div>
            <div class="adm-sec"><span class="lb">Paiement</span>
                <div class="adm-note">@RenewalNote(sc.Sub, sc.C.NextRenewalUtc, sc.PeriodAmount, sc.C.BillingPeriod == "annual" ? "an" : "mois")</div>
                <div class="adm-acts">
                    @if (Subscriptions.CanRecord(sc.C.NextRenewalUtc, now)) { <button type="button" class="btn ok-o sm" @onclick="() => PayClient(sc)">@(sc.C.NextRenewalUtc == null ? "Premier paiement reçu" : "Paiement reçu")</button> }
                    @if (clientPayments.FirstOrDefault() is { } last) { <button type="button" class="btn ghost sm" @onclick="() => Undo(last)">Annuler le dernier paiement</button> }
                </div></div>
            <div class="adm-sec"><span class="lb">Historique des paiements</span>
                @foreach (var h in clientPayments)
                {
                    <div class="adm-ln"><span style="color:var(--ink)">@Subscriptions.ToLocal(h.PaidUtc).ToString("d MMM yyyy", Fr)<span class="adm-sub">@(h.First ? "premier paiement" : h.Period == "annual" ? "renouvellement annuel" : "renouvellement mensuel") · jusqu'au @h.ToUtc.ToString("d MMM yyyy", Fr)@(h.Commission > 0 ? " · commission " + Subscriptions.Fmt(h.Commission) : "")</span></span><span class="m">@Subscriptions.Fmt(h.Amount)</span></div>
                }
                @if (clientPayments.Count == 0) { <div class="adm-note">Aucun paiement enregistré.</div> }
            </div>
        </div>
    </aside>
}

@code {
    private record RRow(Reseller R, int Clients, int Screens, int Users, decimal Mrr, int Pct, Subscriptions.Share Share, decimal ExpectedSum, string PayState, Payout? Payout, bool HasIban);
    private record CRow(Tenant C, Reseller R, bool Direct, string State, bool Billable, string Sub, int Screens, int Users, decimal Unit, decimal Gross, decimal Monthly, decimal PeriodAmount, int ResellerPct, decimal ResellerShare);
    private record Renew(string Name, string Reseller, string Period, string Detail, string State, DateTime? Next, decimal Amount, bool Blocked, Guid ClientId);
    private record PriceView(decimal Base, decimal Growth, int AnnualPct, int DefaultPct);

    private static readonly System.Globalization.CultureInfo Fr = new("fr-CH");
    private static readonly string[] Palette = { "#0B1F3A", "#2A7F62", "#B9792B", "#7A5CC0", "#C0392B", "#2A8A99", "#5A6B80" };

    private DateTime now = DateTime.UtcNow;
    private int year, month;
    private string tab = "Clients", filter = "Tous";
    private Guid? selR, selC;
    private PriceView prices = new(15, 29, 15, 20);
    private List<RRow> rrows = new();
    private List<CRow> crows = new();
    private List<Renew> renewals = new();
    private List<Payment> monthPayments = new();
    private List<Payment> history = new();          // paiements du mois du revendeur ouvert
    private List<Payment> clientPayments = new();   // historique du client ouvert
    private Dictionary<Guid, string> resellerNames = new();
    private decimal mrr, grossBase, grossGrowth, paidSum, feeSum, commissionSum, dueSum, blockedSum;
    private int dueCount, blockedCount, resellerCount, clientCount, billedClients, billedScreens, userCount;
    private RRow? payOf;
    private string payRef = "";

    private string MonthLabel => char.ToUpper(Fr.DateTimeFormat.GetMonthName(month)[0]) + Fr.DateTimeFormat.GetMonthName(month)[1..] + " " + year;
    private static string Day(DateTime utc) => utc.ToLocalTime().ToString("d MMM yyyy", Fr);
    private static string Initials(string n) => string.Concat(n.Split(' ', StringSplitOptions.RemoveEmptyEntries).Take(2).Select(w => char.ToUpperInvariant(w[0])));
    private static string AvatarColor(string n) => Palette[Math.Abs(n.Aggregate(0, (h, ch) => h * 31 + ch)) % Palette.Length];
    private string ResellerName(Guid? id) => id is { } g && resellerNames.TryGetValue(g, out var n) ? n : "—";

    private RRow? SelRow => selR is { } id ? rrows.FirstOrDefault(r => r.R.Id == id) : null;
    private CRow? SelClient => selC is { } id ? crows.FirstOrDefault(c => c.C.Id == id) : null;
    private IEnumerable<CRow> FilteredClients => crows.Where(c => filter switch { "Directs" => c.Direct, "Via un revendeur" => !c.Direct, "À renouveler" => c.Sub == Subscriptions.Soon || c.Sub == Subscriptions.Unpaid || c.Sub == Subscriptions.FirstDue, _ => true });

    private bool IsLatest(Payment p) => Root.Read(db => db.Payments.Where(x => x.ClientId == p.ClientId).OrderByDescending(x => x.PaidUtc).FirstOrDefault()?.Id == p.Id);

    private RenderFragment Renewal(string state, DateTime? next, bool blockedForPayment) => builder =>
    {
        var css = blockedForPayment || state == Subscriptions.Unpaid ? "bad" : state == Subscriptions.Soon || state == Subscriptions.FirstDue ? "warn" : state == Subscriptions.Current ? "ok" : "mute";
        var label = blockedForPayment ? "Bloqué : non payé" : state;
        builder.OpenElement(0, "span"); builder.AddAttribute(1, "class", "adm-st " + css); builder.AddContent(2, label); builder.CloseElement();
        if (next is { } n)
        {
            builder.OpenElement(3, "small"); builder.AddAttribute(4, "class", "adm-sub");
            builder.AddContent(5, state == Subscriptions.Current ? "jusqu'au " + Day(n) : "échéance le " + Day(n));
            builder.CloseElement();
        }
    };

    private string RenewalNote(string state, DateTime? next, decimal amount, string per) => state switch
    {
        Subscriptions.FirstDue => "Aucun paiement enregistré. Le premier paiement fixe la date anniversaire et met fin à l'essai.",
        Subscriptions.NotBilled => "Pas de paiement à enregistrer pour le moment. Le premier paiement fixe la date anniversaire.",
        Subscriptions.Current => $"À jour jusqu'au {Day(next!.Value)}. Prochain renouvellement : {Subscriptions.Fmt(amount)} CHF par {per}.",
        Subscriptions.Soon => $"Renouvellement le {Day(next!.Value)} : {Subscriptions.Fmt(amount)} CHF. Sans paiement ce jour-là, le compte est bloqué.",
        _ => $"Non payé depuis le {Day(next!.Value)} : le compte est bloqué. Enregistrez le paiement pour le débloquer."
    };

    private string NotBilledReason(CRow c) => c.State switch
    {
        ClientStates.Trial => "En essai : pas facturé. Son premier paiement met fin à l'essai.",
        ClientStates.Ended => "Essai terminé : pas facturé tant qu'il n'a pas payé.",
        ClientStates.Pending => "Compte à valider : pas facturé.",
        ClientStates.Suspended => "Suspendu : pas facturé.",
        _ => "Bloqué : pas facturé."
    };

    protected override async Task OnInitializedAsync()
    {
        now = DateTime.UtcNow;
        var local = Subscriptions.ToLocal(now);
        (year, month) = (local.Year, local.Month);
        // Les comptes dont la date anniversaire est passée sans paiement sont bloqués (le service d'arrière-plan le fait aussi, toutes les heures).
        var ids = Root.Write(db => Subscriptions.Enforce(db, DateTime.UtcNow));
        Load();
        foreach (var id in ids.Distinct()) await Screens.NotifyClient(id);
    }

    private void Shift(int delta)
    {
        var d = new DateTime(year, month, 1).AddMonths(delta);
        (year, month) = (d.Year, d.Month);
        selR = selC = null;
        Load();
    }

    private void SetTab(string t) { tab = t; filter = "Tous"; selR = selC = null; }

    private void Load()
    {
        now = DateTime.UtcNow;
        Root.Read(db =>
        {
            var p = Subscriptions.PricesOf(db);
            prices = new(p.Base, p.Growth, p.AnnualPct, db.Platform.DefaultCommissionPct);
            var direct = db.Resellers.FirstOrDefault(r => r.IsDefault);
            resellerNames = db.Resellers.ToDictionary(r => r.Id, r => r.IsDefault ? "Linkii (direct)" : r.Name);
            crows = db.Clients.OrderBy(c => c.Name).Select(c =>
            {
                var r = db.Resellers.FirstOrDefault(x => x.Id == c.ResellerId) ?? direct!;
                var billable = Subscriptions.Billable(db, c, now);
                var gross = Subscriptions.MonthlyOf(db, c);
                var period = Subscriptions.ClientAmount(db, c);
                var pct = Subscriptions.CommissionPct(db, r);
                var sub = Subscriptions.StateOf(c.NextRenewalUtc, billable || c.TrialEndsUtc != null, now);
                return new CRow(c, r, r.IsDefault, ClientStates.Of(c, Signup.OwnerOf(db, c), now), billable, sub, Subscriptions.ScreensOf(db, c), Subscriptions.UsersOf(db, c),
                    Subscriptions.Unit(p, c.Plan), gross, billable ? Subscriptions.ClientMonthlyEquivalent(db, c) : 0, period, pct, Subscriptions.CommissionOf(period, Subscriptions.FeeOf(db, period), pct, r.IsDefault));
            }).ToList();
            monthPayments = db.Payments.Where(x => Subscriptions.InMonth(x.PaidUtc, year, month)).OrderByDescending(x => x.PaidUtc).ToList();
            rrows = db.Resellers.Where(r => !r.IsDefault).OrderBy(r => r.Name).Select(r =>
            {
                var cs = crows.Where(c => c.R.Id == r.Id).ToList();
                var state = Subscriptions.PayoutState(db, r, year, month, now);
                return new RRow(r, cs.Count, cs.Where(c => c.Billable).Sum(c => c.Screens), cs.Sum(c => c.Users), cs.Sum(c => c.Monthly), Subscriptions.CommissionPct(db, r),
                    Subscriptions.ShareOf(db, r, year, month), Subscriptions.ExpectedOf(db, r, now).Sum(e => e.Commission), state, Subscriptions.PayoutOf(db, r.Id, year, month), r.Iban != "");
            }).ToList();

            // CA mensuel : ce que rapportent aujourd'hui les clients actifs au tarif Linkii (un client à l'année compte pour son équivalent mensuel remisé).
            mrr = crows.Where(c => c.Billable).Sum(c => c.Monthly);
            grossBase = crows.Where(c => c.Billable && !c.C.IsGrowth).Sum(c => c.Gross);
            grossGrowth = crows.Where(c => c.Billable && c.C.IsGrowth).Sum(c => c.Gross);
            paidSum = monthPayments.Sum(x => x.Amount);
            feeSum = monthPayments.Sum(x => x.Fee);
            commissionSum = monthPayments.Sum(x => x.Commission);

            renewals = crows.Where(c => Subscriptions.CanRecord(c.C.NextRenewalUtc, now) && (c.C.NextRenewalUtc != null || c.Billable || c.C.TrialEndsUtc != null))
                .Select(c => new Renew(c.C.Name, c.Direct ? "Linkii (direct)" : c.R.Name, c.C.BillingPeriod == "annual" ? "annuel" : "mensuel", c.Screens + " écrans · " + Plans.Label(c.C.Plan), c.Sub, c.C.NextRenewalUtc, c.PeriodAmount,
                    c.C.Blocked && c.C.BlockedReason == Subscriptions.PaymentReason, c.C.Id))
                .OrderBy(x => x.Next ?? DateTime.MaxValue).ToList();
            var soon = crows.Where(c => !c.C.Blocked && c.C.NextRenewalUtc is { } n && n.Date >= now.Date && n.Date <= now.Date.AddDays(30)).Select(c => c.PeriodAmount).ToList();
            dueCount = soon.Count; dueSum = soon.Sum();
            var blocked = renewals.Where(x => x.Blocked).ToList();
            blockedCount = blocked.Count; blockedSum = blocked.Sum(x => x.Amount);

            resellerCount = rrows.Count; clientCount = crows.Count;
            billedClients = crows.Count(c => c.Billable);
            billedScreens = crows.Where(c => c.Billable).Sum(c => c.Screens);
            userCount = crows.Sum(c => c.Users);
            history = selR is { } rid ? monthPayments.Where(x => x.ResellerId == rid).ToList() : new();
            clientPayments = selC is { } cid ? db.Payments.Where(x => x.ClientId == cid).OrderByDescending(x => x.PaidUtc).Take(8).ToList() : new();
            return 0;
        });
    }

    private void OpenR(RRow r) { selR = r.R.Id; selC = null; Load(); }
    private void OpenC(CRow c) { selC = c.C.Id; selR = null; Load(); }
    private void Close() { selR = selC = null; }

    private async Task PayClient(CRow c)
    {
        var pay = Root.Write(db => db.Clients.FirstOrDefault(x => x.Id == c.C.Id) is { } x ? Subscriptions.RecordClient(db, x, DateTime.UtcNow) : null);
        Load();
        await Screens.NotifyClient(c.C.Id);
        if (pay == null) { Toast.Error("Rien à enregistrer : le prochain renouvellement n'est pas encore proche."); return; }
        Toast.Ok($"Paiement de « {c.C.Name} » enregistré : {Subscriptions.Fmt(pay.Amount)} CHF. Prochain renouvellement le {Day(pay.ToUtc)}." + (pay.Commission > 0 ? $" Commission du revendeur : {Subscriptions.Fmt(pay.Commission)} CHF." : ""));
    }

    private async Task PayRenewal(Renew x)
    {
        if (crows.FirstOrDefault(c => c.C.Id == x.ClientId) is { } c) await PayClient(c);
    }

    private async Task Undo(Payment p)
    {
        var ok = Root.Write(db => Subscriptions.UndoLast(db, p.Id));
        Load();
        if (p.ClientId is { } cid) await Screens.NotifyClient(cid);
        if (ok) Toast.Ok($"Paiement de « {p.Name} » annulé."); else Toast.Error("Seul le dernier paiement peut être annulé, et pas après le versement du mois au revendeur.");
    }

    private void SetPeriod(CRow c, string period)
    {
        if (c.C.BillingPeriod == period) return;
        Root.Write(db => { if (db.Clients.FirstOrDefault(x => x.Id == c.C.Id) is { } x) x.BillingPeriod = period; });
        Load();
        var when = period == "annual" ? "à l’année" : "au mois";
        Toast.Ok($"« {c.C.Name} » paiera désormais {when} dès son prochain renouvellement.");
    }

    private void OpenPay(RRow r) { payRef = ""; payOf = r; }

    private void ConfirmPay(RRow r)
    {
        var p = Root.Write(db => db.Resellers.FirstOrDefault(x => x.Id == r.R.Id) is { } x ? Subscriptions.MarkPaid(db, x, year, month, payRef, DateTime.UtcNow) : null);
        payOf = null;
        Load();
        if (p == null) Toast.Error("Rien à verser, ou le versement est déjà enregistré.");
        else Toast.Ok($"Versement de {Subscriptions.Fmt(p.Amount)} CHF à « {r.R.Name} » enregistré pour {MonthLabel.ToLowerInvariant()}.");
    }

    private void Unpay(RRow r)
    {
        if (r.Payout == null) return;
        Root.Write(db => Subscriptions.Unpay(db, r.Payout.Id));
        Load();
        Toast.Ok($"Versement à « {r.R.Name} » annulé.");
    }
}
