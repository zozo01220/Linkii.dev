@page "/admin/ads/{Id:guid}"
@attribute [Microsoft.AspNetCore.Authorization.Authorize(Policy = "PlatformAdmin")]
@inject JsonStore Root
@inject AdLog Log
@inject NavigationManager Nav
@inject Toaster Toast

@* Résultats d'une campagne : passages par mois, rapport de preuve et export. Sa modification (annonceur, période, tarif, diffusion, spots)
   se fait dans le tiroir « Modifier » (AdCampaignDrawer), comme depuis la liste des campagnes. *@
@if (c == null)
{
    <div class="card empty"><div class="big">Campagne introuvable</div><p><a href="/admin/ads">Retour aux campagnes</a></p></div>
}
else
{
    <div class="page-head">
        <div>
            <a class="back-link" href="/admin/ads">← Campagnes</a>
            <h1>@(c.Advertiser.Length > 0 ? c.Advertiser : "Campagne sans annonceur")@(c.Name.Length > 0 ? " · " + c.Name : "")</h1>
            <p class="sub sc-intro">@(Ads.Day(c.Start)?.ToString("d MMM", Ads.Fr)) → @(Ads.Day(c.End)?.ToString("d MMM yyyy", Ads.Fr)) · @AdModes.Label(c.Mode)@(c.Stopped ? " · arrêtée" : "")</p>
        </div>
        <div class="row" style="gap:8px">
            <button type="button" class="btn ghost" @onclick="ToggleStop">@(c.Stopped ? "Reprendre la diffusion" : "Arrêter la diffusion")</button>
            <button type="button" class="btn" @onclick="() => drawer = true"><Ico Name="pencil-square" Size="16" /> Modifier</button>
        </div>
    </div>

    <div class="adm-tools">
        <select @bind="month" @bind:after="LoadResults" aria-label="Mois">
            @foreach (var m in Months) { <option value="@m">@Ads.Fr.TextInfo.ToTitleCase(DateTime.ParseExact(m + "-01", "yyyy-MM-dd", null).ToString("MMMM yyyy", Ads.Fr))</option> }
        </select>
        <span class="grow"></span>
        <a class="btn ghost sm" href="/admin/ads/@Id/report/@month">Rapport de preuve</a>
        <a class="btn ghost sm" download="campagne-@(Tenancy.Slugify(c.Advertiser))-@(month).csv" href="@CsvHref">Exporter en CSV</a>
    </div>
    <div class="adm-k4">
        <div class="adm-card"><div class="kl">Passages complets</div><div class="kn">@results.Sum(r => r.Row.Complete).ToString("N0", Ads.Fr)</div><div class="ks">sur le mois</div></div>
        <div class="adm-card"><div class="kl">Temps d'affichage complet</div><div class="kn">@Ads.Human(results.Sum(r => r.Row.Seconds))</div><div class="ks">passages complets × durée</div></div>
        <div class="adm-card"><div class="kl">Passages interrompus</div><div class="kn">@results.Sum(r => r.Row.Interrupted).ToString("N0", Ads.Fr)</div><div class="ks">non facturés</div></div>
        <div class="adm-card"><div class="kl">Montant à facturer</div><div class="kn">@Ads.Chf(results.Sum(r => r.Row.Gross))</div><div class="ks">dont @Ads.Chf(results.Sum(r => r.Row.Owner)) reversés</div></div>
    </div>
    <div class="adm-card" style="margin-bottom:14px">
        <div class="adm-ct">Passages complets par jour <span>barres orange : passages interrompus</span></div>
        <div class="ad-chart">
            @{ var max = Math.Max(1, days.Count == 0 ? 1 : days.Max(d => d.Complete + d.Cut)); }
            @foreach (var d in days)
            {
                <div class="col" title="@d.Label : @d.Complete complets, @d.Cut interrompus"><i class="cut" style="height:@(d.Cut * 100 / max)%"></i><i style="height:@(d.Complete * 100 / max)%"></i></div>
            }
        </div>
    </div>
    <div class="adm-card" style="padding:0">
        @if (results.Count == 0) { <div class="adm-note" style="padding:18px">Aucun passage ce mois-ci.</div> }
        else
        {
            <table class="adm-tbl">
                <thead><tr><th>Écran (compte)</th><th class="r">Complets</th><th class="r">Interrompus</th><th class="r">Temps complet</th><th class="r">Montant</th><th>Dernière diffusion</th></tr></thead>
                <tbody>
                    @foreach (var r in results)
                    {
                        <tr style="cursor:default"><td><b>@r.Screen</b> <span class="adm-sub" style="display:inline">(@r.Client)</span></td><td class="r m">@r.Row.Complete</td><td class="r m">@r.Row.Interrupted</td><td class="r m">@Ads.Human(r.Row.Seconds)</td><td class="r m">@Ads.Chf(r.Row.Gross)</td><td class="adm-sub">@r.Last.ToLocalTime().ToString("d.M HH:mm")</td></tr>
                    }
                </tbody>
            </table>
        }
    </div>
    <p class="adm-note" style="margin-top:12px">Heures dans le fuseau Europe/Zurich. Les passages détaillés et les agrégats sont conservés 13 mois. Un passage est compté une seule fois (identifiant unique), à l'heure du serveur.</p>

    @if (Log.Total(c.Id) == 0)
    {
        <div class="adm-danger"><div><b>Supprimer la campagne</b><small>Possible tant qu'aucun passage n'a été compté.</small></div><button type="button" class="btn danger sm" @onclick="Delete">Supprimer</button></div>
    }

    @if (drawer)
    {
        <AdCampaignDrawer Id="Id" OnSaved="Saved" OnClose="() => drawer = false" />
    }
}

@code {
    [Parameter] public Guid Id { get; set; }

    private AdCampaign? c;
    private string month = "";
    private bool drawer;

    private record ResultRow(AdRow Row, string Screen, string Client, DateTime Last);
    private List<ResultRow> results = new();
    private List<(string Label, int Complete, int Cut)> days = new();
    private string CsvHref = "";

    private static readonly TimeZoneInfo Zone = AdReports.Zone("Europe/Zurich");
    private DateTime LocalNow => TimeZoneInfo.ConvertTimeFromUtc(DateTime.UtcNow, Zone);
    private IEnumerable<string> Months => Enumerable.Range(0, 13).Select(i => LocalNow.AddMonths(-i).ToString("yyyy-MM"));

    protected override void OnParametersSet()
    {
        month = LocalNow.ToString("yyyy-MM");
        Reload();
    }

    private void Reload()
    {
        c = Root.Read(db => db.AdCampaigns.FirstOrDefault(x => x.Id == Id) is { } x ? System.Text.Json.JsonSerializer.Deserialize<AdCampaign>(System.Text.Json.JsonSerializer.Serialize(x)) : null);
        LoadResults();
    }

    private void Saved(AdCampaign saved) { drawer = false; Reload(); }

    private void ToggleStop()
    {
        if (c == null) return;
        c.Stopped = !c.Stopped;
        var stopped = c.Stopped;
        Root.Write(db => { if (db.AdCampaigns.FirstOrDefault(x => x.Id == Id) is { } x) x.Stopped = stopped; });
        Toast.Ok(stopped ? "Diffusion arrêtée : les spots quittent les écrans." : "Diffusion reprise.");
    }

    private void Delete()
    {
        if (Log.Total(Id) > 0) return;
        Root.Write(db => { db.AdCampaigns.RemoveAll(x => x.Id == Id); db.AdDecisions.RemoveAll(d => c!.Spots.Any(s => s.Id == d.SpotId)); });
        Nav.NavigateTo("/admin/ads");
    }

    private void LoadResults()
    {
        if (c == null) return;
        var (from, to) = AdReports.Month(month, Zone);
        var plays = Log.ReadAll(from).Where(p => p.Play.StartUtc < to && p.Play.CampaignId == Id).ToList();
        var camps = new List<AdCampaign> { c };
        (results, var csvRows) = Root.Read(db =>
        {
            var rows = AdReports.Rows(plays.Select(p => p.Play), camps);
            var list = rows.Select(r =>
            {
                var s = db.Screens.FirstOrDefault(x => x.Id == r.ScreenId);
                var cl = plays.First(p => p.Play.ScreenId == r.ScreenId).ClientId;
                return new ResultRow(r, s?.Name ?? "(écran supprimé)", db.Clients.FirstOrDefault(x => x.Id == cl)?.Name ?? "—", plays.Where(p => p.Play.ScreenId == r.ScreenId).Max(p => p.Play.StartUtc));
            }).ToList();
            var csv = new List<string[]> { new[] { "Compte", "Écran", "Passages complets", "Interrompus", "Temps complet (s)", "Prix (CHF)", "Montant (CHF)" } };
            csv.AddRange(list.Select(x => new[] { x.Client, x.Screen, x.Row.Complete.ToString(), x.Row.Interrupted.ToString(), x.Row.Seconds.ToString(), x.Row.Price.ToString("0.000", System.Globalization.CultureInfo.InvariantCulture), x.Row.Gross.ToString("0.00", System.Globalization.CultureInfo.InvariantCulture) }));
            return (list, csv);
        });
        CsvHref = "data:text/csv;charset=utf-8," + Uri.EscapeDataString("﻿" + AdReports.Csv(csvRows));
        var first = DateTime.ParseExact(month + "-01", "yyyy-MM-dd", null);
        days = Enumerable.Range(0, DateTime.DaysInMonth(first.Year, first.Month)).Select(i => first.AddDays(i)).Select(d =>
        {
            var ofDay = plays.Where(p => TimeZoneInfo.ConvertTimeFromUtc(p.Play.StartUtc, Zone).Date == d).ToList();
            return (d.ToString("d MMM", Ads.Fr), ofDay.Count(p => p.Play.Complete), ofDay.Count(p => !p.Play.Complete));
        }).ToList();
    }
}
