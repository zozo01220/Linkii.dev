@page "/admin/settings"
@attribute [Microsoft.AspNetCore.Authorization.Authorize(Policy = "PlatformAdmin")]
@inject JsonStore Root
@inject Toaster Toast
@inject SecretBox Box
@inject Mailer Mail
@inject NpmProxy Npm
@inject ResellerResolver Resolver

<div class="page-head">
    <div>
        <h1>Réglages</h1>
        <p class="sub sc-intro">Paramètres communs à tous les clients, quel que soit leur revendeur.</p>
    </div>
</div>

<div class="adm-set @(sub ? "sub" : "hub")">
    <nav class="n-nav" aria-label="Sections">
        @foreach (var g in Groups)
        {
            <h4>@g.Title</h4>
            @foreach (var (id, label, icon) in g.Items)
            {
                var sid = id;
                <button type="button" class="@(section == sid ? "on" : "")" @onclick="() => { section = sid; sub = true; }"><Ico Name="@icon" Size="18" /> <span>@label</span>@if (Attention(sid)) { <span class="n-dot" title="@AttentionTip(sid)"></span> }</button>
            }
        }
    </nav>

    @* Look « app » : liste des rubriques, puis la rubrique ouverte avec « ‹ Réglages » (comme les Réglages de l'espace client) *@
    <button type="button" class="rg-back adm-back" @onclick="() => sub = false"><Ico Name="chevron-right" Size="16" /> Réglages</button>
    <h2 class="adm-subh">@Sections.FirstOrDefault(s => s.Id == section).Label</h2>

    <div class="n-set">
    @if (section == "signup")
    {
        <div class="n-card"><p class="n-cardt">Essai gratuit</p><p class="n-cardd">Proposé à chaque organisation créée en libre-service (e-mail, Microsoft ou Google), à partir de la validation de l'adresse. Une modification ne touche que les nouveaux comptes : les essais en cours gardent leur date de fin.</p>
            <div class="n-fields">
                <div class="n-f"><label>Durée de l'essai</label><div class="u"><input type="number" min="1" max="365" class="mono" aria-label="Durée de l'essai en jours" @bind="trialDays" /><span class="muted">jours</span></div></div>
                <div class="n-f"><label>Licence pendant l'essai</label><div class="adm-seg" style="max-width:220px"><button type="button" class="@(trialPlan == Plans.Base ? "on" : "")" @onclick="() => trialPlan = Plans.Base">Essential</button><button type="button" class="@(trialPlan == Plans.Growth ? "on" : "")" @onclick="() => trialPlan = Plans.Growth">Pro</button></div><small>Pro d'office : le client essaie tout et choisit sa licence au moment de payer.</small></div>
                <div class="n-f"><label>Rappel avant la fin</label><div class="u"><input type="number" min="1" max="14" class="mono" aria-label="Rappel en jours" @bind="reminderDays" /><span class="muted">jours avant</span></div><small>À la fin, les écrans affichent « Essai terminé » ; le back-office reste ouvert pour choisir un plan.</small></div>
            </div></div>
        <div class="n-card"><p class="n-cardt">Validation de l'adresse</p><p class="n-cardd">Le compte reste « à valider » tant que le lien reçu par e-mail n'a pas été cliqué.</p>
            <div class="n-fields">
                <div class="n-f"><label>Validité du lien</label><div class="u"><input type="number" min="1" max="720" class="mono" aria-label="Validité du lien en heures" @bind="linkHours" /><span class="muted">heures</span></div></div>
                <div class="n-f"><label>Suppression si jamais validé</label><div class="u"><input type="number" min="1" max="365" class="mono" aria-label="Délai de suppression en jours" @bind="purgeDays" /><span class="muted">jours</span></div><small>Libère les adresses fausses ou mal saisies.</small></div>
            </div></div>
        <div class="n-card"><p class="n-cardt">Après l'essai</p><p class="n-cardd">Sans plan choisi à la fin de l'essai (ou d'un abonnement résilié), les écrans s'arrêtent. <span class="n-hint" title="Les contenus sont conservés ce nombre de jours puis supprimés définitivement. Annoncé dès l'inscription ; avertissements à 15, 7 et 1 jour. Seulement pour les espaces créés en libre-service.">En savoir plus <Ico Name="info" Size="13" /></span></p>
            <div class="n-fields"><div class="n-f"><label>Conservation des contenus</label><div class="u"><input type="number" min="7" max="365" class="mono" aria-label="Conservation en jours" @bind="retentionDays" /><span class="muted">jours</span></div></div></div></div>
        <div class="n-card"><p class="n-cardt">Codes d'essai</p><p class="n-cardd">Un lien d'inscription <span class="mono">/login?signup=1&amp;code=SALON30</span> donne la durée du code au lieu de la durée par défaut (salon, partenaire, démonstration).</p>
            <table class="adm-tbl n-tbl">
                <thead><tr><th>Code</th><th>Durée</th><th>Inscriptions</th><th>Actif</th><th></th></tr></thead>
                <tbody>
                    @foreach (var tc in codes)
                    {
                        var t = tc;
                        <tr style="cursor:default"><td class="mono"><b>@t.Code</b></td><td><input type="number" min="1" max="365" class="mono" style="width:70px" @bind="t.Days" aria-label="Durée du code" /> j</td><td>@t.Uses</td>
                            <td><button type="button" class="switch @(t.Active ? "on" : "")" role="switch" aria-checked="@(t.Active ? "true" : "false")" aria-label="Code actif" @onclick="() => t.Active = !t.Active"><span></span></button></td>
                            <td class="r"><button type="button" class="btn ghost sm" @onclick="() => codes.Remove(t)">Retirer</button></td></tr>
                    }
                    <tr style="cursor:default"><td><input class="mono" style="width:140px" placeholder="NOUVEAU-CODE" @bind="newCode" aria-label="Nouveau code" /></td><td><input type="number" min="1" max="365" class="mono" style="width:70px" @bind="newCodeDays" aria-label="Durée du nouveau code" /> j</td><td></td><td></td>
                        <td class="r"><button type="button" class="btn ghost sm" @onclick="AddCode">Ajouter</button></td></tr>
                </tbody>
            </table></div>
    }
    else if (section == "journey")
    {
        <div class="n-card"><p class="n-cardt">Parcours e-mails</p><p class="n-cardd">De l'inscription à la fin, puis pendant l'abonnement. <Ico Name="lock" Size="13" /> = obligatoire, ne se coupe pas. Les e-mails déclenchés par une action partent tout de suite ; les autres à 9 h, heure de l'organisation.</p>
            @foreach (var phase in Journey.Select(j => j.Phase).Distinct())
            {
                <div class="n-ph"><b>@phase</b><div class="n-mails">
                    @foreach (var (_, label, when, kind, on) in Journey.Where(j => j.Phase == phase))
                    {
                        <div class="n-mail"><div class="grow">@label<small>@when</small></div>
                            @if (on == "first") { <button type="button" class="switch @(mailFirst ? "on" : "")" role="switch" aria-checked="@(mailFirst ? "true" : "false")" aria-label="@label" @onclick="() => mailFirst = !mailFirst"><span></span></button> }
                            else if (on == "tips") { <button type="button" class="switch @(mailTips ? "on" : "")" role="switch" aria-checked="@(mailTips ? "true" : "false")" aria-label="@label" @onclick="() => mailTips = !mailTips"><span></span></button> }
                            else { <span class="lk" title="@kind"><Ico Name="lock" Size="14" /></span> }
                        </div>
                    }
                </div></div>
            }
        </div>
    }
    else if (section == "access")
    {
        <div class="n-card"><p class="n-cardt">Suspension et blocage</p><p class="n-cardd">Deux états que vous appliquez depuis la fiche d'un client.</p>
            <div class="adm-row">
                <div>Suspendu<small>Les écrans du client cessent de diffuser et affichent « Service suspendu ». Ses membres gardent l'accès au back-office.</small></div>
                <div class="val"><span class="adm-st warn">Écrans coupés</span></div>
            </div>
            <div class="adm-row">
                <div>Bloqué<small>Les écrans sont coupés et le back-office est fermé : plus aucun membre de l'organisation ne peut se connecter. L'équipe Linkivi peut toujours y entrer.</small></div>
                <div class="val"><span class="adm-st bad">Écrans et accès coupés</span></div>
            </div>
            <div class="adm-row">
                <div>Journal des accès<small>Chaque « Entrer dans l'espace » de l'équipe est enregistré et consultable dans l'onglet Activité de la fiche client.</small></div>
                <div class="val"><span class="adm-st ok">Toujours actif</span></div>
            </div></div>
    }
    else if (section == "prices")
    {
        var sim = priceGrowth * 10;
        var fee = Math.Round(sim * feePct / 100 + feeFixed, 2);
        var net = sim - fee;
        var commission = Math.Round(net * commissionPct / 100, 2);
        <div class="n-card"><p class="n-cardt">Tarifs</p><p class="n-cardd">Prix unique : tous les clients paient le tarif Linkivi, au nombre d'écrans, sans limite.</p>
            <div class="n-fields">
                <div class="n-f"><label>Essential</label><div class="u"><input type="number" min="0" step="0.5" class="mono" aria-label="Prix Essential" @bind="priceBase" /><span class="muted">CHF / écran / mois</span></div></div>
                <div class="n-f"><label>Pro</label><div class="u"><input type="number" min="0" step="0.5" class="mono" aria-label="Prix Pro" @bind="priceGrowth" /><span class="muted">CHF / écran / mois</span></div><small>Contrôle du direct, supervision, murs d'écrans et statistiques en plus.</small></div>
                <div class="n-f"><label>Remise annuelle</label><div class="u"><input type="number" min="0" max="90" class="mono" aria-label="Remise annuelle en pourcentage" @bind="annualPct" /><span class="muted">%</span></div><small>Pour un paiement de 12 mois en une fois.</small></div>
            </div>
            <div class="n-sim"><div class="t">Exemple : 10 écrans Pro</div><div><span>par mois</span><b>@Subscriptions.Fmt(sim) CHF</b></div><div><span>à l'année (−@annualPct %)</span><b>@Subscriptions.Fmt(Math.Round(sim * 12 * (100 - annualPct) / 100, 2)) CHF</b></div></div></div>
        <div class="n-card"><p class="n-cardt">Revendeurs et frais de paiement</p><p class="n-cardd">Linkivi retient une commission sur le net (montant moins frais) des clients d'un revendeur ; le revendeur reçoit le reste, versé le dernier jour du mois. Un taux particulier se règle dans la fiche du revendeur ; un paiement annuel est réparti d'un coup.</p>
            <div class="n-fields">
                <div class="n-f"><label>Commission de Linkivi (par défaut)</label><div class="u"><input type="number" min="0" max="100" class="mono" aria-label="Commission par défaut en pourcentage" @bind="commissionPct" /><span class="muted">%</span></div></div>
                <div class="n-f"><label>Frais de paiement estimés</label><div class="u"><input type="number" min="0" max="20" step="0.1" class="mono" style="width:80px" aria-label="Frais en pourcentage" @bind="feePct" /><span class="muted">% +</span><input type="number" min="0" max="10" step="0.05" class="mono" style="width:80px" aria-label="Frais fixes" @bind="feeFixed" /><span class="muted">CHF</span></div><small>Stripe : 2,9 % + 0,30 CHF par carte. Estimation tant que Stripe n'envoie pas les frais réels.</small></div>
            </div>
            <div class="n-sim"><div class="t">Sur un paiement de @Subscriptions.Fmt(sim) CHF d'un client de revendeur</div><div><span>frais estimés</span><b>−@Subscriptions.Fmt(fee)</b></div><div><span>net</span><b>@Subscriptions.Fmt(net)</b></div><div><span>Linkivi (@commissionPct %)</span><b>@Subscriptions.Fmt(commission)</b></div><div><span>revendeur</span><b>@Subscriptions.Fmt(net - commission)</b></div></div></div>
        <div class="n-card"><p class="n-cardt">Date anniversaire <span class="adm-st ok" style="margin-left:6px">Automatique</span></p><p class="n-cardd" style="margin:0">Un client paie au mois ou à l'année. La date anniversaire est celle de son premier paiement et ne change plus. Sans paiement à cette date, le compte est bloqué automatiquement (pas de relance) ; le paiement suivant le débloque.</p></div>
    }
    else if (section == "pay")
    {
        if (paymentMode == PaymentModes.Simulation)
        {
            <div class="n-ban warn"><Ico Name="alert" Size="18" /><div><b>Mode simulation actif.</b> Partout où Stripe interviendrait (choix du plan, écran ajouté, passage à Pro, carte), une fenêtre propose « paiement réussi » ou « refusé » ; les échéances sont payées d'office, sauf refus demandé dans la fiche du client. Les paiements simulés comptent comme les vrais et sont marqués « simulé ».</div></div>
        }
        else
        {
            <div class="n-ban ok"><Ico Name="check" Size="18" /><div><b>Stripe actif.</b> Les paiements passent par Stripe.</div></div>
        }
        <div class="n-card"><p class="n-cardt">Paiement en ligne</p><p class="n-cardd">Deux étapes pour passer à Stripe (à brancher).</p>
            <div class="n-fields">
                <div class="n-f"><label>1 · Clé secrète Stripe</label><input class="mono full" type="password" @bind="stripeKey" autocomplete="new-password" placeholder="@(hasStripeKey ? "Enregistrée" : "sk_live_…")" aria-label="Clé secrète Stripe" /><small>Chiffrée, jamais réaffichée. Tant que Stripe n'est pas branché, elle ne sert à rien.</small></div>
                <div class="n-f"><label>2 · Mode</label><div class="adm-seg" style="max-width:240px"><button type="button" class="@(paymentMode == PaymentModes.Simulation ? "on" : "")" @onclick="() => paymentMode = PaymentModes.Simulation">Simulation</button><button type="button" class="@(paymentMode == PaymentModes.Stripe ? "on" : "")" disabled="@(!hasStripeKey)" title="@(hasStripeKey ? null : "Saisissez d'abord la clé secrète Stripe")" @onclick="() => paymentMode = PaymentModes.Stripe">Stripe</button></div><small>Stripe se débloque une fois la clé enregistrée.</small></div>
            </div></div>
        <div class="n-card"><p class="n-cardt">Nettoyage avant la mise en service</p><p class="n-cardd">@simulatedCount paiement@(simulatedCount > 1 ? "s" : "") simulé@(simulatedCount > 1 ? "s" : ""). À effacer avant la mise en service réelle : les abonnements restent, seul le journal des paiements est vidé.</p>
            <button type="button" class="btn ghost" disabled="@(simulatedCount == 0)" @onclick="ClearSimulated">Effacer les paiements simulés</button></div>
    }
    else if (section == "addr")
    {
        <div class="n-card"><p class="n-cardt">Adresse des revendeurs</p><p class="n-cardd">Chaque revendeur reçoit une adresse « revendeur + séparateur + domaine ». Avec un certificat générique dans NPM, elle fonctionne dès la création.</p>
            <div class="n-fields">
                <div class="n-f"><label>Domaine de base</label><input class="full mono" @bind="baseDomain" placeholder="@EffectiveBase" autocomplete="off" spellcheck="false" /><small>Domaine du certificat générique de NPM (*.domaine). Vide, le serveur utilise « @EffectiveBase ».</small></div>
                <div class="n-f"><label>Séparateur</label>
                    <select class="full" @bind="sepChoice"><option value="">Automatique</option><option value=".">. (point) : acme.domaine</option><option value="-">- (tiret) : acme-domaine</option></select></div>
            </div>
            <div class="n-flow"><span class="n-node"><small>Revendeur</small><b>acme</b></span><Ico Name="chevron-right" Size="16" /><span class="n-node on"><small>Adresse créée (réglages enregistrés)</small><b class="mono">@Example</b></span>@if (npmForwardHost.Trim() != "") { <Ico Name="chevron-right" Size="16" /><span class="n-node"><small>NPM : hôte proxy + certificat</small><b class="mono">@npmScheme://@npmForwardHost.Trim():@npmPort</b></span> }</div></div>
        if (npmReady)
        {
            <div class="n-ban ok"><Ico Name="check" Size="18" /><div><b>NPM configuré.</b> Un hôte proxy est créé automatiquement pour chaque nouveau revendeur.</div></div>
        }
        <div class="n-card"><p class="n-cardt">Nginx Proxy Manager @if (!npmReady) { <span class="adm-st mute" style="margin-left:6px">Non configuré</span> }</p><p class="n-cardd">Linkivi y crée un hôte proxy pour chaque nouveau revendeur, avec le certificat générique du domaine. Laissez l'adresse vide pour ne rien automatiser.</p>
            <div class="n-fields">
                <div class="n-f" style="grid-column:1/-1"><label>Adresse de l'API</label><input class="full mono" @bind="npmUrl" placeholder="http://192.168.1.120:81" autocomplete="off" spellcheck="false" /></div>
                <div class="n-f"><label>Identifiant (compte dédié)</label><input class="full" @bind="npmUser" autocomplete="off" /></div>
                <div class="n-f"><label>Mot de passe</label><input class="full" type="password" @bind="npmPassword" autocomplete="new-password" name="npm-secret" placeholder="@(hasNpmPassword && npmReadable ? "Enregistré : laisser vide pour le conserver" : hasNpmPassword ? "Illisible sur ce serveur : saisissez-le à nouveau" : "")" /></div>
            </div>
            <div class="n-sub">Destination des hôtes</div>
            <div class="n-fields">
                <div class="n-f"><label>Protocole</label><div class="adm-seg" style="max-width:160px"><button type="button" class="@(npmScheme == "http" ? "on" : "")" @onclick='() => npmScheme = "http"'>http</button><button type="button" class="@(npmScheme == "https" ? "on" : "")" @onclick='() => npmScheme = "https"'>https</button></div></div>
                <div class="n-f"><label>Adresse du serveur</label><input class="full mono" @bind="npmForwardHost" placeholder="192.168.1.249" autocomplete="off" /></div>
                <div class="n-f"><label>Port</label><input type="number" min="1" max="65535" class="mono" style="width:100px" @bind="npmPort" aria-label="Port" /></div>
            </div>
            <div class="n-test"><button type="button" class="btn ghost" @onclick="TestNpm" disabled="@testing">Tester la connexion</button>
                @if (npmTest != "") { <span class="adm-st @(npmTestOk ? "ok" : "bad")">@npmTest</span> }
                <small>Enregistre les champs avant de tester.</small></div></div>
    }
    else if (section == "mail")
    {
        if (!Mail.Configured)
        {
            <div class="n-ban warn"><Ico Name="alert" Size="18" /><div><b>Aucun serveur renseigné : aucun e-mail ne part.</b> Confirmations d'adresse, mots de passe provisoires, invitations et rappels dépendent de ce réglage.</div></div>
        }
        else
        {
            <div class="n-ban ok"><Ico Name="check" Size="18" /><div><b>Serveur d'envoi configuré.</b> Un seul serveur pour toute la plateforme.</div></div>
        }
        <div class="n-card"><p class="n-cardt">Serveur d'envoi</p><p class="n-cardd">Un seul serveur pour toute la plateforme : confirmations d'adresse, mots de passe provisoires, invitations et rappels.</p>
            <div class="n-fields">
                <div class="n-f"><label>Serveur SMTP</label><input class="full" @bind="smtpHost" placeholder="smtp.exemple.ch" autocomplete="off" /></div>
                <div class="n-f"><label>Port</label><input type="number" min="1" max="65535" class="mono" style="width:100px" @bind="smtpPort" aria-label="Port" /></div>
                <div class="n-f"><label>Sécurité</label><div class="adm-seg" style="max-width:220px"><button type="button" class="@(smtpSsl ? "on" : "")" @onclick="() => smtpSsl = true">SSL / TLS</button><button type="button" class="@(!smtpSsl ? "on" : "")" @onclick="() => smtpSsl = false">Aucune</button></div></div>
            </div></div>
        <div class="n-card"><p class="n-cardt">Connexion et expéditeur</p><p class="n-cardd">Compte utilisé pour envoyer, et adresse qui apparaît chez le destinataire.</p>
            <div class="n-fields">
                <div class="n-f"><label>Identifiant</label><input class="full" @bind="smtpUser" autocomplete="off" /></div>
                <div class="n-f"><label>Mot de passe</label><input class="full" type="password" @bind="smtpPassword" autocomplete="new-password" placeholder="@(hasPassword ? "Enregistré : laisser vide pour le conserver" : "")" /><small>Chiffré, jamais réaffiché.</small></div>
                <div class="n-f"><label>Adresse d'expédition</label><input class="full" type="email" @bind="smtpFrom" placeholder="no-reply@exemple.ch" autocomplete="off" /></div>
            </div></div>
        <div class="n-card"><p class="n-cardt">Tester l'envoi</p><p class="n-cardd">Enregistre les réglages puis envoie un e-mail de contrôle.</p>
            <div class="n-test" style="margin-top:0;padding-top:0;border:0"><input class="full" type="email" style="max-width:300px" @bind="testTo" placeholder="vous@organisation.ch" autocomplete="off" aria-label="Adresse de test" /><button type="button" class="btn ghost" @onclick="SendTest" disabled="@sending">Envoyer un e-mail de test</button></div>
            <small class="muted" style="display:block;margin-top:8px">Sans serveur renseigné ici, la configuration du serveur (Linkii:Smtp) est utilisée.</small></div>
    }
    else
    {
        <div class="n-card"><p class="n-cardt">Conditions générales</p><p class="n-cardd">Texte affiché dans une fenêtre sur la page de création d'un espace. Version acceptée et date enregistrées pour chaque administrateur.</p>
            <div class="n-test" style="margin-top:0;padding-top:0;border:0"><button type="button" class="btn ghost" data-open-dialog="terms-dialog">Aperçu</button><small>Version @Terms.Version, publiée le @Terms.PublishedUtc.ToString("d MMMM yyyy", Signup.Fr) · acceptée par @accepted compte@(accepted > 1 ? "s" : "")</small></div></div>
    }

    @if (Dirty)
    {
        <div class="n-save" role="status"><Ico Name="info" Size="16" /><span class="grow">Modifications non enregistrées</span><button type="button" class="btn ghost" @onclick="Cancel">Annuler</button><button type="button" class="btn" @onclick="Save">Enregistrer</button></div>
    }
    </div>
</div>

<TermsDialog Accept="false" />

@code {
    private int trialDays, linkHours, purgeDays, accepted, smtpPort = 587;
    private string smtpHost = "", smtpUser = "", smtpPassword = "", smtpFrom = "";
    private bool smtpSsl = true, hasPassword, sending;
    private string testTo = "";
    private string section = "signup";
    private bool sub;   // look « app » : une rubrique ouverte (liste des rubriques masquée)
    private string baseDomain = "", sepChoice = "", npmUrl = "", npmUser = "", npmPassword = "", npmScheme = "http", npmForwardHost = "", npmTest = "";
    private int npmPort = 5001, annualPct = 15, commissionPct = 20;
    private decimal priceBase = 15, priceGrowth = 29, feePct = 2.9m, feeFixed = 0.30m;
    private bool npmReadable = true;
    private bool hasNpmPassword, npmReady, testing, npmTestOk;
    private string EffectiveBase => Root.Read(d => Resolver.BaseDomainOf(d));
    private string Example => Root.Read(d => Resolver.HostFor(d, "acme"));
    // Rubriques groupées par famille : Clients, Argent, Plateforme
    private static readonly (string Title, (string Id, string Label, string Icon)[] Items)[] Groups =
    {
        ("Clients", new[] { ("signup", "Inscription et essai", "user"), ("journey", "Parcours e-mails", "mail-send"), ("access", "Suspension et blocage", "lock") }),
        ("Argent", new[] { ("prices", "Tarifs et commissions", "chart"), ("pay", "Paiement en ligne", "card") }),
        ("Plateforme", new[] { ("addr", "Adresses et NPM", "globe"), ("mail", "Serveur d'e-mails", "mail"), ("terms", "Conditions", "file") })
    };
    private static readonly (string Id, string Label, string Icon)[] Sections = Groups.SelectMany(g => g.Items).ToArray();

    /// <summary>Pastille orange dans le menu : ce qui mérite attention (paiements simulés, aucun serveur d'e-mails).</summary>
    private bool Attention(string id) => id == "pay" ? paymentMode == PaymentModes.Simulation : id == "mail" && !Mail.Configured;
    private string AttentionTip(string id) => id == "pay" ? "Mode simulation" : "Aucun serveur d'e-mails";

