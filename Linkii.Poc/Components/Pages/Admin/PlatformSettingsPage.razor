@page "/admin/settings"
@attribute [Microsoft.AspNetCore.Authorization.Authorize(Policy = "PlatformAdmin")]
@inject JsonStore Root
@inject Toaster Toast
@inject SecretBox Box
@inject Mailer Mail
@inject NpmProxy Npm
@inject ResellerResolver Resolver

<div class="page-head">
    <div>
        <h1>Réglages</h1>
        <p class="sub sc-intro">Paramètres communs à tous les clients, quel que soit leur revendeur.</p>
    </div>
    <button class="btn adm-save" @onclick="Save">Enregistrer</button>
</div>

<div class="adm-set @(sub ? "sub" : "hub")">
    <nav aria-label="Sections">
        @foreach (var (id, label, icon) in Sections)
        {
            var sid = id;
            <button type="button" class="@(section == sid ? "on" : "")" @onclick="() => { section = sid; sub = true; }"><Ico Name="@icon" Size="18" /> <span>@label</span></button>
        }
    </nav>

    @* Look « app » : liste des rubriques, puis la rubrique ouverte avec « ‹ Réglages » (comme les Réglages de l'espace client) *@
    <button type="button" class="rg-back adm-back" @onclick="() => sub = false"><Ico Name="chevron-right" Size="16" /> Réglages</button>
    <h2 class="adm-subh">@Sections.FirstOrDefault(s => s.Id == section).Label</h2>
    <div class="adm-card" style="padding:4px 22px">
    @if (section == "signup")
    {
        <div class="adm-row">
            <div>Durée de l'essai gratuit<small>Proposé à chaque organisation créée en libre-service (e-mail, Microsoft ou Google), à partir de la validation de l'adresse. Une modification s'applique aux nouveaux comptes : les essais en cours gardent leur date de fin.</small></div>
            <div class="val"><input type="number" min="1" max="365" class="mono" style="width:90px" aria-label="Durée de l'essai en jours" @bind="trialDays" /><span class="muted">jours</span></div>
        </div>
        <div class="adm-row">
            <div>Validité du lien de confirmation<small>Le compte reste « à valider » tant que le lien envoyé par e-mail n'a pas été cliqué.</small></div>
            <div class="val"><input type="number" min="1" max="720" class="mono" style="width:90px" aria-label="Validité du lien en heures" @bind="linkHours" /><span class="muted">heures</span></div>
        </div>
        <div class="adm-row">
            <div>Suppression des comptes jamais validés<small>Libère les adresses fausses ou mal saisies.</small></div>
            <div class="val"><input type="number" min="1" max="365" class="mono" style="width:90px" aria-label="Délai de suppression en jours" @bind="purgeDays" /><span class="muted">jours après l'inscription</span></div>
        </div>
        <div class="adm-row">
            <div>Licence pendant l'essai<small>Pro d'office : le client essaie tout et choisit sa licence au moment de payer.</small></div>
            <div class="val"><div class="adm-seg"><button type="button" class="@(trialPlan == Plans.Base ? "on" : "")" @onclick="() => trialPlan = Plans.Base">Essential</button><button type="button" class="@(trialPlan == Plans.Growth ? "on" : "")" @onclick="() => trialPlan = Plans.Growth">Pro</button></div></div>
        </div>
        <div class="adm-row">
            <div>Conservation après l'essai<small>Sans plan choisi à la fin de l'essai (ou d'un abonnement résilié), les écrans s'arrêtent, les contenus sont conservés ce nombre de jours puis supprimés définitivement. Annoncé dès l'inscription ; avertissements à 15, 7 et 1 jour. Seulement pour les espaces créés en libre-service.</small></div>
            <div class="val"><input type="number" min="7" max="365" class="mono" style="width:90px" aria-label="Conservation en jours" @bind="retentionDays" /><span class="muted">jours</span></div>
        </div>
        <div class="adm-row">
            <div>Rappel avant la fin de l'essai<small>À la fin, les écrans affichent « Essai terminé » ; le back-office reste ouvert pour choisir un plan.</small></div>
            <div class="val"><input type="number" min="1" max="14" class="mono" style="width:90px" aria-label="Rappel en jours" @bind="reminderDays" /><span class="muted">jours avant</span></div>
        </div>
        <div class="adm-row" style="display:block">
            <div>Codes d'essai<small>Un lien d'inscription <span class="mono">/login?signup=1&amp;code=SALON30</span> donne la durée du code au lieu de la durée par défaut (salon, partenaire, démonstration).</small></div>
            <table class="adm-tbl" style="margin:10px 0 6px">
                <thead><tr><th>Code</th><th>Durée</th><th>Inscriptions</th><th>Actif</th><th></th></tr></thead>
                <tbody>
                    @foreach (var tc in codes)
                    {
                        var t = tc;
                        <tr><td class="mono"><b>@t.Code</b></td><td><input type="number" min="1" max="365" class="mono" style="width:70px" @bind="t.Days" aria-label="Durée du code" /> j</td><td>@t.Uses</td>
                            <td><button type="button" class="switch @(t.Active ? "on" : "")" role="switch" aria-checked="@(t.Active ? "true" : "false")" aria-label="Code actif" @onclick="() => t.Active = !t.Active"><span></span></button></td>
                            <td><button type="button" class="btn ghost sm" @onclick="() => codes.Remove(t)">Retirer</button></td></tr>
                    }
                    <tr><td><input class="mono" style="width:140px" placeholder="NOUVEAU-CODE" @bind="newCode" aria-label="Nouveau code" /></td><td><input type="number" min="1" max="365" class="mono" style="width:70px" @bind="newCodeDays" aria-label="Durée du nouveau code" /> j</td><td></td><td></td>
                        <td><button type="button" class="btn ghost sm" @onclick="AddCode">Ajouter</button></td></tr>
                </tbody>
            </table>
        </div>
    }
    else if (section == "journey")
    {
        <div style="padding:16px 0 4px" class="muted">E-mails envoyés à l'organisation, de l'inscription à la fin (plan acheté ou suppression). Les e-mails déclenchés par une action partent tout de suite ; les autres partent à 9 h, heure de l'organisation. Les obligatoires ne se coupent pas.</div>
        @foreach (var (label, when, kind, on) in Journey)
        {
            <div class="adm-row">
                <div>@label<small>@when</small></div>
                <div class="val">
                    @if (on == "first") { <button type="button" class="switch @(mailFirst ? "on" : "")" role="switch" aria-checked="@(mailFirst ? "true" : "false")" aria-label="@label" @onclick="() => mailFirst = !mailFirst"><span></span></button> }
                    else if (on == "tips") { <button type="button" class="switch @(mailTips ? "on" : "")" role="switch" aria-checked="@(mailTips ? "true" : "false")" aria-label="@label" @onclick="() => mailTips = !mailTips"><span></span></button> }
                    else { <span class="adm-st @(kind == "Obligatoire" ? "ok" : "mute")">@kind</span> }
                </div>
            </div>
        }
    }
    else if (section == "access")
    {
        <div class="adm-row">
            <div>Suspendu<small>Les écrans du client cessent de diffuser et affichent « Service suspendu ». Ses membres gardent l'accès au back-office.</small></div>
            <div class="val"><span class="adm-st warn">Écrans coupés</span></div>
        </div>
        <div class="adm-row">
            <div>Bloqué<small>Les écrans sont coupés et le back-office est fermé : plus aucun membre de l'organisation ne peut se connecter. L'équipe Linkii peut toujours y entrer.</small></div>
            <div class="val"><span class="adm-st bad">Écrans et accès coupés</span></div>
        </div>
        <div class="adm-row">
            <div>Journal des accès<small>Chaque « Entrer dans l'espace » de l'équipe est enregistré et consultable dans l'onglet Activité de la fiche client.</small></div>
            <div class="val"><span class="adm-st ok">Toujours actif</span></div>
        </div>
    }
    else if (section == "billing")
    {
        <div class="adm-row">
            <div>Licence Essential<small>Prix par écran et par mois. Les clients paient au nombre d'écrans, sans limite.</small></div>
            <div class="val"><input type="number" min="0" step="0.5" class="mono" style="width:100px" aria-label="Prix Essential" @bind="priceBase" /><span class="muted">CHF</span></div>
        </div>
        <div class="adm-row">
            <div>Licence Pro<small>Prix par écran et par mois : contrôle du direct, supervision, murs d'écrans et statistiques en plus.</small></div>
            <div class="val"><input type="number" min="0" step="0.5" class="mono" style="width:100px" aria-label="Prix Pro" @bind="priceGrowth" /><span class="muted">CHF</span></div>
        </div>
        <div class="adm-row">
            <div>Remise annuelle<small>Pour un client qui paie à l'année (12 mois en un paiement).</small></div>
            <div class="val"><input type="number" min="0" max="90" class="mono" style="width:90px" aria-label="Remise annuelle en pourcentage" @bind="annualPct" /><span class="muted">%</span></div>
        </div>
        <div class="adm-row">
            <div>Commission de Linkii sur les revendeurs<small>Part du net (montant moins frais de paiement) que Linkii retient sur ce que paient les clients d'un revendeur ; le revendeur reçoit le reste, versé le dernier jour du mois. Chaque revendeur peut recevoir un taux particulier dans sa fiche ; un paiement annuel est réparti d'un coup. Prix unique : tous les clients paient le tarif Linkii.</small></div>
            <div class="val"><input type="number" min="0" max="100" class="mono" style="width:90px" aria-label="Commission par défaut en pourcentage" @bind="commissionPct" /><span class="muted">%</span></div>
        </div>
        <div class="adm-row">
            <div>Frais de paiement estimés<small>Pourcentage et montant fixe retenus sur chaque paiement avant de calculer la commission (Stripe : 2,9 % + 0,30 CHF par carte). Estimation tant que Stripe n'envoie pas les frais réels.</small></div>
            <div class="val"><input type="number" min="0" max="20" step="0.1" class="mono" style="width:80px" aria-label="Frais en pourcentage" @bind="feePct" /><span class="muted">% +</span><input type="number" min="0" max="10" step="0.05" class="mono" style="width:80px" aria-label="Frais fixes" @bind="feeFixed" /><span class="muted">CHF</span></div>
        </div>
        <div class="adm-row">
            <div>Date anniversaire<small>Un client paie au mois ou à l'année. La date anniversaire est celle de son premier paiement et ne change plus. Sans paiement à cette date, le compte est bloqué automatiquement : pas de relance. Le paiement suivant le débloque.</small></div>
            <div class="val"><span class="adm-st ok">Automatique</span></div>
        </div>
        <div class="adm-row">
            <div>Paiement en ligne<small>Simulation : partout où Stripe interviendrait (choix du plan, écran ajouté, passage à Pro, carte), une fenêtre propose « paiement réussi » ou « refusé » ; les échéances sont payées d'office, sauf refus demandé dans la fiche du client (Facturation). Les paiements simulés comptent comme les vrais et sont marqués « simulé ». Stripe : à brancher (clé secrète à saisir).</small></div>
            <div class="val"><div class="adm-seg"><button type="button" class="@(paymentMode == PaymentModes.Simulation ? "on" : "")" @onclick="() => paymentMode = PaymentModes.Simulation">Simulation</button><button type="button" class="@(paymentMode == PaymentModes.Stripe ? "on" : "")" disabled="@(!hasStripeKey)" title="@(hasStripeKey ? null : "Saisissez d'abord la clé secrète Stripe")" @onclick="() => paymentMode = PaymentModes.Stripe">Stripe</button></div></div>
        </div>
        <div class="adm-row">
            <div>Clé secrète Stripe<small>Prévue pour le branchement : chiffrée, jamais réaffichée. Tant que Stripe n'est pas branché, elle ne sert à rien.</small></div>
            <div class="val"><input class="mono" type="password" style="width:220px" @bind="stripeKey" autocomplete="new-password" placeholder="@(hasStripeKey ? "Enregistrée" : "sk_live_…")" aria-label="Clé secrète Stripe" /></div>
        </div>
        <div class="adm-row">
            <div>Paiements simulés<small>@simulatedCount paiement@(simulatedCount > 1 ? "s" : "") simulé@(simulatedCount > 1 ? "s" : ""). À effacer avant la mise en service réelle : les abonnements restent, seul le journal des paiements est vidé.</small></div>
            <div class="val"><button type="button" class="btn ghost" disabled="@(simulatedCount == 0)" @onclick="ClearSimulated">Effacer</button></div>
        </div>
    }
    else if (section == "addr")
    {
        <div style="padding:16px 0 4px" class="muted">Chaque revendeur reçoit une adresse « revendeur + séparateur + domaine ». Avec un certificat générique dans NPM, elle fonctionne dès la création.</div>
        <div class="form-grid" style="padding:8px 0 6px">
            <div><label class="lbl">Domaine de base</label><input class="full mono" @bind="baseDomain" placeholder="@EffectiveBase" autocomplete="off" spellcheck="false" /><small class="muted">À renseigner : c'est le domaine du certificat générique de NPM (*.domaine). Vide, le serveur utilise « @EffectiveBase ».</small></div>
            <div><label class="lbl">Séparateur</label>
                <select class="full" @bind="sepChoice"><option value="">Automatique</option><option value=".">. (point) : acme.domaine</option><option value="-">- (tiret) : acme-domaine</option></select></div>
            <div><label class="lbl">Exemple</label><div class="mono" style="padding:8px 0">@Example</div></div>
        </div>
        <div class="adm-row" style="border-top:1px solid var(--row);margin-top:10px">
            <div>Nginx Proxy Manager<small>Linkii y crée un hôte proxy pour chaque nouveau revendeur, avec le certificat générique du domaine. Laissez l'adresse vide pour ne rien automatiser.</small></div>
            <div class="val"><span class="adm-st @(npmReady ? "ok" : "mute")">@(npmReady ? "Configuré" : "Non configuré")</span></div>
        </div>
        <div class="form-grid" style="padding:4px 0 8px">
            <div style="grid-column:1/-1"><label class="lbl">Adresse de l'API</label><input class="full mono" @bind="npmUrl" placeholder="http://192.168.1.120:81" autocomplete="off" spellcheck="false" /></div>
            <div><label class="lbl">Identifiant (compte dédié)</label><input class="full" @bind="npmUser" autocomplete="off" /></div>
            <div><label class="lbl">Mot de passe</label><input class="full" type="password" @bind="npmPassword" autocomplete="new-password" name="npm-secret" placeholder="@(hasNpmPassword && npmReadable ? "Enregistré : laisser vide pour le conserver" : hasNpmPassword ? "Illisible sur ce serveur : saisissez-le à nouveau" : "")" /></div>
            <div><label class="lbl">Destination des hôtes</label>
                <div class="row" style="gap:6px"><select @bind="npmScheme"><option value="http">http</option><option value="https">https</option></select><input class="full mono" @bind="npmForwardHost" placeholder="192.168.1.249" autocomplete="off" /><input type="number" min="1" max="65535" class="mono" style="width:90px" @bind="npmPort" aria-label="Port" /></div></div>
        </div>
        <div class="row" style="gap:10px;padding-bottom:16px"><button type="button" class="btn ghost" @onclick="TestNpm" disabled="@testing">Enregistrer et tester la connexion</button><span class="@(npmTestOk ? "muted" : "err")" style="margin:0">@npmTest</span></div>
    }
    else if (section == "mail")
    {
        <div style="padding:16px 0 4px" class="muted">Un seul serveur d'envoi pour toute la plateforme : confirmations d'adresse, mots de passe provisoires, invitations et rappels. @(Mail.Configured ? "" : "Aucun e-mail ne part tant que ce n'est pas renseigné.")</div>
        <div class="form-grid" style="padding:8px 0 18px">
            <div><label class="lbl">Serveur et port</label>
                <div class="row" style="gap:8px"><input class="full" @bind="smtpHost" placeholder="smtp.exemple.ch" autocomplete="off" /><input type="number" min="1" max="65535" class="mono" style="width:90px" @bind="smtpPort" aria-label="Port" /></div></div>
            <div><label class="lbl"><input type="checkbox" class="ios" @bind="smtpSsl" /> Connexion chiffrée (SSL/TLS)</label></div>
            <div><label class="lbl">Identifiant</label><input class="full" @bind="smtpUser" autocomplete="off" /></div>
            <div><label class="lbl">Mot de passe</label><input class="full" type="password" @bind="smtpPassword" autocomplete="new-password" placeholder="@(hasPassword ? "Enregistré : laisser vide pour le conserver" : "")" /></div>
            <div><label class="lbl">Adresse d'expédition</label><input class="full" type="email" @bind="smtpFrom" placeholder="no-reply@exemple.ch" autocomplete="off" /></div>
            <div><label class="lbl">Envoyer un e-mail de test à</label>
                <div class="row" style="gap:8px"><input class="full" type="email" @bind="testTo" placeholder="vous@organisation.ch" autocomplete="off" /><button type="button" class="btn ghost" @onclick="SendTest" disabled="@sending">Enregistrer et tester</button></div>
                <small class="muted">Sans serveur renseigné ici, la configuration du serveur (Linkii:Smtp) est utilisée.</small></div>
        </div>
    }
    else
    {
        <div class="adm-row">
            <div>Conditions générales<small>Texte affiché dans une fenêtre sur la page de création d'un espace. Version acceptée et date enregistrées pour chaque administrateur.</small>
                <small>Version @Terms.Version, publiée le @Terms.PublishedUtc.ToString("d MMMM yyyy", Signup.Fr) · acceptée par @accepted compte@(accepted > 1 ? "s" : "")</small></div>
            <div class="val"><button type="button" class="btn ghost" data-open-dialog="terms-dialog">Aperçu</button></div>
        </div>
    }
    </div>
</div>

<TermsDialog Accept="false" />

@code {
    private int trialDays, linkHours, purgeDays, accepted, smtpPort = 587;
    private string smtpHost = "", smtpUser = "", smtpPassword = "", smtpFrom = "";
    private bool smtpSsl = true, hasPassword, sending;
    private string testTo = "";
    private string section = "signup";
    private bool sub;   // look « app » : une rubrique ouverte (liste des rubriques masquée)
    private string baseDomain = "", sepChoice = "", npmUrl = "", npmUser = "", npmPassword = "", npmScheme = "http", npmForwardHost = "", npmTest = "";
    private int npmPort = 5001, annualPct = 15, commissionPct = 20;
    private decimal priceBase = 15, priceGrowth = 29, feePct = 2.9m, feeFixed = 0.30m;
    private bool npmReadable = true;
    private bool hasNpmPassword, npmReady, testing, npmTestOk;
    private string EffectiveBase => Root.Read(d => Resolver.BaseDomainOf(d));
    private string Example => Root.Read(d => Resolver.HostFor(d, "acme"));
    private static readonly (string Id, string Label, string Icon)[] Sections =
    {
        ("signup", "Inscription et essai", "user"), ("journey", "Parcours e-mails", "mail-send"), ("access", "Suspension et blocage", "lock"), ("billing", "Facturation", "chart"), ("addr", "Adresses", "globe"), ("mail", "E-mails", "mail"), ("terms", "Conditions", "file")
    };

    // Essai, conservation, codes, parcours e-mails, paiement (voir Billing, Lifecycle)
    private string trialPlan = Plans.Growth, paymentMode = PaymentModes.Simulation, stripeKey = "", newCode = "";
    private int retentionDays = 30, reminderDays = 2, newCodeDays = 30, simulatedCount;
    private bool mailFirst = true, mailTips = true, hasStripeKey;
    private List<TrialCode> codes = new();

    /// <summary>Le parcours, dans l'ordre : libellé, moment, type, interrupteur (first / tips) ou rien pour un obligatoire.</summary>
    private static readonly (string Label, string When, string Kind, string? Toggle)[] Journey =
    {
        ("Validation de l'adresse", "Immédiat à l'inscription par e-mail ; lien valable selon « Inscription et essai »", "Obligatoire", null),
        ("Bienvenue", "À la validation : dates de fin d'essai et de suppression sans plan", "Obligatoire", null),
        ("Premiers pas", "J+1, si aucun écran n'est connecté (case « nouveautés et astuces »)", "Facultatif", "first"),
        ("Astuces", "J+3 pour un essai court, J+10 et J+20 pour un essai d'un mois (case « nouveautés et astuces »)", "Facultatif", "tips"),
        ("Rappel de fin d'essai", "Avant la fin, avec une estimation du prix", "Obligatoire", null),
        ("Essai terminé", "Le jour de la fin, sans plan choisi", "Obligatoire", null),
        ("Avertissements de suppression", "15, 7 et 1 jour avant, à tous les administrateurs", "Obligatoire", null),
        ("Suppression effectuée, bonne continuation", "Au terme de la conservation", "Obligatoire", null),
        ("Plan actif, bonne continuation", "Au choix du plan (fin de séquence)", "Obligatoire", null),
        ("Écran ajouté", "Immédiat, avec le prorata, aux administrateurs", "Obligatoire", null),
        ("Passage à Essential programmé", "Immédiat, avec ce qui sera verrouillé", "Obligatoire", null),
        ("Résiliation enregistrée", "Immédiat ; puis avertissements de suppression", "Obligatoire", null),
        ("Paiement refusé", "Immédiat, compte bloqué, aux administrateurs", "Obligatoire", null),
    };

    private void AddCode()
    {
        var c = global::Linkii.Poc.Billing.NormalizeCode(newCode);   // « Billing » seul désigne ici la page Facturation
        if (c.Length < 3) { Toast.Error("Le code doit comporter au moins 3 lettres ou chiffres."); return; }
        if (codes.Any(x => x.Code == c)) { Toast.Error("Ce code existe déjà."); return; }
        if (newCodeDays is < 1 or > 365) { Toast.Error("La durée doit être comprise entre 1 et 365 jours."); return; }
        codes.Add(new TrialCode { Code = c, Days = newCodeDays });
        newCode = ""; newCodeDays = 30;
    }

    private void ClearSimulated()
    {
        var n = Root.Write(d => d.Payments.RemoveAll(p => p.Simulated));
        simulatedCount = 0;
        Toast.Ok($"{n} paiement{(n > 1 ? "s" : "")} simulé{(n > 1 ? "s" : "")} effacé{(n > 1 ? "s" : "")}.");
    }

    protected override void OnInitialized()
    {
        (trialDays, linkHours, purgeDays, accepted) = Root.Read(d => (d.Platform.TrialDays, d.Platform.VerifyLinkHours, d.Platform.PurgeUnverifiedDays,
            d.Users.Count(u => u.TermsVersion == Terms.Version)));
        var p = Root.Read(d => d.Platform);
        (baseDomain, sepChoice, npmUrl, npmUser, npmScheme, npmForwardHost, npmPort, hasNpmPassword) = (p.BaseDomain, p.SubdomainSeparator, p.NpmUrl, p.NpmUser, p.NpmForwardScheme, p.NpmForwardHost, p.NpmForwardPort, p.NpmPassword != "");
        (priceBase, priceGrowth, annualPct, commissionPct, feePct, feeFixed) = (p.PriceBase, p.PriceGrowth, p.AnnualDiscountPct, p.DefaultCommissionPct, p.StripeFeePct, p.StripeFeeFixed);
        npmReady = Npm.Configured;
        npmReadable = !hasNpmPassword || npmReady || Npm.Problem() is not { } pb || !pb.Contains("illisible");
        (smtpHost, smtpPort, smtpSsl, smtpUser, smtpFrom, hasPassword) = (p.SmtpHost, p.SmtpPort > 0 ? p.SmtpPort : 587, p.SmtpSsl, p.SmtpUser, p.SmtpFrom, p.SmtpPassword != "");
        (trialPlan, retentionDays, reminderDays, mailFirst, mailTips, paymentMode, hasStripeKey) = (p.TrialPlan, p.RetentionDays, p.TrialReminderDays, p.MailFirstSteps, p.MailTips, p.PaymentMode, p.StripeSecretKey != "");
        codes = p.TrialCodes.Select(c => new TrialCode { Code = c.Code, Days = c.Days, Active = c.Active, Uses = c.Uses }).ToList();   // copie : rien n'est enregistré avant « Enregistrer »
        simulatedCount = Root.Read(d => d.Payments.Count(x => x.Simulated));
    }

    private void Save() => SaveCore(true);

    private bool SaveCore(bool toast)
    {
        if (trialDays is < 1 or > 365) { Toast.Error("La durée de l'essai doit être comprise entre 1 et 365 jours."); return false; }
        if (linkHours is < 1 or > 720) { Toast.Error("La validité du lien doit être comprise entre 1 et 720 heures."); return false; }
        if (purgeDays is < 1 or > 365) { Toast.Error("Le délai de suppression doit être compris entre 1 et 365 jours."); return false; }
        if (smtpPort is < 1 or > 65535) { Toast.Error("Le port du serveur d'e-mails doit être compris entre 1 et 65535."); return false; }
        if (smtpHost.Trim() != "" && !smtpFrom.Contains('@') && !smtpUser.Contains('@')) { Toast.Error("Indiquez l'adresse d'expédition des e-mails."); return false; }
        if (priceBase < 0 || priceGrowth < 0 || priceBase > 10000 || priceGrowth > 10000) { Toast.Error("Les prix doivent être compris entre 0 et 10 000 CHF."); return false; }
        if (commissionPct is < 0 or > 100) { Toast.Error("La commission doit être comprise entre 0 et 100 %."); return false; }
        if (feePct is < 0 or > 20 || feeFixed is < 0 or > 10) { Toast.Error("Les frais de paiement ne sont pas valides."); return false; }
        if (annualPct is < 0 or > 90) { Toast.Error("La remise annuelle doit être comprise entre 0 et 90 %."); return false; }
        baseDomain = baseDomain.Trim().ToLowerInvariant();
        if (baseDomain != "" && !System.Text.RegularExpressions.Regex.IsMatch(baseDomain, @"^[a-z0-9]([a-z0-9-]*[a-z0-9])?(\.[a-z0-9]([a-z0-9-]*[a-z0-9])?)+$")) { Toast.Error("Le domaine de base n'est pas valide (ex. : linkii.duckdns.org)."); return false; }
        if (npmUrl.Trim() != "" && !Uri.TryCreate(npmUrl.Trim(), UriKind.Absolute, out _) || npmPort is < 1 or > 65535) { Toast.Error("L'adresse de NPM ou le port de destination n'est pas valide."); return false; }
        if (retentionDays is < 7 or > 365) { Toast.Error("La conservation doit être comprise entre 7 et 365 jours."); return false; }
        if (reminderDays is < 1 or > 14) { Toast.Error("Le rappel doit partir entre 1 et 14 jours avant la fin de l'essai."); return false; }
        if (codes.Any(c => c.Days is < 1 or > 365)) { Toast.Error("La durée d'un code doit être comprise entre 1 et 365 jours."); return false; }
        var stripeEncrypted = stripeKey.Trim() == "" ? null : Box.Protect(stripeKey.Trim());
        var encrypted = smtpPassword == "" ? null : Box.Protect(smtpPassword);
        var npmEncrypted = npmPassword == "" ? null : Box.Protect(npmPassword);
        Root.Write(d =>
        {
            var p = d.Platform;
            p.TrialDays = trialDays; p.VerifyLinkHours = linkHours; p.PurgeUnverifiedDays = purgeDays;
            p.TrialPlan = trialPlan; p.RetentionDays = retentionDays; p.TrialReminderDays = reminderDays; p.MailFirstSteps = mailFirst; p.MailTips = mailTips;
            // codes : les inscriptions comptées entre-temps sont gardées
            p.TrialCodes = codes.Select(c => new TrialCode { Code = c.Code, Days = c.Days, Active = c.Active, Uses = Math.Max(c.Uses, p.TrialCodes.FirstOrDefault(o => o.Code == c.Code)?.Uses ?? 0) }).ToList();
            if (stripeEncrypted != null) p.StripeSecretKey = stripeEncrypted;
            hasStripeKey = p.StripeSecretKey != "";
            p.PaymentMode = paymentMode == PaymentModes.Stripe && hasStripeKey ? PaymentModes.Stripe : PaymentModes.Simulation;
            paymentMode = p.PaymentMode;
            p.PriceBase = Math.Round(priceBase, 2); p.PriceGrowth = Math.Round(priceGrowth, 2); p.AnnualDiscountPct = annualPct; p.DefaultCommissionPct = commissionPct; p.StripeFeePct = Math.Round(feePct, 2); p.StripeFeeFixed = Math.Round(feeFixed, 2);
            p.BaseDomain = baseDomain; p.SubdomainSeparator = sepChoice; p.NpmUrl = npmUrl.Trim(); p.NpmUser = npmUser.Trim(); p.NpmForwardScheme = npmScheme; p.NpmForwardHost = npmForwardHost.Trim(); p.NpmForwardPort = npmPort;
            if (p.NpmUrl == "") p.NpmPassword = ""; else if (npmEncrypted != null) p.NpmPassword = npmEncrypted;
            hasNpmPassword = p.NpmPassword != "";
            p.SmtpHost = smtpHost.Trim(); p.SmtpPort = smtpPort; p.SmtpSsl = smtpSsl; p.SmtpUser = smtpUser.Trim(); p.SmtpFrom = smtpFrom.Trim();
            if (p.SmtpHost == "") p.SmtpPassword = ""; else if (encrypted != null) p.SmtpPassword = encrypted;
            hasPassword = p.SmtpPassword != "";
        });
        smtpPassword = ""; npmPassword = ""; stripeKey = ""; npmReady = Npm.Configured;
        if (toast) Toast.Ok("Réglages de la plateforme enregistrés.");
        return true;
    }

    private async Task TestNpm()
    {
        if (!SaveCore(false)) return;
        testing = true; npmTest = "Connexion en cours…"; npmTestOk = true; StateHasChanged();
        (npmTestOk, npmTest) = await Npm.Test();
        testing = false;
    }

    private async Task SendTest()
    {
        if (!SaveCore(false)) return;
        var email = testTo.Trim();
        if (!System.Net.Mail.MailAddress.TryCreate(email, out _)) { Toast.Error("Indiquez l'adresse qui doit recevoir l'e-mail de test."); return; }
        sending = true; StateHasChanged();
        var err = await Mail.Send(email, "Test d'envoi Linkii", "<p>Cet e-mail confirme que l'envoi depuis Linkii fonctionne.</p>", "Cet e-mail confirme que l'envoi depuis Linkii fonctionne.");
        sending = false;
        if (err == null) Toast.Ok($"Réglages enregistrés. E-mail de test envoyé à {email}."); else Toast.Error($"Réglages enregistrés, mais l'envoi a échoué : {err}.");
    }
}
