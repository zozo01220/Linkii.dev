        annualPct, commissionPct, priceBase, priceGrowth, feePct, feeFixed, trialPlan, paymentMode, stripeKey, retentionDays, reminderDays, mailFirst, mailTips,
        string.Join(",", codes.Select(c => $"{c.Code}:{c.Days}:{c.Active}")));

