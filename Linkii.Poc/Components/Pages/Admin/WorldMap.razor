@using Microsoft.JSInterop
@inject JsonStore Root
@inject IWebHostEnvironment Env
@inject IJSRuntime JS

@* Carte du monde des écrans (super-administrateur). Une pastille par pays avec le nombre d'écrans ; clic : détail (en ligne / hors ligne).
   Seul le pays est connu (voir Geo) ; les écrans qui ont désactivé leur localisation n'y figurent pas.
   Zoom et déplacement (molette, pavé tactile, glisser, pincement) : world-map.js, côté navigateur ; Blazor ne gère que la sélection. *@
<div class="adm-card wm-card">
    @if (pays.Count > 0) { <style>@((MarkupString)(string.Join(",", pays.Select(p => ".wm-land #c-" + p.Code)) + "{fill:#CFE0F1;stroke:#9DB9D6}"))</style> }
    <div class="adm-ct">Écrans dans le monde <span>@located écran@(located > 1 ? "s" : "") · @pays.Count pays · <b class="wm-ok">@totOn en ligne</b> · <b class="wm-ko">@totOff hors ligne</b>@(unlocated > 0 ? $" · {unlocated} non localisé{(unlocated > 1 ? "s" : "")}" : "")</span>
        <div class="sp-seg wm-filter" role="group" aria-label="Filtrer par état">
            <button type="button" class="@(filter == "" ? "on" : "")" @onclick='() => SetFilter("")'>Tous</button>
            <button type="button" class="@(filter == "on" ? "on" : "")" @onclick='() => SetFilter("on")'>En ligne</button>
            <button type="button" class="@(filter == "off" ? "on" : "")" @onclick='() => SetFilter("off")'>Hors ligne</button>
        </div></div>
    <div class="wm-main">
        <div class="wm-map" @ref="mapEl">
            <svg viewBox="0 0 1000 500" role="img" aria-label="Carte du monde des écrans" @onclick="() => Select(null)">
                <g class="wm-land">@((MarkupString)Paths)</g>
                @foreach (var p in pays.Where(p => p.Pin))
                {
                    var sel = selected == p.Code;
                    <g class="wm-pin @(p.Off > 0 ? "off" : "") @(sel ? "sel" : "")" style="transform: translate(@(N(p.X))px, @(N(p.Y))px) scale(var(--s, 1))" @onclick="() => Select(p.Code)" @onclick:stopPropagation="true" role="button" tabindex="0" aria-label="@p.Name : @p.Total écran@(p.Total > 1 ? "s" : "")" @onkeydown="e => Key(e, p.Code)">
                        <circle class="halo" r="11" />
                        <circle class="bg" r="11" />
                        <rect x="-5.5" y="-5" width="11" height="7" rx="1" fill="none" stroke="#fff" stroke-width="1.4" />
                        <path d="M-2.5 5H2.5M0 2V5" stroke="#fff" stroke-width="1.4" fill="none" />
                        <circle class="bd" cx="9" cy="-9" r="6.5" />
                        <text x="9" y="-9">@p.Total</text>
                    </g>
                }
            </svg>
            <div class="wm-zoom"><button type="button" data-wm="in" aria-label="Zoomer">+</button><button type="button" data-wm="out" aria-label="Dézoomer">−</button><button type="button" data-wm="reset" aria-label="Vue monde" title="Vue monde">⌂</button></div>
            <div class="wm-hint">Molette ou pincement pour zoomer · glisser pour déplacer</div>
            @if (pays.FirstOrDefault(p => p.Code == selected) is { } sp)
            {
                <div class="wm-pop" data-x="@N(sp.X)" data-y="@N(sp.Y)" style="left:-999px;top:0" role="dialog" aria-label="@sp.Name">
                    <div class="wm-pop-h"><b>@sp.Name</b><button type="button" class="wm-x" aria-label="Fermer" @onclick="() => Select(null)">✕</button></div>
                    <div class="wm-pop-r"><span>Écrans</span><b>@sp.Total</b></div>
                    <div class="wm-pop-r"><span><i class="dot g"></i>En ligne</span><b>@sp.On</b></div>
                    <div class="wm-pop-r"><span><i class="dot r"></i>Hors ligne</span><b>@sp.Off</b></div>
                    <div class="wm-pop-r"><span>Clients</span><b>@sp.Clients</b></div>
                    @foreach (var sc in sp.Screens.Take(6))
                    {
                        <div class="wm-pop-s"><i class="dot @(sc.On ? "g" : "r")"></i><span>@sc.Name</span><em>@(sc.On ? "En ligne" : "Hors ligne")</em></div>
                    }
                    @if (sp.Screens.Count > 6) { <div class="wm-pop-s wm-more">+ @(sp.Screens.Count - 6) autres écrans</div> }
                </div>
            }
            <div class="wm-legend"><span><i class="dot n"></i>Tous en ligne</span><span><i class="dot r"></i>Au moins un hors ligne</span></div>
        </div>
        <div class="wm-side">
            @foreach (var p in pays)
            {
                <button type="button" class="wm-li @(selected == p.Code ? "sel" : "")" @onclick="() => Pick(p)">
                    <span class="wm-cc">@p.Code</span>
                    <span class="wm-nm">@p.Name<span class="wm-bar"><i style="width:@((int)Math.Round(p.Total * 100.0 / maxTotal))%"></i></span></span>
                    <span class="wm-n @(p.Off > 0 ? "r" : "")" title="@(p.Off > 0 ? p.Off + " hors ligne" : "Tous en ligne")">@p.Total</span>
                </button>
            }
            @if (pays.Count == 0) { <div class="adm-empty">Aucun écran localisé pour le moment. Les écrans se localisent à leur prochaine connexion.</div> }
        </div>
    </div>
</div>

@code {
    private record Pays(string Code, string Name, double X, double Y, bool Pin, int Total, int On, int Clients, List<(string Name, bool On)> Screens)
    {
        public int Off => Total - On;
    }

    private static string? paths;
    private string Paths => paths ??= File.ReadAllText(Path.Combine(Env.WebRootPath, "admin", "world-paths.txt"));

    private List<Pays> pays = new();
    private int located, unlocated, maxTotal = 1, totOn, totOff;
    private string filter = "";   // "", "on" ou "off"
    private void SetFilter(string f) { filter = f; selected = null; Load(); }
    private string? selected;
    private ElementReference mapEl;

    private static string N(double v) => v.ToString("0.##", System.Globalization.CultureInfo.InvariantCulture);

    protected override async Task OnAfterRenderAsync(bool first)
    {
        try
        {
            if (first) await JS.InvokeVoidAsync("wmInit", mapEl);   // zoom et déplacement : world-map.js
            await JS.InvokeVoidAsync("wmPlace", mapEl);              // bulle posée sur son pays
        }
        catch (JSDisconnectedException) { }
    }

    protected override void OnInitialized() => Load();

    private void Load()
    {
        var now = DateTime.UtcNow;
        Root.Read(d =>
        {
            var live = d.Screens.Where(s => s.Token != null && s.GeoMode != Geo.Off).ToList();
            unlocated = live.Count(s => s.GeoCountry == null);
            totOn = live.Count(s => s.GeoCountry != null && ScreenControl.Online(s, now));
            totOff = live.Count(s => s.GeoCountry != null) - totOn;
            pays = live.Where(s => s.GeoCountry != null && (filter == "" || ScreenControl.Online(s, now) == (filter == "on"))).GroupBy(s => s.GeoCountry!).Select(g =>
            {
                var c = WorldGeo.Find(g.Key);
                return new Pays(g.Key, c?.Name ?? g.Key, c?.X ?? 0, c?.Y ?? 0, c != null, g.Count(), g.Count(s => ScreenControl.Online(s, now)), g.Select(s => s.ClientId).Distinct().Count(), g.OrderBy(s => s.Name, StringComparer.CurrentCultureIgnoreCase).Select(s => (string.IsNullOrWhiteSpace(s.Name) ? "Écran" : s.Name, ScreenControl.Online(s, now))).ToList());
            }).OrderByDescending(p => p.Total).ThenBy(p => p.Name, StringComparer.CurrentCultureIgnoreCase).ToList();
            return 0;
        });
        located = pays.Sum(p => p.Total);
        maxTotal = Math.Max(1, pays.Count == 0 ? 1 : pays.Max(p => p.Total));
    }

    private void Key(KeyboardEventArgs e, string code) { if (e.Key is "Enter" or " ") Select(code); }

    private void Select(string? code) => selected = selected == code ? null : code;

    private async Task Pick(Pays p)
    {
        selected = p.Code;
        if (p.Pin) await JS.InvokeVoidAsync("wmFocus", mapEl, p.X, p.Y);   // recentre et zoome sur le pays choisi dans la liste
    }
}
