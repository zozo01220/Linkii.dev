@page "/admin/clients"
@attribute [Microsoft.AspNetCore.Authorization.Authorize(Policy = "PlatformAdmin")]
@inject JsonStore Root
@inject Mailer Mail
@inject ResellerResolver Resolver
@inject NavigationManager Nav
@inject Toaster Toast
@inject Notifier Screens

<div class="page-head">
    <div>
        <h1>Clients<span class="lx-cntpill">@clients.Count</span></h1>
        <p class="sub sc-intro">Gérez les comptes, leurs licences et leur accès. Cliquez sur un client pour ouvrir sa fiche.</p>
    </div>
    <button class="btn" data-fab="Nouveau client" @onclick="Open"><Ico Name="plus" Size="16" /> Nouveau client</button>
</div>

@if (showAdd)
{
    <div class="modal-backdrop" @onclick="Close"></div>
    <div class="modal app-modal" role="dialog" aria-modal="true" aria-labelledby="add-title">
        <div class="modal-head">
            <div class="grow"><h3 id="add-title">Nouveau client</h3></div>
            <button type="button" class="modal-x" aria-label="Fermer" @onclick="Close"><Ico Name="x" Size="20" /></button>
        </div>
        <EditForm Model="this" OnSubmit="Add" class="modal-form">
            <div class="modal-body">
                <div class="form-grid">
                    <div>
                        <label class="lbl">Revendeur</label>
                        <select class="full" @bind="resellerId">
                            @foreach (var r in resellers) { <option value="@r.Id">@r.Name</option> }
                        </select>
                    </div>
                    <div><label class="lbl">Nom du client</label><input class="full" @bind="clientName" placeholder="Ex. : UNIL" /></div>
                    <div><label class="lbl">Administrateur : nom</label><input class="full" @bind="adminName" /></div>
                    <div><label class="lbl">Administrateur : e-mail</label><input class="full" type="email" @bind="adminEmail" autocomplete="off" /></div>
                    <div>
                        <label class="lbl">Mot de passe provisoire <small>(envoyé par e-mail, à changer à la 1re connexion)</small></label>
                        <div class="row" style="gap:6px"><input class="full mono" @bind="adminPwd" autocomplete="off" spellcheck="false" /><button type="button" class="btn ghost" title="Générer un autre mot de passe" @onclick="() => adminPwd = Passwords.Generate()">Générer</button></div>
                    </div>
                </div>
                @if (formError != null) { <div class="err">@formError</div> }
            </div>
            <div class="modal-foot">
                <button type="button" class="btn ghost" @onclick="Close">Annuler</button>
                <button type="submit" class="btn">Créer le client</button>
            </div>
        </EditForm>
    </div>
}

<div class="adm-tabs" role="tablist" aria-label="État du client">
    <button type="button" class="@(state == "" ? "on" : "")" @onclick='() => state = ""'>Tous <b>@clients.Count</b></button>
    @foreach (var s in ClientStates.All)
    {
        var st = s;
        <button type="button" class="@(state == st ? "on" : "")" @onclick="() => state = st">@st <b>@clients.Count(c => c.State == st)</b></button>
    }
</div>

<div class="adm-tools">
    <div class="search-box">
        <Ico Name="search" Size="16" />
        <input placeholder="Rechercher un client, un e-mail, un revendeur…" aria-label="Rechercher" @bind="search" @bind:event="oninput" />
    </div>
    <select @bind="plan" aria-label="Licence">
        <option value="">Toutes les licences</option>
        @foreach (var p in Plans.All) { <option value="@p">@Plans.Label(p)</option> }
    </select>
    <select @bind="source" aria-label="Origine">
        <option value="">Toutes les origines</option>
        @foreach (var s in SignupSources.All) { <option value="@s">@SignupSources.Label(s)</option> }
        <option value="none">Non renseignée</option>
    </select>
</div>

<div class="adm-card" style="padding:0;overflow:hidden">
<div class="tbl-scroll">
<table class="adm-tbl adm-cards">
    <thead><tr><th>Client</th><th>Licence</th><th>Écrans</th><th class="r">Utilisateurs</th><th>État</th><th></th></tr></thead>
    <tbody>
    @foreach (var c in Filtered)
    {
        var row = c;
        <tr class="@(selId == c.Client.Id ? "sel" : "")" @onclick="() => OpenRow(row)">
            <td>
                <div class="adm-who">
                    <div class="adm-av" style="background:@AvatarColor(c.Client.Name)">@Initials(c.Client.Name)</div>
                    <div><b>@c.Client.Name</b><small>@c.Reseller · @c.Owner?.Email</small></div>
                </div>
            </td>
            <td><span class="adm-plan @(c.Client.IsGrowth ? "g" : "")">@Plans.Label(c.Client.Plan)</span></td>
            <td>
                <span class="m">@c.Online</span><span class="adm-sub" style="display:inline"> / @c.Screens</span><span class="u"> écrans</span>
                <div class="adm-bar"><i style="width:@(c.Screens == 0 ? 0 : c.Online * 100 / c.Screens)%;background:@(c.Screens == 0 ? "#C5CED9" : c.Online == c.Screens ? "#1E8E5A" : c.Online > 0 ? "#D79A2B" : "#C8372D")"></i></div>
            </td>
            <td class="r m">@c.Users.Total<span class="u"> utilisateur@(c.Users.Total > 1 ? "s" : "")</span></td>
            <td class="st"><span class="adm-st @ClientStates.Css(c.State)">@c.State@(c.State == ClientStates.Trial ? $" · {c.Client.TrialDaysLeft(now)} j" : "")</span></td>
            <td class="r"><Ico Name="chevron-right" Size="16" /></td>
        </tr>
    }
    @if (!Filtered.Any()) { <tr><td colspan="6" style="text-align:center;color:var(--muted);padding:32px">@(clients.Count == 0 ? "Aucun client pour l'instant." : "Aucun client ne correspond à ces critères.")</td></tr> }
    </tbody>
</table>
</div>
</div>
<div class="adm-foot"><span>@Filtered.Count() client@(Filtered.Count() > 1 ? "s" : "") affiché@(Filtered.Count() > 1 ? "s" : "")</span><span>Entrer dans un espace est journalisé.</span></div>

@if (Sel is { } c0)
{
    var o = c0.Owner;
    <div class="adm-veil" @onclick="CloseDrawer"></div>
    <aside class="adm-drawer" role="dialog" aria-label="Fiche de @c0.Client.Name">
        <div class="dh">
            <div class="top">
                <div class="adm-av lg" style="background:@AvatarColor(c0.Client.Name)">@Initials(c0.Client.Name)</div>
                <div class="grow"><h2>@c0.Client.Name</h2><span class="adm-st @ClientStates.Css(c0.State)">@c0.State</span></div>
                <button type="button" class="btn ghost icon" aria-label="Fermer" @onclick="CloseDrawer"><Ico Name="x" Size="18" /></button>
            </div>
            <div class="adm-tabs" style="margin:16px 0 0">
                @foreach (var t in DrawerTabs)
                {
                    var tt = t;
                    <button type="button" class="@(tab == tt ? "on" : "")" @onclick="() => tab = tt">@tt</button>
                }
            </div>
        </div>
        <div class="db">
        @if (tab == "Aperçu")
        {
            <div class="adm-kv">
                <div><span>Écrans</span><b>@c0.Online<small>/@c0.Screens</small></b></div>
                <div><span>Utilisateurs</span><b>@c0.Users.Total</b></div>
                <div><span>Licence</span><b style="font-size:16px;padding-top:3px">@Plans.Label(c0.Client.Plan)</b></div>
            </div>

            <div class="adm-sec">
                <span class="lb">Licence</span>
                <div class="adm-seg">
                    @foreach (var p in Plans.All)
                    {
                        var pp = p;
                        <button type="button" class="@(c0.Client.Plan == pp ? "on" : "")" @onclick="() => SetPlan(c0.Client, pp)">@Plans.Label(pp)</button>
                    }
                </div>
                <div class="adm-note" style="margin-top:6px">@(c0.Client.IsGrowth ? "Growth : contrôle du direct, supervision, murs d'écrans et statistiques en plus." : "Base : playlists, médiathèque, planning et intégrations.") Le changement est immédiat.</div>
            </div>

            @if (c0.Client.TrialEndsUtc is { } end)
            {
                <div class="adm-sec">
                    <span class="lb">Essai gratuit</span>
                    <div class="adm-note">@(c0.Client.TrialEnded(now) ? $"Terminé le {Day(end)} : les écrans affichent « Essai terminé »." : $"{c0.Client.TrialDaysLeft(now)} j restants, jusqu'au {Day(end)}.")</div>
                    <div class="adm-acts">
                        @foreach (var d in new[] { 7, 14, 30 }) { var dd = d; <button type="button" class="btn ghost sm" @onclick="() => Extend(c0, dd)">+@dd j</button> }
                        <button type="button" class="btn ghost sm" @onclick="() => EndTrial(c0)">Passer en abonné</button>
                    </div>
                </div>
            }

            <div class="adm-sec">
                <span class="lb">Accès</span>
                <div class="adm-note">@StateNote(c0)</div>
                <div class="adm-acts">
                    @if (c0.State == ClientStates.Pending && o != null)
                    {
                        <button type="button" class="btn ok-o sm" @onclick="() => ValidateNow(c0)"><Ico Name="check" Size="15" /> Valider le compte</button>
                        @if (o.AwaitsVerification) { <button type="button" class="btn ghost sm" @onclick="() => ResendLink(c0)"><Ico Name="mail-send" Size="15" /> Renvoyer le lien</button> }
                    }
                    @if (c0.Client.Blocked)
                    {
                        <button type="button" class="btn ok-o sm" @onclick="() => SetAccess(c0, false, false)"><Ico Name="play" Size="15" /> Débloquer</button>
                    }
                    else
                    {
                        @if (c0.Client.Suspended) { <button type="button" class="btn ok-o sm" @onclick="() => SetAccess(c0, false, false)"><Ico Name="play" Size="15" /> Réactiver</button> }
                        else { <button type="button" class="btn warn-o sm" @onclick="() => SetAccess(c0, true, false)"><Ico Name="pause" Size="15" /> Suspendre</button> }
                        <button type="button" class="btn danger sm" @onclick="() => SetAccess(c0, false, true)"><Ico Name="lock" Size="15" /> Bloquer</button>
                    }
                </div>
                <div class="adm-note" style="margin-top:8px">Suspendre coupe les écrans, le back-office reste accessible. Bloquer ferme aussi le back-office.</div>
            </div>

            <div class="adm-sec">
                <span class="lb">Informations</span>
                <div class="adm-ln"><span>Administrateur</span><span>@(o?.Name) <span class="adm-sub">@o?.Email</span></span></div>
                <div class="adm-ln"><span>Revendeur</span><span>@c0.Reseller</span></div>
                <div class="adm-ln"><span>Origine</span><span>@SignupSources.Label(c0.Client.SignupSource)</span></div>
                <div class="adm-ln"><span>Créé le</span><span>@Day(c0.Client.CreatedUtc) <span class="adm-sub">@Ago(c0.Client.CreatedUtc)</span></span></div>
                <div class="adm-ln"><span>Adresse e-mail</span><span>@(Signup.IsVerified(o) ? $"validée le {o!.EmailVerifiedUtc!.Value.ToLocalTime().ToString("d MMM", Fr)}" : "à valider")</span></div>
                <div class="adm-ln"><span>E-mails</span><span>@(o?.MarketingOptIn == true ? "✓" : "—") offres · @(o?.NewsOptIn == true ? "✓" : "—") nouveautés</span></div>
            </div>

            <div class="adm-danger">
                <div><b>Supprimer le client</b><small>Écrans, médias et utilisateurs sont effacés.</small></div>
                <button type="button" class="btn danger sm" @onclick="() => deleteOf = c0"><Ico Name="trash" Size="15" /> Supprimer</button>
            </div>
        }
        else if (tab == "Écrans")
        {
            <div style="margin-top:14px">
            @foreach (var s in drawerScreens)
            {
                <div class="adm-ln">
                    <span style="color:var(--ink)"><span class="adm-dot" style="background:@(s.Status == "Hors ligne" ? "#C8372D" : s.Status == "En ligne" ? "#1E8E5A" : "#D79A2B");margin-right:8px"></span>@s.Name<span class="adm-sub">@s.Detail</span></span>
                    <span>@s.Status</span>
                </div>
            }
            @if (drawerScreens.Count == 0) { <div class="adm-empty">Aucun écran appairé.</div> }
            </div>
        }
        else if (tab == "Utilisateurs")
        {
            <div class="adm-note" style="margin-top:14px">@c0.Users.Breakdown · @c0.Users.Active30 actif@(c0.Users.Active30 > 1 ? "s" : "") sur 30 jours · @c0.Users.Areas aire@(c0.Users.Areas > 1 ? "s" : "") de gestion</div>
            @foreach (var u in clientUsers)
            {
                <div class="adm-ln">
                    <span style="color:var(--ink)">@u.Label<span class="adm-sub">@u.Email</span></span>
                    <span>@(u.Role == Roles.ClientAdmin ? "Administrateur" : clientLevels.FirstOrDefault(l => l.Id == u.LevelId)?.Name ?? "Aucun niveau")
                        <span class="adm-sub">@(u.Disabled ? "désactivé" : u.IsInvited ? "invité" : (u.LastActiveUtc ?? u.LastLoginUtc)?.ToLocalTime().ToString("d MMM yyyy HH:mm") ?? "jamais connecté")</span></span>
                </div>
            }
        }
        else
        {
            <div style="margin-top:14px">
            @foreach (var l in drawerLog)
            {
                <div class="adm-ln"><span style="color:var(--ink)">@(l.Action == "enter" ? "Entrée dans l'espace" : "Sortie de l'espace")<span class="adm-sub">@l.UserEmail (@l.Role)</span></span><span>@l.AtUtc.ToLocalTime().ToString("d MMM yyyy HH:mm")</span></div>
            }
            @if (drawerLog.Count == 0) { <div class="adm-empty">Aucun accès enregistré par l'équipe.</div> }
            </div>
        }
        </div>
        <div class="df">
            <form method="post" action="/space/enter"><input type="hidden" name="clientId" value="@c0.Client.Id" /><button class="btn" type="submit"><Ico Name="logout" Size="16" /> Entrer dans l'espace</button></form>
        </div>
    </aside>
}

@if (deleteOf is { } del)
{
    <div class="modal-backdrop" style="z-index:110" @onclick="() => deleteOf = null"></div>
    <div class="modal app-modal sm" style="z-index:111" role="dialog" aria-modal="true" aria-labelledby="del-title">
        <div class="modal-head">
            <div class="grow"><h3 id="del-title">Supprimer « @del.Client.Name » ?</h3></div>
            <button type="button" class="modal-x" aria-label="Fermer" @onclick="() => deleteOf = null"><Ico Name="x" Size="20" /></button>
        </div>
        <div class="modal-body">
            <p>Cette action est <b>définitive</b> : les @del.Users.Total utilisateur@(del.Users.Total > 1 ? "s" : ""), les @del.Screens écran@(del.Screens > 1 ? "s" : "") connecté@(del.Screens > 1 ? "s" : ""), les listes de lecture, les contenus et les fichiers de la médiathèque sont effacés. Les écrans cesseront d'afficher leur contenu.</p>
            <label class="lbl">Tapez le nom du client pour confirmer</label>
            <input class="full" @bind="deleteConfirm" @bind:event="oninput" placeholder="@del.Client.Name" autocomplete="off" />
        </div>
        <div class="modal-foot">
            <button type="button" class="btn ghost" @onclick="() => deleteOf = null">Annuler</button>
            <button type="button" class="btn danger-solid" disabled="@(!string.Equals(deleteConfirm.Trim(), del.Client.Name, StringComparison.OrdinalIgnoreCase))" @onclick="() => Delete(del)">Supprimer définitivement</button>
        </div>
    </div>
}

@code {
    private record Row(Tenant Client, string Reseller, int Screens, int Online, UserStats Users, User? Owner, string State);
    private record ScreenLine(string Name, string Status, string Detail);

    [SupplyParameterFromQuery(Name = "etat")] public string? EtatParam { get; set; }
    [SupplyParameterFromQuery(Name = "nouveau")] public string? NouveauParam { get; set; }

    private static readonly System.Globalization.CultureInfo Fr = new("fr-CH");
    private static readonly string[] DrawerTabs = { "Aperçu", "Écrans", "Utilisateurs", "Activité" };
    private static readonly string[] Palette = { "#2F6FB5", "#1E8E5A", "#B7791F", "#7A5CC0", "#C0392B", "#2A8A99", "#5A6B80" };

    private List<Row> clients = new();
    private List<Reseller> resellers = new();
    private string state = "", plan = "", source = "", search = "";
    private DateTime now = DateTime.UtcNow;
    private int trialDays = 7, purgeDays = 7;

    // Fiche ouverte
    private Guid? selId;
    private string tab = "Aperçu";
    private List<ScreenLine> drawerScreens = new();
    private List<User> clientUsers = new();
    private List<AccessLevel> clientLevels = new();
    private List<AccessLogEntry> drawerLog = new();
    private Row? Sel => selId is { } id ? clients.FirstOrDefault(c => c.Client.Id == id) : null;

    private Row? deleteOf { get => _deleteOf; set { _deleteOf = value; deleteConfirm = ""; } }
    private Row? _deleteOf;
    private string deleteConfirm = "";

    private bool showAdd;
    private Guid resellerId;
    private string clientName = "", adminName = "", adminEmail = "", adminPwd = "";
    private string? formError;

    private IEnumerable<Row> Filtered => clients.Where(c => (state == "" || c.State == state)
        && (plan == "" || c.Client.Plan == plan)
        && (source == "" || (source == "none" ? c.Client.SignupSource == null : c.Client.SignupSource == source))
        && (search.Trim() is not { Length: > 0 } q || c.Client.Name.Contains(q, StringComparison.OrdinalIgnoreCase)
            || c.Owner?.Email.Contains(q, StringComparison.OrdinalIgnoreCase) == true || c.Reseller.Contains(q, StringComparison.OrdinalIgnoreCase)))
        .OrderByDescending(c => c.Client.CreatedUtc);

    private static string Initials(string n) => string.Concat(n.Split(' ', StringSplitOptions.RemoveEmptyEntries).Take(2).Select(w => char.ToUpperInvariant(w[0])));
    private static string AvatarColor(string n) => Palette[Math.Abs(n.Aggregate(0, (h, ch) => h * 31 + ch)) % Palette.Length];
    private static string Day(DateTime utc) => utc.ToLocalTime().ToString("d MMM yyyy", Fr);
    private string Ago(DateTime utc)
    {
        var d = now - utc;
        return d.TotalHours < 1 ? "il y a < 1 h" : d.TotalDays < 1 ? $"il y a {(int)d.TotalHours} h" : $"il y a {(int)d.TotalDays} j";
    }

    private string StateNote(Row r) => r.State switch
    {
        ClientStates.Blocked => "Écrans coupés et back-office fermé aux membres.",
        ClientStates.Suspended => "Écrans coupés. Le back-office reste accessible.",
        ClientStates.Pending => r.Owner?.AwaitsVerification == true
            ? $"En attente de la confirmation de l'adresse. Suppression automatique dans {PurgeIn(r.Owner)} j."
            : "Première connexion attendue.",
        ClientStates.Ended => "Essai terminé : les écrans affichent « Essai terminé ».",
        _ => "Accès complet."
    };

    private int PurgeIn(User u) => Math.Max(0, (int)Math.Ceiling(((u.CreatedUtc ?? now).AddDays(purgeDays) - now).TotalDays));

    protected override void OnInitialized() { Load(); resellerId = resellers.FirstOrDefault()?.Id ?? Guid.Empty; }

    protected override void OnParametersSet()
    {
        if (EtatParam != null && ClientStates.All.Contains(EtatParam)) state = EtatParam;
        if (NouveauParam == "1" && !showAdd) Open();
    }

    private void Load()
    {
        resellers = Root.Read(d => d.Resellers.Where(r => r.Active).OrderBy(r => r.Name).ToList());
        now = DateTime.UtcNow;
        (trialDays, purgeDays) = Root.Read(d => (d.Platform.TrialDays, d.Platform.PurgeUnverifiedDays));
        clients = Root.Read(d => d.Clients.OrderBy(c => c.Name).Select(c =>
        {
            var owner = Signup.OwnerOf(d, c);
            var scr = d.Screens.Where(s => s.ClientId == c.Id && s.Token != null).ToList();
            return new Row(c, d.Resellers.FirstOrDefault(r => r.Id == c.ResellerId)?.Name ?? "?", scr.Count,
                scr.Count(s => s.LastSeenUtc is { } ls && now - ls <= TimeSpan.FromSeconds(90)), UserStats.Of(d, c), owner, ClientStates.Of(c, owner, now));
        }).ToList());
        if (selId != null) LoadDrawer();
    }

    // Écrans, utilisateurs et accès de la fiche ouverte (lecture seule).
    private void LoadDrawer()
    {
        var id = selId!.Value;
        (drawerScreens, clientUsers, clientLevels, drawerLog) = Root.Read(d =>
        {
            var c = d.Clients.FirstOrDefault(x => x.Id == id);
            if (c == null) return (new List<ScreenLine>(), new List<User>(), new List<AccessLevel>(), new List<AccessLogEntry>());
            var r = d.Resellers.FirstOrDefault(x => x.Id == c.ResellerId);
            var screens = d.Screens.Where(s => s.ClientId == id && s.Token != null).OrderBy(s => s.Name).Select(s =>
            {
                var status = Helpers.Status(s, d.Playlists.FirstOrDefault(p => p.Id == s.PlaylistId && p.ClientId == id), c, r, Helpers.SyncStamp(d.Areas, s));
                var seen = s.LastSeenUtc is { } ls ? "vu " + Ago(ls) : "jamais vu";
                return new ScreenLine(s.Name, status, (s.DetectedW is { } w ? $"{w}×{s.DetectedH} · " : "") + seen);
            }).ToList();
            var users = d.Users.Where(u => u.ClientId == id && Roles.IsClient(u.Role)).OrderBy(u => u.Role == Roles.ClientAdmin ? 0 : 1).ThenBy(u => u.Name).ToList();
            return (screens, users, c.Levels.ToList(), d.AccessLog.Where(l => l.ClientId == id).OrderByDescending(l => l.AtUtc).Take(30).ToList());
        });
    }

    private void OpenRow(Row r) { selId = r.Client.Id; tab = "Aperçu"; LoadDrawer(); }
    private void CloseDrawer() { selId = null; }

    // ---------- Création ----------

    private void Open() { formError = null; adminPwd = Passwords.Generate(); showAdd = true; }
    private void Close() { showAdd = false; if (NouveauParam != null) Nav.NavigateTo("admin/clients", replace: true); }

    // Le compte est créé avec un mot de passe provisoire, envoyé par e-mail ; il devra être changé à la première connexion.
    private async Task Add()
    {
        formError = null;
        Reseller? reseller = null;
        var err = Root.Write(d =>
        {
            reseller = d.Resellers.FirstOrDefault(x => x.Id == resellerId);
            if (reseller == null) return "Choisissez un revendeur.";
            return Tenancy.CreateClient(d, reseller, clientName, adminName, adminEmail, adminPwd, mustChangePassword: true, source: SignupSources.Console).Error;
        });
        if (err != null) { formError = err; return; }
        var (name, person, email, pwd) = (clientName.Trim(), adminName, adminEmail.Trim().ToLowerInvariant(), adminPwd);
        clientName = adminName = adminEmail = adminPwd = ""; showAdd = false;
        Load();
        var mailErr = await Mail.SendWelcome(reseller!, Resolver.LoginUrl(reseller!, Nav.BaseUri), $"Votre espace « {name} » est prêt.", person, email, pwd);
        if (mailErr == null) Toast.Ok($"Client « {name} » créé. Ses identifiants ont été envoyés à {email}.");
        else Toast.Error($"Client « {name} » créé, mais l'e-mail n'a pas pu être envoyé : {mailErr}. Communiquez vous-même le mot de passe provisoire à {email} : {pwd}");
    }

    // ---------- Licence, accès ----------

    private async Task SetPlan(Tenant c, string plan)
    {
        if (plan is not (Plans.Base or Plans.Growth) || c.Plan == plan) return;
        Root.Write(d => { d.Clients.First(y => y.Id == c.Id).Plan = plan; });
        Load();
        await Screens.NotifyClient(c.Id);
        Toast.Ok($"Licence « {Plans.Label(plan)} » pour {c.Name}.");
    }

    // Suspendu : écrans coupés, back-office ouvert. Bloqué : écrans coupés et back-office fermé. Les deux s'excluent.
    private async Task SetAccess(Row r, bool suspended, bool blocked)
    {
        Root.Write(d => { var x = d.Clients.First(y => y.Id == r.Client.Id); x.Suspended = suspended; x.Blocked = blocked; x.BlockedReason = ""; });
        Load();
        await Screens.NotifyClient(r.Client.Id);
        Toast.Ok(blocked ? $"« {r.Client.Name} » est bloqué : écrans coupés et back-office fermé."
            : suspended ? $"« {r.Client.Name} » est suspendu : écrans coupés."
            : $"« {r.Client.Name} » est de nouveau actif.");
    }

    // ---------- Validation et essai ----------

    private async Task Extend(Row r, int days)
    {
        Root.Write(d => { if (d.Clients.FirstOrDefault(c => c.Id == r.Client.Id) is { } c) Signup.Extend(c, days, DateTime.UtcNow); });
        Load();
        await Screens.NotifyClient(r.Client.Id);   // écrans en « Essai terminé » : la diffusion reprend
        Toast.Ok($"Essai de « {r.Client.Name} » prolongé de {days} jours.");
    }

    private async Task EndTrial(Row r)
    {
        Root.Write(d => { if (d.Clients.FirstOrDefault(c => c.Id == r.Client.Id) is { } c) { c.TrialEndsUtc = null; c.TrialReminderSentUtc = null; c.TrialEndedNotifiedUtc = null; } });
        Load();
        await Screens.NotifyClient(r.Client.Id);
        Toast.Ok($"« {r.Client.Name} » n'est plus en essai : abonné.");
    }

    private string AppBase(Guid resellerId)
    {
        var r = Root.Read(d => d.Resellers.First(x => x.Id == resellerId));
        return Resolver.LoginUrl(r, Nav.BaseUri)[..^"login".Length];
    }

    private async Task ResendLink(Row r)
    {
        var nowUtc = DateTime.UtcNow;
        var (token, reseller, hours) = Root.Write(d =>
        {
            var u = d.Users.FirstOrDefault(x => x.Id == r.Owner!.Id);
            return u is { AwaitsVerification: true } ? (Signup.NewToken(u, d.Platform.VerifyLinkHours, nowUtc), d.Resellers.First(x => x.Id == r.Client.ResellerId), d.Platform.VerifyLinkHours) : (null, null, 0);
        });
        if (token == null) { Load(); return; }
        var link = AppBase(r.Client.ResellerId) + "login/verify/confirm?t=" + Uri.EscapeDataString(token);
        var err = await Mail.SendVerification(reseller!, link, r.Owner!.Name, r.Owner.Email, r.Client.Name, hours);
        Load();
        if (err == null) Toast.Ok($"Nouveau lien de confirmation envoyé à {r.Owner.Email}.");
        else Toast.Error($"Le lien n'a pas pu être envoyé : {err}.");
    }

    // Adresse vérifiée par l'équipe Linkii (ex. confirmée par téléphone) : l'essai démarre et l'e-mail de bienvenue part.
    private async Task ValidateNow(Row r)
    {
        var nowUtc = DateTime.UtcNow;
        var (user, client, reseller) = Root.Write(d =>
        {
            var u = d.Users.First(x => x.Id == r.Owner!.Id);
            var c = d.Clients.First(x => x.Id == r.Client.Id);
            Signup.Verify(d, u, c, nowUtc);
            return (u, c, d.Resellers.First(x => x.Id == c.ResellerId));
        });
        Load();
        if (!SignupSources.IsSelfService(client.SignupSource) || user.WelcomeSentUtc != null) { Toast.Ok($"Compte de « {client.Name} » validé."); return; }
        var err = await Mail.SendSignupWelcome(reseller, AppBase(reseller.Id), user.Name, user.Email, client.Name, trialDays,
            client.TrialEndsUtc is { } end ? Signup.Day(client, end) : null, Signup.SignInHint(user));
        if (err == null) { Root.Write(d => { if (d.Users.FirstOrDefault(u => u.Id == user.Id) is { } u) u.WelcomeSentUtc = DateTime.UtcNow; }); Toast.Ok($"Compte de « {client.Name} » validé. L'e-mail de bienvenue a été envoyé."); }
        else Toast.Error($"Compte validé, mais l'e-mail de bienvenue n'a pas pu être envoyé : {err}.");
    }

    // ---------- Suppression ----------

    private async Task Delete(Row r)
    {
        if (!string.Equals(deleteConfirm.Trim(), r.Client.Name, StringComparison.OrdinalIgnoreCase)) return;
        await Screens.NotifyClient(r.Client.Id);   // les écrans sont prévenus avant que l'organisation disparaisse
        var files = Root.Write(d => Signup.RemoveClient(d, r.Client.Id));
        foreach (var f in files) try { File.Delete(Path.Combine(AppPaths.MediaDir, Path.GetFileName(f))); } catch (IOException) { }
        deleteOf = null; selId = null;
        Load();
        Toast.Ok($"Client « {r.Client.Name} » supprimé.");
    }
}
