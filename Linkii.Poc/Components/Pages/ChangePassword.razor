@page "/login/password"
@layout AuthLayout
@using System.Security.Claims
@inject JsonStore Store
@inject NavigationManager Nav

@* Première connexion avec un mot de passe provisoire (reçu par e-mail) : le compte doit d'abord choisir le sien.
   Sous /login : rendu statique, et seule page accessible tant que le mot de passe n'est pas changé. *@
<PageTitle>@(Host?.DisplayName ?? "Linkii") · Nouveau mot de passe</PageTitle>

<h1>Choisissez votre mot de passe</h1>
<p class="lead">Vous vous êtes connecté avec un mot de passe provisoire. Remplacez-le par un mot de passe personnel pour accéder à votre espace.</p>

<EditForm Model="Form" FormName="change-password" OnValidSubmit="Save" method="post" class="auth-form">
    <label>Nouveau mot de passe <small>(8 caractères minimum)</small></label>
    <InputText @bind-Value="Form!.Password" type="password" autocomplete="new-password" />
    <label>Confirmez le mot de passe</label>
    <InputText @bind-Value="Form.Confirm" type="password" autocomplete="new-password" />
    @if (error != null) { <div class="err">@error</div> }
    <button class="btn" type="submit">Enregistrer et continuer</button>
</EditForm>
<form method="post" action="/logout" class="auth-alt"><button type="submit" class="linkish">Se déconnecter</button></form>

@code {
    [CascadingParameter] private HttpContext? Http { get; set; }
    [SupplyParameterFromForm(FormName = "change-password")] private PasswordModel? Form { get; set; }

    private Reseller? Host => Http?.Items["reseller"] as Reseller;
    private string? error;

    public class PasswordModel
    {
        public string Password { get; set; } = "";
        public string Confirm { get; set; } = "";
    }

    private Guid? UserId => Guid.TryParse(Http?.User.FindFirst(ClaimTypes.NameIdentifier)?.Value, out var id) ? id : null;

    protected override void OnInitialized()
    {
        Form ??= new();
        if (Http?.User.Identity?.IsAuthenticated != true) { Nav.NavigateTo("/login", forceLoad: true); return; }
        // déjà fait (ou rien à faire) : retour à l'espace
        var uid = UserId;
        if (HttpMethods.IsGet(Http.Request.Method) && !Store.Read(d => d.Users.FirstOrDefault(u => u.Id == uid)?.MustChangePassword == true))
            Nav.NavigateTo(Claims.Home(Http.User), forceLoad: true);
    }

    private void Save()
    {
        error = null;
        var pwd = Form!.Password;
        if (pwd.Length < 8) { error = "Le mot de passe est trop court (8 caractères minimum)."; return; }
        if (pwd != Form.Confirm) { error = "Les deux mots de passe ne correspondent pas."; return; }
        var uid = UserId;
        var res = Store.Write(d =>
        {
            var u = d.Users.FirstOrDefault(x => x.Id == uid);
            if (u == null) return "Compte introuvable.";
            if (Passwords.Verify(u.PasswordHash, pwd)) return "Choisissez un mot de passe différent du mot de passe provisoire.";
            u.PasswordHash = Passwords.Hash(pwd);
            u.MustChangePassword = false;
            return null;
        });
        if (res != null) { error = res; return; }
        Nav.NavigateTo(Claims.Home(Http!.User), forceLoad: true);
    }
}
