@page "/stats/publicite/releve/{Month}"
@attribute [Microsoft.AspNetCore.Authorization.Authorize(Policy = "ClientSpace")]
@inject TenantStore Store

@* Relevé mensuel des revenus publicitaires de l'organisation (Statistiques › Publicité › Relevé). *@
<AdStatementDoc ClientId="Store.ClientId" Month="@Month" Back="/stats?tab=pub" BackLabel="Statistiques" />

@code {
    [Parameter] public string Month { get; set; } = "";
}
