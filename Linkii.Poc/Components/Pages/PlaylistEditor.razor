        mItem = null; mPlaylist = null; mMedia = null; mPlacement = "full";
        mTab = "content"; mQrOn = false; mQrCode = null; mQrUrl = ""; mQrLabel = "";
        mFormat = null;
        mQrSize = QrTracking.DefaultSize; (mQrX, mQrY) = (QrTracking.DefaultX, QrTracking.DefaultY);
    }

