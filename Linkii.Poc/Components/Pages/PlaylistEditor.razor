    // ---------- Carte du fil (§186) : carrée, image pleine carte ; numéro, type, nom, durée toujours visibles ; au survol Régler et Supprimer ----------
    private RenderFragment Card(FlowRow r) =>
        @<text><span class="pfx-num">@r.Num</span>
