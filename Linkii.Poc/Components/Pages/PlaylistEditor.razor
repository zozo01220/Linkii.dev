    // Durée modifiée sur place : « m:ss » ou un nombre de secondes ; une app « jusqu'à la fin » passe en durée fixe
    private PlaylistItem? durFor;
    private string durValue = "";
    private ElementReference durInput;
    private bool focusDur;

    private void StartDur(PlaylistItem it)
    {
        durFor = it; focusDur = true;
        var m = media.FirstOrDefault(x => x.Id == it.MediaId);
        durValue = Helpers.FormatDuration(Helpers.ItemSeconds(it, m, Svc.Find(m?.AppId), media));
    }

    private void DurKey(KeyboardEventArgs e)
    {
        if (e.Key == "Enter") SaveDur();
        else if (e.Key == "Escape") durFor = null;
        else if (e.Key is "ArrowUp" or "ArrowDown" && ParseDuration(durValue) is { } s)   // une seconde de plus ou de moins
            durValue = Helpers.FormatDuration(Math.Clamp(s + (e.Key == "ArrowUp" ? 1 : -1), 1, 86400));
    }

    private static int? ParseDuration(string s)
    {
        s = s.Trim();
        var parts = s.Split(':');
        if (parts.Length == 1 && int.TryParse(parts[0], out var sec)) return sec;
        if (parts.Length == 2 && int.TryParse(parts[0], out var mm) && int.TryParse(parts[1], out var ss) && ss is >= 0 and < 60) return mm * 60 + ss;
        if (parts.Length == 3 && int.TryParse(parts[0], out var hh) && int.TryParse(parts[1], out var m2) && int.TryParse(parts[2], out var s2) && m2 is >= 0 and < 60 && s2 is >= 0 and < 60) return hh * 3600 + m2 * 60 + s2;
        return null;
    }

    private void SaveDur()
    {
        if (durFor is not { } it || Current is not { } pl) return;
        durFor = null;
        if (ParseDuration(durValue) is not { } secs || secs < 1 || secs > 86400) { Toast.Error("Durée invalide : saisissez par exemple 0:08, 1:30 ou 45 (entre 1 seconde et 24 heures)."); return; }
        var content = ContentDuration(media.FirstOrDefault(x => x.Id == it.MediaId));
        WriteList(d =>
        {
            it.DurationSec = secs;
            if (content) it.DurationMode = "fixed";
            pl.Touch();
        });
        Reload();
    }

    private void PickAppWithForm(AppManifest app)
    {
        newApp = app; newName = null;
