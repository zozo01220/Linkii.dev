    /// <summary>Une ligne du fil : place dans la boucle (numéro, départ), durée et couleur de l'app.</summary>
    private sealed record FlowRow(int Index, PlaylistItem It, MediaItem? M, bool Masked, bool Incomplete, bool Plays, int Seconds, int Start, string Num, string When, string Color, string? AppId, (string Css, string Text)? Chip, bool Hold);

    private List<FlowRow> Rows(Playlist pl)
    {
        var rows = new List<FlowRow>();
        int t = 0, n = 0;
        var now = ContentWindow.NowIso(zone);   // heure de l'organisation : une période en cours ou passée se lit à cet instant
        for (var i = 0; i < pl.Draft.Count; i++)
        {
            var it = pl.Draft[i];
            var m = media.FirstOrDefault(x => x.Id == it.MediaId);
            var incomplete = Svc.IsIncomplete(m);
            var inWindow = ContentWindow.Plays(it.StartsAt, it.EndsAt, now);   // hors période : pas dans la boucle ce tour-ci
            var plays = !it.Off && it.Placement == "full" && m != null && !incomplete && inWindow;   // ajouté à vide : pas encore diffusé
            var secs = plays ? Helpers.ItemSeconds(it, m, Svc.Find(m?.AppId), media) : 0;
            // sous le numéro : l'heure de départ dans la boucle ; un contenu qui n'y passe pas n'a pas d'heure (la raison est dans sa ligne)
            var when = it.Off ? "ignoré" : plays ? Helpers.FormatDuration(t) : "";
            var look = LookId(m);
            rows.Add(new(i, it, m, MediaLibrary.UsesHidden(m, hidden), incomplete, plays, secs, t, plays ? (++n).ToString() : "–", when, AppIcon.LookOf(look).Color, look,
                it.Off ? null : ContentWindow.Chip(it.StartsAt, it.EndsAt, now), !it.Off && !inWindow));
            t += secs;
        }
        return rows;
    }

    private static string? LookId(MediaItem? m) => m == null ? null : m.AppId ?? (m.Type == "video" ? "video" : "image");

    private string RowClass(FlowRow r) => (r.It.Id == freshId ? "fresh " : r.Incomplete && !r.Masked ? "todo " : "") + (r.It.Off ? "off " : "") + (r.Hold ? "hold " : "") + (r.Masked ? "masked" : "");

    private bool Draggable(FlowRow r) => !readOnlyHere && durFor != r.It;

