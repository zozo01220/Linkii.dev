@inject TenantStore Store
@inject AppService Svc
@inject CanvaService Canva
@inject IJSRuntime JS
@inject ScanLog Scans
@inject NavigationManager Nav
@inject Toaster Toast
@inject MediaLibrary MediaLib
@inject ModeService Modes
@inject AppCatalog Catalog
@inject ScreenPublisher Publisher
@inject PublishSchedule Sched
@inject AiReview Review
@inject AiService AiSvc
@inject AssistantPanel Panel
@using Microsoft.JSInterop
@implements IDisposable

<YoutubeDurations Items="media" OnUpdated="Refresh" />

@if (Current is { } pl)
{
    var rows = Rows(pl);
    var total = rows.Where(r => r.Plays).Sum(r => r.Seconds);
    var active = pl.Draft.Count(i => !i.Off);
    var air = diff.OnAir;
    var pend = diff.ToUpdate.Count();
    var chosen = diff.Chosen.Count;
    var needs = pend > 0 || chosen > 0;   // une modification à publier : le bouton passe à l'orange
    var pubTip = needs ? $"Publier sur {(chosen > 0 ? chosen : pend)} écran{((chosen > 0 ? chosen : pend) > 1 ? "s" : "")}" : air > 0 ? "À jour : rien à publier" : "Choisir les écrans";
    @* Page d'une liste (maquette maquettes/liste-page-epuree.html) : plus d'onglets. À gauche le titre, trois boutons (aperçu, publier, ⋯) puis une ligne par contenu ;
       à droite la colonne « Ajouter » sur toute la hauteur, dont les contenus se glissent dans la liste. L'aperçu et la publication s'ouvrent en fenêtres. *@
    <div class="lep" @ref="flowRoot">
        <div class="lep-main">
            @if (readOnlyHere)
            {
                <div class="dw-note"><Ico Name="lock" Size="15" /><span class="grow">Cette liste est dans un dossier partagé en <b>lecture seule</b> : vous pouvez la voir et la diffuser, pas la modifier.</span></div>
            }
            <div class="pt-crumb"><a href="playlists" @onclick="Close" @onclick:preventDefault>‹ Listes de diffusion</a></div>
            <header class="le-head">
                <div>
                    <div class="le-title @(readOnlyHere ? "ro" : "")">
                        @if (renaming)
                        {
                            <input class="le-ni le-ni-h" @ref="renameInput" @bind="renameValue" @bind:event="oninput" @onkeydown="e => OnRenameKey(e, pl)" @onblur="() => Rename(pl)" aria-label="Nom de la liste" />
                        }
                        else
                        {
                            <h1 @onclick="() => { if (!readOnlyHere) StartRename(pl); }">@pl.Name</h1>
                            @if (!readOnlyHere) { <button type="button" class="le-ren" title="Renommer" aria-label="Renommer la liste" @onclick="() => StartRename(pl)"><Ico Name="edit" Size="16" /></button> }
                        }
                    </div>
                    <p class="le-meta">
                        <span>@active contenu@(active > 1 ? "s" : "")@(pl.Draft.Count > 0 ? $" · {Helpers.FormatDuration(total)}" : "")</span>
                        @if (air > 0) { <span>·</span><button type="button" class="le-live" title="@(diff.Outside > 0 ? $"Dont {diff.Outside} hors de votre périmètre" : null)" @onclick="OpenPublish">● Diffusée sur @air écran@(air > 1 ? "s" : "")</button> }
                        else { <span>· Non diffusée</span> }
                    </p>
                </div>
            </header>

            @* Relecture de l'IA avant publication (Pro) : bandeau, puis fenêtre « Avant de publier ». Maquette : maquettes/ia-pistes.html *@
            @if (pl.Draft.Count > 0)
            {
                var pending = RevPending(pl);
                @if (revState.Status == AiStatus.NeedsPro && pl.Draft.Any(i => !i.Off))
                {
                    <div class="ai-bar up"><Ico Name="crown" Size="16" /><span>La relecture automatique avant publication est comprise dans le plan Pro.</span><span class="grow"></span><a class="btn ghost sm" href="/settings?tab=abonnement">Voir les plans</a></div>
                }
                else if (revState.Status is AiStatus.Quota or AiStatus.Cap)
                {
                    <div class="ai-bar up"><Ico Name="alert" Size="16" /><span>Relecture de l'IA en pause : @(revState.Trial ? "les demandes de l'essai sont utilisées" : "quota du mois atteint"). Vous pouvez publier normalement.</span></div>
                }
                else if (revState.Available && revBusy && rev == null)
                {
                    <div class="ai-bar run" role="status"><Ico Name="spark" Size="16" /><span>Relecture de la liste en cours</span><span class="ai-dots"><i></i><i></i><i></i></span></div>
                }
                else if (revState.Available && rev is { Ok: true })
                {
                    if (pending.Count > 0)
                    {
                        <div class="ai-bar"><Ico Name="spark" Size="16" /><span><b>Relecture de l'IA :</b> @pending.Count remarque@(pending.Count > 1 ? "s" : "") à regarder avant de publier.</span><span class="grow"></span><button type="button" class="btn ghost sm" @onclick="() => ShowReview(false)"><Ico Name="spark" Size="14" /> Voir dans l'assistant</button></div>
                    }
                    else
                    {
                        <div class="ai-bar ok"><Ico Name="check" Size="16" /><span><b>Relecture de l'IA :</b> rien à signaler.</span></div>
                    }
                }
            }

            @* trois boutons au-dessus de la liste : aperçu, publier (icône seule : blanc si tout est à jour, orange s'il y a une modification), menu ⋯ *@
            <div class="le-bar"><div class="le-act">
                <button type="button" class="le-ib" title="Aperçu" aria-label="Aperçu de la liste" disabled="@(pl.Draft.Count == 0)" @onclick="() => trying = true"><Ico Name="eye" Size="20" /></button>
                <button type="button" class="btn @(needs ? "publish-btn" : "ghost") le-pub" title="@pubTip" aria-label="@pubTip" disabled="@(pl.Draft.Count == 0 && air == 0 && chosen == 0)" @onclick="OpenPublish"><Ico Name="upload" Size="18" />@if (RevPending(pl).Count > 0) { <span class="ai-cnt" title="Remarques de la relecture de l'IA">@RevPending(pl).Count</span> }</button>
                <span class="le-dw">
                    <button type="button" class="le-ib" title="Plus" aria-label="Plus d'actions" aria-haspopup="menu" aria-expanded="@(listMenu ? "true" : "false")" @onclick="() => listMenu = !listMenu"><NxIco Name="more" Size="20" /></button>
                    @if (listMenu)
                    {
                        <div class="kebab-backdrop" @onclick="() => listMenu = false"></div>
                        <div class="le-menu" role="menu">
                            @if (!readOnlyHere) { <button type="button" role="menuitem" @onclick="() => { listMenu = false; StartRename(pl); }"><Ico Name="edit" Size="16" /> Renommer</button> }
                            <button type="button" role="menuitem" @onclick="() => { listMenu = false; whenFor = null; whenOpen = true; }"><Ico Name="calendar" Size="16" /> Programmer la diffusion…</button>
                            @if (!readOnlyHere && pl.Draft.Count > 1) { <button type="button" role="menuitem" @onclick="() => { listMenu = false; trAll = true; }"><Ico Name="transition" Size="16" /> Transitions…</button> }
                        </div>
                    }
                </span>
            </div></div>

            @* une ligne par contenu ; vide : une zone de dépôt qui dit quoi faire *@
            <div class="le-rows">
                @if (pl.Draft.Count == 0)
                {
                    <div class="le-empty">
                        <i><NxIco Name="list" Size="30" /></i>
                        <b>@(readOnlyHere ? "Cette liste est vide" : "Cette liste est vide")</b>
                        @if (!readOnlyHere)
                        {
                            <span>Choisissez un contenu dans la colonne de droite : il s'ajoute ici, dans l'ordre de passage, en boucle.</span><br />
                            <span class="arr"><Ico Name="arrow-right" Size="16" /> Glissez un contenu ici, ou cliquez dessus</span>
                        }
                    </div>
                }
                else
                {
                    <div class="le-card">
                        @foreach (var r in rows)
                        {
                            var row = r;
                            <div class="le-row @RowClass(row) @(readOnlyHere ? "ro" : "")" data-i="@row.Index" data-id="@row.It.Id" data-drag="@(Draggable(row) ? "1" : null)" @key="row.It" @onclick="() => OnRowClick(pl, row)">
                                <span class="le-n" title="@(Draggable(row) ? "Glisser pour changer l'ordre" : null)">@row.Num</span>
                                <span class="le-th" style="@(row.Masked ? null : $"background:{row.Color}")">
                                    @if (row.Masked) { <span class="le-lock"><Ico Name="lock" Size="22" /></span> }
                                    else if (row.M?.AppId == Compositions.AppId) { <CompositionThumb Item="row.M" Files="media" Contain="true" /> }
                                    else if (row.M != null) { <MediaThumb Media="row.M" All="media" Wide="true" /> }
                                </span>
                                <span class="le-nm">
                                    <span class="le-nmt">
                                        @if (renRow == row.It)
                                        {
                                            <input class="le-ni" @ref="renRowInput" @bind="renRowValue" @bind:event="oninput" @onkeydown="RenRowKey" @onblur="SaveRowRename" @onclick:stopPropagation="true" aria-label="Nom du contenu" />
                                        }
                                        else
                                        {
                                            <b class="le-name" title="@(CanRename(row) ? "Cliquer pour renommer" : null)" @onclick:stopPropagation="true" @onclick="() => { if (CanRename(row)) StartRowRename(row); else OnRowClick(pl, row); }">@(row.Masked ? "Contenu masqué" : row.M?.Name ?? "(supprimé)")</b>
                                            @if (CanRename(row)) { <button type="button" class="le-pen" title="Renommer" aria-label="Renommer @row.M!.Name" @onclick:stopPropagation="true" @onclick="() => StartRowRename(row)"><Ico Name="edit" Size="14" /></button> }
                                        }
                                    </span>
                                    <small>
                                        <span>@(row.M != null ? Kind(row.M) : "")</span>
                                        @if (row.Incomplete && !row.Masked)
                                        {
                                            @* application ajoutée sans tout ce qu'il lui faut : la pastille orange ouvre son réglage *@
                                            <button type="button" class="le-st todo" title="Il manque une information à ce contenu : il ne passe pas tant qu'il n'est pas configuré" @onclick:stopPropagation="true" @onclick="() => OnRowClick(pl, row)">À configurer</button>
                                        }
                                        else if (StateText(row) is { } st) { <span class="le-st @StateClass(row)">@st</span> }
                                        @if (ScanOn(row))
                                        {
                                            var scans = scanCounts.TryGetValue(row.It.Id, out var sc) ? sc.Scans : 0;
                                            <button type="button" class="le-scan" title="Scans du QR code ces 90 derniers jours : ouvrir le réglage" @onclick:stopPropagation="true" @onclick='() => OpenSettings(pl, row.It, row.M, "qr")'><Ico Name="qr" Size="13" /> @scans scan@(scans > 1 ? "s" : "")</button>
                                        }
                                    </small>
                                </span>
                                <span class="le-dw">@DurView(row)</span>
                                <span class="le-dw">
                                    @if (!readOnlyHere && !row.Masked && row.M != null)
                                    {
                                        <button type="button" class="le-more @(rowMenu == row.It ? "on" : "")" title="Plus" aria-label="Plus d'actions pour @row.M.Name" aria-haspopup="menu" aria-expanded="@(rowMenu == row.It ? "true" : "false")" @onclick:stopPropagation="true" @onclick="() => { durFor = null; rowMenu = rowMenu == row.It ? null : row.It; }"><NxIco Name="more" Size="18" /></button>
                                        @if (rowMenu == row.It)
                                        {
                                            <div class="kebab-backdrop" @onclick:stopPropagation="true" @onclick="() => rowMenu = null"></div>
                                            <div class="le-menu" role="menu" @onclick:stopPropagation="true">
                                                <button type="button" role="menuitem" @onclick="() => { rowMenu = null; OpenSettings(pl, row.It, row.M); }"><Ico Name="edit" Size="16" /> Modifier…</button>
                                                <button type="button" role="menuitem" @onclick="() => { rowMenu = null; OpenProgramming(row); }"><Ico Name="calendar" Size="16" /> Programmer la diffusion…</button>
                                                <button type="button" role="menuitem" title="Le même contenu passe une seconde fois, juste après" @onclick="() => { rowMenu = null; Duplicate(pl, row.It); }"><Ico Name="copy" Size="16" /> Dupliquer</button>
                                                <hr />
                                                <button type="button" role="menuitem" class="danger" @onclick="() => { rowMenu = null; RemoveWithUndo(pl, row.It); }"><Ico Name="trash" Size="16" /> Retirer de la liste</button>
                                            </div>
                                        }
                                    }
                                </span>
                            </div>
                        }
                        <div class="le-loop"><NxIco Name="loop" Size="15" /> Puis retour au premier contenu</div>
                    </div>
                }
            </div>
        </div>

        @if (!readOnlyHere && !mini)
        {
            var tabs = LibTabs().ToList();
            var shown = tabs.Where(t => t.Count > 0).ToList();   // types vides masqués
            if (shown.Count == 0 && tabs.Count > 0) shown.Add(tabs[0]);
            if (libTab != "all" && !shown.Any(t => t.Key == libTab)) libTab = "all";
            <aside class="le-side" aria-label="Ajouter à la liste" @ref="libRoot">
                <div class="le-sidehd">
                    <h3>Ajouter</h3>
                    @LibAction()
                </div>
                <p class="le-hint">Glissez un contenu dans la liste, ou cliquez dessus pour l'ajouter à la fin.</p>
                <div class="le-tools">
                    <label class="search-box"><Ico Name="search" Size="16" /><input @ref="libSearchInput" placeholder="Rechercher" aria-label="Rechercher dans les contenus" @bind="libSearch" @bind:event="oninput" /></label>
                    <select class="le-sel" aria-label="Type de contenu" @bind="libTab">
                        <option value="all">Tout</option>
                        @foreach (var t in shown) { <option value="@t.Key">@t.Label</option> }
                    </select>
                </div>
                <div class="le-list">@CatList()</div>
            </aside>
        }
    </div>

    @if (pubOpen)
    {
        @* « Publier la liste » : les écrans qui reçoivent la modification, maintenant ou à l'heure choisie *@
        <div class="modal-backdrop" @onclick="() => pubOpen = false"></div>
        <div class="modal le-pubm" role="dialog" aria-modal="true" aria-labelledby="pub-title">
            <div class="modal-head">
                <div class="grow"><h3 id="pub-title">Publier la liste</h3><small>@pl.Name</small></div>
                <button type="button" class="modal-x" aria-label="Fermer" @onclick="() => pubOpen = false"><Ico Name="x" Size="20" /></button>
            </div>
            <div class="modal-body">
                <PlaylistPublish Model="diff" ItemsCount="pl.Draft.Count" OnChanged="StateHasChanged" OnGoFil="() => pubOpen = false" OnProgram="ProgramOne" />
            </div>
            <div class="modal-foot">
                @if (diff.Changed) { <button type="button" class="btn ghost" @onclick="() => diff.Undo()">Annuler les changements</button> }
                <span class="grow"></span>
                <button type="button" class="btn ghost" @onclick="() => pubOpen = false">Fermer</button>
                <div class="nx-split">
                    <button type="button" class="btn publish-btn" disabled="@(chosen == 0 || diff.Busy)" title="@(chosen == 0 ? "Activez au moins un écran" : null)" @onclick="() => PublishNow(null)"><Ico Name="upload" Size="16" /> @diff.ButtonLabel()@if (RevPending(pl).Count > 0) { <span class="ai-cnt" title="Remarques de la relecture de l'IA">@RevPending(pl).Count</span> }</button>
                    <button type="button" class="btn publish-btn nx-caret" disabled="@(chosen == 0 || diff.Busy)" aria-label="Autres façons de publier" aria-haspopup="menu" aria-expanded="@(pubMenu ? "true" : "false")" @onclick="() => pubMenu = !pubMenu"><Ico Name="chevron" Size="16" /></button>
                    @if (pubMenu)
                    {
                        <div class="kebab-backdrop" @onclick="() => pubMenu = false"></div>
                        <div class="nx-menu up" role="menu">
                            <button type="button" role="menuitem" @onclick="() => PublishNow(DateTime.MinValue)"><Ico Name="upload" Size="16" /><span>Tout publier maintenant<small>Sans tenir compte des heures choisies</small></span></button>
                            <button type="button" role="menuitem" @onclick="() => { pubMenu = false; whenFor = null; whenOpen = true; }"><Ico Name="calendar" Size="16" /><span>Tout programmer…<small>Une même heure pour tous les écrans activés</small></span></button>
                        </div>
                    }
                </div>
            </div>
        </div>
    }
    @if (whenOpen)
    {
        <PublishWhen Model="diff" Target="whenFor" OnClose="() => whenOpen = false" OnDone="WhenDone" />
    }
    @* import depuis les onglets Images / Vidéos : champ de fichiers caché (ouvert par « Importer ») et fenêtre « Depuis le cloud » (expert), gardés dans la page pour que l'import continue *@
    @if (canImport)
    {
        <MediaUploader InputId="@ImportInputId" OnImported="Imported" ShowJobs="false" Changed="StateHasChanged" @ref="importer" />
        @if (impCloud && Modes.Expert)
        {
            <div class="modal-backdrop" @onclick="() => impCloud = false"></div>
            <div class="imp-bottom lx-import" role="dialog" aria-modal="true" aria-labelledby="pf-imp-title">
                <div class="imp-head">
                    <h3 id="pf-imp-title">Importer depuis le cloud<small>Chaque page d'un document devient une image, rangée dans une présentation du dossier « …_médias ».</small></h3>
                    <button type="button" class="modal-x" aria-label="Fermer" @onclick="() => impCloud = false"><Ico Name="x" Size="20" /></button>
                </div>
                <div class="imp-body"><DocumentImporter OnImported="CloudImported" /></div>
                <div class="imp-foot"><span>Une fois le compte connecté, on revient ici et la tuile est déverrouillée.</span><button class="btn ghost" @onclick="() => impCloud = false">Fermer</button></div>
            </div>
        }
    }
}
else
{
    <div class="card empty"><div class="big">Liste de lecture introuvable</div><p>Elle a peut-être été supprimée. <button type="button" class="back" @onclick="Close">Revenir aux listes de lecture</button></p></div>
}

@{
    // Onglets « Contenu / QR code » de la fenêtre d'un contenu, en tête de la colonne de droite (comme « Écran / Widgets » de l'éditeur d'écran).
    // Partagés par la création (galerie → fenêtre de l'app) et par la fenêtre de réglage d'un contenu existant.
    var qrAngle = mPlacement != "full";   // un contenu en angle ou en bandeau n'a pas de QR code : l'onglet est grisé
    var qrScans = mItem != null && scanCounts.TryGetValue(mItem.Id, out var qc) ? qc.Scans : 0;
    RenderFragment qrTabs = @<div class="se-utabs" role="tablist" aria-label="Réglage du contenu">
        <button type="button" role="tab" aria-selected="@(mTab == "content" ? "true" : "false")" class="@(mTab == "content" ? "on" : "")" @onclick='() => mTab = "content"'><Ico Name="monitor" Size="18" /> Contenu</button>
        @if (mItem != null)
        {
            <button type="button" role="tab" aria-selected="@(mTab == "prog" ? "true" : "false")" class="@(mTab == "prog" ? "on" : "")" @onclick='() => mTab = "prog"'>
                <Ico Name="calendar" Size="18" /> Programmation
                @if (mSchedOn) { <span class="tab-dot" title="Une période est définie"></span> }
            </button>
        }
        <button type="button" role="tab" aria-selected="@(mTab == "qr" ? "true" : "false")" class="@(mTab == "qr" && !qrAngle ? "on" : "")" disabled="@qrAngle"
                title="@(qrAngle ? "Le QR code n'est disponible que pour un contenu en pleine page." : "")" @onclick='() => mTab = "qr"'>
            <Ico Name="qr" Size="18" /> QR code
            @if (!growth) { <span class="tab-lock"><Ico Name="lock" Size="12" /> Pro</span> }
            else if (mQrOn && qrScans > 0) { <small class="on-badge">@qrScans</small> }
        </button>
    </div>;
    // Onglet « Programmation » : période de diffusion du contenu (début et fin facultatifs), colonne de droite comme « QR code »
    RenderFragment progPane = @<div class="ci-prog">
        <h4 class="ci-t">Période de diffusion</h4>
        <div class="ci-seg" role="radiogroup" aria-label="Période de diffusion">
            <button type="button" role="radio" aria-checked="@(mSchedOn ? "false" : "true")" class="@(mSchedOn ? "" : "on")" @onclick="() => mSchedOn = false">Toujours</button>
            <button type="button" role="radio" aria-checked="@(mSchedOn ? "true" : "false")" class="@(mSchedOn ? "on" : "")" @onclick="() => mSchedOn = true">Période</button>
        </div>
        @if (mSchedOn)
        {
            <div class="ci-sched">
                <div class="ci-sched-row"><b>Début</b><input type="date" aria-label="Date de début" value="@mFromDate" @onchange='e => mFromDate = e.Value?.ToString() ?? ""' /><input type="time" aria-label="Heure de début" value="@mFromTime" @onchange='e => mFromTime = e.Value?.ToString() ?? ""' /></div>
                <div class="ci-sched-row"><b>Fin</b><input type="date" aria-label="Date de fin" value="@mToDate" @onchange='e => mToDate = e.Value?.ToString() ?? ""' /><input type="time" aria-label="Heure de fin" value="@mToTime" @onchange='e => mToTime = e.Value?.ToString() ?? ""' /></div>
                <p class="hint">Laissez un champ vide pour ne pas limiter de ce côté. Heure de l'écran.</p>
                <div class="ci-sched-sum">@ScheduleSummary()</div>
            </div>
        }
        else { <p class="hint">Le contenu passe en boucle sans limite de date.</p> }
    </div>;
    RenderFragment qrPreview = @<div>
        <h4 class="ci-t">Aperçu de l'écran</h4>
        <QrPlacer Format="@mFormat" FormatChanged="SetFormatValue" Media="(newForm ?? itemForm)?.PickedMedia() ?? mMedia" Fit="@((newForm ?? itemForm)?.PreviewFit ?? "contain")" All="media" Text="@(growth && mQrOn ? QrText : null)" X="mQrX" Y="mQrY" Size="mQrSize" Label="@mQrLabel" OnMoved="QrMoved" />
    </div>;
    RenderFragment qrPane = @<div class="ci-qr">
        <div class="ci-qr-master">
            <div><b>Compter les scans du QR code</b><small>Un QR code est ajouté au contenu ; chaque scan est comptabilisé.</small></div>
            <input type="checkbox" class="ios" checked="@(growth && mQrOn)" disabled="@(!growth)" aria-label="Compter les scans du QR code" @onchange="e => ToggleQr(e.Value is true)" />
        </div>
        @if (!growth) { <div class="ci-qr-locked">@Plans.LockedHint.</div> }
        else if (mQrOn)
        {
            <div class="qr-fields">
                <div class="dw-field"><label>Emplacement</label>
                    <div class="qr-pos" role="group" aria-label="Emplacement du QR code">
                        @foreach (var (key, label) in QrSpots) { if (key == "c") { <span aria-hidden="true"></span> continue; } <button type="button" class="qr-pos-@key" title="@label" aria-label="@label" @onclick="() => PlaceQr(key)"><i></i></button> }
                    </div>
                    <small>Ou glissez le QR code directement dans l'aperçu.</small>
                </div>
                <div class="dw-field"><label for="qr-url">Adresse de destination *</label><input id="qr-url" type="text" inputmode="url" maxlength="@QrTracking.UrlMax" placeholder="https://…" @bind="mQrUrl" @bind:event="oninput" /></div>
                <div class="dw-field"><label for="qr-lbl">Texte sous le QR code</label><input id="qr-lbl" type="text" maxlength="@QrTracking.LabelMax" @bind="mQrLabel" @bind:event="oninput" /></div>
                <div class="dw-field"><label for="qr-size">Taille <span class="mono">@Math.Round(mQrSize) %</span></label><input id="qr-size" type="range" min="@QrTracking.MinSize" max="@QrTracking.MaxSize" step="1" value="@Math.Round(mQrSize)" @oninput="ChangeQrSize" /></div>
            </div>
        }
    </div>;
    // l'onglet ouvert remplace la colonne de configuration : « QR code » ou « Programmation » (sans aperçu du contenu pour ce dernier)
    bool otherOpen = (mTab == "qr" && !qrAngle) || (mTab == "prog" && mItem != null);
    RenderFragment otherPane = mTab == "prog" ? progPane : qrPane;
    RenderFragment? otherPreview = mTab == "prog" ? null : qrPreview;
}

