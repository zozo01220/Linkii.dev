    private void OpenSettings(Playlist pl, PlaylistItem it, MediaItem? m, string tab = "content")
    {
        mPlaylist = pl; mItem = it; mMedia = m; itemName = null;
        mFormat = null;
        mPlacement = m?.Type == "app" && PlacementsFor(m).Any(o => o.Id == "full") ? "full" : it.Placement;   // un contenu est toujours en pleine page (sauf widgets d'angle)
        mMode = it.DurationMode == "fixed" ? "fixed" : "content";
        mSeconds = it.DurationSec;
        mTab = tab == "prog" ? "prog" : growth && tab == "qr" && it.Placement == "full" ? "qr" : "content";
        mSchedOn = it.StartsAt != null || it.EndsAt != null;
        (mFromDate, mFromTime) = SplitWindow(it.StartsAt);
        (mToDate, mToTime) = SplitWindow(it.EndsAt);
        mQrOn = it.QrOn; mQrCode = it.QrCode; mQrUrl = it.QrUrl ?? ""; mQrLabel = it.QrLabel ?? "";
        mQrSize = QrTracking.ClampSize(it.QrSize);
        (mQrX, mQrY) = QrTracking.ClampPos(it.QrX, it.QrY, mQrSize);
    }

    // Composition : « Ouvrir l'éditeur » depuis la fenêtre. Les réglages de la fenêtre (position, durée, QR code) sont enregistrés d'abord, sinon ils
    // seraient perdus en quittant la page ; s'ils sont refusés (message affiché), on reste dans la fenêtre.
    private async Task OpenCompositionEditor(Guid compositionId)
    {
        await SaveAll();
        if (mItem != null) return;
        Nav.NavigateTo($"/compositions/{compositionId}?back={Uri.EscapeDataString($"/playlists/{Id}")}");
    }

    private void CloseSettings() { mItem = null; mPlaylist = null; mMedia = null; mTab = "content"; mSchedOn = false; }

    /// <summary>Ouvre la fenêtre du contenu directement sur son onglet « Programmation » (pastille de la ligne, menu ⋮).</summary>
    private void OpenProgramming(FlowRow r)
    {
        if (Current is { } pl && r.M != null) OpenSettings(pl, r.It, r.M, "prog");
    }

    private static (string Date, string Time) SplitWindow(string? iso) =>
        iso == null ? ("", "") : (iso[..10], iso[11..16]);

    /// <summary>Date et heure saisies en une valeur aaaa-mm-ddTHH:mm ; sans heure, début à 00:00 et fin à 23:59. Null si la date est vide.</summary>
    private static string? WindowOf(string date, string time, string defaultTime) =>
        date.Length == 0 ? null : date[..Math.Min(10, date.Length)] + "T" + (time.Length == 0 ? defaultTime : time[..Math.Min(5, time.Length)]);   // le navigateur peut ajouter les secondes

    private string ScheduleSummary()
    {
        var from = mSchedOn ? WindowOf(mFromDate, mFromTime, "00:00") : null;
        var to = mSchedOn ? WindowOf(mToDate, mToTime, "23:59") : null;
        if (from == null && to == null) return "Diffusé sans limite : renseignez au moins une date.";
        if (from != null && to != null) return $"Diffusé du {ContentWindow.Long(from)} au {ContentWindow.Long(to)}.";
        return from != null ? $"Diffusé à partir du {ContentWindow.Long(from)}, sans fin." : $"Diffusé tout de suite, jusqu'au {ContentWindow.Long(to!)}.";
    }

    // Adresse encodée dans le QR code de l'aperçu : l'adresse courte réelle (code déjà créé) ou un exemple tant que le contenu n'est pas enregistré.
    private string? QrText => QrTracking.ShortUrl(QrTracking.Origin(Nav.BaseUri), mQrCode ?? "XXXXXXXX");

    // QR dessiné sur les aperçus de la fenêtre (image, carrousel, grille) : réglages en cours, seulement si le contenu est en pleine page
    private PublishedQr? PreviewQr => growth && mQrOn && mPlacement == "full" ? QrTracking.Build(QrText, mQrX, mQrY, mQrSize, mQrLabel) : null;

    // QR de la vignette d'une ligne : celui qui sera publié (réglages enregistrés)
    private PublishedQr? RowQr(PlaylistItem it) => growth ? QrTracking.Overlay(it, true, it.Placement) : null;

    private void ToggleQr(bool on)
    {
        mQrOn = on;
        if (on) mQrCode ??= QrTracking.NewCode();   // le code ne change plus ensuite : le QR affiché sur l'écran reste valable
    }

    private void ChangeQrSize(ChangeEventArgs e)
    {
        if (!double.TryParse(e.Value?.ToString(), System.Globalization.NumberStyles.Float, System.Globalization.CultureInfo.InvariantCulture, out var v)) return;
        mQrSize = QrTracking.ClampSize(v);
        (mQrX, mQrY) = QrTracking.ClampPos(mQrX, mQrY, mQrSize);
    }

    private static readonly (string Key, string Label)[] QrSpots =
    {
        ("tl", "En haut à gauche"), ("t", "En haut"), ("tr", "En haut à droite"),
        ("l", "À gauche"), ("c", ""), ("r", "À droite"),
        ("bl", "En bas à gauche"), ("b", "En bas"), ("br", "En bas à droite"),
    };
    /// <summary>Emplacement prédéfini : calculé dans le navigateur avec les vraies dimensions de l'aperçu (marge de 2 %).</summary>
    private async Task PlaceQr(string key)
    {
        try { await JS.InvokeVoidAsync("linkiiQr.place", key); } catch { }
    }

    private void QrMoved((double X, double Y) p) => (mQrX, mQrY) = QrTracking.ClampPos(p.X, p.Y, mQrSize);

    private void ChangeMode(ChangeEventArgs e)
    {
        mMode = e.Value?.ToString() == "fixed" ? "fixed" : "content";
        if (mMode == "fixed") mSeconds = Helpers.VideoSeconds(mMedia) ?? 30;   // départ : la durée de la vidéo si elle est connue
    }

    private void SaveSettings()
    {
        if (mItem is not { } item || mPlaylist is not { } pl) return;
        var content = ContentDuration(mMedia);
        var needsSeconds = mPlacement == "full" && (!content || mMode == "fixed");
        if (needsSeconds && (mSeconds < 1 || mSeconds > 86400)) { Toast.Error("La durée doit être comprise entre 1 et 86 400 secondes."); return; }
        var placement = mPlacement; var mode = mMode; var seconds = mSeconds;
        var qr = mMedia?.AppId != null && growth;   // le QR code ne se règle que pour un contenu d'app, avec la licence Pro
        var qrOn = mQrOn; var qrUrl = QrTracking.Destination(mQrUrl) ?? mQrUrl.Trim(); var qrLabel = QrTracking.CleanLabel(mQrLabel);
        var qrCode = qrOn ? mQrCode ?? QrTracking.NewCode() : mQrCode ?? item.QrCode; var qrBase = QrTracking.Origin(Nav.BaseUri);
        double qx = mQrX, qy = mQrY, qs = mQrSize;
        var from = ScheduleFrom; var to = ScheduleTo;
        WriteList(d =>
        {
            item.StartsAt = from; item.EndsAt = to;
            item.Placement = placement;
            if (content) item.DurationMode = mode;
            if (needsSeconds) item.DurationSec = seconds;
            if (qr)
            {
                item.QrOn = qrOn; item.QrCode = qrCode; item.QrUrl = qrUrl; item.QrLabel = qrLabel; item.QrBase = qrBase;
                item.QrX = qx; item.QrY = qy; item.QrSize = qs;
            }
            pl.Touch();   // à publier depuis la page Écrans
        });
        Toast.Ok("Paramètres enregistrés.");
        CloseSettings();
        Reload();
    }


    public void Dispose() { revCts?.Cancel(); selfRef?.Dispose(); if (revKey.Length > 0) Panel.Release(revKey); }

    // Temps alloué, affiché à droite de la ligne ; le détail se règle dans la fenêtre « Paramètres ».
    private string Duration(PlaylistItem it, MediaItem? m)
    {
        if (m == null) return "";
        if (it.Placement != "full") return "Permanent";
        if (ContentDuration(m) && it.DurationMode != "fixed")
            return Helpers.ContentSeconds(Svc.Find(m.AppId), m, media) is { } c ? Helpers.FormatDuration(c.Seconds)
                 : Helpers.VideoSeconds(m) is { } v ? Helpers.FormatDuration(v) : "Jusqu'à la fin";
        return Helpers.FormatDuration(it.DurationSec);
    }

    private bool renaming;
    private string renameValue = "";

    private ElementReference renameInput;
    private bool focusRename;

    private void StartRename(Playlist pl) { renameValue = pl.Name; renaming = true; focusRename = true; }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        RevRefresh();   // la carte de relecture du panneau suit la liste (contenu désactivé, remarque ignorée…)
        if (focusRename && renaming) { focusRename = false; await renameInput.FocusAsync(); }
        if (focusRenRow && renRow != null) { focusRenRow = false; try { await JS.InvokeVoidAsync("linkiiFlow.select", renRowInput); } catch (JSException) { } }
        if (revealFresh) { revealFresh = false; try { await JS.InvokeVoidAsync("linkiiFlow.revealMedia"); } catch (JSException) { } }   // média importé : amené en vue en tête de la liste
        // Le fil n'existe qu'une fois la liste de lecture chargée ; le script ignore un second appel sur le même élément.
        if (flowRoot.Context != null && flowRoot.Id != flowInitId)
        {
            flowInitId = flowRoot.Id;
            selfRef ??= DotNetObjectReference.Create(this);
            await JS.InvokeVoidAsync("linkiiRows.init", flowRoot, selfRef);
        }
        if (revealId is { } rid) { revealId = null; try { await JS.InvokeVoidAsync("linkiiRows.reveal", rid.ToString()); } catch (JSException) { } }
    }

    private void OnRenameKey(KeyboardEventArgs e, Playlist pl)
    {
        if (e.Key == "Enter") Rename(pl);
        else if (e.Key == "Escape") renaming = false;
    }

    private void Rename(Playlist pl)
    {
        if (!renaming) return;
        var name = renameValue.Trim();
        if (name.Length == 0) return;
        WriteList(d => { pl.Name = name; pl.UpdatedAt = DateTime.UtcNow; });   // le nom n'est pas publié : aucun écran à notifier
        Toast.Ok($"Liste de lecture renommée en « {name} ».");
        renaming = false;
        Reload();
    }

}
