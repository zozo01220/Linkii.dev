    // Combien de fois une vignette est déjà dans le fil
    private int UsedFile(Guid fileId) => Current?.Draft.Count(i => media.FirstOrDefault(x => x.Id == i.MediaId) is { } m && m.Settings.GetValueOrDefault("media") == fileId.ToString()) ?? 0;
    private int UsedItem(Guid id) => Current?.Draft.Count(i => i.MediaId == id) ?? 0;
    private int UsedApp(string appId) => Current?.Draft.Count(i => media.FirstOrDefault(x => x.Id == i.MediaId)?.AppId == appId) ?? 0;

    // Colonne « Ajouter » : un contenu de la bibliothèque. Un clic l'ajoute à la fin, on peut aussi le glisser dans la liste (playlist-rows.js).
    // Aperçu : l'icône de l'application (AppId), une composition, ou la vignette du média ou du contenu.
    private sealed record CatEntry(string Drag, string Name, string Sub, MediaItem? M, string? AppId, Action Add, int Used, bool Busy = false, bool Fresh = false);

    private IEnumerable<CatEntry> FileEntries(string type) =>
        pickFiles.Where(m => m.Type == type && (freshFiles.Contains(m.Id) || Match(m.Name)))
            .OrderByDescending(m => freshFiles.Contains(m.Id)).ThenByDescending(m => m.AddedUtc)
            .Select(f => new CatEntry("med:" + f.Id, f.Name, f.Status != null ? "Conversion en cours…" : MediaMeta(f), f, null, () => AddMedia(f, TakePick()), UsedFile(f.Id), f.Status != null, freshFiles.Contains(f.Id)));

    private IEnumerable<CatEntry> CompoEntries() =>
        compoItems.Where(c => Match(c.Name))
            .Select(c => new CatEntry("cmp:" + c.Id, c.Name, Compositions.Size(c.Settings) is { } sz ? $"Composition · {sz.W} × {sz.H}" : "Composition", c, null, () => AddCompositionAt(c, TakePick()), UsedItem(c.Id)));

    private IEnumerable<CatEntry> InstanceEntries(List<MediaItem> items) =>
        items.Where(m => Match(m.Name))
            .Select(m => new CatEntry("inst:" + m.Id, m.Name, Svc.Find(m.AppId)?.Name ?? "", m, null, () => AddInstance(m, TakePick()), UsedItem(m.Id)));

    private IEnumerable<CatEntry> AppEntries() =>
        OtherApps.Where(a => Match(a.Name) || Match(a.Summary))
            .Select(a => new CatEntry("app:" + a.Id, a.Name, a.Summary ?? a.Category ?? "Application", null, a.Id, () => AddEmpty(a, TakePick()), UsedApp(a.Id)));

    private IEnumerable<CatEntry> CatEntries(string kind)
    {
        if (kind is "all" or "img") foreach (var e in FileEntries("image")) yield return e;
        if (kind is "all" or "vid") foreach (var e in FileEntries("video")) yield return e;
        if (kind is "all" or "cmp") foreach (var e in CompoEntries()) yield return e;
        if (kind is "all" or "pres") foreach (var e in InstanceEntries(presItems)) yield return e;
        if (kind is "all" or "web") foreach (var e in InstanceEntries(webItems)) yield return e;
        if (kind is "all" or "app") foreach (var e in AppEntries()) yield return e;
    }

