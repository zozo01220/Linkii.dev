    // ---------- Actions du menu ⋮ ----------
    // Dupliquer : le même contenu passe une seconde fois, juste après (QR de comptage : une adresse courte à lui)
    private void Duplicate(Playlist pl, PlaylistItem it)
    {
        menuFor = null;
        var copy = new PlaylistItem
        {
            MediaId = it.MediaId, DurationSec = it.DurationSec, DurationMode = it.DurationMode, Placement = it.Placement, Off = it.Off, StartsAt = it.StartsAt, EndsAt = it.EndsAt,
            QrOn = it.QrOn, QrCode = it.QrOn ? QrTracking.NewCode() : null, QrUrl = it.QrUrl, QrLabel = it.QrLabel, QrBase = it.QrBase, QrX = it.QrX, QrY = it.QrY, QrSize = it.QrSize
        };
        WriteList(d =>
        {
            // Un contenu d'app (Canva, page web…) a ses propres réglages : la copie en reçoit une instance à elle, sinon changer l'un changerait l'autre.
            // Fichiers image / vidéo et compositions restent partagés (on ne les modifie pas ici).
            if (d.Media.FirstOrDefault(x => x.Id == it.MediaId) is { AppId: not null } src && src.AppId != Compositions.AppId)
            {
                var name = src.Name.Length > 70 ? src.Name[..70] : src.Name;
                var inst = new MediaItem
                {
                    ClientId = src.ClientId, AreaId = src.AreaId, Name = name + " (copie)", Type = src.Type, AppId = src.AppId, AppVersion = src.AppVersion,
                    Settings = new(src.Settings), Secrets = new(src.Secrets), Info = new(src.Info), FolderId = src.FolderId, OwnerId = src.OwnerId, AddedUtc = DateTime.UtcNow
                };
                d.Media.Add(inst);
                copy.MediaId = inst.Id;
            }
            var at = pl.Draft.IndexOf(it);
            pl.Draft.Insert(at < 0 ? pl.Draft.Count : at + 1, copy);
            pl.Touch();
        });
        Reload();
        Flash(copy.Id);
    }

    private void ToggleOff(Playlist pl, PlaylistItem it)
    {
        menuFor = null;
        var off = !it.Off;
        WriteList(d => { it.Off = off; pl.Touch(); });
        Toast.Ok(off ? "Contenu désactivé : il reste dans la liste mais la boucle le saute." : "Contenu réactivé.");
        Reload();
    }

    // Renommer un contenu d'app, sur place
    private PlaylistItem? renameFor;
    private string renameItemValue = "";
    private ElementReference renameItemInput;
    private bool focusItemRename;

    private void StartItemRename(PlaylistItem it, MediaItem m) { menuFor = null; durFor = null; renameFor = it; renameItemValue = m.Name; focusItemRename = true; }

    private void OnItemRenameKey(KeyboardEventArgs e, MediaItem m)
    {
        if (e.Key == "Enter") SaveItemName(m);
        else if (e.Key == "Escape") renameFor = null;
    }

    private void SaveItemName(MediaItem m)
    {
        var name = renameItemValue.Trim();
        if (name.Length == 0) return;
        if (name.Length > 80) { Toast.Error("Le nom est trop long (80 caractères maximum)."); return; }
        WriteList(d => { if (d.Media.FirstOrDefault(x => x.Id == m.Id && x.AppId != null) is { } x) x.Name = name; });
        renameFor = null;
        Reload();
    }

    // Durée modifiée sur place : « m:ss » ou un nombre de secondes ; une app « jusqu'à la fin » passe en durée fixe
    private PlaylistItem? durFor;
    private string durValue = "";
    private ElementReference durInput;
    private bool focusDur;

    private void StartDur(PlaylistItem it)
    {
        menuFor = null; renameFor = null;
        durFor = it; focusDur = true;
        var m = media.FirstOrDefault(x => x.Id == it.MediaId);
        durValue = Helpers.FormatDuration(Helpers.ItemSeconds(it, m, Svc.Find(m?.AppId), media));
    }

    private void DurKey(KeyboardEventArgs e)
    {
        if (e.Key == "Enter") SaveDur();
        else if (e.Key == "Escape") durFor = null;
    }

    private static int? ParseDuration(string s)
    {
        s = s.Trim();
        var parts = s.Split(':');
        if (parts.Length == 1 && int.TryParse(parts[0], out var sec)) return sec;
        if (parts.Length == 2 && int.TryParse(parts[0], out var mm) && int.TryParse(parts[1], out var ss) && ss is >= 0 and < 60) return mm * 60 + ss;
        if (parts.Length == 3 && int.TryParse(parts[0], out var hh) && int.TryParse(parts[1], out var m2) && int.TryParse(parts[2], out var s2) && m2 is >= 0 and < 60 && s2 is >= 0 and < 60) return hh * 3600 + m2 * 60 + s2;
        return null;
    }

    private void SaveDur()
    {
        if (durFor is not { } it || Current is not { } pl) return;
        durFor = null;
        if (ParseDuration(durValue) is not { } secs || secs < 1 || secs > 86400) { Toast.Error("Durée invalide : saisissez par exemple 0:08, 1:30 ou 45 (entre 1 seconde et 24 heures)."); return; }
        var content = ContentDuration(media.FirstOrDefault(x => x.Id == it.MediaId));
        WriteList(d =>
        {
            it.DurationSec = secs;
            if (content) it.DurationMode = "fixed";
            pl.Touch();
        });
        Reload();
    }

    private void PickAppWithForm(AppManifest app)
    {
        newApp = app; newName = null;
        // réglages du QR code pour le nouveau contenu : mêmes champs que la fenêtre d'un contenu, réinitialisés
        mItem = null; mPlaylist = null; mMedia = null; mPlacement = "full";
        mTab = "content"; mQrOn = false; mQrCode = null; mQrUrl = ""; mQrLabel = "";
        mQrSize = QrTracking.DefaultSize; (mQrX, mQrY) = (QrTracking.DefaultX, QrTracking.DefaultY);
    }

    // Ajout d'un contenu : le QR code (licence Pro) est vérifié avant tout enregistrement, comme pour un contenu existant.
    private async Task SaveNew()
    {
        if (growth && mQrOn && mPlacement == "full" && QrTracking.Destination(mQrUrl) == null)
        {
            mTab = "qr";
            Toast.Error("Saisissez l'adresse de destination du QR code (adresse web complète, par exemple https://www.exemple.ch).");
            return;
        }
        await newForm!.Save();
    }

    private IEnumerable<Option> PlacementsFor(MediaItem? m) =>
        Svc.Find(m?.AppId) is { } app ? ScreenOptions.Placements.Where(o => app.Placements.Contains(o.Id)) : ScreenOptions.PlacementsFor(m);

    // Une app « content » (YouTube) décide elle-même de sa durée : fin de la vidéo, plafonnée par son paramètre.
    private bool ContentDuration(MediaItem? m) => Svc.Find(m?.AppId)?.Duration == "content";

    private Playlist? Current => playlists.FirstOrDefault(p => p.Id == Id);

    // Une liste rangée dans un dossier partagé en lecture seule ne s'enregistre pas, même si la page est ouverte (contrôle côté serveur)
    private bool readOnlyHere;
    private void WriteList(Action<ClientDb> act)
    {
        try
        {
            Store.Write(d =>
            {
                if (d.Playlists.FirstOrDefault(p => p.Id == Id) is { } p && !PlaylistOps.CanEdit(d, p))
                    throw new UnauthorizedAccessException("Cette liste est dans un dossier partagé en lecture seule : vous ne pouvez pas la modifier.");
                act(d);
            });
        }
        catch (UnauthorizedAccessException e) { Toast.Error(e.Message); }
    }

    protected override void OnParametersSet() { Reload(); renaming = false; }

    private async Task Refresh() { Reload(); await InvokeAsync(StateHasChanged); }

    private bool portraitScreens;   // tous les écrans qui jouent cette liste sont en portrait : les aperçus des contenus le sont aussi
    private int outside;   // écrans hors du périmètre du membre qui jouent cette liste
    private HashSet<Guid> hidden = new();

    private void Reload()
    {
        playlists = Store.Read(d => d.Playlists.Where(p => PlaylistOps.RightOf(d, p) != FolderRight.None).ToList());   // une liste d'un dossier invisible est « introuvable »
        readOnlyHere = Store.Read(d => d.Playlists.FirstOrDefault(p => p.Id == Id) is { } cur && !PlaylistOps.CanEdit(d, cur));
        media = Store.Read(d => d.Media.Where(m => m.Status == null).ToList());   // hors vidéos en conversion / en échec
        zone = Store.Read(d => d.Tenant.Timezone);
        hidden = MediaLib.HiddenFileIds();   // fichiers des dossiers non accordés : leurs contenus sont masqués
        enabledApps = Svc.Installed().Select(i => Svc.Find(i.AppId)).OfType<AppManifest>().Where(a => !a.ScreenWidget).OrderBy(a => a.Name, StringComparer.CurrentCultureIgnoreCase).ToList();
        growth = Store.Read(d => d.Tenant.IsGrowth);
        outside = Store.Read(d => d.Access.Sees is { } sees ? d.Root.Screens.Count(s => s.ClientId == d.ClientId && s.Token != null && !sees(s) && s.ZonePlaylists().Contains(Id)) : 0);
        portraitScreens = Store.Read(d => d.Root.Screens.Where(s => s.ClientId == d.ClientId && s.Token != null && s.ZonePlaylists().Contains(Id)).ToList() is { Count: > 0 } ps && ps.All(s => s.Orientation == "portrait"));
        scanCounts = growth ? Scans.Counts(Store.ClientId, DateTime.UtcNow.AddDays(-ScanLog.RetentionDays)) : new();
    }

    // Le contenu de l'app vient d'être créé avec ses réglages : il rejoint la liste de lecture à l'endroit choisi (par défaut, à la fin).
    private void AddApp(Playlist pl, MediaItem item)
    {
        var dur = Store.Read(d => d.Tenant.DefaultDurationSec);
        var placement = PlacementsFor(item).Select(o => o.Id).DefaultIfEmpty("full").Contains("full") ? "full" : PlacementsFor(item).First().Id;
        var at = insertAt is { } i && i >= 0 && i < pl.Draft.Count ? i : pl.Draft.Count;
        // QR code de comptage : réglé dans l'onglet « QR code » de la fenêtre de création (licence Pro, contenu en pleine page)
        var qr = growth && mQrOn && placement == "full";
        var qrCode = qr ? mQrCode ?? QrTracking.NewCode() : null; var qrUrl = QrTracking.Destination(mQrUrl) ?? mQrUrl.Trim();
        var qrLabel = QrTracking.CleanLabel(mQrLabel); var qrBase = QrTracking.Origin(Nav.BaseUri);
        var (qx, qy, qs) = (mQrX, mQrY, mQrSize);
        WriteList(d =>
        {
            pl.Draft.Insert(at, new PlaylistItem
            {
                MediaId = item.Id, DurationSec = dur, Placement = placement,
                QrOn = qr, QrCode = qrCode, QrUrl = qr ? qrUrl : null, QrLabel = qrLabel, QrBase = qrBase, QrX = qx, QrY = qy, QrSize = qs
            });
            pl.Touch();
        });
        insertAt = null;
        newApp = null;
        Toast.Ok($"« {item.Name} » ajouté à la liste de lecture.");
        Reload();
    }

    // App : ses réglages sont enregistrés d'abord (validation comprise), puis la position et la durée dans la liste de lecture.
    private string? ScheduleFrom => mSchedOn ? WindowOf(mFromDate, mFromTime, "00:00") : null;
    private string? ScheduleTo => mSchedOn ? WindowOf(mToDate, mToTime, "23:59") : null;

    private async Task SaveAll()
    {
        // Période de diffusion : dates bien formées et fin après le début (vérifié avant d'enregistrer quoi que ce soit)
        if (mItem != null && !ContentWindow.Valid(ScheduleFrom, ScheduleTo, out var windowError)) { mTab = "prog"; Toast.Error(windowError!); return; }
        // QR code activé : une destination valide est nécessaire (vérifié avant d'enregistrer quoi que ce soit)
        if (growth && mMedia?.AppId != null && mPlacement == "full" && mQrOn && QrTracking.Destination(mQrUrl) == null)
        {
            mTab = "qr";
            Toast.Error("Saisissez l'adresse de destination du QR code (adresse web complète, par exemple https://www.exemple.ch).");
            return;
        }
        if (mMedia?.AppId != null && itemForm != null) await itemForm.Save();
        else SaveSettings();
    }

    // Un contenu d'app n'existe que pour ses listes de lecture : retiré de la dernière, il est supprimé (les fichiers de la médiathèque restent).
    private void RemoveItem(Playlist pl, PlaylistItem it)
    {
        if (MediaLibrary.UsesHidden(media.FirstOrDefault(x => x.Id == it.MediaId), hidden)) { Toast.Error("Ce contenu utilise un média que vous ne voyez pas : vous ne pouvez pas le retirer."); return; }
        WriteList(d => { pl.Draft.Remove(it); pl.Touch(); });
        var m = media.FirstOrDefault(x => x.Id == it.MediaId);
        if (m?.AppId != null && m.AppId != Compositions.AppId && Svc.PlaylistsUsing(m.Id).Count == 0) Svc.DeleteInstance(m.Id);   // une composition reste dans « Mes compositions »
        Toast.Ok($"« {m?.Name ?? "Contenu"} » retiré de la liste de lecture.");
        Reload();
    }

    // ---------- Paramètres d'un élément (fenêtre modale) ----------
    private PlaylistItem? mItem;
    private Playlist? mPlaylist;
    private MediaItem? mMedia;
    private string mPlacement = "full", mMode = "content";
    private int mSeconds = 8;

    // QR code de comptage des scans (onglet « QR code », licence Pro) : réglages en cours d'édition, enregistrés avec la fenêtre
    private string mTab = "content";
    // Onglet « Programmation » : période de diffusion (aaaa-mm-jj et hh:mm, sans limite si vide)
    private bool mSchedOn;
    private string mFromDate = "", mFromTime = "", mToDate = "", mToTime = "";
    private string zone = "Europe/Zurich";   // fuseau de l'organisation : la période se compare à son heure
    private bool mQrOn;
    private string mQrUrl = "", mQrLabel = "";
    private string? mQrCode;
    private double mQrX = QrTracking.DefaultX, mQrY = QrTracking.DefaultY, mQrSize = QrTracking.DefaultSize;
    private bool growth;
    private Dictionary<Guid, (int Scans, int Visitors)> scanCounts = new();

    // ---------- Compositions : choix dans « Mes compositions » ----------
    private bool pickCompo;
    private List<MediaItem> compoItems = new(), compoFiles = new();
    private string NewCompositionUrl => $"/compositions/new?back={Uri.EscapeDataString($"/playlists/{Id}")}&addTo={Id}&at={insertAt?.ToString() ?? ""}";

    private void OpenCompositionPicker(int? position)
    {
        insertAt = position;
        compoItems = Svc.Instances(Compositions.AppId);
        compoFiles = MediaLib.PickableFiles().Where(m => m.Type == "image" && m.Status == null && m.FileName != null).ToList();
