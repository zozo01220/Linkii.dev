    // Une liste rangée dans un dossier partagé en lecture seule ne s'enregistre pas, même si la page est ouverte (contrôle côté serveur)
    private bool readOnlyHere;
    private void WriteList(Action<ClientDb> act)
    {
        try
        {
            Store.Write(d =>
            {
                if (d.Playlists.FirstOrDefault(p => p.Id == Id) is { } p && !PlaylistOps.CanEdit(d, p))
                    throw new UnauthorizedAccessException("Cette liste est dans un dossier partagé en lecture seule : vous ne pouvez pas la modifier.");
                act(d);
            });
        }
        catch (UnauthorizedAccessException e) { Toast.Error(e.Message); }
