@inject TenantStore Store
@inject AppService Svc
@inject CanvaService Canva
@inject IJSRuntime JS
@inject ScanLog Scans
@inject NavigationManager Nav
@inject Toaster Toast
@inject MediaLibrary MediaLib
@using Microsoft.JSInterop
@implements IDisposable

@if (readOnlyHere)
{
    <div class="dw-note"><Ico Name="lock" Size="15" /><span class="grow">Cette liste est dans un dossier partagé en <b>lecture seule</b> : vous pouvez la voir et la diffuser, pas la modifier.</span></div>
}

<YoutubeDurations Items="media" OnUpdated="Refresh" />

@if (Current is { } pl)
{
    var rows = Rows(pl);
    var total = rows.Where(r => r.Plays).Sum(r => r.Seconds);
    var active = pl.Draft.Count(i => !i.Off);
    <div class="pf" @ref="flowRoot">
        @if (!readOnlyHere)
        {
            @* Apps activées (hors widgets d'écran) : on les glisse dans le fil, ou un clic les ajoute à la fin, à vide ; le contenu se complète ensuite. *@
            <aside class="pf-apps" aria-label="Ajouter au fil">
                <div class="pf-apps-h">
                    <h3>Ajouter au fil</h3>
                    <p>Glissez une app dans le fil, ou cliquez pour l'ajouter à la fin.</p>
                    <label class="search-box"><Ico Name="search" Size="16" /><input placeholder="Rechercher une app" aria-label="Rechercher une app" @bind="appSearch" @bind:event="oninput" /></label>
                </div>
                <div class="pf-apps-l">
                    @if (enabledApps.Count == 0)
                    {
                        <p class="hint">Aucune intégration activée. <a href="/integrations">Choisissez-les dans la page Intégrations</a>.</p>
                    }
                    @foreach (var g in AppGroups())
                    {
                        <h5>@g.Key</h5>
                        @foreach (var a in g)
                        {
                            var app = a;
                            <button type="button" class="pf-app" draggable="true" data-app="@app.Id" title="@app.Summary" @onclick="() => AddEmpty(app, null)">
                                <AppIcon Id="@app.Id" Small="true" /><span class="grow">@app.Name</span><span class="grip" aria-hidden="true"><Ico Name="grip" Size="14" /></span>
                            </button>
                        }
                    }
                    @if (enabledApps.Count > 0 && !PickerApps.Any()) { <p class="hint">Aucune app trouvée.</p> }
                </div>
                <div class="pf-apps-f"><a href="/integrations">Toutes les intégrations…</a></div>
            </aside>
        }

        <div class="pf-main">
            <div class="page-head">
                <div class="grow" style="min-width:0">
                    @if (renaming)
                    {
                        <div class="row rename-row">
                            <input class="grow" style="min-width:0" @ref="renameInput" @bind="renameValue" @bind:event="oninput" @onkeydown="e => OnRenameKey(e, pl)" aria-label="Nom de la liste de lecture" />
                            <button class="btn sm" @onclick="() => Rename(pl)">Enregistrer</button>
                            <button class="btn ghost sm" @onclick="() => renaming = false">Annuler</button>
                        </div>
                    }
                    else
                    {
                        <div class="row" style="gap:12px">
                            <h1>@pl.Name</h1>
                            <button class="btn ghost sm icon" title="Renommer" aria-label="Renommer la liste de lecture" @onclick="() => StartRename(pl)"><Ico Name="edit" Size="16" /></button>
                        </div>
                    }
                    <p class="sub">@active contenu@(active > 1 ? "s" : "")@(total > 0 ? $" · boucle de {Helpers.FormatDuration(total)}" : "")</p>
                    @if (outside > 0) { <p class="sub" role="note"><Ico Name="monitor" Size="14" /> Cette liste est aussi diffusée sur @outside écran@(outside > 1 ? "s" : "") hors de votre périmètre : vos modifications les concerneront à leur prochaine publication.</p> }
                </div>
                @if (pl.Draft.Count > 0) { <button type="button" class="btn ghost" @onclick="() => trying = true"><Ico Name="play" Size="16" /> Essayer sur…</button> }
            </div>

            @* Frise de la boucle : chaque contenu diffusé y prend une place proportionnelle à sa durée *@
            <div class="pf-strip-wrap">
                <div class="pf-strip-top">
                    <span class="lbl">Une boucle dure <b>@Helpers.FormatDuration(total)</b> puis recommence au contenu 1</span>
                    <div class="pf-seg" role="group" aria-label="Affichage du fil">
                        <button type="button" class="@(view == "lines" ? "on" : "")" aria-pressed="@(view == "lines" ? "true" : "false")" @onclick='() => SetView("lines")'><Ico Name="menu" Size="14" /> Lignes</button>
                        <button type="button" class="@(view == "cards" ? "on" : "")" aria-pressed="@(view == "cards" ? "true" : "false")" @onclick='() => SetView("cards")'><Ico Name="grid" Size="14" /> Cartes</button>
                    </div>
                </div>
                <div class="pf-strip">
                    @foreach (var r in rows.Where(r => r.Plays))
                    {
                        var row = r;
                        <button type="button" class="@(row.It.Id == freshId ? "new" : "")" style="flex:@Math.Max(1, row.Seconds);background:@row.Color" title="@row.Num. @row.M?.Name · @Helpers.FormatDuration(row.Seconds)" @onclick="() => Reveal(row.It.Id)">@row.Num@(total > 0 && row.Seconds * 100 >= total * 12 ? $" {row.M?.Name}" : "")</button>
                    }
                </div>
                <div class="pf-ticks">@foreach (var f in new[] { 0, .25, .5, .75, 1 }) { <span>@Helpers.FormatDuration((int)Math.Round(total * f))</span> }</div>
            </div>

            <div class="pf-flow @view">
                @foreach (var r in rows)
                {
                    var row = r;
                    <div class="pf-u @RowClass(row)" data-i="@row.Index" data-id="@row.It.Id" draggable="@(Draggable(row) ? "true" : "false")" @key="row.It">
                        @if (view == "lines")
                        {
                            <div class="pf-rail"><span class="pf-num">@row.Num</span>@if (row.When.Length > 0) { <span class="t">@row.When</span> }</div>
                            <div class="pf-it">
                                <span class="h" aria-hidden="true"><Ico Name="grip" Size="16" /></span>
                                @Thumb(row)
                                @Info(row)
                                @if (ScanOn(row)) { @Scan(row) } else { <span class="pf-scan none" aria-hidden="true">—</span> }
                                <div class="pf-dur">@Dur(row)<small>durée</small></div>
                                @Kebab(row)
                            </div>
                        }
                        else
                        {
                            <div class="pf-c">
                                <div class="pf-cth">
                                    @Thumb(row)
                                    <span class="pf-num">@row.Num</span>
                                    @if (durFor != row.It && DurationText(row) is { Length: > 0 } dt) { <span class="pf-tdur">@dt</span> }
                                    @if (ScanOn(row)) { <span class="pf-tscan">@Scan(row)</span> }
                                </div>
                                <div class="pf-cb">
                                    <div>
                                        @Info(row)
                                        @if (durFor == row.It) { <div class="pf-dur">@Dur(row)</div> }
                                        <span class="start">@(row.Plays ? $"démarre à {Helpers.FormatDuration(row.Start)}" : row.Hold ? "hors période de diffusion" : row.It.Off ? "ignoré dans la boucle" : row.Incomplete ? "à configurer" : row.It.Placement != "full" ? "affiché en continu" : "")</span>
                                    </div>
                                    @Kebab(row)
                                </div>
                            </div>
                        }
                    </div>
                }
                @if (!readOnlyHere)
                {
                    @if (view == "lines")
                    {
                        <div class="pf-u pf-end-row">
                            <div class="pf-rail"><span class="pf-loop"><Ico Name="refresh" Size="16" /></span><span class="t">@Helpers.FormatDuration(total)</span></div>
                            <div class="pf-end"><Ico Name="plus" Size="16" /> @(pl.Draft.Count == 0 ? "Glissez une app ici pour commencer la liste de lecture" : "Glissez une app ici pour l'ajouter à la fin · ensuite la boucle recommence au contenu 1")</div>
                        </div>
                    }
                    else
                    {
                        <div class="pf-u pf-end-row">
                            <div class="pf-end"><span class="pf-loop"><Ico Name="refresh" Size="16" /></span>Glissez une app ici<small>@(pl.Draft.Count == 0 ? "pour commencer la liste de lecture" : "ajout à la fin · la boucle recommence ensuite")</small></div>
                        </div>
                    }
                }
            </div>
        </div>
    </div>
}
else
{
    <div class="card empty"><div class="big">Liste de lecture introuvable</div><p>Elle a peut-être été supprimée. <button type="button" class="back" @onclick="Close">Revenir aux listes de lecture</button></p></div>
}

@{
    // Onglets « Contenu / QR code » de la fenêtre d'un contenu, en tête de la colonne de droite (comme « Écran / Widgets » de l'éditeur d'écran).
    // Partagés par la création (galerie → fenêtre de l'app) et par la fenêtre de réglage d'un contenu existant.
    var qrAngle = mPlacement != "full";   // un contenu en angle ou en bandeau n'a pas de QR code : l'onglet est grisé
    var qrScans = mItem != null && scanCounts.TryGetValue(mItem.Id, out var qc) ? qc.Scans : 0;
    RenderFragment qrTabs = @<div class="se-utabs" role="tablist" aria-label="Réglage du contenu">
        <button type="button" role="tab" aria-selected="@(mTab == "content" ? "true" : "false")" class="@(mTab == "content" ? "on" : "")" @onclick='() => mTab = "content"'><Ico Name="monitor" Size="18" /> Contenu</button>
        @if (mItem != null)
        {
            <button type="button" role="tab" aria-selected="@(mTab == "prog" ? "true" : "false")" class="@(mTab == "prog" ? "on" : "")" @onclick='() => mTab = "prog"'>
                <Ico Name="calendar" Size="18" /> Programmation
                @if (mSchedOn) { <span class="tab-dot" title="Une période est définie"></span> }
            </button>
        }
        <button type="button" role="tab" aria-selected="@(mTab == "qr" ? "true" : "false")" class="@(mTab == "qr" && !qrAngle ? "on" : "")" disabled="@qrAngle"
                title="@(qrAngle ? "Le QR code n'est disponible que pour un contenu en pleine page." : "")" @onclick='() => mTab = "qr"'>
            <Ico Name="qr" Size="18" /> QR code
            @if (!growth) { <span class="tab-lock"><Ico Name="lock" Size="12" /> Pro</span> }
            else if (mQrOn && qrScans > 0) { <small class="on-badge">@qrScans</small> }
        </button>
    </div>;
    // Onglet « Programmation » : période de diffusion du contenu (début et fin facultatifs), colonne de droite comme « QR code »
    RenderFragment progPane = @<div class="ci-prog">
        <h4 class="ci-t">Période de diffusion</h4>
        <div class="ci-seg" role="radiogroup" aria-label="Période de diffusion">
            <button type="button" role="radio" aria-checked="@(mSchedOn ? "false" : "true")" class="@(mSchedOn ? "" : "on")" @onclick="() => mSchedOn = false">Toujours</button>
            <button type="button" role="radio" aria-checked="@(mSchedOn ? "true" : "false")" class="@(mSchedOn ? "on" : "")" @onclick="() => mSchedOn = true">Période</button>
        </div>
        @if (mSchedOn)
        {
            <div class="ci-sched">
                <div class="ci-sched-row"><b>Début</b><input type="date" aria-label="Date de début" value="@mFromDate" @onchange='e => mFromDate = e.Value?.ToString() ?? ""' /><input type="time" aria-label="Heure de début" value="@mFromTime" @onchange='e => mFromTime = e.Value?.ToString() ?? ""' /></div>
                <div class="ci-sched-row"><b>Fin</b><input type="date" aria-label="Date de fin" value="@mToDate" @onchange='e => mToDate = e.Value?.ToString() ?? ""' /><input type="time" aria-label="Heure de fin" value="@mToTime" @onchange='e => mToTime = e.Value?.ToString() ?? ""' /></div>
                <p class="hint">Laissez un champ vide pour ne pas limiter de ce côté. Heure de l'écran.</p>
                <div class="ci-sched-sum">@ScheduleSummary()</div>
            </div>
        }
        else { <p class="hint">Le contenu passe en boucle sans limite de date.</p> }
    </div>;
    RenderFragment qrPreview = @<div>
        <h4 class="ci-t">Aperçu de l'écran</h4>
        <QrPlacer Media="(newForm ?? itemForm)?.PickedMedia() ?? mMedia" Fit="@((newForm ?? itemForm)?.PreviewFit ?? "contain")" All="media" Text="@(growth && mQrOn ? QrText : null)" X="mQrX" Y="mQrY" Size="mQrSize" Label="@mQrLabel" OnMoved="QrMoved" />
    </div>;
    RenderFragment qrPane = @<div class="ci-qr">
        <div class="ci-qr-master">
            <div><b>Compter les scans du QR code</b><small>Un QR code est ajouté au contenu ; chaque scan est comptabilisé.</small></div>
            <input type="checkbox" class="ios" checked="@(growth && mQrOn)" disabled="@(!growth)" aria-label="Compter les scans du QR code" @onchange="e => ToggleQr(e.Value is true)" />
        </div>
        @if (!growth) { <div class="ci-qr-locked">@Plans.LockedHint.</div> }
        else
        {
            <div class="qr-fields @(mQrOn ? "" : "off")" inert="@(!mQrOn)">
                <div class="dw-field"><label for="qr-url">Adresse de destination *</label><input id="qr-url" type="text" inputmode="url" maxlength="@QrTracking.UrlMax" placeholder="https://…" @bind="mQrUrl" @bind:event="oninput" /></div>
                <div class="dw-field"><label for="qr-lbl">Texte sous le QR code</label><input id="qr-lbl" type="text" maxlength="@QrTracking.LabelMax" @bind="mQrLabel" @bind:event="oninput" /></div>
                <div class="dw-field"><label for="qr-size">Taille <span class="mono">@Math.Round(mQrSize) %</span></label><input id="qr-size" type="range" min="@QrTracking.MinSize" max="@QrTracking.MaxSize" step="1" value="@Math.Round(mQrSize)" @oninput="ChangeQrSize" /></div>
            </div>
        }
    </div>;
    // l'onglet ouvert remplace la colonne de configuration : « QR code » ou « Programmation » (sans aperçu du contenu pour ce dernier)
    bool otherOpen = (mTab == "qr" && !qrAngle) || (mTab == "prog" && mItem != null);
    RenderFragment otherPane = mTab == "prog" ? progPane : qrPane;
    RenderFragment? otherPreview = mTab == "prog" ? null : qrPreview;
}

@if (newApp != null && Current is { } target)
{
    var a = newApp;
    <div class="modal-backdrop" @onclick="() => newApp = null"></div>
    <div class="modal app-modal ci-modal" role="dialog" aria-modal="true" aria-labelledby="new-app-title">
        <div class="modal-head">
            <AppIcon Id="@a.Id" />
            <div class="grow">
                <div class="ci-title"><h3 id="new-app-title">@(newName ?? a.Name)</h3> <button type="button" class="btn ghost sm icon" title="Renommer" aria-label="Renommer" @onclick="() => newForm?.OpenRename()"><Ico Name="edit" Size="15" /></button></div>
                <small>Ajout à « @target.Name »</small>
            </div>
            @if (a.HasAdvanced) { <button type="button" class="modal-x" aria-label="Options avancées" title="Options avancées" @onclick="() => newForm?.OpenAdvanced()"><Ico Name="sliders" Size="20" /></button> }
            <button type="button" class="modal-x" aria-label="Fermer" @onclick="() => newApp = null"><Ico Name="x" Size="20" /></button>
        </div>
        <div class="modal-body">
            <AppInstanceForm @key="a.Id" AppId="@a.Id" ShowActions="false" OnSaved="item => AddApp(target, item)" OnRenamed="n => newName = n" @ref="newForm"
                             ConfTabs="qrTabs" OtherTab="@otherOpen" OtherPane="@otherPane" OtherPreview="@otherPreview" PreviewQr="PreviewQr" PreviewPortrait="portraitScreens" PreviewPlace="mPlacement" />
</div>
        <div class="modal-foot">
            <button class="btn ghost" @onclick="() => newApp = null">Annuler</button>
            @if (AppInstanceForm.NeedsTest(a)) { <button class="btn ghost" @onclick="() => newForm!.Test()">Tester</button> }
            <button class="btn" @onclick="SaveNew">Ajouter à la liste de lecture</button>
        </div>
    </div>
}

@if (pickCompo && Current is { } cpl)
{
    @* Compositions (§80) : celles de « Mes compositions » se choisissent ici ; une nouvelle s'ajoute dès son premier enregistrement. *@
    <div class="modal-backdrop" @onclick="() => pickCompo = false"></div>
    <div class="modal app-modal" role="dialog" aria-modal="true" aria-labelledby="cmp-pick-title" style="max-width:760px">
        <div class="modal-head">
            <AppIcon Id="@Compositions.AppId" />
            <div class="grow"><h3 id="cmp-pick-title">Ajouter une composition</h3><small>À « @cpl.Name »</small></div>
            <button type="button" class="modal-x" aria-label="Fermer" @onclick="() => pickCompo = false"><Ico Name="x" Size="20" /></button>
        </div>
        <div class="modal-body">
            @if (compoItems.Count == 0)
            {
                <div class="empty compact"><div class="big">Aucune composition</div><p>Créez-en une : elle sera enregistrée dans « Mes compositions » et ajoutée à cette liste.</p></div>
            }
            else
            {
                <p class="hint">Choisissez une composition de « Mes compositions ». Elle peut aussi servir dans d'autres listes.</p>
                <div class="cmp-pick">
                    @foreach (var c in compoItems)
                    {
                        var ci = c;
                        <button type="button" class="cmp-choice" @onclick="() => AddComposition(ci)">
                            <CompositionThumb Item="ci" Files="compoFiles" Label="@("Aperçu de " + ci.Name)" />
                            <span><b>@ci.Name</b>@if (Compositions.Size(ci.Settings) is { } sz) { <small>@sz.W × @sz.H</small> }</span>
                        </button>
                    }
                </div>
            }
        </div>
        <div class="modal-foot">
            <button class="btn ghost" @onclick="() => pickCompo = false">Annuler</button>
            <a class="btn" href="@NewCompositionUrl"><Ico Name="plus" Size="16" /> Créer une composition</a>
        </div>
    </div>
}

@if (mItem != null && mPlaylist != null)
{
    var isApp = mMedia?.AppId != null;
    <div class="modal-backdrop" @onclick="CloseSettings"></div>
    <div class="modal @(isApp ? "app-modal ci-modal" : "")" role="dialog" aria-modal="true" aria-labelledby="modal-title">
        @if (isApp)
        {
            <div class="modal-head">
                <AppIcon Id="@mMedia!.AppId" />
                <div class="grow">
                    <div class="ci-title"><h3 id="modal-title">@(itemName ?? mMedia.Name)</h3> <button type="button" class="btn ghost sm icon" title="Renommer" aria-label="Renommer" @onclick="() => itemForm?.OpenRename()"><Ico Name="edit" Size="15" /></button></div>
                    <small>@Svc.Find(mMedia.AppId)?.Name</small>
                </div>
                @if (Svc.Find(mMedia.AppId) is { HasAdvanced: true }) { <button type="button" class="modal-x" aria-label="Options avancées" title="Options avancées" @onclick="() => itemForm?.OpenAdvanced()"><Ico Name="sliders" Size="20" /></button> }
                <button type="button" class="modal-x" aria-label="Fermer" @onclick="CloseSettings"><Ico Name="x" Size="20" /></button>
            </div>
        }
        else
        {
            <h3 id="modal-title">Paramètres du contenu</h3>
            <p class="hint"><b>@mMedia?.Name</b> · @(mMedia?.Type == "video" ? "vidéo" : "image")</p>
        }
        @* réglages de ce contenu dans la liste (position, durée) : pour une app, à droite de l'aperçu (colonne de configuration), sinon sous le titre *@
        @{
            RenderFragment listSettings = @<div class="dw">
            @if (mMedia?.Type == "app")
            {
                <div class="dw-field">
                    <label>Position à l'écran</label>
                    <select @bind="mPlacement">
                        @foreach (var o in PlacementsFor(mMedia)) { <option value="@o.Id">@o.Label</option> }
                    </select>
                    <small>Pleine page : le contenu passe à son tour dans la boucle. Angle ou bandeau : il reste affiché en permanence.</small>
                </div>
            }
            @if (mPlacement != "full")
            {
                <div class="dw-note">Ce contenu reste affiché en permanence pendant toute la boucle : il n'a pas de durée.</div>
            }
            else if (ContentDuration(mMedia))
            {
                <div class="dw-field">
                    <label>Durée d'affichage</label>
                    <select value="@mMode" @onchange="ChangeMode">
                        <option value="content" selected="@(mMode == "content")">Jusqu'à la fin du contenu</option>
                        <option value="fixed" selected="@(mMode == "fixed")">Durée fixe</option>
                    </select>
                    @if (Helpers.VideoSeconds(mMedia) is { } vs) { <small>Durée de la vidéo : @Helpers.FormatDuration(vs).</small> }
                    <small>« Jusqu'à la fin » passe au contenu suivant à la fin de la vidéo (dans la limite de la durée maximale de l'app). « Durée fixe » coupe ou rejoue la vidéo à ce terme.</small>
                </div>
                @if (mMode == "fixed")
                {
                    <div class="dw-field"><label>Durée fixe (secondes)</label><input type="number" min="1" max="86400" @bind="mSeconds" /></div>
                }
            }
            else
            {
                <div class="dw-field"><label>Durée d'affichage (secondes)</label><input type="number" min="1" max="86400" @bind="mSeconds" /></div>
            }
            </div>;
            RenderFragment appExtra = @<section class="ci-listset" aria-label="Dans cette liste de lecture"><h4 class="ci-t">Dans cette liste de lecture</h4>@listSettings</section>;
        }
        @if (isApp)
        {
            <div class="modal-body">
                <AppInstanceForm @key="mMedia!.Id" AppId="@(mMedia!.AppId!)" InstanceId="mMedia!.Id" ShowActions="false" OnSaved="_ => SaveSettings()" OnRenamed="n => itemName = n" Extra="appExtra" ConfTabs="qrTabs" OtherTab="@otherOpen" OtherPane="@otherPane" OtherPreview="@otherPreview" PreviewQr="PreviewQr" PreviewPortrait="portraitScreens" PreviewPlace="mPlacement" OnOpenEditor="OpenCompositionEditor" @ref="itemForm" />
            </div>
        }
        else if (mItem != null)
        {
            @* contenu d'une image ou d'une vidéo : deux onglets, comme ceux d'une app (Contenu / Programmation) *@
            <div class="se-utabs" role="tablist" aria-label="Réglage du contenu">
                <button type="button" role="tab" aria-selected="@(mTab == "prog" ? "false" : "true")" class="@(mTab == "prog" ? "" : "on")" @onclick='() => mTab = "content"'><Ico Name="monitor" Size="18" /> Contenu</button>
                <button type="button" role="tab" aria-selected="@(mTab == "prog" ? "true" : "false")" class="@(mTab == "prog" ? "on" : "")" @onclick='() => mTab = "prog"'>
                    <Ico Name="calendar" Size="18" /> Programmation
                    @if (mSchedOn) { <span class="tab-dot" title="Une période est définie"></span> }
                </button>
            </div>
            @if (mTab == "prog") { @progPane } else { @listSettings }
        }
        else { @listSettings }
        <div class="@(isApp ? "modal-foot" : "modal-actions")">
            <button class="btn ghost" @onclick="CloseSettings">Annuler</button>
            @if (isApp && Svc.Find(mMedia!.AppId) is { } ma && AppInstanceForm.NeedsTest(ma)) { <button class="btn ghost" @onclick="() => itemForm!.Test()">Tester</button> }
            <button class="btn" @onclick="SaveAll">Enregistrer</button>
        </div>
    </div>
}

@if (trying)
{
    <SimulatorDialog PlaylistId="Id" OnClose="() => trying = false" />
}

@code {
    [Parameter] public Guid Id { get; set; }
    [Parameter] public EventCallback OnClose { get; set; }
    private Task Close() => OnClose.InvokeAsync();

    private List<Playlist> playlists = new();
    private List<MediaItem> media = new();
    private bool trying;   // « Essayer sur… » : simulateur de la liste


    // Ajout d'un contenu : colonne des apps activées (hors widgets d'écran), à glisser dans le fil ou à cliquer (ajout à la fin).
    private List<AppManifest> enabledApps = new();
    private string appSearch = "";
    private int? insertAt;   // position d'insertion ; null : à la fin
    private AppManifest? newApp;
    private AppInstanceForm? newForm, itemForm;
    private string? newName, itemName;   // nom modifié par le bouton « Renommer » du bandeau (titre de la fenêtre)

    private IEnumerable<AppManifest> PickerApps => enabledApps
        .Where(a => appSearch.Length == 0 || a.Name.Contains(appSearch, StringComparison.OrdinalIgnoreCase) || (a.Summary ?? "").Contains(appSearch, StringComparison.OrdinalIgnoreCase));

    // Groupes de la colonne : les médias d'abord, puis le web ; les autres catégories ensuite, par ordre alphabétique
    private static readonly string[] GroupOrder = { "Médiathèque", "Drive", "Web", "Service en ligne" };
    private IEnumerable<IGrouping<string, AppManifest>> AppGroups() => PickerApps
        .GroupBy(a => string.IsNullOrEmpty(a.Category) ? "Autres" : a.Category)
        .OrderBy(g => Array.IndexOf(GroupOrder, g.Key) is var k && k >= 0 ? k : GroupOrder.Length)
        .ThenBy(g => g.Key, StringComparer.CurrentCultureIgnoreCase);

    /// <summary>Ajoute à la liste de lecture un contenu de l'app, à vide (à la position donnée, par défaut à la fin) ; l'utilisateur le complète ensuite.</summary>
    private void AddEmpty(AppManifest app, int? position)
    {
        if (Current is not { } pl) return;
        if (app.Id == Compositions.AppId) { OpenCompositionPicker(position); return; }   // on choisit une composition existante, ou on en crée une
        if (Svc.CreateEmpty(app.Id) is not { } item) { Toast.Error("Activez d'abord cette intégration dans la page Intégrations."); return; }
        var dur = Store.Read(d => d.Tenant.DefaultDurationSec);
        var placement = PlacementsFor(item).Select(o => o.Id).DefaultIfEmpty("full").Contains("full") ? "full" : PlacementsFor(item).First().Id;
        var at = position is { } i && i >= 0 && i < pl.Draft.Count ? i : pl.Draft.Count;
        var row = new PlaylistItem { MediaId = item.Id, DurationSec = dur, Placement = placement };
        WriteList(d =>
        {
            pl.Draft.Insert(at, row);
            pl.Touch();
        });
        Toast.Ok($"« {app.Name} » ajouté en position {at + 1} : cliquez sur « Configurer » pour choisir son contenu.");
        Reload();
        Flash(row.Id);
    }

