    // Combien de fois une vignette est déjà dans le fil
    private int UsedFile(Guid fileId) => Current?.Draft.Count(i => media.FirstOrDefault(x => x.Id == i.MediaId) is { } m && m.Settings.GetValueOrDefault("media") == fileId.ToString()) ?? 0;
    private int UsedItem(Guid id) => Current?.Draft.Count(i => i.MediaId == id) ?? 0;
    private int UsedApp(string appId) => Current?.Draft.Count(i => media.FirstOrDefault(x => x.Id == i.MediaId)?.AppId == appId) ?? 0;

    // Vignette de la bibliothèque : un clic ajoute (à la fin, ou à l'endroit choisi par « + »), on peut aussi la glisser dans le fil.
    // Aperçu : l'icône de l'intégration (appId), une composition, ou la vignette du média ou du contenu.
    private RenderFragment Tile(string drag, string name, string sub, MediaItem? m, string? appId, Action add, int used, bool busy = false, bool fresh = false, string? len = null) =>
        @<button type="button" class="pfx-tile @(fresh ? "fresh" : "") @(busy ? "busy" : "")" data-add="@(busy ? null : drag)" data-fresh="@(fresh ? "1" : null)" disabled="@busy"
                 title="@(busy ? "Conversion en cours : le média sera ajoutable dans un instant" : $"Ajouter « {name} »{(pickAt is { } p ? $" en position {p + 1}" : " à la fin")}")" @onclick="add">
            <span class="pfx-tb">
                @if (appId != null) { <span class="pfx-app" style="background:@AppIcon.LookOf(appId).Color"><AppIcon Id="@appId" Tile="false" Size="34" /></span> }
                else if (m?.AppId == Compositions.AppId) { <CompositionThumb Item="m" Files="compoFiles" Contain="true" /> }
                else if (m != null) { <MediaThumb Media="m" All="media" /> }
                @if (used > 0) { <span class="pfx-used">dans le fil ×@used</span> }
                @if (fresh) { <span class="pfx-new">Nouveau</span> }
                @if (len != null) { <span class="pfx-len mono">@len</span> }
                <span class="pfx-add" aria-hidden="true"><span><Ico Name="plus" Size="12" /> @(pickAt is { } p2 ? $"Insérer en {p2 + 1}" : "Ajouter à la fin")</span></span>
            </span>
            <span class="pfx-tn">@name</span>
            <span class="pfx-ts">@sub</span>
        </button>;

