@page "/playlists/{Id:guid}"
@attribute [Microsoft.AspNetCore.Authorization.Authorize(Policy = "ClientSpace")]
@inject TenantStore Store
@inject AppService Svc
@inject CanvaService Canva
@inject IJSRuntime JS
@inject Toaster Toast
@using Microsoft.JSInterop
@implements IDisposable

<div class="page-head">
    <div class="grow" style="min-width:0">
        <a class="back" href="/playlists">← Listes de lecture</a>
        @if (renaming && Current is { } rp)
        {
            <div class="row rename-row">
                <input class="grow" style="min-width:0" @ref="renameInput" @bind="renameValue" @bind:event="oninput" @onkeydown="e => OnRenameKey(e, rp)" aria-label="Nom de la liste de lecture" />
                <button class="btn sm" @onclick="() => Rename(rp)">Enregistrer</button>
                <button class="btn ghost sm" @onclick="() => renaming = false">Annuler</button>
            </div>
        }
        else
        {
            <div class="row" style="gap:12px">
                <h1>@(Current?.Name ?? "Liste de lecture")</h1>
                @if (Current is { } cp) { <button class="btn ghost sm" @onclick="() => StartRename(cp)"><Ico Name="edit" Size="15" /> Renommer</button> }
            </div>
        }
        <p class="sub">Composez la boucle de contenus. La diffusion se publie écran par écran, depuis la page Écrans.</p>
    </div>
</div>

<YoutubeDurations Items="media" OnUpdated="Refresh" />

<div class="pe-main">
    @if (Current is { } pl)
    {
        <div class="card">
            <div class="pe-head">
                <h3>@pl.Draft.Count contenu@(pl.Draft.Count > 1 ? "s" : "")</h3>
                @if (LoopSeconds(pl) is > 0 and var loop) { <span class="pe-total" title="Durée d'un tour complet de la boucle (contenus pleine page)"><Ico Name="clock" Size="15" /> Boucle <b class="mono">@Helpers.FormatDuration(loop)</b></span> }
                <span class="grow"></span>
                @if (pl.Draft.Count > 0) { <button type="button" class="btn ghost" title="Jouer la liste dans son état actuel, sur un écran ou un mur simulé" @onclick="() => trying = true"><Ico Name="play" Size="16" /> Essayer sur…</button> }
                <button type="button" class="btn" @onclick="() => OpenPicker(null)"><Ico Name="plus" Size="16" /> Ajouter un contenu</button>
            </div>

            @if (pl.Draft.Count == 0)
            {
                <div class="empty"><div class="big">Liste de lecture vide</div><p>Ajoutez une app : Image, Vidéo et Diaporamas utilisent les fichiers de la médiathèque.</p></div>
            }
            <div class="sort-list" @ref="sortList">
            @for (var i = 0; i < pl.Draft.Count; i++)
            {
                var idx = i;
                var it = pl.Draft[idx];
                var m = media.FirstOrDefault(x => x.Id == it.MediaId);
                <div class="item-row" data-sort-row @key="it">
                    @if (idx > 0)
                    {
                        @* entre deux lignes : insérer un contenu à cet endroit *@
                        <button type="button" class="item-insert" title="Insérer un contenu ici" aria-label="Insérer un contenu avant « @(m?.Name ?? "ce contenu") »" @onclick="() => OpenPicker(idx)"><span><Ico Name="plus" Size="13" /> Insérer ici</span></button>
                    }
                    <div class="idx"><span class="n">@(idx + 1)</span><span class="grip" title="Glisser pour déplacer"><Ico Name="grip" Size="16" /></span></div>
                    <div class="th">
                        @if (m != null) { <MediaThumb Media="m" All="media" /> }
                        @if (Helpers.YoutubeBadge(m) is { } badge) { <span class="dur">@badge</span> }
                    </div>
                    @{ var kind = m?.AppId != null ? Svc.Find(m.AppId)?.Name ?? "App" : m?.Type == "video" ? "Vidéo" : "Image"; }
                    @if (m != null)
                    {
                        @* nom et type : accès direct aux paramètres du contenu *@
                        <button type="button" class="item-open" title="Paramètres de « @m.Name »" @onclick="() => OpenSettings(pl, it, m)">
                            <b>@m.Name</b>
                            <span class="item-kind"><Ico Name="sliders" Size="13" /> @kind@(it.Placement != "full" ? " · incrusté en permanence" : "")</span>
                        </button>
                    }
                    else { <div><b>(supprimé)</b></div> }
                    <div class="dur-cell mono" title="Temps alloué à ce contenu">@Duration(it, m)</div>
                    <div class="kebab">
                        <button type="button" class="kebab-btn" aria-label="Actions pour @(m?.Name ?? "ce contenu")" aria-haspopup="menu" aria-expanded="@(menuFor == it ? "true" : "false")"
                                @onclick="() => menuFor = menuFor == it ? null : it"><Ico Name="dots-v" Size="18" /></button>
                        @if (menuFor == it)
                        {
                            <div class="kebab-backdrop" @onclick="() => menuFor = null"></div>
                            <div class="kebab-menu" role="menu">
                                @if (m != null) { <button type="button" role="menuitem" @onclick="() => { menuFor = null; OpenSettings(pl, it, m); }"><Ico Name="sliders" Size="16" /> Paramètres</button> }
                                @if (idx > 0) { <button type="button" role="menuitem" @onclick="() => { menuFor = null; Move(pl, idx, -1); }"><Ico Name="arrow-up" Size="16" /> Monter</button> }
                                @if (idx < pl.Draft.Count - 1) { <button type="button" role="menuitem" @onclick="() => { menuFor = null; Move(pl, idx, 1); }"><Ico Name="arrow-down" Size="16" /> Descendre</button> }
                                <button type="button" role="menuitem" class="danger" @onclick="() => { menuFor = null; RemoveItem(pl, it); }"><Ico Name="trash" Size="16" /> Retirer</button>
                            </div>
                        }
                    </div>
                </div>
            }
            </div>
            <button type="button" class="pe-add-end" @onclick="() => OpenPicker(null)"><Ico Name="plus" Size="18" /> Ajouter un contenu@(pl.Draft.Count > 0 ? " à la fin" : "")</button>
        </div>
    }
    else
    {
        <div class="card empty"><div class="big">Liste de lecture introuvable</div><p>Elle a peut-être été supprimée. <a href="/playlists">Revenir aux listes de lecture</a></p></div>
    }
</div>

@if (picking && Current is { } dest)
{
    @* Galerie des apps activées : recherche, catégories, puis la fenêtre de paramétrage de l'app choisie *@
    <div class="modal-backdrop" @onclick="() => picking = false"></div>
    <div class="modal app-modal wide pk-modal" role="dialog" aria-modal="true" aria-labelledby="pk-title">
        <div class="modal-head">
            <div class="grow">
                <h3 id="pk-title">Ajouter un contenu à « @dest.Name »</h3>
                <small>@(insertAt is { } at && at < dest.Draft.Count ? $"Inséré en position {at + 1}" : "Ajouté à la fin de la liste de lecture")</small>
            </div>
            <button type="button" class="modal-x" aria-label="Fermer" @onclick="() => picking = false"><Ico Name="x" Size="20" /></button>
        </div>
        <div class="modal-body">
            @if (enabledApps.Count == 0)
            {
                <p class="hint">Aucune intégration activée. <a href="/integrations">Choisissez-les dans la page Intégrations</a>.</p>
            }
            else
            {
                <div class="search-box">
                    <Ico Name="search" Size="16" />
                    <input placeholder="Rechercher une app" aria-label="Rechercher une app" @bind="appSearch" @bind:event="oninput" @ref="pickSearch" />
                </div>
                <div class="pk-cats" role="tablist" aria-label="Catégories">
                    <button type="button" role="tab" class="@(appCat == "" ? "on" : "")" aria-selected="@(appCat == "" ? "true" : "false")" @onclick='() => appCat = ""'>Toutes</button>
                    @foreach (var c in enabledApps.Select(a => a.Category).Where(c => !string.IsNullOrEmpty(c)).Distinct().Order())
                    {
                        var cat = c;
                        <button type="button" role="tab" class="@(appCat == cat ? "on" : "")" aria-selected="@(appCat == cat ? "true" : "false")" @onclick="() => appCat = cat">@cat</button>
                    }
                </div>
                <div class="pk-grid">
                    @foreach (var a in PickerApps)
                    {
                        var app = a;
                        <button type="button" class="pk-tile" @onclick="() => PickApp(app)">
                            <AppIcon Id="@app.Id" Connected="@(app.Id == "canva" ? Canva.ConnectionOf(Store.ClientId).Connected : null)" />
                            <span><b>@app.Name</b><small>@app.Summary</small></span>
                        </button>
                    }
                </div>
                @if (!PickerApps.Any()) { <p class="hint">Aucune app ne correspond.</p> }
                <p class="hint" style="margin-top:14px">D'autres intégrations s'activent dans la page <a href="/integrations">Intégrations</a>.</p>
            }
        </div>
    </div>
}


@if (newApp != null && Current is { } target)
{
    var a = newApp;
    <div class="modal-backdrop" @onclick="() => newApp = null"></div>
    <div class="modal app-modal wide" role="dialog" aria-modal="true" aria-labelledby="new-app-title">
        <div class="modal-head">
            <AppIcon Id="@a.Id" />
            <div class="grow">
                <h3 id="new-app-title">@a.Name</h3>
                <small>Ajout à « @target.Name »</small>
            </div>
            <button type="button" class="modal-x" aria-label="Fermer" @onclick="() => newApp = null"><Ico Name="x" Size="20" /></button>
        </div>
        <div class="modal-body">
            <AppInstanceForm @key="a.Id" AppId="@a.Id" ShowActions="false" OnSaved="item => AddApp(target, item)" @ref="newForm" />
        </div>
        <div class="modal-foot">
            <button class="btn ghost" @onclick="() => newApp = null">Annuler</button>
            @if (a.Provider != null) { <button class="btn ghost" @onclick="() => newForm!.Test()">Tester</button> }
            <button class="btn" @onclick="() => newForm!.Save()">Ajouter à la liste de lecture</button>
        </div>
    </div>
}

@if (mItem != null && mPlaylist != null)
{
    var isApp = mMedia?.AppId != null;
    <div class="modal-backdrop" @onclick="CloseSettings"></div>
    <div class="modal @(isApp ? "app-modal wide" : "")" role="dialog" aria-modal="true" aria-labelledby="modal-title">
        @if (isApp)
        {
            <div class="modal-head">
                <AppIcon Id="@mMedia!.AppId" />
                <div class="grow">
                    <h3 id="modal-title">@mMedia.Name</h3>
                    <small>@Svc.Find(mMedia.AppId)?.Name</small>
                </div>
                <button type="button" class="modal-x" aria-label="Fermer" @onclick="CloseSettings"><Ico Name="x" Size="20" /></button>
            </div>
        }
        else
        {
            <h3 id="modal-title">Paramètres du contenu</h3>
            <p class="hint"><b>@mMedia?.Name</b> · @(mMedia?.Type == "video" ? "vidéo" : "image")</p>
        }
        <div class="@(isApp ? "modal-body" : "")">
        @if (isApp)
        {
            <AppInstanceForm @key="mMedia!.Id" AppId="@(mMedia!.AppId!)" InstanceId="mMedia!.Id" ShowActions="false" OnSaved="_ => SaveSettings()" @ref="itemForm" />
            <h4 class="pe-sub">Dans cette liste de lecture</h4>
        }
        <div class="dw">
            @if (mMedia?.Type == "app")
            {
                <div class="dw-field">
                    <label>Position à l'écran</label>
                    <select @bind="mPlacement">
                        @foreach (var o in PlacementsFor(mMedia)) { <option value="@o.Id">@o.Label</option> }
                    </select>
                    <small>Pleine page : le contenu passe à son tour dans la boucle. Angle ou bandeau : il reste affiché en permanence.</small>
                </div>
            }
            @if (mPlacement != "full")
            {
                <div class="dw-note">Ce contenu reste affiché en permanence pendant toute la boucle : il n'a pas de durée.</div>
            }
            else if (ContentDuration(mMedia))
            {
                <div class="dw-field">
                    <label>Durée d'affichage</label>
                    <select value="@mMode" @onchange="ChangeMode">
                        <option value="content" selected="@(mMode == "content")">Jusqu'à la fin du contenu</option>
                        <option value="fixed" selected="@(mMode == "fixed")">Durée fixe</option>
                    </select>
                    @if (Helpers.VideoSeconds(mMedia) is { } vs) { <small>Durée de la vidéo : @Helpers.FormatDuration(vs).</small> }
                    <small>« Jusqu'à la fin » passe au contenu suivant à la fin de la vidéo (dans la limite de la durée maximale de l'app). « Durée fixe » coupe ou rejoue la vidéo à ce terme.</small>
                </div>
                @if (mMode == "fixed")
                {
                    <div class="dw-field"><label>Durée fixe (secondes)</label><input type="number" min="1" max="86400" @bind="mSeconds" /></div>
                }
            }
            else
            {
                <div class="dw-field"><label>Durée d'affichage (secondes)</label><input type="number" min="1" max="86400" @bind="mSeconds" /></div>
            }
        </div>
        </div>
        <div class="@(isApp ? "modal-foot" : "modal-actions")">
            <button class="btn ghost" @onclick="CloseSettings">Annuler</button>
            @if (isApp && Svc.Find(mMedia!.AppId)?.Provider != null) { <button class="btn ghost" @onclick="() => itemForm!.Test()">Tester</button> }
            <button class="btn" @onclick="SaveAll">Enregistrer</button>
        </div>
    </div>
}

@if (trying)
{
    <SimulatorDialog PlaylistId="Id" OnClose="() => trying = false" />
}

@code {
    [Parameter] public Guid Id { get; set; }

    private List<Playlist> playlists = new();
    private List<MediaItem> media = new();
    private bool trying;   // « Essayer sur… » : simulateur de la liste


    // Ajout d'un contenu : galerie des apps activées dans la page Intégrations, puis fenêtre de paramétrage de l'app choisie.
    private List<AppManifest> enabledApps = new();
    private string appSearch = "", appCat = "";
    private bool picking, focusPicker;
    private int? insertAt;   // position d'insertion ; null : à la fin
    private ElementReference pickSearch;
    private AppManifest? newApp;
    private AppInstanceForm? newForm, itemForm;

    private IEnumerable<AppManifest> PickerApps => enabledApps
        .Where(a => appCat == "" || a.Category == appCat)
        .Where(a => appSearch.Length == 0 || a.Name.Contains(appSearch, StringComparison.OrdinalIgnoreCase) || (a.Summary ?? "").Contains(appSearch, StringComparison.OrdinalIgnoreCase));

    private void OpenPicker(int? at) { insertAt = at; appSearch = ""; appCat = ""; picking = true; focusPicker = true; }

    private void PickApp(AppManifest app) { picking = false; newApp = app; }

    // Durée d'un tour de boucle : contenus pleine page (une vidéo « jusqu'à la fin » compte pour sa durée connue).
    private int LoopSeconds(Playlist p) => p.Draft.Where(i => i.Placement == "full").Sum(i =>
    {
        var m = media.FirstOrDefault(x => x.Id == i.MediaId);
        return ContentDuration(m) && i.DurationMode != "fixed" ? Helpers.VideoSeconds(m) ?? i.DurationSec : i.DurationSec;
    });

    private IEnumerable<Option> PlacementsFor(MediaItem? m) =>
        Svc.Find(m?.AppId) is { } app ? ScreenOptions.Placements.Where(o => app.Placements.Contains(o.Id)) : ScreenOptions.PlacementsFor(m);

    // Une app « content » (YouTube) décide elle-même de sa durée : fin de la vidéo, plafonnée par son paramètre.
    private bool ContentDuration(MediaItem? m) => Svc.Find(m?.AppId)?.Duration == "content";

    private Playlist? Current => playlists.FirstOrDefault(p => p.Id == Id);

    protected override void OnParametersSet() { Reload(); renaming = false; }

    private async Task Refresh() { Reload(); await InvokeAsync(StateHasChanged); }

    private void Reload()
    {
        playlists = Store.Read(d => d.Playlists.ToList());
        media = Store.Read(d => d.Media.Where(m => m.Status == null).ToList());   // hors vidéos en conversion / en échec
        enabledApps = Svc.Installed().Select(i => Svc.Find(i.AppId)).OfType<AppManifest>().Where(a => !a.ScreenWidget).OrderBy(a => a.Name, StringComparer.CurrentCultureIgnoreCase).ToList();
    }

    // Le contenu de l'app vient d'être créé avec ses réglages : il rejoint la liste de lecture à l'endroit choisi (par défaut, à la fin).
    private void AddApp(Playlist pl, MediaItem item)
    {
        var dur = Store.Read(d => d.Tenant.DefaultDurationSec);
        var placement = PlacementsFor(item).Select(o => o.Id).DefaultIfEmpty("full").Contains("full") ? "full" : PlacementsFor(item).First().Id;
        var at = insertAt is { } i && i >= 0 && i < pl.Draft.Count ? i : pl.Draft.Count;
        Store.Write(d => { pl.Draft.Insert(at, new PlaylistItem { MediaId = item.Id, DurationSec = dur, Placement = placement }); pl.Touch(); });
        insertAt = null;
        newApp = null;
        Toast.Ok($"« {item.Name} » ajouté à la liste de lecture.");
        Reload();
    }

    // App : ses réglages sont enregistrés d'abord (validation comprise), puis la position et la durée dans la liste de lecture.
    private async Task SaveAll()
    {
        if (mMedia?.AppId != null && itemForm != null) await itemForm.Save();
        else SaveSettings();
    }

    // Un contenu d'app n'existe que pour ses listes de lecture : retiré de la dernière, il est supprimé (les fichiers de la médiathèque restent).
    private void RemoveItem(Playlist pl, PlaylistItem it)
    {
        Store.Write(d => { pl.Draft.Remove(it); pl.Touch(); });
        var m = media.FirstOrDefault(x => x.Id == it.MediaId);
        if (m?.AppId != null && Svc.PlaylistsUsing(m.Id).Count == 0) Svc.DeleteInstance(m.Id);
        Toast.Ok($"« {m?.Name ?? "Contenu"} » retiré de la liste de lecture.");
        Reload();
    }

    private void Move(Playlist pl, int idx, int delta)
    {
        Store.Write(d =>
        {
            (pl.Draft[idx], pl.Draft[idx + delta]) = (pl.Draft[idx + delta], pl.Draft[idx]);
            pl.Touch();
        });
        Reload();
    }

    // ---------- Paramètres d'un élément (fenêtre modale) ----------
    private PlaylistItem? mItem;
    private Playlist? mPlaylist;
    private MediaItem? mMedia;
    private string mPlacement = "full", mMode = "content";
    private int mSeconds = 8;

    private void OpenSettings(Playlist pl, PlaylistItem it, MediaItem? m)
    {
        mPlaylist = pl; mItem = it; mMedia = m;
        mPlacement = it.Placement;
        mMode = it.DurationMode == "fixed" ? "fixed" : "content";
        mSeconds = it.DurationSec;
    }

    private void CloseSettings() { mItem = null; mPlaylist = null; mMedia = null; }

    private void ChangeMode(ChangeEventArgs e)
    {
        mMode = e.Value?.ToString() == "fixed" ? "fixed" : "content";
        if (mMode == "fixed") mSeconds = Helpers.VideoSeconds(mMedia) ?? 30;   // départ : la durée de la vidéo si elle est connue
    }

    private void SaveSettings()
    {
        if (mItem is not { } item || mPlaylist is not { } pl) return;
        var content = ContentDuration(mMedia);
        var needsSeconds = mPlacement == "full" && (!content || mMode == "fixed");
        if (needsSeconds && (mSeconds < 1 || mSeconds > 86400)) { Toast.Error("La durée doit être comprise entre 1 et 86 400 secondes."); return; }
        var placement = mPlacement; var mode = mMode; var seconds = mSeconds;
        Store.Write(d =>
        {
            item.Placement = placement;
            if (content) item.DurationMode = mode;
            if (needsSeconds) item.DurationSec = seconds;
            pl.Touch();   // à publier depuis la page Écrans
        });
        Toast.Ok("Paramètres enregistrés.");
        CloseSettings();
        Reload();
    }

    private PlaylistItem? menuFor;

    // ---------- Glisser-déposer des lignes ----------
    // Le déplacement à la souris est géré par sort-list.js, qui rappelle Reorder au lâcher.
    private ElementReference sortList;
    private bool sortReady;
    private DotNetObjectReference<PlaylistEditor>? selfRef;

    // La ligne glissée prend la place de la ligne visée ; les autres se décalent.
    [JSInvokable]
    public Task Reorder(int from, int to)
    {
        if (Current is { } pl && from != to && from >= 0 && from < pl.Draft.Count && to >= 0 && to < pl.Draft.Count)
        {
            Store.Write(d =>
            {
                var it = pl.Draft[from];
                pl.Draft.RemoveAt(from);
                pl.Draft.Insert(to, it);
                pl.Touch();
            });
            Reload();
        }
        return InvokeAsync(StateHasChanged);
    }

    public void Dispose() => selfRef?.Dispose();

    // Temps alloué, affiché à droite de la ligne ; le détail se règle dans la fenêtre « Paramètres ».
    private string Duration(PlaylistItem it, MediaItem? m)
    {
        if (m == null) return "";
        if (it.Placement != "full") return "Permanent";
        if (ContentDuration(m) && it.DurationMode != "fixed") return "Jusqu'à la fin";
        return Helpers.FormatDuration(it.DurationSec);
    }

    private bool renaming;
    private string renameValue = "";

    private ElementReference renameInput;
    private bool focusRename;

    private void StartRename(Playlist pl) { renameValue = pl.Name; renaming = true; focusRename = true; }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (focusRename && renaming) { focusRename = false; await renameInput.FocusAsync(); }
        if (focusPicker && picking && enabledApps.Count > 0) { focusPicker = false; await pickSearch.FocusAsync(); }
        // La liste n'existe qu'une fois la liste de lecture chargée ; le script ignore un second appel sur le même élément.
        if (sortList.Context != null && !sortReady)
        {
            sortReady = true;
            selfRef ??= DotNetObjectReference.Create(this);
            await JS.InvokeVoidAsync("linkiiSort.init", sortList, selfRef);
        }
    }

    private void OnRenameKey(KeyboardEventArgs e, Playlist pl)
    {
        if (e.Key == "Enter") Rename(pl);
        else if (e.Key == "Escape") renaming = false;
    }

    private void Rename(Playlist pl)
    {
        var name = renameValue.Trim();
        if (name.Length == 0) return;
        Store.Write(d => { pl.Name = name; pl.UpdatedAt = DateTime.UtcNow; });   // le nom n'est pas publié : aucun écran à notifier
        Toast.Ok($"Liste de lecture renommée en « {name} ».");
        renaming = false;
        Reload();
    }

}
