    }

    private static string MediaMeta(MediaItem m) =>
        (m.Width is { } w && m.Height is { } h ? $"{w} × {h}" : m.Type == "video" ? "Vidéo" : "Image")
        + (m.Type == "video" && Helpers.VideoSeconds(m) is { } vs ? $" · {Helpers.FormatDuration(vs)}" : "");

    /// <summary>Ajoute un fichier de la médiathèque au fil (à la position donnée, par défaut à la fin), comme un contenu « Image » ou « Vidéo » déjà rempli.</summary>
    private void AddMedia(MediaItem file, int? position)
    {
        if (Current is not { } pl) return;
        var appId = file.Type == "video" ? "video" : "image";
        if (!enabledApps.Any(a => a.Id == appId)) { Toast.Error($"L'application « {(appId == "video" ? "Vidéo" : "Image")} » n'est pas disponible."); return; }
        if (Svc.CreateFromMedia(file) is not { } item) { Toast.Error("Ce média ne peut pas être ajouté."); return; }
        var dur = file.Type == "video" ? Helpers.VideoSeconds(file) ?? 30 : Store.Read(d => d.Tenant.DefaultDurationSec);
        var at = position is { } i && i >= 0 && i < pl.Draft.Count ? i : pl.Draft.Count;
        var row = new PlaylistItem { MediaId = item.Id, DurationSec = dur, DurationMode = "fixed", Placement = "full" };
        WriteList(d =>
        {
            pl.Draft.Insert(at, row);
            pl.Touch();
        });
        Toast.Ok($"« {file.Name} » ajouté comme {(appId == "video" ? "vidéo" : "image")} en position {at + 1}.");
        Reload();
        Flash(row.Id);
    }

    // Le contenu glissé s'insère à la position visée (comptée avant son retrait)
    [JSInvokable]
    public Task MoveItem(int from, int at)
    {
        if (Current is { } pl && from >= 0 && from < pl.Draft.Count && at >= 0 && at <= pl.Draft.Count && at != from && at != from + 1)
        {
            var it = pl.Draft[from];
            var to = from < at ? at - 1 : at;
            WriteList(d =>
            {
                pl.Draft.RemoveAt(from);
                pl.Draft.Insert(to, it);
                pl.Touch();
            });
            Toast.Ok($"« {media.FirstOrDefault(x => x.Id == it.MediaId)?.Name ?? "Contenu"} » déplacé en position {to + 1}.");
            Reload();
            Flash(it.Id);
        }
        return InvokeAsync(StateHasChanged);
    }

    // Contenu qui vient d'être ajouté ou déplacé : surligné quelques secondes et amené à l'écran
    private Guid? freshId, revealId;
    private void Flash(Guid id)
    {
        freshId = id; revealId = id;
        _ = Task.Delay(2600).ContinueWith(_ => InvokeAsync(() => { if (freshId == id) { freshId = null; StateHasChanged(); } }));
    }

    /// <summary>Une ligne du fil : place dans la boucle (numéro, départ), durée et couleur de l'app.</summary>
    private sealed record FlowRow(int Index, PlaylistItem It, MediaItem? M, bool Masked, bool Incomplete, bool Plays, int Seconds, int Start, string Num, string When, string Color, string? AppId, (string Css, string Text)? Chip, bool Hold);

    private List<FlowRow> Rows(Playlist pl)
    {
        var rows = new List<FlowRow>();
        int t = 0, n = 0;
        var now = ContentWindow.NowIso(zone);   // heure de l'organisation : une période en cours ou passée se lit à cet instant
        for (var i = 0; i < pl.Draft.Count; i++)
        {
            var it = pl.Draft[i];
            var m = media.FirstOrDefault(x => x.Id == it.MediaId);
            var incomplete = Svc.IsIncomplete(m);
            var inWindow = ContentWindow.Plays(it.StartsAt, it.EndsAt, now);   // hors période : pas dans la boucle ce tour-ci
            var plays = !it.Off && it.Placement == "full" && m != null && !incomplete && inWindow;   // ajouté à vide : pas encore diffusé
            var secs = plays ? Helpers.ItemSeconds(it, m, Svc.Find(m?.AppId), media) : 0;
            // sous le numéro : l'heure de départ dans la boucle ; un contenu qui n'y passe pas n'a pas d'heure (la raison est dans sa ligne)
            var when = it.Off ? "ignoré" : plays ? Helpers.FormatDuration(t) : "";
            var look = LookId(m);
            rows.Add(new(i, it, m, MediaLibrary.UsesHidden(m, hidden), incomplete, plays, secs, t, plays ? (++n).ToString() : "–", when, AppIcon.LookOf(look).Color, look,
                it.Off ? null : ContentWindow.Chip(it.StartsAt, it.EndsAt, now), !it.Off && !inWindow));
            t += secs;
        }
        return rows;
    }

    private static string? LookId(MediaItem? m) => m == null ? null : m.AppId ?? (m.Type == "video" ? "video" : "image");

    private string RowClass(FlowRow r) => (r.It.Id == freshId ? "fresh " : r.Incomplete && !r.Masked ? "todo " : "") + (r.It.Off ? "off " : "") + (r.Hold ? "hold " : "") + (r.Masked ? "masked" : "");

    private bool Draggable(FlowRow r) => !readOnlyHere && renRow != r.It;

    private bool ScanOn(FlowRow r) => growth && r.It.QrOn && r.It.Placement == "full" && r.M != null && !r.Masked;

    private string DurationText(FlowRow r) => r.M == null ? "" : Duration(r.It, r.M);

    // « Jusqu'à la fin », « Permanent » : en texte courant, pas dans le grand chiffre
    private string? TextDur(FlowRow r) => DurationText(r) is { Length: > 0 } s && !char.IsDigit(s[0]) ? "txt" : null;

    private string Kind(MediaItem m) => m.AppId != null ? Svc.Find(m.AppId)?.Name ?? "App" : m.Type == "video" ? "Vidéo" : "Image";

    // Sous le nom : pourquoi le contenu ne passe pas normalement (désactivé, hors période, en continu), ou sa période ; rien sinon
    private static string? StateText(FlowRow r) =>
        r.Masked ? "média non partagé"
        : r.It.Off ? "Désactivé"
        : r.Hold ? "Hors période" + (r.Chip is { } c ? $" · {c.Text}" : "")
        : r.M != null && r.It.Placement != "full" ? "Affiché en continu"
        : r.Chip is { } chip ? chip.Text : null;

    private static string StateClass(FlowRow r) => r.It.Off ? "off" : r.Hold ? "hold" : "per";

