@code {
    [Parameter] public Guid Id { get; set; }
    [Parameter] public EventCallback OnClose { get; set; }
    private Task Close() => OnClose.InvokeAsync();

    private List<Playlist> playlists = new();
    private List<MediaItem> media = new();
    private bool trying;   // « Aperçu » : simulateur de la liste

    // ---------- Diffusion : état partagé par l'en-tête (« Publier sur N écrans ») et l'onglet Diffusion ----------
    private PlaylistDiffusion diff = default!;
    private bool pubMenu, whenOpen;
    private PlaylistDiffusion.ScreenRow? whenFor;   // null : « Programmer… » des écrans cochés ; sinon menu ⋯ d'une ligne
    private ElementReference libRoot, libSearchInput;

    // null : chaque écran à son heure (maintenant si aucune) ; DateTime.MinValue : tous maintenant
    private async Task PublishNow(DateTime? all)
    {
        pubMenu = false;
        // la relecture de l'IA a des remarques non traitées : on les montre d'abord (« Publier quand même » reste possible)
        if (Current is { } cur && revState.Available && RevPending(cur).Count > 0) { revAll = all; pubOpen = false; ShowReview(true); return; }
        if (await diff.Publish(all)) { Reload(); pubOpen = false; }
    }

    private DateTime? revAll;
    private async Task PublishAnyway()
    {
        var left = Current is { } cur ? RevPending(cur).Count : 0;
        if (!await diff.Publish(revAll)) { Panel.Refresh(); return; }
        Reload();
        pubOpen = false;
        revOutcome = left > 0 ? $"Liste publiée malgré {left} remarque{(left > 1 ? "s" : "")}." : "Liste publiée après la relecture.";
        revPublish = false;
        Panel.Release(revKey);
    }

    // ---------- La relecture dans le panneau de l'assistant (toute l'IA y passe) ----------
    // « Voir dans l'assistant », ou « Publier » avec des remarques en attente : les remarques s'ouvrent dans le panneau, à côté de la liste.
    // Leurs boutons (Ouvrir, Ne pas publier, Ignorer, Publier quand même) agissent sur cette page ; en la quittant, il en reste un résumé.
    private string revKey = "";
    private bool revPublish;
    private string revOutcome = "";

    private void ShowReview(bool publishing)
    {
        if (Current is not { } pl) return;
        revPublish = publishing; revOutcome = "";
        revKey = "review-" + pl.Id.ToString("N");
        Panel.Show(revKey, $"Relire la liste « {pl.Name} » avant de publier", "Liste de diffusion · Relecture de l'IA", ReviewCard, ReviewSummary);
    }

    private void RevRefresh() { if (revKey.Length > 0 && Panel.Has(revKey)) Panel.Refresh(); }

    private void RevClose(string why) { revOutcome = why; revPublish = false; Panel.Release(revKey); }

    private string ReviewSummary()
    {
        if (revOutcome.Length > 0) return revOutcome;
        var n = Current is { } pl ? RevPending(pl).Count : 0;
        return n == 0 ? "Relecture : toutes les remarques ont été traitées." : $"Relecture : {n} remarque{(n > 1 ? "s" : "")} encore à regarder.";
    }

    private RenderFragment ReviewCard => __builder =>
    {
        if (Current is not { } pl) return;
        var rows0 = RevPending(pl);
        var chosen = diff.Chosen.Count;
        <div class="ai-rvs">
            <p style="margin:0">@(rows0.Count == 0 ? $"J'ai relu « {pl.Name} » : plus aucune remarque." : $"J'ai relu « {pl.Name} » : {rows0.Count} remarque{(rows0.Count > 1 ? "s" : "")} à regarder. Je ne modifie rien sans vous.")</p>
            @foreach (var (f, it, m) in rows0)
            {
                var ff = f; var item = it; var med = m;
                <div class="ai-rv">
                    <div class="ai-rv-th">@if (med?.AppId == Compositions.AppId) { <CompositionThumb Item="med" Files="media" Contain="true" /> } else if (med != null) { <MediaThumb Media="med" All="media" Wide="true" /> }</div>
                    <div class="ai-rv-t"><span class="ai-kind @(ff.Kind == AiKinds.Date ? "red" : "")"><Ico Name="@AiKinds.Icon(ff.Kind)" Size="13" />@AiKinds.Label(ff.Kind)</span><b class="nm">@(med?.Name ?? "Contenu")</b>
                        <p>@(ff.Kind == AiKinds.Small ? "Le texte" : "On lit") <q><mark>@ff.Quote</mark></q>@(ff.Advice.Length > 0 ? ". " + ff.Advice : "")</p></div>
                    <div class="ai-rv-a">
                        @if (!readOnlyHere && med != null) { <button type="button" class="btn ghost sm" @onclick="() => RevOpenItem(item, med)">Ouvrir</button> }
                        @if (!readOnlyHere && (ff.Kind == AiKinds.Date || ff.Kind == AiKinds.Template)) { <button type="button" class="btn ghost sm" title="Le contenu garde sa place dans la liste mais n'est pas publié" @onclick="() => RevSkip(ff)">Ne pas publier</button> }
                        <button type="button" class="linklike" @onclick="() => RevIgnore(ff)">Ignorer</button>
                    </div>
                </div>
            }
            <div class="ai-rv-f">
                @if (revPublish)
                {
                    <button type="button" class="btn sm" disabled="@(chosen == 0 || diff.Busy)" @onclick="PublishAnyway"><Ico Name="upload" Size="14" /> @(rows0.Count > 0 ? "Publier quand même" : "Publier")</button>
                    <button type="button" class="btn ghost sm" @onclick='() => RevClose("Publication reportée après la relecture.")'>Pas maintenant</button>
                }
                else
                {
                    <button type="button" class="btn ghost sm" @onclick="() => RevClose(ReviewSummary())">C'est noté</button>
                }
            </div>
        </div>
    };

    // ---------- Relecture de l'IA avant publication (Pro) : dates passées, textes de modèle oubliés, fautes, textes trop petits ----------
    private AiState revState = new(AiStatus.Off, 0, 0, false);
    private AiReviewResult? rev;
    private bool revBusy;
    private int revFor = -1;
    private Guid revForList;
    private CancellationTokenSource? revCts;

    /// <summary>Lance la relecture (après un court délai) quand la liste a changé depuis la dernière ; sans changement, rien ne repart.</summary>
    private void QueueReview()
    {
        if (Current is not { } pl) return;
        var cid = Store.ClientId;
        revState = AiSvc.State(cid, "review");
        if (!revState.Available || pl.Draft.Count == 0) { rev = null; revBusy = false; revFor = -1; return; }
        if (revForList == pl.Id && revFor == pl.Revision) return;
        if (revForList != pl.Id) rev = null;
        revForList = pl.Id; revFor = pl.Revision;
        revCts?.Cancel();
        var cts = revCts = new CancellationTokenSource();
        revBusy = true;
        _ = RunReview(cid, pl.Id, cts.Token);
    }

    private async Task RunReview(Guid cid, Guid listId, CancellationToken ct)
    {
        try
        {
            await Task.Delay(1500, ct);
            var r = await Review.Run(cid, listId, ct);
            if (!ct.IsCancellationRequested) rev = r;
        }
        catch (OperationCanceledException) { }
        catch (Exception) { if (!ct.IsCancellationRequested) rev = new AiReviewResult(false, new(), ""); }
        if (ct.IsCancellationRequested) return;
        revBusy = false;
        await InvokeAsync(() => { revState = AiSvc.State(cid, "review"); StateHasChanged(); RevRefresh(); });
    }

    /// <summary>Remarques à regarder : celles que la personne n'a pas ignorées, sur des contenus encore publiés.</summary>
    private List<(AiFinding F, PlaylistItem It, MediaItem? M)> RevPending(Playlist pl)
    {
        var res = new List<(AiFinding, PlaylistItem, MediaItem?)>();
        if (!revState.Available || rev is not { Ok: true } r) return res;
        foreach (var f in r.Findings)
            if (!pl.AiIgnored.Contains(f.Key) && pl.Draft.FirstOrDefault(i => i.Id == f.ItemId) is { Off: false } it)
                res.Add((f, it, media.FirstOrDefault(m => m.Id == it.MediaId)));
        return res;
    }

    private void RevIgnore(AiFinding f)
    {
        WriteList(d => { if (d.Playlists.FirstOrDefault(p => p.Id == Id) is { } p && !p.AiIgnored.Contains(f.Key)) p.AiIgnored.Add(f.Key); });
        Reload();
        RevRefresh(); if (revKey.Length > 0 && Panel.Has(revKey)) Panel.Save();   // le résumé gardé dans la discussion suit
    }

    private void RevSkip(AiFinding f)
    {
        WriteList(d =>
        {
            if (d.Playlists.FirstOrDefault(p => p.Id == Id) is { } p && p.Draft.FirstOrDefault(i => i.Id == f.ItemId) is { } it) { it.Off = true; p.Touch(); }
        });
        if (Current is { } cur) revFor = cur.Revision;   // la relecture reste valable : un contenu en moins ne demande pas de nouvelle lecture
        Reload();
        RevRefresh(); if (revKey.Length > 0 && Panel.Has(revKey)) Panel.Save();   // le résumé gardé dans la discussion suit
        Toast.Ok("Contenu désactivé dans la liste : il ne sera pas publié. Vous pouvez le réactiver à tout moment.");
    }

    private void RevOpenItem(PlaylistItem it, MediaItem m)
    {
        if (Current is { } cur) OpenSettings(cur, it, m);
    }

    private void ProgramOne(PlaylistDiffusion.ScreenRow r) { whenFor = r; whenOpen = true; }

    private void WhenDone() { whenOpen = false; whenFor = null; Reload(); }

    // Ajout d'un contenu : colonne des apps activées (hors widgets d'écran), à glisser dans le fil ou à cliquer (ajout à la fin).
    private List<AppManifest> enabledApps = new();
    private int? insertAt;   // position d'insertion ; null : à la fin
    private AppManifest? newApp;
    private AppInstanceForm? newForm, itemForm;
    private string? newName, itemName;   // nom modifié par le bouton « Renommer » du bandeau (titre de la fenêtre)

    /// <summary>Ajoute à la liste de lecture un contenu de l'app, à vide (à la position donnée, par défaut à la fin) ; l'utilisateur le complète ensuite.</summary>
    private void AddEmpty(AppManifest app, int? position)
    {
        if (Current is not { } pl) return;
        if (app.Id == Compositions.AppId) { OpenCompositionPicker(position); return; }   // on choisit une composition existante, ou on en crée une
        if (app.Id == HomeAssistantRules.BuildingApp) { insertAt = position; pickBuilding = true; return; }   // plan + affichage d'abord (§202)
        if (Svc.CreateEmpty(app.Id) is not { } item) { Toast.Error("Activez d'abord cette application dans la page Applications."); return; }
        var dur = Store.Read(d => d.Tenant.DefaultDurationSec);
        var placement = PlacementsFor(item).Select(o => o.Id).DefaultIfEmpty("full").Contains("full") ? "full" : PlacementsFor(item).First().Id;
        var at = position is { } i && i >= 0 && i < pl.Draft.Count ? i : pl.Draft.Count;
        var row = new PlaylistItem { MediaId = item.Id, DurationSec = dur, Placement = placement };
        WriteList(d =>
        {
            pl.Draft.Insert(at, row);
            pl.Touch();
        });
        // ajoutée avec ses réglages par défaut ; s'il lui manque une information, sa carte porte « À configurer » en orange
