    private static readonly int[] DurPresets = { 3, 5, 8, 10, 15, 20, 30, 45, 60, 90, 120 };

    private static string DurLabel(int s) => s < 60 ? $"{s} s" : s % 60 != 0 ? $"{s / 60} min {s % 60} s" : $"{s / 60} min";

    private void OpenDur(PlaylistItem it) { rowMenu = null; durAll = false; durFor = durFor == it ? null : it; }

    private RenderFragment DurView(FlowRow r) =>
        @<text>
