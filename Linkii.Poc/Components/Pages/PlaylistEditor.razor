    private IEnumerable<Option> PlacementsFor(MediaItem? m) =>
        Svc.Find(m?.AppId) is { } app ? ScreenOptions.Placements.Where(o => app.Placements.Contains(o.Id)) : ScreenOptions.PlacementsFor(m);

    // Une app « content » (YouTube) décide elle-même de sa durée : fin de la vidéo, plafonnée par son paramètre.
    private bool ContentDuration(MediaItem? m) => Svc.Find(m?.AppId)?.Duration == "content";

    private Playlist? Current => playlists.FirstOrDefault(p => p.Id == Id);

    // Une liste rangée dans un dossier partagé en lecture seule ne s'enregistre pas, même si la page est ouverte (contrôle côté serveur)
    private bool readOnlyHere;
    private void WriteList(Action<ClientDb> act)
    {
        try
        {
            Store.Write(d =>
            {
                if (d.Playlists.FirstOrDefault(p => p.Id == Id) is { } p && !PlaylistOps.CanEdit(d, p))
                    throw new UnauthorizedAccessException("Cette liste est dans un dossier partagé en lecture seule : vous ne pouvez pas la modifier.");
                act(d);
            });
        }
        catch (UnauthorizedAccessException e) { Toast.Error(e.Message); }
    }

    protected override void OnParametersSet() { Reload(); renaming = false; }

    private async Task Refresh() { Reload(); await InvokeAsync(StateHasChanged); }

    private bool portraitScreens;   // tous les écrans qui jouent cette liste sont en portrait : les aperçus des contenus le sont aussi
    private int outside;   // écrans hors du périmètre du membre qui jouent cette liste
    private HashSet<Guid> hidden = new();

    private void Reload()
    {
        playlists = Store.Read(d => d.Playlists.Where(p => PlaylistOps.RightOf(d, p) != FolderRight.None).ToList());   // une liste d'un dossier invisible est « introuvable »
        readOnlyHere = Store.Read(d => d.Playlists.FirstOrDefault(p => p.Id == Id) is { } cur && !PlaylistOps.CanEdit(d, cur));
        media = Store.Read(d => d.Media.Where(m => m.Status == null).ToList());   // hors vidéos en conversion / en échec
        zone = Store.Read(d => d.Tenant.Timezone);
        hidden = MediaLib.HiddenFileIds();   // fichiers des dossiers non accordés : leurs contenus sont masqués
        // onglet « Médias » : images et vidéos prêtes (ni en conversion ni en échec), les plus récentes d'abord
        // (une vidéo importée depuis le tiroir reste visible pendant sa conversion)
        pickFiles = MediaLib.PickableFiles().Where(m => m.Type is "image" or "video" && (m.Status == null || m.Status == "processing" && freshFiles.Contains(m.Id)) && !hidden.Contains(m.Id)).OrderByDescending(m => m.AddedUtc).ToList();
        canImport = !readOnlyHere && Store.Read(d => d.Access.CanWrite(LevelPages.Media));
        enabledApps = Svc.Installed().Select(i => Svc.Find(i.AppId)).OfType<AppManifest>().Where(a => !a.ScreenWidget && !a.IsFeature).OrderBy(a => a.Name, StringComparer.CurrentCultureIgnoreCase).ToList();   // les deux modes : toutes les intégrations attribuées (hors widgets d'écran), §186
        compoItems = Svc.Instances(Compositions.AppId);
        compoFiles = MediaLib.PickableFiles().Where(m => m.Type == "image" && m.Status == null && m.FileName != null).ToList();
        // pages web et présentations déjà réglées (un contenu ajouté à vide et jamais fini n'est pas proposé)
        webItems = Svc.Instances("webpage").Where(m => !Svc.IsIncomplete(m)).ToList();
        presItems = PresApps.SelectMany(Svc.Instances).Where(m => !Svc.IsIncomplete(m)).OrderByDescending(m => m.AddedUtc).ToList();
        onScreens = Store.Read(d => d.Root.Screens.Count(s => s.ClientId == d.ClientId && s.Token != null && s.ZonePlaylists().Contains(Id)));
        growth = Store.Read(d => d.Tenant.IsGrowth);
        outside = Store.Read(d => d.Access.Sees is { } sees ? d.Root.Screens.Count(s => s.ClientId == d.ClientId && s.Token != null && !sees(s) && s.ZonePlaylists().Contains(Id)) : 0);
        portraitScreens = Store.Read(d => d.Root.Screens.Where(s => s.ClientId == d.ClientId && s.Token != null && s.ZonePlaylists().Contains(Id)).ToList() is { Count: > 0 } ps && ps.All(s => s.Orientation == "portrait"));
        scanCounts = growth ? Scans.Counts(Store.ClientId, DateTime.UtcNow.AddDays(-ScanLog.RetentionDays)) : new();
    }

    // Le contenu de l'app vient d'être créé avec ses réglages : il rejoint la liste de lecture à l'endroit choisi (par défaut, à la fin).
    private void AddApp(Playlist pl, MediaItem item)
    {
        var dur = Store.Read(d => d.Tenant.DefaultDurationSec);
        var placement = PlacementsFor(item).Select(o => o.Id).DefaultIfEmpty("full").Contains("full") ? "full" : PlacementsFor(item).First().Id;
        var at = insertAt is { } i && i >= 0 && i < pl.Draft.Count ? i : pl.Draft.Count;
        // QR code de comptage : réglé dans l'onglet « QR code » de la fenêtre de création (licence Pro, contenu en pleine page)
        var qr = growth && mQrOn && placement == "full";
        var qrCode = qr ? mQrCode ?? QrTracking.NewCode() : null; var qrUrl = QrTracking.Destination(mQrUrl) ?? mQrUrl.Trim();
        var qrLabel = QrTracking.CleanLabel(mQrLabel); var qrBase = QrTracking.Origin(Nav.BaseUri);
        var (qx, qy, qs) = (mQrX, mQrY, mQrSize);
        WriteList(d =>
        {
            pl.Draft.Insert(at, new PlaylistItem
            {
                MediaId = item.Id, DurationSec = dur, Placement = placement,
                QrOn = qr, QrCode = qrCode, QrUrl = qr ? qrUrl : null, QrLabel = qrLabel, QrBase = qrBase, QrX = qx, QrY = qy, QrSize = qs
            });
            pl.Touch();
        });
        insertAt = null;
        newApp = null;
        Toast.Ok($"« {item.Name} » ajouté à la liste de lecture.");
        Reload();
    }

    // App : ses réglages sont enregistrés d'abord (validation comprise), puis la position et la durée dans la liste de lecture.
    private string? ScheduleFrom => mSchedOn ? WindowOf(mFromDate, mFromTime, "00:00") : null;
    private string? ScheduleTo => mSchedOn ? WindowOf(mToDate, mToTime, "23:59") : null;

    private async Task SaveAll()
    {
        // Période de diffusion : dates bien formées et fin après le début (vérifié avant d'enregistrer quoi que ce soit)
        if (mItem != null && !ContentWindow.Valid(ScheduleFrom, ScheduleTo, out var windowError)) { mTab = "prog"; Toast.Error(windowError!); return; }
        // QR code activé : une destination valide est nécessaire (vérifié avant d'enregistrer quoi que ce soit)
        if (growth && mMedia?.AppId != null && mPlacement == "full" && mQrOn && QrTracking.Destination(mQrUrl) == null)
        {
            mTab = "qr";
            Toast.Error("Saisissez l'adresse de destination du QR code (adresse web complète, par exemple https://www.exemple.ch).");
            return;
        }
        if (mMedia?.AppId != null && itemForm != null) await itemForm.Save();
        else SaveSettings();
    }

    // Un contenu d'app n'existe que pour ses listes de lecture : retiré de la dernière, il est supprimé (les fichiers de la médiathèque restent).
    private void RemoveItem(Playlist pl, PlaylistItem it)
    {
        if (MediaLibrary.UsesHidden(media.FirstOrDefault(x => x.Id == it.MediaId), hidden)) { Toast.Error("Ce contenu utilise un média que vous ne voyez pas : vous ne pouvez pas le retirer."); return; }
        WriteList(d => { pl.Draft.Remove(it); pl.Touch(); });
        var m = media.FirstOrDefault(x => x.Id == it.MediaId);
        if (m?.AppId != null && m.AppId != Compositions.AppId && Svc.PlaylistsUsing(m.Id).Count == 0) Svc.DeleteInstance(m.Id);   // une composition reste dans « Mes compositions »
        Toast.Ok($"« {m?.Name ?? "Contenu"} » retiré de la liste de lecture.");
        Reload();
    }

