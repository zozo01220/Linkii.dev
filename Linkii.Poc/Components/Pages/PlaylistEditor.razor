    // Média importé : rechargé, mis en tête de la liste et signalé ; une vidéo en conversion devient ajoutable dès qu'elle est prête
    private void Imported(MediaItem m)
    {
        freshFiles.Add(m.Id);
        Reload();
        revealFresh = true;
        if (m.Status != null) _ = WatchConversion(m.Id);
        Toast.Ok(m.Status == "processing" ? $"« {m.Name} » importé dans la médiathèque, conversion en MP4 en cours." : $"« {m.Name} » importé dans la médiathèque : glissez-le dans le fil.");
    }

    private async Task WatchConversion(Guid id)
    {
        for (var i = 0; i < 200; i++)   // au plus ~10 minutes
        {
            await Task.Delay(3000);
            var status = Store.Read(d => d.Media.FirstOrDefault(x => x.Id == id)?.Status);
            if (status == null || status == "error") break;
        }
        await InvokeAsync(() => { Reload(); StateHasChanged(); });
    }

