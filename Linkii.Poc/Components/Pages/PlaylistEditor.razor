    private void SetTransition(Playlist pl, PlaylistItem it, string type, int? ms)
    {
        var id = it.Id;
        var all = trAll;
        WriteList(d =>
        {
            foreach (var x in all ? pl.Draft : new List<PlaylistItem> { it })
            {
                x.Transition = Transitions.Valid(type);
                x.TransitionMs = ms is { } m ? Transitions.ValidMs(m) : it.TransitionMs;
            }
            pl.Touch();
        });
        Reload();
        if (!all) trItem = Current?.Draft.FirstOrDefault(x => x.Id == id);
    }

    private void ApplyTransitionToAll(Playlist pl, PlaylistItem from)
    {
        var tr = from.Transition; var ms = from.TransitionMs;
        WriteList(d => { foreach (var i in pl.Draft) { i.Transition = tr; i.TransitionMs = ms; } pl.Touch(); });
        trItem = null;
        Toast.Ok("Transition appliquée à tous les contenus.");
        Reload();
    }

