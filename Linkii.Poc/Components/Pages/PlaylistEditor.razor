    private static readonly string[] PresApps = { "ms-powerpoint", "google-slides", "google-docs", "pdf", "canva" };
    private static readonly HashSet<string> StdApps = new(new[] { "image", "video", Compositions.AppId, "webpage" }.Concat(PresApps));
    private bool Has(string appId) => enabledApps.Any(a => a.Id == appId);
    private IEnumerable<AppManifest> OtherApps => enabledApps.Where(a => !StdApps.Contains(a.Id));
    private bool Match(string? name) => libSearch.Length == 0 || (name ?? "").Contains(libSearch, StringComparison.OrdinalIgnoreCase);

    private sealed record LibTab(string Key, string Label, string Color, int Count);

    private IEnumerable<LibTab> LibTabs()
    {
        if (Has("image")) yield return new("img", "Images", AppIcon.LookOf("image").Color, pickFiles.Count(m => m.Type == "image"));
        if (Has("video")) yield return new("vid", "Vidéos", AppIcon.LookOf("video").Color, pickFiles.Count(m => m.Type == "video"));
        if (Has(Compositions.AppId)) yield return new("cmp", "Compositions", AppIcon.LookOf(Compositions.AppId).Color, compoItems.Count);
        if (PresApps.Any(Has)) yield return new("pres", "Présentations", AppIcon.LookOf("ms-powerpoint").Color, presItems.Count);
        if (Has("webpage")) yield return new("web", "Pages web", AppIcon.LookOf("webpage").Color, webItems.Count);
        yield return new("app", "Intégrations", "var(--muted)", OtherApps.Count());
    }

    // Bouton d'ajout propre à l'onglet
    private RenderFragment LibAction() => libTab switch
