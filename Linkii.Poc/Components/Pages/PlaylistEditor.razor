            if (d.Tenant.HaPlans.FirstOrDefault(p => p.Id == r.PlanId) is not { } p || p.Views.FirstOrDefault(v => v.Id == r.ViewId) is not { } v) { err = "Plan ou affichage introuvable."; return; }
            if (HaPlanUses.NewContent(d, Catalog, p, v) is not { } c) { err = "Activez d'abord Home Assistant dans la page Applications."; return; }
