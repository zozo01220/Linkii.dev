    // Sous la carte : un contenu qui ne passe pas en ce moment porte une pastille de couleur (hors période en orange, à configurer, désactivé)
    private static string WhenClass(FlowRow r) => r.Plays ? "" : r.It.Off ? "st off" : r.Hold ? "st hold" : r.Incomplete ? "st todo" : "";

    // Sous la carte : l'heure de passage dans la boucle, ou pourquoi elle n'y passe pas
    private string When(FlowRow r) =>
        r.Plays ? $"passe à {Helpers.FormatDuration(r.Start)}"
