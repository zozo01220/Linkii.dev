    // ---------- Fil : glisser-déposer (playlist-flow.js) ----------
    private ElementReference flowRoot;
    private string? flowInitId;
    private DotNetObjectReference<PlaylistEditor>? selfRef;

    // ---------- Onglet « Médias » : images et vidéos de la médiathèque, ajoutées comme contenus « Image » ou « Vidéo » ----------
    private List<MediaItem> pickFiles = new();
    // ---------- Import depuis le tiroir (§176) : le média entre dans la médiathèque et apparaît en tête de l'onglet Médias ----------
    private const string ImportInputId = "pf-import-files";
    private MediaUploader? importer;
    private bool canImport, impMenu, impUrl, impCloud;
    private string impUrlValue = "";
    private ElementReference impUrlInput;
    private readonly HashSet<Guid> freshFiles = new();
    private bool revealFresh;
    private IReadOnlyList<MediaUploader.UploadJob> ImportJobs => importer?.Jobs ?? Array.Empty<MediaUploader.UploadJob>();

    private async Task OpenImportUrl()
    {
        impMenu = false; impUrl = true; impUrlValue = "";
        StateHasChanged();
        await Task.Yield();
        try { await impUrlInput.FocusAsync(); } catch (JSException) { } catch (InvalidOperationException) { }
    }

    private async Task SubmitImportUrl()
    {
        var u = impUrlValue.Trim();
        if (u.Length == 0 || importer == null) return;
        impUrl = false; impUrlValue = "";
        await importer.ImportUrl(u);
    }

    private void DismissImport(MediaUploader.UploadJob job)
    {
        if (job.State == "running") importer?.Cancel(job); else importer?.Dismiss(job);
    }

    // Média importé : rechargé, mis en tête de la liste et signalé ; une vidéo en conversion devient ajoutable dès qu'elle est prête
    private void Imported(MediaItem m)
    {
        freshFiles.Add(m.Id);
        Reload();
        revealFresh = true;
        if (m.Status != null) _ = WatchConversion(m.Id);
        Toast.Ok(m.Status == "processing" ? $"« {m.Name} » importé dans la médiathèque, conversion en MP4 en cours." : $"« {m.Name} » importé dans la médiathèque : glissez-le dans le fil.");
    }

    private async Task WatchConversion(Guid id)
    {
        for (var i = 0; i < 200; i++)   // au plus ~10 minutes
        {
            await Task.Delay(3000);
            var status = Store.Read(d => d.Media.FirstOrDefault(x => x.Id == id)?.Status);
            if (status == null || status == "error") break;
        }
        await InvokeAsync(() => { Reload(); StateHasChanged(); });
    }

    // Document importé depuis le cloud : ses pages entrent dans la médiathèque (présentation du dossier « …_médias »)
    private void CloudImported(Guid? id)
    {
        impCloud = false;
        Reload();
        StateHasChanged();
        Toast.Ok("Document importé dans la médiathèque : ses pages sont rangées dans une présentation, à retrouver dans Contenus.");
    }

    private static string MediaMeta(MediaItem m) =>
        (m.Width is { } w && m.Height is { } h ? $"{w} × {h}" : m.Type == "video" ? "Vidéo" : "Image")
        + (m.Type == "video" && Helpers.VideoSeconds(m) is { } vs ? $" · {Helpers.FormatDuration(vs)}" : "");

    /// <summary>Ajoute un fichier de la médiathèque au fil (à la position donnée, par défaut à la fin), comme un contenu « Image » ou « Vidéo » déjà rempli.</summary>
    private void AddMedia(MediaItem file, int? position)
    {
        if (Current is not { } pl) return;
        var appId = file.Type == "video" ? "video" : "image";
        if (!enabledApps.Any(a => a.Id == appId)) { Toast.Error($"L'intégration « {(appId == "video" ? "Vidéo" : "Image")} » n'est pas disponible."); return; }
        if (Svc.CreateFromMedia(file) is not { } item) { Toast.Error("Ce média ne peut pas être ajouté."); return; }
        var dur = file.Type == "video" ? Helpers.VideoSeconds(file) ?? 30 : Store.Read(d => d.Tenant.DefaultDurationSec);
        var at = position is { } i && i >= 0 && i < pl.Draft.Count ? i : pl.Draft.Count;
        var row = new PlaylistItem { MediaId = item.Id, DurationSec = dur, DurationMode = "fixed", Placement = "full" };
        WriteList(d =>
        {
            pl.Draft.Insert(at, row);
            pl.Touch();
        });
        Toast.Ok($"« {file.Name} » ajouté comme {(appId == "video" ? "vidéo" : "image")} en position {at + 1}.");
        Reload();
        Flash(row.Id);
    }

    // Le contenu glissé s'insère à la position visée (comptée avant son retrait)
    [JSInvokable]
    public Task MoveItem(int from, int at)
    {
        if (Current is { } pl && from >= 0 && from < pl.Draft.Count && at >= 0 && at <= pl.Draft.Count && at != from && at != from + 1)
        {
            var it = pl.Draft[from];
            var to = from < at ? at - 1 : at;
            WriteList(d =>
            {
                pl.Draft.RemoveAt(from);
                pl.Draft.Insert(to, it);
                pl.Touch();
            });
            Toast.Ok($"« {media.FirstOrDefault(x => x.Id == it.MediaId)?.Name ?? "Contenu"} » déplacé en position {to + 1}.");
            Reload();
