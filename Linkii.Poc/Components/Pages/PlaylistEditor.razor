    // Fenêtre « Régler » : contenu précédent / suivant sans fermer (les modifications en cours ne sont pas enregistrées)
    private void StepSettings(int dir)
    {
        if (mPlaylist is not { } pl || mItem is not { } it || pl.Draft.Count < 2) return;
        var i = pl.Draft.IndexOf(it);
        for (var k = 1; k < pl.Draft.Count; k++)
        {
            var next = pl.Draft[((i + dir * k) % pl.Draft.Count + pl.Draft.Count) % pl.Draft.Count];
            var m = media.FirstOrDefault(x => x.Id == next.MediaId);
            if (m == null || MediaLibrary.UsesHidden(m, hidden)) continue;
            CloseSettings();
            OpenSettings(pl, next, m);
            return;
        }
    }

