            {
                var cur = Helpers.ItemSeconds(r.It, r.M, Svc.Find(r.M.AppId), media);
                <button type="button" class="le-d" title="Choisir la durée d'affichage" aria-haspopup="menu" aria-expanded="@(durFor == r.It ? "true" : "false")" @onclick:stopPropagation="true" @onclick="() => OpenDur(r.It)">@DurationText(r) <Ico Name="chevron" Size="13" /></button>
                @if (durFor == r.It)
                {
