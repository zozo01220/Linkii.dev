                    <div class="le-menu le-dp" role="menu" @onclick:stopPropagation="true">
                        <div class="le-dph">Durée d'affichage</div>
                        <div class="le-dpg">
                            @foreach (var s in DurPresets.Append(cur).Distinct().OrderBy(x => x))
                            {
                                var sec = s;
                                <button type="button" class="@(sec == cur ? "on" : "")" @onclick="() => SetDuration(r.It, sec)">@DurLabel(sec)</button>
                            }
                        </div>
                        <label class="le-sw"><input type="checkbox" @bind="durAll" /><i></i><span>Appliquer à tous les contenus</span></label>
                    </div>
                }
            }
            else if (DurationText(r) is { Length: > 0 } t)
            {
                <span class="le-d ro">@t</span>
            }
        </text>;

    private void SetDuration(PlaylistItem it, int secs)
    {
        if (Current is not { } pl) return;
        var all = durAll;
        durFor = null; durAll = false;
        var targets = all
            ? pl.Draft.Where(x => x.Placement == "full" && media.FirstOrDefault(m => m.Id == x.MediaId) is { } mm && !MediaLibrary.UsesHidden(mm, hidden)).ToList()
            : new List<PlaylistItem> { it };
        WriteList(d =>
        {
            foreach (var x in targets)
            {
                x.DurationSec = secs;
                if (ContentDuration(media.FirstOrDefault(m => m.Id == x.MediaId))) x.DurationMode = "fixed";
            }
            pl.Touch();
        });
        Toast.Ok(all ? $"Durée de {DurLabel(secs)} appliquée aux {targets.Count} contenus." : $"Durée : {DurLabel(secs)}.");
        Reload();
    }

