    private string? flowInitId;
    private DotNetObjectReference<PlaylistEditor>? selfRef;

    [JSInvokable]
    public Task DropApp(string appId, int at)
    {
        if (enabledApps.FirstOrDefault(a => a.Id == appId) is { } app) AddEmpty(app, at);
        return InvokeAsync(StateHasChanged);
    }

    // Le contenu glissé s'insère à la position visée (comptée avant son retrait)
    [JSInvokable]
    public Task MoveItem(int from, int at)
    {
        if (Current is { } pl && from >= 0 && from < pl.Draft.Count && at >= 0 && at <= pl.Draft.Count && at != from && at != from + 1)
        {
            var it = pl.Draft[from];
            var to = from < at ? at - 1 : at;
            WriteList(d =>
            {
                pl.Draft.RemoveAt(from);
                pl.Draft.Insert(to, it);
                pl.Touch();
            });
            Toast.Ok($"« {media.FirstOrDefault(x => x.Id == it.MediaId)?.Name ?? "Contenu"} » déplacé en position {to + 1}.");
            Reload();
            Flash(it.Id);
        }
        return InvokeAsync(StateHasChanged);
    }

    // Contenu qui vient d'être ajouté ou déplacé : surligné quelques secondes et amené à l'écran
    private Guid? freshId, revealId;
    private void Flash(Guid id)
    {
        freshId = id; revealId = id;
        _ = Task.Delay(2600).ContinueWith(_ => InvokeAsync(() => { if (freshId == id) { freshId = null; StateHasChanged(); } }));
    }
    private void Reveal(Guid id) => Flash(id);

