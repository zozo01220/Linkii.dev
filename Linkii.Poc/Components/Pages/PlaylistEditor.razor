@inject TenantStore Store
@inject AppService Svc
@inject CanvaService Canva
@inject IJSRuntime JS
@inject ScanLog Scans
@inject NavigationManager Nav
@inject Toaster Toast
@inject MediaLibrary MediaLib
@inject ModeService Modes
@using Microsoft.JSInterop
@implements IDisposable

@if (readOnlyHere)
{
    <div class="dw-note"><Ico Name="lock" Size="15" /><span class="grow">Cette liste est dans un dossier partagé en <b>lecture seule</b> : vous pouvez la voir et la diffuser, pas la modifier.</span></div>
}

<YoutubeDurations Items="media" OnUpdated="Refresh" />

@if (Current is { } pl)
{
    var rows = Rows(pl);
    var total = rows.Where(r => r.Plays).Sum(r => r.Seconds);
    var active = pl.Draft.Count(i => !i.Off);
    @* Tiroir du bas (maquette liste-diffusion-fil-horizontal.html, §186) : en-tête avec la durée totale, frise de la boucle,
       fil horizontal de cartes carrées, puis la bibliothèque en onglets par type (Images, Vidéos, Compositions, Présentations, Pages web, Intégrations). *@
    <div class="pfx @(mini ? "mini" : "")" @ref="flowRoot">
        <header class="pfx-head">
            <div class="pfx-title">
                @if (renaming)
                {
                    <div class="row rename-row">
                        <input class="grow" style="min-width:0" @ref="renameInput" @bind="renameValue" @bind:event="oninput" @onkeydown="e => OnRenameKey(e, pl)" aria-label="Nom de la liste de diffusion" />
                        <button class="btn sm" @onclick="() => Rename(pl)">Enregistrer</button>
                        <button class="btn ghost sm" @onclick="() => renaming = false">Annuler</button>
                    </div>
                }
                else
                {
                    <div class="pfx-name">
                        <h2>@pl.Name</h2>
                        @if (!readOnlyHere) { <button class="btn ghost sm icon" title="Renommer" aria-label="Renommer la liste de diffusion" @onclick="() => StartRename(pl)"><Ico Name="edit" Size="16" /></button> }
                    </div>
                }
                <p class="pfx-meta">
                    @if (onScreens > 0) { <span class="live">● Diffusée sur @onScreens écran@(onScreens > 1 ? "s" : "")</span> } else { <span>Non diffusée</span> }
                    @if (outside > 0) { <span title="Vos modifications les concerneront à leur prochaine publication."> · dont @outside hors de votre périmètre</span> }
                </p>
            </div>
            <div class="pfx-total" role="status" aria-label="Durée totale de la boucle">
                <Ico Name="refresh" Size="20" />
                <span><small>Durée totale de la boucle</small><b class="mono">@Helpers.FormatDuration(total)</b></span>
                <span class="sep"><small>Contenus</small><b class="mono">@active</b></span>
            </div>
            @if (!readOnlyHere && pl.Draft.Count > 1) { <button type="button" class="btn ghost" title="Choisir l'effet de passage d'un contenu au suivant, pour tous les contenus" @onclick="() => trAll = true"><Ico Name="chevron-right" Size="16" /> Transitions</button> }
            @if (pl.Draft.Count > 0) { <button type="button" class="btn ghost" title="Voir la liste sur un écran ou un mur, sans rien publier" @onclick="() => trying = true"><Ico Name="play" Size="16" /> Aperçu</button> }
            <button type="button" class="pfx-ib" title="Fermer" aria-label="Fermer" @onclick="Close"><Ico Name="x" Size="20" /></button>
        </header>

        <div class="pfx-filwrap">
            <button type="button" class="pfx-nav l" aria-label="Défiler vers la gauche" @onclick='() => Scroll(-1)'><Ico Name="chevron-left" Size="18" /></button>
            <div class="pfx-fil pf-flow cards">
                @foreach (var r in rows)
                {
                    var row = r;
                    <div class="pf-u pfx-u @RowClass(row) @(pickAt == row.Index ? "pick" : "")" data-i="@row.Index" data-id="@row.It.Id" data-drag="@(Draggable(row) ? "1" : null)" @key="row.It">
                        @if (Modes.Expert && row.Index > 0 && row.It.Placement == "full")
                        {
                            @* transition jouée à l'arrivée de ce contenu, depuis le précédent *@
                            <button type="button" class="pfx-tr @(row.It.Transition != Transitions.Default ? "set" : "")" title="Transition : @Transitions.Label(row.It.Transition)" aria-label="Transition avant le contenu @(row.Index + 1) : @Transitions.Label(row.It.Transition)" @onclick="() => trItem = row.It"><Ico Name="@TrIcon(row.It.Transition)" Size="14" /></button>
                        }
                        @Card(row)
                        <div class="pfx-when @WhenClass(row)">@When(row)</div>
                    </div>
                }
                @if (!readOnlyHere)
                {
                    <div class="pf-u pf-end-row pfx-u pfx-endu @(pickAt == pl.Draft.Count ? "pick" : "")">
                        <div class="pf-end pfx-end">
                            <Ico Name="plus" Size="22" />
                            <span>@(pl.Draft.Count == 0 ? "Glissez ou cliquez un contenu de la bibliothèque pour commencer la liste" : "Glissez ou cliquez un contenu de la bibliothèque pour l'ajouter à la fin")</span>
                        </div>
                        <div class="pfx-when">&nbsp;</div>
                    </div>
                }
                @if (pl.Draft.Count > 0)
                {
                    <div class="pfx-loop"><span class="r"><Ico Name="refresh" Size="18" /></span>à <b class="mono">@Helpers.FormatDuration(total)</b><br />recommence au contenu 1</div>
                }
            </div>
            <button type="button" class="pfx-nav r" aria-label="Défiler vers la droite" @onclick='() => Scroll(1)'><Ico Name="chevron-right" Size="18" /></button>
        </div>

        @if (!readOnlyHere && !mini)
        {
            var tabs = LibTabs().ToList();
            if (!tabs.Any(t => t.Key == libTab) && tabs.Count > 0) libTab = tabs[0].Key;
            <section class="pfx-lib" aria-label="Bibliothèque">
                <div class="pfx-libh"><b>Ajouter au fil</b><span>Choisissez un type de contenu, puis cliquez ou glissez dans le fil.</span></div>
                <div class="pfx-tabs" role="tablist" aria-label="Types de contenus">
                    @foreach (var t in tabs)
                    {
                        var tab = t;
                        <button type="button" role="tab" aria-selected="@(libTab == tab.Key ? "true" : "false")" class="@(libTab == tab.Key ? "on" : "")" @onclick='() => { libTab = tab.Key; libSearch = ""; }'>
                            @tab.Label<span class="c">@tab.Count</span>
                        </button>
                    }
                </div>
                <div class="pfx-tools">
                    <label class="search-box"><Ico Name="search" Size="16" /><input placeholder="Rechercher" aria-label="Rechercher dans la bibliothèque" @bind="libSearch" @bind:event="oninput" /></label>
                    @if (pickAt is { } pa)
                    {
                        <span class="pfx-hint"><b>Le prochain contenu choisi sera inséré en position @(pa + 1).</b> <button type="button" class="pf-link" @onclick="() => pickAt = null">Annuler</button></span>
                    }
                    @LibAction()
                </div>
                <div class="pfx-grid">@LibGrid()</div>
            </section>
        }
    </div>
    @* import depuis les onglets Images / Vidéos : champ de fichiers caché (ouvert par « Importer ») et fenêtre « Depuis le cloud » (expert), gardés dans la page pour que l'import continue *@
    @if (canImport)
    {
        <MediaUploader InputId="@ImportInputId" OnImported="Imported" ShowJobs="false" Changed="StateHasChanged" @ref="importer" />
        @if (impCloud && Modes.Expert)
        {
            <div class="modal-backdrop" @onclick="() => impCloud = false"></div>
            <div class="imp-bottom lx-import" role="dialog" aria-modal="true" aria-labelledby="pf-imp-title">
                <div class="imp-head">
                    <h3 id="pf-imp-title">Importer depuis le cloud<small>Chaque page d'un document devient une image, rangée dans une présentation du dossier « …_médias ».</small></h3>
                    <button type="button" class="modal-x" aria-label="Fermer" @onclick="() => impCloud = false"><Ico Name="x" Size="20" /></button>
                </div>
                <div class="imp-body"><DocumentImporter OnImported="CloudImported" /></div>
                <div class="imp-foot"><span>Une fois le compte connecté, on revient ici et la tuile est déverrouillée.</span><button class="btn ghost" @onclick="() => impCloud = false">Fermer</button></div>
            </div>
        }
    }
}
else
{
    <div class="card empty"><div class="big">Liste de diffusion introuvable</div><p>Elle a peut-être été supprimée. <button type="button" class="back" @onclick="Close">Revenir aux listes de diffusion</button></p></div>
}

@{
    // Onglets « Contenu / QR code » de la fenêtre d'un contenu, en tête de la colonne de droite (comme « Écran / Widgets » de l'éditeur d'écran).
    // Partagés par la création (galerie → fenêtre de l'app) et par la fenêtre de réglage d'un contenu existant.
    var qrAngle = mPlacement != "full";   // un contenu en angle ou en bandeau n'a pas de QR code : l'onglet est grisé
    var qrScans = mItem != null && scanCounts.TryGetValue(mItem.Id, out var qc) ? qc.Scans : 0;
    RenderFragment qrTabs = @<div class="se-utabs" role="tablist" aria-label="Réglage du contenu">
        <button type="button" role="tab" aria-selected="@(mTab == "content" ? "true" : "false")" class="@(mTab == "content" ? "on" : "")" @onclick='() => mTab = "content"'><Ico Name="monitor" Size="18" /> Contenu</button>
        @if (mItem != null)
        {
            <button type="button" role="tab" aria-selected="@(mTab == "prog" ? "true" : "false")" class="@(mTab == "prog" ? "on" : "")" @onclick='() => mTab = "prog"'>
                <Ico Name="calendar" Size="18" /> Programmation
                @if (mSchedOn) { <span class="tab-dot" title="Une période est définie"></span> }
            </button>
        }
        <button type="button" role="tab" aria-selected="@(mTab == "qr" ? "true" : "false")" class="@(mTab == "qr" && !qrAngle ? "on" : "")" disabled="@qrAngle"
                title="@(qrAngle ? "Le QR code n'est disponible que pour un contenu en pleine page." : "")" @onclick='() => mTab = "qr"'>
            <Ico Name="qr" Size="18" /> QR code
            @if (!growth) { <span class="tab-lock"><Ico Name="lock" Size="12" /> Pro</span> }
            else if (mQrOn && qrScans > 0) { <small class="on-badge">@qrScans</small> }
        </button>
    </div>;
    // Onglet « Programmation » : période de diffusion du contenu (début et fin facultatifs), colonne de droite comme « QR code »
    RenderFragment progPane = @<div class="ci-prog">
        <h4 class="ci-t">Période de diffusion</h4>
        <div class="ci-seg" role="radiogroup" aria-label="Période de diffusion">
            <button type="button" role="radio" aria-checked="@(mSchedOn ? "false" : "true")" class="@(mSchedOn ? "" : "on")" @onclick="() => mSchedOn = false">Toujours</button>
            <button type="button" role="radio" aria-checked="@(mSchedOn ? "true" : "false")" class="@(mSchedOn ? "on" : "")" @onclick="() => mSchedOn = true">Période</button>
        </div>
        @if (mSchedOn)
        {
            <div class="ci-sched">
                <div class="ci-sched-row"><b>Début</b><input type="date" aria-label="Date de début" value="@mFromDate" @onchange='e => mFromDate = e.Value?.ToString() ?? ""' /><input type="time" aria-label="Heure de début" value="@mFromTime" @onchange='e => mFromTime = e.Value?.ToString() ?? ""' /></div>
                <div class="ci-sched-row"><b>Fin</b><input type="date" aria-label="Date de fin" value="@mToDate" @onchange='e => mToDate = e.Value?.ToString() ?? ""' /><input type="time" aria-label="Heure de fin" value="@mToTime" @onchange='e => mToTime = e.Value?.ToString() ?? ""' /></div>
                <p class="hint">Laissez un champ vide pour ne pas limiter de ce côté. Heure de l'écran.</p>
                <div class="ci-sched-sum">@ScheduleSummary()</div>
            </div>
        }
        else { <p class="hint">Le contenu passe en boucle sans limite de date.</p> }
    </div>;
    RenderFragment qrPreview = @<div>
        <h4 class="ci-t">Aperçu de l'écran</h4>
        <QrPlacer Format="@mFormat" FormatChanged="SetFormatValue" Media="(newForm ?? itemForm)?.PickedMedia() ?? mMedia" Fit="@((newForm ?? itemForm)?.PreviewFit ?? "contain")" All="media" Text="@(growth && mQrOn ? QrText : null)" X="mQrX" Y="mQrY" Size="mQrSize" Label="@mQrLabel" OnMoved="QrMoved" />
    </div>;
    RenderFragment qrPane = @<div class="ci-qr">
        <div class="ci-qr-master">
            <div><b>Compter les scans du QR code</b><small>Un QR code est ajouté au contenu ; chaque scan est comptabilisé.</small></div>
            <input type="checkbox" class="ios" checked="@(growth && mQrOn)" disabled="@(!growth)" aria-label="Compter les scans du QR code" @onchange="e => ToggleQr(e.Value is true)" />
        </div>
        @if (!growth) { <div class="ci-qr-locked">@Plans.LockedHint.</div> }
        else if (mQrOn)
        {
            <div class="qr-fields">
                <div class="dw-field"><label>Emplacement</label>
                    <div class="qr-pos" role="group" aria-label="Emplacement du QR code">
                        @foreach (var (key, label) in QrSpots) { if (key == "c") { <span aria-hidden="true"></span> continue; } <button type="button" class="qr-pos-@key" title="@label" aria-label="@label" @onclick="() => PlaceQr(key)"><i></i></button> }
                    </div>
                    <small>Ou glissez le QR code directement dans l'aperçu.</small>
                </div>
                <div class="dw-field"><label for="qr-url">Adresse de destination *</label><input id="qr-url" type="text" inputmode="url" maxlength="@QrTracking.UrlMax" placeholder="https://…" @bind="mQrUrl" @bind:event="oninput" /></div>
                <div class="dw-field"><label for="qr-lbl">Texte sous le QR code</label><input id="qr-lbl" type="text" maxlength="@QrTracking.LabelMax" @bind="mQrLabel" @bind:event="oninput" /></div>
                <div class="dw-field"><label for="qr-size">Taille <span class="mono">@Math.Round(mQrSize) %</span></label><input id="qr-size" type="range" min="@QrTracking.MinSize" max="@QrTracking.MaxSize" step="1" value="@Math.Round(mQrSize)" @oninput="ChangeQrSize" /></div>
            </div>
        }
    </div>;
    // l'onglet ouvert remplace la colonne de configuration : « QR code » ou « Programmation » (sans aperçu du contenu pour ce dernier)
    bool otherOpen = (mTab == "qr" && !qrAngle) || (mTab == "prog" && mItem != null);
    RenderFragment otherPane = mTab == "prog" ? progPane : qrPane;
    RenderFragment? otherPreview = mTab == "prog" ? null : qrPreview;
}

@if (newApp != null && Current is { } target)
{
    var a = newApp;
    <div class="modal-backdrop" @onclick="() => newApp = null"></div>
    <div class="modal app-modal ci-modal" role="dialog" aria-modal="true" aria-labelledby="new-app-title">
        <div class="modal-head">
            <AppIcon Id="@a.Id" />
            <div class="grow">
                <div class="ci-title"><h3 id="new-app-title">@(newName ?? a.Name)</h3> <button type="button" class="btn ghost sm icon" title="Renommer" aria-label="Renommer" @onclick="() => newForm?.OpenRename()"><Ico Name="edit" Size="15" /></button></div>
                <small>Ajout à « @target.Name »</small>
            </div>
            @if (a.HasAdvanced) { <button type="button" class="modal-x" aria-label="Options avancées" title="Options avancées" @onclick="() => newForm?.OpenAdvanced()"><Ico Name="sliders" Size="20" /></button> }
            <button type="button" class="modal-x" aria-label="Fermer" @onclick="() => newApp = null"><Ico Name="x" Size="20" /></button>
        </div>
        <div class="modal-body">
            <AppInstanceForm @key="a.Id" AppId="@a.Id" ShowActions="false" OnSaved="item => AddApp(target, item)" OnRenamed="n => newName = n" @ref="newForm"
                             ConfTabs="qrTabs" OtherTab="@otherOpen" OtherPane="@otherPane" OtherPreview="@otherPreview" PreviewQr="PreviewQr" PreviewQrMoved="QrMoved" PreviewPortrait="portraitScreens" PreviewPlace="mPlacement" PreviewFormat="@mFormat" PreviewFormatChanged="SetFormatValue" />
</div>
        <div class="modal-foot">
            <button class="btn ghost" @onclick="() => newApp = null">Annuler</button>
            @if (AppInstanceForm.NeedsTest(a)) { <button class="btn ghost" @onclick="() => newForm!.Test()">Tester</button> }
            <button class="btn" @onclick="SaveNew">Ajouter à la liste de lecture</button>
        </div>
    </div>
}

@if (pickCompo && Current is { } cpl)
{
    @* Compositions (§80) : celles de « Mes compositions » se choisissent ici ; une nouvelle s'ajoute dès son premier enregistrement. *@
    <div class="modal-backdrop" @onclick="() => pickCompo = false"></div>
    <div class="modal app-modal" role="dialog" aria-modal="true" aria-labelledby="cmp-pick-title" style="max-width:760px">
        <div class="modal-head">
            <AppIcon Id="@Compositions.AppId" />
            <div class="grow"><h3 id="cmp-pick-title">Ajouter une composition</h3><small>À « @cpl.Name »</small></div>
            <button type="button" class="modal-x" aria-label="Fermer" @onclick="() => pickCompo = false"><Ico Name="x" Size="20" /></button>
        </div>
        <div class="modal-body">
            @if (compoItems.Count == 0)
            {
                <div class="empty compact"><div class="big">Aucune composition</div><p>Créez-en une : elle sera enregistrée dans « Mes compositions » et ajoutée à cette liste.</p></div>
            }
            else
            {
                <p class="hint">Choisissez une composition de « Mes compositions ». Elle peut aussi servir dans d'autres listes.</p>
                <div class="cmp-pick">
                    @foreach (var c in compoItems)
                    {
                        var ci = c;
                        <button type="button" class="cmp-choice" @onclick="() => AddComposition(ci)">
                            <CompositionThumb Item="ci" Files="compoFiles" Label="@("Aperçu de " + ci.Name)" />
                            <span><b>@ci.Name</b>@if (Compositions.Size(ci.Settings) is { } sz) { <small>@sz.W × @sz.H</small> }</span>
                        </button>
                    }
                </div>
            }
        </div>
        <div class="modal-foot">
            <button class="btn ghost" @onclick="() => pickCompo = false">Annuler</button>
            <a class="btn" href="@NewCompositionUrl"><Ico Name="plus" Size="16" /> Créer une composition</a>
        </div>
    </div>
}

@if ((trItem != null || trAll) && Current is { } trpl)
{
    var src = trItem ?? trpl.Draft.Skip(1).FirstOrDefault() ?? trpl.Draft.FirstOrDefault();
    var trNum = trpl.Draft.IndexOf(src!) + 1;
    <div class="modal-backdrop" @onclick="CloseTransition"></div>
    <div class="modal pfx-trm" role="dialog" aria-modal="true" aria-labelledby="tr-title" style="max-width:520px">
        <div class="modal-head">
            <div class="grow"><h3 id="tr-title">@(trAll ? "Transitions de la liste" : "Transition")</h3><small>@(trAll ? "Un même effet entre tous les contenus" : $"Entre le contenu {trNum - 1} et le contenu {trNum}")</small></div>
            <button type="button" class="modal-x" aria-label="Fermer" @onclick="CloseTransition"><Ico Name="x" Size="20" /></button>
        </div>
        <div class="modal-body">
            <div class="pfx-trg" role="radiogroup" aria-label="Type de transition">
                @foreach (var t in Transitions.All)
                {
                    var id = t.Id;
                    <button type="button" role="radio" aria-checked="@(src!.Transition == id)" class="pfx-tro @(src.Transition == id ? "on" : "")" @onclick="() => SetTransition(trpl, src, id, null)"><span class="pfx-trp tr-@id"><i></i><i></i></span>@t.Label</button>
                }
            </div>
            @if (src!.Transition != "cut")
            {
                <label class="pfx-trd">Durée <input type="range" min="@Transitions.MinMs" max="@Transitions.MaxMs" step="100" value="@src.TransitionMs" @onchange="e => SetTransition(trpl, src, src.Transition, int.TryParse(e.Value?.ToString(), out var ms) ? ms : null)" /> <b class="mono">@((src.TransitionMs / 1000.0).ToString("0.0")) s</b></label>
            }
        </div>
        <div class="modal-foot">
            @if (!trAll && Modes.Expert) { <button class="btn ghost" @onclick="() => ApplyTransitionToAll(trpl, src)">Appliquer à toutes les transitions</button> }
            <button class="btn" @onclick="CloseTransition">OK</button>
        </div>
    </div>
}

@if (mItem != null && mPlaylist != null)
{
    var isApp = mMedia?.AppId != null;
    <div class="modal-backdrop" @onclick="CloseSettings"></div>
    <div class="modal @(isApp ? "app-modal ci-modal" : "")" role="dialog" aria-modal="true" aria-labelledby="modal-title">
        @if (isApp)
        {
            <div class="modal-head">
                <AppIcon Id="@mMedia!.AppId" />
                <div class="grow">
                    <div class="ci-title"><h3 id="modal-title">@(itemName ?? mMedia.Name)</h3> <button type="button" class="btn ghost sm icon" title="Renommer" aria-label="Renommer" @onclick="() => itemForm?.OpenRename()"><Ico Name="edit" Size="15" /></button></div>
                    <small>@Svc.Find(mMedia.AppId)?.Name</small>
                </div>
                @if (Svc.Find(mMedia.AppId) is { HasAdvanced: true }) { <button type="button" class="modal-x" aria-label="Options avancées" title="Options avancées" @onclick="() => itemForm?.OpenAdvanced()"><Ico Name="sliders" Size="20" /></button> }
                @if (mPlaylist.Draft.Count > 1)
                {
                    <button type="button" class="modal-x" aria-label="Contenu précédent" title="Contenu précédent" @onclick="() => StepSettings(-1)"><Ico Name="chevron-left" Size="20" /></button>
                    <button type="button" class="modal-x" aria-label="Contenu suivant" title="Contenu suivant" @onclick="() => StepSettings(1)"><Ico Name="chevron-right" Size="20" /></button>
                }
                <button type="button" class="modal-x" aria-label="Fermer" @onclick="CloseSettings"><Ico Name="x" Size="20" /></button>
            </div>
        }
        else
        {
            <div class="row" style="align-items:flex-start">
                <div class="grow"><h3 id="modal-title">Paramètres du contenu</h3><p class="hint"><b>@mMedia?.Name</b> · @(mMedia?.Type == "video" ? "vidéo" : "image")</p></div>
                @if (mPlaylist.Draft.Count > 1)
                {
                    <button type="button" class="modal-x" aria-label="Contenu précédent" title="Contenu précédent" @onclick="() => StepSettings(-1)"><Ico Name="chevron-left" Size="20" /></button>
                    <button type="button" class="modal-x" aria-label="Contenu suivant" title="Contenu suivant" @onclick="() => StepSettings(1)"><Ico Name="chevron-right" Size="20" /></button>
                }
            </div>
        }
        @* réglages de ce contenu dans la liste (position, durée) : pour une app, à droite de l'aperçu (colonne de configuration), sinon sous le titre *@
        @{
            RenderFragment listSettings = @<div class="dw">
            @if (mPlacement != "full")
            {
                <div class="dw-note">Ce contenu reste affiché en permanence pendant toute la boucle : il n'a pas de durée.</div>
            }
            else if (ContentDuration(mMedia))
            {
                <div class="dw-field">
                    <label>Durée d'affichage</label>
                    <select value="@mMode" @onchange="ChangeMode">
                        <option value="content" selected="@(mMode == "content")">Jusqu'à la fin du contenu</option>
                        <option value="fixed" selected="@(mMode == "fixed")">Durée fixe</option>
                    </select>
                    @if (Helpers.VideoSeconds(mMedia) is { } vs) { <small>Durée de la vidéo : @Helpers.FormatDuration(vs).</small> }
                    <small>« Jusqu'à la fin » passe au contenu suivant à la fin de la vidéo (dans la limite de la durée maximale de l'app). « Durée fixe » coupe ou rejoue la vidéo à ce terme.</small>
                </div>
                @if (mMode == "fixed")
                {
                    <div class="dw-field"><label>Durée fixe (secondes)</label><input type="number" min="1" max="86400" @bind="mSeconds" /></div>
                }
            }
            else
            {
                <div class="dw-field"><label>Durée d'affichage (secondes)</label><input type="number" min="1" max="86400" @bind="mSeconds" /></div>
            }
