            RenderFragment appExtra = @<section class="ci-listset" aria-label="Dans cette liste de diffusion"><h4 class="ci-t">Dans cette liste de diffusion</h4>@listSettings</section>;
        }
        @if (isApp)
        {
            <div class="modal-body">
                <AppInstanceForm @key="mMedia!.Id" AppId="@(mMedia!.AppId!)" InstanceId="mMedia!.Id" ShowActions="false" OnSaved="_ => SaveSettings()" OnRenamed="n => itemName = n" Extra="appExtra" ConfTabs="qrTabs" OtherTab="@otherOpen" OtherPane="@otherPane" OtherPreview="@otherPreview" PreviewQr="PreviewQr" PreviewQrMoved="QrMoved" PreviewPortrait="portraitScreens" PreviewPlace="mPlacement" PreviewFormat="@mFormat" PreviewFormatChanged="SetFormatValue" OnOpenEditor="OpenCompositionEditor" @ref="itemForm" />
            </div>
        }
        else if (mItem != null)
        {
            @* contenu d'une image ou d'une vidéo : deux onglets, comme ceux d'une app (Contenu / Programmation) *@
            <div class="se-utabs" role="tablist" aria-label="Réglage du contenu">
                <button type="button" role="tab" aria-selected="@(mTab == "prog" ? "false" : "true")" class="@(mTab == "prog" ? "" : "on")" @onclick='() => mTab = "content"'><Ico Name="monitor" Size="18" /> Contenu</button>
                <button type="button" role="tab" aria-selected="@(mTab == "prog" ? "true" : "false")" class="@(mTab == "prog" ? "on" : "")" @onclick='() => mTab = "prog"'>
                    <Ico Name="calendar" Size="18" /> Programmation
                    @if (mSchedOn) { <span class="tab-dot" title="Une période est définie"></span> }
                </button>
            </div>
            @if (mTab == "prog") { @progPane } else { @listSettings }
        }
        else { @listSettings }
        <div class="@(isApp ? "modal-foot" : "modal-actions") pfx-mfoot">
            @* actions de la carte (anciennement dans le menu ⋮) : retirer, dupliquer, désactiver *@
            @if (!readOnlyHere)
            {
                <button type="button" class="btn ghost pfx-del" @onclick="() => { var it = mItem; var p = mPlaylist; CloseSettings(); RemoveWithUndo(p!, it!); }"><Ico Name="trash" Size="15" /> Retirer du fil</button>
                <button type="button" class="btn ghost" title="Le même contenu passe une seconde fois, juste après" @onclick="() => { var it = mItem; var p = mPlaylist; CloseSettings(); Duplicate(p!, it!); }"><Ico Name="copy" Size="15" /> Dupliquer</button>
                <button type="button" class="btn ghost" title="@(mItem.Off ? "Le contenu repasse dans la boucle" : "Le contenu reste dans la liste mais la boucle le saute")" @onclick="() => { var it = mItem; var p = mPlaylist; CloseSettings(); ToggleOff(p!, it!); }"><Ico Name="@(mItem.Off ? "eye" : "eye-off")" Size="15" /> @(mItem.Off ? "Réactiver" : "Désactiver")</button>
            }
            <span class="grow"></span>
            <button class="btn ghost" @onclick="CloseSettings">Annuler</button>
            @if (isApp && Svc.Find(mMedia!.AppId) is { } ma && AppInstanceForm.NeedsTest(ma)) { <button class="btn ghost" @onclick="() => itemForm!.Test()">Tester</button> }
            <button class="btn" @onclick="SaveAll">Enregistrer</button>
        </div>
    </div>
}

