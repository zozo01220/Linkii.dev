            @if (libTab is "all" or "img" or "vid")
            {
                @foreach (var j in ImportJobs)
                {
                    var job = j;
                    var failed = job.State == "error";
                    <div class="le-job @(failed ? "fail" : "")" role="status">
                        <b>@job.Name</b>
                        @if (!failed) { <span class="bar"><i style="width:@(MediaUploader.Pct(job))%"></i></span> }
                        <span>@(failed ? job.Error ?? "Échec de l'import" : job.Note ?? (job.Total is > 0 ? $"Import · {MediaUploader.Pct(job)} %" : "Import…")) · <button type="button" class="pf-link" @onclick="() => DismissImport(job)">@(failed ? "Retirer" : "Annuler")</button></span>
                    </div>
                }
            }
            @{
                var entries = CatEntries(libTab).ToList();
                var shownEntries = libTab == "all" ? entries.Take(CatAllMax).ToList() : entries;
            }
            @foreach (var e in shownEntries)
            {
                var en = e;
                <button type="button" class="le-it @(en.Used > 0 ? "in" : "") @(en.Fresh ? "fresh" : "")" data-add="@(en.Busy ? null : en.Drag)" data-fresh="@(en.Fresh ? "1" : null)" disabled="@en.Busy"
                        title="@(en.Busy ? "Conversion en cours : le média sera ajoutable dans un instant" : "Cliquer : ajouter à la fin · glisser : le poser à l'endroit voulu")" @onclick="en.Add">
                    <span class="ic @(en.AppId != null ? "app" : "")" style="@(en.AppId != null ? $"background:{AppIcon.LookOf(en.AppId).Color}" : en.M != null ? $"background:{AppIcon.LookOf(LookId(en.M)).Color}" : null)">
                        @if (en.AppId != null) { <AppIcon Id="@en.AppId" Tile="false" Size="26" /> }
                        else if (en.M?.AppId == Compositions.AppId) { <CompositionThumb Item="en.M" Files="compoFiles" Contain="true" /> }
                        else if (en.M != null) { <MediaThumb Media="en.M" All="media" /> }
                    </span>
                    <span><b>@en.Name</b><small>@en.Sub</small></span>
                    <span class="le-add"><Ico Name="@(en.Used > 0 ? "check" : "plus")" Size="16" /></span>
                </button>
            }
            @if (entries.Count == 0 && ImportJobs.Count == 0) { <p class="le-none">@CatEmpty()</p> }
            else if (libTab == "all" && entries.Count > CatAllMax) { <p class="le-none">… et @(entries.Count - CatAllMax) autres : choisissez un type ou cherchez par nom.</p> }
        </text>;

    /// <summary>Page web ou présentation déjà réglée ailleurs : elle rejoint le fil avec sa propre copie des réglages (la changer ici ne change pas l'autre liste).</summary>
    private void AddInstance(MediaItem src, int? position)
    {
        if (Current is not { } pl) return;
        var dur = Store.Read(d => d.Tenant.DefaultDurationSec);
        var at = position is { } i && i >= 0 && i < pl.Draft.Count ? i : pl.Draft.Count;
        var row = new PlaylistItem { DurationSec = dur, Placement = "full" };
        WriteList(d =>
        {
            if (d.Media.FirstOrDefault(x => x.Id == src.Id && x.AppId != null) is not { } s) return;
            if (Svc.PlaylistsUsing(s.Id).Count == 0) row.MediaId = s.Id;   // pas encore dans une liste : réutilisée telle quelle
            else
            {
                var name = s.Name.Length > 80 ? s.Name[..80] : s.Name;
                var inst = new MediaItem
                {
                    ClientId = s.ClientId, AreaId = s.AreaId, Name = name, Type = s.Type, AppId = s.AppId, AppVersion = s.AppVersion,
                    Settings = new(s.Settings), Secrets = new(s.Secrets), Info = new(s.Info), FolderId = s.FolderId, OwnerId = s.OwnerId, AddedUtc = DateTime.UtcNow
                };
                d.Media.Add(inst);
                row.MediaId = inst.Id;
            }
            pl.Draft.Insert(at, row);
            pl.Touch();
        });
        if (row.MediaId == Guid.Empty) { Toast.Error("Ce contenu n'existe plus."); Reload(); return; }
        Toast.Ok($"« {src.Name} » ajouté en position {at + 1}.");
        Reload();
        Flash(row.Id);
    }

    private void AddCompositionAt(MediaItem c, int? position) { insertAt = position; AddComposition(c); }

    [JSInvokable]
    public Task DropAdd(string key, int at)
    {
        var p = key.IndexOf(':');
        var (kind, id) = p > 0 ? (key[..p], key[(p + 1)..]) : ("", key);
        pickAt = null;
        if (kind == "app") { if (enabledApps.FirstOrDefault(a => a.Id == id) is { } app) AddEmpty(app, at); }
        else if (Guid.TryParse(id, out var g))
        {
            if (kind == "med" && pickFiles.FirstOrDefault(m => m.Id == g) is { } file) AddMedia(file, at);
            else if (kind == "cmp" && compoItems.FirstOrDefault(m => m.Id == g) is { } c) AddCompositionAt(c, at);
            else if (kind == "inst" && webItems.Concat(presItems).FirstOrDefault(m => m.Id == g) is { } inst) AddInstance(inst, at);
        }
        return InvokeAsync(StateHasChanged);
    }

    // Retirer (mode simple) : tout de suite, avec « Annuler » dans le message
    private void RemoveWithUndo(Playlist pl, PlaylistItem it)
    {
        var at = pl.Draft.IndexOf(it);
        if (at < 0) return;
        var name = media.FirstOrDefault(x => x.Id == it.MediaId)?.Name ?? "Contenu";
        WriteList(d => { pl.Draft.Remove(it); pl.Touch(); });
        Reload();
        Toast.Ok($"« {name} » retiré de la liste.", "Annuler", () => InvokeAsync(() =>
        {
            if (Current is not { } cur || cur.Draft.Contains(it)) return;
            WriteList(d => { cur.Draft.Insert(Math.Min(at, cur.Draft.Count), it); cur.Touch(); });
            Reload();
            Flash(it.Id);
            StateHasChanged();
        }));
    }

    // ---------- Actions du menu ⋮ ----------
    // Dupliquer : le même contenu passe une seconde fois, juste après (QR de comptage : une adresse courte à lui)
    private void Duplicate(Playlist pl, PlaylistItem it)
    {
        var copy = new PlaylistItem
        {
            MediaId = it.MediaId, DurationSec = it.DurationSec, DurationMode = it.DurationMode, Placement = it.Placement, Off = it.Off, StartsAt = it.StartsAt, EndsAt = it.EndsAt, Transition = it.Transition, TransitionMs = it.TransitionMs,
            QrOn = it.QrOn, QrCode = it.QrOn ? QrTracking.NewCode() : null, QrUrl = it.QrUrl, QrLabel = it.QrLabel, QrBase = it.QrBase, QrX = it.QrX, QrY = it.QrY, QrSize = it.QrSize
        };
        WriteList(d =>
        {
            // Un contenu d'app (Canva, page web…) a ses propres réglages : la copie en reçoit une instance à elle, sinon changer l'un changerait l'autre.
            // Fichiers image / vidéo et compositions restent partagés (on ne les modifie pas ici).
            if (d.Media.FirstOrDefault(x => x.Id == it.MediaId) is { AppId: not null } src && src.AppId != Compositions.AppId)
            {
                var name = src.Name.Length > 70 ? src.Name[..70] : src.Name;
                var inst = new MediaItem
                {
                    ClientId = src.ClientId, AreaId = src.AreaId, Name = name + " (copie)", Type = src.Type, AppId = src.AppId, AppVersion = src.AppVersion,
                    Settings = new(src.Settings), Secrets = new(src.Secrets), Info = new(src.Info), FolderId = src.FolderId, OwnerId = src.OwnerId, AddedUtc = DateTime.UtcNow
                };
                d.Media.Add(inst);
                copy.MediaId = inst.Id;
            }
            var at = pl.Draft.IndexOf(it);
            pl.Draft.Insert(at < 0 ? pl.Draft.Count : at + 1, copy);
            pl.Touch();
        });
        Reload();
        Flash(copy.Id);
    }

