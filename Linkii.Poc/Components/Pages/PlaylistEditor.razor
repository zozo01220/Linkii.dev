        if (Has(Compositions.AppId)) yield return new("cmp", "Compositions", AppIcon.LookOf(Compositions.AppId).Color, compoItems.Count);
        if (PresApps.Any(Has)) yield return new("pres", "Présentations", AppIcon.LookOf("ms-powerpoint").Color, presItems.Count);
        if (Has("webpage")) yield return new("web", "Pages web", AppIcon.LookOf("webpage").Color, webItems.Count);
        yield return new("app", "Applications", "var(--muted)", OtherApps.Count());
    }

