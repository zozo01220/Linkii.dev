    private RenderFragment ImportButton() => !canImport ? @<span></span> : Modes.Simple
        ? @<label for="@ImportInputId" class="pf-imp-btn" role="button" tabindex="0" title="Importer des images ou des vidéos depuis l'ordinateur"><Ico Name="upload" Size="14" /> Importer</label>
        : @<span class="pf-imp">
            <button type="button" class="pf-imp-btn" aria-haspopup="menu" aria-expanded="@(impMenu ? "true" : "false")" @onclick="() => { impUrl = false; impMenu = !impMenu; }"><Ico Name="upload" Size="14" /> Importer <Ico Name="chevron" Size="12" /></button>
            @if (impMenu)
            {
