@using System.Text.Json
@using Microsoft.JSInterop
@using Plan = Linkii.Poc.Planning
@inject TenantStore Store
@inject Notifier Notifier
@inject ScreenPublisher Publisher
@inject NavigationManager Nav
@inject Toaster Toast

@* Borne interactive (§168) : la fenêtre ne garde que l'essentiel. La liste interactive (ce que le visiteur touche) se crée et se règle dans Listes de lecture › Listes interactives ;
   ici on choisit celle de la borne, ce que l'écran diffuse quand personne ne touche (une liste de lecture, ou deux : haut/bas en portrait, gauche/droite en paysage) et les réglages.
   Tout se règle sur une copie de travail : rien n'est enregistré avant « Enregistrer », rien ne part sur la borne avant la publication (même workflow que les écrans).
   Les statistiques de la borne sont dans Statistiques › Bornes. Maquette validée : maquettes/liste-interactive-editeur.html. *@

@if (s?.Kiosk is null || k is null)
{
    <div class="modal-backdrop" @onclick="Close"></div>
    <div class="modal app-modal" role="dialog" aria-modal="true" aria-label="Borne introuvable">
        <div class="modal-head"><div class="grow"><h3>Borne introuvable</h3></div><button type="button" class="modal-x" aria-label="Fermer" @onclick="Close"><Ico Name="x" Size="20" /></button></div>
        <div class="modal-body"><p class="hint">Cet écran n'est pas une borne interactive, ou il a été supprimé.</p></div>
    </div>
}
else
{
    var portrait = orientation == "portrait";
    var list = CurrentList;
    var zoneDef = ScreenLayouts.Find(layout);
    var split = zoneDef.Sizes.Length > 1;
    var tileCount = list?.Pages.Sum(p => p.Els.Count(e => e.Kind == "tile")) ?? 0;
    <div class="modal-backdrop" @onclick="Close"></div>
    <div class="modal app-modal wg-modal kp-win" role="dialog" aria-modal="true" aria-labelledby="kp-title">
        <div class="modal-head">
            <span class="app-ico" style="--app-c:#C45A00"><Ico Name="hand" Size="22" /></span>
            <div class="grow" style="min-width:0">
                @if (headRename)
                {
                    <div class="row se-rename">
                        <input class="grow" maxlength="80" @bind="headValue" @bind:event="oninput" @onkeydown="OnHeadKey" aria-label="Nom de la borne" />
                        <button type="button" class="btn sm" disabled="@string.IsNullOrWhiteSpace(headValue)" @onclick="SaveHeadRename">Renommer</button>
                        <button type="button" class="btn ghost sm" @onclick="() => headRename = false">Annuler</button>
                    </div>
                }
                else
                {
                    <div class="row" style="gap:8px;flex-wrap:nowrap">
                        <h3 id="kp-title" class="se-title">@name</h3>
                        <button type="button" class="btn ghost sm icon" title="Renommer la borne" aria-label="Renommer la borne" @onclick="StartHeadRename"><Ico Name="edit" Size="15" /></button>
                        <span class="badge @(Offline ? "hors-ligne" : "en-ligne")">@(Offline ? "Hors ligne" : "En ligne")</span>
                        <span class="kiosk-tag badge neutre"><Ico Name="hand" Size="12" /> Borne · @(portrait ? "Portrait" : "Paysage")</span>
                        @if (dirty) { <span class="badge mise-a-jour" title="Modifications pas encore enregistrées">Non enregistré</span> }
                        else if (Pending) { <span class="badge mise-a-jour" title="Liste interactive, réglages, liste de lecture ou widgets modifiés depuis la dernière publication">À publier</span> }
                    </div>
                }
                <small>Modifier la borne</small>
            </div>
            <button type="button" class="modal-x" aria-label="Planning de la borne" title="Planning de la borne : quelle liste passe, quand" @onclick="() => planOpen = true"><Ico Name="calendar" Size="20" /></button>
            <button type="button" class="modal-x" aria-label="Paramètres de la borne" title="Paramètres de la borne" @onclick="() => parOpen = true"><Ico Name="sliders" Size="20" /></button>
            <button type="button" class="modal-x" aria-label="Fermer" @onclick="Close"><Ico Name="x" Size="20" /></button>
        </div>

        <div class="modal-body wg-body">
            <div class="wg-stage-wrap" style="--z: @zoom.ToString(Inv)">
                <div class="wg-stage @(portrait ? "portrait" : "")">
                    @if (view == "idle")
                    {
                        @* ce que voit le visiteur au repos : le premier contenu plein écran de chaque zone, avec le bouton « Touchez l'écran » dans le style choisi *@
                        <div class="kp-ks idle kp-idle kd-zones @(portrait ? "col" : "row")">
                            @for (var z = 0; z < zoneDef.Sizes.Length; z++)
                            {
                                var zi = z;
                                var pl = playlists.FirstOrDefault(p => p.Id == ZoneList(zi));
                                var thumb = pl?.Draft.Where(i => i.Placement == "full").Select(i => Media(i.MediaId)).FirstOrDefault(m => m != null);
                                <div class="kd-zone" style="flex:@F(zoneDef.Sizes[zi])">
                                    @if (thumb != null) { <span class="wg-zone-img">@if (thumb.AppId == Compositions.AppId) { <CompositionThumb Item="thumb" Files="media" Contain="true" /> } else { <MediaThumb Media="thumb" All="media" /> }</span> }
                                    <span class="kp-idle-tag">@(split ? $"Zone {zi + 1} · " : "Diffusion en inactivité · ")@(pl?.Name ?? "aucune liste de lecture")</span>
                                </div>
                            }
                            <div class="@("kt kt-" + Kiosk.TouchKey(k.TouchStyle) + (portrait ? "" : " kt-land"))">@TouchMarkup(Kiosk.TouchKey(k.TouchStyle))</div>
                        </div>
                    }
                    else if (list != null)
                    {
                        <div class="kd-home"><InteractiveListThumb List="list" Files="media" /></div>
                    }
                    else
                    {
                        <div class="kd-none"><Ico Name="hand" Size="28" /><b>Aucune liste interactive</b><small>Choisissez-en une à droite.</small></div>
                    }
                    <button type="button" class="wg-sim" title="Voir ce que voit le visiteur (dernière publication)" @onclick="() => sim = true" @onclick:stopPropagation="true"><Ico Name="play" Size="14" /> Simuler</button>
                </div>
                <div class="kp-view" role="group" aria-label="État de la borne">
                    <button type="button" class="@(view == "home" ? "on" : "")" @onclick='() => view = "home"'>Accueil</button>
                    <button type="button" class="@(view == "idle" ? "on" : "")" @onclick='() => view = "idle"'>Inactivité</button>
                </div>
                <div class="wg-zoom" role="group" aria-label="Zoom de l'aperçu">
                    <button type="button" aria-label="Réduire" title="Réduire" disabled="@(zoom <= MinZoom + 0.001)" @onclick="() => ZoomBy(-0.1)"><Ico Name="minus" Size="16" /></button>
                    <span>@Math.Round(zoom * 100) %</span>
                    <button type="button" aria-label="Agrandir" title="Agrandir" disabled="@(zoom >= MaxZoom - 0.001)" @onclick="() => ZoomBy(0.1)"><Ico Name="plus" Size="16" /></button>
                </div>
            </div>

            <div class="wg-side kd-side">
                <section class="kd-sec">
                    <h4>Liste interactive</h4>
                    <p class="kp-h">Ce que le visiteur touche : pages, tuiles, textes et images.</p>
                    @if (list != null)
                    {
                        <div class="kd-list">
                            <span class="kd-lth"><InteractiveListThumb List="list" Files="media" /></span>
                            <span class="kd-lnm"><b>@list.Name</b><small>@(tileCount > 1 ? $"{tileCount} tuiles" : $"{tileCount} tuile") · @(list.Pages.Count > 1 ? $"{list.Pages.Count} pages" : "1 page") · @(InteractiveLists.Portrait(list.Orientation) ? "Portrait" : "Paysage")</small></span>
                            <button type="button" class="btn ghost sm" @onclick="() => OpenEditor(list.Id)"><Ico Name="edit" Size="14" /> Modifier</button>
                        </div>
                        @if (list.Orientation != orientation)
                        {
                            <div class="kd-warn" role="alert">Cette liste est en @(InteractiveLists.Portrait(list.Orientation) ? "portrait" : "paysage") et la borne en @(portrait ? "portrait" : "paysage") : elle serait déformée. Changez le format de la borne (icône des paramètres) ou choisissez une autre liste.</div>
                        }
                    }
                    <div class="dw-field">
                        <label for="k-list">@(list == null ? "Choisir la liste de la borne" : "Changer de liste")</label>
                        <select id="k-list" @onchange="AssignInteractive">
                            <option value="" selected="@(k.ListId == null)">— Aucune liste interactive —</option>
                            @foreach (var l in Compatible) { <option value="@l.Id" selected="@(l.Id == k.ListId)">@l.Name@(l.Orientation != orientation ? " (" + (InteractiveLists.Portrait(l.Orientation) ? "portrait" : "paysage") + ")" : "")</option> }
                        </select>
                    </div>
                    <div><button type="button" class="btn ghost sm" @onclick="OpenCreate"><Ico Name="plus" Size="14" /> Créer une liste interactive</button></div>
                </section>

                <section class="kd-sec">
                    <h4>Quand personne ne touche</h4>
                    <p class="kp-h">L'écran diffuse ces listes de lecture. Le premier toucher interrompt la diffusion et ouvre la liste interactive.</p>
                    <div class="kp-seg" role="group" aria-label="Découpage de l'écran">
                        <button type="button" class="@(!split ? "on" : "")" @onclick="() => SetSplit(false)">Plein écran</button>
                        <button type="button" class="@(split ? "on" : "")" disabled="@(!CanSplit)" title="@(CanSplit ? "" : "Ce format d'écran n'est pas découpé")" @onclick="() => SetSplit(true)">2 zones</button>
                    </div>
                    <div class="kd-zonesrow">
                        <div class="kd-scr @(portrait ? "p" : "l") @(split ? "two" : "")" aria-hidden="true">
                            @for (var z = 0; z < zoneDef.Sizes.Length; z++) { <div style="flex:@F(zoneDef.Sizes[z])">@(split ? "Zone " + (z + 1) : "Plein écran")</div> }
                        </div>
                        <div class="kd-zsel">
                            @for (var z = 0; z < zoneDef.Sizes.Length; z++)
                            {
                                var zi = z;
                                <div class="dw-field">
                                    <label for="@("k-z" + zi)">@(split ? ZoneName(zi, portrait) : "Liste de lecture")</label>
                                    <select id="@("k-z" + zi)" @onchange="e => SetZoneList(zi, e)">
                                        <option value="" selected="@(ZoneList(zi) == null)">— Aucune liste de lecture —</option>
                                        @foreach (var p in playlists) { <option value="@p.Id" selected="@(p.Id == ZoneList(zi))">@p.Name</option> }
                                    </select>
                                </div>
                            }
                        </div>
                    </div>
                </section>

                <section class="kd-sec">
                    <button type="button" class="kd-fold" @onclick="() => parOpen = true">
                        <span><b>Réglages</b><small>Retours automatiques, accessibilité, bouton « Touchez l'écran », veille, verrouillage</small></span><Ico Name="sliders" Size="18" />
                    </button>
                </section>
            </div>
        </div>

        <div class="modal-foot">
            @if (confirmPublish)
            {
                @if (needsApproval)
                {
                    <span class="confirm-line" role="alert">Demander l'approbation ? Un approbateur décide avant que la borne n'affiche « @(list?.Name ?? "sa liste interactive") » ; d'ici là elle garde sa version.</span>
                    <button class="btn ghost" @onclick="() => confirmPublish = false">Retour</button>
                    <button class="btn" disabled="@saving" @onclick="() => SaveAll(true)"><Ico Name="shield" Size="16" /> Envoyer pour approbation</button>
                }
                else
                {
                    <span class="confirm-line" role="alert">Publier maintenant ? La borne affichera aussitôt « @(list?.Name ?? "aucune liste interactive") » et, en inactivité, @(split ? "ses deux zones de diffusion" : "« " + (playlists.FirstOrDefault(p => p.Id == ZoneList(0))?.Name ?? "aucune liste de lecture") + " »").</span>
                    <button class="btn ghost" @onclick="() => confirmPublish = false">Retour</button>
                    <button class="btn" disabled="@saving" @onclick="() => SaveAll(true)"><Ico Name="upload" Size="16" /> Confirmer la publication</button>
                }
            }
            else
            {
                <button class="btn ghost" @onclick="Close">Annuler</button>
                <button class="btn ghost" disabled="@saving" @onclick="() => SaveAll(false)">Enregistrer</button>
                <button class="btn" disabled="@saving" @onclick="() => confirmPublish = true">@(needsApproval ? "Enregistrer et demander l'approbation" : "Enregistrer et publier")</button>
            }
        </div>
    </div>

    @if (planOpen)
    {
        <div class="kp-veil over" @onclick="() => planOpen = false"></div>
        <div class="kp-drawer over" role="dialog" aria-modal="true" aria-labelledby="kp-plan-t">
            <div class="kp-dh"><h2 id="kp-plan-t">Planning de la borne</h2><button type="button" class="modal-x" aria-label="Fermer" @onclick="() => planOpen = false"><Ico Name="x" Size="20" /></button></div>
            <div class="kp-db">
                <p class="kp-h" style="margin-bottom:12px">Le planning ne se règle pas ici : il se gère dans le menu Planning, pour un écran, une borne, une zone ou une aire. Un visiteur qui touche l'écran passe toujours avant le planning ; à son départ, le créneau en cours reprend.</p>
                @if (SlotRows.Count == 0) { <div class="kp-empty"><b>Aucun planning</b><p>La borne diffuse ses listes de lecture en permanence.</p></div> }
                else
                {
                    <div class="kp-pl">
                        @foreach (var r in SlotRows)
                        {
                            <div><span class="kp-src @r.Css">@r.Source</span><span>@r.Text</span><span class="kp-h">@r.Note</span></div>
                        }
                    </div>
                }
            </div>
            <div class="kp-df"><button type="button" class="btn ghost" @onclick="() => planOpen = false">Fermer</button><a class="btn" href="/planning?screen=@Id">Gérer dans Planning →</a></div>
        </div>
    }

    @if (parOpen)
    {
        <div class="kp-veil over" @onclick="() => parOpen = false"></div>
        <div class="kp-drawer over" role="dialog" aria-modal="true" aria-labelledby="kp-par-t">
            <div class="kp-dh"><h2 id="kp-par-t">Réglages de la borne</h2><button type="button" class="modal-x" aria-label="Fermer" @onclick="() => parOpen = false"><Ico Name="x" Size="20" /></button></div>
            <div class="kp-db">
                <p class="kp-lbl">Format</p>
                <div class="kp-seg" role="group" aria-label="Orientation">
                    <button type="button" class="@(orientation != "portrait" ? "on" : "")" @onclick='() => SetOrientation("landscape")'><i class="ori l"></i> Paysage</button>
                    <button type="button" class="@(orientation == "portrait" ? "on" : "")" @onclick='() => SetOrientation("portrait")'><i class="ori p"></i> Portrait</button>
                </div>
                <div class="kp-f" style="margin-top:14px"><label for="k-res">Résolution</label>
                    <select id="k-res" @onchange="SetResolution">
                        @foreach (var r in new[] { "auto", "1920x1080", "3840x2160", "1280x720" }) { <option value="@r" selected="@(resolution == r)">@(r == "auto" ? "Automatique (celle de l'écran)" : r.Replace("x", " × "))</option> }
                    </select>
                    <span class="kp-h">@(s.DetectedW is > 0 ? $"Détectée : {Math.Max(s.DetectedW ?? 0, s.DetectedH ?? 0)} × {Math.Min(s.DetectedW ?? 0, s.DetectedH ?? 0)}." : "Détectée à la première connexion.") Le format s'applique dès l'enregistrement.</span></div>

                <p class="kp-lbl" style="margin-top:18px">Miroir de l'affichage</p>
                @Switch("Miroir horizontal", "Inverse la gauche et la droite.", mirrorH, v => { mirrorH = v; dirty = true; })
                @Switch("Miroir vertical", "Inverse le haut et le bas ; les deux ensemble : écran fixé à l'envers. S'applique dès l'enregistrement.", mirrorV, v => { mirrorV = v; dirty = true; })

                <p class="kp-lbl" style="margin-top:18px">Retours automatiques</p>
                <div class="kp-f"><label for="k-ret">Retour à l'accueil après</label>
                    <select id="k-ret" @onchange="e => Edit(c => c.ReturnSec = Kiosk.Clamp(Num(e.Value, 30), Kiosk.MinReturn, Kiosk.MaxReturn))">
                        @foreach (var v in new[] { 15, 30, 60, 120 }) { <option value="@v" selected="@(k.ReturnSec == v)">@v secondes sans toucher</option> }
                    </select></div>
                <div class="kp-f"><label for="k-idle">Retour à la diffusion après</label>
                    <select id="k-idle" @onchange="e => Edit(c => c.IdleSec = Kiosk.Clamp(Num(e.Value, 120), Kiosk.MinIdle, Kiosk.MaxIdle))">
                        @foreach (var v in new[] { 60, 120, 300, 600 }) { <option value="@v" selected="@(k.IdleSec == v)">@(v / 60) minute@(v > 60 ? "s" : "") à l'accueil</option> }
                    </select></div>
                <div class="kp-f"><label for="k-touch">Bouton « Touchez l'écran pour commencer »</label>
                    <select id="k-touch" @onchange="e => Edit(c => c.TouchStyle = Kiosk.TouchKey(e.Value?.ToString()))">
                        @foreach (var ts in Kiosk.TouchStyles) { <option value="@ts.Key" selected="@(Kiosk.TouchKey(k.TouchStyle) == ts.Key)">@ts.Label</option> }
                    </select>
                    <span class="kp-h">Il s'affiche au centre de l'écran tant que personne n'a touché la borne (aperçu « Inactivité »).</span></div>

                <p class="kp-lbl" style="margin-top:18px">Accessibilité</p>
                @Switch("Tuiles à hauteur de fauteuil", "La liste interactive et le bouton Retour se placent dans la moitié basse de l'écran.", k.Accessible, v => Edit(c => c.Accessible = v))

                <p class="kp-lbl" style="margin-top:18px">Session du visiteur</p>
                @Switch("Tout remettre à zéro", "Documents en page 1, vidéos arrêtées ; historique et cookies des sites effacés sur l'appareil.", k.Wipe, v => Edit(c => c.Wipe = v))
                @Switch("Son des vidéos", "Sinon les vidéos s'ouvrent sans son.", k.Sound, v => Edit(c => c.Sound = v))
                @if (k.Sound)
                {
                    <div class="kp-f" style="margin-left:54px;max-width:260px"><label for="k-vol">Volume</label>
                        <select id="k-vol" @onchange="e => Edit(c => c.Volume = Kiosk.Clamp(Num(e.Value, 60), 10, 100))">
                            @foreach (var v in new[] { 30, 60, 80, 100 }) { <option value="@v" selected="@(k.Volume == v)">@v %</option> }
                        </select></div>
                }

                <p class="kp-lbl" style="margin-top:18px">Verrouillage</p>
                @Switch("Empêcher de quitter l'application", "Bloque la touche Windows, Alt+Tab et Alt+F4 ; la fenêtre reste au premier plan.", k.Lock, v => Edit(c => c.Lock = v))
                @Switch("Désactiver le zoom", "Évite le zoom par pincement ou molette.", k.NoZoom, v => Edit(c => c.NoZoom = v))
                @Switch("Masquer le curseur de la souris", "Seul le toucher est utilisé.", k.HideCursor, v => Edit(c => c.HideCursor = v))
                <span class="kp-h">Accès technicien : appui long de 5 s dans le coin en haut à gauche de l'écran, puis le code PIN technicien de l'organisation (à régler dans <a href="/settings">Réglages</a>). Il permet de quitter le mode borne ou de redémarrer.</span>

                <p class="kp-lbl" style="margin-top:18px">Veille et appareil</p>
                @Switch("Un toucher réveille la borne pendant la veille", "", k.WakeOnTouch, v => Edit(c => c.WakeOnTouch = v))
                @Switch("Démarrer avec Windows", "La borne s'ouvre seule à l'allumage du PC.", autoStart, v => { autoStart = v; dirty = true; })
                <span class="kp-h">La mise en veille et la luminosité se règlent dans les paramètres de l'écran (éditeur de l'écran).</span>
                <div style="margin-top:8px"><button type="button" class="btn ghost sm" @onclick="() => editor = true"><Ico Name="edit" Size="14" /> Widgets et réglages de l'écran…</button></div>

                <p class="kp-lbl" style="margin-top:18px">Mode d'affichage</p>
                <span class="kp-h" style="margin-bottom:8px">Repasser l'écran en diffusion simple. La liste interactive est conservée, mais n'est plus affichée.</span>
                <button type="button" class="btn danger" @onclick="() => confirmOff = true">Repasser en écran de diffusion</button>
            </div>
            <div class="kp-df"><span class="kp-h" style="margin-right:auto">Les réglages se valident avec « Enregistrer ».</span><button type="button" class="btn" @onclick="() => parOpen = false">Fermer</button></div>
        </div>
    }

    @if (confirmOff)
    {
        <div class="modal-backdrop over" @onclick="() => confirmOff = false"></div>
        <div class="modal kp-confirm" role="alertdialog" aria-modal="true">
            <h3>Repasser « @name » en écran de diffusion ?</h3>
            <p class="hint">La borne ne réagit plus au toucher et diffuse sa liste de lecture. La liste interactive est conservée. Cette action s'applique et se publie aussitôt ; les autres modifications non enregistrées sont abandonnées.</p>
            <div class="modal-actions"><button class="btn ghost" @onclick="() => confirmOff = false">Annuler</button><button class="btn" @onclick="TurnOff">Repasser en diffusion</button></div>
        </div>
    }

    @if (editor) { <ScreenEditor ScreenId="s.Id" OnClose="EditorClosed" /> }
    @if (sim) { <SimulatorDialog ScreenId="s.Id" Stacked="true" OnClose="() => sim = false" /> }
}

@code {
    [Parameter] public Guid Id { get; set; }
    [Parameter] public EventCallback OnClose { get; set; }

    private static readonly System.Globalization.CultureInfo Inv = System.Globalization.CultureInfo.InvariantCulture;
    private const double MinZoom = 0.5, MaxZoom = 2;

    private Task Close() => OnClose.InvokeAsync();

    private Screen? s;
    private Tenant tenant = new();
    private List<Playlist> playlists = new();
    private List<MediaItem> media = new();
    private List<InteractiveList> lists = new();

    // copie de travail : rien n'est écrit avant « Enregistrer »
    private KioskConfig? k;
    private string name = "", orientation = "landscape", resolution = "auto", layout = ScreenLayouts.Full;
    private bool autoStart, mirrorH, mirrorV;
    private List<Guid?> zonePl = new();
    private Guid? loadedFor;
    private bool dirty;

    private string view = "home";
    private double zoom = 1;
    private bool saving, confirmPublish, editor, sim, confirmOff, planOpen, parOpen;
    private bool needsApproval;   // la personne est soumise à approbation : « publier » dépose une demande (voir Approvals)
    private bool headRename;
    private string headValue = "";

    protected override void OnParametersSet() => Load();

    private void Load()
    {
        s = Store.Read(d => d.Screens.FirstOrDefault(x => x.Id == Id && x.Token != null));
        if (s?.Kiosk == null) return;
        tenant = Store.Read(d => d.Tenant);
        needsApproval = Store.Read(d => ApprovalOps.NeedsApproval(d.Root, d.Tenant, d.Access.UserId, new[] { Id }));
        playlists = Store.Read(d => PlaylistOps.Choosable(d));
        media = Store.Read(d => d.Media.Where(m => m.Status == null).ToList());
        lists = Store.Read(d => d.InteractiveLists.OrderBy(l => l.Name, StringComparer.CurrentCultureIgnoreCase).ToList());
        if (loadedFor != Id) { ResetDraft(); loadedFor = Id; }
    }

    private void ResetDraft()
    {
        k = Copy(s!.Kiosk!);
        name = s.Name; orientation = s.Orientation; resolution = s.Resolution; autoStart = s.AutoStart; (mirrorH, mirrorV) = (s.MirrorH, s.MirrorV);
        layout = ScreenLayouts.Fit(ScreenLayouts.Find(s.Layout).Id, Spec);
        zonePl = s.ZonePlaylists().Take(ScreenLayouts.Find(layout).Sizes.Length).ToList();
        dirty = false;
    }

    private static T Copy<T>(T x) => JsonSerializer.Deserialize<T>(JsonSerializer.Serialize(x))!;

    private bool Offline => s?.LastSeenUtc is not { } ls || DateTime.UtcNow - ls > TimeSpan.FromSeconds(90);
    private bool Pending => s != null && Helpers.HasPending(s, playlists);

    private MediaItem? Media(Guid id) => media.FirstOrDefault(m => m.Id == id);
    private InteractiveList? CurrentList => lists.FirstOrDefault(l => l.Id == k?.ListId);
    private IEnumerable<InteractiveList> Compatible => lists.Where(l => l.Orientation == orientation || l.Id == k?.ListId);
    // Une borne est un écran tactile de PC Windows : elle se découpe comme un écran de télévision, quel que soit le type enregistré (un « smartphone » ne se découpe pas).
    private ScreenSpec Spec => new() { Type = "tv", Orientation = orientation, Resolution = resolution };
    private bool CanSplit => ScreenLayouts.For(Spec).Any(d => d.Sizes.Length > 1);

    private static string Fm(double d) => d.ToString("0.##", Inv);
    private string F(double d) => Fm(d);
    private static int Num(object? v, int fallback) => int.TryParse(v?.ToString(), out var n) ? n : fallback;
    private static string ZoneName(int z, bool portrait) => z == 0 ? (portrait ? "Zone du haut" : "Zone de gauche") : z == 1 ? (portrait ? "Zone du bas" : "Zone de droite") : "Zone " + (z + 1);

    /// <summary>Un réglage de la borne : sur la copie de travail seulement, enregistré avec « Enregistrer ».</summary>
    private void Edit(Action<KioskConfig> change) { if (k != null) { change(k); dirty = true; } }

    private RenderFragment Switch(string title, string text, bool on, Action<bool> set) => @<div class="kp-sw">
        <button type="button" class="switch @(on ? "on" : "")" role="switch" aria-checked="@(on ? "true" : "false")" aria-label="@title" @onclick="() => set(!on)"><span></span></button>
        <div><b>@title</b>@if (text.Length > 0) { <small>@text</small> }</div>
    </div>;

    // Bouton « Touchez l'écran » : même balisage que kiosk.js (touchHtml)
    private const string Hand = "<svg class=\"kt-h\" viewBox=\"0 0 24 24\"><path fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.7\" stroke-linecap=\"round\" stroke-linejoin=\"round\" d=\"M9 11V5.5a1.5 1.5 0 0 1 3 0V10m0-1.5a1.5 1.5 0 0 1 3 0V11m0-1a1.5 1.5 0 0 1 3 0v5.5A6 6 0 0 1 12 21.5h-.5a6 6 0 0 1-4.7-2.3L4 15.6a1.6 1.6 0 0 1 2.4-2.1L9 15.5\"/></svg>";
    private static MarkupString TouchMarkup(string s) => new(s switch
    {
        "round" => "<i class=\"kt-ring\"></i><i class=\"kt-ring r2\"></i><div class=\"kt-c kt-dot\">" + Hand + "</div><div class=\"kt-lbl\">Touchez l’écran<br>pour commencer</div>",
        "glass" => "<div class=\"kt-c kt-card\">" + Hand + "<h3>Touchez l’écran</h3><p>pour commencer</p></div>",
        "icon" => "<div class=\"kt-c kt-halo\"></div><div class=\"kt-c kt-ico\">" + Hand + "</div><div class=\"kt-lbl\">Touchez pour commencer</div>",
        "band" => "<div class=\"kt-band-in\"><h3>Touchez l’écran<br>pour commencer</h3>" + Hand + "</div>",
        "button" => "<div class=\"kt-c kt-btn\"><b>Commencer</b><span>Touchez l’écran</span></div>",
        _ => "<div class=\"kt-c\">Touchez l’écran pour commencer</div>"
    });

    private void ZoomBy(double d) => zoom = Math.Clamp(Math.Round(zoom + d, 2), MinZoom, MaxZoom);
    private void SetOrientation(string o) { orientation = o; layout = ScreenLayouts.Fit(layout, Spec); FitZones(); dirty = true; }
    private void SetResolution(ChangeEventArgs e) { resolution = e.Value?.ToString() ?? "auto"; layout = ScreenLayouts.Fit(layout, Spec); FitZones(); dirty = true; }

    // ----- Nom -----
    private void StartHeadRename() { headValue = name; headRename = true; }
    private void OnHeadKey(KeyboardEventArgs e) { if (e.Key == "Enter") SaveHeadRename(); else if (e.Key == "Escape") headRename = false; }
    private void SaveHeadRename()
    {
        var n = (headValue ?? "").Trim();
        if (n.Length == 0) return;
        Store.Write(d => { if (d.Screens.FirstOrDefault(x => x.Id == Id) is { } sc) sc.Name = n; });   // le nom n'est pas diffusé : enregistré aussitôt, comme l'éditeur d'écran
        name = n; headRename = false;
    }

    // ----- Liste interactive -----
    private void AssignInteractive(ChangeEventArgs e)
    {
        var g = Guid.TryParse(e.Value?.ToString(), out var x) ? x : (Guid?)null;
        Edit(c => c.ListId = g);
    }

    // Modifier ou créer une liste quitte la fenêtre : la copie de travail est enregistrée d'abord (sans publier), comme avant d'ouvrir l'éditeur d'écran.
    private Task OpenEditor(Guid id) => SaveAll(false, $"/interactive/{id}?back=/screens");
    private Task OpenCreate() => SaveAll(false, $"/interactive/new?o={orientation}&back=/screens");

    // ----- Inactivité : une zone, ou deux (haut/bas en portrait, gauche/droite en paysage) -----
    private Guid? ZoneList(int z) => zonePl.ElementAtOrDefault(z);

    private void FitZones()
    {
        var n = ScreenLayouts.Find(layout).Sizes.Length;
        while (zonePl.Count < n) zonePl.Add(null);
        if (zonePl.Count > n) zonePl.RemoveRange(n, zonePl.Count - n);
    }

    private void SetSplit(bool two)
    {
        layout = two ? "50-50" : ScreenLayouts.Full;
        FitZones();
        dirty = true;
    }

    private void SetZoneList(int z, ChangeEventArgs e)
    {
        FitZones();
        zonePl[z] = Guid.TryParse(e.Value?.ToString(), out var g) ? g : null;
        dirty = true;
    }

    // L'éditeur d'écran enregistre de son côté (liste, widgets, découpage) : la copie de travail reprend ces valeurs à son retour.
    private void EditorClosed()
    {
        editor = false;
        var keep = k; var keepDirty = dirty;
        Load();
        if (s != null)
        {
            name = s.Name; orientation = s.Orientation; resolution = s.Resolution; (mirrorH, mirrorV) = (s.MirrorH, s.MirrorV);
            layout = ScreenLayouts.Fit(ScreenLayouts.Find(s.Layout).Id, Spec);
            zonePl = s.ZonePlaylists().Take(ScreenLayouts.Find(layout).Sizes.Length).ToList();
        }
        k = keep; dirty = keepDirty;
    }

    // ----- Enregistrer / publier : même déroulement que l'éditeur d'écran -----
    private async Task SaveAll(bool publish) => await SaveAll(publish, null);

    private async Task SaveAll(bool publish, string? then)
    {
        if (k == null) return;
        var kd = Copy(k); var (o, r, au, lay) = (orientation, resolution, autoStart, layout); var (mh, mv) = (mirrorH, mirrorV); var zones = zonePl.ToList();
        saving = true;
        ScreenPublisher.Result? pub = null;
        try
        {
            var formatChanged = Store.Write(d =>
            {
                var sc = d.Screens.First(x => x.Id == Id);
                if (JsonSerializer.Serialize(sc.Kiosk) != JsonSerializer.Serialize(kd)) { sc.Kiosk = kd; sc.KioskRevision++; }   // liste choisie ou réglages modifiés = à publier
                var changed = sc.Orientation != o || sc.Resolution != r || sc.MirrorH != mh || sc.MirrorV != mv;   // le miroir s'applique aussitôt, comme le format
                sc.Orientation = o; sc.Resolution = r; sc.AutoStart = au; sc.MirrorH = mh; sc.MirrorV = mv;
                sc.Layout = lay;   // autre découpage ou autre liste dans une zone = modification à publier
                for (var z = 0; z < zones.Count; z++) sc.SetZonePlaylist(z, zones[z]);
                return changed;
            });
            if (publish) pub = await Publisher.Publish([Id]);
            else if (formatChanged) await Notifier.NotifyScreen(Id);   // le format s'applique sans attendre la publication
        }
        finally { saving = false; }
        if (pub?.Error != null) Toast.Error(pub.Error);
        else if (then == null) Toast.Ok(pub?.Request is { } rq ? $"Borne « {name} » enregistrée. Demande n° {rq.Number} envoyée : elle garde sa version jusqu'à la décision."
            : publish ? $"Borne « {name} » enregistrée et publiée." : $"Borne « {name} » enregistrée.");
        if (then != null) Nav.NavigateTo(then);
        else await OnClose.InvokeAsync();
    }

    private async Task TurnOff()
    {
        Store.Write(d => { if (d.Screens.FirstOrDefault(x => x.Id == Id) is { } sc) { sc.Kiosk = null; sc.PublishedKiosk = null; } });
        await Publisher.Initial(Id);   // la borne reçoit tout de suite sa configuration d'écran de diffusion (retour à la diffusion simple : rien à approuver)
        Toast.Ok("L'écran est repassé en diffusion simple.");   // la fenêtre se ferme : la borne passe dans l'onglet des écrans de diffusion
        await OnClose.InvokeAsync();
    }

    // ----- Planning appliqué (lecture seule) -----
    private record SlotRow(string Source, string Css, string Text, string Note);
    private List<SlotRow> SlotRows
    {
        get
        {
            if (s == null) return new();
            var (area, zone) = Store.Read(d => { var a = d.Areas.FirstOrDefault(x => x.Id == s.AreaId); return (a, Plan.ZoneOf(a, s)); });
            var source = s.OwnPlanning || s.Slots.Count > 0 ? ("Cette borne", "own", "Propre")
                : zone != null && Plan.HasOwn(zone) ? ("Zone · " + zone.Name, "inh", "Hérité")
                : area != null ? ("Aire · " + area.Name, "inh", "Hérité") : ("", "", "");
            return Plan.Effective(area, s).Select(sl => new SlotRow(source.Item1, source.Item2,
                Plan.Describe(sl) + " · " + (playlists.FirstOrDefault(p => p.Id == sl.PlaylistId)?.Name ?? "(liste supprimée)"), source.Item3)).ToList();
        }
    }
}
