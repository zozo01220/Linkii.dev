@page "/compositions/new"
@page "/compositions/{Id:guid}"
@attribute [Microsoft.AspNetCore.Authorization.Authorize(Policy = "Page:compositions")]
@implements IAsyncDisposable
@using Microsoft.JSInterop
@inject AppService Svc
@inject MediaLibrary Library
@inject MediaImporter Importer
@inject CompositionLibrary Folders
@inject TenantStore Store
@inject DataSetService Data
@inject IJSRuntime JS
@inject NavigationManager Nav
@inject ModeService Modes
@inject HomeAssistantLive HaLive
@inject AiService AiSvc
@inject AssistantPanel Panel

@* Éditeur de compositions (DEV-POC.md §80, §84, §85) : l'interface est en JS (wwwroot/compo-editor.js, plein écran), le serveur garde le document,
   calcule les QR codes, liste et importe les images de la médiathèque, garde « Mes modèles », et lit les données des sources (blocs, champs reliés). Le rendu des calques est celui du player (player/composition.js).
   « /compositions/new » : rien n'est créé tant qu'on n'a pas enregistré (pas de composition vide laissée derrière soi). *@
<HeadContent><link rel="stylesheet" href="compo-editor.css?v=17" /></HeadContent>

@if (!ready)
{
    <div class="page-head"><div><h1>Composition introuvable</h1><p class="sub">Elle a peut-être été supprimée, ou elle appartient à une autre aire de gestion.</p></div></div>
    <a class="btn ghost" href="@Back">← Retour</a>
}
else if (!Svc.IsInstalled(Compositions.AppId))
{
    <div class="page-head"><div><h1>Compositions</h1><p class="sub">L'application « Compositions » n'est pas dans Mes applications.</p></div></div>
    <a class="btn" href="/applications">Ouvrir les applications</a>
}
else
{
    <div class="ce" @ref="root"></div>
    @* « Importer » du panneau Médias : le JS ouvre ce sélecteur de fichiers ; les images entrent dans la médiathèque de l'aire. *@
    <InputFile id="ce-file" OnChange="OnFiles" multiple accept="image/*" style="display:none" />
}

@code {
    [Parameter] public Guid? Id { get; set; }
    /// <summary>Page d'origine (Compositions, liste de lecture…), où « Retour » et l'enregistrement avec retour ramènent.</summary>
    [SupplyParameterFromQuery(Name = "back")] public string? BackParam { get; set; }
    /// <summary>Modèle de la galerie (numéro) pour démarrer une nouvelle composition.</summary>
    [SupplyParameterFromQuery(Name = "tpl")] public int? Tpl { get; set; }
    /// <summary>Modèle de « Mes modèles » pour démarrer une nouvelle composition.</summary>
    [SupplyParameterFromQuery(Name = "mytpl")] public Guid? MyTpl { get; set; }
    [SupplyParameterFromQuery(Name = "dtpl")] public int? Dtpl { get; set; }
    [SupplyParameterFromQuery(Name = "ds")] public string? Ds { get; set; }
    /// <summary>Modèle « Maison connectée » de la galerie et les entités Home Assistant choisies pour ses emplacements (JSON).</summary>
    [SupplyParameterFromQuery(Name = "htpl")] public int? Htpl { get; set; }
    [SupplyParameterFromQuery(Name = "ha")] public string? HaPicks { get; set; }
    /// <summary>Liste de lecture où ajouter la composition dès son premier enregistrement (création depuis la liste), et la position visée.</summary>
    [SupplyParameterFromQuery(Name = "addTo")] public Guid? AddTo { get; set; }
    [SupplyParameterFromQuery(Name = "at")] public int? At { get; set; }
    /// <summary>Dossier de la page Compositions ouvert à la création : la nouvelle composition y est rangée.</summary>
    [SupplyParameterFromQuery(Name = "folder")] public Guid? FolderParam { get; set; }

    private const int MaxImport = 10;
    private MediaItem? item;
    private CompositionTemplate? startTemplate;
    private bool ready;
    private Guid? createdId;   // composition créée par le premier enregistrement
    private ElementReference root;
    private DotNetObjectReference<CompositionEditor>? self;

    private string Back => BackParam is { Length: > 1 } b && b.StartsWith('/') && !b.StartsWith("//") && !b.Contains('\\') ? b : "/compositions";

    protected override void OnParametersSet()
    {
        if (Id is { } id)
        {
            var m = Svc.Instance(id);
            item = m?.AppId == Compositions.AppId ? m : null;
            ready = item != null;
        }
        else
        {
            startTemplate = MyTpl is { } t ? Store.Read(d => CompositionTemplates.Visible(d).FirstOrDefault(x => x.Id == t)) : null;
            ready = MyTpl == null || startTemplate != null;
        }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender || !ready || !Svc.IsInstalled(Compositions.AppId)) return;
        self = DotNetObjectReference.Create(this);
        await JS.InvokeVoidAsync("LinkiiCompoEditor.mount", root, new
        {
            name = item?.Name ?? startTemplate?.Name ?? "",
            doc = item?.Settings.GetValueOrDefault("doc") ?? startTemplate?.Doc ?? "",
            fromTemplate = startTemplate != null,   // document d'un modèle : pas encore enregistré
            images = Images(),
            videos = Videos(),
            tpl = Tpl,
            dtpl = Dtpl,   // modèle « jeux de données » de la galerie, relié au jeu Ds
            ds = Ds,
            htpl = Htpl,   // modèle « Maison connectée », relié aux entités HaPicks
            ha = HaPicks,
            myTemplates = Templates(),
            sources = Sources(),
            screens = ScreenChoices(),   // « Nouvelle composition » : écran concerné, sa résolution et son orientation
            ai = AiMode(),   // bouton « Améliorer » des textes : on | pro (invitation) | pause | off (absent)
            expert = Modes.Expert,   // menus Données et Graphiques : mode expert seulement
            canImport = Store.Read(d => d.Access.CanWrite(LevelPages.Media)),
            canEditData = Store.Read(d => d.Access.IsOrgAdmin)   // nom lisible et masquage des champs d'un jeu : comme la gestion des sources de données
        }, self);
    }

    private string AiMode() => AiSvc.State(Store.ClientId).Status switch { AiStatus.Ok => "on", AiStatus.NeedsPro => "pro", AiStatus.Quota or AiStatus.Cap => "pause", _ => "off" };

    /// <summary>Enregistre le nom et le document (crée la composition au premier enregistrement) ; rend le message d'erreur, ou null.</summary>
    [JSInvokable]
    public string? Save(string name, string doc)
    {
        if (Compositions.Clean(doc) is not { } c) return "La composition est trop grande ou illisible : elle n'a pas été enregistrée.";
        var target = Id ?? createdId;
        var (saved, errors) = Svc.SaveInstance(Compositions.AppId, target, name, new Dictionary<string, string> { ["doc"] = c.Doc, ["images"] = string.Join(",", c.Images) });
        if (errors.Count > 0) return string.Join(" ", errors);
        if (target == null && saved != null)
        {
            createdId = saved.Id;
            Folders.PlaceNew(saved.Id, FolderParam);
            if (AddTo is { } listId) AddToList(listId, saved.Id);
        }
        return null;
    }

    // Création depuis une liste de lecture : la composition y entre à la position choisie, pleine page, avec la durée par défaut.
    private void AddToList(Guid listId, Guid compositionId)
    {
        try
        {
            Store.Write(d =>
            {
                if (d.Playlists.FirstOrDefault(p => p.Id == listId) is not { } pl || !PlaylistOps.CanEdit(d, pl)) return;
                var at = At is { } i && i >= 0 && i < pl.Draft.Count ? i : pl.Draft.Count;
                pl.Draft.Insert(at, new PlaylistItem { MediaId = compositionId, DurationSec = d.Tenant.DefaultDurationSec, Placement = "full" });
                pl.Touch();
            });
        }
        catch (UnauthorizedAccessException) { }
    }

    // ---------- Écrans existants (fenêtre « Nouvelle composition ») ----------

    /// <summary>Écrans connectés avec leur taille dans leur orientation (largeur W, hauteur H). Sans résolution connue : 1920 × 1080, l'orientation est appliquée quand même.</summary>
    private List<object> ScreenChoices() => Store.Read(d =>
    {
        var areas = d.Areas.ToList();
        return d.AllScreens.Where(s => s.Token != null).OrderBy(s => s.Name, StringComparer.CurrentCultureIgnoreCase).Take(200).Select(s =>
        {
            var p = (s.Resolution ?? "").Split('x');
            var known = p.Length == 2 && int.TryParse(p[0], out var a) && int.TryParse(p[1], out var b) && a > 0 && b > 0;
            var (x, y) = known ? (int.Parse(p[0]), int.Parse(p[1])) : (1920, 1080);
            var (big, small) = (Math.Max(x, y), Math.Min(x, y));
            var portrait = s.Orientation == "portrait";
            var area = areas.FirstOrDefault(r => r.Id == s.AreaId);
            var zone = area?.Zones.FirstOrDefault(z => z.Id == s.ZoneId)?.Name;
            return (object)new { id = s.Id.ToString("N"), name = s.Name, place = string.Join(" › ", new[] { area?.Name, zone }.Where(n => !string.IsNullOrWhiteSpace(n))), w = portrait ? small : big, h = portrait ? big : small, def = !known };
        }).ToList();
    });

    // ---------- Mes modèles ----------

    private List<object> Templates() => Store.Read(d => CompositionTemplates.Visible(d).OrderByDescending(t => t.CreatedUtc)
        .Select(t => (object)new { id = t.Id.ToString(), name = t.Name, doc = t.Doc }).ToList());

    /// <summary>Enregistre le document comme modèle de « Mes modèles » ; rend { error } ou { templates }.</summary>
    [JSInvokable]
    public object SaveTemplate(string name, string doc)
    {
        try
        {
            var err = Store.Write(d => CompositionTemplates.Save(d, name, doc).Error);
            return err != null ? new { error = err } : new { templates = Templates() };
        }
        catch (Exception e) when (e is UnauthorizedAccessException or ReadOnlyLevelException) { return new { error = "Vous êtes en lecture seule : vous ne pouvez pas enregistrer de modèle." }; }
    }

    [JSInvokable]
    public object DeleteTemplate(string id)
    {
        if (Guid.TryParse(id, out var g)) Store.Write(d => { CompositionTemplates.Delete(d, g); });
        return Templates();
    }

    // ---------- Sources de données (§85) ----------

    /// <summary>
    /// Sources d'un bloc, d'une liste ou de champs : contenus de Mes applications (météo, calendrier, RSS, capteurs), jeux de données de l'organisation
    /// (§139, plan Pro, avec leurs colonnes) et « Cet écran » (paramètres connus des écrans, écrans proposés pour l'aperçu).
    /// </summary>
    [JSInvokable]
    public List<object> Sources()
    {
        var list = Svc.CompositionSources().Select(m => (object)new { id = m.Id.ToString("N"), name = m.Name, app = m.AppId, room = m.AppId == "agenda" && m.Settings.GetValueOrDefault("room") == "true", roomName = m.Settings.GetValueOrDefault("roomName") ?? "" }).ToList();
        var (allowed, sets, screens) = Store.Read(d => (DataSourceOps.Allowed(d.Tenant), d.Tenant.DataSets.Select(x => x.Copy()).ToList(),
            d.AllScreens.OrderBy(s => s.Name, StringComparer.CurrentCultureIgnoreCase).Take(100).Select(s => (s.Id, s.Name, s.Params.ToList())).ToList()));
        if (allowed)
            list.AddRange(sets.OrderBy(s => s.Name, StringComparer.CurrentCultureIgnoreCase).Select(s => (object)new
            {
                id = s.Id.ToString("N"), name = s.Name, app = "dataset",
                cols = s.Columns.Select(c => new { key = c.Key, label = c.Label, type = c.Type, name = c.Name, hidden = c.Hidden })
            }));
        // Home Assistant : source intégrée dès que le compte de l'organisation est connecté (champs « e:entité », blocs Capteurs), sans contenu à créer
        if (Store.Read(d => d.Tenant.HomeAssistant?.Copy()) is { } ha)
            list.Add(new
            {
                id = Compositions.HaSource.ToString("N"), name = "Home Assistant", app = Compositions.HaApp,
                ents = ha.Active().Select(e => new { id = e.Id, name = e.Name, domain = e.Domain, unit = e.Unit, dc = e.DeviceClass })
            });
        var pars = screens.SelectMany(s => s.Item3).Where(p => p.Name.Trim().Length > 0).GroupBy(p => DataTables.Slug(p.Name)).Select(g => new { key = g.Key, label = g.First().Name.Trim() });
        list.Add(new
        {
            id = Compositions.ScreenSource.ToString("N"), name = "Cet écran", app = "screen",
            cols = new[] { new { key = "name", label = "Nom de l'écran" }, new { key = "zone", label = "Zone" }, new { key = "area", label = "Aire" } }.Concat(pars.Select(p => new { key = "p." + p.key, label = p.label })),
            screens = screens.Select(s => new { id = s.Id.ToString(), name = s.Name, has = s.Item3.Count > 0 })
        });
        return list;
    }

    /// <summary>
    /// Données actuelles d'une source (les mêmes que l'écran recevrait) : { data } ou { error }. « Cet écran » : celles de l'écran choisi pour l'aperçu
    /// (identifiant après « @ »), sinon du premier écran qui a des paramètres. Jeu de données : sa dernière copie (lue maintenant si elle n'existe pas).
    /// </summary>
    [JSInvokable]
    public async Task<object> SourceData(string id)
    {
        var at = id.IndexOf('@');
        Guid? screenId = at > 0 && Guid.TryParse(id[(at + 1)..], out var sg) ? sg : null;
        if (at > 0) id = id[..at];
        if (!Guid.TryParse(id, out var g)) return new { error = "Source introuvable." };
        if (g == Compositions.HaSource)   // toutes les entités du compte, avec leur état du moment
        {
            var (cid, account) = Store.Read(d => (d.ClientId, d.Tenant.HomeAssistant?.Copy()));
            if (account == null) return new { error = "Compte Home Assistant non connecté." };
            try
            {
                var (states, _) = await HaLive.States(cid, account);
                return new { data = new { title = "", fetchedAt = DateTime.UtcNow, entities = account.Entities.Select(e => HomeAssistantProvider.Entity(e.Id, states.GetValueOrDefault(e.Id), false)).ToList() } };
            }
            catch (InvalidOperationException ex) { return new { error = ex.Message }; }
        }
        if (g == Compositions.ScreenSource)
            return new { data = Store.Read(d => Compositions.ScreenData(d.Root, (screenId is { } sid ? d.AllScreens.FirstOrDefault(s => s.Id == sid) : null)
                ?? d.AllScreens.FirstOrDefault(s => s.Params.Count > 0) ?? d.AllScreens.FirstOrDefault())) };
        var (clientId, set) = Store.Read(d => (d.ClientId, DataSourceOps.Allowed(d.Tenant) ? d.Tenant.DataSets.FirstOrDefault(x => x.Id == g)?.Copy() : null));
        if (set != null)
        {
            if (Data.Table(clientId, g) == null) await Data.Refresh(clientId, g);
            if (Data.Table(clientId, g) is not { } t) return new { error = Data.Last(clientId, g)?.Message ?? "Pas encore lu." };
            return new { data = DataTables.ForScreen(t, null, false) };
        }
        var (data, error) = await Svc.SourceData(g);
        return error != null ? new { error } : new { data };
    }

    /// <summary>
    /// Nom lisible (vide : celui d'origine) et masquage d'un champ d'un jeu, valables dans toutes les compositions ; ne changent pas les titres
    /// déjà donnés aux colonnes des listes. Rend le message d'erreur, ou null.
    /// </summary>
    [JSInvokable]
    public string? ColumnPref(string set, string key, string name, bool hidden)
    {
        if (!Guid.TryParse(set, out var g)) return "Jeu de données introuvable.";
        name = (name ?? "").Trim();
        if (name.Length > 60) name = name[..60];
        return Store.Write(db =>
        {
            if (!db.Access.IsOrgAdmin) return "Seuls les administrateurs de l'organisation renomment ou masquent les champs d'un jeu.";
            if (db.Tenant.DataSets.FirstOrDefault(x => x.Id == g)?.Columns.FirstOrDefault(c => c.Key == key) is not { } c) return "Champ introuvable.";
            c.Name = name; c.Hidden = hidden;
            return (string?)null;
        });
    }

    // ---------- Médias ----------

    /// <summary>Tracé du QR code (le même que celui publié sur l'écran).</summary>
    [JSInvokable]
    public string? Qr(string text) => QrCodes.Encode(text);

    /// <summary>Images prêtes de la médiathèque visibles par la personne, les plus récentes d'abord.</summary>
    [JSInvokable]
    public List<object> Images() => Library.PickableFiles()
        .Where(m => m.Type == "image" && m.Status == null && m.FileName != null)
        .OrderByDescending(m => m.AddedUtc)
        .Select(m => (object)new { id = m.Id.ToString(), name = m.Name, url = "/media/" + m.FileName, w = m.Width, h = m.Height })
        .ToList();

    /// <summary>Vidéos prêtes de la médiathèque (MP4 convertis à l'import) visibles par la personne, les plus récentes d'abord.</summary>
    [JSInvokable]
    public List<object> Videos() => Library.PickableFiles()
        .Where(m => m.Type == "video" && m.Status == null && m.FileName != null)
        .OrderByDescending(m => m.AddedUtc)
        .Select(m => (object)new { id = m.Id.ToString(), name = m.Name, url = "/media/" + m.FileName, w = m.Width, h = m.Height, sec = double.TryParse(m.Info.GetValueOrDefault("durationSec"), System.Globalization.NumberStyles.Float, System.Globalization.CultureInfo.InvariantCulture, out var d) ? (int)Math.Round(d) : 0, size = m.Size })
        .ToList();

    // Images choisies dans « Importer » : ajoutées à la médiathèque (racine de l'aire), puis proposées à l'éditeur (la première est placée sur la page).
    private async Task OnFiles(InputFileChangeEventArgs e)
    {
        if (!Store.Read(d => d.Access.CanWrite(LevelPages.Media)))
        {
            await JS.InvokeVoidAsync("LinkiiCompoEditor.imported", Images(), Array.Empty<string>(), new[] { "Vous êtes en lecture seule sur la médiathèque : vous ne pouvez pas y ajouter de fichier." });
            return;
        }
        var files = e.GetMultipleFiles(MaxImport + 1);
        var errors = new List<string>();
        if (files.Count > MaxImport) errors.Add($"Au plus {MaxImport} images à la fois : les suivantes sont ignorées.");
        var picked = files.Take(MaxImport).ToList();
        await JS.InvokeVoidAsync("LinkiiCompoEditor.importing", picked.Count);
        var ids = new List<string>();
        foreach (var f in picked)
        {
            if (!f.ContentType.StartsWith("image/", StringComparison.OrdinalIgnoreCase) || !MediaImporter.IsSupported(f.Name)) { errors.Add($"« {f.Name} » n'est pas une image prise en charge."); continue; }
            var r = await Importer.Import(f, Store.ClientId, null, CancellationToken.None, Store.AreaId, null, Store.UserId);
            if (r.Item != null) ids.Add(r.Item.Id.ToString());
            else errors.Add(r.Error ?? $"« {f.Name} » n'a pas pu être importée.");
        }
        await JS.InvokeVoidAsync("LinkiiCompoEditor.imported", Images(), ids, errors);
    }

    [JSInvokable]
    public void Leave() => Nav.NavigateTo(Back);

    // ---------- « ✦ Améliorer » d'un texte : la proposition s'affiche dans le panneau de l'assistant, « Remplacer » écrit dans le calque ----------
    private readonly string aiKey = "compo-text-" + Guid.NewGuid().ToString("N");
    private enum AiCardState { Loading, Suggest, Applied, Message }
    private AiCardState aiCard;
    private string aiEl = "", aiSource = "", aiMode = "improve", aiSuggestion = "", aiMessage = "", aiOutcome = "";

    /// <summary>Appelé par l'éditeur (bouton « Améliorer » d'un texte) : la demande part dans le panneau de l'assistant.</summary>
    [JSInvokable]
    public async Task AiImprove(string elId, string text)
    {
        aiEl = elId; aiSource = text ?? ""; aiOutcome = "";
        await AiAsk("improve");
    }

    private void AiShow() => Panel.Show(aiKey, "Améliorer ce texte", "Composition · Texte", AiCardView, AiSummary);

    private static string Tokens(string t) => string.Join("|", System.Text.RegularExpressions.Regex.Matches(t ?? "", "{{[^}]*}}").Select(m => m.Value));

    private async Task AiAsk(string mode)
    {
        aiCard = AiCardState.Loading; AiShow();
        var r = await AiSvc.Rewrite(Store.ClientId, aiSource, mode, false);
        if (!r.Ok) { aiMessage = r.Message; aiCard = AiCardState.Message; }
        else if (Tokens(r.Text) != Tokens(aiSource)) { aiMessage = "L'IA a modifié un champ relié (entre accolades) : la proposition est écartée pour ne pas casser le texte."; aiCard = AiCardState.Message; }
        else { aiMode = mode; aiSuggestion = r.Text; aiCard = AiCardState.Suggest; }
        AiShow();
    }

    private async Task AiApply()
    {
        bool ok;
        try { ok = await JS.InvokeAsync<bool>("LinkiiCompoEditor.applyAi", aiEl, aiSuggestion); }
        catch (JSException) { ok = false; }
        if (!ok) { aiMessage = "Le texte n'est plus dans la composition : rien n'a été remplacé."; aiCard = AiCardState.Message; Panel.Refresh(); return; }
        aiCard = AiCardState.Applied; Panel.Save(); Panel.Refresh();
    }

    private async Task AiUndo()
    {
        try { await JS.InvokeAsync<bool>("LinkiiCompoEditor.applyAi", aiEl, aiSource); } catch (JSException) { }
        AiClose("Ancien texte remis : « " + aiSource + " »");
    }

    private void AiClose(string why) { aiOutcome = why; Panel.Release(aiKey); }

    private string AiSummary() => aiOutcome.Length > 0 ? aiOutcome : aiCard switch
    {
        AiCardState.Applied => "Texte remplacé par : « " + aiSuggestion + " »",
        AiCardState.Suggest => Ai.ModeLabel(aiMode) + " : « " + aiSuggestion + " »",
        AiCardState.Message => aiMessage,
        _ => "Demande interrompue.",
    };

    private RenderFragment AiCardView => __builder =>
    {
        switch (aiCard)
        {
            case AiCardState.Loading:
                <div class="ai-sug loading" role="status"><Ico Name="spark" Size="15" /><span>L'IA écrit</span><span class="ai-dots"><i></i><i></i><i></i></span></div>
                break;
            case AiCardState.Message:
                <div class="ai-sug none paused" role="status"><Ico Name="alert" Size="16" /><span>@aiMessage</span><span class="grow"></span><button type="button" class="linklike" @onclick="() => AiClose(aiMessage)">Fermer</button></div>
                break;
            case AiCardState.Applied:
                <div class="ai-sug none done" role="status"><Ico Name="check" Size="15" /><span>Texte remplacé dans la composition.</span><span class="grow"></span><button type="button" class="linklike" @onclick="AiUndo"><Ico Name="rotate-left" Size="14" /> Revenir à l'ancien</button></div>
                <div><button type="button" class="linklike" @onclick='() => AiClose("Texte remplacé par : « " + aiSuggestion + " »")'>C'est bon</button></div>
                break;
            default:
                <div class="ai-sug" role="region" aria-label="Proposition de l'IA">
                    <div class="ai-sug-h"><Ico Name="spark" Size="15" /><b>@Ai.ModeLabel(aiMode)</b></div>
                    <p class="ai-sug-t">@aiSuggestion</p>
                    <div class="ai-sug-a">
                        <button type="button" class="btn sm" @onclick="AiApply"><Ico Name="check" Size="15" /> Remplacer</button>
                        <button type="button" class="btn ghost sm" @onclick='() => AiClose("Proposition ignorée.")'>Ignorer</button>
                    </div>
                    <span class="ai-adj">
                        <button type="button" @onclick='() => AiAsk("short")'>Plus court</button><button type="button" @onclick='() => AiAsk("warm")'>Plus chaleureux</button><button type="button" @onclick='() => AiAsk("formal")'>Plus formel</button>
                        @foreach (var (id, label) in Ai.Languages) { var l = id; <button type="button" @onclick="() => AiAsk(l)">@(char.ToUpper(label[0]) + label[1..])</button> }
                    </span>
                </div>
                break;
        }
    };

    public async ValueTask DisposeAsync()
    {
        Panel.Release(aiKey);
        try { await JS.InvokeVoidAsync("LinkiiCompoEditor.unmount"); }
        catch (JSDisconnectedException) { }
        catch (InvalidOperationException) { }   // rendu statique : pas de JS
        self?.Dispose();
    }
}
