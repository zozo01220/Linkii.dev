    var idx = OpenList.FindIndex(x => x.Id == om.Id);
    <MediaPreviewPanel Item="om" Path="@PathOf(om)" CanEdit="Own(om)" Drive="@(MediaLibrary.IsDrive(om) ? DriveTitle(DriveOf(om)) : null)"
                       CanShare="@Shareable(om)" ShareSum="@(mediaShares.GetValueOrDefault(om.Id, ShareSummary.None))" SharedBy="@SharedBy(om)" CanLeave="@(SharedBy(om) != null && fileTabs.GetValueOrDefault(om.Id)?.SharedIn == true)" CanDelete="@CanDel(om)"
                       OnShare="() => { sharingKind = ShareKind.Media; sharingMedia = new() { (om.Id, om.Name) }; }" OnLeave="() => leaving = om"
