            <p class="hint">@(many ? "Ils seront retirés" : "Il sera retiré") de : <b>@string.Join(", ", used.Take(6))@(used.Count > 6 ? $" et {used.Count - 6} autre{(used.Count > 7 ? "s" : "")}" : "")</b>. Les écrans concernés auront une mise à jour à publier ; d'ici là, ils gardent ce qu'ils diffusent. Cette action est définitive.</p>
        }
        <div class="modal-actions">
            <button class="btn ghost" @onclick="() => confirmDelete = null">Annuler</button>
            <button class="btn danger-solid" @onclick="Delete">Supprimer</button>
        </div>
    </div>
}

<NewMark Family="media" Tab="@tab" Ids="@allFiles.Select(m => m.Id).Concat(folderRows.Select(r => r.Folder.Id))" Via="newVia" />

@code {
    private bool foldersOpen;   // look « app » : liste des dossiers dépliée
    private List<MediaItem> files = new();     // fichiers de la position ouverte
    private HashSet<Guid> unused = new();      // fichiers sans emploi (filtre « Non utilisés », mention sur la vignette)
    private readonly HashSet<Guid> picked = new();
    private string type = "", filter = "", source = "", search = "", sort = "date";   // filter : "" | unused
    private bool scopeAll = true;              // recherche et « Non utilisés » : toute l'aire (défaut) ou le dossier ouvert
    private bool showUpload, dragging;
    private bool inApp;   // look « app » : appui long = sélection
    private string view = "cards";   // cards | list (liste : PC seulement ; sur mobile, toujours en cartes)
    private Guid? menuFor, openId;
    private MediaItem? renaming;
    private string renameValue = "";
    private List<Guid>? confirmDelete;
    private System.Threading.Timer? refreshTimer;
    private MediaUploader? uploader;

    // Imports en cours ou en échec : affichés comme des vignettes en tête de la grille, avec leur pourcentage.
    private IReadOnlyList<MediaUploader.UploadJob> Jobs => uploader?.Jobs ?? Array.Empty<MediaUploader.UploadJob>();

    // Provenance d'un fichier : téléversé ici, exporté depuis Canva, ou synchronisé depuis un dossier Drive.
    private static readonly (string Key, string Label)[] Sources =
        { ("upload", "Téléversés"), ("presentation", "Présentations"), ("canva", "Canva"), ("pdf", "PDF"), ("gdrive", "Google Drive"), ("onedrive", "OneDrive") };

    private string SourceOf(MediaItem m) =>
        Pres.Is(m) ? "presentation"
        : MediaLibrary.IsDrive(m) ? (DriveOf(m)?.Source == "onedrive" ? "onedrive" : "gdrive")
        : m.Info.ContainsKey("canva") || m.Info.ContainsKey("canvaFolder") ? "canva" : m.Info.ContainsKey("pdf") ? "pdf" : "upload";

    private string? SourceLabel(MediaItem m) => Pres.Is(m) ? Pres.Label(m.Info.GetValueOrDefault("src")) : SourceOf(m) switch { "onedrive" => "OneDrive", "gdrive" => "GDrive", "canva" => "Canva", "pdf" => "PDF", _ => null };

    private DriveFolder? DriveOf(MediaItem m) => MediaLibrary.IsDrive(m) ? drives.GetValueOrDefault(m.Info["drive"]) : null;

    // Recherche et « Non utilisés » regardent toute l'aire (chemin affiché sous chaque résultat), comme les listes de lecture ; les types et sources filtrent ce qu'on voit.
    private bool Active => search.Length > 0 || filter != "";
    private bool ShowPath => FoldersShown && Active && scopeAll;
    private IEnumerable<MediaItem> Pool => ShowPath ? scopeFiles : files;

    // Les compteurs de chaque filtre tiennent compte de l'autre (type × source).
    private IEnumerable<MediaItem> ByType => Pool.Where(m => type == "" || m.Type == type);
    private IEnumerable<MediaItem> BySource => Pool.Where(m => source == "" || SourceOf(m) == source);

    private IEnumerable<MediaItem> Visible
    {
        get
        {
            var q = ByType.Where(m => source == "" || SourceOf(m) == source)
                          .Where(m => filter != "unused" || unused.Contains(m.Id))
                          .Where(m => search.Length == 0 || m.Name.Contains(search, StringComparison.OrdinalIgnoreCase));
            return sort switch
            {
                "name" => q.OrderBy(m => m.Name, StringComparer.CurrentCultureIgnoreCase),
                "size" => q.OrderByDescending(m => m.Size ?? 0),
                _ => q   // déjà triés du plus récent au plus ancien
            };
        }
    }

    private long TotalSize => files.Sum(m => m.Size ?? 0);
    private int UnusedHere => Pool.Count(m => unused.Contains(m.Id));

    // Retour de l'assistant d'ajout d'une intégration lancé depuis le tiroir « Depuis le cloud » : le tiroir se rouvre
    [SupplyParameterFromQuery(Name = "import")] public string? ImportParam { get; set; }

    protected override void OnInitialized()
    {
        if (ImportParam == "cloud") showUpload = true;
        tab = Store.Read(d => d.Users.FirstOrDefault(u => u.Id == d.Access.UserId)?.LibraryTabs.GetValueOrDefault("media")) ?? LibraryTab.Mine;
        Reload();
        // pendant une conversion vidéo, la liste se rafraîchit seule
        refreshTimer = new System.Threading.Timer(_ => InvokeAsync(() =>
        {
            if (allFiles.Any(m => m.Status == "processing") || Drives.Running(Store.ClientId).Count > 0) { Reload(); StateHasChanged(); }   // import de dossier Drive : les fichiers arrivent au fil de l'eau
        }), null, 2000, 2000);
        Drives.ProgressChanged += OnDriveProgress;
    }


    // ---------- Présentations (§103) : carte épurée, mêmes pastilles que les médias, dans l'aperçu ----------

    private Dictionary<Guid, MediaItem> covers = new();    // première page de chaque présentation (aperçu de sa carte)
    private Dictionary<Guid, int> presUses = new();         // contenus qui affichent chaque présentation

    private int PresUseCount(MediaItem m) => presUses.GetValueOrDefault(m.Id);

    private string PresFormat(MediaItem m) => $"Présentation · {Pres.Pages(m)} {Pres.UnitPlural(m.Info.GetValueOrDefault("src"), Pres.Pages(m))} · {Pres.Label(m.Info.GetValueOrDefault("src"))}";

    private RenderFragment PresMini(MediaItem item) => __builder =>
    {
