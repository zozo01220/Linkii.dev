    private void LeaveShared()
    {
        if (leaving is not { } m) return;
        string? err;
        try { err = Store.Write(d => ItemShareOps.Leave(d, ShareKind.Media, m.Id)); }
        catch (UnauthorizedAccessException e) { err = e.Message; }
