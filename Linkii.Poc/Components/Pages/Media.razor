@page "/media"
@attribute [Microsoft.AspNetCore.Authorization.Authorize(Policy = "Page:media")]
@implements IAsyncDisposable
@using Microsoft.JSInterop
@inject MediaLibrary Library
@inject DriveService Drives
@inject TenantStore Store
@inject Toaster Toast
@inject IJSRuntime JS

@* Médiathèque épurée (§51) : même squelette que les listes de lecture. Vignettes « galerie » (l'image d'abord), un clic ouvre l'aperçu
   (infos, où le média sert, actions), la case au survol sélectionne. On importe en déposant des fichiers n'importe où sur la page. *@
<div class="lx-top">
    <h1>
        @if (FoldersShown && currentRow is { } cur)
        {
            <button type="button" class="lx-crumb @(dropOver == RootDrop ? "drop-target" : "")" @onclick="() => OpenFolder(null)"
                    @ondragover="() => { }" @ondragover:preventDefault="true" @ondragenter="() => { if (dragIds.Count > 0) dropOver = RootDrop; }" @ondragleave="() => { if (dropOver == RootDrop) dropOver = null; }" @ondrop:preventDefault="true" @ondrop="() => DropOn(null)">Médiathèque</button>
            @foreach (var c in crumbs.Take(crumbs.Count - 1))
            {
                var row = c;
                <span class="lx-sl">/</span>
                <button type="button" class="lx-crumb @(dropOver == row.Folder.Id ? "drop-target" : "")" @onclick="() => OpenFolder(row.Folder.Id)"
                        @ondragover="() => { }" @ondragover:preventDefault="true" @ondragenter="() => { if (dragIds.Count > 0) dropOver = row.Folder.Id; }" @ondragleave="() => { if (dropOver == row.Folder.Id) dropOver = null; }" @ondrop:preventDefault="true" @ondrop="() => DropOn(row.Folder.Id)">@row.Folder.Name</button>
            }
            <span class="lx-sl">/</span>
            <span>@cur.Folder.Name</span>
            <span class="lx-right @(cur.Right == FolderRight.Read ? "ro" : "")"><Ico Name="@(cur.Right == FolderRight.Read ? "lock" : "folder")" Size="12" /> @RightLabel(cur)</span>
            <SharePill Audience="AudienceOf(cur.Folder.Id)" Long="true" Clickable="cur.Right == FolderRight.Owner || cur.Folder.OwnerId == Store.UserId" ReadOnly="cur.Right == FolderRight.Read" OwnerName="@(cur.Folder.OwnerId == Store.UserId ? null : cur.OwnerName)" OnClick="() => sharingId = cur.Folder.Id" />
        }
        else
        {
            <span>Médiathèque</span>
        }
    </h1>
    <span class="grow"></span>
    <div class="btns">
        @if (currentRow is { } here && (here.Right == FolderRight.Owner || here.Folder.OwnerId == Store.UserId))
        {
            <button class="btn ghost sm" @onclick="() => sharingId = here.Folder.Id"><Ico Name="users" Size="14" /> Partager…</button>
        }
        @if (FoldersShown && CanCreateHere) { <button class="btn ghost" @onclick='() => { newFolderName = ""; newFolderError = null; creatingFolder = true; }'><Ico Name="folder" Size="16" /> Nouveau dossier</button> }
        @if (CanUploadHere) { <button class="btn lx-imp" @onclick="OpenImport"><Ico Name="upload" Size="16" /> Importer</button> }
    </div>
</div>

<div class="lx-status">
    <span>@Plural(files.Count, "média", "médias")@(TotalSize > 0 ? $" · {Helpers.FormatSize(TotalSize)}" : "")@(FoldersShown && folderId == null && folderRows.Count > 0 ? $" · {Plural(folderRows.Count, "dossier", "dossiers")}" : "")</span>
    @if (UnusedHere > 0 && filter != "unused")
    {
        <span><i class="lx-dot off"></i>@Plural(UnusedHere, "média non utilisé", "médias non utilisés") <button type="button" class="linklike" @onclick='() => SetFilter("unused")'>Voir</button></span>
    }
    @if (currentRow is { Right: FolderRight.Read })
    {
        <span>Vous pouvez voir, télécharger et utiliser ces fichiers dans vos listes, pas les modifier.</span>
    }
    else if (CanUploadHere && (files.Count > 0 || Jobs.Count > 0))
    {
        <span class="lx-desk">Glissez des fichiers n'importe où sur la page pour les importer.</span>
    }
</div>

<DriveSyncBar />

@if (files.Count == 0 && Jobs.Count == 0 && subfolders.Count == 0 && !Active)
{
    <div class="empty">
        <div class="big">@(folderId == null ? "Votre médiathèque est vide" : "Ce dossier est vide")</div>
        @if (CanUploadHere)
        {
            <p>Glissez ici vos images et vos vidéos depuis l'ordinateur, ou importez-les. Elles serviront dans vos listes de lecture.</p>
            <button class="btn" @onclick="OpenImport"><Ico Name="upload" Size="16" /> Importer des médias</button>
        }
    </div>
}
else
{
    <div class="lx-tools" role="region" aria-label="Recherche et filtres">
        <div class="search-box">
            <Ico Name="search" Size="16" />
            <input data-lx-search placeholder="Rechercher dans la médiathèque" aria-label="Rechercher des médias" @bind="search" @bind:event="oninput" />
        </div>
        @if (Active || type != "" || source != "") { <span class="lx-count" aria-live="polite">@Plural(Visible.Count(), "résultat", "résultats")</span> }
        <FilterMenu Groups="FilterGroups" Extra="@(FoldersShown && folderId != null && !scopeAll ? 1 : 0)" OnPick="PickFilter" OnReset="ResetFilters">
            <Footer>
                @if (FoldersShown && folderId != null)
                {
                    <div class="fm-note"><span>Chercher dans : @(scopeAll ? "toute l'aire" : "ce dossier")</span><button type="button" class="linklike" @onclick="() => scopeAll = !scopeAll">Changer</button></div>
                }
            </Footer>
        </FilterMenu>
        <select @bind="sort" class="tb-sort" aria-label="Trier">
            <option value="date">Récents</option>
            <option value="name">Nom</option>
            <option value="size">Taille</option>
        </select>
        <ViewToggle StorageKey="media" Photos="true" @bind-Value="view" />
    </div>
    <FilterChips Groups="FilterGroups" Extra="FilterExtras" OnClear="ClearFilter" OnResetAll="ResetFilters" />

    @* Dossiers de la position ouverte : puces compactes, cibles du glisser-déposer *@
    @if (subfolders.Count > 0)
    {
        @* Look « app » : les dossiers se replient derrière un bouton (masqué ailleurs par le CSS). *@
        <button type="button" class="lx-fold-toggle @(foldersOpen ? "open" : "")" aria-expanded="@(foldersOpen ? "true" : "false")" @onclick="() => foldersOpen = !foldersOpen"><Ico Name="folder" Size="16" /> <span>Dossiers</span> <small>@subfolders.Count</small><Ico Name="chevron" Size="16" /></button>
        <div class="lx-folders @(foldersOpen ? "open" : "")">
            @foreach (var row in subfolders)
            {
                var r = row;
                var inside = ChildCount(r.Folder.Id);
                var mine = r.Folder.OwnerId == Store.UserId;
                <div class="lx-fchip @(r.Shared ? "" : "priv") @(dropOver == r.Folder.Id ? "drop-target" : "")" role="button" tabindex="0" title="@FolderTitle(r)" aria-label="Ouvrir le dossier @r.Folder.Name" @onclick="() => OpenFolder(r.Folder.Id)" @onkeydown='e => { if (e.Key == "Enter") OpenFolder(r.Folder.Id); }'
                     @ondragover="() => { }" @ondragover:preventDefault="true" @ondragenter="() => { if (dragIds.Count > 0) dropOver = r.Folder.Id; }" @ondragleave="() => { if (dropOver == r.Folder.Id) dropOver = null; }" @ondrop:preventDefault="true" @ondrop="() => DropOn(r.Folder.Id)">
                    <Ico Name="folder" Size="17" />
                    <span class="nm">@r.Folder.Name</span>
                    <small>@inside</small>
                    <SharePill Audience="AudienceOf(r.Folder.Id)" Clickable="mine || isAdmin" ReadOnly="r.Right == FolderRight.Read" OwnerName="@(mine ? null : r.OwnerName)" OnClick="() => sharingId = r.Folder.Id" />
                    @if (mine || isAdmin)
                    {
                        <div class="kebab" @onclick:stopPropagation="true">
                            <button type="button" class="kebab-btn" aria-label="Actions pour le dossier @r.Folder.Name" aria-haspopup="menu" aria-expanded="@(menuFor == r.Folder.Id ? "true" : "false")"
                                    @onclick="() => menuFor = menuFor == r.Folder.Id ? null : r.Folder.Id"><Ico Name="dots-v" Size="16" /></button>
                            @if (menuFor == r.Folder.Id)
                            {
                                <div class="kebab-backdrop" @onclick="() => menuFor = null"></div>
                                <div class="kebab-menu" role="menu">
                                    <span class="kebab-note">@(mine ? "Votre dossier" : $"Dossier de {r.OwnerName}") · @(r.Shared ? "partagé" : "privé")</span>
                                    <button type="button" role="menuitem" @onclick="() => { menuFor = null; sharingId = r.Folder.Id; }"><Ico Name="users" Size="16" /> Partager…</button>
                                    @if (r.Right == FolderRight.Owner)
                                    {
                                        <button type="button" role="menuitem" @onclick="() => { menuFor = null; renamingFolder = r; renameFolderValue = r.Folder.Name; newFolderError = null; }"><Ico Name="edit" Size="16" /> Renommer</button>
                                        <button type="button" role="menuitem" class="danger" @onclick="() => { menuFor = null; deletingFolder = r; }"><Ico Name="trash" Size="16" /> Supprimer</button>
                                    }
                                </div>
                            }
                        </div>
                    }
                </div>
            }
        </div>
    }

    @if (!Visible.Any() && Jobs.Count == 0)
    {
        @if (Active || type != "" || source != "") { <div class="empty"><div class="big">Aucun média ne correspond</div><button class="btn ghost sm" @onclick='() => { search = ""; filter = ""; type = ""; source = ""; }'>Effacer la recherche et les filtres</button></div> }
    }
    else
    {
        @if (view == "list")
        {
        <div class="lx-tbl-wrap">
            <table class="lx-tbl">
                <thead>
                    <tr>
                        <th style="width:34px"><input type="checkbox" class="sc-check lx-check" checked="@AllPicked" @onchange="ToggleAll" aria-label="Tout sélectionner" /></th>
                        <th><button type="button" class="@(sort == "name" ? "on" : "")" @onclick='() => sort = "name"'>Nom</button></th>
                        @if (FoldersShown) { <th>Emplacement</th> }
                        <th>Format</th>
                        <th class="num"><button type="button" class="@(sort == "size" ? "on" : "")" @onclick='() => sort = "size"'>Taille</button></th>
                        <th>Utilisation</th>
                        <th><button type="button" class="@(sort == "date" ? "on" : "")" @onclick='() => sort = "date"'>Importé</button></th>
                        <th style="width:44px"><span class="sr-only">Actions</span></th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var j in Jobs)
                    {
                        var job = j;
                        <tr>
                            <td></td>
                            <td><div class="nm"><span class="mini"><Ico Name="upload" Size="16" /></span><span>@job.Name</span></div></td>
                            @if (FoldersShown) { <td></td> }
                            <td colspan="4"><small>@(job.State == "error" ? job.Error ?? "Échec de l'import" : job.Total is > 0 ? $"Envoi · {MediaUploader.Pct(job)} %" : "Envoi…")</small></td>
                            <td><button type="button" class="kebab-btn" aria-label="@(job.State == "error" ? "Retirer" : "Annuler l'import de") @job.Name" @onclick="() => DismissJob(job)"><Ico Name="x" Size="16" /></button></td>
                        </tr>
                    }
                    @foreach (var m in Visible)
                    {
                        var item = m;
                        <tr class="@(picked.Contains(item.Id) ? "picked" : "") @(dragIds.Contains(item.Id) ? "dragging" : "")" draggable="@(CanDrag(item) ? "true" : "false")" @ondragstart="() => StartDrag(item)" @ondragend="EndDrag">
                            <td>@if (Selectable(item)) { <input type="checkbox" class="sc-check lx-check" checked="@picked.Contains(item.Id)" @onchange="() => Toggle(item.Id)" aria-label="Sélectionner @item.Name" /> }</td>
                            <td><div class="nm"><span class="mini">@if (item.Status == null) { <MediaThumb Media="item" /> } else { <Ico Name="@(item.Status == "failed" ? "x" : "hourglass")" Size="16" /> }</span><button type="button" title="@item.Name" @onclick="() => Open(item)">@item.Name</button></div></td>
                            @if (FoldersShown) { <td><small>@PathOf(item)</small></td> }
                            <td><small>@(item.Type == "video" ? "Vidéo" : "Image")@(MediaProbe.Label(item) is { } fmt ? " · " + fmt : "")@(SourceLabel(item) is { } src ? " · " + src : "")</small></td>
                            <td class="num">@(item.Size is { } s ? Helpers.FormatSize(s) : "—")</td>
                            <td>@if (item.Status == "failed") { <span class="lx-state bad"><i class="lx-dot bad"></i><span>Échec</span></span> } else if (unused.Contains(item.Id)) { <span class="lx-state"><i class="lx-dot off"></i><span>Non utilisé</span></span> } else { <span class="lx-state ok"><i class="lx-dot"></i><span>Utilisé</span></span> }</td>
                            <td><small>@(item.AddedUtc is { } a ? a.ToLocalTime().ToString("dd.MM.yyyy") : "—")</small></td>
                            <td>@Menu(item)</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
        }
        @if (view == "photos")
        {
            @* Vue « photos » : mosaïque serrée groupée par jour d'import ; pastille ronde pour sélectionner (appui long dans l'app) ; état d'usage en simple point. *@
            <div class="ph @(picked.Count > 0 ? "ph-selecting" : "")">
                @if (Jobs.Count > 0)
                {
                    <div class="ph-day"><span>Envoi en cours <small>@Jobs.Count</small></span></div>
                    <div class="ph-grid">
                        @foreach (var j in Jobs)
                        {
                            var job = j;
                            var failed = job.State == "error";
                            <div class="ph-t up @(failed ? "fail" : "")" title="@job.Name">
                                @if (failed) { <span class="ph-msg"><Ico Name="x" Size="18" />@(job.Error ?? "Échec")</span> }
                                else { <span class="ph-msg">@(job.Total is > 0 ? $"{MediaUploader.Pct(job)} %" : "Envoi…")</span><span class="ph-bar" style="width:@(MediaUploader.Pct(job))%"></span> }
                                <button type="button" class="ph-x" aria-label="@(failed ? "Retirer" : "Annuler l'import de") @job.Name" @onclick="() => DismissJob(job)"><Ico Name="x" Size="14" /></button>
                            </div>
                        }
                    </div>
                }
                @foreach (var g in PhotoGroups)
                {
                    var grp = g;
                    var selectable = grp.Items.Where(Selectable).ToList();
                    var allIn = selectable.Count > 0 && selectable.All(x => picked.Contains(x.Id));
                    @if (grp.Label != null)
                    {
                        <div class="ph-day">
                            @if (selectable.Count > 0) { <button type="button" class="ph-dayck @(allIn ? "on" : "")" aria-label="Sélectionner tout « @grp.Label »" aria-pressed="@(allIn ? "true" : "false")" @onclick="() => ToggleGroup(selectable)"><Ico Name="check" Size="13" /></button> }
                            <span>@grp.Label <small>@grp.Items.Count</small></span>
                        </div>
                    }
                    <div class="ph-grid">
                        @foreach (var m in grp.Items)
                        {
                            var item = m;
                            var failed = item.Status == "failed";
                            <div class="ph-t @(picked.Contains(item.Id) ? "picked" : "") @(failed ? "fail" : "") @(dragIds.Contains(item.Id) ? "dragging" : "")" style="--r:@PhotoRatio(item)"
                                 role="button" tabindex="0" title="@item.Name" aria-label="Aperçu de @item.Name" @onclick="e => ClickCard(item, e)" @onkeydown='e => { if (e.Key == "Enter") Open(item); }'
                                 @oncontextmenu="() => LongPress(item)" @oncontextmenu:preventDefault="inApp"
                                 draggable="@(CanDrag(item) ? "true" : "false")" @ondragstart="() => StartDrag(item)" @ondragend="EndDrag">
                                @if (item.Status == "processing") { <span class="ph-msg"><span class="spinner-lg"></span>Conversion…</span> }
                                else if (failed) { <span class="ph-msg"><Ico Name="x" Size="18" />@(item.Error ?? "Import en échec")</span> }
                                else { <MediaThumb Media="item" /> }
                                @if (Selectable(item)) { <input type="checkbox" class="sc-check lx-check" checked="@picked.Contains(item.Id)" @onclick:stopPropagation="true" @onchange="() => Toggle(item.Id)" aria-label="Sélectionner @item.Name" /> }
                                @if (!failed && item.Status == null)
                                {
                                    @if (item.Type == "video") { <span class="ph-dur"><Ico Name="play" Size="10" />@(Seconds(item) is { } sec ? Helpers.FormatDuration(sec) : "")</span> }
                                    <span class="ph-use @(unused.Contains(item.Id) ? "no" : "")" title="@(unused.Contains(item.Id) ? "Non utilisé" : "Utilisé dans une liste")"></span>
                                }
                            </div>
                        }
                    </div>
                }
            </div>
        }
        else
        {
        @* sur mobile, toujours en cartes (pas de bascule) *@
        <div class="lx-mgrid @(picked.Count > 0 ? "lx-selecting" : "") @(view == "list" ? "lx-mobile-only" : "")">
            @foreach (var j in Jobs)
            {
                var job = j;
                var failed = job.State == "error";
                <div class="lx-mc @(failed ? "fail" : "up")">
                    <div class="th">
                        @if (failed) { <Ico Name="x" Size="22" /><span>@(job.Error ?? "Échec de l'import")</span><div class="acts"><button type="button" @onclick="() => DismissJob(job)">Retirer</button></div> }
                        else
                        {
                            <span class="pct">@(job.Total is > 0 ? $"{MediaUploader.Pct(job)} %" : Helpers.FormatSize(job.Done))</span>
                            <span class="bar" style="width:@(MediaUploader.Pct(job))%"></span>
                            <button type="button" class="kebab-btn x" aria-label="Annuler l'import de @job.Name" title="Annuler" @onclick="() => DismissJob(job)"><Ico Name="x" Size="15" /></button>
                        }
                    </div>
                    <div class="nm" title="@job.Name">@job.Name</div>
                    <div class="mt">@(failed ? "Échec de l'import" : job.Total is > 0 ? $"Envoi · {Helpers.FormatSize(job.Done)} / {Helpers.FormatSize(job.Total.Value)}" : "Envoi…")</div>
                </div>
            }
            @foreach (var m in Visible)
            {
                var item = m;
                var failed = item.Status == "failed";
                <div class="lx-mc @(picked.Contains(item.Id) ? "picked" : "") @(failed ? "fail" : "") @(openId == item.Id ? "open" : "") @(dragIds.Contains(item.Id) ? "dragging" : "")"
                     role="button" tabindex="0" aria-label="Aperçu de @item.Name" @onclick="e => ClickCard(item, e)" @onkeydown='e => { if (e.Key == "Enter") Open(item); }'
                     draggable="@(CanDrag(item) ? "true" : "false")" @ondragstart="() => StartDrag(item)" @ondragend="EndDrag">
                    <div class="th">
                        @if (item.Status == "processing") { <span class="spinner-lg"></span><small>Conversion en MP4…</small> }
                        else if (failed)
                        {
                            <Ico Name="x" Size="22" /><span title="@item.Error">@(item.Error ?? "Import en échec")</span>
                            @if (Own(item)) { <div class="acts" @onclick:stopPropagation="true"><button type="button" @onclick="() => confirmDelete = new() { item.Id }">Retirer</button></div> }
                        }
                        else { <MediaThumb Media="item" /> }
                        @if (Selectable(item)) { <input type="checkbox" class="sc-check lx-check" checked="@picked.Contains(item.Id)" @onclick:stopPropagation="true" @onchange="() => Toggle(item.Id)" aria-label="Sélectionner @item.Name" /> }
                        @if (!failed && item.Status == null)
                        {
                            @if (SourceLabel(item) is { } src) { <span class="lx-src" title="@(MediaLibrary.IsDrive(item) ? DriveTitle(DriveOf(item)) : null)">@if (MediaLibrary.IsDrive(item)) { <Ico Name="folder" Size="11" /> }@src</span> }
                            @if (item.Type == "video") { <span class="lx-badge"><Ico Name="play" Size="11" />@(Seconds(item) is { } s ? Helpers.FormatDuration(s) : "")</span> }
                            @if (unused.Contains(item.Id)) { <span class="lx-unused">Non utilisé</span> }
                        }
                    </div>
                    <div class="nm" title="@item.Name">@if (FoldersShown && item.FolderId is { } fid && rights.GetValueOrDefault(fid) == FolderRight.Read) { <Ico Name="lock" Size="12" /> }@item.Name</div>
                    <div class="mt">@(ShowPath ? PathOf(item) : Details(item))</div>
                </div>
            }
        </div>
        }
    }

    @if (CanUploadHere && picked.Count == 0)
    {
        <button type="button" class="ph-fab" aria-label="Importer des médias" @onclick="OpenImport"><Ico Name="upload" Size="24" /></button>
    }

    @if (picked.Count > 0)
    {
        <div class="lx-selbar" role="region" aria-label="Sélection">
            <b>@picked.Count sélectionné@(picked.Count > 1 ? "s" : "")</b>
            <button type="button" @onclick="ToggleAll">@(AllPicked ? "Tout désélectionner" : $"Tout sélectionner ({Visible.Count(Selectable)})")</button>
            <span class="vr"></span>
            @if (FoldersShown) { <button type="button" disabled="@(pickedEditable.Count == 0)" @onclick="() => folderMove = pickedEditable"><Ico Name="folder" Size="15" /><span class="lx-lbl">Ranger…</span></button> }
            @if (canMove && pickedOwn.Count > 0) { <button type="button" @onclick="() => bulkMove = true"><Ico Name="move" Size="15" /><span class="lx-lbl">Autre aire…</span></button> }
            <span class="vr"></span>
            <button type="button" class="del" @onclick="() => confirmDelete = pickedOwn.Select(x => x.Id).ToList()"><Ico Name="trash" Size="15" /> Supprimer</button>
            <span class="vr"></span>
            <button type="button" title="Tout désélectionner (Échap)" aria-label="Tout désélectionner" @onclick="() => picked.Clear()"><Ico Name="x" Size="15" /></button>
        </div>
    }
}

@* Import : la fenêtre (choisir des fichiers ou coller une adresse) et le voile de dépôt restent dans la page, fermés,
   pour que les imports continuent et que les fichiers déposés se lisent depuis leur champ. *@
@if (CanUploadHere)
{
    <div style="@(showUpload ? "" : "display:none")">
        <div class="modal-backdrop" @onclick="() => showUpload = false"></div>
        <div class="modal lx-import" role="dialog" aria-modal="true" aria-labelledby="imp-title">
            <h3 id="imp-title">Importer@(currentRow is { } f ? $" dans « {f.Folder.Name} »" : "")</h3>
            <MediaUploader OnImported="Imported" ShowJobs="false" Changed="UploadChanged" @ref="uploader" FolderId="folderId" />
            <div class="modal-actions"><button class="btn ghost" @onclick="() => showUpload = false">Fermer</button></div>
        </div>
    </div>
    <div class="lx-dropzone @(dragging ? "on" : "")" aria-hidden="@(dragging ? "false" : "true")">
        <Ico Name="upload" Size="40" />
        <span>Déposez pour importer@(currentRow is { } f2 ? $" dans « {f2.Folder.Name} »" : " dans la médiathèque")</span>
        <small>Images (JPG, PNG, GIF, WEBP, SVG) et vidéos (MP4, MOV, AVI, MKV…) · 2 Go maximum par fichier</small>
        <InputFile OnChange="OnDropped" multiple aria-label="Fichiers à importer" />
    </div>
}

@if (open is { } om)
{
    var idx = OpenList.FindIndex(x => x.Id == om.Id);
    <MediaPreviewPanel Item="om" Path="@PathOf(om)" CanEdit="Own(om)" Drive="@(MediaLibrary.IsDrive(om) ? DriveTitle(DriveOf(om)) : null)"
                       HasPrev="idx > 0" HasNext="idx >= 0 && idx < OpenList.Count - 1"
                       OnClose="() => openId = null" OnPrev="() => Step(-1)" OnNext="() => Step(1)"
                       OnRename="() => OpenRename(om)"
                       OnFolder="@(FoldersShown ? EventCallback.Factory.Create(this, () => folderMove = new() { (om.Id, om.Name) }) : default)"
                       OnArea="@(canMove ? EventCallback.Factory.Create(this, () => moving = om) : default)"
                       OnDelete="() => confirmDelete = new() { om.Id }" />
}

@if (creatingFolder)
