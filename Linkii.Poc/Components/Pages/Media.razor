@if (deletingFolder is { } df)
{
    var usedInFolder = Library.UsedInFolder(df.Folder.Id);
    var inside = allFiles.Count(m => m.FolderId == df.Folder.Id);
    <div class="modal-backdrop" @onclick="() => deletingFolder = null"></div>
    <div class="modal" role="alertdialog" aria-modal="true" aria-labelledby="df-title">
        <h3 id="df-title">Supprimer le dossier « @df.Folder.Name » ?</h3>
        <p class="hint">Le dossier, ses sous-dossiers et leurs fichiers@(inside > 0 ? $" ({inside} visible{(inside > 1 ? "s" : "")} ici)" : "") seront supprimés. Cette action est définitive.</p>
        @if (usedInFolder.Count > 0)
        {
            <p class="hint">Ces fichiers sont utilisés et seront retirés de : <b>@string.Join(", ", usedInFolder)</b>. Les écrans concernés auront une mise à jour à publier.</p>
        }
        <div class="modal-actions">
            <button class="btn ghost" @onclick="() => deletingFolder = null">Annuler</button>
            <button class="btn danger-solid" @onclick="() => DeleteFolder(df)">Supprimer</button>
        </div>
    </div>
}

@if (sharingId is { } shId)
{
    <FolderShareDialog FolderId="shId" OnClose="() => { sharingId = null; Reload(); StateHasChanged(); }" />
}

@if (folderMove is { } fm)
{
    <FolderMoveDialog Items="fm" OnClose='n => { folderMove = null; if (n > 0) { picked.Clear(); Toast.Ok(n > 1 ? $"{n} fichiers rangés." : "Fichier rangé."); Reload(); } }' />
}

@if (moving is { } mv)
{
    <AreaMoveDialog Kind="media" Items="new() { (mv.Id, mv.Name) }" OnClose="moved => { moving = null; if (moved) { openId = null; Reload(); } }" />
