@if (confirmDelete is { Count: > 0 } del)
{
    var used = del.SelectMany(Library.UsedBy).Distinct().ToList();
    var many = del.Count > 1;
    <div class="modal-backdrop" @onclick="() => confirmDelete = null"></div>
    <div class="modal" role="alertdialog" aria-modal="true" aria-labelledby="mdel-title">
        <h3 id="mdel-title">Supprimer @(many ? $"{del.Count} médias" : $"« {allFiles.FirstOrDefault(f => f.Id == del[0])?.Name} »") ?</h3>
        @if (used.Count == 0)
        {
            <p class="hint">@(many ? "Ils ne sont" : "Il n'est") dans aucune liste de lecture ni aucun contenu. Cette action est définitive.</p>
        }
        else
        {
            <p class="hint">@(many ? "Ils seront retirés" : "Il sera retiré") de : <b>@string.Join(", ", used.Take(6))@(used.Count > 6 ? $" et {used.Count - 6} autre{(used.Count > 7 ? "s" : "")}" : "")</b>. Les écrans concernés auront une mise à jour à publier ; d'ici là, ils gardent ce qu'ils diffusent. Cette action est définitive.</p>
        }
        <div class="modal-actions">
            <button class="btn ghost" @onclick="() => confirmDelete = null">Annuler</button>
            <button class="btn danger-solid" @onclick="Delete">Supprimer</button>
        </div>
    </div>
}

@code {
    private bool foldersOpen;   // look « app » : liste des dossiers dépliée
    private List<MediaItem> files = new();     // fichiers de la position ouverte
    private HashSet<Guid> unused = new();      // fichiers sans emploi (filtre « Non utilisés », mention sur la vignette)
    private readonly HashSet<Guid> picked = new();
    private string type = "", filter = "", source = "", search = "", sort = "date";   // filter : "" | unused
    private bool scopeAll = true;              // recherche et « Non utilisés » : toute l'aire (défaut) ou le dossier ouvert
    private bool showUpload, dragging;
    private bool inApp;   // look « app » : appui long = sélection
    private string view = "cards";   // cards | list (liste : PC seulement ; sur mobile, toujours en cartes)
    private Guid? menuFor, openId;
    private MediaItem? renaming;
    private string renameValue = "";
    private List<Guid>? confirmDelete;
    private System.Threading.Timer? refreshTimer;
