    <div class="modal-backdrop" @onclick="() => confirmDelete = null"></div>
    <div class="modal" role="alertdialog" aria-modal="true" aria-labelledby="mdel-title">
        <h3 id="mdel-title">Supprimer @(many ? $"{del.Count} médias" : $"« {allFiles.FirstOrDefault(f => f.Id == del[0])?.Name} »") ?</h3>
        @if (used.Count == 0)
        {
            <p class="hint">@(many ? "Ils ne sont" : "Il n'est") dans aucune liste de lecture ni aucun contenu. Cette action est définitive.</p>
