@page "/media"
@attribute [Microsoft.AspNetCore.Authorization.Authorize(Policy = "Page:media")]
@implements IDisposable
@inject MediaLibrary Library
@inject DriveService Drives
@inject TenantStore Store
@inject Toaster Toast
@inject ModeService Modes

<div class="page-head">
    <div>
        <h1>Médiathèque</h1>
        <p class="sub">Vos images et vidéos, y compris celles de vos dossiers Drive, à utiliser dans vos listes de lecture.</p>
    </div>
    <div class="btns">
        @if (FoldersShown && CanCreateHere) { <button class="btn ghost" @onclick='() => { newFolderName = ""; newFolderError = null; creatingFolder = true; }'><Ico Name="folder" Size="16" /> Nouveau dossier</button> }
        @if (CanUploadHere)
        {
            <button class="btn" @onclick="() => showUpload = !showUpload" aria-expanded="@(showUpload ? "true" : "false")">
                <Ico Name="upload" Size="16" /> Téléverser des médias
            </button>
        }
    </div>
</div>

<DriveSyncBar />

@if (FoldersShown)
{
    <nav class="lib-crumb" aria-label="Emplacement dans la médiathèque">
        <button type="button" class="linklike" @onclick="() => OpenFolder(null)" @ondragover="() => { }" @ondragover:preventDefault="true" @ondrop:preventDefault="true" @ondrop="() => DropOn(null)"><Ico Name="image" Size="15" /> Médiathèque de l'aire</button>
        @foreach (var c in crumbs)
        {
            var row = c;
            <span class="sep">›</span>
            <button type="button" class="linklike" @onclick="() => OpenFolder(row.Folder.Id)" @ondragover="() => { }" @ondragover:preventDefault="true" @ondrop:preventDefault="true" @ondrop="() => DropOn(row.Folder.Id)">@row.Folder.Name</button>
        }
    </nav>
    @if (currentRow is { } cur)
    {
        @if (cur.Right == FolderRight.Read)
        {
            <div class="dw-note"><Ico Name="lock" Size="15" /><span class="grow">Dossier partagé en <b>lecture seule</b> : vous pouvez voir, télécharger et utiliser ses fichiers dans vos listes, pas les modifier.</span></div>
        }
        <div class="lib-folder-head">
            <span class="muted">@(cur.Folder.OwnerId == Store.UserId ? "Votre dossier" : $"Dossier de {cur.OwnerName}")@(cur.Shared ? " · partagé" : " · privé")</span>
            <span class="grow"></span>
            @if (cur.Right == FolderRight.Owner || cur.Folder.OwnerId == Store.UserId) { <button class="btn ghost sm" @onclick="() => sharingId = cur.Folder.Id"><Ico Name="users" Size="14" /> Partager…</button> }
        </div>
    }
}

@if (creatingFolder)
{
    <div class="modal-backdrop" @onclick="() => creatingFolder = false"></div>
    <div class="modal" role="dialog" aria-modal="true" aria-labelledby="nf-title">
        <h3 id="nf-title">Nouveau dossier@(folderId is { } ? $" dans « {currentRow?.Folder.Name} »" : "")</h3>
        <input style="width:100%;margin-top:10px" placeholder="Nom du dossier" maxlength="60" aria-label="Nom du dossier" @bind="newFolderName" @bind:event="oninput" @onkeydown='e => { if (e.Key == "Enter") CreateFolder(); }' />
        @if (newFolderError != null) { <div class="err">@newFolderError</div> }
        <p class="hint">Privé à votre nom : partagez-le ensuite avec d'autres membres, en lecture ou en écriture.</p>
        <div class="modal-actions">
            <button class="btn ghost" @onclick="() => creatingFolder = false">Annuler</button>
            <button class="btn" disabled="@string.IsNullOrWhiteSpace(newFolderName)" @onclick="CreateFolder">Créer</button>
        </div>
    </div>
}

@if (renamingFolder is { } rf)
{
    <div class="modal-backdrop" @onclick="() => renamingFolder = null"></div>
    <div class="modal" role="dialog" aria-modal="true" aria-labelledby="rnf-title">
        <h3 id="rnf-title">Renommer le dossier</h3>
        <input style="width:100%;margin-top:10px" maxlength="60" aria-label="Nom du dossier" @bind="renameFolderValue" @bind:event="oninput" @onkeydown='e => { if (e.Key == "Enter") RenameFolder(rf); }' />
        @if (newFolderError != null) { <div class="err">@newFolderError</div> }
        <div class="modal-actions">
            <button class="btn ghost" @onclick="() => renamingFolder = null">Annuler</button>
            <button class="btn" disabled="@string.IsNullOrWhiteSpace(renameFolderValue)" @onclick="() => RenameFolder(rf)">Renommer</button>
        </div>
    </div>
}

@if (deletingFolder is { } df)
{
    var usedInFolder = Library.UsedInFolder(df.Folder.Id);
    var inside = files.Count(m => m.FolderId == df.Folder.Id);
    <div class="modal-backdrop" @onclick="() => deletingFolder = null"></div>
    <div class="modal" role="alertdialog" aria-modal="true" aria-labelledby="df-title">
        <h3 id="df-title">Supprimer le dossier « @df.Folder.Name » ?</h3>
        <p class="hint">Le dossier, ses sous-dossiers et leurs fichiers@(inside > 0 ? $" ({inside} visible{(inside > 1 ? "s" : "")} ici)" : "") seront supprimés. Cette action est définitive.</p>
        @if (usedInFolder.Count > 0)
        {
            <p class="hint">Ces fichiers sont utilisés et seront retirés de : <b>@string.Join(", ", usedInFolder)</b>. Les écrans concernés auront une mise à jour à publier.</p>
        }
        <div class="modal-actions">
            <button class="btn ghost" @onclick="() => deletingFolder = null">Annuler</button>
            <button class="btn danger-solid" @onclick="() => DeleteFolder(df)">Supprimer</button>
        </div>
    </div>
}

@if (sharingId is { } shId)
{
    <FolderShareDialog FolderId="shId" OnClose="() => { sharingId = null; Reload(); StateHasChanged(); }" />
}

@if (folderMove is { } fm)
{
    <FolderMoveDialog Items="fm" OnClose='n => { folderMove = null; if (n > 0) { picked.Clear(); Toast.Ok(n > 1 ? $"{n} fichiers rangés." : "Fichier rangé."); Reload(); } }' />
}

@if (unusedCanva.Count > 0)
{
    <div class="dw-note lib-clean">
        <span class="grow">@unusedCanva.Count export@(unusedCanva.Count > 1 ? "s" : "") Canva @(unusedCanva.Count > 1 ? "ne servent" : "ne sert") plus : @(unusedCanva.Count > 1 ? "ils ne sont" : "il n'est") dans aucun contenu ni sur aucun écran.</span>
        <button type="button" class="btn ghost sm" @onclick="() => cleaning = true"><Ico Name="trash" Size="14" /> Nettoyer…</button>
    </div>
}

@* Toujours présent (masqué quand le panneau est replié) : refermer le panneau n'interrompt pas les imports en cours. *@
@if (CanUploadHere)
{
    <div class="card lib-upload" style="@(showUpload || (files.Count == 0 && Jobs.Count == 0) ? "" : "display:none")">
        <MediaUploader OnImported="Imported" ShowJobs="false" Changed="StateHasChanged" @ref="uploader" FolderId="folderId" />
    </div>
}

@* Dossiers de la position ouverte (option « Dossiers dans la médiathèque », mode expert) : tuiles cliquables, au-dessus des fichiers. *@
@if (subfolders.Count > 0 && search.Length == 0 && filter == "" && source == "")
{
    <div class="lib-grid lib-folders">
        @foreach (var row in subfolders)
        {
            var r = row;
            var inside = ChildCount(r.Folder.Id);
            var mine = r.Folder.OwnerId == Store.UserId;
            <div class="lib-card lib-folder @(dropOver == r.Folder.Id ? "drop-target" : "")" role="button" tabindex="0" aria-label="Ouvrir le dossier @r.Folder.Name" @onclick="() => OpenFolder(r.Folder.Id)"
                 @ondragover="() => { }" @ondragover:preventDefault="true" @ondragenter="() => { if (dragIds.Count > 0) dropOver = r.Folder.Id; }" @ondragleave="() => { if (dropOver == r.Folder.Id) dropOver = null; }" @ondrop:preventDefault="true" @ondrop="() => DropOn(r.Folder.Id)">
                <div class="lib-th lib-th-folder">
                    <Ico Name="folder" Size="34" />
                    <span class="lib-count">@inside élément@(inside > 1 ? "s" : "")</span>
                </div>
                <div class="lib-body">
                    <div class="lib-text">
                        <span class="lib-name" title="@r.Folder.Name">@r.Folder.Name</span>
                        <div class="lib-sub"><small class="lib-size">@(mine ? "Votre dossier" : $"Dossier de {r.OwnerName}")</small></div>
                    </div>
                    @if (mine) { <span class="pill dark">Propriétaire</span> }
                    else if (r.Right == FolderRight.Write) { <span class="pill ok">Écriture</span> }
                    else if (r.Right == FolderRight.Read) { <span class="pill blue">Lecture</span> }
                    else { <span class="pill">Administrateur</span> }
                    @if (mine || isAdmin)
                    {
                        <div class="kebab" @onclick:stopPropagation="true">
                            <button type="button" class="kebab-btn" aria-label="Actions pour le dossier @r.Folder.Name" aria-haspopup="menu" aria-expanded="@(menuFor == r.Folder.Id ? "true" : "false")"
                                    @onclick="() => menuFor = menuFor == r.Folder.Id ? null : r.Folder.Id"><Ico Name="dots-v" Size="18" /></button>
                            @if (menuFor == r.Folder.Id)
                            {
                                <div class="kebab-backdrop" @onclick="() => menuFor = null"></div>
                                <div class="kebab-menu" role="menu">
                                    <button type="button" role="menuitem" @onclick="() => { menuFor = null; sharingId = r.Folder.Id; }"><Ico Name="users" Size="16" /> Partager…</button>
                                    @if (r.Right == FolderRight.Owner)
                                    {
                                        <button type="button" role="menuitem" @onclick="() => { menuFor = null; renamingFolder = r; renameFolderValue = r.Folder.Name; newFolderError = null; }"><Ico Name="edit" Size="16" /> Renommer</button>
                                        <button type="button" role="menuitem" class="danger" @onclick="() => { menuFor = null; deletingFolder = r; }"><Ico Name="trash" Size="16" /> Supprimer</button>
                                    }
                                </div>
                            }
                        </div>
                    }
                </div>
            </div>
        }
    </div>
}

@if (files.Count > 0 || Jobs.Count > 0)
{
    <div class="lib-tools">
        <label class="lib-all">
            <input type="checkbox" class="sc-check" checked="@(Visible.Any(m => !MediaLibrary.IsDrive(m)) && Visible.Where(m => !MediaLibrary.IsDrive(m)).All(m => picked.Contains(m.Id)))" @onchange="ToggleAll" aria-label="Tout sélectionner" />
            @if (picked.Count > 0) { <span>@picked.Count sélectionné@(picked.Count > 1 ? "s" : "")</span> }
        </label>
        @if (picked.Count > 0)
        {
            @if (FoldersShown && pickedEditable.Count > 0) { <button class="btn ghost sm" @onclick="() => folderMove = pickedEditable"><Ico Name="move" Size="14" /> Ranger dans un dossier…</button> }
            @if (canMove) { <button class="btn ghost sm" @onclick="() => bulkMove = true"><Ico Name="move" Size="14" /> Déplacer vers une autre aire…</button> }
            <button class="btn danger sm" @onclick="() => confirmDelete = picked.ToList()"><Ico Name="trash" Size="14" /> Supprimer</button>
        }
        <div class="seg" role="tablist" aria-label="Type de fichier">
            <button type="button" class="@(filter == "" ? "on" : "")" @onclick='() => filter = ""'>Tous <small>@BySource.Count()</small></button>
            <button type="button" class="@(filter == "image" ? "on" : "")" @onclick='() => filter = "image"'>Images <small>@BySource.Count(m => m.Type == "image")</small></button>
            <button type="button" class="@(filter == "video" ? "on" : "")" @onclick='() => filter = "video"'>Vidéos <small>@BySource.Count(m => m.Type == "video")</small></button>
        </div>
        <select @bind="source" aria-label="Source">
            <option value="">Toutes les sources</option>
            @foreach (var (key, label) in Sources)
            {
                var n = ByType.Count(m => SourceOf(m) == key);
                @if (n > 0 || source == key) { <option value="@key">@label (@n)</option> }
            }
        </select>
        <div class="search-box grow" style="margin:0">
            <Ico Name="search" Size="16" />
            <input placeholder="Rechercher des médias" aria-label="Rechercher des médias" @bind="search" @bind:event="oninput" />
        </div>
        <select @bind="sort" aria-label="Trier">
            <option value="date">Plus récents</option>
            <option value="name">Nom</option>
            <option value="size">Taille</option>
        </select>
        <ViewToggle StorageKey="media" @bind-Value="view" />
    </div>

    @if (!Visible.Any() && Jobs.Count == 0) { <div class="empty"><div class="big">Aucun média trouvé</div></div> }

    <div class="lib-grid @(view == "list" ? "list" : "")">
        @foreach (var j in Jobs)
        {
            var job = j;
            var failed = job.State == "error";
            <div class="lib-card uploading @(failed ? "failed" : "")">
                <div class="lib-th">
                    @if (failed) { <Ico Name="x" Size="26" /><small class="lib-proc" title="@job.Error">@job.Error</small> }
                    else { <span class="upl-pct">@(job.Total is > 0 ? $"{MediaUploader.Pct(job)} %" : Helpers.FormatSize(job.Done))</span> }
                </div>
                <div class="lib-body">
                    <div class="lib-text">
                        <span class="lib-name" title="@job.Name">@job.Name</span>
                        <small class="lib-size">@(failed ? "Échec de l'import" : job.Total is > 0 ? $"{Helpers.FormatSize(job.Done)} / {Helpers.FormatSize(job.Total.Value)}" : "Téléversement…")</small>
                    </div>
                    <span class="lib-col">@(failed ? "Échec" : "Envoi…")</span>
                    <span class="lib-col"></span>
                    @if (failed) { <button type="button" class="kebab-btn" aria-label="Retirer @job.Name" title="Retirer" @onclick="() => uploader!.Dismiss(job)"><Ico Name="x" Size="16" /></button> }
                    else { <button type="button" class="kebab-btn" aria-label="Annuler l'import de @job.Name" title="Annuler" @onclick="() => uploader!.Cancel(job)"><Ico Name="x" Size="16" /></button> }
                </div>
            </div>
        }
        @foreach (var m in Visible)
        {
            var item = m;
            var on = picked.Contains(item.Id);
            var drive = MediaLibrary.IsDrive(item) ? drives.GetValueOrDefault(item.Info["drive"]) : null;   // fichier synchronisé depuis un dossier Drive
            <div class="lib-card @(on ? "picked" : "") @(item.Status == "failed" ? "failed" : "") @(Selectable(item) ? "selectable" : "") @(dragIds.Contains(item.Id) ? "dragging" : "")" @onclick="() => ClickCard(item)"
                 draggable="@(CanDrag(item) ? "true" : "false")" @ondragstart="() => StartDrag(item)" @ondragend="EndDrag">
                <div class="lib-th">
                    @if (item.Status == "processing") { <span class="spinner-lg"></span><small class="lib-proc">Conversion en MP4…</small> }
                    else if (item.Status == "failed") { <Ico Name="x" Size="26" /><small class="lib-proc" title="@item.Error">@item.Error</small> }
                    else { <MediaThumb Media="item" /> }
                    @if (!MediaLibrary.IsDrive(item) && CanEdit(item)) { <input type="checkbox" class="sc-check lib-check" checked="@on" @onclick:stopPropagation="true" @onchange="() => Toggle(item.Id)" aria-label="Sélectionner @item.Name" /> }
                    else { <input type="checkbox" class="sc-check lib-check" disabled title="@(MediaLibrary.IsDrive(item) ? "Fichier synchronisé depuis un Drive : commun à toutes les aires, ni déplaçable ni supprimable d'ici" : "Dossier en lecture seule : ce fichier ne se modifie pas")" aria-label="@item.Name ne peut pas être sélectionné" /> }
                    <span class="lib-type" title="@(item.Type == "video" ? "Vidéo" : "Image")"><Ico Name="@(item.Type == "video" ? "video" : "image")" Size="15" /></span>
                    @if (MediaLibrary.IsDrive(item))
                    {
                        <span class="lib-drive" title="@DriveTitle(drive)"><Ico Name="folder" Size="13" /> @(drive?.Source == "onedrive" ? "OneDrive" : "Drive")</span>
                    }
                </div>
                <div class="lib-body">
                    <div class="lib-text">
                        <span class="lib-name" title="@item.Name">@item.Name</span>
                        <div class="lib-sub">
                        <small class="lib-size" title="@(item.Width is > 0 ? $"{item.Width}×{item.Height} px" : null)">@(item.Size is { } s ? Helpers.FormatSize(s) : "—")@(MediaProbe.Label(item) is { } fmt ? " · " + fmt : "")</small>
                        @if (item.AddedUtc is { } added) { <small class="lib-added">Importé le @added.ToLocalTime().ToString("dd.MM.yyyy")</small> }
                        </div>
                    </div>
                    <span class="lib-col lib-kind" title="@(item.Type == "video" ? "Vidéo" : "Image")"><Ico Name="@(item.Type == "video" ? "video" : "image")" Size="20" /></span>
                    <div class="kebab" @onclick:stopPropagation="true">
                        <button type="button" class="kebab-btn" aria-label="Actions pour @item.Name" aria-haspopup="menu" aria-expanded="@(menuFor == item.Id ? "true" : "false")"
                                @onclick="() => menuFor = menuFor == item.Id ? null : item.Id"><Ico Name="dots-v" Size="18" /></button>
                        @if (menuFor == item.Id)
                        {
                            <div class="kebab-backdrop" @onclick="() => menuFor = null"></div>
                            <div class="kebab-menu" role="menu">
                                @if (MediaLibrary.IsDrive(item))
                                {
                                    <span class="kebab-note">@DriveTitle(drive). Renommez ou retirez-le dans le Drive.</span>
                                }
                                else if (CanEdit(item))
                                {
                                    <button type="button" role="menuitem" @onclick="() => OpenRename(item)"><Ico Name="edit" Size="16" /> Renommer</button>
                                }
                                else
                                {
                                    <span class="kebab-note">Dossier en lecture seule : ce fichier ne se modifie pas.</span>
                                }
                                @if (item.FileName != null) { <a role="menuitem" href="/media/@item.FileName" download="@item.Name" @onclick="() => menuFor = null"><Ico Name="download" Size="16" /> Télécharger</a> }
                                @if (!MediaLibrary.IsDrive(item) && canMove)
                                {
                                    <button type="button" role="menuitem" @onclick="() => { menuFor = null; moving = item; }"><Ico Name="move" Size="16" /> Déplacer vers une autre aire…</button>
                                }
                                @if (FoldersShown && !MediaLibrary.IsDrive(item) && CanEdit(item))
                                {
                                    <button type="button" role="menuitem" @onclick="() => { menuFor = null; folderMove = new() { (item.Id, item.Name) }; }"><Ico Name="move" Size="16" /> Ranger dans un dossier…</button>
                                }
                                @if (!MediaLibrary.IsDrive(item) && CanEdit(item))
                                {
                                    <button type="button" role="menuitem" class="danger" @onclick="() => { menuFor = null; confirmDelete = new() { item.Id }; }"><Ico Name="trash" Size="16" /> Supprimer</button>
                                }
                            </div>
                        }
                    </div>
                </div>
            </div>
        }
    </div>
}

@if (moving is { } mv)
{
    <AreaMoveDialog Kind="media" Items="new() { (mv.Id, mv.Name) }" OnClose="moved => { moving = null; if (moved) Reload(); }" />
}
@if (bulkMove)
{
    <AreaMoveDialog Kind="media" Items="files.Where(f => picked.Contains(f.Id)).Select(f => (f.Id, f.Name)).ToList()" OnClose="moved => { bulkMove = false; if (moved) Reload(); }" />
}

@if (renaming != null)
{
    <div class="modal-backdrop" @onclick="() => renaming = null"></div>
    <div class="modal" role="dialog" aria-modal="true" aria-labelledby="ren-title">
        <h3 id="ren-title">Renommer le média</h3>
        <input style="width:100%;margin-top:10px" @bind="renameValue" @bind:event="oninput" @onkeydown="OnRenameKey" aria-label="Nom du média" />
        <div class="modal-actions">
            <button class="btn ghost" @onclick="() => renaming = null">Annuler</button>
            <button class="btn" disabled="@string.IsNullOrWhiteSpace(renameValue)" @onclick="Rename">Renommer</button>
        </div>
    </div>
}

@if (confirmDelete is { Count: > 0 } del)
{
    var used = del.SelectMany(Library.UsedBy).Distinct().ToList();
    <div class="modal-backdrop" @onclick="() => confirmDelete = null"></div>
    <div class="modal" role="alertdialog" aria-modal="true" aria-labelledby="mdel-title">
        <h3 id="mdel-title">Supprimer @(del.Count > 1 ? $"{del.Count} médias" : $"« {files.FirstOrDefault(f => f.Id == del[0])?.Name} »") ?</h3>
        @if (used.Count == 0)
        {
            <p class="hint">@(del.Count > 1 ? "Ils ne sont utilisés" : "Il n'est utilisé") par aucune app. Cette action est définitive.</p>
        }
        else
        {
            <p class="hint">@(del.Count > 1 ? "Ils seront retirés" : "Il sera retiré") de : <b>@string.Join(", ", used)</b>. Les écrans concernés auront une mise à jour à publier. Cette action est définitive.</p>
        }
        <div class="modal-actions">
            <button class="btn ghost" @onclick="() => confirmDelete = null">Annuler</button>
            <button class="btn danger-solid" @onclick="Delete">Supprimer</button>
        </div>
    </div>
}

@if (cleaning && unusedCanva.Count > 0)
{
    <div class="modal-backdrop" @onclick="() => cleaning = false"></div>
    <div class="modal" role="alertdialog" aria-modal="true" aria-labelledby="mcl-title">
        <h3 id="mcl-title">Supprimer @unusedCanva.Count export@(unusedCanva.Count > 1 ? "s" : "") Canva ?</h3>
        <p class="hint">Ces fichiers viennent d'exports de designs devenus inutiles (export abandonné, contenu supprimé, remplacé par un autre export) :</p>
        <ul class="hint" style="max-height:180px;overflow:auto;margin:6px 0 0;padding-left:18px">
            @foreach (var m in unusedCanva.Take(30)) { <li>@m.Name</li> }
            @if (unusedCanva.Count > 30) { <li>… et @(unusedCanva.Count - 30) autre@(unusedCanva.Count - 30 > 1 ? "s" : "")</li> }
        </ul>
        <p class="hint">Cette action est définitive. Vous pourrez toujours exporter le design à nouveau depuis Canva.</p>
        <div class="modal-actions">
            <button class="btn ghost" @onclick="() => cleaning = false">Annuler</button>
            <button class="btn danger-solid" @onclick="CleanCanva">Supprimer</button>
        </div>
    </div>
}

@code {
    private List<MediaItem> files = new();
    private List<MediaItem> unusedCanva = new();
    private bool cleaning;
    private readonly HashSet<Guid> picked = new();
    private string filter = "", source = "", search = "", sort = "date";
    private bool showUpload;
    private string view = "cards";   // cards | list (liste : PC seulement ; sur mobile, toujours en cartes)
    private Guid? menuFor;
    private MediaItem? renaming;
    private string renameValue = "";
    private List<Guid>? confirmDelete;
    private System.Threading.Timer? refreshTimer;
    private MediaUploader? uploader;

    // Imports en cours ou en échec : affichés comme des cartes en tête de la grille, avec leur pourcentage.
    private IReadOnlyList<MediaUploader.UploadJob> Jobs => uploader?.Jobs ?? Array.Empty<MediaUploader.UploadJob>();

    // Provenance d'un fichier : téléversé ici, exporté depuis Canva, ou synchronisé depuis un dossier Drive.
    private static readonly (string Key, string Label)[] Sources =
        { ("upload", "Téléversés"), ("canva", "Canva"), ("pdf", "PDF"), ("gdrive", "Google Drive"), ("onedrive", "OneDrive") };

    private string SourceOf(MediaItem m) =>
        MediaLibrary.IsDrive(m) ? (drives.GetValueOrDefault(m.Info["drive"])?.Source == "onedrive" ? "onedrive" : "gdrive")
        : m.Info.ContainsKey("canva") ? "canva" : m.Info.ContainsKey("pdf") ? "pdf" : "upload";

    // Les compteurs de chaque filtre tiennent compte de l'autre (type × source).
    private IEnumerable<MediaItem> ByType => files.Where(m => filter == "" || m.Type == filter);
    private IEnumerable<MediaItem> BySource => files.Where(m => source == "" || SourceOf(m) == source);

    private IEnumerable<MediaItem> Visible
    {
        get
        {
            var q = ByType.Where(m => source == "" || SourceOf(m) == source)
                          .Where(m => search.Length == 0 || m.Name.Contains(search, StringComparison.OrdinalIgnoreCase));
            return sort switch
            {
                "name" => q.OrderBy(m => m.Name, StringComparer.CurrentCultureIgnoreCase),
                "size" => q.OrderByDescending(m => m.Size ?? 0),
                _ => q   // déjà triés du plus récent au plus ancien
            };
        }
    }

    protected override void OnInitialized()
    {
        Reload();
        // pendant une conversion vidéo, la liste se rafraîchit seule
        refreshTimer = new System.Threading.Timer(_ => InvokeAsync(() =>
        {
            if (files.Any(m => m.Status == "processing") || Drives.Running(Store.ClientId).Count > 0) { Reload(); StateHasChanged(); }   // import de dossier Drive : les fichiers arrivent au fil de l'eau
        }), null, 2000, 2000);
        Drives.ProgressChanged += OnDriveProgress;
    }

    private MediaItem? moving;
    private bool bulkMove;
    private bool canMove;  // administrateur de l'organisation, avec au moins une autre aire

    // ---------- Dossiers (option « Dossiers dans la médiathèque », mode expert) ----------

    private bool foldersOn, isAdmin, canCreateRoot;
    private Guid? folderId;                                   // dossier ouvert ; null : racine de l'aire
    private List<FolderRow> folderRows = new();               // dossiers vus par la personne
    private Dictionary<Guid, FolderRight> rights = new();
    private List<FolderRow> subfolders = new();               // dossiers de la position ouverte
    private List<FolderRow> crumbs = new();                   // chemin jusqu'au dossier ouvert
    private List<MediaItem> allFiles = new();                 // tous les fichiers visibles de l'aire
    private bool creatingFolder;
    private string newFolderName = "", renameFolderValue = "";
    private string? newFolderError;
    private FolderRow? renamingFolder, deletingFolder;
    private Guid? sharingId;
    private List<(Guid Id, string Name)>? folderMove;

    private bool FoldersShown => foldersOn;   // dossiers visibles en mode simple comme en mode expert
    private FolderRow? currentRow => folderId is { } id ? folderRows.FirstOrDefault(r => r.Folder.Id == id) : null;
    private bool CanCreateHere => folderId is null ? canCreateRoot : currentRow is { } c && c.Right >= FolderRight.Write;
    private bool CanUploadHere => folderId is null || currentRow is { } c && c.Right >= FolderRight.Write;
    // À la racine, tout fichier se modifie comme avant ; dans un dossier, il faut y écrire.
    private bool CanEdit(MediaItem m) => m.FolderId is not { } f || rights.GetValueOrDefault(f) >= FolderRight.Write;
    private List<(Guid Id, string Name)> pickedEditable => allFiles.Where(m => picked.Contains(m.Id) && !MediaLibrary.IsDrive(m) && CanEdit(m)).Select(m => (m.Id, m.Name)).ToList();

    private void OpenFolder(Guid? id)
    {
        folderId = id;
        picked.Clear();
        menuFor = null;
        Reload();
    }

    private void Reload()
    {
        canMove = Store.Read(d => d.Access.IsOrgAdmin && d.Area != null && d.Access.OrgAreaCount > 1);
        foldersOn = Store.Read(d => d.Tenant.FoldersOn);
        isAdmin = Store.Read(d => d.Access.IsOrgAdmin);
        canCreateRoot = Store.Read(d => FolderAccess.CanCreateAtRoot(d.Access));
        folderRows = Library.Folders();
        rights = folderRows.ToDictionary(r => r.Folder.Id, r => r.Right);
        if (!FoldersShown) folderId = null;
        else if (folderId is { } open && !rights.ContainsKey(open)) folderId = null;   // dossier retiré ou supprimé entre-temps
        allFiles = Library.Files();
        files = FoldersShown ? allFiles.Where(m => m.FolderId == folderId).ToList() : allFiles;
        // À la racine : les dossiers qui n'ont pas de parent visible. Dans un dossier : ses enfants visibles.
        subfolders = FoldersShown
            ? folderRows.Where(r => folderId is { } fid ? r.Folder.ParentId == fid : r.Folder.ParentId is not { } p || !rights.ContainsKey(p)).ToList()
            : new();
        crumbs = BuildCrumbs();
        drives = Library.DriveFolders();
        unusedCanva = Library.UnusedCanva();
        picked.IntersectWith(allFiles.Where(f => !MediaLibrary.IsDrive(f)).Select(f => f.Id));
    }

    // Éléments directs d'un dossier : ses fichiers et ses sous-dossiers visibles
    private int ChildCount(Guid id) => allFiles.Count(m => m.FolderId == id) + folderRows.Count(r => r.Folder.ParentId == id);

    private List<FolderRow> BuildCrumbs()
    {
        var list = new List<FolderRow>();
        for (var cur = currentRow; cur != null && list.Count < FolderAccess.MaxDepth; cur = cur.Folder.ParentId is { } p ? folderRows.FirstOrDefault(r => r.Folder.Id == p) : null)
            list.Insert(0, cur);
        return list;
    }

    private void CreateFolder()
    {
        var (error, _) = Library.CreateFolder(newFolderName, folderId);
        if (error != null) { newFolderError = error; return; }
        creatingFolder = false;
        Toast.Ok($"Dossier « {newFolderName.Trim()} » créé.");
        Reload();
    }

    private void RenameFolder(FolderRow rf)
    {
        var error = Library.RenameFolder(rf.Folder.Id, renameFolderValue);
        if (error != null) { newFolderError = error; return; }
        renamingFolder = null;
        Toast.Ok("Dossier renommé.");
        Reload();
    }

    private void DeleteFolder(FolderRow df)
    {
        var error = Library.DeleteFolder(df.Folder.Id);
        deletingFolder = null;
        if (error != null) { Toast.Error(error); return; }
        if (folderId == df.Folder.Id) folderId = df.Folder.ParentId;
        picked.Clear();
        Toast.Ok($"Dossier « {df.Folder.Name} » supprimé.");
        Reload();
    }

    private Dictionary<string, DriveFolder> drives = new();   // dossiers Drive, pour situer les fichiers synchronisés

    private static string DriveTitle(DriveFolder? f) => f == null ? "Synchronisé depuis un Drive"
        : $"Synchronisé depuis le dossier « {f.Name} » ({(f.Source == "onedrive" ? "OneDrive" : "Google Drive")})";

    private void Imported(MediaItem m) { Reload(); Toast.Ok(m.Status == "processing" ? $"« {m.Name} » importé, conversion en MP4 en cours." : $"« {m.Name} » importé."); }


    private void Toggle(Guid id) { if (!picked.Remove(id)) picked.Add(id); }

    // Un fichier qu'on peut sélectionner : toute la carte, sur simple appui, le coche ou le décoche.
    private bool Selectable(MediaItem m) => !MediaLibrary.IsDrive(m) && CanEdit(m);
    private void ClickCard(MediaItem m) { if (Selectable(m)) Toggle(m.Id); }

    // Glisser-déposer : un fichier, ou tous les fichiers sélectionnés, vers un dossier (ou la racine de l'aire, null)
    private List<Guid> dragIds = new();
    private Guid? dropOver;
    private bool CanDrag(MediaItem m) => FoldersShown && Selectable(m);
    private void StartDrag(MediaItem m)
    {
        dragIds = picked.Contains(m.Id) ? pickedEditable.Select(x => x.Id).ToList() : new List<Guid> { m.Id };
    }
    private void EndDrag() { dragIds = new(); dropOver = null; }
    private void DropOn(Guid? target)
    {
        var ids = dragIds.ToList();
        EndDrag();
        if (ids.Count == 0) return;
        var (moved, refused) = Library.MoveFiles(ids, target);
        if (refused.Count > 0) Toast.Error(refused[0] + (refused.Count > 1 ? $" (et {refused.Count - 1} autre{(refused.Count > 2 ? "s" : "")})" : ""));
        if (moved > 0) { picked.Clear(); Toast.Ok(moved > 1 ? $"{moved} fichiers rangés." : "Fichier rangé."); }
        Reload();
    }

    private void ToggleAll()
    {
        var vis = Visible.Where(m => !MediaLibrary.IsDrive(m) && CanEdit(m)).Select(m => m.Id).ToList();   // les fichiers Drive ne se suppriment pas d'ici, ni ceux d'un dossier en lecture seule
        if (vis.All(picked.Contains)) picked.ExceptWith(vis); else picked.UnionWith(vis);
    }

    private void OpenRename(MediaItem m) { menuFor = null; renaming = m; renameValue = m.Name; }

    private void OnRenameKey(KeyboardEventArgs e)
    {
        if (e.Key == "Enter") Rename();
        else if (e.Key == "Escape") renaming = null;
    }

    private void Rename()
    {
        if (renaming == null || string.IsNullOrWhiteSpace(renameValue)) return;
        Library.Rename(renaming.Id, renameValue);
        Toast.Ok("Média renommé.");
        renaming = null;
        Reload();
    }

    private void Delete()
    {
        if (confirmDelete == null) return;
        Library.Delete(confirmDelete);
        Toast.Ok(confirmDelete.Count > 1 ? $"{confirmDelete.Count} médias supprimés." : "Média supprimé.");
        picked.ExceptWith(confirmDelete);
        confirmDelete = null;
        Reload();
    }

    private void CleanCanva()
    {
        cleaning = false;
        var n = Library.DeleteUnusedCanva();
        Toast.Ok(n > 1 ? $"{n} exports Canva supprimés." : n == 1 ? "1 export Canva supprimé." : "Rien à supprimer.");
        Reload();
    }

    // Fin d'un import de dossier : la liste est relue aussitôt
    private void OnDriveProgress(Guid clientId)
    {
        if (clientId != Store.ClientId || Drives.Running(clientId).Count > 0) return;
        _ = InvokeAsync(() => { Reload(); StateHasChanged(); });
    }

    public void Dispose()
    {
        Drives.ProgressChanged -= OnDriveProgress;
        refreshTimer?.Dispose();
    }
}
