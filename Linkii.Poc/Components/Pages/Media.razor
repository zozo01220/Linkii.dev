@page "/media"
@attribute [Microsoft.AspNetCore.Authorization.Authorize(Policy = "Page:media")]
@implements IAsyncDisposable
@using Microsoft.JSInterop
@inject MediaLibrary Library
@inject AppService Apps
@inject DriveService Drives
@inject TenantStore Store
@inject Toaster Toast
@inject IJSRuntime JS

@* Médiathèque épurée (§51) : même squelette que les listes de lecture. Vignettes « galerie » (l'image d'abord), un clic ouvre l'aperçu
   (infos, où le média sert, actions), la case au survol sélectionne. On importe en déposant des fichiers n'importe où sur la page. *@
<div class="lx-top">
    <div class="lx-title">
    <h1>
        @if (FoldersShown && currentRow is { } cur)
        {
            <button type="button" class="lx-crumb @(dropOver == RootDrop ? "drop-target" : "")" @onclick="() => OpenFolder(null)"
                    @ondragover="() => { }" @ondragover:preventDefault="true" @ondragenter="() => { if (dragIds.Count > 0) dropOver = RootDrop; }" @ondragleave="() => { if (dropOver == RootDrop) dropOver = null; }" @ondrop:preventDefault="true" @ondrop="() => DropOn(null)">Médiathèque</button>
            @foreach (var c in crumbs.Take(crumbs.Count - 1))
            {
                var row = c;
                <span class="lx-sl">/</span>
                <button type="button" class="lx-crumb @(dropOver == row.Folder.Id ? "drop-target" : "")" @onclick="() => OpenFolder(row.Folder.Id)"
                        @ondragover="() => { }" @ondragover:preventDefault="true" @ondragenter="() => { if (dragIds.Count > 0) dropOver = row.Folder.Id; }" @ondragleave="() => { if (dropOver == row.Folder.Id) dropOver = null; }" @ondrop:preventDefault="true" @ondrop="() => DropOn(row.Folder.Id)">@row.Folder.Name</button>
            }
            <span class="lx-sl">/</span>
            <span>@cur.Folder.Name</span>
            <span class="lx-right @(cur.Right == FolderRight.Read ? "ro" : "")"><Ico Name="@(cur.Right == FolderRight.Read ? "lock" : "folder")" Size="12" /> @RightLabel(cur)</span>
            <SharePill Summary="FolderSum(cur.Folder.Id)" Long="true" Clickable="multi && cur.Right == FolderRight.Owner" ReadOnly="cur.Right == FolderRight.Read" OwnerName="@(cur.Folder.OwnerId == me ? null : cur.OwnerName)" OnClick="() => ShareFolder(cur)" />
        }
        else
        {
            <span>Médiathèque</span>
        }
        <span class="lx-cntpill" aria-label="@Plural(files.Count, "média", "médias")">@files.Count</span>
    </h1>
    <p class="sub">Vos images, vidéos et documents, importés une fois et réutilisables dans toutes vos listes de lecture.</p>
    </div>
    <span class="grow"></span>
    <div class="btns">
        @if (multi && currentRow is { Right: FolderRight.Owner } here)
        {
            <button class="btn btn-share lx-share" @onclick="() => ShareFolder(here)"><Ico Name="users" Size="16" /> Partager…</button>
        }
        @if (CanUploadHere)
        {
            @* Un seul bouton « Ajouter » (maquette mediatheque-import-boutons-page.html) : ordinateur, adresse web, cloud, nouveau dossier.
               Look « app » : le bouton est masqué, le bouton flottant reprend les mêmes choix (sources [data-fab] cachées, cliquées par app-fab.js). *@
            <div class="lx-add">
                <button class="btn lx-add-btn" aria-haspopup="menu" aria-expanded="@(newMenu ? "true" : "false")" @onclick="() => { urlOpen = false; newMenu = !newMenu; }"><Ico Name="plus" Size="16" /> Ajouter <Ico Name="chevron" Size="14" /></button>
                @if (newMenu)
                {
                    <div class="kebab-backdrop" @onclick="() => newMenu = false"></div>
                    <div class="kebab-menu lx-add-menu" role="menu">
                        <label for="@FileInputId" role="menuitem" tabindex="0" @onclick="() => newMenu = false"><Ico Name="upload" Size="18" /><span><b>Depuis l'ordinateur</b><small>@ComputerFormats</small></span></label>
                        <button type="button" role="menuitem" @onclick="OpenUrl"><Ico Name="link" Size="18" /><span><b>Depuis une adresse web</b><small>Lien direct vers une image ou une vidéo</small></span></button>
                        <button type="button" role="menuitem" @onclick="OpenCloud"><Ico Name="cloud" Size="18" /><span><b>Depuis le cloud</b><small>OneDrive, Google, Canva, Dropbox…</small></span></button>
                        @if (FoldersShown && CanCreateHere)
                        {
                            <span class="sep" role="separator"></span>
                            <button type="button" role="menuitem" @onclick="OpenNewFolder"><Ico Name="folder" Size="18" /><span><b>Nouveau dossier@(currentRow is { } cf ? $" dans « {cf.Folder.Name} »" : "")</b></span></button>
                        }
                    </div>
                }
                @if (urlOpen)
                {
                    <div class="kebab-backdrop" @onclick="() => urlOpen = false"></div>
                    <form class="lx-url-pop" role="dialog" aria-labelledby="url-title" @onsubmit="SubmitUrl" @onsubmit:preventDefault>
                        <b id="url-title">Importer depuis une adresse web</b>
                        <div class="row">
                            <input type="url" @ref="urlInput" placeholder="https://exemple.ch/affiche.jpg" @bind="urlValue" @bind:event="oninput" aria-label="Adresse web du fichier" />
                            <button type="submit" class="btn" disabled="@string.IsNullOrWhiteSpace(urlValue)">Importer</button>
                        </div>
                        <small>Lien direct vers une image ou une vidéo. Le fichier est copié dans @(currentRow is { } uf ? $"« {uf.Folder.Name} »" : "la médiathèque").</small>
                    </form>
                }
                <span class="lx-fabsrc" aria-hidden="true">
                    <label for="@FileInputId" data-fab="Depuis l'ordinateur"><Ico Name="upload" Size="16" /></label>
                    <button type="button" tabindex="-1" data-fab="Depuis une adresse web" @onclick="OpenUrl"><Ico Name="link" Size="16" /></button>
                    <button type="button" tabindex="-1" data-fab="Depuis le cloud" @onclick="OpenCloud"><Ico Name="cloud" Size="16" /></button>
                    @if (FoldersShown && CanCreateHere) { <button type="button" tabindex="-1" data-fab="Nouveau dossier" @onclick="OpenNewFolder"><Ico Name="folder" Size="16" /></button> }
                </span>
            </div>
        }
        else if (FoldersShown && CanCreateHere)
        {
            <button class="btn ghost" data-fab="Nouveau dossier" @onclick="OpenNewFolder"><Ico Name="folder" Size="16" /> Nouveau dossier</button>
        }
    </div>
</div>

@if (Tabs.Count > 1)
{
    @* Onglets (24 octobre 2026) : ses médias, ceux qu'on lui partage, et pour l'administrateur toute l'organisation. Jamais mélangés. *@
    <nav class="tabs int-tabs lx-utabs" role="tablist" aria-label="Médias affichés">
        @foreach (var t in Tabs)
        {
            var key = t.Key;
            <button type="button" role="tab" class="@(tab == key ? "on" : "")" aria-selected="@(tab == key ? "true" : "false")" @onclick="() => SetTab(key)">@t.Label@if (t.Count > 0) { <span class="cat-count">@t.Count</span> }<TabNew Family="media" Tab="@key" /></button>
        }
    </nav>
}

<div class="lx-status">
    <span class="lx-appoff">@Plural(files.Count, "média", "médias")@(TotalSize > 0 ? $" · {Helpers.FormatSize(TotalSize)}" : "")@(FoldersShown && folderId == null && folderRows.Count > 0 ? $" · {Plural(folderRows.Count, "dossier", "dossiers")}" : "")</span>
    @if (UnusedHere > 0 && filter != "unused")
    {
        <span class="lx-appoff"><i class="lx-dot off"></i>@Plural(UnusedHere, "média non utilisé", "médias non utilisés") <button type="button" class="linklike" @onclick='() => SetFilter("unused")'>Voir</button></span>
    }
    @if (currentRow is { Right: FolderRight.Read })
    {
        <span>Vous pouvez voir, télécharger et utiliser ces fichiers dans vos listes, pas les modifier.</span>
    }
    else if (CanUploadHere && (files.Count > 0 || Jobs.Count > 0))
    {
        <span class="lx-desk">Glissez des fichiers n'importe où sur la page pour les importer.</span>
    }
</div>

<DriveSyncBar />

@if (files.Count == 0 && Jobs.Count == 0 && subfolders.Count == 0 && !Active)
{
    <div class="empty">
        <div class="big">@(folderId != null ? "Ce dossier est vide" : tab == LibraryTab.Shared ? "Rien n'a encore été partagé avec vous" : "Votre médiathèque est vide")</div>
        @if (tab == LibraryTab.Shared && folderId == null) { <p>Quand un collègue vous partage un média ou un dossier, il apparaît ici. Vous pouvez l'utiliser dans vos listes de lecture.</p> }
        @if (CanUploadHere)
        {
            @if (currentRow is { } fe)
            {
                <p>Glissez ici vos images et vos vidéos depuis l'ordinateur, ou importez-les dans « @fe.Folder.Name ».</p>
            }
            else
            {
                <p>Glissez ici vos images et vos vidéos depuis l'ordinateur, ou importez-les. Elles serviront dans vos listes de lecture.</p>
            }
            @EmptyImport
        }
    </div>
}
else
{
    <section class="lx-fzone" aria-label="Dossiers">
    @* Dossiers de la position ouverte, hors du bloc des médias : forme de dossier (FolderShape) avec l'aperçu des derniers médias, cibles du glisser-déposer.
       PC : grille ; app : bande qui défile, appui long = menu (partager, renommer, supprimer). *@
    @if (subfolders.Count > 0 || (FoldersShown && CanCreateHere))
    {
        <div class="lx-fstrip lx-fgrid" role="list" aria-label="Dossiers">
            @foreach (var row in subfolders)
            {
                var r = row;
                var mine = r.Folder.OwnerId == me;
                var sum = FolderSum(r.Folder.Id);
                var recent = RecentMedia(r.Folder.Id);
                var canMenu = r.Right == FolderRight.Owner;
                <div data-nid="@r.Folder.Id" class="lx-fcard @(dropOver == r.Folder.Id ? "drop-target" : "") @(landedFolder == r.Folder.Id ? "landed" : "")" role="listitem" tabindex="0" draggable="@(r.Right == FolderRight.Owner && !inApp ? "true" : null)" @ondragstart="() => { dragFolder = r.Folder.Id; }" @ondragend="EndDrag" title="@FolderTitle(r)" aria-label="Ouvrir le dossier @r.Folder.Name"
                     @onclick="() => OpenFolder(r.Folder.Id)" @onkeydown='e => { if (e.Key == "Enter") OpenFolder(r.Folder.Id); }'
                     @ondragover="() => { }" @ondragover:preventDefault="true" @ondragenter="() => { if (dragIds.Count > 0 || (dragFolder != null && dragFolder != r.Folder.Id)) dropOver = r.Folder.Id; }" @ondragleave="() => { if (dropOver == r.Folder.Id) dropOver = null; }" @ondrop:preventDefault="true" @ondrop="() => DropOn(r.Folder.Id)"
                     @oncontextmenu="() => { if (canMenu) menuFor = r.Folder.Id; }" @oncontextmenu:preventDefault="inApp && canMenu">
                    <FolderShape Preview="recent" Count="ChildCount(r.Folder.Id)" Unit="@FolderUnit(r.Folder.Id)">
                        <Badge>
                            @if (r.Right == FolderRight.Read) { <span class="fbadge ro" title="Dossier de @r.OwnerName"><Ico Name="lock" Size="11" /> @(tab == LibraryTab.Mine ? "Lecture seule" : First(r.OwnerName))</span> }
                            else if (r.Right == FolderRight.Write) { <span class="fbadge lvl" title="Dossier de @r.OwnerName, vous pouvez le modifier"><Ico Name="users" Size="11" /> @First(r.OwnerName)</span> }
                            else if (sum.Any) { <span class="fbadge @(sum.Everyone != null ? "lvl" : "sh")"><Ico Name="users" Size="11" /> @(sum.Everyone != null ? "Partagé · tous" : $"Partagé · {sum.People}")</span> }
                            else if (!mine && tab != LibraryTab.Mine && r.Folder.OwnerId != null) { <span class="fbadge sh" title="Dossier de @r.OwnerName">@First(r.OwnerName)</span> }
                        </Badge>
                    </FolderShape>
                    <div class="fn"><span>@r.Folder.Name</span><small>@FolderDate(r)</small></div>
                    @if (canMenu)
                    {
                        <button type="button" class="fk" aria-label="Actions pour le dossier @r.Folder.Name" aria-haspopup="menu" aria-expanded="@(menuFor == r.Folder.Id ? "true" : "false")"
                                @onclick:stopPropagation="true" @onclick="() => menuFor = menuFor == r.Folder.Id ? null : r.Folder.Id"><Ico Name="dots-v" Size="16" /></button>
                    }
                    @if (menuFor == r.Folder.Id)
                    {
                        <div class="kebab-backdrop" @onclick:stopPropagation="true" @onclick="() => menuFor = null"></div>
                        <div class="kebab-menu" role="menu" @onclick:stopPropagation="true">
                            <span class="kebab-note">@r.Folder.Name · @(mine ? "votre dossier" : $"dossier de {r.OwnerName}") · @(sum.Any ? "partagé" : "non partagé")</span>
                            @if (multi) { <button type="button" role="menuitem" @onclick="() => { menuFor = null; ShareFolder(r); }"><Ico Name="users" Size="16" /> Partager…</button> }
                            @if (r.Right == FolderRight.Owner)
                            {
                                <button type="button" role="menuitem" @onclick="() => { menuFor = null; renamingFolder = r; renameFolderValue = r.Folder.Name; newFolderError = null; }"><Ico Name="edit" Size="16" /> Renommer</button>
                                @if (FoldersShown) { <button type="button" role="menuitem" @onclick="() => { menuFor = null; reparenting = (r.Folder.Id, r.Folder.Name); }"><Ico Name="move" Size="16" /> Déplacer…</button> }
                                <button type="button" role="menuitem" class="danger" @onclick="() => { menuFor = null; deletingFolder = r; }"><Ico Name="trash" Size="16" /> Supprimer</button>
                            }
                        </div>
                    }
                </div>
            }
            @if (FoldersShown && CanCreateHere)
            {
                <button type="button" class="lx-fcard add" @onclick='() => { newFolderName = ""; newFolderError = null; creatingFolder = true; }'>
                    <div class="fv"><span class="fbk"></span><span class="ffr"><Ico Name="plus" Size="22" /></span></div>
                    <div class="fn"><span>Nouveau dossier</span></div>
                </button>
            }
        </div>
    }
    </section>
    <section class="lx-blk lx-blk-main" aria-label="Médias">
        <div class="lx-bh"><Ico Name="image" Size="16" /> <span>Médias</span> <small>@Visible.Count()</small></div>
    <div class="lx-tools" role="region" aria-label="Recherche et filtres">
        <div class="search-box">
            <Ico Name="search" Size="16" />
            <input data-lx-search placeholder="Rechercher dans la médiathèque" aria-label="Rechercher des médias" @bind="search" @bind:event="oninput" />
        </div>
        @if (Active || type != "" || source != "") { <span class="lx-count" aria-live="polite">@Plural(Visible.Count(), "résultat", "résultats")</span> }
        <FilterMenu Groups="FilterGroups" Extra="@(FoldersShown && folderId != null && !scopeAll ? 1 : 0)" OnPick="PickFilter" OnReset="ResetFilters">
            <Footer>
                @if (FoldersShown && folderId != null)
                {
                    <div class="fm-note"><span>Chercher dans : @(scopeAll ? "toute l'aire" : "ce dossier")</span><button type="button" class="linklike" @onclick="() => scopeAll = !scopeAll">Changer</button></div>
                }
            </Footer>
        </FilterMenu>
        <select @bind="sort" class="tb-sort" aria-label="Trier">
            <option value="date">Récents</option>
            <option value="name">Nom</option>
            <option value="size">Taille</option>
        </select>
        <ViewToggle StorageKey="media" Photos="true" @bind-Value="view" />
    </div>
    <FilterChips Groups="FilterGroups" Extra="FilterExtras" OnClear="ClearFilter" OnResetAll="ResetFilters" />

    @if (!Visible.Any() && Jobs.Count == 0)
    {
        @if (Active || type != "" || source != "") { <div class="empty"><div class="big">Aucun média ne correspond</div><button class="btn ghost sm" @onclick='() => { search = ""; filter = ""; type = ""; source = ""; }'>Effacer la recherche et les filtres</button></div> }
        else
        {
            @* rien à cet endroit, mais des dossiers au-dessus : on le dit, avec le bouton d'import *@
            <div class="empty compact">
                <div class="big">@(currentRow is { } re ? $"Aucun média dans « {re.Folder.Name} »" : "Aucun média à la racine")</div>
                <p>@(folderId == null ? "Vos médias sont rangés dans les dossiers ci-dessus." : "Ses médias sont rangés dans les sous-dossiers ci-dessus.")@(CanUploadHere ? " Glissez ici ceux qui n'ont pas besoin de dossier, ou importez-les." : "")</p>
                @if (CanUploadHere) { @EmptyImport }
            </div>
        }
    }
    else
    {
        @if (view == "list")
        {
        <div class="lx-tbl-wrap">
            <table class="lx-tbl">
                <thead>
                    <tr>
                        <th style="width:34px"><input type="checkbox" class="sc-check lx-check" checked="@AllPicked" @onchange="ToggleAll" aria-label="Tout sélectionner" /></th>
                        <th><button type="button" class="@(sort == "name" ? "on" : "")" @onclick='() => sort = "name"'>Nom</button></th>
                        @if (FoldersShown) { <th>Emplacement</th> }
                        <th>Format</th>
                        <th class="num"><button type="button" class="@(sort == "size" ? "on" : "")" @onclick='() => sort = "size"'>Taille</button></th>
                        <th>Utilisation</th>
                        <th><button type="button" class="@(sort == "date" ? "on" : "")" @onclick='() => sort = "date"'>Importé</button></th>
                        <th style="width:44px"><span class="sr-only">Actions</span></th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var j in Jobs)
                    {
                        var job = j;
                        <tr>
                            <td></td>
                            <td><div class="nm"><span class="mini"><Ico Name="upload" Size="16" /></span><span>@job.Name</span></div></td>
                            @if (FoldersShown) { <td></td> }
                            <td colspan="4"><small>@(job.State == "error" ? job.Error ?? "Échec de l'import" : job.Total is > 0 ? $"Envoi · {MediaUploader.Pct(job)} %" : "Envoi…")</small></td>
                            <td><button type="button" class="kebab-btn" aria-label="@(job.State == "error" ? "Retirer" : "Annuler l'import de") @job.Name" @onclick="() => DismissJob(job)"><Ico Name="x" Size="16" /></button></td>
                        </tr>
                    }
                    @foreach (var m in Visible)
                    {
                        var item = m;
                        @if (Pres.Is(item))
                        {
                            <tr data-nid="@item.Id" class="@(landed.Contains(item.Id) ? "landed" : "") @(picked.Contains(item.Id) ? "picked" : "") @(dragIds.Contains(item.Id) ? "dragging" : "")" draggable="@(CanDrag(item) ? "true" : "false")" @ondragstart="() => StartDrag(item)" @ondragend="EndDrag">
                                <td>@if (Selectable(item)) { <input type="checkbox" class="sc-check lx-check" checked="@picked.Contains(item.Id)" @onchange="() => Toggle(item.Id)" aria-label="Sélectionner @item.Name" /> }</td>
                                <td><div class="nm"><span class="mini lx-pres-mini">@PresMini(item)</span><button type="button" title="@item.Name" @onclick="() => Open(item)">@item.Name</button></div></td>
                                @if (FoldersShown) { <td><small>@PathOf(item)</small></td> }
                                <td><small>@PresFormat(item)</small></td>
                                <td class="num">@(item.Size is { } ps ? Helpers.FormatSize(ps) : "—")</td>
                                <td>@if (unused.Contains(item.Id)) { <span class="lx-state"><i class="lx-dot off"></i><span>Non utilisée</span></span> } else { <span class="lx-state ok"><i class="lx-dot"></i><span>Utilisée@(PresUseCount(item) is var pc and > 0 ? $" · {Plural(pc, "contenu", "contenus")}" : "")</span></span> }</td>
                                <td><small>@(item.AddedUtc is { } pa ? pa.ToLocalTime().ToString("dd.MM.yyyy") : "—")</small></td>
                                <td>@Menu(item)</td>
                            </tr>
                            continue;
                        }
                        <tr data-nid="@item.Id" class="@(landed.Contains(item.Id) ? "landed" : "") @(picked.Contains(item.Id) ? "picked" : "") @(dragIds.Contains(item.Id) ? "dragging" : "")" draggable="@(CanDrag(item) ? "true" : "false")" @ondragstart="() => StartDrag(item)" @ondragend="EndDrag">
                            <td>@if (Selectable(item)) { <input type="checkbox" class="sc-check lx-check" checked="@picked.Contains(item.Id)" @onchange="() => Toggle(item.Id)" aria-label="Sélectionner @item.Name" /> }</td>
                            <td><div class="nm"><span class="mini">@if (item.Status == null) { <MediaThumb Media="item" /> } else { <Ico Name="@(item.Status == "failed" ? "x" : "hourglass")" Size="16" /> }</span><button type="button" title="@item.Name" @onclick="() => Open(item)">@item.Name</button>@ShareBadge(item, "ph-sharei")</div></td>
                            @if (FoldersShown) { <td><small>@PathOf(item)</small></td> }
                            <td><small>@(item.Type == "video" ? "Vidéo" : "Image")@(MediaProbe.Label(item) is { } fmt ? " · " + fmt : "")@(SourceLabel(item) is { } src ? " · " + src : "")</small></td>
                            <td class="num">@(item.Size is { } s ? Helpers.FormatSize(s) : "—")</td>
                            <td>@if (item.Status == "failed") { <span class="lx-state bad"><i class="lx-dot bad"></i><span>Échec</span></span> } else if (unused.Contains(item.Id)) { <span class="lx-state"><i class="lx-dot off"></i><span>Non utilisé</span></span> } else { <span class="lx-state ok"><i class="lx-dot"></i><span>Utilisé</span></span> }</td>
                            <td><small>@(item.AddedUtc is { } a ? a.ToLocalTime().ToString("dd.MM.yyyy") : "—")</small></td>
                            <td>@Menu(item)</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
        }
        @if (view == "photos")
        {
            @* Vue « photos » : mosaïque serrée groupée par jour d'import ; pastille ronde pour sélectionner (appui long dans l'app) ; état d'usage en simple point. *@
            <div class="ph @(picked.Count > 0 ? "ph-selecting" : "")">
                @if (Jobs.Count > 0)
                {
                    <div class="ph-day"><span>Envoi en cours <small>@Jobs.Count</small></span></div>
                    <div class="ph-grid">
                        @foreach (var j in Jobs)
                        {
                            var job = j;
                            var failed = job.State == "error";
                            <div class="ph-t up @(failed ? "fail" : "")" title="@job.Name">
                                @if (failed) { <span class="ph-msg"><Ico Name="x" Size="18" />@(job.Error ?? "Échec")</span> }
                                else { <span class="ph-msg">@(job.Note != null ? "Conversion…" : job.Total is > 0 ? $"{MediaUploader.Pct(job)} %" : "Envoi…")</span><span class="ph-bar" style="width:@(MediaUploader.Pct(job))%"></span> }
                                <button type="button" class="ph-x" aria-label="@(failed ? "Retirer" : "Annuler l'import de") @job.Name" @onclick="() => DismissJob(job)"><Ico Name="x" Size="14" /></button>
                            </div>
                        }
                    </div>
                }
                @foreach (var g in PhotoGroups)
                {
                    var grp = g;
                    var selectable = grp.Items.Where(Selectable).ToList();
                    var allIn = selectable.Count > 0 && selectable.All(x => picked.Contains(x.Id));
                    @if (grp.Label != null)
                    {
                        <div class="ph-day">
                            @if (selectable.Count > 0) { <button type="button" class="ph-dayck @(allIn ? "on" : "")" aria-label="Sélectionner tout « @grp.Label »" aria-pressed="@(allIn ? "true" : "false")" @onclick="() => ToggleGroup(selectable)"><Ico Name="check" Size="13" /></button> }
                            <span>@grp.Label <small>@grp.Items.Count</small></span>
                        </div>
                    }
                    <div class="ph-grid">
                        @foreach (var m in grp.Items)
                        {
                            var item = m;
                            var failed = item.Status == "failed";
                            @if (Pres.Is(item))
                            {
                                <div data-nid="@item.Id" class="ph-t lx-pres @(landed.Contains(item.Id) ? "landed" : "") @(picked.Contains(item.Id) ? "picked" : "") @(dragIds.Contains(item.Id) ? "dragging" : "")" style="--r:@PhotoRatio(item)"
                                     role="button" tabindex="0" title="@item.Name" aria-label="Ouvrir la présentation @item.Name" @onclick="e => ClickCard(item, e)" @onkeydown='e => { if (e.Key == "Enter") Open(item); }'
                                     @oncontextmenu="() => LongPress(item)" @oncontextmenu:preventDefault="inApp"
                                     draggable="@(CanDrag(item) ? "true" : "false")" @ondragstart="() => StartDrag(item)" @ondragend="EndDrag">
                                    @PresFace(item)
                                </div>
                                continue;
                            }
                            <div data-nid="@item.Id" class="ph-t @(landed.Contains(item.Id) ? "landed" : "") @(picked.Contains(item.Id) ? "picked" : "") @(failed ? "fail" : "") @(dragIds.Contains(item.Id) ? "dragging" : "")" style="--r:@PhotoRatio(item)"
                                 role="button" tabindex="0" title="@item.Name" aria-label="Aperçu de @item.Name" @onclick="e => ClickCard(item, e)" @onkeydown='e => { if (e.Key == "Enter") Open(item); }'
                                 @oncontextmenu="() => LongPress(item)" @oncontextmenu:preventDefault="inApp"
                                 draggable="@(CanDrag(item) ? "true" : "false")" @ondragstart="() => StartDrag(item)" @ondragend="EndDrag">
                                @if (item.Status == "processing") { <span class="ph-msg"><span class="spinner-lg"></span>Conversion…</span> }
                                else if (failed) { <span class="ph-msg"><Ico Name="x" Size="18" />@(item.Error ?? "Import en échec")</span> }
                                else { <MediaThumb Media="item" /> }
                                @if (Selectable(item)) { <input type="checkbox" class="sc-check lx-check" checked="@picked.Contains(item.Id)" @onclick:stopPropagation="true" @onchange="() => Toggle(item.Id)" aria-label="Sélectionner @item.Name" /> }
                                @if (!failed && item.Status == null)
                                {
                                    @if (item.Type == "video") { <span class="ph-dur"><Ico Name="play" Size="10" />@(Seconds(item) is { } sec ? Helpers.FormatDuration(sec) : "")</span> }
                                    @if (SourceLabel(item) is { } psrc) { <span class="lx-src" title="@(MediaLibrary.IsDrive(item) ? DriveTitle(DriveOf(item)) : null)">@if (MediaLibrary.IsDrive(item)) { <Ico Name="folder" Size="11" /> }@psrc</span> }
                                    <span class="ph-use @(unused.Contains(item.Id) ? "no" : "")" title="@(unused.Contains(item.Id) ? "Non utilisé" : "Utilisé dans une liste")"></span>
                                    @ShareBadge(item, "ph-share")
                                }
                            </div>
                        }
                    </div>
                }
            </div>
        }
        else
        {
        @* sur mobile, toujours en cartes (pas de bascule) *@
        <div class="lx-mgrid @(picked.Count > 0 ? "lx-selecting" : "") @(view == "list" ? "lx-mobile-only" : "")">
            @foreach (var j in Jobs)
            {
                var job = j;
                var failed = job.State == "error";
                <div class="lx-mc @(failed ? "fail" : "up")">
                    <div class="th">
                        @if (failed) { <Ico Name="x" Size="22" /><span>@(job.Error ?? "Échec de l'import")</span><div class="acts"><button type="button" @onclick="() => DismissJob(job)">Retirer</button></div> }
                        else
                        {
                            <span class="pct">@(job.Note != null ? "…" : job.Total is > 0 ? $"{MediaUploader.Pct(job)} %" : Helpers.FormatSize(job.Done))</span>
                            <span class="bar" style="width:@(MediaUploader.Pct(job))%"></span>
                            <button type="button" class="kebab-btn x" aria-label="Annuler l'import de @job.Name" title="Annuler" @onclick="() => DismissJob(job)"><Ico Name="x" Size="15" /></button>
                        }
                    </div>
                    <div class="nm" title="@job.Name">@job.Name</div>
                    <div class="mt">@(failed ? "Échec de l'import" : job.Note != null ? job.Note : job.Total is > 0 ? $"Envoi · {Helpers.FormatSize(job.Done)} / {Helpers.FormatSize(job.Total.Value)}" : "Envoi…")</div>
                </div>
            }
            @foreach (var m in Visible)
            {
                var item = m;
                var failed = item.Status == "failed";
                @if (Pres.Is(item))
                {
                    @* présentation : l'aperçu seul (nom au centre de la première diapositive), pastilles dans l'aperçu, pas de légende dessous *@
                    <div data-nid="@item.Id" class="lx-mc lx-pres @(landed.Contains(item.Id) ? "landed" : "") @(picked.Contains(item.Id) ? "picked" : "") @(openId == item.Id ? "open" : "") @(dragIds.Contains(item.Id) ? "dragging" : "")"
                         role="button" tabindex="0" aria-label="Ouvrir la présentation @item.Name" @onclick="e => ClickCard(item, e)" @onkeydown='e => { if (e.Key == "Enter") Open(item); }'
                         draggable="@(CanDrag(item) ? "true" : "false")" @ondragstart="() => StartDrag(item)" @ondragend="EndDrag">
                        <div class="th">@PresFace(item)</div>
                    </div>
                    continue;
                }
                <div data-nid="@item.Id" class="lx-mc @(landed.Contains(item.Id) ? "landed" : "") @(picked.Contains(item.Id) ? "picked" : "") @(failed ? "fail" : "") @(openId == item.Id ? "open" : "") @(dragIds.Contains(item.Id) ? "dragging" : "")"
                     role="button" tabindex="0" aria-label="Aperçu de @item.Name" @onclick="e => ClickCard(item, e)" @onkeydown='e => { if (e.Key == "Enter") Open(item); }'
                     draggable="@(CanDrag(item) ? "true" : "false")" @ondragstart="() => StartDrag(item)" @ondragend="EndDrag">
                    <div class="th">
                        @if (item.Status == "processing") { <span class="spinner-lg"></span><small>Conversion en MP4…</small> }
                        else if (failed)
                        {
                            <Ico Name="x" Size="22" /><span title="@item.Error">@(item.Error ?? "Import en échec")</span>
                            @if (CanDel(item)) { <div class="acts" @onclick:stopPropagation="true"><button type="button" @onclick="() => confirmDelete = new() { item.Id }">Retirer</button></div> }
                        }
                        else { <MediaThumb Media="item" /> }
                        @if (Selectable(item)) { <input type="checkbox" class="sc-check lx-check" checked="@picked.Contains(item.Id)" @onclick:stopPropagation="true" @onchange="() => Toggle(item.Id)" aria-label="Sélectionner @item.Name" /> }
                        @if (!failed && item.Status == null)
                        {
                            @if (SourceLabel(item) is { } src) { <span class="lx-src" title="@(MediaLibrary.IsDrive(item) ? DriveTitle(DriveOf(item)) : null)">@if (MediaLibrary.IsDrive(item)) { <Ico Name="folder" Size="11" /> }@src</span> }
                            @if (item.Type == "video") { <span class="lx-badge"><Ico Name="play" Size="11" />@(Seconds(item) is { } s ? Helpers.FormatDuration(s) : "")</span> }
                            @if (unused.Contains(item.Id)) { <span class="lx-unused">Non utilisé</span> }
                            @ShareBadge(item, "ph-share")
                        }
                    </div>
                    <div class="nm" title="@item.Name">@if (FoldersShown && item.FolderId is { } fid && rights.GetValueOrDefault(fid) == FolderRight.Read) { <Ico Name="lock" Size="12" /> }@item.Name</div>
                    <div class="mt">@(ShowPath ? PathOf(item) : Details(item))</div>
                </div>
            }
        </div>
        }
    }
    </section>

    @if (picked.Count > 0)
    {
        <div class="lx-selbar" role="region" aria-label="Sélection">
            <b>@picked.Count sélectionné@(picked.Count > 1 ? "s" : "")</b>
            <button type="button" @onclick="ToggleAll">@(AllPicked ? "Tout désélectionner" : $"Tout sélectionner ({Visible.Count(Selectable)})")</button>
            <span class="vr"></span>
            @if (pickedShareable.Count > 0) { <button type="button" @onclick="() => { sharingKind = ShareKind.Media; sharingMedia = pickedShareable; }"><Ico Name="share" Size="15" /><span class="lx-lbl">Partager…</span></button> }
            @if (FoldersShown) { <button type="button" disabled="@(pickedEditable.Count == 0)" @onclick="() => folderMove = pickedEditable"><Ico Name="folder" Size="15" /><span class="lx-lbl">Ranger…</span></button> }
            <span class="vr"></span>
            <button type="button" class="del" @onclick="() => confirmDelete = pickedOwn.Select(x => x.Id).ToList()"><Ico Name="trash" Size="15" /> Supprimer</button>
            <span class="vr"></span>
            <button type="button" title="Tout désélectionner (Échap)" aria-label="Tout désélectionner" @onclick="() => picked.Clear()"><Ico Name="x" Size="15" /></button>
        </div>
    }
}

@* Import : le champ de fichiers caché (menu « Ajouter »), le tiroir « Depuis le cloud » et le voile de dépôt restent dans la page, fermés,
   pour que les imports continuent et que les fichiers déposés se lisent depuis leur champ. *@
@if (CanUploadHere)
{
    <MediaUploader InputId="@FileInputId" OnImported="Imported" ShowJobs="false" Changed="StateHasChanged" @ref="uploader" FolderId="folderId" />
    <div style="@(showUpload ? "" : "display:none")">
        @* tiroir qui vient du bas, de la même largeur que l'assistant d'ajout d'intégration (.cw-top) : les sources cloud seulement *@
        <div class="modal-backdrop" @onclick="() => showUpload = false"></div>
        <div class="imp-bottom lx-import" role="dialog" aria-modal="true" aria-labelledby="imp-title">
            <div class="imp-head">
                <h3 id="imp-title">Importer depuis le cloud<small>Chaque page d'un document devient une image, rangée dans une présentation du dossier « …_médias ».</small></h3>
                <button type="button" class="modal-x" aria-label="Fermer" @onclick="() => showUpload = false"><Ico Name="x" Size="20" /></button>
            </div>
            <div class="imp-body">
                <DocumentImporter OnImported="DocumentImported" />
            </div>
            <div class="imp-foot"><span>Une fois le compte connecté, on revient ici et la tuile est déverrouillée.</span><button class="btn ghost" @onclick="() => showUpload = false">Fermer</button></div>
        </div>
    </div>
    <div class="lx-dropzone @(dragging ? "on" : "")" aria-hidden="@(dragging ? "false" : "true")">
        <Ico Name="upload" Size="40" />
        <span>Déposez pour importer@(currentRow is { } f2 ? $" dans « {f2.Folder.Name} »" : " dans la médiathèque")</span>
        <small>Images (JPG, PNG, GIF, WEBP, SVG), vidéos (MP4, MOV, AVI, MKV…)@(LocalDocuments.FormatsText(Apps.IsInstalled) is { Length: > 0 } dropDocs ? $" et documents ({dropDocs})" : "") · 2 Go maximum par fichier</small>
        <InputFile OnChange="OnDropped" multiple aria-label="Fichiers à importer" />
    </div>
}

@if (open is { } om)
