    // Menu « Filtres » : type, utilisation, source (la source seulement s'il y en a plusieurs)
    private IReadOnlyList<FilterGroup> FilterGroups
    {
        get
        {
            var list = new List<FilterGroup>
            {
                new("type", "Type", type, new FilterOption[] { new("", "Tous"), new("image", "Images", BySource.Count(m => m.Type == "image")), new("video", "Vidéos", BySource.Count(m => m.Type == "video")) }),
                new("use", "Utilisation", filter, new FilterOption[] { new("", "Tous"), new("unused", "Non utilisés", Pool.Count(m => unused.Contains(m.Id)), "Dans aucune liste de lecture, aucun contenu et sur aucun écran") }),
            };
            if (Sources.Count(s => Pool.Any(m => SourceOf(m) == s.Key)) > 1 || source != "")
                list.Add(new("source", "Source", source, new[] { new FilterOption("", "Toutes") }
                    .Concat(Sources.Select(s => (s.Key, s.Label, N: ByType.Count(m => SourceOf(m) == s.Key))).Where(s => s.N > 0 || source == s.Key).Select(s => new FilterOption(s.Key, s.Label, s.N))).ToList()));
            return list;
        }
    }
    private IReadOnlyList<FilterExtra> FilterExtras => FoldersShown && folderId != null && !scopeAll ? new[] { new FilterExtra("Dans : ce dossier", () => scopeAll = true) } : Array.Empty<FilterExtra>();
    private void PickFilter((string Key, string Value) p)
    {
        switch (p.Key) { case "type": type = p.Value; break; case "use": SetFilter(p.Value); break; case "source": source = p.Value; break; }
    }
    private void ClearFilter(string key) => PickFilter((key, ""));
    private void ResetFilters() { type = ""; source = ""; scopeAll = true; SetFilter(""); }

    private void Reload()
    {
        foldersOn = Store.Read(d => d.Tenant.FoldersOn);
        isAdmin = Store.Read(d => d.Access.IsOrgAdmin);
        canCreateRoot = Store.Read(d => FolderAccess.CanCreateAtRoot(d.Access, LevelPages.Media));
        canWrite = Store.Read(d => d.Access.CanWrite(LevelPages.Media));
        (me, multi, readAll, people, mediaShares, folderShares) = Store.Read(d => (d.Access.UserId, d.Users.Count(u => !u.Disabled) > 1,
            !d.Access.IsOrgAdmin && d.Access.ModeOf(LevelPages.Media) == PageMode.Read, d.Users.ToDictionary(u => u.Id, u => u.Label),
            ItemShareOps.Summaries(d, ShareKind.Media), ItemShareOps.Summaries(d, ShareKind.MediaFolder)));
        folderRows = Library.Folders();
        rights = folderRows.ToDictionary(r => r.Folder.Id, r => r.Right);
        if (!FoldersShown) folderId = null;
        else if (folderId is { } open && !rights.ContainsKey(open)) folderId = null;   // dossier retiré ou supprimé entre-temps
        allFiles = Library.Entries();
        fileTabs = Library.FileTabs();
        fileRights = Library.FileRights();
        covers = Library.PresentationCovers();
        presUses = Library.PresentationUseCounts();

        // Onglets : seul dans l'organisation ou en lecture seule, tout est affiché ; un utilisateur a ses médias et ses partages ; l'administrateur, en plus, toute l'organisation
        if (!multi || readAll) tab = LibraryTab.All;
        else if (tab == LibraryTab.All && !isAdmin) tab = LibraryTab.Mine;
        bool InTab(string t, MediaItem m) => fileTabs.TryGetValue(m.Id, out var i) ? LibraryTab.InTab(t, i, me, isAdmin) : t == LibraryTab.All;
        (HashSet<Guid> Folders, List<MediaItem> Files) Scope(string t)
        {
            var fs = LibraryTab.Folders(t, folderRows.Select(r => (r.Folder.Id, r.Folder.ParentId, r.Tab)), me, isAdmin);
            return (fs, allFiles.Where(m => InTab(t, m) || m.FolderId is { } f && fs.Contains(f)).ToList());
        }
        (tabFolders, scopeFiles) = Scope(tab);
        // à la racine d'un onglet : les fichiers hors de ses dossiers, et les dossiers dont le parent n'en fait pas partie ; dans un dossier : tout ce qu'il contient
        files = !FoldersShown ? scopeFiles
            : folderId == null ? scopeFiles.Where(m => m.FolderId is not { } f || !tabFolders.Contains(f)).ToList()
            : allFiles.Where(m => m.FolderId == folderId).ToList();
        subfolders = FoldersShown
            ? folderRows.Where(r => folderId is { } fid ? r.Folder.ParentId == fid : tabFolders.Contains(r.Folder.Id) && (r.Folder.ParentId is not { } p || !tabFolders.Contains(p))).ToList()
            : new();
        var sharedRoots = 0;
        if (multi && !readAll)
        {
            var (sf, sfiles) = Scope(LibraryTab.Shared);
            sharedRoots = folderRows.Count(r => sf.Contains(r.Folder.Id) && (r.Folder.ParentId is not { } p || !sf.Contains(p))) + sfiles.Count(m => m.FolderId is not { } f || !sf.Contains(f));
        }
        Tabs = !multi || readAll ? new()
            : new List<TabItem> { new(LibraryTab.Mine, "Mes médias", 0), new(LibraryTab.Shared, "Partagés avec moi", sharedRoots) }
                .Concat(isAdmin ? [new TabItem(LibraryTab.All, "Toute l'organisation", 0)] : Array.Empty<TabItem>()).ToList();
        crumbs = BuildCrumbs();
        drives = Library.DriveFolders();
        unused = Library.UnusedIds();
        unused.ExceptWith(allFiles.Where(m => m.Status == "failed").Select(m => m.Id));   // un import en échec est signalé comme tel, pas comme « non utilisé »
        picked.IntersectWith(allFiles.Where(Selectable).Select(f => f.Id));
        if (openId is { } oid && allFiles.All(m => m.Id != oid)) openId = null;
        newVia = BuildNewVia();
    }

    // Rebond de ce qui est nouveau (§116) : un média ou un dossier hors de la vue fait rebondir le dossier de la vue qui y mène
    private Dictionary<Guid, Guid> newVia = new();
    private Dictionary<Guid, Guid> BuildNewVia()
    {
        var via = new Dictionary<Guid, Guid>();
        if (!FoldersShown) return via;
        var cache = new Dictionary<Guid, Guid?>();
        Guid? Child(Guid f) { if (!cache.TryGetValue(f, out var c)) cache[f] = c = FolderChildOnPath(f); return c; }
        var inView = files.Select(m => m.Id).ToHashSet();
        foreach (var m in allFiles)
            if (!inView.Contains(m.Id) && m.FolderId is { } f && Child(f) is { } c) via[m.Id] = c;
        foreach (var r in folderRows)
            if (Child(r.Folder.Id) is { } c2 && c2 != r.Folder.Id) via[r.Folder.Id] = c2;
        return via;
    }

    // Éléments directs d'un dossier : ses fichiers et ses sous-dossiers visibles
    private int ChildCount(Guid id) => allFiles.Count(m => m.FolderId == id) + folderRows.Count(r => r.Folder.ParentId == id);

    private string FolderUnit(Guid id) => FolderShape.UnitFor(allFiles.Count(m => m.FolderId == id), folderRows.Count(r => r.Folder.ParentId == id), "média", "médias");

    // Sous le nom du dossier : le dernier média ajouté, sinon sa création
    private string FolderDate(FolderRow r)
    {
        var last = allFiles.Where(m => m.FolderId == r.Folder.Id && m.AddedUtc != null).Max(m => m.AddedUtc);
        var d = (last ?? r.Folder.CreatedUtc).ToLocalTime();
        return (last != null ? "modifié le " : "créé le ") + d.ToString(d.Year == DateTime.Now.Year ? "d MMM" : "d MMM yyyy", Fr);
    }

    private List<FolderRow> BuildCrumbs()
    {
        var list = new List<FolderRow>();
        for (var cur = currentRow; cur != null && list.Count < FolderAccess.MaxDepth; cur = cur.Folder.ParentId is { } p ? folderRows.FirstOrDefault(r => r.Folder.Id == p) : null)
            list.Insert(0, cur);
        return list;
    }

    // Emplacement d'un fichier : chemin de son dossier, ou la racine de l'aire (fichier Drive : son dossier Drive)
    private string PathOf(MediaItem m)
    {
        if (MediaLibrary.IsDrive(m)) return DriveOf(m) is { } df ? $"Drive « {df.Name} »" : "Drive";
        if (m.FolderId is not { } fid || folderRows.FirstOrDefault(r => r.Folder.Id == fid) is not { } row) return !multi ? "Médiathèque" : SharedBy(m) is { } ow ? $"Médias de {ow}" : "Mes médias";
        var names = new List<string>();
        for (var cur = row; cur != null && names.Count < FolderAccess.MaxDepth; cur = cur.Folder.ParentId is { } pid ? folderRows.FirstOrDefault(r => r.Folder.Id == pid) : null)
            names.Insert(0, cur.Folder.Name);
        return string.Join(" › ", names);
    }

