    private int jobsAtOpen;

    // Imports en cours ou en échec : affichés comme des vignettes en tête de la grille, avec leur pourcentage.
    private IReadOnlyList<MediaUploader.UploadJob> Jobs => uploader?.Jobs ?? Array.Empty<MediaUploader.UploadJob>();

    // Provenance d'un fichier : téléversé ici, exporté depuis Canva, ou synchronisé depuis un dossier Drive.
    private static readonly (string Key, string Label)[] Sources =
        { ("upload", "Téléversés"), ("canva", "Canva"), ("pdf", "PDF"), ("gdrive", "Google Drive"), ("onedrive", "OneDrive") };

    private string SourceOf(MediaItem m) =>
        MediaLibrary.IsDrive(m) ? (DriveOf(m)?.Source == "onedrive" ? "onedrive" : "gdrive")
        : m.Info.ContainsKey("canva") ? "canva" : m.Info.ContainsKey("pdf") ? "pdf" : "upload";

    private string? SourceLabel(MediaItem m) => SourceOf(m) switch { "onedrive" => "OneDrive", "gdrive" => "Drive", "canva" => "Canva", "pdf" => "PDF", _ => null };

    private DriveFolder? DriveOf(MediaItem m) => MediaLibrary.IsDrive(m) ? drives.GetValueOrDefault(m.Info["drive"]) : null;

    // Recherche et « Non utilisés » regardent toute l'aire (chemin affiché sous chaque résultat), comme les listes de lecture ; les types et sources filtrent ce qu'on voit.
    private bool Active => search.Length > 0 || filter != "";
    private bool ShowPath => FoldersShown && Active && scopeAll;
    private IEnumerable<MediaItem> Pool => ShowPath ? allFiles : files;

    // Les compteurs de chaque filtre tiennent compte de l'autre (type × source).
    private IEnumerable<MediaItem> ByType => Pool.Where(m => type == "" || m.Type == type);
    private IEnumerable<MediaItem> BySource => Pool.Where(m => source == "" || SourceOf(m) == source);

    private IEnumerable<MediaItem> Visible
    {
        get
        {
            var q = ByType.Where(m => source == "" || SourceOf(m) == source)
                          .Where(m => filter != "unused" || unused.Contains(m.Id))
                          .Where(m => search.Length == 0 || m.Name.Contains(search, StringComparison.OrdinalIgnoreCase));
            return sort switch
            {
                "name" => q.OrderBy(m => m.Name, StringComparer.CurrentCultureIgnoreCase),
                "size" => q.OrderByDescending(m => m.Size ?? 0),
                _ => q   // déjà triés du plus récent au plus ancien
            };
        }
    }

    private long TotalSize => files.Sum(m => m.Size ?? 0);
    private int UnusedHere => Pool.Count(m => unused.Contains(m.Id));

    protected override void OnInitialized()
    {
        Reload();
        // pendant une conversion vidéo, la liste se rafraîchit seule
        refreshTimer = new System.Threading.Timer(_ => InvokeAsync(() =>
        {
            if (allFiles.Any(m => m.Status == "processing") || Drives.Running(Store.ClientId).Count > 0) { Reload(); StateHasChanged(); }   // import de dossier Drive : les fichiers arrivent au fil de l'eau
        }), null, 2000, 2000);
        Drives.ProgressChanged += OnDriveProgress;
    }

    private MediaItem? moving;
    private bool bulkMove;
    private bool canMove;  // administrateur de l'organisation, avec au moins une autre aire

    // ---------- Dossiers (option « Dossiers dans la médiathèque ») ----------

    private bool foldersOn, isAdmin, canCreateRoot, canWrite;   // canWrite : accès « Voir et modifier » à la médiathèque (éléments hors dossier)
    private Guid? folderId;                                   // dossier ouvert ; null : racine de l'aire
    private List<FolderRow> folderRows = new();               // dossiers vus par la personne
    private Dictionary<Guid, FolderRight> rights = new();
    private Dictionary<Guid, FolderAudience> audiences = new();   // personnes qui ont accès à chaque dossier (icône Partage)
    private FolderAudience AudienceOf(Guid folder) => audiences.GetValueOrDefault(folder, FolderAudience.None);
    private List<FolderRow> subfolders = new();               // dossiers de la position ouverte
    private List<FolderRow> crumbs = new();                   // chemin jusqu'au dossier ouvert
    private List<MediaItem> allFiles = new();                 // tous les fichiers visibles de l'aire
    private bool creatingFolder;
    private string newFolderName = "", renameFolderValue = "";
    private string? newFolderError;
    private FolderRow? renamingFolder, deletingFolder;
    private Guid? sharingId;
    private List<(Guid Id, string Name)>? folderMove;
    private static readonly Guid RootDrop = Guid.Empty;       // cible « racine » du glisser-déposer (fil d'Ariane)

    private bool FoldersShown => foldersOn;   // dossiers visibles en mode simple comme en mode expert
    private FolderRow? currentRow => folderId is { } id ? folderRows.FirstOrDefault(r => r.Folder.Id == id) : null;
    private bool CanCreateHere => folderId is null ? canCreateRoot : currentRow is { } c && c.Right >= FolderRight.Write;
    private bool CanUploadHere => folderId is null ? canWrite : currentRow is { } c && c.Right >= FolderRight.Write;
    // À la racine, tout fichier se modifie comme avant ; dans un dossier, il faut y écrire.
    private bool CanEdit(MediaItem m) => m.FolderId is not { } f ? canWrite : rights.GetValueOrDefault(f) >= FolderRight.Write;
    private List<(Guid Id, string Name)> pickedEditable => allFiles.Where(m => picked.Contains(m.Id) && Selectable(m)).Select(m => (m.Id, m.Name)).ToList();
    private MediaItem? open => openId is { } id ? allFiles.FirstOrDefault(m => m.Id == id) : null;
    private List<MediaItem> OpenList => Visible.ToList();

    private void OpenFolder(Guid? id)
    {
        folderId = id;
        picked.Clear();
        menuFor = null; openId = null; scopeAll = true;
        Reload();
        _ = SetDrop();
    }

    private void SetFilter(string f) { filter = f; picked.Clear(); }

    // Menu « Filtres » : type, utilisation, source (la source seulement s'il y en a plusieurs)
    private IReadOnlyList<FilterGroup> FilterGroups
    {
        get
        {
            var list = new List<FilterGroup>
            {
                new("type", "Type", type, new FilterOption[] { new("", "Tous"), new("image", "Images", BySource.Count(m => m.Type == "image")), new("video", "Vidéos", BySource.Count(m => m.Type == "video")) }),
                new("use", "Utilisation", filter, new FilterOption[] { new("", "Tous"), new("unused", "Non utilisés", Pool.Count(m => unused.Contains(m.Id)), "Dans aucune liste de lecture, aucun contenu et sur aucun écran") }),
            };
            if (Sources.Count(s => Pool.Any(m => SourceOf(m) == s.Key)) > 1 || source != "")
                list.Add(new("source", "Source", source, new[] { new FilterOption("", "Toutes") }
                    .Concat(Sources.Select(s => (s.Key, s.Label, N: ByType.Count(m => SourceOf(m) == s.Key))).Where(s => s.N > 0 || source == s.Key).Select(s => new FilterOption(s.Key, s.Label, s.N))).ToList()));
            return list;
        }
    }
    private IReadOnlyList<FilterExtra> FilterExtras => FoldersShown && folderId != null && !scopeAll ? new[] { new FilterExtra("Dans : ce dossier", () => scopeAll = true) } : Array.Empty<FilterExtra>();
    private void PickFilter((string Key, string Value) p)
    {
        switch (p.Key) { case "type": type = p.Value; break; case "use": SetFilter(p.Value); break; case "source": source = p.Value; break; }
    }
    private void ClearFilter(string key) => PickFilter((key, ""));
    private void ResetFilters() { type = ""; source = ""; scopeAll = true; SetFilter(""); }

    private void Reload()
    {
        canMove = Store.Read(d => d.Access.IsOrgAdmin && d.Area != null && d.Access.OrgAreaCount > 1);
        foldersOn = Store.Read(d => d.Tenant.FoldersOn);
        isAdmin = Store.Read(d => d.Access.IsOrgAdmin);
        canCreateRoot = Store.Read(d => FolderAccess.CanCreateAtRoot(d.Access, LevelPages.Media));
        canWrite = Store.Read(d => d.Access.CanWrite(LevelPages.Media));
        folderRows = Library.Folders();
        rights = folderRows.ToDictionary(r => r.Folder.Id, r => r.Right);
        audiences = foldersOn ? Library.Audiences() : new();
        if (!FoldersShown) folderId = null;
        else if (folderId is { } open && !rights.ContainsKey(open)) folderId = null;   // dossier retiré ou supprimé entre-temps
        allFiles = Library.Files();
        files = FoldersShown ? allFiles.Where(m => m.FolderId == folderId).ToList() : allFiles;
        // À la racine : les dossiers qui n'ont pas de parent visible. Dans un dossier : ses enfants visibles.
        subfolders = FoldersShown
            ? folderRows.Where(r => folderId is { } fid ? r.Folder.ParentId == fid : r.Folder.ParentId is not { } p || !rights.ContainsKey(p)).ToList()
            : new();
        crumbs = BuildCrumbs();
        drives = Library.DriveFolders();
        unused = Library.UnusedIds();
        unused.ExceptWith(allFiles.Where(m => m.Status == "failed").Select(m => m.Id));   // un import en échec est signalé comme tel, pas comme « non utilisé »
        picked.IntersectWith(allFiles.Where(Selectable).Select(f => f.Id));
        if (openId is { } oid && allFiles.All(m => m.Id != oid)) openId = null;
    }

    // Éléments directs d'un dossier : ses fichiers et ses sous-dossiers visibles
    private int ChildCount(Guid id) => allFiles.Count(m => m.FolderId == id) + folderRows.Count(r => r.Folder.ParentId == id);

    private List<FolderRow> BuildCrumbs()
    {
        var list = new List<FolderRow>();
        for (var cur = currentRow; cur != null && list.Count < FolderAccess.MaxDepth; cur = cur.Folder.ParentId is { } p ? folderRows.FirstOrDefault(r => r.Folder.Id == p) : null)
            list.Insert(0, cur);
        return list;
    }

    // Emplacement d'un fichier : chemin de son dossier, ou la racine de l'aire (fichier Drive : son dossier Drive)
    private string PathOf(MediaItem m)
    {
        if (MediaLibrary.IsDrive(m)) return DriveOf(m) is { } f ? $"Drive « {f.Name} »" : "Drive";
        if (m.FolderId is not { } fid || folderRows.FirstOrDefault(r => r.Folder.Id == fid) is not { } row) return "Médiathèque de l'aire";
        var names = new List<string>();
        for (var cur = row; cur != null && names.Count < FolderAccess.MaxDepth; cur = cur.Folder.ParentId is { } pid ? folderRows.FirstOrDefault(r => r.Folder.Id == pid) : null)
            names.Insert(0, cur.Folder.Name);
        return string.Join(" › ", names);
    }

    private static string Details(MediaItem m)
    {
        if (m.Status == "processing") return "Conversion en cours";
        if (m.Status == "failed") return "Échec de l'import";
        var parts = new List<string>();
        if (m.Width is > 0) parts.Add(m.Type == "video" ? MediaProbe.Label(m)! : $"{m.Width}×{m.Height}");
        if (m.Size is { } s) parts.Add(Helpers.FormatSize(s));
        return parts.Count > 0 ? string.Join(" · ", parts) : (m.Type == "video" ? "Vidéo" : "Image");
    }

    private static int? Seconds(MediaItem m) => int.TryParse(m.Info.GetValueOrDefault("durationSec"), out var s) && s > 0 ? s : null;

    private string RightLabel(FolderRow r) =>
        r.Folder.OwnerId == Store.UserId ? (r.Shared ? "Votre dossier" : "Votre dossier · privé")
        : r.Right switch
        {
            FolderRight.Read => $"Lecture seule · dossier de {r.OwnerName}",
            FolderRight.Write => $"Écriture · dossier de {r.OwnerName}",
            _ => $"Administrateur · dossier de {r.OwnerName}"
        };

    private string FolderTitle(FolderRow r) => (r.Folder.OwnerId == Store.UserId ? "Votre dossier" : $"Dossier de {r.OwnerName}") + (r.Right == FolderRight.Read ? " · lecture seule" : r.Shared ? " · partagé" : " · privé");

    private static string Plural(int n, string one, string many) => $"{n} {(n > 1 ? many : one)}";

    private RenderFragment Menu(MediaItem item) => __builder =>
    {
        <div class="kebab">
            <button type="button" class="kebab-btn" aria-label="Actions pour @item.Name" aria-haspopup="menu" aria-expanded="@(menuFor == item.Id ? "true" : "false")"
                    @onclick="() => menuFor = menuFor == item.Id ? null : item.Id"><Ico Name="dots-v" Size="18" /></button>
            @if (menuFor == item.Id)
            {
                <div class="kebab-backdrop" @onclick="() => menuFor = null"></div>
                <div class="kebab-menu" role="menu">
                    <button type="button" role="menuitem" @onclick="() => { menuFor = null; Open(item); }"><Ico Name="eye" Size="16" /> Aperçu et utilisations</button>
                    @if (Own(item)) { <button type="button" role="menuitem" @onclick="() => OpenRename(item)"><Ico Name="edit" Size="16" /> Renommer</button> }
                    @if (item.FileName != null) { <a role="menuitem" href="/media/@item.FileName" download="@item.Name" @onclick="() => menuFor = null"><Ico Name="download" Size="16" /> Télécharger</a> }
                    @if (FoldersShown && Selectable(item)) { <button type="button" role="menuitem" @onclick="() => { menuFor = null; folderMove = new() { (item.Id, item.Name) }; }"><Ico Name="folder" Size="16" /> Ranger dans un dossier…</button> }
                    @if (canMove && Own(item)) { <button type="button" role="menuitem" @onclick="() => { menuFor = null; moving = item; }"><Ico Name="move" Size="16" /> Déplacer vers une autre aire…</button> }
                    @if (Own(item)) { <button type="button" role="menuitem" class="danger" @onclick="() => { menuFor = null; confirmDelete = new() { item.Id }; }"><Ico Name="trash" Size="16" /> Supprimer</button> }
                </div>
            }
        </div>
    };

    private void CreateFolder()
    {
        var (error, _) = Library.CreateFolder(newFolderName, folderId);
        if (error != null) { newFolderError = error; return; }
        creatingFolder = false;
        Toast.Ok($"Dossier « {newFolderName.Trim()} » créé.");
        Reload();
    }

    private void RenameFolder(FolderRow rf)
    {
        var error = Library.RenameFolder(rf.Folder.Id, renameFolderValue);
        if (error != null) { newFolderError = error; return; }
        renamingFolder = null;
        Toast.Ok("Dossier renommé.");
        Reload();
    }

    private void DeleteFolder(FolderRow df)
    {
        var error = Library.DeleteFolder(df.Folder.Id);
        deletingFolder = null;
        if (error != null) { Toast.Error(error); return; }
        if (folderId == df.Folder.Id) folderId = df.Folder.ParentId;
        picked.Clear();
        Toast.Ok($"Dossier « {df.Folder.Name} » supprimé.");
        Reload();
    }

    private Dictionary<string, DriveFolder> drives = new();   // dossiers Drive, pour situer les fichiers synchronisés

    private static string DriveTitle(DriveFolder? f) => f == null ? "Synchronisé depuis un Drive"
        : $"Synchronisé depuis le dossier « {f.Name} » ({(f.Source == "onedrive" ? "OneDrive" : "Google Drive")})";

    // ---------- Import ----------

    private void OpenImport() { jobsAtOpen = Jobs.Count; showUpload = true; }

    private void Imported(MediaItem m) { Reload(); Toast.Ok(m.Status == "processing" ? $"« {m.Name} » importé, conversion en MP4 en cours." : $"« {m.Name} » importé."); }

    // Dès qu'un import démarre, la fenêtre se ferme : la progression s'affiche dans la grille.
    private void UploadChanged()
    {
        if (showUpload && Jobs.Count > jobsAtOpen) showUpload = false;
        StateHasChanged();
    }

    private async Task OnDropped(InputFileChangeEventArgs e)
    {
        dragging = false;
        jobsAtOpen = Jobs.Count;
        if (uploader != null) await uploader.AddFiles(e);
    }

    private void DismissJob(MediaUploader.UploadJob job)
    {
        if (job.State == "running") uploader?.Cancel(job); else uploader?.Dismiss(job);
    }

    // ---------- Sélection et aperçu ----------

    private void Toggle(Guid id) { if (!picked.Remove(id)) picked.Add(id); }

    // Un fichier qu'on peut sélectionner : ni synchronisé depuis un Drive, ni dans un dossier en lecture seule.
    // sélectionnable / rangeable : ses fichiers, et les fichiers Drive (qu on peut ranger dans un dossier mais ni renommer ni supprimer ici)
    private bool Selectable(MediaItem m) => CanEdit(m) && (FoldersShown || !MediaLibrary.IsDrive(m));
    private bool Own(MediaItem m) => !MediaLibrary.IsDrive(m) && CanEdit(m);
    private List<(Guid Id, string Name)> pickedOwn => allFiles.Where(m => picked.Contains(m.Id) && Own(m)).Select(m => (m.Id, m.Name)).ToList();

    // Clic : aperçu ; en cours de sélection (ou Ctrl/Maj + clic) : coche ou décoche.
    private void ClickCard(MediaItem m, MouseEventArgs e)
    {
        if ((picked.Count > 0 || e.CtrlKey || e.MetaKey || e.ShiftKey) && Selectable(m)) Toggle(m.Id);
        else Open(m);
    }

    private void LongPress(MediaItem m) { if (inApp && Selectable(m)) Toggle(m.Id); }
    private void ToggleGroup(List<MediaItem> items)
    {
        if (items.All(x => picked.Contains(x.Id))) foreach (var x in items) picked.Remove(x.Id);
        else foreach (var x in items) picked.Add(x.Id);
    }

    // Vue photos : groupes par jour d'import (tri « récents »), sinon une seule suite sans en-tête
    private static readonly System.Globalization.CultureInfo Fr = new("fr-FR");
    private IEnumerable<(string? Label, List<MediaItem> Items)> PhotoGroups
    {
        get
        {
            if (sort != "date") { yield return (null, Visible.ToList()); yield break; }
            var today = DateTime.Now.Date;
            foreach (var g in Visible.GroupBy(m => m.AddedUtc is { } a ? a.ToLocalTime().Date : (DateTime?)null))
            {
                var label = g.Key is not { } d ? "Plus ancien" : d == today ? "Aujourd'hui" : d == today.AddDays(-1) ? "Hier" : Fr.TextInfo.ToTitleCase(d.ToString(d.Year == today.Year ? "dddd d MMMM" : "d MMMM yyyy", Fr));
                yield return (label, g.ToList());
            }
        }
    }
    private static string PhotoRatio(MediaItem m) =>
        (m.Width is > 0 && m.Height is > 0 ? Math.Clamp(m.Width.Value / (double)m.Height.Value, 0.55, 2.2) : 1.5).ToString("0.###", System.Globalization.CultureInfo.InvariantCulture);

    private void Open(MediaItem m) { menuFor = null; openId = m.Id; }

    [JSInvokable]
    public Task StepFromKey(int delta) => InvokeAsync(() => { Step(delta); StateHasChanged(); });

    private void Step(int delta)
    {
        var list = OpenList;
        var i = list.FindIndex(x => x.Id == openId);
        if (i >= 0 && i + delta >= 0 && i + delta < list.Count) openId = list[i + delta].Id;
    }

    // Glisser-déposer : un fichier, ou tous les fichiers sélectionnés, vers un dossier (ou la racine de l'aire, null)
    private List<Guid> dragIds = new();
    private Guid? dropOver;
    private bool CanDrag(MediaItem m) => FoldersShown && Selectable(m);
    private void StartDrag(MediaItem m)
    {
        dragIds = picked.Contains(m.Id) ? pickedEditable.Select(x => x.Id).ToList() : new List<Guid> { m.Id };
    }
    private void EndDrag() { dragIds = new(); dropOver = null; }
    private void DropOn(Guid? target)
    {
        var ids = dragIds.ToList();
        EndDrag();
        if (ids.Count == 0) return;
        var (moved, refused) = Library.MoveFiles(ids, target);
        if (refused.Count > 0) Toast.Error(refused[0] + (refused.Count > 1 ? $" (et {refused.Count - 1} autre{(refused.Count > 2 ? "s" : "")})" : ""));
        if (moved > 0) { picked.Clear(); Toast.Ok(moved > 1 ? $"{moved} fichiers rangés." : "Fichier rangé."); }
        Reload();
    }

    private bool AllPicked => Visible.Any(Selectable) && Visible.Where(Selectable).All(m => picked.Contains(m.Id));

    private void ToggleAll()
    {
        var vis = Visible.Where(Selectable).Select(m => m.Id).ToList();   // les fichiers Drive ne se suppriment pas d'ici, ni ceux d'un dossier en lecture seule
        if (vis.All(picked.Contains)) picked.ExceptWith(vis); else picked.UnionWith(vis);
    }

    private void OpenRename(MediaItem m) { menuFor = null; renaming = m; renameValue = m.Name; }

    private void OnRenameKey(KeyboardEventArgs e)
    {
        if (e.Key == "Enter") Rename();
        else if (e.Key == "Escape") renaming = null;
    }

    private void Rename()
    {
        if (renaming == null || string.IsNullOrWhiteSpace(renameValue)) return;
        Library.Rename(renaming.Id, renameValue);
        Toast.Ok("Média renommé.");
        renaming = null;
        Reload();
    }

    private void Delete()
    {
        if (confirmDelete == null) return;
        Library.Delete(confirmDelete);
        var asked = confirmDelete.Count;
        Toast.Ok(asked > 1 ? $"{asked} médias supprimés." : "Média supprimé.");
        picked.ExceptWith(confirmDelete);
        if (openId is { } oid && confirmDelete.Contains(oid)) openId = null;
        confirmDelete = null;
        Reload();
    }

    // Fin d'un import de dossier : la liste est relue aussitôt
    private void OnDriveProgress(Guid clientId)
    {
        if (clientId != Store.ClientId || Drives.Running(clientId).Count > 0) return;
        _ = InvokeAsync(() => { Reload(); StateHasChanged(); });
    }

    // ---------- Clavier et dépôt de fichiers (library.js) ----------
    private DotNetObjectReference<Media>? selfRef;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender) return;
        selfRef = DotNetObjectReference.Create(this);
        try { inApp = await JS.InvokeAsync<bool>("linkiiPrefs.isApp"); } catch (JSException) { } catch (InvalidOperationException) { }
        try { await JS.InvokeVoidAsync("linkiiLibrary.attach", selfRef, CanUploadHere); } catch (JSException) { } catch (InvalidOperationException) { }
    }

    private async Task SetDrop()
    {
        try { await JS.InvokeVoidAsync("linkiiLibrary.setDrop", CanUploadHere); } catch (JSException) { } catch (InvalidOperationException) { }
    }

    [JSInvokable]
    public Task Escape() => InvokeAsync(() =>
    {
        if (menuFor != null) menuFor = null;
        else if (showUpload) showUpload = false;
        else if (openId != null) openId = null;
        else if (picked.Count > 0) picked.Clear();
        else return;
        StateHasChanged();
    });

    [JSInvokable]
    public Task Drag(bool on) => InvokeAsync(() =>
    {
        if (dragIds.Count > 0 || dragging == on) return;   // glisser interne (vers un dossier) : pas de voile
        dragging = on && CanUploadHere;
        StateHasChanged();
    });

    public async ValueTask DisposeAsync()
    {
        Drives.ProgressChanged -= OnDriveProgress;
        refreshTimer?.Dispose();
        if (selfRef == null) return;
        try { await JS.InvokeVoidAsync("linkiiLibrary.detach", selfRef); } catch (JSException) { } catch (JSDisconnectedException) { } catch (InvalidOperationException) { }
        selfRef.Dispose();
    }
}
