    private static string PermName(AccountPermission p) => p.Label.Split(" (")[0];

    private static string SinceLine(ConnectedAccount a) =>
        a.Detail.Length > 0 ? a.Detail
        : a.Since is { } since ? $"Connecté le {since.ToLocalTime():dd.MM.yyyy}" : "";

    private static string ReconnectUrl(ConnectedAccount a) => ConnectedAccounts.ConnectUrl(a.Id, ConnectedAccounts.ReconnectPurpose(a));

    /// <summary>Types de comptes proposés par « Connecter un compte » : ceux qui ne sont pas encore là.</summary>
    private IEnumerable<ConnectedAccounts.KindDef> Addable => ConnectedAccounts.Kinds.Where(k => k.Id != ConnectedAccounts.Canva && accounts.All(a => a.Id != k.Id));

    private bool Available(string kind) => kind switch
    {
        ConnectedAccounts.Microsoft => MsAuth.IsConfigured,
        ConnectedAccounts.Google => GoogleAuth.IsConfigured,
        ConnectedAccounts.Canva => canvaReady,
        ConnectedAccounts.Dropbox => DropboxAuth.IsConfigured,
        ConnectedAccounts.Facebook => FacebookAuth.IsConfigured,
        _ => true
    };

    private void StartConnect(string kind)
    {
        addMenu = false;
        if (kind is ConnectedAccounts.Microsoft or ConnectedAccounts.Google) { wantCalendars = wantFiles = true; connectKind = kind; return; }
        if (kind == ConnectedAccounts.HomeAssistant) { haOpen = true; return; }   // connexion saisie dans sa fenêtre
        if (ConnectedAccounts.IsDriveForm(kind)) { driveSource = kind; return; }   // Nextcloud, SFTP : la connexion se saisit dans la fenêtre du Drive (activé une fois testée)
        connectingServer = kind;   // CalDAV ou Exchange : la connexion se saisit dans la fenêtre de la source
        calSource = kind;
    }

    /// <summary>« Modifier la connexion » d'un serveur : la fenêtre de sa source (agendas, ou Drive pour Nextcloud et SFTP).</summary>
    private void EditConnection(string kind)
    {
        if (ConnectedAccounts.IsDriveForm(kind)) driveSource = kind;
        else if (kind == ConnectedAccounts.HomeAssistant) haOpen = true;
        else calSource = kind;
    }

    /// <summary>Le compte se gère dans la carte de son intégration (menu ⋮ › Reconnecter ou changer de compte) : on ouvre l'assistant à l'étape Connexion.</summary>
    private void ShowAccount(string kind)
    {
        calSource = driveSource = null;
        var ids = ConnectedAccounts.Kind(kind).Integrations.Where(HasWizard).ToList();
        if ((ids.FirstOrDefault(InMineId) ?? ids.FirstOrDefault()) is { } id) OpenWizard(id, 1, !InMineId(id));
    }

    private bool inApp;   // look « app » : appui long = menu du compte

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            try { inApp = await JS.InvokeAsync<bool>("linkiiPrefs.isApp"); if (inApp) StateHasChanged(); } catch (JSException) { } catch (InvalidOperationException) { }
        }
        if (revealPending && flashInt is { } fi)
        {
            revealPending = false;
            try { await JS.InvokeVoidAsync("linkiiPrefs.reveal", "cat-" + fi); } catch (JSException) { } catch (InvalidOperationException) { }
            await Task.Delay(1800);
            if (flashInt == fi) { flashInt = null; StateHasChanged(); }
            return;
        }
        if (!focusPending || flash == null || !accRefs.TryGetValue(flash, out var el)) return;
        focusPending = false;
        try { await el.FocusAsync(); } catch (InvalidOperationException) { return; /* carte pas encore affichée */ }
        // la mise en évidence s'efface après un instant (sauf si un autre compte a été montré entre-temps)
        var shown = flash;
        await Task.Delay(1800);
        if (flash == shown) { flash = null; StateHasChanged(); }
    }

    private async Task Disconnect()
    {
        var id = disconnectId;
        disconnectId = null;
        var name = AccountOf(id!)?.Kind ?? "";
        switch (id)
        {
            case ConnectedAccounts.Microsoft: MsAuth.Disconnect(Store.ClientId); break;
            case ConnectedAccounts.Google: await GoogleAuth.Disconnect(Store.ClientId); break;
            case ConnectedAccounts.Canva: Canva.Disconnect(Store.ClientId); break;
            case ConnectedAccounts.Dropbox: await DropboxAuth.Disconnect(Store.ClientId); break;
            case ConnectedAccounts.Facebook: FacebookAuth.Disconnect(Store.ClientId); break;
            case ConnectedAccounts.Nextcloud or ConnectedAccounts.Sftp: Store.Write(d => d.Tenant.DriveAccounts.RemoveAll(x => x.Source == id)); break;
            case ConnectedAccounts.HomeAssistant: Store.Write(d => { d.Tenant.HomeAssistant = null; }); break;
            default:
                Store.Write(d =>
                {
                    if (d.Tenant.CalendarAccounts.FirstOrDefault(x => x.Source == id) is { } a)
                    {
                        a.Url = ""; a.User = ""; a.Secret = ""; a.Label = ""; a.LastError = ""; a.CheckedUtc = null;
                    }
                });
                break;
        }
        Load();
        Toast.Ok($"{name} déconnecté. Ses contenus ne sont plus mis à jour.");
    }

    // ---------- Chargement et bascules ----------

    protected override void OnInitialized()
    {
        admin = Store.Read(d => d.Access.IsOrgAdmin);
        Load();
        CanvaReturn();
        GoogleReturn();
        MicrosoftReturn();
        DropboxReturn();
        FacebookReturn();
    }

    private void Load()
    {
        enabled = Svc.Installed().Select(a => a.AppId).ToHashSet();
        added = Store.Read(d => d.Tenant.IntegrationsAdded.ToHashSet());
        counts = Store.Read(d => d.Media.Where(m => m.AppId != null).GroupBy(m => m.AppId!).ToDictionary(g => g.Key, g => g.Count()));
        tenant = Store.Read(d => d.Tenant);
        accounts = ConnectedAccounts.Of(tenant);
        canvaAcc = accounts.FirstOrDefault(a => a.Id == ConnectedAccounts.Canva);   // le compte Canva se gère dans la carte de l'intégration, pas dans Comptes connectés
        accounts.RemoveAll(a => a.Id == ConnectedAccounts.Canva);
        canvaReady = Canva.IsConfigured;
    }

    // Enregistré immédiatement : seul le choix proposé dans les listes de lecture change, les écrans ne sont pas concernés.
    private void Toggle(CatalogView.Entry a)
    {
        var on = !enabled.Contains(a.Id);
        if (Svc.Find(a.Id) is not { DefaultOn: true }) Svc.Mark(a.Id);   // désactivée, elle reste dans Mes intégrations
        if (on) Svc.Enable(a.Id); else Svc.Disable(a.Id);
        var n = counts.GetValueOrDefault(a.Id);
        Toast.Ok(on ? $"« {a.Name} » activée : elle est proposée dans les listes de lecture."
                    : $"« {a.Name} » désactivée.{(n > 0 ? $" Ses {n} contenu{(n > 1 ? "s" : "")} restent diffusé{(n > 1 ? "s" : "")}." : "")}");
        Load();
    }

    // Source de calendriers : ses calendriers sont proposés (ou non) pour les nouveaux contenus ; les contenus existants restent diffusés.
    private void ToggleSource(string src)
    {
        var def = SharedCalendarSources.Find(src)!;
        var on = !SharedCalendarSources.Enabled(tenant, src);
        if (on && src == "google" && !GoogleAuth.IsConfigured) { Toast.Error("Google Calendar n'est pas encore disponible sur cette plateforme (connexion Google à configurer sur le serveur)."); return; }
        if (on && src == "m365" && !MsAuth.IsConfigured) { Toast.Error("Microsoft 365 n'est pas encore disponible sur cette plateforme (connexion Microsoft à configurer sur le serveur)."); return; }
        Svc.Mark("cal-" + src);
        Svc.SetCalendarSource(src, on);
        Load();
        if (on && !SharedCalendarSources.Configured(tenant, src)) { if (HasWizard("cal-" + src)) OpenWizard("cal-" + src, 1, false); else calSource = src; Toast.Ok($"« {def.Name} » activée : configurez sa connexion."); }
        else Toast.Ok(on ? $"« {def.Name} » activée : ses calendriers sont proposés dans les listes de lecture." : $"« {def.Name} » désactivée. Les contenus existants restent diffusés.");
    }

    // Source Drive : ses dossiers sont proposés et synchronisés, ou non ; les contenus existants restent diffusés (fichiers du moment).
    private void ToggleDrive(string src)
    {
        var def = DriveSources.Find(src)!;
        var on = !DriveSources.Enabled(tenant, src);
        if (on && src == "gdrive" && !GoogleAuth.IsConfigured) { Toast.Error("Google Drive n'est pas encore disponible sur cette plateforme (connexion Google à configurer sur le serveur)."); return; }
        if (on && src == "onedrive" && !MsAuth.IsConfigured) { Toast.Error("OneDrive et SharePoint ne sont pas encore disponibles sur cette plateforme (connexion Microsoft à configurer sur le serveur)."); return; }
        if (on && src == "dropbox" && !DropboxAuth.IsConfigured) { Toast.Error("Dropbox n'est pas encore disponible sur cette plateforme (connexion Dropbox à configurer sur le serveur)."); return; }
        Svc.Mark("drv-" + src);
        Svc.SetDriveSource(src, on);
        Load();
        if (on && !DriveSources.Configured(tenant, src)) { OpenWizard("drv-" + src, 1, false); Toast.Ok($"« {def.Name} » activée : configurez sa connexion."); }
        else Toast.Ok(on ? $"« {def.Name} » activée : ses dossiers sont proposés dans les listes de lecture." : $"« {def.Name} » désactivée. Les contenus existants restent diffusés.");
    }

    // Serveur CalDAV ou Exchange ajouté depuis « Connecter un compte » : sa source est activée dès que la connexion est enregistrée.
    private void CalendarChanged()
    {
        Load();
        if (connectingServer is { } src && accounts.Any(a => a.Id == src))
        {
            if (!SharedCalendarSources.Enabled(tenant, src)) { Svc.SetCalendarSource(src, true); Load(); }
            connectingServer = null;
        }
    }

