    private bool Enabled(string integrationId) =>
        integrationId.StartsWith("cal-") ? SharedCalendarSources.Enabled(tenant, integrationId[4..])
        : integrationId.StartsWith("drv-") ? DriveSources.Enabled(tenant, integrationId[4..])
        : enabled.Contains(integrationId);

    private string IntegrationName(string integrationId) =>
        integrationId == "ha-home" ? "Home Assistant"
        : integrationId.StartsWith("cal-") ? SharedCalendarSources.Find(integrationId[4..])?.Name ?? integrationId
        : integrationId.StartsWith("drv-") ? DriveSources.Find(integrationId[4..])?.Name ?? integrationId
        : Svc.Catalog.FirstOrDefault(a => a.Id == integrationId)?.Name ?? integrationId;

    /// <summary>Microsoft et Google : l'intégration qui demande cet accès (agendas, fichiers).</summary>
    private static string IntegrationFor(string kind, string purpose) => ConnectedAccounts.Kind(kind).Integrations[purpose == AccountPurposes.Calendar ? 0 : 1];

    private string UsageText(string integrationId)
    {
        if (integrationId.StartsWith("cal-"))
        {
            var n = tenant.SharedCalendars.Count(c => c.Source == integrationId[4..]);
            return n == 0 ? "Aucun calendrier" : $"{n} calendrier{(n > 1 ? "s" : "")}";
        }
        if (integrationId.StartsWith("drv-"))
        {
            var n = tenant.DriveFolders.Count(f => f.Source == integrationId[4..]);
            return n == 0 ? "Aucun dossier" : $"{n} dossier{(n > 1 ? "s" : "")}";
        }
        var c = counts.GetValueOrDefault(integrationId);
        return c == 0 ? "Aucun contenu" : $"{c} contenu{(c > 1 ? "s" : "")}";
    }

    private void Manage(string integrationId)
    {
        if (integrationId.StartsWith("cal-")) calSource = integrationId[4..];
        else if (integrationId.StartsWith("drv-")) driveSource = integrationId[4..];
        else if (integrationId == "canva") cvOpen = true;
    }

