    {
        calSource = null;
        connectingServer = null;
        EndUse();
    }

    private void CloseDrive() { driveSource = null; EndUse(); }
    private void CloseHa() { haOpen = false; EndUse(); }
    private void CloseCanva() => CloseWizard();
