    /// <summary>Intégrations qui s'ajoutent par l'assistant (compte connecté, étapes Connexion › contenu › Import).</summary>
    private static string Initials(string user) => user.Trim().Length == 0 ? "?" : string.Concat(user.Split([' ', '@', '.'], StringSplitOptions.RemoveEmptyEntries).Take(2).Select(p => char.ToUpperInvariant(p[0])));

    private static string ManageLabel(string id) => id == "canva" || id.StartsWith("drv-") ? "Gérer les dossiers…" : id.StartsWith("cal-") ? "Gérer les calendriers…"
        : id == "facebook" ? "Voir les Pages…" : id == "ha-home" ? "Voir les entités…" : "Voir les fichiers…";

    /// <summary>Intégrations qui copient du contenu dans la médiathèque : « Resynchroniser maintenant ».</summary>
    private static bool HasSync(string id) => id == "canva" || id.StartsWith("drv-");

    private string CurrentAccount(string id) => ConnectedAccounts.For(id) is { } k ? AccountOf(k)?.User ?? "" : "";

    private void Resync(string id)
    {
        var clientId = Store.ClientId;
        var areaId = Store.AreaId;
        if (id == "canva") foreach (var f in tenant.CanvaFolders) { var fid = f.Id; _ = Task.Run(() => Canva.SyncFolder(clientId, fid, areaId)); }
        else foreach (var f in tenant.DriveFolders.Where(f => f.Source == id[4..])) { var fid = f.Id; _ = Task.Run(() => Drives.Sync(clientId, fid)); }
        Toast.Ok("Synchronisation lancée : les fichiers arrivent dans la médiathèque.");
    }

    private static bool HasWizard(string id) => id == "canva" || id.StartsWith("drv-") || id is "cal-google" or "cal-m365" or "cal-caldav" or "cal-ews" or "google-slides" or "google-docs" or "ms-powerpoint" or "facebook" or "ha-home";

    private void OpenWizard(string id, int step, bool adding) { pendingUse = null; wizId = id; wizStep = step; wizAdding = adding; }

    private bool InMineId(string id) => AllRows().Any(r => r.E.Id == id && InMine(r));

    /// <summary>Une autre intégration de Mes intégrations utilise le même compte (Google, Microsoft) : annuler un ajout ne le déconnecte pas.</summary>
    private bool AccountShared(string id) => ConnectedAccounts.For(id) is { } k && ConnectedAccounts.Kind(k).Integrations.Any(i => i != id && InMineId(i));
    private void CloseAppDrawer() { appDrawer = null; EndUse(); }

    /// <summary>Plateforme sans connexion au fournisseur (identifiants de l'application à configurer par l'administrateur Linkii) : null si l'intégration est utilisable.</summary>
    private string? Unavailable(CatalogView.Entry e)
    {
        var kind = ConnectedAccounts.For(e.Id);
        // Facebook reste utilisable avec un jeton collé à la main
        return kind == null || kind == ConnectedAccounts.Facebook || Available(kind) ? null
            : $"« {e.Name} » n'est pas encore disponible sur cette plateforme (connexion {ConnectedAccounts.Kind(kind).Name} à configurer sur le serveur).";
    }

    /// <summary>
    /// Bouton « Utiliser » du Store : l'intégration entre dans Mes intégrations et son tiroir de configuration s'ouvre.
    /// Avec ou sans succès de la configuration, elle y reste : en rouge tant que son compte ou sa connexion n'est pas en ordre.
    /// </summary>
    private void Use(CatalogView.Entry e)
    {
        if (Unavailable(e) is { } why) { Toast.Error(why); return; }
        if (HasWizard(e.Id)) { OpenWizard(e.Id, 1, true); return; }   // n'entre dans Mes intégrations qu'au lancement de l'import
        pendingUse = e.Id;
        if (CalSource(e) is { } cal)
        {
            Svc.Mark(e.Id);
            if (!SharedCalendarSources.Enabled(tenant, cal)) { Svc.SetCalendarSource(cal, true); Load(); }
            calSource = cal;
        }
        else if (DrvSource(e) is { } drv)
        {
            Svc.Mark(e.Id);
            if (!DriveSources.Enabled(tenant, drv)) { Svc.SetDriveSource(drv, true); Load(); }
            driveSource = drv;
        }
        else if (e.Id == "ha-home") { Svc.Mark(e.Id); haOpen = true; }
        else
        {
            Svc.Mark(e.Id);
            Svc.Enable(e.Id);
            Load();
            if (e.Id == "canva") { wizStep = 1; cvOpen = true; } else appDrawer = e.Id;
        }
    }

    /// <summary>« Gérer » / « Corriger » d'une carte de Mes intégrations : le tiroir de sa configuration.</summary>
    private void OpenFor(CatalogView.Entry e)
    {
        pendingUse = null;
        if (HasWizard(e.Id)) OpenWizard(e.Id, 2, false);
        else if (CalSource(e) is { } cal) calSource = cal;
        else appDrawer = e.Id;
    }

    /// <summary>Tiroir d'un « Utiliser » refermé : on montre l'intégration dans Mes intégrations, sans regarder si la configuration a réussi.</summary>
    private void EndUse()
    {
        Load();
        if (pendingUse is not { } id) return;
        pendingUse = null;
        tab = "mine"; filter = string.Empty; search = string.Empty;
        flashInt = id; revealPending = true;
    }

    private void RetireApp(AppManifest m)
    {
        appDrawer = null;
        Svc.Disable(m.Id);
        Svc.Unmark(m.Id);
        Load();
        Toast.Ok($"« {m.Name} » retirée de Mes intégrations : elle est de nouveau dans le Store. Ses contenus restent diffusés.");
    }

    // ---------- Retours de connexion ----------

    // Retour de la connexion Canva (/canva/callback) : résultat affiché, et l'intégration activée si besoin.
    private void CanvaReturn()
    {
        var q = System.Web.HttpUtility.ParseQueryString(new Uri(Nav.Uri).Query)["canva"];
        switch (q)
        {
            case "ok":
                var user = AccountOf(ConnectedAccounts.Canva)?.User;
                Toast.Ok($"Canva connecté{(user is { Length: > 0 } ? $" ({user})" : "")}.");
                wizAdding = !enabled.Contains("canva"); wizStep = 2; cvOpen = true;
                break;
            case "denied": Toast.Error("Connexion à Canva annulée."); break;
            case "expired": Toast.Error("La demande de connexion à Canva a expiré. Recommencez."); break;
            case "error": Toast.Error("Canva a refusé la connexion. Réessayez dans un instant."); break;
            case "unconfigured": Toast.Error("La connexion Canva n'est pas encore configurée sur cette plateforme."); break;
        }
    }

    /// <summary>
    /// Connexion Google ou Microsoft réussie : les intégrations dont l'accès a été accordé sont activées.
    /// Lancée depuis une intégration : sa fenêtre est rouverte pour ajouter des agendas ou des dossiers ; depuis Comptes connectés : le compte est montré.
    /// </summary>
    private string? WizParam => System.Web.HttpUtility.ParseQueryString(new Uri(Nav.Uri).Query)["wiz"];

    private void Connected(string kind, string purpose, string user, string calendarSource, string driveSourceId, bool hasCalendars, bool hasFiles)
    {
        Load();
        var name = ConnectedAccounts.Kind(kind).Name;
        var granted = string.Join(" et ", new[] { hasCalendars ? "agendas" : null, hasFiles ? "fichiers" : null }.OfType<string>());
        Toast.Ok($"Compte {name} connecté{(user.Length > 0 ? $" ({user})" : "")}{(granted.Length > 0 ? $" : {granted} autorisés" : "")}.");
        if (accountsTab) ShowAccount(kind);
        else if (WizParam is { } w && HasWizard(w)) OpenWizard(w, 2, !InMineId(w));
        else if (purpose == AccountPurposes.Calendar) OpenWizard("cal-" + calendarSource, 2, !InMineId("cal-" + calendarSource));
        else if (purpose != AccountPurposes.Calendar) OpenWizard("drv-" + driveSourceId, 2, !InMineId("drv-" + driveSourceId));
    }

    // Retour de « Se connecter avec Google » (/google/callback) : Google Calendar, Google Drive ou les deux (Comptes connectés).
    private void GoogleReturn()
    {
        var query = System.Web.HttpUtility.ParseQueryString(new Uri(Nav.Uri).Query);
        var q = query["google"];
        if (q == null) return;
        var purpose = AccountPurposes.Parse(query["for"]);
        switch (q)
        {
            case "ok":
                Connected(ConnectedAccounts.Google, purpose, tenant.GoogleUser, "google", "gdrive",
                          GoogleAuth.Has(tenant, GoogleAuth.CalendarScope), GoogleAuth.Has(tenant, GoogleAuth.DriveScope));
                break;
            case "denied": Toast.Error("Connexion à Google annulée."); break;
            case "scope": Toast.Error(purpose switch
            {
                AccountPurposes.Calendar => "L'accès à vos agendas n'a pas été autorisé : reconnectez-vous en cochant l'accès à Google Calendar.",
                AccountPurposes.Drive => "L'accès à Google Drive n'a pas été autorisé : reconnectez-vous en cochant l'accès à vos fichiers Drive.",
                _ => "Aucun accès n'a été autorisé : reconnectez-vous en cochant l'accès à vos agendas ou à vos fichiers Drive."
            }); break;
            case "expired": Toast.Error("La demande de connexion à Google a expiré. Recommencez."); break;
            case "unconfigured": Toast.Error("La connexion Google n'est pas encore configurée sur cette plateforme."); break;
            default: Toast.Error("Google a refusé la connexion. Réessayez dans un instant."); break;
        }
    }

    // Retour de « Se connecter avec Dropbox » (/dropbox/callback) : la source Dropbox est activée, et sa fenêtre rouverte pour ajouter des dossiers.
    private void DropboxReturn()
    {
        var q = System.Web.HttpUtility.ParseQueryString(new Uri(Nav.Uri).Query)["dropbox"];
        switch (q)
        {
            case "ok":
                Load();
                var user = AccountOf(ConnectedAccounts.Dropbox)?.User;
                Toast.Ok($"Dropbox connecté{(user is { Length: > 0 } ? $" ({user})" : "")}. Ajoutez vos dossiers.");
                if (accountsTab) ShowAccount(ConnectedAccounts.Dropbox); else OpenWizard("drv-dropbox", 2, !InMineId("drv-dropbox"));
                break;
            case "denied": Toast.Error("Connexion à Dropbox annulée."); break;
            case "scope": Toast.Error("Les autorisations de lecture des fichiers n'ont pas été accordées : vérifiez les permissions de l'application Dropbox (files.metadata.read, files.content.read)."); break;
            case "expired": Toast.Error("La demande de connexion à Dropbox a expiré. Recommencez."); break;
            case "unconfigured": Toast.Error("La connexion Dropbox n'est pas encore configurée sur cette plateforme."); break;
            case not null: Toast.Error("Dropbox a refusé la connexion. Réessayez dans un instant."); break;
        }
    }

    // Retour de « Se connecter avec Facebook » (/facebook/callback) : l'intégration Facebook est activée et le compte montré.
    private void FacebookReturn()
    {
        var q = System.Web.HttpUtility.ParseQueryString(new Uri(Nav.Uri).Query)["facebook"];
        switch (q)
        {
            case "ok" or "nopages":
                Load();
                var user = AccountOf(ConnectedAccounts.Facebook)?.User;
                if (q == "ok") Toast.Ok($"Facebook connecté{(user is { Length: > 0 } ? $" ({user})" : "")}. Choisissez une de ses Pages depuis une liste de lecture.");
                else Toast.Error("Facebook est connecté, mais ce compte n'administre aucune Page (ou n'a pas accordé l'accès aux Pages). Reconnectez-vous en cochant vos Pages.");
                if (accountsTab) ShowAccount(ConnectedAccounts.Facebook);
                else OpenWizard("facebook", 2, !InMineId("facebook"));
                break;
            case "denied": Toast.Error("Connexion à Facebook annulée."); break;
            case "expired": Toast.Error("La demande de connexion à Facebook a expiré. Recommencez."); break;
            case "unconfigured": Toast.Error("La connexion Facebook n'est pas encore configurée sur cette plateforme."); break;
            case not null: Toast.Error("Facebook a refusé la connexion. Réessayez dans un instant."); break;
        }
    }

    // Retour de « Se connecter avec Microsoft » (/microsoft/callback) : même principe que Google (Microsoft 365, OneDrive et SharePoint, ou les deux).
    private void MicrosoftReturn()
    {
        var query = System.Web.HttpUtility.ParseQueryString(new Uri(Nav.Uri).Query);
        var q = query["microsoft"];
        if (q == null) return;
        var purpose = AccountPurposes.Parse(query["for"]);
        switch (q)
        {
            case "ok":
                Connected(ConnectedAccounts.Microsoft, purpose, tenant.MsUser, "m365", "onedrive",
                          MicrosoftAuth.Has(tenant, MicrosoftAuth.CalendarScope), MicrosoftAuth.Has(tenant, MicrosoftAuth.DriveScope));
                break;
            case "denied": Toast.Error("Connexion à Microsoft annulée."); break;
            case "admin": Toast.Error("Votre organisation demande l'approbation de Linkii par son administrateur Microsoft 365. Transmettez-lui la demande, puis recommencez."); break;
            case "scope": Toast.Error(purpose switch
            {
                AccountPurposes.Calendar => "L'accès à vos agendas n'a pas été autorisé : reconnectez-vous en acceptant l'accès aux agendas.",
                AccountPurposes.Drive => "L'accès à vos fichiers n'a pas été autorisé : reconnectez-vous en acceptant l'accès aux fichiers.",
                _ => "Aucun accès n'a été autorisé : reconnectez-vous en acceptant l'accès aux agendas ou aux fichiers."
            }); break;
            case "expired": Toast.Error("La demande de connexion à Microsoft a expiré. Recommencez."); break;
            case "unconfigured": Toast.Error("La connexion Microsoft n'est pas encore configurée sur cette plateforme."); break;
            default: Toast.Error("Microsoft a refusé la connexion. Réessayez dans un instant."); break;
        }
    }
