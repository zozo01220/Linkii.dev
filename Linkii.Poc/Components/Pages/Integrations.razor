    private (string Label, string Css) AccState(ConnectedAccount a) =>
        a.Lost ? ("Reconnexion nécessaire", "hors-ligne")
        : a.Error.Length > 0 ? ("Erreur de connexion", "hors-ligne")
        : a.Permissions.Any(p => !p.Granted && p.Purpose != null && Enabled(IntegrationFor(a.Id, p.Purpose))) ? ("Autorisation à compléter", "mise-a-jour")
        : ("Connecté", "en-ligne");

