@page "/integrations"
@attribute [Microsoft.AspNetCore.Authorization.Authorize(Policy = "Page:integrations")]
@inject TenantStore Store
@inject AppService Svc
@inject DriveService Drives
@inject AccountManager Accounts
@inject NavigationManager Nav
@inject Toaster Toast
@inject CanvaService Canva
@inject GoogleAuth GoogleAuth
@inject MicrosoftAuth MsAuth
@inject DropboxAuth DropboxAuth
@inject FacebookAuth FacebookAuth
@using Microsoft.JSInterop
@inject IJSRuntime JS

<div class="page-head">
    <div>
        <h1>Intégrations</h1>
        <p class="sub sc-intro">Les sources de contenus de vos listes de lecture et les comptes qui y donnent accès.</p>
    </div>
    @if (admin && accountsTab && Addable.Any())
    {
      <div class="row head-actions int-ha">
        <div class="kebab add-menu">
            <button class="btn" data-fab="Connecter un compte" aria-haspopup="menu" aria-expanded="@(addMenu ? "true" : "false")" @onclick="() => addMenu = !addMenu"><Ico Name="plus" Size="16" /> Connecter un compte <Ico Name="chevron" Size="14" /></button>
            @if (addMenu)
            {
                <div class="kebab-backdrop" @onclick="() => addMenu = false"></div>
                <div class="kebab-menu" role="menu">
                    @foreach (var k in Addable)
                    {
                        var kind = k;
                        var ready = Available(kind.Id);
                        @if (kind.Id is ConnectedAccounts.Canva or ConnectedAccounts.Dropbox or ConnectedAccounts.Facebook && ready)
                        {
                            <a role="menuitem" href="@ConnectedAccounts.ConnectUrl(kind.Id)" target="_top"><AccountLogo Kind="@kind.Id" Size="20" /><span><b>@kind.Name</b><small>@kind.Summary</small></span></a>
                        }
                        else
                        {
                            <button type="button" role="menuitem" disabled="@(!ready)" @onclick="() => StartConnect(kind.Id)"><AccountLogo Kind="@kind.Id" Size="20" /><span><b>@kind.Name</b><small>@(ready ? kind.Summary : "Pas encore disponible sur cette plateforme")</small></span></button>
                        }
                    }
                </div>
            }
        </div>
      </div>
    }
</div>

@if (admin)
{
<nav class="tabs int-tabs" role="tablist" aria-label="Mes intégrations, Store et comptes connectés">
    <button type="button" role="tab" class="@(tab == "mine" ? "on" : "")" aria-selected="@(tab == "mine" ? "true" : "false")" @onclick='() => SetTab("mine")'>
        Mes intégrations <span class="cat-count">@MineCount</span>
        @if (MineHasError) { <span class="tab-alert" title="Une intégration est en erreur"><span class="sr-only">Une intégration est en erreur</span></span> }
    </button>
    <button type="button" role="tab" class="@(tab == "store" ? "on" : "")" aria-selected="@(tab == "store" ? "true" : "false")" @onclick='() => SetTab("store")'>Intégrations Store <span class="cat-count">@StoreCount</span></button>
</nav>
}

@if (!accountsTab)
{
    var store = tab == "store";
    var groups = GroupsOf(store);
    <div class="lib-tools">
        <div class="search-box grow" style="margin:0">
            <Ico Name="search" Size="16" />
            <input placeholder="Rechercher une intégration" aria-label="Rechercher une intégration" @bind="search" @bind:event="oninput" />
        </div>
        <ViewToggle StorageKey="integrations" @bind-Value="view" />
    </div>
    <div class="int-chips" role="group" aria-label="Filtrer par catégorie">
        <button type="button" class="chip @(filter.Length == 0 ? "on" : "")" aria-pressed="@(filter.Length == 0 ? "true" : "false")" @onclick="() => filter = string.Empty">Toutes <small>@TabRows(store).Count</small></button>
        @foreach (var c in Sections.Where(s => TabRows(store).Any(r => r.Section == s)))
        {
            var cat = c;
            <button type="button" class="chip @(filter == cat ? "on" : "")" aria-pressed="@(filter == cat ? "true" : "false")" @onclick="() => filter = cat">@cat <small>@TabRows(store).Count(r => r.Section == cat)</small></button>
        }
    </div>

    @if (groups.Count == 0)
    {
        <div class="card empty">
            <div class="big">@(store && search.Length == 0 && filter.Length == 0 ? "Tout le Store est déjà dans Mes intégrations" : "Aucune intégration trouvée")</div>
            @if (store && search.Length == 0 && filter.Length == 0) { <p>Vous utilisez toutes les intégrations disponibles.</p> }
        </div>
    }
    else
    {
        var visible = groups.SelectMany(g => g.Items).Select(x => x.Id).ToList();
        var picked = store ? new List<string>() : visible.Where(selected.Contains).ToList();
        var pickable = admin && !store;
        @if (view == "list")
        {
            <div class="int-list">
                <div class="int-row int-hd" aria-hidden="@(pickable ? "false" : "true")">
                    <span>@if (pickable) { <input type="checkbox" class="sc-check" checked="@(picked.Count == visible.Count && visible.Count > 0)" @onchange="() => PickAll(visible)" aria-label="Tout sélectionner" /> }</span>
                    <span></span><span>Intégration</span><span class="int-c-use">@(store ? "Prérequis" : "Utilisation")</span><span class="int-c-cat">Catégorie</span><span></span>
                </div>
                @foreach (var g in groups)
                {
                    @foreach (var e in g.Items) { @IntRow(e, g.Title ?? "", store, pickable) }
                }
            </div>
        }
        else
        {
            @foreach (var g in groups)
            {
                <h2 class="cat-group">@g.Title <span class="cat-count">@g.Items.Count</span></h2>
                <div class="int-grid">
                    @foreach (var e in g.Items) { @IntCard(e, store, pickable, g.Title ?? "") }
                </div>
            }
        }
        @if (picked.Count > 0)
        {
            var removable = picked.Count(CanRetire);
            <div class="lx-selbar" role="region" aria-label="Sélection">
                <b>@picked.Count sélectionnée@(picked.Count > 1 ? "s" : "")</b>
                <span class="vr"></span>
                <button type="button" @onclick="() => BulkSet(picked, true)">Activer</button>
                <button type="button" @onclick="() => BulkSet(picked, false)">Désactiver</button>
                <button type="button" disabled="@(removable == 0)" title="@(removable == 0 ? "Les intégrations de base ne se retirent pas : désactivez-les." : "Les remet dans le Store ; leurs contenus restent diffusés.")" @onclick="() => BulkRetire(picked)">Retirer@(removable > 0 && removable < picked.Count ? $" ({removable})" : "")</button>
                <span class="vr"></span>
                <button type="button" title="Tout désélectionner" aria-label="Tout désélectionner" @onclick="() => selected.Clear()"><Ico Name="x" Size="15" /></button>
            </div>
        }
    }
}
else
{
    @if (accounts.Count == 0)
    {
        <div class="card empty">
            <div class="big">Aucun compte connecté</div>
            <p>Connectez un compte Microsoft, Google, Canva, Dropbox ou Facebook, ou un serveur (agendas, Nextcloud, SFTP) : ses agendas, dossiers ou designs seront proposés dans vos listes de lecture.</p>
        </div>
    }
    @if (accounts.Count > 0)
    {
        <div class="lib-tools">
            <div class="search-box grow" style="margin:0">
                <Ico Name="search" Size="16" />
                <input placeholder="Rechercher un compte" aria-label="Rechercher un compte" @bind="accSearch" @bind:event="oninput" />
            </div>
            <FilterMenu Groups="AccGroups" OnPick="p => accFilter = p.Value" OnReset="() => accFilter = string.Empty" />
            <ViewToggle StorageKey="accounts" @bind-Value="accView" />
        </div>
        <FilterChips Groups="AccGroups" OnClear="_ => accFilter = string.Empty" OnResetAll="() => accFilter = string.Empty" />
    }
    <div class="acc-list @(accView == "list" ? "list" : "")">
        @foreach (var acc in ShownAccounts)
        {
            var a = acc;
            var state = AccState(a);
            var oauth = a.Id is ConnectedAccounts.Microsoft or ConnectedAccounts.Google or ConnectedAccounts.Canva or ConnectedAccounts.Dropbox or ConnectedAccounts.Facebook;
            <article class="acc-card @(flash == a.Id ? "flash" : "") @(openAcc.Contains(a.Id) ? "open" : "")" tabindex="-1" @ref="accRefs[a.Id]" aria-labelledby="acc-@a.Id"
                     @oncontextmenu="() => { if (inApp) accMenu = a.Id; }" @oncontextmenu:preventDefault="inApp">
                <div class="acc-head" @onclick="() => ToggleAcc(a.Id)">
                    <AccountLogo Kind="@a.Id" Size="28" />
                    <button type="button" class="acc-chev" aria-expanded="@(openAcc.Contains(a.Id) ? "true" : "false")" aria-label="@(openAcc.Contains(a.Id) ? "Masquer" : "Voir") les intégrations du compte @a.Kind" @onclick="() => ToggleAcc(a.Id)" @onclick:stopPropagation="true"><Ico Name="chevron" Size="14" /></button>
                    <div class="acc-id">
                        <b id="acc-@a.Id">@a.Kind</b>
                        <small class="acc-user"><span class="acc-dot @state.Css" title="@state.Label"></span><span class="sr-only">@state.Label : </span>@a.User</small>
                    </div>
                    @{ var nInt = ConnectedAccounts.Kind(a.Id).Integrations.Count(); }
                    <span class="acc-count">@nInt intégration@(nInt > 1 ? "s" : "")</span>
                    @* Look app : le bouton Reconnecter se voit sans ouvrir la carte quand le compte demande de l'attention *@
                    @if (a.Lost && oauth) { <a class="acc-reco" href="@ReconnectUrl(a)" target="_top" @onclick="() => { }" @onclick:stopPropagation="true">Reconnecter</a> }
                    else if (a.Lost || a.Error.Length > 0) { <button type="button" class="acc-reco" @onclick="() => EditConnection(a.Id)" @onclick:stopPropagation="true">Vérifier</button> }
                    <div class="kebab" @onclick:stopPropagation="true">
                        <button type="button" class="kebab-btn" aria-haspopup="menu" aria-expanded="@(accMenu == a.Id ? "true" : "false")" aria-label="Actions pour le compte @a.Kind" @onclick="() => accMenu = accMenu == a.Id ? null : a.Id"><Ico Name="dots-v" Size="18" /></button>
                        @if (accMenu == a.Id)
                        {
                            <div class="kebab-backdrop" @onclick="() => accMenu = null"></div>
                            <div class="kebab-menu" role="menu">
                                @if (oauth)
                                {
                                    <a role="menuitem" href="@ReconnectUrl(a)" target="_top"><Ico Name="refresh" Size="16" /> Reconnecter ou changer de compte</a>
                                }
                                else
                                {
                                    <button type="button" role="menuitem" @onclick="() => { accMenu = null; EditConnection(a.Id); }"><Ico Name="edit" Size="16" /> Modifier la connexion</button>
                                }
                                <button type="button" role="menuitem" class="danger" @onclick="() => { accMenu = null; disconnectId = a.Id; }"><Ico Name="logout" Size="16" /> Déconnecter…</button>
                            </div>
                        }
                    </div>
                </div>
                <div class="acc-detail">
                @if (a.Lost)
                {
                    <div class="acc-alert">
                        <span class="grow">La connexion à ce compte a expiré ou a été retirée chez @a.Kind : ses contenus ne sont plus mis à jour.</span>
                        <a class="btn danger sm" href="@ReconnectUrl(a)" target="_top">Reconnecter @a.Kind</a>
                    </div>
                }
                else if (a.Error.Length > 0)
                {
                    <div class="acc-alert">
                        <span class="grow">Dernier test en échec : @a.Error</span>
                        <button type="button" class="btn danger sm" @onclick="() => EditConnection(a.Id)">Vérifier la connexion</button>
                    </div>
                }
                @foreach (var p in a.Permissions.Where(p => !p.Granted && p.Purpose != null && !a.Lost))
                {
                    <div class="acc-alert">
                        <span class="grow">@PermName(p) : accès non autorisé</span>
                        <a class="btn danger sm" href="@ConnectedAccounts.ConnectUrl(a.Id, p.Purpose ?? AccountPurposes.All)" target="_top">Autoriser</a>
                    </div>
                }
                <div class="acc-uses">
                    @foreach (var id in ConnectedAccounts.Kind(a.Id).Integrations)
                    {
                        var intId = id;
                        <button type="button" class="acc-use" title="Gérer @IntegrationName(intId)" @onclick="() => Manage(intId)">
                            <AppIcon Id="@intId" Small="true" />
                            <span class="grow">@IntegrationName(intId)</span>
                            <small>@(Enabled(intId) ? UsageText(intId) : "Inactive")</small>
                        </button>
                    }
                </div>
                <div class="acc-foot">
                    <span class="acc-perms">Lecture :
                        @foreach (var p in a.Permissions)
                        {
                            <span class="acc-perm @(p.Granted ? "" : "no")" title="@p.Label"><Ico Name="@(p.Granted ? "check" : "x")" Size="14" />@PermName(p)</span>
                        }
                    </span>
                    <small>@SinceLine(a)</small>
                </div>
                </div>
            </article>
        }
    </div>
    <p class="acc-aside"><Ico Name="lock" Size="14" /><span>Ces comptes appartiennent à l'organisation et ne donnent qu'un accès en lecture. Se connecter à Linkii avec Google ou Microsoft est autre chose : cela se règle dans <a href="account">Mon compte</a> et ne donne accès à aucun fichier ni agenda.</span></p>
}

@if (calSource != null)
{
    <CalendarSourceDialog Source="@calSource" OnClose="CloseCalendar" OnChanged="CalendarChanged" OnShowAccount="ShowAccount" />
}

@if (driveSource != null)
{
    <DriveSourceDialog Source="@driveSource" OnClose="CloseDrive" OnChanged="Load" OnShowAccount="ShowAccount" />
}

@* Hors de tout bloc conditionnel : « Connecter un compte › Home Assistant » ouvre cette fenêtre sans autre source choisie. *@
<HaAccountDialog Open="haOpen" OnClose="CloseHa" OnChanged="Load" />

@if (wizId is { } wid)
{
    @* Assistant d'ajout d'une intégration avec compte (maquette canva-assistant-ajout.html) : tiroir du haut ; n'enregistre rien avant son dernier pas *@
    @if (wid == "canva")
    {
        <CanvaWizard StartStep="wizStep" Adding="wizAdding" OnAdded="() => pendingUse = wid" OnClose="CloseWizard" OnChanged="Load" />
    }
    else if (wid.StartsWith("drv-"))
    {
        <DriveWizard Source="@wid[4..]" StartStep="wizStep" Adding="wizAdding" AccountShared="AccountShared(wid)" OnAdded="() => pendingUse = wid" OnClose="CloseWizard" OnChanged="Load" />
    }
    else if (wid.StartsWith("cal-"))
    {
        <CalendarWizard Source="@wid[4..]" StartStep="wizStep" Adding="wizAdding" AccountShared="AccountShared(wid)" OnAdded="() => pendingUse = wid" OnClose="CloseWizard" OnChanged="Load" />
    }
    else if (wid == "ha-home")
    {
        <HaWizard StartStep="wizStep" Adding="wizAdding" OnAdded="() => pendingUse = wid" OnClose="CloseWizard" OnChanged="Load" />
    }
    else
    {
        <AppAccountWizard AppId="@wid" StartStep="wizStep" Adding="wizAdding" AccountShared="AccountShared(wid)" OnAdded="() => pendingUse = wid" OnClose="CloseWizard" OnChanged="Load" />
    }
}

@if (retireInfo is { } ri)
{
    <div class="modal-backdrop" @onclick="() => retireInfo = null"></div>
    <div class="modal app-modal sm" role="alertdialog" aria-modal="true" aria-labelledby="rc-title">
        <div class="modal-head">
            <AppIcon Id="@ri.Icon" />
            <div class="grow"><h3 id="rc-title">Retirer l'intégration @ri.Name ?</h3><small>Tout ce que cette intégration a apporté dans Linkii est retiré en une fois.</small></div>
        </div>
        <div class="modal-body">
            <ul class="cw-list">
                @foreach (var l in ri.Lines) { <li><b>@l.Title</b>@if (l.Note.Length > 0) { <small>@l.Note</small> }</li> }
            </ul>
            <p class="acc-hint">Rien n'est supprimé chez le fournisseur. Vous pourrez ajouter l'intégration de nouveau depuis le Store.</p>
        </div>
        <div class="modal-foot">
            <button class="btn ghost" @onclick="() => retireInfo = null">Annuler</button>
            <button class="btn danger-solid" @onclick="ConfirmRetire">Retirer et tout supprimer</button>
        </div>
    </div>
}

@if (detailId is { } dtId && DetailsHref(dtId) is { } dtHref && Svc.Find(dtHref["/apps/".Length..]) is { } dt)
{
    @* Fiche de l'intégration : tiroir du haut, moitié centrée, un seul bouton centré en bas *@
    <div class="modal-backdrop" @onclick="() => detailId = null"></div>
    <div class="cw-top cw-half" role="dialog" aria-modal="true" aria-labelledby="dt-title">
        <div class="cw-wrap">
            <div class="cw-head">
                <AppIcon Id="@dtId" />
                <div class="grow">
                    <h3 id="dt-title">@dt.Name</h3>
                    <small>@dt.Category · version @dt.Version</small>
                </div>
            </div>
            <div class="cw-body"><AppDetailBody App="dt" /></div>
            <div class="cw-foot center"><button type="button" class="btn" @onclick="() => detailId = null">Fermer</button></div>
        </div>
    </div>
}

@if (appDrawer is { } did && Svc.Find(did) is { } dm)
{
    @* Tiroir d'une intégration simple : ce qu'elle fait, le compte qu'elle demande, et son usage. Ouvert par « Utiliser » (Store) ou « Gérer » / « Corriger » (Mes intégrations). *@
    var dKind = ConnectedAccounts.For(did);
    var dAcc = dKind == null ? null : AccountOf(dKind);
    var dRow = AllRows().FirstOrDefault(r => r.E.Id == did);
    var dErr = dRow != null && MineEntry(dRow.E) is { StatusCss: "hors-ligne", Off: false } dEntry ? dEntry : null;
    <div class="modal-backdrop" @onclick="CloseAppDrawer"></div>
    <div class="modal app-modal as-drawer" role="dialog" aria-modal="true" aria-labelledby="apd-title">
        <div class="modal-head">
            <AppIcon Id="@did" />
            <div class="grow">
                <h3 id="apd-title">@dm.Name</h3>
                <small>@(dRow?.Section ?? dm.Category)</small>
            </div>
            <button type="button" class="modal-x" aria-label="Fermer" @onclick="CloseAppDrawer"><Ico Name="x" Size="20" /></button>
        </div>
        <div class="modal-body">
            <p class="int-drawer-desc">@(dm.Description.Length > 0 ? dm.Description : dm.Summary)</p>
            @if (dErr is { StatusTitle: { Length: > 0 } why }) { <div class="cat-err" style="margin:0 0 14px" role="alert"><Ico Name="alert" Size="15" /><span>@why</span></div> }
            @if (dKind != null)
            {
                <div class="cvs-account">
                    <AccountLogo Kind="@dKind" />
                    <div class="grow">
                        <b>@(dAcc?.User ?? "Aucun compte connecté")</b>
                        <small>@(dAcc == null ? $"Nécessaire pour utiliser {dm.Name}. Linkii demande uniquement un accès en lecture." : dAcc.Lost ? "Connexion expirée : reconnectez le compte." : SinceLine(dAcc))</small>
                    </div>
                    @if (dAcc != null) { <button type="button" class="btn ghost sm" @onclick="() => { CloseAppDrawer(); ShowAccount(dKind); }">Voir le compte</button> }
                    @if (dAcc == null || dAcc.Lost)
                    {
                        @if (Available(dKind)) { <a class="btn sm" href="@ConnectedAccounts.ConnectUrl(dKind, AccountPurposes.Drive)" target="_top">@(dAcc == null ? $"Se connecter avec {ConnectedAccounts.Kind(dKind).Name}" : "Reconnecter")</a> }
                    }
                </div>
                @if (!Available(dKind)) { <div class="int-drawer-note">@ConnectedAccounts.Kind(dKind).Name n'est pas encore disponible sur cette plateforme (connexion à configurer par l'administrateur Linkii).</div> }
            }
            else
            {
                <div class="int-drawer-note">Cette intégration ne demande aucun compte : elle est prête à l'emploi. Désactivez-la avec l'interrupteur pour ne plus la proposer dans les listes de lecture.</div>
            }
            <div class="int-drawer-use">
                <span>@UsageText(did)</span>
                @if (did == Compositions.AppId) { <a class="btn ghost sm" href="/compositions">Ouvrir Compositions</a> }
                else { <a class="btn ghost sm" href="/apps/@did">Voir les contenus</a> }
            </div>
        </div>
        <div class="modal-foot">
            @if (!dm.DefaultOn) { <button type="button" class="int-remove" @onclick="() => RetireApp(dm)">Retirer de Mes intégrations</button> }
            <button class="btn" @onclick="CloseAppDrawer">Fermer</button>
        </div>
    </div>
}

@if (connectKind != null)
{
    @* Microsoft ou Google depuis Comptes connectés : choix des accès demandés, puis page de connexion du fournisseur *@
    var def = ConnectedAccounts.Kind(connectKind);
    var ms = connectKind == ConnectedAccounts.Microsoft;
    <div class="modal-backdrop" @onclick="() => connectKind = null"></div>
    <div class="modal app-modal" role="dialog" aria-modal="true" aria-labelledby="acn-title">
        <div class="modal-head">
            <AccountLogo Kind="@connectKind" Size="28" />
            <div class="grow">
                <h3 id="acn-title">Connecter un compte @def.Name</h3>
                <small>Vous passez par la page de connexion @def.Name : Linkii ne voit jamais votre mot de passe.</small>
            </div>
            <button type="button" class="modal-x" aria-label="Fermer" @onclick="() => connectKind = null"><Ico Name="x" Size="20" /></button>
        </div>
        <div class="modal-body acc-connect">
            <p>Ce que Linkii pourra lire, sans jamais rien modifier :</p>
            <label class="acc-choice"><input type="checkbox" class="ios" @bind="wantCalendars" /><span><b>Agendas</b><small>@(ms ? "Microsoft 365 : agendas Outlook, salles et boîtes partagées" : "Google Calendar : agendas du compte, ou partagés avec lui")</small></span></label>
            <label class="acc-choice"><input type="checkbox" class="ios" @bind="wantFiles" /><span><b>Fichiers</b><small>@(ms ? "OneDrive et SharePoint : dossiers d'images et de vidéos" : "Google Drive : dossiers d'images et de vidéos, Drive partagés compris")</small></span></label>
            @if (ms) { <p class="acc-hint">Certaines organisations demandent l'approbation de leur administrateur Microsoft 365.</p> }
        </div>
        <div class="modal-foot">
            <button class="btn ghost" @onclick="() => connectKind = null">Annuler</button>
            @if (wantCalendars || wantFiles)
            {
                <a class="btn" href="@ConnectedAccounts.ConnectUrl(connectKind, wantCalendars && wantFiles ? AccountPurposes.All : wantCalendars ? AccountPurposes.Calendar : AccountPurposes.Drive)" target="_top">Continuer avec @def.Name</a>
            }
            else { <button class="btn" disabled>Continuer avec @def.Name</button> }
        </div>
    </div>
}

@if (disconnectId != null && accounts.FirstOrDefault(a => a.Id == disconnectId) is { } gone)
{
    var impacted = ConnectedAccounts.Kind(gone.Id).Integrations.Where(Enabled).ToList();
    <div class="modal-backdrop" @onclick="() => disconnectId = null"></div>
    <div class="modal app-modal" role="dialog" aria-modal="true" aria-labelledby="acd-title">
        <div class="modal-head">
            <AccountLogo Kind="@gone.Id" Size="28" />
            <div class="grow">
                <h3 id="acd-title">Déconnecter @gone.Kind ?</h3>
                <small>@gone.User</small>
            </div>
            <button type="button" class="modal-x" aria-label="Fermer" @onclick="() => disconnectId = null"><Ico Name="x" Size="20" /></button>
        </div>
        <div class="modal-body acc-connect">
            @if (impacted.Count > 0)
            {
                <div class="acc-impact">
                    <b>Ne seront plus mis à jour :</b>
                    <ul>@foreach (var i in impacted) { <li>@IntegrationName(i) — @UsageText(i)</li> }</ul>
                </div>
            }
            <p>@(gone.Id == ConnectedAccounts.Canva ? "Les designs déjà exportés restent dans la médiathèque et sur les écrans." : "Les contenus restent dans vos listes de lecture, avec leur dernière version.") Vous pourrez reconnecter ce compte, ou un autre, à tout moment.</p>
            @if (gone.Id == ConnectedAccounts.Microsoft) { <p class="acc-hint">Microsoft ne permet pas à Linkii de retirer lui-même l'autorisation : pour la retirer aussi chez Microsoft, passez par « Mes applications » de votre compte.</p> }
        </div>
        <div class="modal-foot">
            <button class="btn ghost" @onclick="() => disconnectId = null">Annuler</button>
            <button class="btn danger" @onclick="Disconnect">Déconnecter</button>
        </div>
    </div>
}

@code {
    // Catégories affichées, dans l'ordre (boutons de filtre et titres des groupes), dans « Mes intégrations » comme dans le Store.
    // Calendriers et Drives sont des familles de sources, pas des apps.
    private const string CalendarsGroup = "Calendriers", DrivesGroup = "Fichiers et Drives", HomeGroup = "Maison connectée";
    private static readonly string[] Sections = { "Médias", "Web", "Documents et design", CalendarsGroup, DrivesGroup, "Réseaux sociaux", HomeGroup, "Autres" };

    private static string SectionOf(AppManifest a) => a.Id switch
    {
        "image" or "slideshow-images" or "video" or "slideshow-videos" or "pdf" or "composition" => "Médias",
        "rss" or "webpage" or "youtube" or "weather-slide" => "Web",
        "canva" or "google-slides" or "google-docs" or "ms-powerpoint" => "Documents et design",
        "facebook" => "Réseaux sociaux",
        _ => "Autres"
    };

    // Ordre des cartes dans leur groupe (les apps absentes de la liste suivent, par nom).
    private static readonly string[] Order = { "image", "slideshow-images", "video", "slideshow-videos", "canva", "pdf", "composition", "google-slides", "google-docs", "ms-powerpoint", "youtube", "rss", "weather-slide", "facebook", "webpage" };

    [SupplyParameterFromQuery(Name = "tab")] public string? TabParam { get; set; }

    private string search = "", filter = "", view = "cards";   // view : cards | list (mémorisé dans le navigateur)
    private HashSet<string> enabled = new();
    private Dictionary<string, int> counts = new();   // contenus créés, par app
    private Tenant tenant = new();
    private List<ConnectedAccount> accounts = new();
    private string tab = "mine";   // mine | store | accounts
    private bool accountsTab { get => tab == "accounts"; set { if (value) tab = "accounts"; else if (tab == "accounts") tab = "mine"; } }
    private int wizStep = 1;
    private bool wizAdding;   // assistant Canva ouvert pour ajouter l'intégration (pas encore dans Mes intégrations)
    private RetireInfo? retireInfo;
    private ConnectedAccount? canvaAcc;
    private string? wizId;   // intégration dont l'assistant d'ajout est ouvert
    private bool cvOpen { get => wizId == "canva"; set { if (value) wizId = "canva"; else if (wizId == "canva") wizId = null; } }
    private bool addMenu, canvaReady, admin = true;   // admin : activation, comptes et connexions ; un membre voit seulement les intégrations de son niveau
    private string? calSource;     // source de calendriers dont la fenêtre « Gérer » est ouverte
    private string? driveSource;   // source Drive dont la fenêtre « Gérer » est ouverte
    private bool haOpen;           // compte Home Assistant : fenêtre de connexion ouverte
    private string? accMenu;       // compte dont le menu ⋯ est ouvert
    private string? disconnectId;  // compte dont la déconnexion est à confirmer
    private string? connectKind;   // Microsoft ou Google : choix des accès avant la connexion
    private bool wantCalendars = true, wantFiles = true;
    private string? connectingServer;   // serveur CalDAV ou Exchange ajouté depuis « Connecter un compte » : source activée une fois configurée
    private IReadOnlyList<FilterGroup> AccGroups => new[] { new FilterGroup("prov", "Fournisseur", accFilter, new[] { new FilterOption("", "Tous") }.Concat(accounts.Select(k => new FilterOption(k.Id, k.Kind))).ToList()) };
    private string accView = "cards", accSearch = "", accFilter = "";   // vue cartes | liste (mémorisée dans le navigateur)
    private readonly HashSet<string> openAcc = new();   // comptes dépliés en vue liste
    private void ToggleAcc(string id) { if (!openAcc.Remove(id)) openAcc.Add(id); }
    private IEnumerable<ConnectedAccount> ShownAccounts => accounts.Where(a =>
        (accFilter == "" || a.Id == accFilter) &&
        (accSearch.Trim().Length == 0 || a.Kind.Contains(accSearch.Trim(), StringComparison.OrdinalIgnoreCase) || a.User.Contains(accSearch.Trim(), StringComparison.OrdinalIgnoreCase)));
    private string? flash;              // compte mis en évidence après « Voir le compte »
    private HashSet<string> added = new();   // intégrations prises dans le Store (Tenant.IntegrationsAdded)
    private string? pendingUse;         // intégration que « Utiliser » vient d'ouvrir : à la fermeture du tiroir, on la montre dans Mes intégrations
    private string? flashInt;           // intégration mise en évidence un instant dans Mes intégrations
    private bool revealPending;
    private string? detailId;          // entrée dont le tiroir « Détails » (fiche de l'app) est ouvert
    private string? appDrawer;          // intégration simple (app) dont le tiroir est ouvert
    private bool focusPending;
    private readonly Dictionary<string, ElementReference> accRefs = new();

    private static string? CalSource(CatalogView.Entry e) => e.Id.StartsWith("cal-") ? e.Id[4..] : null;
    private static string? DrvSource(CatalogView.Entry e) => e.Id.StartsWith("drv-") ? e.Id[4..] : null;

    private bool Shown(string text, bool on) =>
        search.Length == 0 || text.Contains(search, StringComparison.OrdinalIgnoreCase);

    private record Row(string Section, CatalogView.Entry E, bool Base);

    /// <summary>Toutes les intégrations visibles, dans l'ordre : catégorie, puis ordre des apps, puis les sources dans leur ordre.</summary>
    private List<Row> AllRows()
    {
        // les apps « Calendrier partagé » et « Dossier Drive » n'ont pas de carte : elles suivent leurs sources (actives dès qu'une source l'est)
        var rows = Svc.Catalog.Where(a => !a.ScreenWidget && a.Id is not ("agenda" or "drive") && (admin || enabled.Contains(a.Id)))
            .OrderBy(a => a.Name, StringComparer.CurrentCultureIgnoreCase)
            .Select(a => new Row(SectionOf(a), Entry(a), a.DefaultOn))
            .ToList();
        if (admin)
        {
            rows.AddRange(SharedCalendarSources.All.Select(s => new Row(CalendarsGroup, SourceEntry(s), false)));
            rows.AddRange(DriveSources.All.Select(s => new Row(DrivesGroup, DriveEntry(s), false)));
            rows.Add(new Row(HomeGroup, HomeEntry(), false));
        }
        return rows.OrderBy(r => Array.IndexOf(Sections, r.Section))
            .ThenBy(r => Array.IndexOf(Order, r.E.Id) is var i && i >= 0 ? i : int.MaxValue)
            .ToList();
    }

    /// <summary>Dans « Mes intégrations » : celles de base, celles prises dans le Store (même désactivées) et toute intégration active.</summary>
    private bool InMine(Row r) => r.Base || added.Contains(r.E.Id) || !r.E.Off;

    private List<Row> TabRows(bool store) => AllRows().Where(r => InMine(r) != store).ToList();

    private int MineCount => TabRows(false).Count;
    private int StoreCount => TabRows(true).Count;
    private bool MineHasError => TabRows(false).Any(r => MineEntry(r.E).StatusCss == "hors-ligne" && !r.E.Off);

    /// <summary>Une intégration prise mais pas en ordre (compte non connecté, accès à autoriser, connexion à configurer) apparaît en rouge.</summary>
    private static CatalogView.Entry MineEntry(CatalogView.Entry e) => e.Off || e.StatusCss != "mise-a-jour"
        ? e
        : e with
        {
            StatusCss = "hors-ligne",
            StatusTitle = e.StatusTitle ?? e.Status switch
            {
                "À connecter" => "Le compte n'est pas connecté : connectez-le pour utiliser cette intégration.",
                "À configurer" => "La connexion n'est pas encore configurée : saisissez-la puis testez-la.",
                _ => "La configuration est à terminer."
            }
        };

    private List<CatalogView.Group> GroupsOf(bool store) =>
        TabRows(store)
            .Where(r => Shown(r.E.Name + " " + r.E.Summary + " " + r.Section, !r.E.Off) && (filter.Length == 0 || filter == r.Section))
            .GroupBy(r => r.Section)
            .Select(g => new CatalogView.Group(g.Key, g.Select(r => store ? r.E with { Off = false, StatusCss = "en-ligne" } : MineEntry(r.E)).ToList()))
            .ToList();

    /// <summary>Ce que demande une intégration du Store avant d'être utilisable.</summary>
    private static string Need(string id) => id == "cal-ics" ? "Lien à renseigner"
        : ConnectedAccounts.For(id) is not { } kind ? "Aucun compte requis"
        : kind is ConnectedAccounts.Microsoft or ConnectedAccounts.Google or ConnectedAccounts.Canva or ConnectedAccounts.Dropbox or ConnectedAccounts.Facebook
            ? $"Compte {ConnectedAccounts.Kind(kind).Name} requis" : "Serveur à renseigner";

    private void SetTab(string t) { tab = t; filter = string.Empty; search = string.Empty; selected.Clear(); menuId = null; }

    // ---------- Cartes, liste et sélection ----------

    private readonly HashSet<string> selected = new();   // cases cochées dans Mes intégrations
    private string? menuId;                               // carte ou ligne dont le menu ⋯ est ouvert

    private void TogglePick(string id) { if (!selected.Remove(id)) selected.Add(id); }
    private void PickAll(List<string> visible) { if (visible.All(selected.Contains)) selected.ExceptWith(visible); else selected.UnionWith(visible); }

    /// <summary>Les intégrations de base ne se retirent pas (on les désactive) ; Home Assistant se gère par son compte.</summary>
    private bool CanRetire(string id) => admin && Svc.Find(id) is not { DefaultOn: true };

    /// <summary>Active ou désactive une intégration, quelle que soit sa famille (app, source de calendriers, source Drive).</summary>
    private void SetOn(string id, bool on)
    {
        if (id.StartsWith("cal-")) Svc.SetCalendarSource(id[4..], on);
        else if (id.StartsWith("drv-")) Svc.SetDriveSource(id[4..], on);
        else if (id == "ha-home") return;   // son compte se gère dans sa fenêtre
        else if (on) Svc.Enable(id); else Svc.Disable(id);
    }

    private CatalogView.Entry? EntryOf(string id) => AllRows().FirstOrDefault(r => r.E.Id == id)?.E;

    private void BulkSet(List<string> ids, bool on)
    {
        int done = 0, refused = 0;
        foreach (var id in ids)
        {
            if (EntryOf(id) is not { } e || id == "ha-home") continue;
            if (on && Unavailable(e) != null) { refused++; continue; }
            if (Svc.Find(id) is not { DefaultOn: true }) Svc.Mark(id);   // désactivée, elle reste dans Mes intégrations
            SetOn(id, on);
            done++;
        }
        selected.Clear();
        Load();
        var extra = refused > 0 ? $" {refused} n'a pas pu être activée : connexion du fournisseur non configurée sur cette plateforme." : "";
        if (done == 0 && refused > 0) Toast.Error(extra.Trim());
        else Toast.Ok($"{done} intégration{(done > 1 ? "s" : "")} {(on ? "activée" : "désactivée")}{(done > 1 ? "s" : "")}.{extra}");
    }

    private async Task BulkRetire(List<string> ids)
    {
        var gone = ids.Where(CanRetire).ToList();
        foreach (var id in gone) await RetireCore(id);
        selected.Clear();
        Load();
        Toast.Ok($"{gone.Count} intégration{(gone.Count > 1 ? "s retirées" : " retirée")} de Mes intégrations. Les contenus restent diffusés ; {(gone.Count > 1 ? "elles sont" : "elle est")} de nouveau dans le Store.");
    }

    /// <summary>Retire l'intégration ; une source Drive emporte ses dossiers et les fichiers qu'elle avait copiés dans la médiathèque.</summary>
    private async Task RetireCore(string id)
    {
        var keepAccount = AccountShared(id);   // calculé avant le retrait : un compte Google ou Microsoft peut servir à une autre intégration
        if (id == "canva") { Canva.RemoveAllFolders(Store.ClientId); Svc.Uninstall("canva"); }
        else if (id.StartsWith("drv-"))
        {
            var source = id[4..];
            foreach (var f in Store.Read(d => d.Tenant.DriveFolders.Where(x => x.Source == source).ToList()))
                await Drives.RemoveFolder(Store.ClientId, f.Id);
        }
        else if (id.StartsWith("cal-")) { var source = id[4..]; Store.Write(d => { d.Tenant.SharedCalendars.RemoveAll(c => c.Source == source); }); }
        else if (id is "google-slides" or "google-docs" or "ms-powerpoint" or "facebook") Svc.Uninstall(id);   // contenus et images converties
        if (id != "ha-home") SetOn(id, false);
        Svc.Unmark(id);
        if (ConnectedAccounts.For(id) is { } kind && !keepAccount) await Accounts.Disconnect(kind);   // le compte part avec l'intégration
    }

    private async Task ConfirmRetire()
    {
        var ri = retireInfo;
        retireInfo = null;
        if (ri == null) return;
        await RetireCore(ri.Id);
        selected.Remove(ri.Id);
        Load();
        Toast.Ok($"{ri.Name} retiré : ses fichiers sont supprimés de la médiathèque{(ri.AccountGoes ? " et le compte est déconnecté" : "")}.");
    }

    private record RetireInfo(string Id, string Name, string Icon, List<(string Title, string Note)> Lines, bool AccountGoes);

    private static string N(int n, string one, string many) => $"{n} {(n > 1 ? many : one)}";

    /// <summary>Ce qui part avec l'intégration : fichiers de la médiathèque, contenus et listes de lecture touchés, compte déconnecté.</summary>
    private RetireInfo ImpactOf(CatalogView.Entry e)
    {
        var id = e.Id;
        var lines = new List<(string Title, string Note)>();
        var gone = !AccountShared(id) && ConnectedAccounts.For(id) != null;
        var user = ConnectedAccounts.For(id) is { } k ? AccountOf(k)?.User ?? "" : "";
        if (id == "canva")
        {
            var c = Canva.Impact(Store.ClientId);
            lines.Add((N(c.Files, "image", "images") + " dans la médiathèque", $"{N(c.Designs, "design", "designs")}, dossier « {CanvaService.MediaFolderName} » et dossiers synchronisés compris"));
            lines.Add(Usage(c.Playlists));
        }
        else
        {
            var (files, contents, lists, note) = Store.Read(d =>
            {
                HashSet<Guid> fileIds; List<MediaItem> conts; string nt;
                if (id.StartsWith("drv-"))
                {
                    var keys = d.Tenant.DriveFolders.Where(f => f.Source == id[4..]).Select(f => f.Id.ToString()).ToHashSet();
                    fileIds = d.Media.Where(m => m.Info.TryGetValue("drive", out var v) && keys.Contains(v)).Select(m => m.Id).ToHashSet();
                    conts = d.Media.Where(m => m.AppId == "drive" && m.Settings.GetValueOrDefault("folder") is { } fo && keys.Contains(fo)).ToList();
                    nt = N(keys.Count, "dossier synchronisé", "dossiers synchronisés");
                }
                else if (id.StartsWith("cal-"))
                {
                    var refs = d.Tenant.SharedCalendars.Where(c => c.Source == id[4..]).Select(c => c.Id.ToString()).ToHashSet();
                    fileIds = new();
                    conts = d.Media.Where(m => m.AppId == "agenda" && m.Settings.GetValueOrDefault("calendar") is { } ca && refs.Contains(ca)).ToList();
                    nt = N(refs.Count, "calendrier partagé", "calendriers partagés");
                }
                else if (id == "ha-home") { fileIds = new(); conts = new(); nt = ""; }
                else
                {
                    conts = d.Media.Where(m => m.AppId == id).ToList();
                    fileIds = conts.SelectMany(m => m.Settings.Values.SelectMany(AppField.MediaIds)).ToHashSet();
                    nt = "";
                }
                var all = fileIds.Concat(conts.Select(m => m.Id)).ToHashSet();
                var pls = d.Playlists.Where(p => p.Draft.Any(i => all.Contains(i.MediaId))).Select(p => p.Name).OrderBy(x => x).ToList();
                return (fileIds.Count, conts.Count, pls, nt);
            });
            if (files > 0 || id.StartsWith("drv-")) lines.Add((N(files, "fichier", "fichiers") + " dans la médiathèque", note));
            else if (note.Length > 0) lines.Add((note, ""));
            if (contents > 0) lines.Add((N(contents, "contenu", "contenus") + " dans les listes de lecture", "ils sont supprimés avec l'intégration"));
            lines.Add(Usage(lists));
        }
        if (gone) lines.Add(((user.Length > 0 ? $"Compte de {user}" : "Compte") + " déconnecté", "L'accès donné à Linkii est supprimé."));
        else if (ConnectedAccounts.For(id) != null) lines.Add(("Compte conservé", "Une autre intégration l'utilise encore."));
        return new(id, e.Name, e.Icon, lines, gone);

        (string, string) Usage(List<string> pl) => pl.Count == 0 ? ("Aucune liste de lecture touchée", "")
            : ($"Utilisé dans {N(pl.Count, "liste de lecture", "listes de lecture")}", $"« {string.Join(" », « ", pl)} » : ces éléments disparaissent des listes et des écrans à la prochaine publication.");
    }

    private async Task Retire(CatalogView.Entry e)
    {
        menuId = null;
        if (HasWizard(e.Id)) { retireInfo = ImpactOf(e); return; }
        await RetireCore(e.Id);
        selected.Remove(e.Id);
        Load();
        Toast.Ok($"« {e.Name} » retirée de Mes intégrations : elle est de nouveau dans le Store. Ses contenus restent diffusés.");
    }

    /// <summary>Usage de l'intégration, suivi du compte connecté qu'elle utilise.</summary>
    private string UsageLine(string id)
    {
        var acc = ConnectedAccounts.For(id) is { } k ? AccountOf(k) : null;
        return acc is { Lost: false, User.Length: > 0 } ? $"{UsageText(id)} · {acc.User}" : UsageText(id);
    }

    /// <summary>Icône de l'intégration sur une tuile arrondie à sa couleur.</summary>
    private RenderFragment TileOf(CatalogView.Entry e)
    {
        var look = AppIcon.LookOf(e.Icon);
        if (BrandLogos.Has(e.Icon)) return @<span class="int-tile is-brand"><BrandLogo Id="@e.Icon" Size="34" /></span>;
        return @<span class="int-tile" style="--c:@look.Color">@if (look.Icon is { } ic) { <Ico Name="@ic" Size="32" /> } else { <span class="int-emoji">@(Svc.Find(e.Icon)?.Icon ?? "🧩")</span> }</span>;
    }

    /// <summary>Page descriptive de l'intégration (null : elle n'en a pas, comme Home Assistant).</summary>
    private static string? DetailsHref(string id) => id switch
    {
        "ha-home" => null,
        _ when id.StartsWith("cal-") => "/apps/agenda",
        _ when id.StartsWith("drv-") => "/apps/drive",
        _ => "/apps/" + id
    };

    private RenderFragment KebabOf(CatalogView.Entry e) => @<div class="kebab" @onclick:stopPropagation="true">
        <button type="button" class="kebab-btn" aria-haspopup="menu" aria-expanded="@(menuId == e.Id ? "true" : "false")" aria-label="Actions pour @e.Name" @onclick="() => menuId = menuId == e.Id ? null : e.Id"><Ico Name="dots-v" Size="18" /></button>
        @if (menuId == e.Id)
        {
            <div class="kebab-backdrop" @onclick="() => menuId = null"></div>
            <div class="kebab-menu" role="menu">
                @if (DetailsHref(e.Id) != null) { <button type="button" role="menuitem" @onclick="() => { menuId = null; detailId = e.Id; }"><Ico Name="info" Size="16" /> Détails</button> }
                @ToggleItemOf(e)
                @if (HasWizard(e.Id) && admin)
                {
                    <button type="button" role="menuitem" @onclick="() => { menuId = null; OpenWizard(e.Id, 2, false); }"><Ico Name="folder" Size="16" /> @ManageLabel(e.Id)</button>
                    <hr />
                    @if (HasSync(e.Id)) { <button type="button" role="menuitem" @onclick="() => { menuId = null; Resync(e.Id); }"><Ico Name="refresh" Size="16" /> Resynchroniser maintenant</button> }
                    <button type="button" role="menuitem" @onclick="() => { menuId = null; OpenWizard(e.Id, 1, false); }"><Ico Name="user" Size="16" /><span>Reconnecter ou changer de compte…@if (CurrentAccount(e.Id) is { Length: > 0 } cur) { <small class="kebab-sub">Compte actuel : @cur</small> }</span></button>
                    <hr />
                }
                else {
                    <button type="button" role="menuitem" @onclick="() => { menuId = null; OpenFor(e); }"><Ico Name="edit" Size="16" /> Gérer</button>
                }
                @if (CanRetire(e.Id)) { <button type="button" role="menuitem" class="danger" @onclick="() => Retire(e)"><Ico Name="x" Size="16" /> @(HasWizard(e.Id) ? "Retirer l'intégration…" : "Retirer")</button> }
            </div>
        }
    </div>;

    /// <summary>Entrée « Activer / Désactiver » du menu ⋯ (Home Assistant n'en a pas : son compte se gère dans sa fenêtre).</summary>
    private RenderFragment ToggleItemOf(CatalogView.Entry e) => @<text>
        @if (e.Id == "ha-home" || !admin) { }
        else
        {
            <button type="button" role="menuitem" @onclick="() => { menuId = null; if (CalSource(e) is { } src) ToggleSource(src); else if (DrvSource(e) is { } drv) ToggleDrive(drv); else Toggle(e); }"><Ico Name="power" Size="16" /> @(e.Off ? "Activer" : "Désactiver")</button>
        }
    </text>;

    /// <summary>Petit point d'état devant le nom : vert (active), gris (désactivée), rouge (en erreur).</summary>
    private RenderFragment StateDot(CatalogView.Entry e) => @<text>
        @{ var (css, label) = e.Off ? ("off", "Désactivée") : e.StatusCss == "hors-ligne" ? ("bad", "Erreur de configuration") : ("", "Active"); }
        <span class="int-dot @css" title="@label" role="img" aria-label="@label"></span>
    </text>;

    /// <summary>Nom : lien vers le détail dans le Store, simple texte dans Mes intégrations (le détail est dans le menu ⋯).</summary>
    private RenderFragment NameOf(CatalogView.Entry e, bool store) => @<text>
        @if (store && DetailsHref(e.Id) is { } href) { <a class="cat-name int-link" href="@href" title="Voir le détail de @e.Name" @onclick="() => detailId = e.Id" @onclick:preventDefault="true">@e.Name</a> }
        else { <span class="cat-name">@e.Name</span> }
    </text>;

    private RenderFragment IntCard(CatalogView.Entry e, bool store, bool pickable, string category = "")
    {
        var err = !store && e.StatusCss == "hors-ligne" && !e.Off;
        var acc = !store && ConnectedAccounts.For(e.Id) is { } ak ? AccountOf(ak) : null;
        var sub = acc is { Lost: false, User.Length: > 0 } ? acc.User : acc is { Lost: true } ? "Connexion expirée" : e.Summary;
        return @<article id="cat-@e.Id" class="int-card @(err ? "err" : "") @(!store && e.Off ? "off" : "") @(selected.Contains(e.Id) ? "sel" : "") @(flashInt == e.Id ? "flash" : "")">
            <div class="int-top">
                @if (!store && pickable) { <input type="checkbox" class="sc-check int-pick" checked="@selected.Contains(e.Id)" @onchange="() => TogglePick(e.Id)" aria-label="Sélectionner @e.Name" /> }
                <div class="int-logo" aria-hidden="true">@TileOf(e)</div>
                <div class="int-txt">
                    <div class="int-nm">@NameOf(e, store)</div>
                    <div class="int-sub" title="@sub">@sub</div>
                </div>
                @if (store) { @if (category.Length > 0) { <span class="int-tag">@category</span> } }
                else if (pickable) { @KebabOf(e) }
            </div>
            <div class="int-foot">
                @if (store)
                {
                    <span class="int-need">@Need(e.Id)</span>
                    <span class="grow"></span>
                    <button type="button" class="btn-use" @onclick="() => Use(e)">Utiliser</button>
                }
                else if (err)
                {
                    @if (admin) { <button type="button" class="linklike grow int-fix" title="@e.StatusTitle" @onclick="() => OpenFor(e)">@(e.StatusTitle is { Length: > 0 } why ? why : "Corriger la configuration")</button> }
                    else { <span class="grow">@e.StatusTitle</span> }
                    <span class="int-pill bad"><i></i>Erreur</span>
                }
                else
                {
                    <span class="int-use">@UsageText(e.Id)</span>
                    <span class="grow"></span>
                    <span class="int-pill @(e.Off ? "off" : "ok")"><i></i>@(e.Off ? "Désactivée" : "Active")</span>
                }
            </div>
        </article>;
    }

    private RenderFragment IntRow(CatalogView.Entry e, string category, bool store, bool pickable)
    {
        var err = !store && e.StatusCss == "hors-ligne" && !e.Off;
        return @<div id="cat-@e.Id" class="int-row @(err ? "err" : "") @(!store && e.Off ? "off" : "") @(selected.Contains(e.Id) ? "sel" : "") @(flashInt == e.Id ? "flash" : "")">
            <span>@if (pickable) { <input type="checkbox" class="sc-check" checked="@selected.Contains(e.Id)" @onchange="() => TogglePick(e.Id)" aria-label="Sélectionner @e.Name" /> }</span>
            <span class="int-th">@TileOf(e)</span>
            <div class="int-nmc">
                <div class="int-nmrow">
                    @if (!store) { @StateDot(e) }
                    <div class="int-nm">@NameOf(e, store)</div>
                </div>
                @if (store) { <small>@e.Summary</small> }
                else if (err && e.StatusTitle is { Length: > 0 } why) { <small class="int-em">@why</small> }
            </div>
            <span class="int-c int-c-use">@(store ? Need(e.Id) : UsageLine(e.Id))</span>
            <span class="int-c int-c-cat">@category</span>
            <span class="int-act">
                @if (store) { <button type="button" class="btn-use" @onclick="() => Use(e)">Utiliser</button> }
                else if (admin)
                {
                    @if (err) { <button type="button" class="btn danger-solid sm" @onclick="() => OpenFor(e)">Corriger</button> }
                    @KebabOf(e)
                }
            </span>
        </div>;
    }

    private ConnectedAccount? AccountOf(string kind) => kind == ConnectedAccounts.Canva ? canvaAcc : accounts.FirstOrDefault(a => a.Id == kind);

    /// <summary>État d'une intégration qui passe par un compte Google, Microsoft ou Canva (null : le compte est en ordre).</summary>
    private (string, string, string?)? AccountProblem(string kind, bool configured) => AccountOf(kind) switch
    {
        { Lost: true } a => ("Compte à reconnecter", "hors-ligne", $"La connexion au compte {a.Kind} a expiré : reconnectez-le dans Comptes connectés."),
        null => ("À connecter", "mise-a-jour", (string?)null),
        _ when !configured => ("Accès à autoriser", "mise-a-jour", "Le compte connecté n'a pas encore accordé cet accès : autorisez-le dans Comptes connectés."),
        _ => null
    };

    private CatalogView.Entry Entry(AppManifest a)
    {
        var on = enabled.Contains(a.Id);
        if (!on) return CatalogView.Entry.Of(a, "Inactive", "inactif", true);
        if (a.Id == "canva")
        {
            if (!canvaReady) return CatalogView.Entry.Of(a, "Indisponible", "inactif", false);
            if (AccountProblem(ConnectedAccounts.Canva, true) is { } p) return CatalogView.Entry.Of(a, p.Item1, p.Item2, false) with { StatusTitle = p.Item3 };
            return CatalogView.Entry.Of(a, "Connecté", "en-ligne", false);
        }
        if (a.Id is "google-slides" or "google-docs" or "ms-powerpoint")   // lisent des fichiers du Drive du compte Google ou Microsoft
        {
            var kind = ConnectedAccounts.For(a.Id)!;
            var drive = AccountOf(kind)?.Permissions.Any(x => x.Purpose == AccountPurposes.Drive && x.Granted) == true;
            if (AccountProblem(kind, drive) is { } p) return CatalogView.Entry.Of(a, p.Item1, p.Item2, false) with { StatusTitle = p.Item3 };
        }
        if (a.Id == "facebook" && AccountOf(ConnectedAccounts.Facebook) is { Lost: true } fb)   // sans compte, l'intégration marche encore avec un jeton collé à la main
            return CatalogView.Entry.Of(a, "Compte à reconnecter", "hors-ligne", false) with { StatusTitle = $"La connexion au compte {fb.Kind} a expiré : reconnectez-le dans Comptes connectés." };
        return CatalogView.Entry.Of(a, "Active", "en-ligne", false);
    }

    private CatalogView.Entry SourceEntry(CalendarSourceDef s)
    {
        var acc = SharedCalendarSources.Account(tenant, s.Id);
        var on = acc?.Enabled == true;
        var configured = SharedCalendarSources.Configured(tenant, s.Id);
        var google = s.Id == "google";   // compte Google de l'organisation, partagé avec Google Drive
        var microsoft = s.Id == "m365";  // compte Microsoft de l'organisation, partagé avec OneDrive et SharePoint
        (string status, string css, string? why) = google && !GoogleAuth.IsConfigured ? ("Indisponible", "inactif", "Connexion Google de la plateforme non configurée (administrateur Linkii)")
            : microsoft && !MsAuth.IsConfigured ? ("Indisponible", "inactif", "Connexion Microsoft de la plateforme non configurée (administrateur Linkii)")
            : !on ? ("Inactive", "inactif", (string?)null)
            : (google || microsoft) && AccountProblem(google ? ConnectedAccounts.Google : ConnectedAccounts.Microsoft, configured) is { } problem ? problem
            : !configured ? ("À configurer", "mise-a-jour", (string?)null)
            : acc!.LastError.Length > 0 ? ("Erreur de connexion", "hors-ligne", acc.LastError)
            : s.Id == "ics" ? ("Active", "en-ligne", (string?)null) : ("Connecté", "en-ligne", (string?)null);
        return new("cal-" + s.Id, s.Name, "Calendrier partagé", s.Summary, "cal-" + s.Id, null, status, css, !on, why);
    }

    private CatalogView.Entry DriveEntry(DriveSourceDef s)
    {
        var on = DriveSources.Enabled(tenant, s.Id);
        var failed = tenant.DriveFolders.FirstOrDefault(f => f.Source == s.Id && f.LastError.Length > 0);
        var kind = ConnectedAccounts.For("drv-" + s.Id)!;   // compte Google, Microsoft, Dropbox ou serveur utilisé par la source
        (string status, string css, string? why) = !Available(kind) ? ("Indisponible", "inactif", $"Connexion {ConnectedAccounts.Kind(kind).Name} de la plateforme non configurée (administrateur Linkii)")
            : !on ? ("Inactive", "inactif", (string?)null)
            : AccountProblem(kind, DriveSources.Configured(tenant, s.Id)) is { } problem ? problem
            : failed != null ? ("Erreur de synchronisation", "hors-ligne", $"{failed.Name} : {failed.LastError}")
            : ("Connecté", "en-ligne", (string?)null);
        return new("drv-" + s.Id, s.Name, "Drive", s.Summary, "drv-" + s.Id, null, status, css, !on, why);
    }

    /// <summary>Carte Home Assistant de la catégorie « Maison connectée » : son compte de l'organisation, ouvert par « Gérer ».</summary>
    private CatalogView.Entry HomeEntry()
    {
        var ha = tenant.HomeAssistant;
        (string status, string css, string? why) = ha == null ? ("À connecter", "mise-a-jour", (string?)null)
            : ha.LastError.Length > 0 ? ("Erreur de connexion", "hors-ligne", ha.LastError)
            : ("Connecté", "en-ligne", (string?)null);
        return new("ha-home", "Home Assistant", "Maison connectée", "Capteurs, interrupteurs et lumières de votre Home Assistant.", "homeassistant", null, status, css, ha == null, why);
    }

