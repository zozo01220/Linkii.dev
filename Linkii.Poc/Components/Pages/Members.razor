    /// <summary>
    /// Niveau en cours d'édition (§54). Le périmètre garde la forme du modèle : un élément coché donne tout ce qu'il contient. Chaque domaine
    /// (Écrans, Listes de lecture, Médiathèque) a son accès ; Listes et Médiathèque ont leur visibilité et leurs propres dossiers.
    /// </summary>
    private class LevelForm
    {
        public Guid? Id; public string OldName = "", Name = "";
        public bool AllIntegrations, AllWidgets, AllAreas, ManageZones, Planning;
        public HashSet<string> Apps = new();
        public HashSet<Guid> Areas = new(), Zones = new(), Screens = new();
        public Dictionary<string, string> Access = Domains.ToDictionary(d => d, _ => DomainAccess.Write);
        public Dictionary<string, string> Visibility = new() { [LevelPages.Playlists] = LevelVisibility.All, [LevelPages.Media] = LevelVisibility.All };
        public HashSet<string> CreateFolders = new(), ShareFolders = new();
        public Dictionary<Guid, string> FolderModes = new();   // « Dossiers choisis » : dossier → « read » ou « write » (absent : masqué)

        public static LevelForm From(AccessLevel l) => new()
        {
            Id = l.Id, OldName = l.Name, Name = l.Name, AllIntegrations = l.AllIntegrations, AllWidgets = l.AllWidgets, Apps = [.. l.Apps],
            ManageZones = l.ManageZones, Planning = l.Pages.Contains(LevelPages.Planning),
            AllAreas = l.AllAreas, Areas = [.. l.AreaIds], Zones = [.. l.ZoneIds], Screens = [.. l.ScreenIds],
            Access = Domains.ToDictionary(d => d, l.AccessTo),
            Visibility = new() { [LevelPages.Playlists] = l.VisibilityOf(LevelPages.Playlists), [LevelPages.Media] = l.VisibilityOf(LevelPages.Media) },
            CreateFolders = FolderDomains.Where(l.CreatesFolders).ToHashSet(),
            ShareFolders = FolderDomains.Where(l.SharesFolders).ToHashSet()
        };

        public AccessLevel ToLevel() => new()
        {
            Id = Id ?? Guid.NewGuid(), Name = Name, AllIntegrations = AllIntegrations, AllWidgets = AllWidgets, Apps = [.. Apps],
            Pages = Planning ? [LevelPages.Planning] : [], ManageZones = ManageZones,
            AllAreas = AllAreas, AreaIds = [.. Areas], ZoneIds = [.. Zones], ScreenIds = [.. Screens],
            ScreensAccess = Access[LevelPages.Screens], PlaylistsAccess = Access[LevelPages.Playlists], MediaAccess = Access[LevelPages.Media],
            PlaylistsVisibility = Visibility[LevelPages.Playlists], MediaVisibility = Visibility[LevelPages.Media],
            PlaylistsCreateFolders = CreateFolders.Contains(LevelPages.Playlists), MediaCreateFolders = CreateFolders.Contains(LevelPages.Media),
            PlaylistsShareFolders = ShareFolders.Contains(LevelPages.Playlists), MediaShareFolders = ShareFolders.Contains(LevelPages.Media)
        };
    }

    private static readonly string[] Domains = { LevelPages.Screens, LevelPages.Playlists, LevelPages.Media };
    private static readonly string[] FolderDomains = { LevelPages.Playlists, LevelPages.Media };
    private string lvTab = "overview", appTab = "integrations", appQuery = "", folderQuery = "";

    private void OpenLevel(AccessLevel? l)
    {
        menuFor = null; levelError = null; open.Clear();
        lvTab = "overview"; appTab = "integrations"; appQuery = folderQuery = "";
        lf = l == null ? new LevelForm { AllIntegrations = true, AllWidgets = true, CreateFolders = [.. FolderDomains], ShareFolders = [.. FolderDomains] } : LevelForm.From(l);
        if (l != null)
            foreach (var f in folders)
                foreach (var s in f.Shares.Where(s => s.Kind == FolderShareKind.Level && s.TargetId == l.Id))
                    lf.FolderModes[f.Id] = s.Write ? "write" : "read";
        if (areas.Count == 1) open.Add(areas[0].Id);   // une seule aire : ses zones sont déjà dépliées
    }

    private void Duplicate(AccessLevel l)
    {
        OpenLevel(l);
        lf!.Id = null; lf.OldName = ""; lf.Name = l.Name + " (copie)";
    }

    private void SaveLevel()
    {
        if (lf is not { } f) return;
        var level = f.ToLevel();
        // les dossiers ne sont réécrits que si l'option est active : éteinte, les partages existants restent intacts. Seuls les domaines en
        // « Dossiers choisis » gardent leurs choix dossier par dossier ; les autres n'ont plus de partage de niveau.
        var chosen = f.FolderModes.Where(kv => folders.FirstOrDefault(x => x.Id == kv.Key) is { } fd && f.Visibility[fd.Kind] == LevelVisibility.Chosen)
            .ToDictionary(kv => kv.Key, kv => kv.Value);
        levelError = Store.Write(d => AccessLevels.Save(d, level) ?? (foldersOn ? FolderOps.SetLevelShares(d, level.Id, chosen) : null));
        if (levelError != null) return;
        Toast.Ok(f.Id == null ? $"Niveau « {level.Name.Trim()} » créé." : $"Niveau « {level.Name.Trim()} » enregistré : ses membres le reçoivent aussitôt.");
        lf = null;
        Load();
    }

