@page "/members"
@attribute [Microsoft.AspNetCore.Authorization.Authorize(Policy = "ClientAdmin")]
@inject TenantStore Store
@inject TenantContext Ctx
@inject Mailer Mail
@inject ResellerResolver Resolver
@inject NavigationManager Nav
@inject Toaster Toast
@inject AppCatalog Catalog

<div class="page-head">
    <div>
        <h1>Membres</h1>
        <p class="sub">Les personnes qui gèrent les écrans de @orgName. Chacune a un niveau de droits, défini par un administrateur : pages visibles, intégrations et widgets utilisables, aires, zones et écrans.</p>
    </div>
    @if (tab == "levels") { <button class="btn" @onclick="() => OpenLevel(null)"><Ico Name="plus" Size="16" /> Créer un niveau</button> }
    else { <button class="btn" @onclick="OpenInvite"><Ico Name="plus" Size="16" /> Inviter une personne</button> }
</div>

<nav class="se-utabs" role="tablist" aria-label="Membres et niveaux de droits">
    <button type="button" role="tab" class="@(tab == "members" ? "on" : "")" aria-selected="@(tab == "members" ? "true" : "false")" @onclick='() => tab = "members"'>Membres <small>@people.Count</small></button>
    <button type="button" role="tab" class="@(tab == "levels" ? "on" : "")" aria-selected="@(tab == "levels" ? "true" : "false")" @onclick='() => tab = "levels"'>Niveaux de droits <small>@(levels.Count + 1)</small></button>
</nav>

@if (tab == "members")
{
    var since = DateTime.UtcNow.AddDays(-30);
    var invited = people.Count(u => u.IsInvited && !u.Disabled);
    <div class="stats">
        <div class="stat"><div class="n">@people.Count</div><div class="l">personnes</div></div>
        <div class="stat"><div class="n">@people.Count(u => u.ActiveSince(since))</div><div class="l">actives sur 30 jours</div></div>
        <div class="stat"><div class="n">@people.Count(u => u.Role == Roles.ClientAdmin)</div><div class="l">administrateur@(people.Count(u => u.Role == Roles.ClientAdmin) > 1 ? "s" : "") de l'organisation</div></div>
        <div class="stat"><div class="n">@invited</div><div class="l">invitation@(invited > 1 ? "s" : "") en attente</div></div>
    </div>

    <table class="tbl">
        <thead><tr><th style="min-width:220px">Personne</th><th>Niveau de droits</th><th>Périmètre</th><th>État</th><th></th></tr></thead>
        <tbody>
        @foreach (var u in people)
        {
            var p = u;
            var lv = LevelOf(p);
            <tr class="clickable @(p.Disabled ? "dim" : "")" @onclick="() => OpenEdit(p)">
                <td>
                    <div class="who-cell">
                        <span class="avatar @(p.Disabled ? "off" : "")">@Initials(p)</span>
                        <div class="who-txt"><b>@p.Label</b><small>@p.Email@(p.Id == Ctx.UserId ? " · vous" : "")</small></div>
                    </div>
                </td>
                <td>
                    @if (p.Role == Roles.ClientAdmin) { <span class="pill dark">Administrateur</span> }
                    else if (lv != null) { <span class="pill blue">@lv.Name</span>@if (lv.ReadOnly) { <small class="muted"> lecture seule</small> } }
                    else { <span class="pill warn">Aucun niveau</span> }
                </td>
                <td class="muted">@(p.Role == Roles.ClientAdmin ? "Toutes les aires" : lv != null ? AccessLevels.ScopeText(lv, areas, screens) : "—")</td>
                <td><span class="pill @(p.Disabled ? "" : p.IsInvited ? "warn" : "ok")">@(p.Disabled ? "Désactivé" : p.IsInvited ? "Invité" : "Actif")</span></td>
                <td @onclick:stopPropagation="true">
                    <div class="kebab">
                        <button type="button" class="kebab-btn" aria-label="Actions pour @p.Email" aria-haspopup="menu" aria-expanded="@(menuFor == p.Id ? "true" : "false")" @onclick="() => menuFor = menuFor == p.Id ? null : p.Id"><Ico Name="dots-v" Size="18" /></button>
                        @if (menuFor == p.Id)
                        {
                            <div class="kebab-backdrop" @onclick="() => menuFor = null"></div>
                            <div class="kebab-menu" role="menu">
                                <button type="button" role="menuitem" @onclick="() => OpenEdit(p)"><Ico Name="edit" Size="16" /> Modifier</button>
                                @if (p.IsInvited && !p.Disabled) { <button type="button" role="menuitem" @onclick="() => Resend(p)"><Ico Name="mail" Size="16" /> Renvoyer l'invitation</button> }
                                @if (p.Id != Ctx.UserId)
                                {
                                    <button type="button" role="menuitem" @onclick="() => Ask(p, p.Disabled ? EnableAction : DisableAction)"><Ico Name="@(p.Disabled ? "check" : "lock")" Size="16" /> @(p.Disabled ? "Réactiver" : "Désactiver")</button>
                                    <button type="button" role="menuitem" class="danger" @onclick="() => Ask(p, DeleteAction)"><Ico Name="trash" Size="16" /> Supprimer</button>
                                }
                            </div>
                        }
                    </div>
                </td>
            </tr>
        }
        </tbody>
    </table>
}
else
{
    <table class="tbl">
        <thead><tr><th style="min-width:220px">Niveau</th><th>Intégrations</th><th>Widgets</th><th>Périmètre</th><th class="num">Membres</th><th></th></tr></thead>
        <tbody>
            <tr class="dim">
                <td><b>Administrateur</b><small class="muted" style="display:block">Tous les droits, y compris Membres, Aires de gestion et Réglages. Non modifiable.</small></td>
                <td>Toutes</td><td>Tous</td><td class="muted">Toutes les aires</td>
                <td class="num">@people.Count(u => u.Role == Roles.ClientAdmin)</td><td></td>
            </tr>
        @foreach (var l in levels)
        {
            var lv = l;
            <tr class="clickable" @onclick="() => OpenLevel(lv)">
                <td><b>@lv.Name</b>@if (lv.ReadOnly) { <span class="pill" style="margin-left:6px">lecture seule</span> }<small class="muted" style="display:block">@AccessLevels.PagesText(lv, Catalog)</small></td>
                <td>@AccessLevels.AppsText(lv, Catalog, false)</td>
                <td>@AccessLevels.AppsText(lv, Catalog, true)</td>
                <td class="muted">@AccessLevels.ScopeText(lv, areas, screens)</td>
                <td class="num">@people.Count(u => u.LevelId == lv.Id && u.Role == Roles.ClientMember)</td>
                <td @onclick:stopPropagation="true">
                    <div class="kebab">
                        <button type="button" class="kebab-btn" aria-label="Actions pour le niveau @lv.Name" aria-haspopup="menu" aria-expanded="@(menuFor == lv.Id ? "true" : "false")" @onclick="() => menuFor = menuFor == lv.Id ? null : lv.Id"><Ico Name="dots-v" Size="18" /></button>
                        @if (menuFor == lv.Id)
                        {
                            <div class="kebab-backdrop" @onclick="() => menuFor = null"></div>
                            <div class="kebab-menu" role="menu">
                                <button type="button" role="menuitem" @onclick="() => OpenLevel(lv)"><Ico Name="edit" Size="16" /> Modifier</button>
                                <button type="button" role="menuitem" @onclick="() => Duplicate(lv)"><Ico Name="plus" Size="16" /> Dupliquer</button>
                                <button type="button" role="menuitem" class="danger" @onclick="() => { menuFor = null; levelDelete = lv; levelError = null; }"><Ico Name="trash" Size="16" /> Supprimer</button>
                            </div>
                        }
                    </div>
                </td>
            </tr>
        }
        </tbody>
    </table>
    <p class="hint" style="margin-top:12px">Modifier un niveau change aussitôt les droits de tous ses membres. Un niveau utilisé ne se supprime pas : donnez d'abord un autre niveau à ses membres.</p>
}

@if (form != null)
{
    var f = form;
    var isNew = f.Id == null;
    var chosen = Guid.TryParse(f.Level, out var chosenId) ? levels.FirstOrDefault(l => l.Id == chosenId) : null;
    <div class="modal-backdrop" @onclick="() => form = null"></div>
    <div class="modal app-modal" role="dialog" aria-modal="true" aria-labelledby="m-title">
        <div class="modal-head">
            <div class="grow"><h3 id="m-title">@(isNew ? "Inviter une personne" : "Modifier « " + f.OldName + " »")</h3></div>
            <button type="button" class="modal-x" aria-label="Fermer" @onclick="() => form = null"><Ico Name="x" Size="20" /></button>
        </div>
        <EditForm Model="f" OnSubmit="Save" class="modal-form">
            <div class="modal-body">
                <div class="form-grid">
                    <div><label class="lbl" for="m-name">Nom</label><input id="m-name" class="full" maxlength="80" @bind="f.Name" placeholder="Prénom Nom" /></div>
                    <div><label class="lbl" for="m-mail">E-mail</label><input id="m-mail" class="full" type="email" maxlength="120" @bind="f.Email" disabled="@(!isNew)" autocomplete="off" placeholder="prenom.nom@organisation.ch" /></div>
                </div>

                <label class="lbl" for="m-level">Niveau de droits</label>
                <select id="m-level" class="full" value="@f.Level" disabled="@(f.Id == Ctx.UserId)" @onchange="e => { f.Level = e.Value?.ToString() ?? string.Empty; formError = null; }">
                    <option value="">Choisir un niveau…</option>
                    <option value="@AdminLevel">Administrateur — tous les droits</option>
                    @foreach (var l in levels) { <option value="@l.Id">@l.Name</option> }
                </select>
                @if (f.Level == AdminLevel)
                {
                    <div class="lv-sum"><div><b>Pages</b>Toutes, y compris Membres, Aires de gestion et Réglages</div><div><b>Intégrations</b>Toutes</div><div><b>Périmètre</b>Toutes les aires, sans filtre</div></div>
                }
                else if (chosen != null)
                {
                    <div class="lv-sum"><div><b>Pages</b>@AccessLevels.PagesText(chosen, Catalog)</div><div><b>Intégrations</b>@AccessLevels.AppsText(chosen, Catalog, false) · widgets : @AccessLevels.AppsText(chosen, Catalog, true).ToLowerInvariant()</div><div><b>Périmètre</b>@AccessLevels.ScopeText(chosen, areas, screens)</div>@if (chosen.ReadOnly) { <div><b>Modification</b>Lecture seule</div> }</div>
                }
                else if (levels.Count == 0) { <p class="hint" style="margin:8px 0 0">Aucun niveau créé : <a href="" @onclick="CreateFirstLevel" @onclick:preventDefault="true">créez un niveau de droits</a>, ou choisissez Administrateur.</p> }
                @if (isNew) { <p class="hint" style="margin:12px 0 0">Elle reçoit par e-mail un mot de passe provisoire, à changer à la première connexion.</p> }
                @if (formError != null) { <div class="err">@formError</div> }
            </div>
            <div class="modal-foot">
                <button type="button" class="btn ghost" @onclick="() => form = null">Annuler</button>
                <button type="submit" class="btn" disabled="@busy">@(isNew ? (busy ? "Envoi…" : "Envoyer l'invitation") : "Enregistrer")</button>
            </div>
        </EditForm>
    </div>
}

@if (lf != null)
{
    var l = lf;
    var apps = Catalog.All.Where(a => !a.ScreenWidget).OrderBy(a => a.Name, StringComparer.CurrentCultureIgnoreCase).ToList();
    var widgets = Catalog.All.Where(a => a.ScreenWidget).OrderBy(a => a.Name, StringComparer.CurrentCultureIgnoreCase).ToList();
    var members = l.Id is { } editedId ? people.Count(u => u.LevelId == editedId && u.Role == Roles.ClientMember) : 0;
    @* Niveau de droits en onglets (§54) : un onglet par domaine, chacun réglé de la même façon (accès, puis visibilité, puis ses propres dossiers). *@
    <div class="modal-backdrop" @onclick="() => lf = null"></div>
    <div class="modal app-modal lvt-modal" role="dialog" aria-modal="true" aria-labelledby="lv-title">
        <div class="modal-head lvt-head">
            <h3 id="lv-title">@(l.Id == null ? "Nouveau niveau" : "Niveau")</h3>
            <input id="lv-name" class="lvt-name" maxlength="60" @bind="l.Name" @bind:event="oninput" placeholder="Nom du niveau, ex. : Éditeur Magasin" aria-label="Nom du niveau" />
            <span class="grow"></span>
            @if (l.Id != null) { <span class="lvt-members">@members membre@(members > 1 ? "s" : "")</span> }
            <button type="button" class="modal-x" aria-label="Fermer" @onclick="() => lf = null"><Ico Name="x" Size="20" /></button>
        </div>
        <div class="lvt-body">
            <nav class="lvt-tabs" role="tablist" aria-label="Réglages du niveau" aria-orientation="vertical">
                @TabButton("overview", "info", "Vue d'ensemble", "Ce que voit ce niveau", "")
                <h5>Où</h5>
                @TabButton("scope", "map-pin", "Périmètre", AccessLevels.ScopeText(l.ToLevel(), areas, screens), l.ToLevel().HasScope ? "" : "warn")
                <h5>Quoi</h5>
                @TabButton("screens", "monitor", "Écrans et planning", ScreensStatus(), l.Access[LevelPages.Screens] == DomainAccess.None ? "off" : "")
                @TabButton("playlists", "play", "Listes de lecture", DomainStatus(LevelPages.Playlists), l.Access[LevelPages.Playlists] == DomainAccess.None ? "off" : "")
                @TabButton("media", "image", "Médiathèque", DomainStatus(LevelPages.Media), l.Access[LevelPages.Media] == DomainAccess.None ? "off" : "")
                @TabButton("apps", "grid", "Contenus et widgets", $"{AccessLevels.AppsText(l.ToLevel(), Catalog, false)} intégr. · {AccessLevels.AppsText(l.ToLevel(), Catalog, true).ToLowerInvariant()} widgets", "")
            </nav>
            <div class="lvt-pane" role="tabpanel">
                @switch (lvTab)
                {
                    case "scope":
                        <h4>Périmètre</h4>
                        <p class="lvt-lead">Où la personne travaille. Écrans, listes et médias sont limités à ce périmètre.</p>
                        <section class="lv-sec"><div class="lv-in lv-tree">
                            @Check(l.AllAreas ? "all" : "none", "Toutes les aires, y compris celles créées plus tard", ToggleAllAreas, "lv-root")
                            @foreach (var a in areas)
                            {
                                var area = a;
                                var sa = AreaState(area);
                                var oa = open.Contains(area.Id);
                                <div class="lv-n1">
                                    @Tree(sa, area.Name, () => ToggleArea(area), oa, () => Open(area.Id), AreaCount(area, sa))
                                    @if (oa)
                                    {
                                        @foreach (var z in area.Zones)
                                        {
                                            var zone = z;
                                            var sz = ZoneState(area, zone);
                                            var inZone = screens.Where(s => s.AreaId == area.Id && s.ZoneId == zone.Id).ToList();
                                            var oz = open.Contains(zone.Id);
                                            <div class="lv-n2">
                                                @Tree(sz, (zone.IsWall ? "Mur " : "Zone ") + zone.Name, () => ToggleZone(area, zone), oz && !zone.IsWall && inZone.Count > 0, () => Open(zone.Id), zone.IsWall ? "mur entier" : $"{inZone.Count} écran{(inZone.Count > 1 ? "s" : "")}", inZone.Count == 0 || zone.IsWall)
                                                @if (oz && !zone.IsWall)
                                                {
                                                    @foreach (var s in inZone)
                                                    {
                                                        var scr = s;
                                                        <div class="lv-n3">@Check(ScreenOn(scr) ? "all" : "none", scr.Name, () => ToggleScreen(area, zone, scr))</div>
                                                    }
                                                }
                                            </div>
                                        }
                                    }
                                </div>
                            }
                        </div></section>
                        <p class="lv-note">Les listes et les médias appartiennent à une aire : limité à une zone, on voit ceux de toute l'aire (sous réserve des onglets Listes de lecture et Médiathèque). Un mur d'écrans est toujours donné en entier.</p>
                        break;

                    case "screens":
                        <h4>Écrans et planning</h4>
                        <p class="lvt-lead">Les écrans du périmètre.</p>
                        <section class="lv-sec"><h4>1 · Accès aux écrans</h4><div class="lv-in">
                            @AccessCards(LevelPages.Screens, "Pas de page Écrans.", "État, aperçu, simulateur.", "Choisir les listes, publier, mettre en pause.")
                        </div></section>
                        <section class="lv-sec"><h4>2 · En plus</h4><div class="lv-in">
                            @Check(l.Planning && l.Access[LevelPages.Screens] != DomainAccess.None ? "all" : "none", "Planning : programmer des listes par créneau", () => { if (l.Access[LevelPages.Screens] != DomainAccess.None) l.Planning = !l.Planning; }, l.Access[LevelPages.Screens] == DomainAccess.None ? "lv-dis" : "")
                            @Check(l.ManageZones && l.Access[LevelPages.Screens] == DomainAccess.Write ? "all" : "none", "Gérer les zones et les murs dans son périmètre", () => { if (l.Access[LevelPages.Screens] == DomainAccess.Write) l.ManageZones = !l.ManageZones; }, l.Access[LevelPages.Screens] != DomainAccess.Write ? "lv-dis" : "")
                            @if (l.Access[LevelPages.Screens] != DomainAccess.Write) { <p class="lv-note">Gérer les zones demande « Voir et modifier » ; le planning demande l'accès aux écrans.</p> }
                        </div></section>
                        break;

                    case "playlists":
                        @DomainPane(LevelPages.Playlists)
                        break;

                    case "media":
                        @DomainPane(LevelPages.Media)
                        break;

                    case "apps":
                        <h4>Contenus et widgets</h4>
                        <p class="lvt-lead">Les apps avec lesquelles la personne crée des contenus (dans ses listes) et les widgets qu'elle pose sur ses écrans. Les connexions aux comptes restent à l'administrateur.</p>
                        <div class="lvt-tool">
                            <span class="lvt-seg" role="tablist">
                                <button type="button" role="tab" class="@(appTab == "integrations" ? "on" : "")" @onclick='() => appTab = "integrations"'>Intégrations</button>
                                <button type="button" role="tab" class="@(appTab == "widgets" ? "on" : "")" @onclick='() => appTab = "widgets"'>Widgets</button>
                            </span>
                            <div class="search-box"><Ico Name="search" Size="15" /><input placeholder="Rechercher une app" aria-label="Rechercher une app" @bind="appQuery" @bind:event="oninput" /></div>
                        </div>
                        var w = appTab == "widgets";
                        var list = (w ? widgets : apps).Where(a => appQuery.Length == 0 || a.Name.Contains(appQuery, StringComparison.CurrentCultureIgnoreCase)).ToList();
                        @Check((w ? l.AllWidgets : l.AllIntegrations) ? "all" : "none", w ? "Tous les widgets, y compris les futurs" : "Toutes les intégrations, y compris les futures", () => AllApps(w), "lv-root")
                        <div class="lvt-apps">
                            @foreach (var a in list) { var app = a; @Check(AppOn(app) ? "all" : "none", app.Name, () => ToggleApp(app)) }
                        </div>
                        @if (list.Count == 0) { <p class="lv-note">Aucune app ne correspond.</p> }
                        <p class="lv-note">Cocher = utiliser : créer et modifier des contenus avec cette app.</p>
                        break;

                    default:
                        <h4>Vue d'ensemble</h4>
                        <p class="lvt-lead">Ce que les membres de ce niveau peuvent faire, domaine par domaine. Un clic ouvre l'onglet.</p>
                        <div class="lvt-sum">
                            @SumCard("scope", "map-pin", "Périmètre", AccessLevels.ScopeText(l.ToLevel(), areas, screens), "", "")
                            @SumCard("screens", "monitor", "Écrans", ScreensStatus(), DomainAccess.Label(l.Access[LevelPages.Screens]), l.Access[LevelPages.Screens])
                            @SumCard("playlists", "play", "Listes de lecture", VisibilityStatus(LevelPages.Playlists), DomainAccess.Label(l.Access[LevelPages.Playlists]), l.Access[LevelPages.Playlists])
                            @SumCard("media", "image", "Médiathèque", VisibilityStatus(LevelPages.Media), DomainAccess.Label(l.Access[LevelPages.Media]), l.Access[LevelPages.Media])
                            @SumCard("apps", "grid", "Contenus et widgets", $"{AccessLevels.AppsText(l.ToLevel(), Catalog, false)} intégrations · {AccessLevels.AppsText(l.ToLevel(), Catalog, true).ToLowerInvariant()} widgets", "", "")
                            <div class="lvt-card off"><Ico Name="lock" Size="16" /><span class="grow"><b>Réservé aux administrateurs</b><small>Membres, aires, comptes connectés, réglages</small></span></div>
                        </div>
                        <section class="lv-sec" style="margin-top:14px"><h4>Raccourci</h4><div class="lv-in">
                            @Check(AllRead ? "all" : "none", "Tout en lecture seule : chaque domaine passe à « Voir » (plus rien ne se modifie ni ne se publie)", ToggleAllRead)
                        </div></section>
                        break;
                }
                @if (levelError != null) { <div class="err">@levelError</div> }
            </div>
        </div>
        <div class="modal-foot">
            <span class="lvt-foot">@(l.Id == null ? "Le niveau pourra ensuite être donné à des membres." : $"Les changements s'appliquent aussitôt aux {members} membre{(members > 1 ? "s" : "")} de ce niveau.")</span>
            <button type="button" class="btn ghost" @onclick="() => lf = null">Annuler</button>
            <button type="button" class="btn" @onclick="SaveLevel">Enregistrer le niveau</button>
        </div>
    </div>
}

@if (levelDelete is { } ld)
{
    <div class="modal-backdrop" @onclick="() => levelDelete = null"></div>
    <div class="modal" role="alertdialog" aria-modal="true" aria-labelledby="ld-title">
        <h3 id="ld-title">Supprimer le niveau « @ld.Name » ?</h3>
        <p class="hint">Un niveau utilisé ne se supprime pas : ses membres doivent d'abord recevoir un autre niveau.</p>
        @if (levelError != null) { <div class="err">@levelError</div> }
        <div class="modal-actions">
            <button class="btn ghost" @onclick="() => levelDelete = null">Annuler</button>
            <button class="btn danger-solid" @onclick="DeleteLevel">Supprimer</button>
        </div>
    </div>
}

@if (confirm is { } c)
{
    <div class="modal-backdrop" @onclick="() => confirm = null"></div>
    <div class="modal" role="alertdialog" aria-modal="true" aria-labelledby="cf-title">
        <h3 id="cf-title">@(c.Action == DeleteAction ? $"Supprimer le compte de {c.User.Label} ?" : c.Action == DisableAction ? $"Désactiver {c.User.Label} ?" : $"Réactiver {c.User.Label} ?")</h3>
        <p class="hint">@(c.Action == DeleteAction ? "La personne ne pourra plus se connecter. Les écrans, listes de lecture et médias restent dans leurs aires." : c.Action == DisableAction ? "La personne ne pourra plus se connecter. Son niveau est conservé ; vous pourrez la réactiver." : "La personne pourra de nouveau se connecter, avec le même niveau.")</p>
        @if (confirmError != null) { <div class="err">@confirmError</div> }
        <div class="modal-actions">
            <button class="btn ghost" @onclick="() => confirm = null">Annuler</button>
            <button class="btn @(c.Action == DeleteAction ? "danger-solid" : "")" @onclick="Confirm">@(c.Action == DeleteAction ? "Supprimer" : c.Action == DisableAction ? "Désactiver" : "Réactiver")</button>
        </div>
    </div>
}

@code {
    private const string EnableAction = "enable", DisableAction = "disable", DeleteAction = "delete", AdminLevel = "admin";
    private List<User> people = new();
    private List<Area> areas = new();
    private List<Screen> screens = new();
    private List<LevelFolder> folders = new();   // dossiers de la médiathèque et des listes de lecture (tous les niveaux, toutes les aires)
    /// <summary>Dossier vu par le formulaire ; Kind : domaine (LevelPages.Playlists ou LevelPages.Media).</summary>
    private record LevelFolder(Guid Id, Guid? ParentId, Guid AreaId, string Name, string Path, string Kind, List<FolderShare> Shares, Guid? OwnerId);
    private List<(Guid? FolderId, Guid AreaId, string Domain)> items = new();   // listes et fichiers de l'organisation (« N visibles sur M »)
    private HashSet<Guid> memberIds = new();
    private bool foldersOn;                      // option « Dossiers dans la médiathèque » de l'organisation
    private List<AccessLevel> levels = new();
    private bool busy;
    private string orgName = "", tab = "members";
    private Guid? menuFor;
    private MemberForm? form;
    private LevelForm? lf;
    private AccessLevel? levelDelete;
    private string? formError, confirmError, levelError;
    private (User User, string Action)? confirm;
    private readonly HashSet<Guid> open = new();

    private class MemberForm
    {
        public Guid? Id; public string OldName = "", Name = "", Email = "";
        /// <summary>« admin », l'identifiant d'un niveau, ou vide.</summary>
        public string Level = "";
    }

    protected override void OnInitialized() => Load();

    private void Load()
    {
        (orgName, areas, screens, levels, people) = Store.Read(d => (d.Tenant.Name,
            d.Areas.OrderBy(a => a.CreatedUtc).ToList(),
            d.Root.Screens.Where(s => s.ClientId == d.ClientId && s.Token != null).OrderBy(s => s.Name, StringComparer.CurrentCultureIgnoreCase).ToList(),
            d.Tenant.Levels.OrderBy(l => l.Name, StringComparer.CurrentCultureIgnoreCase).ToList(),
            d.Users.OrderBy(u => u.Role == Roles.ClientAdmin ? 0 : 1).ThenBy(u => u.Label, StringComparer.CurrentCultureIgnoreCase).ToList()));
        // dossiers des deux sortes, rangés par chemin (« Affiches › Été ») pour que les sous-dossiers suivent leur parent
        folders = Store.Read(d =>
        {
            var media = FolderOps.All(d);
            var lists = PlaylistFolderOps.All(d);
            static string PathOf<T>(T f, IReadOnlyCollection<T> all) where T : class, IFolderNode => string.Join(" › ", FolderAccess.Chain(f, all).Reverse().Select(x => x.Name));
            return media.Select(f => new LevelFolder(f.Id, f.ParentId, f.AreaId, f.Name, PathOf(f, media), LevelPages.Media, f.Shares, f.OwnerId)).OrderBy(f => f.Path, StringComparer.CurrentCultureIgnoreCase)
                .Concat(lists.Select(f => new LevelFolder(f.Id, f.ParentId, f.AreaId, f.Name, PathOf(f, lists), LevelPages.Playlists, f.Shares, f.OwnerId)).OrderBy(f => f.Path, StringComparer.CurrentCultureIgnoreCase))
                .ToList();
        });
        items = Store.Read(d => d.Root.Playlists.Where(p => p.ClientId == d.ClientId).Select(p => (p.FolderId, p.AreaId, LevelPages.Playlists))
            .Concat(d.Root.Media.Where(m => m.ClientId == d.ClientId && MediaLibrary.IsFile(m) && !MediaLibrary.IsDrive(m)).Select(m => (m.FolderId, m.AreaId, LevelPages.Media))).ToList());
        memberIds = people.Where(u => u.Role == Roles.ClientMember).Select(u => u.Id).ToHashSet();
        foldersOn = Store.Read(d => d.Tenant.FoldersOn);
    }

    private AccessLevel? LevelOf(User u) => u.Role == Roles.ClientMember ? levels.FirstOrDefault(l => l.Id == u.LevelId) : null;

    private static string Initials(User u) => string.Concat(u.Label.Split(' ', '.', '@').Where(w => w.Length > 0).Take(2).Select(w => char.ToUpperInvariant(w[0])));

