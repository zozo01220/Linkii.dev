    private RenderFragment Check(string state, string label, Action click, string css = "") => @<div class="lv-row @css">
        <button type="button" role="checkbox" aria-checked="@(state == "all" ? "true" : state == "some" ? "mixed" : "false")" aria-label="@label" class="lv-box @state" @onclick="click"><Ico Name="@(state == "some" ? "minus" : "check")" Size="12" /></button>
        <span class="lv-lbl" @onclick="click">@label</span>
    </div>;

    private RenderFragment Tree(string state, string label, Action click, bool expanded, Action toggle, string count, bool leaf = false) => @<div class="lv-row">
        @if (leaf) { <span class="lv-tg"></span> }
        else { <button type="button" class="lv-tg" aria-expanded="@(expanded ? "true" : "false")" aria-label="@(expanded ? "Replier" : "Déplier") @label" @onclick="toggle">@(expanded ? "▾" : "▸")</button> }
        <button type="button" role="checkbox" aria-checked="@(state == "all" ? "true" : state == "some" ? "mixed" : "false")" aria-label="@label" class="lv-box @state" @onclick="click"><Ico Name="@(state == "some" ? "minus" : "check")" Size="12" /></button>
        <span class="lv-lbl" @onclick="click">@label</span>
        <span class="lv-cnt">@count</span>
    </div>;
}
