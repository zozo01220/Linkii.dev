        }
        <section class="lv-sec"><h4>2 · Dossiers partagés avec ce rôle <span>@ChosenCount(domain) choisi@(ChosenCount(domain) > 1 ? "s" : "")</span></h4><div class="lv-in">
            <p class="lv-note" style="margin-top:0">Ce que le rôle reçoit en plus, dossier par dossier. Ce que chaque personne voit des autres dossiers (tous, ou seulement ceux qu'on lui partage) se règle sur le membre.</p>
            @if (true)
            {
                var reach = ReachedAreas();
                var rows = folders.Where(f => f.Kind == domain && (folderQuery.Length == 0 || f.Path.Contains(folderQuery, StringComparison.CurrentCultureIgnoreCase))).ToList();
                <div class="lvt-picker">
                    <div class="lvt-ptool">
                        <div class="search-box"><Ico Name="search" Size="15" /><input placeholder="Rechercher un dossier" aria-label="Rechercher un dossier" @bind="folderQuery" @bind:event="oninput" /></div>
                        <span class="grow"></span>
                        <button type="button" class="linklike" @onclick='() => SetAllFolders(domain, "read")'>Tout voir</button>
                        <button type="button" class="linklike" @onclick='() => SetAllFolders(domain, "")'>Tout retirer</button>
                    </div>
                    @if (folders.All(f => f.Kind != domain))
                    {
                        <p class="lv-note" style="padding:0 12px 10px">Aucun dossier pour l'instant : créez-en dans @(lists ? "les listes de lecture" : "la médiathèque").</p>
                    }
                    else
                    {
                        <table class="lvt-tbl">
                            <thead><tr><th>Dossier</th><th>Masqué</th><th>Voir</th><th>Modifier</th></tr></thead>
                            <tbody>
                                @foreach (var fd in rows)
                                {
                                    var folder = fd;
                                    var inReach = reach.Contains(folder.AreaId);
                                    var own = l.FolderModes.GetValueOrDefault(folder.Id) ?? "";
                                    var inh = own == "" ? InheritedMode(folder) : null;
                                    var depth = folder.Path.Count(c => c == '›');
                                    <tr class="@(inReach ? "" : "off")">
                                        <td><div class="lvt-nm" style="padding-left:@(depth * 20)px"><Ico Name="folder" Size="15" /><span>@folder.Name</span><span class="lvt-ar">@(areas.FirstOrDefault(a => a.Id == folder.AreaId)?.Name)</span>@if (inh != null) { <span class="lvt-tag">@(inh == "write" && write ? "modification" : "lecture") héritée</span> }@if (!inReach) { <span class="lvt-tag off">hors périmètre</span> }<span class="lvt-cnt">@items.Count(i => i.FolderId == folder.Id) @noun</span></div></td>
                                        @foreach (var (mode, label) in new[] { ("", "Masqué"), ("read", "Voir"), ("write", "Modifier") })
                                        {
                                            var m = mode;
                                            var dis = !inReach || m == "write" && !write;
                                            var on = own == m && (m != "" || inh == null);
                                            var ghost = own == "" && inh != null && (inh == m || inh == "write" && !write && m == "read");
                                            <td><button type="button" role="radio" aria-checked="@(on ? "true" : "false")" aria-label="@label : @folder.Name" title="@(m == "write" && !write ? "Demande « Voir et modifier »" : label)" class="lvt-dot @(on ? "on" : "") @(on && m == "write" ? "w" : "") @(ghost ? "inh" : "")" disabled="@dis" @onclick="() => SetFolderMode(folder.Id, m)"></button></td>
                                        }
                                    </tr>
                                }
                            </tbody>
                        </table>
                        <div class="lvt-pfoot"><b>@ChosenCount(domain) dossier@(ChosenCount(domain) > 1 ? "s" : "") choisi@(ChosenCount(domain) > 1 ? "s" : "")</b>@(false ? $" · {ChosenCount(domain)} dossier{(ChosenCount(domain) > 1 ? "s" : "")} choisi{(ChosenCount(domain) > 1 ? "s" : "")}" : "").</div>
                    }
                </div>
            }
        </div></section>
        <section class="lv-sec"><h4>3 · Ses propres dossiers</h4><div class="lv-in">
            @Check(l.ShareFolders.Contains(domain) && write ? "all" : "none", lists ? "Partager ses dossiers de listes" : "Partager ses dossiers de médias", () => { if (write && !l.ShareFolders.Remove(domain)) l.ShareFolders.Add(domain); }, write ? "" : "lv-dis")
            @if (!write) { <p class="lv-note">Demande « Voir et modifier ».</p> }
        </div></section>
    };

    private void DeleteLevel()
    {
        if (levelDelete is not { } l) return;
        levelError = Store.Write(d => AccessLevels.Delete(d, l.Id));
        if (levelError != null) return;
        Toast.Ok($"Rôle « {l.Name} » supprimé.");
        levelDelete = null;
        Load();
    }

    // Apps : « tout » mémorisé comme un indicateur (les apps ajoutées plus tard au catalogue sont incluses), sinon liste explicite.
    private bool AppOn(AppManifest a) => lf != null && ((a.ScreenWidget ? lf.AllWidgets : lf.AllIntegrations) || lf.Apps.Contains(a.Id));

    private void ToggleApp(AppManifest a)
    {
        var l = lf!;
        var all = a.ScreenWidget ? l.AllWidgets : l.AllIntegrations;
        var group = Catalog.All.Where(x => x.ScreenWidget == a.ScreenWidget).ToList();
        if (all)
        {   // décocher une app d'un « tout » : les autres restent cochées une à une
            if (a.ScreenWidget) l.AllWidgets = false; else l.AllIntegrations = false;
            foreach (var x in group.Where(x => x.Id != a.Id)) l.Apps.Add(x.Id);
            l.Apps.Remove(a.Id);
        }
        else if (!l.Apps.Remove(a.Id))
        {
            l.Apps.Add(a.Id);
            if (group.All(x => l.Apps.Contains(x.Id))) { if (a.ScreenWidget) l.AllWidgets = true; else l.AllIntegrations = true; foreach (var x in group) l.Apps.Remove(x.Id); }
        }
    }

    private void AllApps(bool widgets)
    {
        var l = lf!;
        var on = widgets ? !l.AllWidgets : !l.AllIntegrations;
        if (widgets) l.AllWidgets = on; else l.AllIntegrations = on;
        foreach (var x in Catalog.All.Where(x => x.ScreenWidget == widgets)) l.Apps.Remove(x.Id);
    }

    /// <summary>Périmètre d'un membre en cours d'édition : aires, zones, écrans (un élément coché donne tout ce qu'il contient) et visibilité des dossiers.</summary>
    private class PerimForm
    {
        public bool AllAreas;
        public HashSet<Guid> Areas = new(), Zones = new(), Screens = new();
        public Dictionary<string, string> Visibility = new() { [LevelPages.Playlists] = LevelVisibility.Chosen, [LevelPages.Media] = LevelVisibility.Chosen };

        public bool HasScope => AllAreas || Areas.Count + Zones.Count + Screens.Count > 0;

        public static PerimForm From(Perimeter p) => new()
        {
            AllAreas = p.AllAreas, Areas = [.. p.AreaIds], Zones = [.. p.ZoneIds], Screens = [.. p.ScreenIds],
            Visibility = new()
            {
                [LevelPages.Playlists] = p.VisibilityOf(LevelPages.Playlists) is LevelVisibility.All or LevelVisibility.AllRead ? p.VisibilityOf(LevelPages.Playlists)! : LevelVisibility.Chosen,
                [LevelPages.Media] = p.VisibilityOf(LevelPages.Media) is LevelVisibility.All or LevelVisibility.AllRead ? p.VisibilityOf(LevelPages.Media)! : LevelVisibility.Chosen
            }
        };

        public Perimeter ToPerimeter() => new()
        {
            AllAreas = AllAreas, AreaIds = [.. Areas], ZoneIds = [.. Zones], ScreenIds = [.. Screens],
            PlaylistsVisibility = Visibility[LevelPages.Playlists], MediaVisibility = Visibility[LevelPages.Media]
        };
    }

    // Ce que la personne pourra faire, et où : le résumé sous le périmètre d'un accès.
    private RenderFragment PerimeterSummary(AccForm acc, AccessLevel? level) => __builder =>
    {
        var p = acc.Perim;
        var (nAreas, nZones, nScreens) = PerimeterCounts(p);
        <div class="lv-sum">
            <div><b>Pourra</b>@(level == null ? "—" : AccessLevels.PagesText(level, Catalog))</div>
            <div><b>Dans seulement</b>@AccessLevels.ScopeText(p.ToPerimeter(), areas, screens)</div>
            <div><b>Soit</b>@(p.AllAreas ? "toute l'organisation" : $"{nAreas} aire{(nAreas > 1 ? "s" : "")} · {nZones} zone{(nZones > 1 ? "s" : "")} · {nScreens} écran{(nScreens > 1 ? "s" : "")}")</div>
        </div>
    };

    private (int Areas, int Zones, int Screens) PerimeterCounts(PerimForm p)
    {
        var per = p.ToPerimeter();
        var reached = areas.Where(a => AccessLevels.Reaches(per, a, screens)).ToList();
        var sees = new LevelScope(per, areas, per.ScreenIds.Count > 0 ? screens : []);
        var zoneCount = reached.SelectMany(a => a.Zones).Count(z => sees.SeesZone(z.Id));
        return (reached.Count, zoneCount, screens.Count(s => sees.Sees(s)));
    }

    // Visibilité des dossiers des autres, par domaine (organisation qui a activé les dossiers) : tous, tous en lecture, ou ceux qu'on lui partage.
    private RenderFragment FolderVisibility(AccForm acc, AccessLevel? level) => __builder =>
    {
        if (foldersOn && level != null)
        {
            foreach (var domain in new[] { LevelPages.Playlists, LevelPages.Media })
            {
                var dom = domain;
                if (level.AccessTo(dom) == DomainAccess.None) continue;
                <div class="mb-vis">
                    <label class="lbl">@(dom == LevelPages.Playlists ? "Dossiers de listes de lecture" : "Dossiers de la médiathèque")</label>
                    <select class="full" value="@acc.Perim.Visibility[dom]" @onchange="e => acc.Perim.Visibility[dom] = e.Value?.ToString() ?? LevelVisibility.Chosen">
                        <option value="@LevelVisibility.Chosen">Les siens et ceux qu'on lui partage</option>
                        <option value="@LevelVisibility.AllRead">Tous ceux de l'organisation, en lecture seule</option>
                        <option value="@LevelVisibility.All">Tous ceux de l'organisation</option>
                    </select>
                </div>
            }
        }
    };

    // Périmètre d'un accès : arbre aires › zones › écrans à trois états (un élément coché donne tout ce qu'il contient, ajouts futurs compris).
    private RenderFragment PerimeterPicker(AccForm acc) => __builder =>
    {
        var l = acc.Perim;
        var open = acc.Open;
                        <section class="lv-sec"><div class="lv-in lv-tree">
                            @Check(l.AllAreas ? "all" : "none", "Toutes les aires, y compris celles créées plus tard", () => ToggleAllAreas(l), "lv-root")
                            @foreach (var a in areas)
                            {
                                var area = a;
                                var sa = AreaState(l, area);
                                var oa = open.Contains(area.Id);
                                <div class="lv-n1">
                                    @Tree(sa, area.Name, () => ToggleArea(l, area), oa, () => Toggle(open, area.Id), AreaCount(l, area, sa))
                                    @if (oa)
                                    {
                                        @foreach (var z in area.Zones)
                                        {
                                            var zone = z;
                                            var sz = ZoneState(l, area, zone);
                                            var inZone = screens.Where(s => s.AreaId == area.Id && s.ZoneId == zone.Id).ToList();
                                            var oz = open.Contains(zone.Id);
                                            <div class="lv-n2">
                                                @Tree(sz, (zone.IsWall ? "Mur " : "Zone ") + zone.Name, () => ToggleZone(l, area, zone), oz && !zone.IsWall && inZone.Count > 0, () => Toggle(open, zone.Id), zone.IsWall ? "mur entier" : $"{inZone.Count} écran{(inZone.Count > 1 ? "s" : "")}", inZone.Count == 0 || zone.IsWall)
                                                @if (oz && !zone.IsWall)
                                                {
                                                    @foreach (var s in inZone)
                                                    {
                                                        var scr = s;
                                                        <div class="lv-n3">@Check(ScreenOn(l, scr) ? "all" : "none", scr.Name, () => ToggleScreen(l, area, zone, scr))</div>
                                                    }
                                                }
                                            </div>
                                        }
                                    }
                                </div>
                            }
                        </div></section>
    };

    // ---------- Périmètre : arbre aires › zones › écrans à trois états ----------

    private static void Toggle(HashSet<Guid> set, Guid id) { if (!set.Remove(id)) set.Add(id); }

    private static bool ScreenOn(PerimForm l, Screen s) => l.AllAreas || l.Areas.Contains(s.AreaId) || s.ZoneId is { } z && l.Zones.Contains(z) || l.Screens.Contains(s.Id);

    private string ZoneState(PerimForm l, Area a, Zone z)
    {
        if (l.AllAreas || l.Areas.Contains(a.Id) || l.Zones.Contains(z.Id)) return "all";
        var inZone = screens.Where(s => s.AreaId == a.Id && s.ZoneId == z.Id).ToList();
        var n = inZone.Count(s => l.Screens.Contains(s.Id));
        return n == 0 ? "none" : n == inZone.Count ? "all" : "some";
    }

    private string AreaState(PerimForm l, Area a)
    {
        if (l.AllAreas || l.Areas.Contains(a.Id)) return "all";
        var states = a.Zones.Select(z => ZoneState(l, a, z)).ToList();
        return states.Count > 0 && states.All(s => s == "all") ? "all" : states.Any(s => s != "none") ? "some" : "none";
    }

    private string AreaCount(PerimForm l, Area a, string state)
    {
        if (state == "all") return "toute l'aire";
        if (state == "none") return "";
        var n = a.Zones.Count(z => ZoneState(l, a, z) != "none");
        return $"{n} zone{(n > 1 ? "s" : "")} sur {a.Zones.Count}";
    }

    /// <summary>Quand « toutes les aires » est coché et qu'on retire un détail, chaque aire devient cochée une à une.</summary>
    private void Expand(PerimForm l)
    {
        if (!l.AllAreas) return;
        l.AllAreas = false;
        foreach (var a in areas) l.Areas.Add(a.Id);
    }

    private static void ToggleAllAreas(PerimForm l)
    {
        var on = !l.AllAreas;
        l.AllAreas = on; l.Areas.Clear(); l.Zones.Clear(); l.Screens.Clear();
    }

    private void ClearArea(PerimForm l, Area a)
    {
        l.Areas.Remove(a.Id);
        foreach (var z in a.Zones) l.Zones.Remove(z.Id);
        l.Screens.RemoveWhere(id => screens.Any(s => s.Id == id && s.AreaId == a.Id));
    }

    private void ToggleArea(PerimForm l, Area a)
    {
        var on = AreaState(l, a) != "all";
        Expand(l);
        ClearArea(l, a);
        if (on) l.Areas.Add(a.Id);
    }

    /// <summary>Toutes les zones de l'aire cochées : l'aire entière l'est (et suivra ses futures zones).</summary>
    private void Collapse(PerimForm l, Area a)
    {
        if (a.Zones.Count == 0 || !a.Zones.All(z => l.Zones.Contains(z.Id))) return;
        ClearArea(l, a);
        l.Areas.Add(a.Id);
    }

    private void ToggleZone(PerimForm l, Area a, Zone z)
    {
        var on = ZoneState(l, a, z) != "all";
        Expand(l);
        if (l.Areas.Remove(a.Id)) foreach (var o in a.Zones.Where(o => o.Id != z.Id)) l.Zones.Add(o.Id);   // l'aire était entière : les autres zones restent cochées
        l.Zones.Remove(z.Id);
        l.Screens.RemoveWhere(id => screens.Any(s => s.Id == id && s.ZoneId == z.Id));
        if (on) { l.Zones.Add(z.Id); Collapse(l, a); }
    }

    private void ToggleScreen(PerimForm l, Area a, Zone z, Screen s)
    {
        var on = !ScreenOn(l, s);
        Expand(l);
        var siblings = screens.Where(x => x.AreaId == a.Id && x.ZoneId == z.Id).ToList();
        if (l.Areas.Remove(a.Id)) foreach (var o in a.Zones.Where(o => o.Id != z.Id)) l.Zones.Add(o.Id);
        if (l.Zones.Remove(z.Id)) foreach (var o in siblings) l.Screens.Add(o.Id);
        if (on)
        {
            l.Screens.Add(s.Id);
            if (siblings.All(x => l.Screens.Contains(x.Id))) { foreach (var o in siblings) l.Screens.Remove(o.Id); l.Zones.Add(z.Id); Collapse(l, a); }
        }
        else l.Screens.Remove(s.Id);
    }

    // ---------- Cases ----------

    private RenderFragment Check(string state, string label, Action click, string css = "", string? appId = null) => @<div class="lv-row @css">
        <button type="button" role="switch" aria-checked="@(state == "all" ? "true" : "false")" aria-label="@(label + (state == "some" ? " (en partie)" : ""))" class="switch sm @(state == "all" ? "on" : state == "some" ? "some" : "")" @onclick="click"><span></span></button>
        @if (appId != null) { <span class="lv-appico" @onclick="click"><AppIcon Id="@appId" Small="true" /></span> }
        <span class="lv-lbl" @onclick="click">@label</span>
    </div>;

    private RenderFragment Tree(string state, string label, Action click, bool expanded, Action toggle, string count, bool leaf = false) => @<div class="lv-row">
        @if (leaf) { <span class="lv-tg"></span> }
        else { <button type="button" class="lv-tg" aria-expanded="@(expanded ? "true" : "false")" aria-label="@(expanded ? "Replier" : "Déplier") @label" @onclick="toggle">@(expanded ? "▾" : "▸")</button> }
        <button type="button" role="switch" aria-checked="@(state == "all" ? "true" : "false")" aria-label="@(label + (state == "some" ? " (en partie)" : ""))" class="switch sm @(state == "all" ? "on" : state == "some" ? "some" : "")" @onclick="click"><span></span></button>
        <span class="lv-lbl" @onclick="click">@label</span>
        <span class="lv-cnt">@count</span>
    </div>;
}
