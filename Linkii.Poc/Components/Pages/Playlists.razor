@page "/playlists"
@page "/playlists/{Id:guid}"
@attribute [Microsoft.AspNetCore.Authorization.Authorize(Policy = "Page:playlists")]
@implements IAsyncDisposable
@using Microsoft.JSInterop
@inject TenantStore Store
@inject AppService Svc
@inject PlaylistLibrary Library
@inject MediaLibrary MediaLib
@inject NavigationManager Nav
@inject Toaster Toast
@inject IJSRuntime JS

@* Listes de lecture épurées (§51) : le fil d'Ariane est le titre, une ligne d'état, une ligne d'outils, les dossiers en puces,
   des cartes qui disent l'essentiel (une ligne de méta, un état de diffusion) et une barre de sélection flottante. *@
<div class="lx-top">
    <div class="lx-title">
    <h1>
        @if (foldersOn && currentRow is { } cur)
        {
            <button type="button" class="lx-crumb @(dropOver == RootDrop ? "drop-target" : "")" @onclick="() => OpenFolder(null)"
                    @ondragover="() => { }" @ondragover:preventDefault="true" @ondragenter="() => { if (dragIds.Count > 0) dropOver = RootDrop; }" @ondragleave="() => { if (dropOver == RootDrop) dropOver = null; }" @ondrop:preventDefault="true" @ondrop="() => DropOn(null)">Listes de lecture</button>
            @foreach (var c in crumbs.Take(crumbs.Count - 1))
            {
                var row = c;
                <span class="lx-sl">/</span>
                <button type="button" class="lx-crumb @(dropOver == row.Folder.Id ? "drop-target" : "")" @onclick="() => OpenFolder(row.Folder.Id)"
                        @ondragover="() => { }" @ondragover:preventDefault="true" @ondragenter="() => { if (dragIds.Count > 0) dropOver = row.Folder.Id; }" @ondragleave="() => { if (dropOver == row.Folder.Id) dropOver = null; }" @ondrop:preventDefault="true" @ondrop="() => DropOn(row.Folder.Id)">@row.Folder.Name</button>
            }
            <span class="lx-sl">/</span>
            <span>@cur.Folder.Name</span>
            <span class="lx-right @(cur.Right == FolderRight.Read ? "ro" : "")"><Ico Name="@(cur.Right == FolderRight.Read ? "lock" : "folder")" Size="12" /> @RightLabel(cur)</span>
            <SharePill Summary="FolderSum(cur.Folder.Id)" Long="true" Clickable="multi && cur.Right == FolderRight.Owner" ReadOnly="cur.Right == FolderRight.Read" OwnerName="@(cur.Folder.OwnerId == me ? null : cur.OwnerName)" OnClick="() => ShareFolder(cur)" />
        }
        else
        {
            <span>Listes de lecture</span>
        }
        <span class="lx-cntpill" aria-label="@Plural(playlists.Count, "liste", "listes")">@playlists.Count</span>
    </h1>
    <p class="sub">Une liste de lecture est une boucle de contenus (images, vidéos, apps) : composez-la, puis choisissez-la sur vos écrans.</p>
    </div>
    <span class="grow"></span>
    <div class="btns">
        @if (multi && currentRow is { Right: FolderRight.Owner } here)
        {
            <button class="btn btn-share lx-share" @onclick="() => ShareFolder(here)"><Ico Name="users" Size="16" /> Partager…</button>
        }
        @if (CanCreateListHere)
        {
            <div class="lx-split">
                <button class="btn" data-fab="Nouvelle liste" @onclick="OpenCreate"><Ico Name="plus" Size="16" /> Nouvelle liste</button>
                @if (foldersOn && CanCreateFolderHere) { <button class="btn ghost lx-appfolder" data-fab="Nouveau dossier" @onclick="OpenNewFolder"><Ico Name="folder" Size="16" /> Nouveau dossier</button> }
                @if (foldersOn && CanCreateFolderHere)
                {
                    <button class="btn lx-car" aria-label="Autres créations" aria-haspopup="menu" aria-expanded="@(newMenu ? "true" : "false")" @onclick="() => newMenu = !newMenu"><Ico Name="chevron" Size="14" /></button>
                    @if (newMenu)
                    {
                        <div class="kebab-backdrop" @onclick="() => newMenu = false"></div>
                        <div class="kebab-menu" role="menu">
                            <button type="button" role="menuitem" @onclick="() => { newMenu = false; OpenCreate(); }"><Ico Name="play" Size="16" /> Nouvelle liste de lecture</button>
                            <button type="button" role="menuitem" @onclick="OpenNewFolder"><Ico Name="folder" Size="16" /> Nouveau dossier@(currentRow is { } cf ? $" dans « {cf.Folder.Name} »" : "")</button>
                        </div>
                    }
                }
            </div>
        }
        else if (foldersOn && CanCreateFolderHere)
        {
            <button class="btn ghost" data-fab="Nouveau dossier" @onclick="OpenNewFolder"><Ico Name="folder" Size="16" /> Nouveau dossier</button>
        }
    </div>
</div>

@if (Tabs.Count > 1)
{
    @* Onglets (24 octobre 2026) : ses listes, celles qu'on lui partage, et pour l'administrateur toute l'organisation. Jamais mélangées. *@
    <nav class="tabs int-tabs lx-utabs" role="tablist" aria-label="Listes affichées">
        @foreach (var t in Tabs)
        {
            var key = t.Key;
            <button type="button" role="tab" class="@(tab == key ? "on" : "")" aria-selected="@(tab == key ? "true" : "false")" @onclick="() => SetTab(key)">@t.Label@if (t.Count > 0) { <span class="cat-count">@t.Count</span> }<TabNew Family="playlists" Tab="@key" /></button>
        }
    </nav>
}

<div class="lx-status">
    <span class="lx-appoff">@Plural(playlists.Count, "liste", "listes")@(foldersOn && folderRows.Count > 0 ? $" · {Plural(folderRows.Count, "dossier", "dossiers")}" : "")</span>
    @if (PendingCount > 0)
    {
        <span class="lx-appoff"><i class="lx-dot warn"></i>@(PendingCount > 1 ? $"{PendingCount} listes ont des modifications non publiées" : "1 liste a des modifications non publiées") <button type="button" class="linklike" @onclick='() => SetFilter("pending")'>Voir</button></span>
    }
    @if (currentRow is { Right: FolderRight.Read })
    {
        <span>Vous pouvez voir, essayer et diffuser ces listes, pas les modifier. Dupliquez-en une pour l'adapter.</span>
    }
</div>

@if (scopeLists.Count == 0 && subfolders.Count == 0 && folderId == null)
{
    <div class="empty">
        <div class="big">@(tab == LibraryTab.Shared ? "Rien n'a encore été partagé avec vous" : "Aucune liste de lecture")</div>
        <p>@(tab == LibraryTab.Shared ? "Quand un collègue vous partage une liste ou un dossier, il apparaît ici. Vous pouvez la diffuser sur vos écrans." : "Une liste de lecture est une boucle de contenus (images, vidéos, apps). Composez-la, puis choisissez-la sur vos écrans et publiez.")</p>
        @if (CanCreateListHere) { <button class="btn" @onclick="OpenCreate"><Ico Name="plus" Size="16" /> Nouvelle liste</button> }
    </div>
}
else
{
    <section class="lx-fzone" aria-label="Dossiers">
    @* Dossiers de la position ouverte, hors du bloc des listes : forme de dossier (FolderShape) avec l'aperçu de leurs listes, cibles du glisser-déposer.
       PC : grille ; app : bande qui défile, appui long = menu. *@
    @if (subfolders.Count > 0 || (foldersOn && CanCreateFolderHere))
    {
        <div class="lx-fstrip lx-fgrid" role="list" aria-label="Dossiers">
            @foreach (var row in subfolders)
            {
                var r = row;
                var mine = r.Folder.OwnerId == me;
                var sum = FolderSum(r.Folder.Id);
                var preview = FolderPreview(r.Folder.Id);
                var canMenu = r.Right == FolderRight.Owner;
                <div data-nid="@r.Folder.Id" class="lx-fcard @(dropOver == r.Folder.Id ? "drop-target" : "")" role="listitem" tabindex="0" draggable="@(r.Right == FolderRight.Owner && !inApp ? "true" : null)" @ondragstart="() => { dragFolder = r.Folder.Id; }" @ondragend="EndDrag" title="@FolderTitle(r)" aria-label="Ouvrir le dossier @r.Folder.Name"
                     @onclick="() => OpenFolder(r.Folder.Id)" @onkeydown='e => { if (e.Key == "Enter") OpenFolder(r.Folder.Id); }'
                     @ondragover="() => { }" @ondragover:preventDefault="true" @ondragenter="() => { if (dragIds.Count > 0 || (dragFolder != null && dragFolder != r.Folder.Id)) dropOver = r.Folder.Id; }" @ondragleave="() => { if (dropOver == r.Folder.Id) dropOver = null; }" @ondrop:preventDefault="true" @ondrop="() => DropOn(r.Folder.Id)"
                     @oncontextmenu="() => { if (canMenu) menuFor = r.Folder.Id; }" @oncontextmenu:preventDefault="inApp && canMenu">
                    <FolderShape Preview="preview" All="media" Count="ChildCount(r.Folder.Id)" Unit="@FolderUnit(r.Folder.Id)">
                        <Badge>
                            @if (r.Right == FolderRight.Read) { <span class="fbadge ro" title="Dossier de @r.OwnerName"><Ico Name="lock" Size="11" /> @(tab == LibraryTab.Mine ? "Lecture seule" : First(r.OwnerName))</span> }
                            else if (r.Right == FolderRight.Write) { <span class="fbadge lvl" title="Dossier de @r.OwnerName, vous pouvez le modifier"><Ico Name="users" Size="11" /> @First(r.OwnerName)</span> }
                            else if (sum.Any) { <span class="fbadge @(sum.Everyone != null ? "lvl" : "sh")"><Ico Name="users" Size="11" /> @(sum.Everyone != null ? "Partagé · tous" : $"Partagé · {sum.People}")</span> }
                            else if (!mine && tab != LibraryTab.Mine && r.Folder.OwnerId != null) { <span class="fbadge sh" title="Dossier de @r.OwnerName">@First(r.OwnerName)</span> }
                        </Badge>
                    </FolderShape>
                    <div class="fn"><span>@r.Folder.Name</span><small>@FolderDate(r)</small></div>
                    @if (canMenu)
                    {
                        <button type="button" class="fk" aria-label="Actions pour le dossier @r.Folder.Name" aria-haspopup="menu" aria-expanded="@(menuFor == r.Folder.Id ? "true" : "false")"
                                @onclick:stopPropagation="true" @onclick="() => menuFor = menuFor == r.Folder.Id ? null : r.Folder.Id"><Ico Name="dots-v" Size="16" /></button>
                    }
                    @if (menuFor == r.Folder.Id)
                    {
                        <div class="kebab-backdrop" @onclick:stopPropagation="true" @onclick="() => menuFor = null"></div>
                        <div class="kebab-menu" role="menu" @onclick:stopPropagation="true">
                            <span class="kebab-note">@r.Folder.Name · @(mine ? "votre dossier" : $"dossier de {r.OwnerName}") · @(sum.Any ? "partagé" : "non partagé")</span>
                            @if (multi) { <button type="button" role="menuitem" @onclick="() => { menuFor = null; ShareFolder(r); }"><Ico Name="users" Size="16" /> Partager…</button> }
                            @if (r.Right == FolderRight.Owner)
                            {
                                <button type="button" role="menuitem" @onclick="() => { menuFor = null; renamingFolder = r; renameFolderValue = r.Folder.Name; folderError = null; }"><Ico Name="edit" Size="16" /> Renommer</button>
                                <button type="button" role="menuitem" @onclick="() => { menuFor = null; reparenting = (r.Folder.Id, r.Folder.Name); }"><Ico Name="move" Size="16" /> Déplacer…</button>
                                <button type="button" role="menuitem" class="danger" @onclick="() => { menuFor = null; deletingFolder = r; }"><Ico Name="trash" Size="16" /> Supprimer</button>
                            }
                        </div>
                    }
                </div>
            }
            @if (foldersOn && CanCreateFolderHere)
            {
                <button type="button" class="lx-fcard add" @onclick="OpenNewFolder">
                    <div class="fv"><span class="fbk"></span><span class="ffr"><Ico Name="plus" Size="22" /></span></div>
                    <div class="fn"><span>Nouveau dossier</span></div>
                </button>
            }
        </div>
    }
    </section>
    <section class="lx-blk lx-blk-main" aria-label="Listes">
        <div class="lx-bh"><Ico Name="play" Size="16" /> <span>Listes</span> <small>@Sorted.Count()</small></div>
    <div class="lx-tools" role="region" aria-label="Recherche et filtres">
        <div class="search-box">
            <Ico Name="search" Size="16" />
            <input data-lx-search placeholder="@(foldersOn ? "Rechercher dans toutes les listes" : "Rechercher des listes de lecture")" aria-label="Rechercher des listes de lecture" @bind="search" @bind:event="oninput" />
        </div>
        @if (Active) { <span class="lx-count" aria-live="polite">@Plural(Sorted.Count(), "résultat", "résultats")</span> }
        <FilterMenu Groups="FilterGroups" Extra="@(foldersOn && folderId != null && !scopeAll ? 1 : 0)" OnPick="PickFilter" OnReset="ResetFilters">
            <Footer>
                @if (foldersOn && folderId != null)
                {
                    <div class="fm-note"><span>Chercher dans : @(scopeAll ? "toute l'aire" : "ce dossier")</span><button type="button" class="linklike" @onclick="() => scopeAll = !scopeAll">Changer</button></div>
                }
            </Footer>
        </FilterMenu>
        <select @bind="sort" class="tb-sort" aria-label="Trier">
            <option value="recent">Récentes</option>
            <option value="name">Nom</option>
            <option value="used">Plus utilisées</option>
        </select>
        <ViewToggle StorageKey="playlists" @bind-Value="view" />
    </div>
    <FilterChips Groups="FilterGroups" Extra="FilterExtras" OnClear="ClearFilter" OnResetAll="ResetFilters" />

    @if (!Sorted.Any())
    {
        @if (Active) { <div class="empty"><div class="big">Aucune liste ne correspond</div><button class="btn ghost sm" @onclick='() => { search = ""; filter = ""; }'>Effacer la recherche et les filtres</button></div> }
        else if (subfolders.Count == 0 && currentRow is { } fe)
        {
            <div class="empty compact">
                <div class="big">Ce dossier est vide</div>
                @if (CanCreateListHere)
                {
                    <p>Créez une liste dans « @fe.Folder.Name », ou glissez-y des listes depuis « Listes de lecture ».</p>
                    <button class="btn" @onclick="OpenCreate"><Ico Name="plus" Size="16" /> Nouvelle liste</button>
                }
            </div>
        }
        else
        {
            @* rien à cet endroit, mais des dossiers au-dessus : on le dit, avec le bouton de création *@
            <div class="empty compact">
                <div class="big">@(currentRow is { } re ? $"Aucune liste dans « {re.Folder.Name} »" : "Aucune liste à la racine")</div>
                <p>@(folderId == null ? "Vos listes sont rangées dans les dossiers ci-dessus." : "Ses listes sont rangées dans les sous-dossiers ci-dessus.")@(CanCreateListHere ? " Créez ici une liste qui n'a pas besoin de dossier." : "")</p>
                @if (CanCreateListHere) { <button class="btn" @onclick="OpenCreate"><Ico Name="plus" Size="16" /> Nouvelle liste</button> }
            </div>
        }
    }
    else
    {
        @if (view == "list")
        {
        <div class="lx-tbl-wrap">
            <table class="lx-tbl @(picked.Count > 0 ? "lx-selecting" : "")">
                <thead>
                    <tr>
                        <th style="width:34px"><input type="checkbox" class="sc-check lx-check" checked="@AllPicked" @onchange="ToggleAll" aria-label="Tout sélectionner" /></th>
                        <th><button type="button" class="@(sort == "name" ? "on" : "")" @onclick='() => sort = "name"'>Nom</button></th>
                        @if (foldersOn) { <th>Emplacement</th> }
                        <th class="num">Contenus</th>
                        <th class="num">Durée</th>
                        <th><button type="button" class="@(sort == "used" ? "on" : "")" @onclick='() => sort = "used"'>Diffusion</button></th>
                        <th><button type="button" class="@(sort == "recent" ? "on" : "")" @onclick='() => sort = "recent"'>Modifiée</button></th>
                        <th style="width:44px"><span class="sr-only">Actions</span></th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var p in Sorted)
                    {
                        var pl = p;
                        var tile = Tiles(pl).FirstOrDefault();
                        var total = TotalSeconds(pl);
                        <tr data-nid="@pl.Id" class="@(picked.Contains(pl.Id) ? "picked" : "") @(dragIds.Contains(pl.Id) ? "dragging" : "")" draggable="@(CanDrag(pl) ? "true" : "false")" @ondragstart="() => StartDrag(pl)" @ondragend="EndDrag">
                            <td><input type="checkbox" class="sc-check lx-check" aria-label="Sélectionner @pl.Name" checked="@picked.Contains(pl.Id)" @onchange="() => Toggle(pl.Id)" /></td>
                            <td><div class="nm"><span class="mini">@if (tile != null) { <MediaThumb Media="tile" All="media" /> } else { <Ico Name="image" Size="16" /> }</span><a href="/playlists/@pl.Id">@pl.Name</a>@ListShare(pl)@if (RightOfList(pl) == FolderRight.Read) { <span title="Lecture seule"><Ico Name="lock" Size="13" /></span> }</div></td>
                            @if (foldersOn) { <td><small>@PathOf(pl)</small></td> }
                            <td class="num">@pl.Draft.Count</td>
                            <td class="num">@(total > 0 ? Helpers.FormatDuration(total) : "—")</td>
                            <td>@State(pl)</td>
                            <td><small>@(Ago(pl) ?? "—")</small></td>
                            <td>@Menu(pl)</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
        }
        @* sur mobile, toujours en cartes (pas de bascule) *@
        <div class="lx-pgrid @(picked.Count > 0 ? "lx-selecting" : "") @(view == "list" ? "lx-mobile-only" : "")">
            @foreach (var p in Sorted)
            {
                var pl = p;
                var tiles = Tiles(pl).Take(3).ToList();
                var total = TotalSeconds(pl);
                <div data-nid="@pl.Id" class="lx-pc @(picked.Contains(pl.Id) ? "picked" : "") @(dragIds.Contains(pl.Id) ? "dragging" : "")"
                     @oncontextmenu="() => { if (inApp) menuFor = pl.Id; }" @oncontextmenu:preventDefault="inApp"
                     draggable="@(CanDrag(pl) ? "true" : "false")" @ondragstart="() => StartDrag(pl)" @ondragend="EndDrag">
                    <input type="checkbox" class="sc-check lx-check" aria-label="Sélectionner @pl.Name" checked="@picked.Contains(pl.Id)" @onchange="() => Toggle(pl.Id)" />
                    <div class="lx-cwrap">
                    @if (tiles.Count == 0)
                    {
                        <a class="pl-cover lx-empty" href="/playlists/@pl.Id" tabindex="-1" aria-hidden="true"><Ico Name="plus" Size="15" /> @(pl.Draft.Count == 0 ? "Ajouter des contenus" : "Aperçu indisponible")</a>
                    }
                    else
                    {
                        <a class="pl-cover @(tiles.Count <= 1 ? "single" : "")" href="/playlists/@pl.Id" tabindex="-1" aria-hidden="true">
                            @foreach (var m in tiles) { <div class="pl-tile"><MediaThumb Media="m" All="media" /></div> }
                        </a>
                    }
                    @if (RightOfList(pl) == FolderRight.Read) { <span class="lx-lock" title="Dans un dossier partagé en lecture seule"><Ico Name="lock" Size="13" /></span> }
                    <span class="lx-cshare">@ListShare(pl)</span>
                    </div>
                    @if (pl.Draft.Count > 0) { <button type="button" class="lx-try" @onclick="() => trying = pl.Id"><Ico Name="play" Size="13" /> Essayer</button> }
                    <div class="lx-pbody">
                        <div class="grow">
                            <a class="pl-name" href="/playlists/@pl.Id" title="@pl.Name">@pl.Name</a>
                            @if (OwnerOf(pl) is { } ow) { <span class="lx-chip" title="@OwnerTitle(pl, ow)"><Ico Name="users" Size="12" /> @First(ow)</span> }

                            <div class="lx-meta">@Meta(pl, total)</div>
                            @if (ShowPath) { <div class="lx-path"><Ico Name="folder" Size="12" /><span>@PathOf(pl)</span></div> }
                            @State(pl)
                        </div>
                        @Menu(pl)
                    </div>
                </div>
            }
        </div>
    }
    </section>

    @if (picked.Count > 0)
    {
        var editable = PickedEditable();
        <div class="lx-selbar" role="region" aria-label="Sélection">
            <b>@picked.Count sélectionnée@(picked.Count > 1 ? "s" : "")</b>
            <button type="button" @onclick="ToggleAll">@(AllPicked ? "Tout désélectionner" : $"Tout sélectionner ({Sorted.Count()})")</button>
            <span class="vr"></span>
            @if (foldersOn) { <button type="button" disabled="@(editable.Count == 0)" title="@(editable.Count == 0 ? "Aucune liste modifiable dans la sélection" : null)" @onclick="() => listMove = editable"><Ico Name="folder" Size="15" /><span class="lx-lbl">Ranger…</span></button> }
            <button type="button" @onclick="DuplicatePicked"><Ico Name="copy" Size="15" /><span class="lx-lbl">Dupliquer</span></button>
            @if (multi && playlists.Any(x => picked.Contains(x.Id) && RightOfList(x) == FolderRight.Owner))
            {
                <button type="button" @onclick="() => { sharingKind = ShareKind.Playlist; sharingItems = playlists.Where(x => picked.Contains(x.Id) && RightOfList(x) == FolderRight.Owner).Select(x => (x.Id, x.Name)).ToList(); }"><Ico Name="share" Size="15" /><span class="lx-lbl">Partager…</span></button>
            }
            <span class="vr"></span>
            <button type="button" class="del" disabled="@(!playlists.Any(x => picked.Contains(x.Id) && CanDel(x)))" title="@(!playlists.Any(x => picked.Contains(x.Id) && CanDel(x)) ? "Aucune de ces listes n'est à vous" : null)"
                    @onclick="() => deleting = playlists.Where(x => picked.Contains(x.Id)).ToList()">
                <Ico Name="trash" Size="15" /> Supprimer
            </button>
            <span class="vr"></span>
            <button type="button" title="Tout désélectionner (Échap)" aria-label="Tout désélectionner" @onclick="() => picked.Clear()"><Ico Name="x" Size="15" /></button>
        </div>
    }
}

@if (Id is { } openId)
{
    <div class="lx-drawer-veil" @onclick="CloseEditor"></div>
    <aside class="lx-drawer pl-drawer" role="dialog" aria-label="Liste de lecture">
        <button type="button" class="pl-x" title="Fermer" aria-label="Fermer" @onclick="CloseEditor"><Ico Name="x" Size="20" /></button>
        <PlaylistEditor @key="openId" Id="openId" OnClose="CloseEditor" />
    </aside>
}

@if (creating)
{
    var dup = DuplicateName(newName);
    <div class="modal-backdrop" @onclick="CloseName"></div>
    <div class="modal" role="dialog" aria-modal="true" aria-labelledby="create-title">
        <h3 id="create-title">@(renamingPl == null ? "Nouvelle liste de lecture" : "Renommer la liste de lecture")</h3>
        <p class="hint">@(renamingPl == null ? "Donnez-lui un nom, vous ajouterez les contenus ensuite." : "Le nouveau nom s'affiche dans le back-office uniquement.")</p>
        <input style="width:100%" @ref="nameInput" @bind="newName" @bind:event="oninput" @onkeydown="OnCreateKey" placeholder="Ex. Accueil, vitrine, salle d'attente" />
        @if (dup) { <p class="hint" style="color:var(--warn-ink)">Une autre liste de l'aire porte déjà ce nom : sur les écrans, on ne saura pas laquelle choisir.</p> }
        <div class="modal-actions">
            <button class="btn ghost" @onclick="CloseName">Annuler</button>
            <button class="btn" disabled="@string.IsNullOrWhiteSpace(newName)" @onclick="SubmitName">@(renamingPl == null ? "Créer" : "Renommer")</button>
        </div>
    </div>
}

@if (creatingFolder)
{
    <div class="modal-backdrop" @onclick="() => creatingFolder = false"></div>
    <div class="modal" role="dialog" aria-modal="true" aria-labelledby="nfp-title">
        <h3 id="nfp-title">Nouveau dossier@(folderId is { } ? $" dans « {currentRow?.Folder.Name} »" : "")</h3>
        <input style="width:100%;margin-top:10px" placeholder="Nom du dossier" maxlength="60" aria-label="Nom du dossier" @bind="newFolderName" @bind:event="oninput" @onkeydown='e => { if (e.Key == "Enter") CreateFolder(); }' />
        @if (folderError != null) { <div class="err">@folderError</div> }
        @if (multi) { <p class="hint">Il est à vous : partagez-le ensuite avec des collègues, « Peut utiliser » ou « Peut modifier ».</p> }
        <div class="modal-actions">
            <button class="btn ghost" @onclick="() => creatingFolder = false">Annuler</button>
