            @if (kept.Count > 0)
            {
                <p class="hint"><Ico Name="lock" Size="13" /> Non supprimée@(kept.Count > 1 ? "s" : "") (lecture seule) : @string.Join(", ", kept.Select(x => $"« {x.Name} »")).</p>
            }
            <div class="modal-actions">
                <button class="btn ghost" @onclick="() => deleting = null">Annuler</button>
                <button class="btn danger-solid" @onclick="() => Delete(gone)">Supprimer@(gone.Count > 1 ? $" {gone.Count} listes" : "")</button>
            </div>
        }
    </div>
}

