}

@if (sharingItems is { } shi)
{
    <ShareDialog Kind="@sharingKind" Items="shi" OnClose="() => sharingItems = null" OnShared="Load" />
}

@if (leaving is { } lvp)
{
    var from = OwnerOf(lvp) ?? "son propriétaire";
    <div class="modal-backdrop" @onclick="() => leaving = null"></div>
    <div class="modal" role="dialog" aria-modal="true" aria-labelledby="lvp-title">
