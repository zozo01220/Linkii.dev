    private void LeaveShared()
    {
        if (leaving is not { } p) return;
        string? err;
        try { err = Store.Write(d => ItemShareOps.Leave(d, ShareKind.Playlist, p.Id)); }
        catch (UnauthorizedAccessException e) { err = e.Message; }
        leaving = null;
        if (err != null) { Toast.Error(err); return; }
        Toast.Ok($"« {p.Name} » n'apparaît plus dans vos partages.");
        Load();
    }

    // Emplacement d'une liste : chemin de son dossier, ou la racine de l'aire
    private string PathOf(Playlist p)
    {
        if (p.FolderId is not { } fid || folderRows.FirstOrDefault(r => r.Folder.Id == fid) is not { } row) return !multi ? "Listes de lecture" : OwnerOf(p) is { } ow ? $"Listes de {ow}" : "Mes listes";
        var names = new List<string>();
        for (var cur = row; cur != null && names.Count < FolderAccess.MaxDepth; cur = cur.Folder.ParentId is { } pid ? folderRows.FirstOrDefault(r => r.Folder.Id == pid) : null)
            names.Insert(0, cur.Folder.Name);
        return string.Join(" › ", names);
    }

    private string RightLabel(PlaylistFolderRow r) =>
        r.Folder.OwnerId == Store.UserId ? (r.Shared ? "Votre dossier" : "Votre dossier · privé")
        : r.Right switch
        {
            FolderRight.Read => $"Lecture seule · dossier de {r.OwnerName}",
            FolderRight.Write => $"Écriture · dossier de {r.OwnerName}",
            _ => $"Administrateur · dossier de {r.OwnerName}"
        };

    private string FolderTitle(PlaylistFolderRow r) => (r.Folder.OwnerId == Store.UserId ? "Votre dossier" : $"Dossier de {r.OwnerName}") + (r.Right == FolderRight.Read ? " · lecture seule" : r.Shared ? " · partagé" : " · privé");

    private static string Plural(int n, string one, string many) => $"{n} {(n > 1 ? many : one)}";

    // Même nom qu'une autre liste de l'aire : les écrans proposent les listes par leur nom
    private bool DuplicateName(string name)
    {
        var n = name.Trim();
        return n.Length > 0 && playlists.Any(p => p.Id != renamingPl?.Id && string.Equals(p.Name.Trim(), n, StringComparison.CurrentCultureIgnoreCase));
    }

    private void OpenCreate() { newMenu = false; renamingPl = null; newName = ""; creating = true; focusName = true; }

    private void OpenNewFolder() { newMenu = false; newFolderName = ""; folderError = null; creatingFolder = true; }

    private void OpenRename(Playlist p) { menuFor = null; renamingPl = p; newName = p.Name; creating = true; focusName = true; }

    private void CloseName() { creating = false; renamingPl = null; }

    // Glisser-déposer : une liste, ou toutes les listes sélectionnées, vers un dossier (ou la racine de l'aire, null)
    private List<Guid> dragIds = new();
    private Guid? dropOver;
    private bool CanDrag(Playlist p) => foldersOn && CanEdit(p);
    private void StartDrag(Playlist p)
    {
        dragIds = picked.Contains(p.Id) ? PickedEditable().Select(x => x.Id).ToList() : new List<Guid> { p.Id };
    }
    private Guid? dragFolder;                                    // dossier qu'on glisse sur un autre (PC)
    private (Guid Id, string Name)? reparenting;                 // fenêtre « Déplacer le dossier »
    private void EndDrag() { dragIds = new(); dragFolder = null; dropOver = null; }
    private void MovedFolder(bool moved) { reparenting = null; if (moved) Load(); }
    private void DropOn(Guid? target)
    {
        if (dragFolder is { } df)   // un dossier glissé sur un autre : il y entre
        {
            EndDrag();
            if (target is { } t && t != df) { var err = Library.MoveFolder(df, t); if (err != null) Toast.Error(err); else Toast.Ok("Dossier déplacé."); Load(); }
            return;
        }
        DropLists(target);
    }

    private void DropLists(Guid? target)
    {
        var ids = dragIds.ToList();
        EndDrag();
        if (ids.Count == 0) return;
        var (moved, refused) = Library.MoveLists(ids, target);
        if (refused.Count > 0) Toast.Error(refused[0] + (refused.Count > 1 ? $" (et {refused.Count - 1} autre{(refused.Count > 2 ? "s" : "")})" : ""));
        if (moved > 0) { picked.Clear(); Toast.Ok(moved > 1 ? $"{moved} listes rangées." : "Liste rangée."); }
        Load();
    }

    private void OpenFolder(Guid? id)
    {
        folderId = id; menuFor = null; picked.Clear(); scopeAll = true;
        Load();
    }

    // Dossiers : chemin jusqu'au dossier ouvert, enfants visibles et contenus directs
    private List<PlaylistFolderRow> BuildCrumbs()
    {
        var list = new List<PlaylistFolderRow>();
        for (var cur = currentRow; cur != null && list.Count < FolderAccess.MaxDepth; cur = cur.Folder.ParentId is { } p ? folderRows.FirstOrDefault(r => r.Folder.Id == p) : null)
            list.Insert(0, cur);
        return list;
    }

    private int ChildCount(Guid id) => playlists.Count(p => p.FolderId == id) + folderRows.Count(r => r.Folder.ParentId == id);

    private string FolderUnit(Guid id) => FolderShape.UnitFor(playlists.Count(p => p.FolderId == id), folderRows.Count(r => r.Folder.ParentId == id), "liste", "listes");

    private static readonly System.Globalization.CultureInfo Fr = new("fr-FR");

    // Sous le nom du dossier : la dernière modification d'une de ses listes, sinon sa création
    private string FolderDate(PlaylistFolderRow r)
    {
        var last = playlists.Where(p => p.FolderId == r.Folder.Id && p.UpdatedAt != null).Max(p => p.UpdatedAt);
        var d = (last ?? r.Folder.CreatedUtc).ToLocalTime();
        return (last != null ? "modifié le " : "créé le ") + d.ToString(d.Year == DateTime.Now.Year ? "d MMM" : "d MMM yyyy", Fr);
    }

    private void CreateFolder()
    {
        var (error, _) = Library.CreateFolder(newFolderName, folderId);
        if (error != null) { folderError = error; return; }
        creatingFolder = false;
        Toast.Ok($"Dossier « {newFolderName.Trim()} » créé.");
        Load();
    }

    private void RenameFolder(PlaylistFolderRow rf)
    {
        var error = Library.RenameFolder(rf.Folder.Id, renameFolderValue);
        if (error != null) { folderError = error; return; }
        renamingFolder = null;
        Toast.Ok("Dossier renommé.");
        Load();
    }

    private void DeleteFolder(PlaylistFolderRow df)
    {
        var error = Library.DeleteFolder(df.Folder.Id);
        deletingFolder = null;
        if (error != null) { Toast.Error(error); return; }
        if (folderId == df.Folder.Id) folderId = df.Folder.ParentId;
        Toast.Ok($"Dossier « {df.Folder.Name} » supprimé.");
        Load();
    }

    // ---------- Clavier : « / » recherche, Échap ferme le menu ou désélectionne ----------
    private DotNetObjectReference<Playlists>? selfRef;
    private bool inApp;   // look « app » : appui long = menu de la carte

    // les trois dernières listes d'un dossier, avec un aperçu : vignettes de sa carte (look app)
    private List<MediaItem> FolderPreview(Guid folder) => playlists.Where(p => p.FolderId == folder).OrderByDescending(p => p.UpdatedAt ?? DateTime.MinValue)
        .Select(p => Tiles(p).FirstOrDefault()).Where(m => m != null).Take(3).ToList()!;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            selfRef = DotNetObjectReference.Create(this);
            try { inApp = await JS.InvokeAsync<bool>("linkiiPrefs.isApp"); if (inApp) StateHasChanged(); } catch (JSException) { } catch (InvalidOperationException) { }
            try { await JS.InvokeVoidAsync("linkiiLibrary.attach", selfRef, false); } catch (JSException) { } catch (InvalidOperationException) { }
        }
        if (focusName && creating) { focusName = false; await nameInput.FocusAsync(); }
    }

    [JSInvokable]
    public Task Escape() => InvokeAsync(() =>
    {
        if (menuFor != null || newMenu) { menuFor = null; newMenu = false; }
        else if (picked.Count > 0) picked.Clear();
        else return;
        StateHasChanged();
    });

    [JSInvokable]
    public Task Drag(bool on) => Task.CompletedTask;   // pas de dépôt de fichiers sur cette page

    public async ValueTask DisposeAsync()
    {
        if (selfRef == null) return;
        try { await JS.InvokeVoidAsync("linkiiLibrary.detach", selfRef); } catch (JSException) { } catch (JSDisconnectedException) { } catch (InvalidOperationException) { }
        selfRef.Dispose();
    }

    private void OnCreateKey(KeyboardEventArgs e)
    {
        if (e.Key == "Enter") SubmitName();
        else if (e.Key == "Escape") CloseName();
    }

    private void SubmitName()
    {
        var name = newName.Trim();
        if (name.Length == 0) return;
        if (renamingPl is { } r)
        {
            var renamed = Store.Write(d =>
            {
                var p = d.Playlists.FirstOrDefault(x => x.Id == r.Id);
                if (p == null || !PlaylistOps.CanEdit(d, p)) return false;
                p.Name = name; p.UpdatedAt = DateTime.UtcNow;   // le nom n'est pas diffusé
                return true;
            });
            if (!renamed) Toast.Error("Vous ne pouvez pas renommer cette liste de lecture.");
            else Toast.Ok($"Liste de lecture renommée en « {name} ».");
            CloseName();
            Load();
            return;
        }
        var created = new Playlist { Name = name, UpdatedAt = DateTime.UtcNow };
        var ok = Store.Write(d =>
        {
            if (folderId is { } fid)
            {
                if (PlaylistFolderOps.Find(d, fid) is not { } f || PlaylistFolderOps.RightOf(d, f) < FolderRight.Write) return false;
                created.FolderId = fid;
            }
            d.Playlists.Add(created);
            return true;
        });
        if (!ok) { Toast.Error("Vous ne pouvez pas créer de liste dans ce dossier."); CloseName(); return; }
        Toast.Ok($"Liste de lecture « {name} » créée.");
        CloseName();
        Nav.NavigateTo($"/playlists/{created.Id}");
    }

    // Copie du contenu (nouveaux identifiants d'éléments) ; la copie n'est choisie sur aucun écran. Elle reste dans le dossier de l'original si on peut y écrire.
    private void Duplicate(Playlist src)
    {
        menuFor = null;
        var where = Store.Write(d => d.Playlists.FirstOrDefault(x => x.Id == src.Id) is { } p ? PlaylistOps.Copy(d, p) : null);
        if (where == null) return;
        Toast.Ok(where.FolderId == src.FolderId ? $"Liste de lecture « {src.Name} » dupliquée." : $"Liste de lecture « {src.Name} » dupliquée dans vos listes (dossier en lecture seule).");
        Load();
    }

    private void DuplicatePicked()
    {
        var ids = picked.ToList();
        var n = Store.Write(d => ids.Select(id => d.Playlists.FirstOrDefault(x => x.Id == id)).Where(p => p != null).Select(p => PlaylistOps.Copy(d, p!)).Count());
        picked.Clear();
        Toast.Ok(n > 1 ? $"{n} listes de lecture dupliquées." : "Liste de lecture dupliquée.");
        Load();
    }

    // Les écrans qui la diffusent gardent leur instantané publié ; elle n'est simplement plus choisie (modification en attente sur ces écrans).
    // Seules les listes que la personne peut modifier sont retirées.
    private void Delete(List<Playlist> list)
    {
        var requested = list.Select(x => x.Id).ToHashSet();
        var removed = Store.Write(d =>
        {
            var ids = d.Playlists.Where(p => requested.Contains(p.Id) && PlaylistOps.CanDelete(d, p)).Select(p => p.Id).ToList();
            PlaylistOps.Remove(d, ids);
            return ids;
        });
        var names = list.Where(x => removed.Contains(x.Id)).ToList();
        if (names.Count > 1) Toast.Ok($"{names.Count} listes de lecture supprimées.");
        else if (names.Count == 1) Toast.Ok($"Liste de lecture « {names[0].Name} » supprimée.");
        else Toast.Error("Vous ne pouvez pas supprimer ces listes de lecture.");
        deleting = null;
        picked.ExceptWith(removed);
        Load();
    }


    // Durée d'une boucle : les contenus « jusqu'à la fin » comptent pour la durée de la vidéo quand elle est connue.
    private int TotalSeconds(Playlist p) => p.Draft.Where(i => i.Placement == "full" && !i.Off).Sum(i =>
    {
        var m = media.FirstOrDefault(x => x.Id == i.MediaId);
        if (Svc.IsIncomplete(m)) return 0;   // ajouté à vide : pas encore diffusé
        return Helpers.ItemSeconds(i, m, Svc.Find(m?.AppId), media);
    });

    private static string? Ago(Playlist p)
    {
        if (p.UpdatedAt is not { } at) return null;   // playlists créées avant le suivi des modifications
        var ago = DateTime.UtcNow - at;
        return ago.TotalMinutes < 1 ? "à l'instant"
            : ago.TotalHours < 1 ? $"il y a {(int)ago.TotalMinutes} min"
            : ago.TotalDays < 1 ? $"il y a {(int)ago.TotalHours} h"
            : ago.TotalDays < 2 ? "hier"
            : ago.TotalDays < 30 ? $"il y a {(int)ago.TotalDays} j"
            : $"le {at.ToLocalTime():d MMM yyyy}";
    }
