@page "/playlists"
@attribute [Microsoft.AspNetCore.Authorization.Authorize(Policy = "Page:playlists")]
@implements IAsyncDisposable
@using Microsoft.JSInterop
@inject TenantStore Store
@inject AppService Svc
@inject PlaylistLibrary Library
@inject MediaLibrary MediaLib
@inject NavigationManager Nav
@inject Toaster Toast
@inject IJSRuntime JS

@* Listes de lecture épurées (§51) : le fil d'Ariane est le titre, une ligne d'état, une ligne d'outils, les dossiers en puces,
   des cartes qui disent l'essentiel (une ligne de méta, un état de diffusion) et une barre de sélection flottante. *@
<div class="lx-top">
    <h1>
        @if (foldersOn && currentRow is { } cur)
        {
            <button type="button" class="lx-crumb @(dropOver == RootDrop ? "drop-target" : "")" @onclick="() => OpenFolder(null)"
                    @ondragover="() => { }" @ondragover:preventDefault="true" @ondragenter="() => { if (dragIds.Count > 0) dropOver = RootDrop; }" @ondragleave="() => { if (dropOver == RootDrop) dropOver = null; }" @ondrop:preventDefault="true" @ondrop="() => DropOn(null)">Listes de lecture</button>
            @foreach (var c in crumbs.Take(crumbs.Count - 1))
            {
                var row = c;
                <span class="lx-sl">/</span>
                <button type="button" class="lx-crumb @(dropOver == row.Folder.Id ? "drop-target" : "")" @onclick="() => OpenFolder(row.Folder.Id)"
                        @ondragover="() => { }" @ondragover:preventDefault="true" @ondragenter="() => { if (dragIds.Count > 0) dropOver = row.Folder.Id; }" @ondragleave="() => { if (dropOver == row.Folder.Id) dropOver = null; }" @ondrop:preventDefault="true" @ondrop="() => DropOn(row.Folder.Id)">@row.Folder.Name</button>
            }
            <span class="lx-sl">/</span>
            <span>@cur.Folder.Name</span>
            <span class="lx-right @(cur.Right == FolderRight.Read ? "ro" : "")"><Ico Name="@(cur.Right == FolderRight.Read ? "lock" : "folder")" Size="12" /> @RightLabel(cur)</span>
            <SharePill Audience="AudienceOf(cur.Folder.Id)" Long="true" Clickable="cur.Right == FolderRight.Owner || cur.Folder.OwnerId == Store.UserId" ReadOnly="cur.Right == FolderRight.Read" OwnerName="@(cur.Folder.OwnerId == Store.UserId ? null : cur.OwnerName)" OnClick="() => sharingId = cur.Folder.Id" />
        }
        else
        {
            <span>Listes de lecture</span>
        }
    </h1>
    <span class="grow"></span>
    <div class="btns">
        @if (currentRow is { } here && (here.Right == FolderRight.Owner || here.Folder.OwnerId == Store.UserId))
        {
            <button class="btn ghost sm" @onclick="() => sharingId = here.Folder.Id"><Ico Name="users" Size="14" /> Partager…</button>
        }
        @if (CanCreateListHere)
        {
            <div class="lx-split">
                <button class="btn" @onclick="OpenCreate"><Ico Name="plus" Size="16" /> Nouvelle liste</button>
                @if (foldersOn && CanCreateFolderHere)
                {
                    <button class="btn lx-car" aria-label="Autres créations" aria-haspopup="menu" aria-expanded="@(newMenu ? "true" : "false")" @onclick="() => newMenu = !newMenu"><Ico Name="chevron" Size="14" /></button>
                    @if (newMenu)
                    {
                        <div class="kebab-backdrop" @onclick="() => newMenu = false"></div>
                        <div class="kebab-menu" role="menu">
                            <button type="button" role="menuitem" @onclick="() => { newMenu = false; OpenCreate(); }"><Ico Name="play" Size="16" /> Nouvelle liste de lecture</button>
                            <button type="button" role="menuitem" @onclick="OpenNewFolder"><Ico Name="folder" Size="16" /> Nouveau dossier@(currentRow is { } cf ? $" dans « {cf.Folder.Name} »" : "")</button>
                        </div>
                    }
                }
            </div>
        }
        else if (foldersOn && CanCreateFolderHere)
        {
            <button class="btn ghost" @onclick="OpenNewFolder"><Ico Name="folder" Size="16" /> Nouveau dossier</button>
        }
    </div>
</div>

<div class="lx-status">
    <span>@Plural(playlists.Count, "liste", "listes")@(foldersOn && folderRows.Count > 0 ? $" · {Plural(folderRows.Count, "dossier", "dossiers")}" : "")</span>
    @if (PendingCount > 0)
    {
        <span><i class="lx-dot warn"></i>@(PendingCount > 1 ? $"{PendingCount} listes ont des modifications non publiées" : "1 liste a des modifications non publiées") <button type="button" class="linklike" @onclick='() => SetFilter("pending")'>Voir</button></span>
    }
    @if (currentRow is { Right: FolderRight.Read })
    {
        <span>Vous pouvez voir, essayer et diffuser ces listes, pas les modifier. Dupliquez-en une pour l'adapter.</span>
    }
</div>

@if (playlists.Count == 0 && subfolders.Count == 0)
{
    <div class="empty">
        <div class="big">Aucune liste de lecture</div>
        <p>Une liste de lecture est une boucle de contenus (images, vidéos, apps). Composez-la, puis choisissez-la sur vos écrans et publiez.</p>
        @if (CanCreateListHere) { <button class="btn" @onclick="OpenCreate"><Ico Name="plus" Size="16" /> Créer une liste de lecture</button> }
    </div>
}
else
{
    <div class="lx-tools" role="region" aria-label="Recherche et filtres">
        <div class="search-box">
            <Ico Name="search" Size="16" />
            <input data-lx-search placeholder="@(foldersOn ? "Rechercher dans toutes les listes" : "Rechercher des listes de lecture")" aria-label="Rechercher des listes de lecture" @bind="search" @bind:event="oninput" />
        </div>
        <div class="seg-chips" role="group" aria-label="Utilisation des listes de lecture" style="display:contents">
            <button type="button" class="lx-chip @(filter == "" ? "on" : "")" aria-pressed="@(filter == "" ? "true" : "false")" @onclick='() => SetFilter("")'>Toutes</button>
            <button type="button" class="lx-chip @(filter == "used" ? "on" : "")" aria-pressed="@(filter == "used" ? "true" : "false")" title="Choisies sur un écran ou programmées dans un planning" @onclick='() => SetFilter("used")'>Utilisées <small>@playlists.Count(p => Use(p).Used)</small></button>
            @if (PendingCount > 0 || filter == "pending")
            {
                <button type="button" class="lx-chip @(filter == "pending" ? "on" : "")" aria-pressed="@(filter == "pending" ? "true" : "false")" title="Modifiées depuis leur publication : les écrans diffusent encore l'ancienne version" @onclick='() => SetFilter("pending")'>À publier <small>@PendingCount</small></button>
            }
            <button type="button" class="lx-chip @(filter == "unused" ? "on" : "")" aria-pressed="@(filter == "unused" ? "true" : "false")" @onclick='() => SetFilter("unused")'>Non utilisées <small>@playlists.Count(p => !Use(p).Used)</small></button>
        </div>
        @if (foldersOn && folderId != null && Active)
        {
            <button type="button" class="lx-chip scope" title="Où chercher" @onclick="() => scopeAll = !scopeAll">Dans : @(scopeAll ? "toute l'aire" : "ce dossier") <Ico Name="refresh" Size="13" /></button>
        }
        <span class="grow"></span>
        @if (Active) { <span class="lx-count" aria-live="polite">@Plural(Sorted.Count(), "résultat", "résultats")</span> }
        <select @bind="sort" aria-label="Trier">
            <option value="recent">Récentes</option>
            <option value="name">Nom</option>
            <option value="used">Plus utilisées</option>
        </select>
        <ViewToggle StorageKey="playlists" @bind-Value="view" />
    </div>

    @* Dossiers de la position ouverte : puces compactes, cibles du glisser-déposer *@
    @if (subfolders.Count > 0)
    {
        <div class="lx-folders">
            @foreach (var row in subfolders)
            {
                var r = row;
                var inside = ChildCount(r.Folder.Id);
                var mine = r.Folder.OwnerId == Store.UserId;
                <div class="lx-fchip @(r.Shared ? "" : "priv") @(dropOver == r.Folder.Id ? "drop-target" : "")" role="button" tabindex="0" title="@FolderTitle(r)" aria-label="Ouvrir le dossier @r.Folder.Name" @onclick="() => OpenFolder(r.Folder.Id)" @onkeydown='e => { if (e.Key == "Enter") OpenFolder(r.Folder.Id); }'
                     @ondragover="() => { }" @ondragover:preventDefault="true" @ondragenter="() => { if (dragIds.Count > 0) dropOver = r.Folder.Id; }" @ondragleave="() => { if (dropOver == r.Folder.Id) dropOver = null; }" @ondrop:preventDefault="true" @ondrop="() => DropOn(r.Folder.Id)">
                    <Ico Name="folder" Size="17" />
                    <span class="nm">@r.Folder.Name</span>
                    <small>@inside</small>
                    <SharePill Audience="AudienceOf(r.Folder.Id)" Clickable="mine || isAdmin" ReadOnly="r.Right == FolderRight.Read" OwnerName="@(mine ? null : r.OwnerName)" OnClick="() => sharingId = r.Folder.Id" />
                    @if (mine || isAdmin)
                    {
                        <div class="kebab" @onclick:stopPropagation="true">
                            <button type="button" class="kebab-btn" aria-label="Actions pour le dossier @r.Folder.Name" aria-haspopup="menu" aria-expanded="@(menuFor == r.Folder.Id ? "true" : "false")"
                                    @onclick="() => menuFor = menuFor == r.Folder.Id ? null : r.Folder.Id"><Ico Name="dots-v" Size="16" /></button>
                            @if (menuFor == r.Folder.Id)
                            {
                                <div class="kebab-backdrop" @onclick="() => menuFor = null"></div>
                                <div class="kebab-menu" role="menu">
                                    <span class="kebab-note">@(mine ? "Votre dossier" : $"Dossier de {r.OwnerName}") · @(r.Shared ? "partagé" : "privé")</span>
                                    <button type="button" role="menuitem" @onclick="() => { menuFor = null; sharingId = r.Folder.Id; }"><Ico Name="users" Size="16" /> Partager…</button>
                                    @if (r.Right == FolderRight.Owner)
                                    {
                                        <button type="button" role="menuitem" @onclick="() => { menuFor = null; renamingFolder = r; renameFolderValue = r.Folder.Name; folderError = null; }"><Ico Name="edit" Size="16" /> Renommer</button>
                                        <button type="button" role="menuitem" class="danger" @onclick="() => { menuFor = null; deletingFolder = r; }"><Ico Name="trash" Size="16" /> Supprimer</button>
                                    }
                                </div>
                            }
                        </div>
                    }
                </div>
            }
        </div>
    }

    @if (!Sorted.Any())
    {
        @if (Active) { <div class="empty"><div class="big">Aucune liste ne correspond</div><button class="btn ghost sm" @onclick='() => { search = ""; filter = ""; }'>Effacer la recherche et les filtres</button></div> }
        else if (subfolders.Count == 0 && folderId != null) { <div class="empty"><div class="big">Ce dossier est vide</div>@if (CanCreateListHere) { <p>Créez-y une liste, ou glissez-y des listes depuis « Listes de lecture ».</p> }</div> }
    }
    else
    {
        @if (view == "list")
        {
        <div class="lx-tbl-wrap">
            <table class="lx-tbl @(picked.Count > 0 ? "lx-selecting" : "")">
                <thead>
                    <tr>
                        <th style="width:34px"><input type="checkbox" class="sc-check lx-check" checked="@AllPicked" @onchange="ToggleAll" aria-label="Tout sélectionner" /></th>
                        <th><button type="button" class="@(sort == "name" ? "on" : "")" @onclick='() => sort = "name"'>Nom</button></th>
                        @if (foldersOn) { <th>Emplacement</th> }
                        <th class="num">Contenus</th>
                        <th class="num">Durée</th>
                        <th><button type="button" class="@(sort == "used" ? "on" : "")" @onclick='() => sort = "used"'>Diffusion</button></th>
                        <th><button type="button" class="@(sort == "recent" ? "on" : "")" @onclick='() => sort = "recent"'>Modifiée</button></th>
                        <th style="width:44px"><span class="sr-only">Actions</span></th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var p in Sorted)
                    {
                        var pl = p;
                        var tile = Tiles(pl).FirstOrDefault();
                        var total = TotalSeconds(pl);
                        <tr class="@(picked.Contains(pl.Id) ? "picked" : "") @(dragIds.Contains(pl.Id) ? "dragging" : "")" draggable="@(CanDrag(pl) ? "true" : "false")" @ondragstart="() => StartDrag(pl)" @ondragend="EndDrag">
                            <td><input type="checkbox" class="sc-check lx-check" aria-label="Sélectionner @pl.Name" checked="@picked.Contains(pl.Id)" @onchange="() => Toggle(pl.Id)" /></td>
                            <td><div class="nm"><span class="mini">@if (tile != null) { <MediaThumb Media="tile" All="media" /> } else { <Ico Name="image" Size="16" /> }</span><a href="/playlists/@pl.Id">@pl.Name</a>@if (RightOfList(pl) == FolderRight.Read) { <span title="Lecture seule"><Ico Name="lock" Size="13" /></span> }</div></td>
                            @if (foldersOn) { <td><small>@PathOf(pl)</small></td> }
                            <td class="num">@pl.Draft.Count</td>
                            <td class="num">@(total > 0 ? Helpers.FormatDuration(total) : "—")</td>
                            <td>@State(pl)</td>
                            <td><small>@(Ago(pl) ?? "—")</small></td>
                            <td>@Menu(pl)</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
        }
        @* sur mobile, toujours en cartes (pas de bascule) *@
        <div class="lx-pgrid @(picked.Count > 0 ? "lx-selecting" : "") @(view == "list" ? "lx-mobile-only" : "")">
            @foreach (var p in Sorted)
            {
                var pl = p;
                var tiles = Tiles(pl).Take(3).ToList();
                var total = TotalSeconds(pl);
                <div class="lx-pc @(picked.Contains(pl.Id) ? "picked" : "") @(dragIds.Contains(pl.Id) ? "dragging" : "")"
                     draggable="@(CanDrag(pl) ? "true" : "false")" @ondragstart="() => StartDrag(pl)" @ondragend="EndDrag">
                    <input type="checkbox" class="sc-check lx-check" aria-label="Sélectionner @pl.Name" checked="@picked.Contains(pl.Id)" @onchange="() => Toggle(pl.Id)" />
                    @if (tiles.Count == 0)
                    {
                        <a class="pl-cover lx-empty" href="/playlists/@pl.Id" tabindex="-1" aria-hidden="true"><Ico Name="plus" Size="15" /> @(pl.Draft.Count == 0 ? "Ajouter des contenus" : "Aperçu indisponible")</a>
                    }
                    else
                    {
                        <a class="pl-cover @(tiles.Count <= 1 ? "single" : "")" href="/playlists/@pl.Id" tabindex="-1" aria-hidden="true">
                            @foreach (var m in tiles) { <div class="pl-tile"><MediaThumb Media="m" All="media" /></div> }
                        </a>
                    }
                    @if (RightOfList(pl) == FolderRight.Read) { <span class="lx-lock" title="Dans un dossier partagé en lecture seule"><Ico Name="lock" Size="13" /></span> }
                    @if (pl.Draft.Count > 0) { <button type="button" class="lx-try" @onclick="() => trying = pl.Id"><Ico Name="play" Size="13" /> Essayer</button> }
                    <div class="lx-pbody">
                        <div class="grow">
                            <a class="pl-name" href="/playlists/@pl.Id" title="@pl.Name">@pl.Name</a>
                            <div class="lx-meta">@Meta(pl, total)</div>
                            @if (ShowPath) { <div class="lx-path"><Ico Name="folder" Size="12" /><span>@PathOf(pl)</span></div> }
                            @State(pl)
                        </div>
                        @Menu(pl)
                    </div>
                </div>
            }
        </div>
    }

    @if (picked.Count > 0)
    {
        var editable = PickedEditable();
        var locked = picked.Count - editable.Count;
        <div class="lx-selbar" role="region" aria-label="Sélection">
            <b>@picked.Count sélectionnée@(picked.Count > 1 ? "s" : "")</b>
            <button type="button" @onclick="ToggleAll">@(AllPicked ? "Tout désélectionner" : $"Tout sélectionner ({Sorted.Count()})")</button>
            <span class="vr"></span>
            @if (foldersOn) { <button type="button" disabled="@(editable.Count == 0)" title="@(editable.Count == 0 ? "Aucune liste modifiable dans la sélection" : null)" @onclick="() => listMove = editable"><Ico Name="folder" Size="15" /><span class="lx-lbl">Ranger…</span></button> }
            @if (canMove) { <button type="button" @onclick="() => bulkMove = true"><Ico Name="move" Size="15" /><span class="lx-lbl">Autre aire…</span></button> }
            <button type="button" @onclick="DuplicatePicked"><Ico Name="copy" Size="15" /><span class="lx-lbl">Dupliquer</span></button>
            <span class="vr"></span>
            <button type="button" class="del" disabled="@(editable.Count == 0)" title="@(editable.Count == 0 ? "Ces listes sont dans un dossier en lecture seule" : null)"
                    @onclick="() => deleting = playlists.Where(x => picked.Contains(x.Id)).ToList()">
                <Ico Name="trash" Size="15" /> Supprimer@(locked > 0 && editable.Count > 0 ? $" {editable.Count}" : "")@if (locked > 0) { <small>(@locked en lecture seule)</small> }
            </button>
            <span class="vr"></span>
            <button type="button" title="Tout désélectionner (Échap)" aria-label="Tout désélectionner" @onclick="() => picked.Clear()"><Ico Name="x" Size="15" /></button>
        </div>
    }
}

@if (creating)
{
    var dup = DuplicateName(newName);
    <div class="modal-backdrop" @onclick="CloseName"></div>
    <div class="modal" role="dialog" aria-modal="true" aria-labelledby="create-title">
        <h3 id="create-title">@(renamingPl == null ? "Nouvelle liste de lecture" : "Renommer la liste de lecture")</h3>
        <p class="hint">@(renamingPl == null ? "Donnez-lui un nom, vous ajouterez les contenus ensuite." : "Le nouveau nom s'affiche dans le back-office uniquement.")</p>
        <input style="width:100%" @ref="nameInput" @bind="newName" @bind:event="oninput" @onkeydown="OnCreateKey" placeholder="Ex. Accueil, vitrine, salle d'attente" />
        @if (dup) { <p class="hint" style="color:var(--warn-ink)">Une autre liste de l'aire porte déjà ce nom : sur les écrans, on ne saura pas laquelle choisir.</p> }
        <div class="modal-actions">
            <button class="btn ghost" @onclick="CloseName">Annuler</button>
            <button class="btn" disabled="@string.IsNullOrWhiteSpace(newName)" @onclick="SubmitName">@(renamingPl == null ? "Créer" : "Renommer")</button>
        </div>
    </div>
}

@if (creatingFolder)
{
    <div class="modal-backdrop" @onclick="() => creatingFolder = false"></div>
    <div class="modal" role="dialog" aria-modal="true" aria-labelledby="nfp-title">
        <h3 id="nfp-title">Nouveau dossier@(folderId is { } ? $" dans « {currentRow?.Folder.Name} »" : "")</h3>
        <input style="width:100%;margin-top:10px" placeholder="Nom du dossier" maxlength="60" aria-label="Nom du dossier" @bind="newFolderName" @bind:event="oninput" @onkeydown='e => { if (e.Key == "Enter") CreateFolder(); }' />
        @if (folderError != null) { <div class="err">@folderError</div> }
        <p class="hint">Privé à votre nom : partagez-le ensuite avec d'autres membres, en lecture ou en écriture.</p>
        <div class="modal-actions">
            <button class="btn ghost" @onclick="() => creatingFolder = false">Annuler</button>
            <button class="btn" disabled="@string.IsNullOrWhiteSpace(newFolderName)" @onclick="CreateFolder">Créer</button>
        </div>
    </div>
}

@if (renamingFolder is { } rf)
{
    <div class="modal-backdrop" @onclick="() => renamingFolder = null"></div>
    <div class="modal" role="dialog" aria-modal="true" aria-labelledby="rnfp-title">
        <h3 id="rnfp-title">Renommer le dossier</h3>
        <input style="width:100%;margin-top:10px" maxlength="60" aria-label="Nom du dossier" @bind="renameFolderValue" @bind:event="oninput" @onkeydown='e => { if (e.Key == "Enter") RenameFolder(rf); }' />
        @if (folderError != null) { <div class="err">@folderError</div> }
        <div class="modal-actions">
            <button class="btn ghost" @onclick="() => renamingFolder = null">Annuler</button>
            <button class="btn" disabled="@string.IsNullOrWhiteSpace(renameFolderValue)" @onclick="() => RenameFolder(rf)">Renommer</button>
        </div>
    </div>
}

@if (deletingFolder is { } df)
{
    var inside = playlists.Where(p => p.FolderId == df.Folder.Id).ToList();
    var impact = PlaylistUses.Impact(inside.Select(p => p.Id).ToList(), allScreens, areas);
    <div class="modal-backdrop" @onclick="() => deletingFolder = null"></div>
    <div class="modal" role="alertdialog" aria-modal="true" aria-labelledby="dfp-title">
        <h3 id="dfp-title">Supprimer le dossier « @df.Folder.Name » ?</h3>
        <p class="hint">Le dossier, ses sous-dossiers et leurs listes@(inside.Count > 0 ? $" ({inside.Count} visible{(inside.Count > 1 ? "s" : "")} ici)" : "") seront supprimés. Les contenus restent dans la médiathèque. Cette action est définitive.</p>
        <DeleteImpactBox Impact="impact" />
        <div class="modal-actions">
            <button class="btn ghost" @onclick="() => deletingFolder = null">Annuler</button>
            <button class="btn danger-solid" @onclick="() => DeleteFolder(df)">Supprimer</button>
        </div>
    </div>
}

@if (sharingId is { } shId)
{
    <PlaylistFolderShareDialog FolderId="shId" OnClose="() => { sharingId = null; Load(); StateHasChanged(); }" />
}

@if (listMove is { } lm)
{
    <PlaylistMoveDialog Items="lm" OnClose='n => { listMove = null; if (n > 0) { picked.Clear(); Toast.Ok(n > 1 ? $"{n} listes rangées." : "Liste rangée."); Load(); } }' />
}

@if (trying is { } tryId)
{
    <SimulatorDialog PlaylistId="tryId" OnClose="() => trying = null" />
}

@if (moving is { } mv)
{
    <AreaMoveDialog Kind="playlist" Items="new() { (mv.Id, mv.Name) }" OnClose="moved => { moving = null; if (moved) Load(); }" />
}
@if (bulkMove)
{
    <AreaMoveDialog Kind="playlist" Items="playlists.Where(x => picked.Contains(x.Id)).Select(x => (x.Id, x.Name)).ToList()" OnClose="moved => { bulkMove = false; if (moved) Load(); }" />
}

@if (deleting is { Count: > 0 } del)
{
    // Seules les listes modifiables partent ; les autres sont nommées, pour qu'on ne croie pas les avoir supprimées.
    var gone = del.Where(CanEdit).ToList();
    var kept = del.Where(x => !CanEdit(x)).ToList();
    var impact = PlaylistUses.Impact(gone.Select(x => x.Id).ToList(), allScreens, areas);
    <div class="modal-backdrop" @onclick="() => deleting = null"></div>
    <div class="modal" role="alertdialog" aria-modal="true" aria-labelledby="del-title">
        @if (gone.Count == 0)
        {
            <h3 id="del-title">Rien à supprimer</h3>
            <p class="hint">@(kept.Count > 1 ? "Ces listes sont" : "Cette liste est") dans un dossier partagé en lecture seule.</p>
            <div class="modal-actions"><button class="btn" @onclick="() => deleting = null">Fermer</button></div>
        }
        else
        {
            <h3 id="del-title">Supprimer @(gone.Count > 1 ? $"{gone.Count} listes de lecture" : $"« {gone[0].Name} »") ?</h3>
            <p class="hint">@(gone.Count > 1 && gone.Count <= 4 ? string.Join(", ", gone.Select(x => $"« {x.Name} »")) + ". " : "")Les contenus restent dans la médiathèque.</p>
            <DeleteImpactBox Impact="impact" />
            @if (kept.Count > 0)
            {
                <p class="hint"><Ico Name="lock" Size="13" /> Non supprimée@(kept.Count > 1 ? "s" : "") (lecture seule) : @string.Join(", ", kept.Select(x => $"« {x.Name} »")).</p>
            }
            <div class="modal-actions">
                <button class="btn ghost" @onclick="() => deleting = null">Annuler</button>
                <button class="btn danger-solid" @onclick="() => Delete(gone)">Supprimer@(gone.Count > 1 ? $" {gone.Count} listes" : "")</button>
            </div>
        }
    </div>
}

@code {
    private List<Playlist> playlists = new();
    private List<MediaItem> media = new();
    private string sort = "recent";
    private string view = "cards";   // cards | list (mémorisé dans le navigateur)
    private bool creating, newMenu;
    private string newName = "";
    private ElementReference nameInput;
