@page "/settings"
@attribute [Microsoft.AspNetCore.Authorization.Authorize(Policy = "ClientAdmin")]
@inject TenantStore Store
@inject JsonStore Root
@inject TenantContext Ctx
@inject Notifier Notifier
@inject NavigationManager Nav
@inject Toaster Toast

<div class="page-head">
    <div>
        <h1>Réglages</h1>
        <p class="sub">Paramètres globaux de votre organisation. Ils s'appliquent à tous les écrans.</p>
    </div>
    @if (Tab is "organisation" or "parametres" || Tab == "supervision" && growth) { <button class="btn" @onclick="Save">Enregistrer</button> }
</div>

<nav class="tabs" aria-label="Sections des réglages">
    @foreach (var (id, label) in Tabs)
    {
        <a class="@(Tab == id ? "on" : "")" href="/settings?tab=@id" aria-current="@(Tab == id ? "page" : null)">@label</a>
    }
</nav>


@switch (Tab)
{
    case "organisation":
        <div class="settings-grid">
            <div class="card">
                <h3>Organisation</h3>
                <p class="hint">Nom affiché dans le back-office. La couleur et le logo sont ceux de votre revendeur.</p>
                <label class="lbl">Nom de l'organisation</label>
                <input class="full" @bind="name" />
                <label class="lbl">Fuseau horaire <small>(horloge des écrans)</small></label>
                <select class="full" @bind="timezone">
                    @foreach (var tz in Timezones) { <option value="@tz">@tz</option> }
                </select>
            </div>
            <div class="card">
                <h3>Aires de gestion et membres</h3>
                <p class="hint">Répartissez vos écrans, listes de lecture et médias en aires (un site, un bâtiment, un service…) et invitez des personnes avec un rôle dans chaque aire. Tant qu'il n'y a qu'une aire et aucun membre, rien ne change.</p>
                <ul class="opt-list">
                    <li><Ico Name="map-pin" Size="16" /> <span class="grow">@areaCount aire@(areaCount > 1 ? "s" : "") de gestion</span><a href="/areas">@(areaCount > 1 ? "Gérer les aires et les zones" : "Créer une aire, des zones")</a></li>
                    <li><Ico Name="users" Size="16" /> <span class="grow">@memberCount membre@(memberCount > 1 ? "s" : "") en plus des administrateurs</span><a href="/members">@(memberCount > 0 ? "Gérer les membres" : "Inviter une personne")</a></li>
                </ul>
            </div>
        </div>
        break;

    case "parametres":
        <div class="settings-grid">
            <div class="card">
                <h3>Diffusion</h3>
                <p class="hint">Valeurs par défaut pour les contenus et les players.</p>
                <label class="lbl">Durée par défaut d'un contenu (secondes)</label>
                <input class="full" type="number" min="1" max="600" @bind="duration" />
                <label class="lbl">Redémarrage nocturne des players</label>
                <select class="full" @bind="reloadHour">
                    @for (var h = 0; h < 24; h++) { <option value="@h">@($"{h:00}:00")</option> }
                </select>
                <small>Évite les fuites de mémoire sur les clés HDMI.</small>
            </div>

            <div class="card">
                <h3>Nouveaux écrans</h3>
                <p class="hint">Préréglage à la création d'un écran (modifiable écran par écran).</p>
                <ScreenFormat Spec="spec" />
            </div>
        </div>
        break;

    case "supervision":
        @* Contrôle du direct et alertes : licence Growth. En licence de base, tout est visible mais verrouillé (bulle au survol). *@
        @if (!growth)
        {
            <div class="sv-upsell"><Ico Name="lock" Size="18" /><span class="grow">La supervision, le contrôle du direct (aperçu, pause, redémarrage) et les murs d'écrans sont inclus dans la licence <b>Growth</b>.</span></div>
        }
        <div class="settings-grid">
            <div class="card">
                <h3>Alertes par e-mail</h3>
                <p class="hint">Soyez prévenu quand un écran ne répond plus, sans ouvrir le back-office.</p>
                <div class="sv-row @(growth ? "" : "locked-row")" data-tip="@(growth ? null : Plans.LockedHint)">
                    <div class="t"><b>Prévenir par e-mail quand un écran tombe</b><small>Un seul e-mail par panne, puis un second quand l'écran revient en ligne.</small></div>
                    <div class="ctl"><button type="button" class="switch @(alertOffline ? "on" : "")" role="switch" aria-checked="@(alertOffline ? "true" : "false")" aria-label="Alertes e-mail" disabled="@(!growth)" @onclick="() => alertOffline = !alertOffline"><span></span></button></div>
                </div>
                <div class="sv-row @(growth ? "" : "locked-row")" data-tip="@(growth ? null : Plans.LockedHint)">
                    <div class="t"><b>Délai avant l'alerte</b><small>Durée pendant laquelle un écran doit rester hors ligne avant l'envoi de l'e-mail.</small></div>
                    <div class="ctl">
                        <select class="full" style="width:160px" @bind="alertMinutes" disabled="@(!growth || !alertOffline)">
                            @foreach (var (m, l) in AlertDelays) { <option value="@m">@l</option> }
                        </select>
                    </div>
                </div>
                <div class="sv-row @(growth ? "" : "locked-row")" data-tip="@(growth ? null : Plans.LockedHint)">
                    <div class="t"><b>Destinataires</b><small>Par défaut, tous les administrateurs de l'organisation.</small></div>
                    <div class="ctl" style="flex-direction:column;align-items:stretch;width:260px">
                        <select class="full" @bind="alertTarget" disabled="@(!growth || !alertOffline)">
                            <option value="admins">Tous les administrateurs</option>
                            <option value="custom">Une adresse dédiée…</option>
                        </select>
                        @if (alertTarget == "custom") { <input class="full" type="email" placeholder="alertes@exemple.ch" aria-label="Adresse des alertes" @bind="alertEmail" disabled="@(!growth || !alertOffline)" /> }
                    </div>
                </div>
            </div>
            <div class="card">
                <h3>Pause des écrans</h3>
                <p class="hint">Une pause se lance depuis la carte d'un écran (bouton Pause).</p>
                <div class="sv-row @(growth ? "" : "locked-row")" data-tip="@(growth ? null : Plans.LockedHint)">
                    <div class="t"><b>Reprise automatique après</b><small>Un écran en pause reprend seul au bout de ce délai : il ne reste jamais figé par oubli. Modifiable à chaque pause.</small></div>
                    <div class="ctl">
                        <select class="full" style="width:190px" @bind="pauseMinutes" disabled="@(!growth)">
                            @foreach (var (m, l) in PauseDelays) { <option value="@m">@l</option> }
                        </select>
                    </div>
                </div>
                <div class="sv-row @(growth ? "" : "locked-row")" data-tip="@(growth ? null : Plans.LockedHint)">
                    <div class="t"><b>Visuel affiché pendant la pause</b><small>Une image de votre médiathèque, sinon le visuel Linkii par défaut.</small></div>
                    <div class="ctl" style="flex:1;min-width:0">@if (growth) { <MediaField Field="pauseField" Values="pauseValues" /> } else { <span class="muted">Visuel Linkii par défaut</span> }</div>
                </div>
            </div>
            <div class="card">
                <h3>Appareil des écrans</h3>
                <p class="hint">Chaque écran remonte son système (par exemple Android 14), son modèle et la version de l'application. Ces informations s'affichent sur sa carte, dans toutes les licences.</p>
            </div>
        </div>
        break;

    case "compte":
        @if (Ctx.IsImpersonating)
        {
            <div class="card empty"><div class="big">Compte non modifiable</div><p>Vous consultez cet espace en tant qu'administrateur : le mot de passe reste celui du client.</p></div>
        }
        else
        {
            <div class="settings-grid">
                <div class="card">
                    <h3>Compte administrateur</h3>
                    <p class="hint">@email</p>
                    @if (externalProvider != null)
                    {
                        <p class="sso-note"><ProviderLogo Provider="@externalProvider" Size="16" /> Connexion avec le bouton « Continuer avec @SignupSources.Label(externalProvider) » : pas de mot de passe Linkii.</p>
                    }
                    else
                    {
                        <label class="lbl">Mot de passe actuel</label>
                        <input class="full" type="password" @bind="oldPwd" autocomplete="current-password" />
                        <label class="lbl">Nouveau mot de passe <small>(8 caractères minimum)</small></label>
                        <input class="full" type="password" @bind="newPwd" autocomplete="new-password" />
                        <div style="margin-top:12px"><button class="btn ghost" @onclick="ChangePassword">Changer le mot de passe</button></div>
                    }
                </div>
                <ConsentPrefs />
            </div>
        }
        break;
}


@code {
    [SupplyParameterFromQuery(Name = "tab")] public string? TabParam { get; set; }

    private static readonly (string Id, string Label)[] Tabs =
    {
        ("organisation", "Organisation"), ("parametres", "Paramètres"), ("supervision", "Supervision"), ("compte", "Compte"),
    };

    private static readonly (int Min, string Label)[] AlertDelays = { (5, "5 minutes"), (10, "10 minutes"), (15, "15 minutes"), (30, "30 minutes"), (60, "1 heure") };
    private static readonly (int Min, string Label)[] PauseDelays = { (15, "15 minutes"), (30, "30 minutes"), (60, "1 heure"), (240, "4 heures"), (0, "Jamais (reprise manuelle)") };

    // Supervision (Growth)
    private bool growth, alertOffline;
    private int alertMinutes = 10, pauseMinutes = 60;
    private string alertTarget = "admins", alertEmail = "";
    private readonly AppField pauseField = new() { Key = "pause", Type = "media", Accept = "image", Label = "Visuel de pause" };
    private Dictionary<string, string> pauseValues = new() { ["pause"] = "" };

    private static readonly string[] Timezones =
    {
        "Europe/Zurich", "Europe/Paris", "Europe/Brussels", "Europe/London", "Europe/Berlin", "Europe/Rome",
        "America/Montreal", "America/New_York", "Africa/Casablanca", "UTC"
    };

    private string Tab => Tabs.Any(t => t.Id == TabParam) ? TabParam! : "organisation";

    private string name = "", timezone = "", email = "";
    private int duration, reloadHour;
    private string oldPwd = "", newPwd = "";
    private string? externalProvider;   // compte Microsoft ou Google, sans mot de passe Linkii
    private ScreenSpec spec = new();
    private int areaCount, memberCount;

    protected override void OnInitialized()
    {
        // Ancien onglet « Applications » (liens enregistrés, retour de Canva) : devenu la page Intégrations.
        if (TabParam == "applications") { Nav.NavigateTo("/integrations" + new Uri(Nav.Uri).Query.Replace("tab=applications&", "").Replace("?tab=applications", ""), replace: true); return; }
        var t = Store.Read(d => d.Tenant);
        name = t.Name; timezone = t.Timezone; duration = t.DefaultDurationSec; reloadHour = t.ReloadHour;
        growth = t.IsGrowth; alertOffline = t.AlertOffline; alertMinutes = AlertDelays.Any(a => a.Min == t.AlertOfflineMinutes) ? t.AlertOfflineMinutes : 10;
        alertTarget = t.AlertEmail.Length > 0 ? "custom" : "admins"; alertEmail = t.AlertEmail;
        pauseMinutes = PauseDelays.Any(p => p.Min == t.PauseResumeMinutes) ? t.PauseResumeMinutes : 60;
        pauseValues["pause"] = t.PauseMediaId?.ToString() ?? "";
        if (Nav.Uri.Contains("saved=1")) Toast.Ok("Réglages enregistrés.");
        email = Ctx.Email;
        var uid = Ctx.UserId;
        externalProvider = Root.Read(d => d.Users.FirstOrDefault(u => u.Id == uid) is { HasPassword: false } u ? u.ExternalProvider : null);
        (areaCount, memberCount) = Store.Read(d => (d.Areas.Count, d.Users.Count(u => u.Role == Roles.ClientMember)));
        spec = ScreenSpec.From(t);
    }

    private async Task Save()
    {
        if (string.IsNullOrWhiteSpace(name)) { Toast.Error("Le nom de l'organisation est obligatoire."); return; }
        if (duration < 1) { Toast.Error("La durée par défaut doit être d'au moins 1 seconde."); return; }
        var target = alertTarget == "custom" ? alertEmail.Trim() : "";
        if (growth && alertOffline && alertTarget == "custom" && !System.Net.Mail.MailAddress.TryCreate(target, out _)) { Toast.Error("L'adresse des alertes n'est pas valide."); return; }
        var pauseImage = AppField.MediaIds(pauseValues.GetValueOrDefault("pause")) is { Count: > 0 } ids ? ids[0] : (Guid?)null;

        Store.Write(d =>
        {
            var t = d.Tenant;
            t.Name = name.Trim(); t.Timezone = timezone;
            t.DefaultDurationSec = duration; t.ReloadHour = reloadHour;
            t.DefaultScreenType = spec.Type; t.DefaultOrientation = spec.Orientation; t.DefaultResolution = spec.Resolution;
            if (t.IsGrowth)   // supervision : licence Growth (contrôlée ici aussi, pas seulement dans l'interface)
            {
                t.AlertOffline = alertOffline; t.AlertOfflineMinutes = alertMinutes; t.AlertEmail = target;
                t.PauseResumeMinutes = pauseMinutes;
                t.PauseMediaId = pauseImage is { } pm && d.Media.Any(m => m.Id == pm && m.Type == "image") ? pauseImage : null;
            }
        });
        await Notifier.NotifyClient(Store.ClientId);   // fuseau / redémarrage : les écrans rechargent leur configuration
        Nav.NavigateTo($"/settings?tab={Tab}&saved=1", forceLoad: true);
    }

    private void ChangePassword()
    {
        var uid = Ctx.UserId;
        var hash = Root.Read(d => d.Users.FirstOrDefault(u => u.Id == uid)?.PasswordHash ?? "");
        if (Ctx.IsImpersonating || !Passwords.Verify(hash, oldPwd)) { Toast.Error("Mot de passe actuel incorrect."); return; }
        if (newPwd.Length < 8) { Toast.Error("Le nouveau mot de passe est trop court (8 caractères minimum)."); return; }
        Root.Write(d => { d.Users.First(u => u.Id == uid).PasswordHash = Passwords.Hash(newPwd); });
        oldPwd = newPwd = "";
        Toast.Ok("Mot de passe modifié.");
    }
}
