@page "/settings"
@attribute [Microsoft.AspNetCore.Authorization.Authorize(Policy = "ClientAdmin")]
@inject TenantStore Store
@inject JsonStore Root
@inject TenantContext Ctx
@inject Notifier Notifier
@inject NavigationManager Nav
@inject Toaster Toast
@inject AppService Apps
@inject PresentationMerge Merge
@inject ModeService Modes

@* Réglages : navigation latérale groupée, une carte par sujet, un réglage par ligne (libellé à gauche, contrôle à droite).
   Les modifications de toutes les sections s'enregistrent ensemble : la barre du bas n'apparaît qu'après un changement. « Utilisation » et « Compte » n'en ont pas besoin. *@
<div class="page-head">
    <div>
        <h1>Réglages</h1>
        <p class="sub sc-intro">Paramètres de votre organisation. Ils s'appliquent à tous les écrans.</p>
    </div>
</div>

<div class="rg-layout @(sub ? "sub" : "hub")">
    <nav class="rg-nav" aria-label="Sections des réglages">
        @foreach (var (group, items) in VisibleGroups)
        {
            <h4>@group</h4>
            @foreach (var t in items)
            {
                var id = t.Id;
                <button type="button" class="@(Tab == id ? "on" : "")" aria-current="@(Tab == id ? "page" : null)" @onclick="() => { tab = id; sub = true; }">
                    <Ico Name="@t.Icon" Size="16" /> <span>@t.Label</span>@if (t.Growth) { <em class="rg-badge">PRO</em> }
                </button>
            }
        }
    </nav>

    <div class="rg-main">
        <button type="button" class="rg-back" @onclick="() => sub = false"><Ico Name="chevron-right" Size="16" /> Réglages</button>
        <div @oninput="Touch" @onchange="Changed" @onclick="Clicked">
        @switch (Tab)
        {
            case "utilisation":
                <div class="rg-ph"><h2>Utilisation</h2><p>Ce que contient votre organisation aujourd'hui.</p></div>

                <section class="rg-sec">
                    <h5>Diffusion</h5>
                    <div class="rg-tiles four">
                        <a class="rg-tile" href="/"><span class="top">Écrans</span><span class="n">@screenCount</span><span class="d">@screensOnline en ligne · @(screenCount - screensOnline) hors ligne</span><span class="go">Voir les écrans →</span></a>
                        <a class="rg-tile" href="/playlists"><span class="top">Playlists</span><span class="n">@playlistCount</span><span class="d">@playlistsUsed en diffusion</span><span class="go">Voir les playlists →</span></a>
                        <a class="rg-tile" href="/organisation"><span class="top">Aires de gestion</span><span class="n">@areaCount</span><span class="d">@areaNames</span><span class="go">Gérer les aires →</span></a>
                        <a class="rg-tile" href="/organisation"><span class="top">Zones</span><span class="n">@zoneCount</span><span class="d">@(wallCount > 0 ? $"dont {wallCount} mur{(wallCount > 1 ? "s" : "")} d'écrans" : "aucun mur d'écrans")</span><span class="go">Gérer les zones →</span></a>
                    </div>
                </section>

                <section class="rg-sec">
                    <h5>Médiathèque</h5>
                    @* Look app : deux tuiles (images, vidéos) à la place du bloc détaillé *@
                    <div class="rg-tiles rg-apptiles">
                        <a class="rg-tile" href="/media"><span class="top">Images</span><span class="n">@imageCount</span><span class="d">@Helpers.FormatSize(imageBytes)</span></a>
                        <a class="rg-tile" href="/media"><span class="top">Vidéos</span><span class="n">@videoCount</span><span class="d">@Helpers.FormatSize(videoBytes)</span></a>
                    </div>
                    <div class="rg-media">
                        <div><div class="lb">Images</div><div class="n">@imageCount</div></div>
                        <div><div class="lb">Vidéos</div><div class="n">@videoCount</div></div>
                        <div><div class="lb">Poids total</div><div class="n">@Helpers.FormatSize(imageBytes + videoBytes)</div></div>
                        <div class="big">
                            @{ var totalBytes = Math.Max(1, imageBytes + videoBytes); var imgPct = (int)Math.Round(imageBytes * 100.0 / totalBytes); }
                            <div class="rg-bar" role="img" aria-label="Poids : images @Helpers.FormatSize(imageBytes), vidéos @Helpers.FormatSize(videoBytes)"><i style="width:@(imageBytes + videoBytes == 0 ? 0 : imgPct)%;background:var(--signal)"></i><i style="width:@(imageBytes + videoBytes == 0 ? 0 : 100 - imgPct)%;background:var(--brand)"></i></div>
                            <div class="rg-legend"><span style="--c:var(--signal)">Images <b>@Helpers.FormatSize(imageBytes)</b></span><span style="--c:var(--brand)">Vidéos <b>@Helpers.FormatSize(videoBytes)</b></span><a href="/media">Ouvrir la médiathèque →</a></div>
                        </div>
                    </div>
                </section>

                <section class="rg-sec">
                    <h5>Connexions</h5>
                    <div class="rg-tiles three">
                        <a class="rg-tile" href="/integrations?tab=@ConnectedAccounts.Tab"><span class="top">Comptes connectés</span><span class="n">@accountCount</span><span class="d">@(accountNames.Length > 0 ? accountNames : "aucun compte")</span><span class="go">Voir les comptes →</span></a>
                        <a class="rg-tile" href="/integrations"><span class="top">Intégrations utilisées</span><span class="n">@integrationCount <small>/ @integrationTotal</small></span><span class="d">@(integrationNames.Length > 0 ? integrationNames : "aucune intégration")</span><span class="go">Voir les intégrations →</span></a>
                    </div>
                </section>
                break;

            case "organisation":
                <div class="rg-ph"><h2>Identité et équipe</h2><p>Qui vous êtes dans Linkii, et qui y travaille.</p></div>
                <div class="rg-card">
                    <header><h3>Organisation</h3><small>La couleur et le logo sont ceux de votre revendeur.</small></header>
                    <div class="sv-row"><div class="t"><b>Nom</b><small>Affiché dans le back-office.</small></div><div class="ctl"><input class="rg-in" @bind="name" aria-label="Nom de l'organisation" /></div></div>
                    <div class="sv-row"><div class="t"><b>Fuseau horaire</b><small>Horloge des écrans.</small></div><div class="ctl">
                        <select class="rg-in" @bind="timezone" aria-label="Fuseau horaire">
                            @foreach (var tz in Timezones) { <option value="@tz">@tz</option> }
                        </select>
                    </div></div>
                </div>
                <div class="rg-card">
                    <header><h3>Aires de gestion</h3><small>Tant qu'il n'y a qu'une aire et aucun membre, rien ne change. Les membres et leurs droits sont dans le menu Membres.</small></header>
                    <div class="sv-row"><div class="t"><b>@areaCount aire@(areaCount > 1 ? "s" : "") de gestion</b><small>Un site, un bâtiment, un service… avec leurs zones.</small></div><div class="ctl"><a href="/organisation">@(areaCount > 1 ? "Gérer les aires et les zones" : "Créer une aire, des zones")</a></div></div>
                </div>
                break;

            case "abonnement":
                <SubscriptionPanel />
                break;

            case "diffusion":
                <div class="rg-ph"><h2>Contenus et écrans</h2><p>Valeurs par défaut pour les contenus, les players et les nouveaux écrans.</p></div>
                <div class="rg-card">
                    <header><h3>Lecture</h3></header>
                    <div class="sv-row"><div class="t"><b>Durée par défaut d'un contenu</b><small>En secondes.</small></div><div class="ctl"><input class="rg-in short" type="number" min="1" max="600" @bind="duration" aria-label="Durée par défaut en secondes" /></div></div>
                    <div class="sv-row"><div class="t"><b>Redémarrage nocturne des players</b><small>Évite les fuites de mémoire sur les clés HDMI.</small></div><div class="ctl">
                        <select class="rg-in short" @bind="reloadHour" aria-label="Heure du redémarrage nocturne">
                            @for (var h = 0; h < 24; h++) { <option value="@h">@($"{h:00}:00")</option> }
                        </select>
                    </div></div>
                </div>
                <div class="rg-card">
                    <header><h3>Menu technicien des écrans</h3><small>Code demandé sur les boîtiers Android après 5 appuis sur OK (ou 5 touchers en haut à droite). Il s'applique à tous les écrans de l'organisation.</small></header>
                    @if (techPinOn && techPin.Length == 0)
                    {
                        <div class="rg-body"><p class="hint" style="margin:0;color:var(--warn-ink)">Aucun code défini : vos écrans gardent leur code par défaut (9999). Définissez un code ci-dessous.</p></div>
                    }
                    <div class="sv-row">
                        <div class="t"><b>Protéger le menu par un code</b><small>Sans code, toute personne devant l'écran peut changer de serveur ou désappairer.</small></div>
                        <div class="ctl"><button type="button" class="switch @(techPinOn ? "on" : "")" role="switch" aria-checked="@(techPinOn ? "true" : "false")" aria-label="Protéger le menu technicien par un code" @onclick="() => { techPinOn = !techPinOn; dirty = true; }"><span></span></button></div>
                    </div>
                    @if (techPinOn)
                    {
                        <div class="sv-row">
                            <div class="t"><b>Code</b><small>4 à 8 chiffres.@if (techPinUtc != null) { <text> Modifié le @techPinUtc.Value.ToLocalTime().ToString("d MMM yyyy") @(techPinBy.Length > 0 ? "par " + techPinBy : "").</text> }</small></div>
                            <div class="ctl" style="display:flex;gap:8px">
                                <input class="rg-in short" type="@(techShow ? "text" : "password")" inputmode="numeric" maxlength="8" autocomplete="off" @bind="techPin" @bind:event="oninput" aria-label="Code du menu technicien" style="font-family:var(--mono);letter-spacing:.2em" />
                                <button type="button" class="btn" @onclick="() => techShow = !techShow">@(techShow ? "Masquer" : "Afficher")</button>
                                <button type="button" class="btn" @onclick="() => { techPin = TechPin.Generate(); techShow = true; dirty = true; }">Générer</button>
                            </div>
                        </div>
                        <div class="sv-row">
                            <div class="t"><b>Autoriser un code propre à un appareil</b><small>Le technicien peut définir un autre code depuis le menu ; il remplace celui-ci sur cet appareil.</small></div>
                            <div class="ctl"><button type="button" class="switch @(techPinLocal ? "on" : "")" role="switch" aria-checked="@(techPinLocal ? "true" : "false")" aria-label="Autoriser un code propre à un appareil" @onclick="() => { techPinLocal = !techPinLocal; dirty = true; }"><span></span></button></div>
                        </div>
                    }
                    @if (pinTotal > 0)
                    {
                        <div class="rg-body"><p class="hint" style="margin:0">@pinApplied écran@(pinApplied > 1 ? "s" : "") Android sur @pinTotal @(pinApplied > 1 ? "ont" : "a") reçu ce code@(pinWaiting.Length > 0 ? ". En attente : " + pinWaiting : "").@if (pinWaiting.Length > 0) { <text> Ils le recevront à leur prochaine synchronisation ; une ancienne version de l'app doit d'abord être mise à jour.</text> }</p></div>
                    }
                </div>
                <div class="rg-card">
                    <header><h3>Nouveaux écrans</h3><small>Préréglage à la création, modifiable écran par écran.</small></header>
                    <div class="rg-body"><ScreenFormat Spec="spec" OnChange="Changed" /></div>
                    <div class="sv-row">
                        <div class="t"><b>Démarrage automatique</b><small>Valeur des nouveaux écrans ; chaque écran peut la changer.</small></div>
                        <div class="ctl"><button type="button" class="switch @(autoStart ? "on" : "")" role="switch" aria-checked="@(autoStart ? "true" : "false")" aria-label="Démarrage automatique des nouveaux écrans" @onclick="() => { autoStart = !autoStart; dirty = true; }"><span></span></button></div>
                    </div>
                </div>
                <div class="rg-card">
                    <header><h3>Présentations</h3><small>PowerPoint, Google Slides, Google Docs, PDF et Canva à plusieurs pages.</small></header>
                    <div class="sv-row">
                        <div class="t"><b>Fusionner automatiquement les doublons de présentations</b><small>Au démarrage du serveur, les présentations identiques (même fichier) sont regroupées en une seule ; les contenus et listes sont repointés et les images en trop supprimées, sauf celles qu'un écran diffuse encore. Coupé, les doublons existants restent, mais les nouveaux imports n'en créent plus.</small></div>
                        <div class="ctl"><button type="button" class="switch @(mergePres ? "on" : "")" role="switch" aria-checked="@(mergePres ? "true" : "false")" aria-label="Fusionner automatiquement les doublons de présentations" @onclick="() => { mergePres = !mergePres; dirty = true; }"><span></span></button></div>
                    </div>
                </div>
                break;

            case "veille":
                <div class="rg-ph"><h2>Veille et luminosité</h2><p>Fonctions avancées, désactivées par défaut. Réglage par aire ; chaque écran peut le remplacer.</p></div>
                <div class="rg-card">
                    <header><h3>Mise en veille</h3><small>Éteint les écrans pendant des plages horaires (nuit, week-end).</small></header>
                    <div class="sv-row">
                        <div class="t"><b>Plages de mise en veille</b></div>
                        <div class="ctl"><button type="button" class="switch @(sleepEnabled ? "on" : "")" role="switch" aria-checked="@(sleepEnabled ? "true" : "false")" aria-label="Plages de mise en veille" @onclick="() => { sleepEnabled = !sleepEnabled; dirty = true; }"><span></span></button></div>
                    </div>
                    @if (sleepEnabled)
                    {
                        <div class="rg-body">
                            @if (areaCount == 1 && soleAreaId != Guid.Empty)
                            {
                                <AreaSleep @ref="sleepRef" AreaId="soleAreaId" Embedded="true" OnEdited="Changed" />
                            }
                            else
                            {
                                <p class="hint" style="margin:0">Enregistrez, puis réglez les plages de chaque aire dans <a href="/organisation">Organisation</a>.</p>
                            }
                        </div>
                    }
                </div>
                <div class="rg-card">
                    <header><h3>Luminosité et contraste</h3><small>Selon l'heure (jour, soirée, nuit), sur l'app Android uniquement.</small></header>
                    <div class="sv-row">
                        <div class="t"><b>Profils jour, soirée, nuit</b><small>Par défaut, aucun écran n'est réglé.</small></div>
                        <div class="ctl"><button type="button" class="switch @(dimEnabled ? "on" : "")" role="switch" aria-checked="@(dimEnabled ? "true" : "false")" aria-label="Luminosité et contraste selon l'heure" @onclick="() => { dimEnabled = !dimEnabled; dirty = true; }"><span></span></button></div>
                    </div>
                    @if (dimEnabled)
                    {
                        <div class="rg-body">
                            @if (areaCount == 1 && soleAreaId != Guid.Empty)
                            {
                                <AreaDim @ref="dimRef" AreaId="soleAreaId" Embedded="true" OnEdited="Changed" />
                            }
                            else
                            {
                                <p class="hint" style="margin:0">Enregistrez, puis réglez la luminosité de chaque aire dans <a href="/organisation">Organisation</a>.</p>
                            }
                        </div>
                    }
                </div>
                break;

            case "supervision":
                @* Contrôle du direct et alertes : licence Pro. En licence Essential, tout est visible mais verrouillé (bulle au survol). *@
                <div class="rg-ph"><h2>Alertes et pause</h2><p>Soyez prévenu d'une panne et gardez la main sur le direct.</p></div>
                @if (!growth)
                {
                    <div class="sv-upsell"><Ico Name="lock" Size="18" /><span class="grow">Les alertes, le contrôle du direct (aperçu, pause, redémarrage) et les murs d'écrans sont inclus dans la licence <b>Pro</b>.</span></div>
                }
                @* Alertes en 3 étapes : ① interrupteur général ② canaux (e-mail, notification) ③ types suivis. Couper ① garde les choix de ② et ③. *@
                var alertsLive = growth && alertsOn;
                <div class="rg-card al-master @(growth ? "" : "al-off")" data-tip="@(growth ? null : Plans.LockedHint)">
                    <div class="sv-row"><span class="al-num">1</span>
                        <div class="t"><b>Activer les alertes</b><small>Un seul interrupteur pour tout couper ou tout rallumer, sans perdre vos choix.</small></div>
                        <div class="ctl"><button type="button" class="switch @(alertsOn ? "on" : "")" role="switch" aria-checked="@(alertsOn ? "true" : "false")" aria-label="Activer les alertes" disabled="@(!growth)" @onclick="() => { alertsOn = !alertsOn; dirty = true; }"><span></span></button></div>
                    </div>
                </div>
                <div class="rg-card @(alertsLive ? "" : "al-off")">
                    <header><span class="al-num">2</span><h3>Comment être prévenu</h3></header>
                    <div class="sv-row">
                        <div class="t"><b>Par e-mail</b><small>Un message dans la boîte e-mail.</small></div>
                        <div class="ctl"><button type="button" class="switch @(alertMail ? "on" : "")" role="switch" aria-checked="@(alertMail ? "true" : "false")" aria-label="Par e-mail" disabled="@(!alertsLive)" @onclick="() => { alertMail = !alertMail; dirty = true; }"><span></span></button></div>
                    </div>
                    @if (alertMail)
                    {
                        <div class="al-sub">
                            <select class="rg-in" @bind="alertTarget" disabled="@(!alertsLive)" aria-label="Destinataires des e-mails">
                                <option value="admins">Tous les administrateurs</option>
                                <option value="custom">Une adresse dédiée…</option>
                            </select>
                            @if (alertTarget == "custom") { <input class="rg-in" type="email" placeholder="alertes@exemple.ch" aria-label="Adresse des alertes" @bind="alertEmail" disabled="@(!alertsLive)" /> }
                        </div>
                    }
                    <div class="sv-row">
                        <div class="t"><b>Par notification</b><small>Sur les téléphones où l'app Linkii est installée et connectée avec un compte administrateur@(pushDevices > 0 ? $" ({pushDevices} enregistré{(pushDevices > 1 ? "s" : "")})" : " (aucun enregistré pour l'instant)").</small></div>
                        <div class="ctl"><button type="button" class="switch @(alertPush ? "on" : "")" role="switch" aria-checked="@(alertPush ? "true" : "false")" aria-label="Par notification" disabled="@(!alertsLive)" @onclick="() => { alertPush = !alertPush; dirty = true; }"><span></span></button></div>
                    </div>
                    @if (alertsLive && !alertMail && !alertPush)
                    {
                        <div class="sv-row"><div class="t"><small class="al-warn">Aucun canal choisi : aucune alerte ne sera envoyée.</small></div></div>
                    }
                </div>
                <div class="rg-card @(alertsLive ? "" : "al-off")">
                    <header><span class="al-num">3</span><h3>De quoi être prévenu</h3></header>
                    @foreach (var (id, label, hint) in Alerts.All)
                    {
                        var kind = id;
                        var on = alertTypes.Contains(kind);
                        <div class="sv-row">
                            <div class="t"><b>@label</b><small>@hint</small></div>
                            <div class="ctl"><button type="button" class="switch @(on ? "on" : "")" role="switch" aria-checked="@(on ? "true" : "false")" aria-label="@label" disabled="@(!alertsLive)" @onclick="() => { if (!alertTypes.Remove(kind)) alertTypes.Add(kind); dirty = true; }"><span></span></button></div>
                        </div>
                        @if (kind == Alerts.Screens && on)
                        {
                            <div class="al-sub al-inline">
                                <span>Alerter après</span>
                                <select class="rg-in short" @bind="alertMinutes" disabled="@(!alertsLive)" aria-label="Délai avant l'alerte">
                                    @foreach (var (m, l) in AlertDelays) { <option value="@m">@l</option> }
                                </select>
                            </div>
                        }
                    }
                </div>
                <div class="rg-card">
                    <header><h3>Pause des écrans</h3><small>Se lance depuis la carte d'un écran (bouton Pause).</small></header>
                    <div class="sv-row @(growth ? "" : "locked-row")" data-tip="@(growth ? null : Plans.LockedHint)">
                        <div class="t"><b>Reprise automatique après</b><small>Un écran en pause reprend seul au bout de ce délai : il ne reste jamais figé par oubli. Modifiable à chaque pause.</small></div>
                        <div class="ctl">
                            <select class="rg-in short" @bind="pauseMinutes" disabled="@(!growth)" aria-label="Reprise automatique après">
                                @foreach (var (m, l) in PauseDelays) { <option value="@m">@l</option> }
                            </select>
                        </div>
                    </div>
                    <div class="sv-row @(growth ? "" : "locked-row")" data-tip="@(growth ? null : Plans.LockedHint)">
                        <div class="t"><b>Visuel affiché pendant la pause</b><small>Une image de votre médiathèque, sinon le visuel Linkii par défaut.</small></div>
                        <div class="ctl" style="flex:1;min-width:0">@if (growth) { <MediaField Field="pauseField" Values="pauseValues" OnChange="Changed" /> } else { <span class="muted">Visuel Linkii par défaut</span> }</div>
                    </div>
                </div>
                break;
        }
        </div>

        @if (Tab == "compte")
        {
            <div class="rg-ph"><h2>Compte et confidentialité</h2><p>Votre accès administrateur.</p></div>
            @if (Ctx.IsImpersonating)
            {
                <div class="card empty"><div class="big">Compte non modifiable</div><p>Vous consultez cet espace en tant qu'administrateur : le mot de passe reste celui du client.</p></div>
            }
            else
            {
                <div class="rg-card">
                    <header><h3>Connexion</h3><small>@email</small></header>
                    @if (externalProvider != null)
                    {
                        <div class="rg-body"><p class="sso-note" style="margin:0"><ProviderLogo Provider="@externalProvider" Size="16" /> Connexion avec le bouton « Continuer avec @SignupSources.Label(externalProvider) » : pas de mot de passe Linkii.</p></div>
                    }
                    else
                    {
                        <div class="sv-row"><div class="t"><b>Mot de passe actuel</b></div><div class="ctl"><input class="rg-in" type="password" @bind="oldPwd" @bind:after="ChangePassword" autocomplete="current-password" aria-label="Mot de passe actuel" /></div></div>
                        <div class="sv-row"><div class="t"><b>Nouveau mot de passe</b><small>8 caractères minimum. Enregistré dès que les deux champs sont remplis.</small></div><div class="ctl"><input class="rg-in" type="password" @bind="newPwd" @bind:after="ChangePassword" autocomplete="new-password" aria-label="Nouveau mot de passe" /></div></div>
                    }
                </div>
                <div class="rg-card rg-mode">
                    <header><h3>Mode d'utilisation</h3><small>@(Modes.Expert ? "Expert : toutes les fonctions." : "Simple : vue réduite.")</small></header>
                    <div class="sv-row"><div class="t"><b>@(Modes.Expert ? "Passer en mode simple" : "Passer en mode expert")</b><small>Planning, aires de gestion, membres, intégrations et widgets.</small></div>
                        <div class="ctl"><button type="button" class="switch @(Modes.Expert ? "on" : "")" role="switch" aria-checked="@(Modes.Expert ? "true" : "false")" aria-label="Passer en mode expert" @onclick="() => Modes.Switch(!Modes.Expert)"><span></span></button></div></div>
                </div>
                <ConsentPrefs />
                <AppDevicePrefs />
            }
        }


        @if (!Modes.Expert)
        {
            <div class="rg-card">
                <header><h3>Fonctions avancées</h3><small>Disponibles en mode expert.</small></header>
                <div class="sv-row"><div class="t"><b>Planning, aires de gestion, membres, intégrations et widgets</b></div>
                    <div class="ctl"><button type="button" class="btn ghost" @onclick="() => Modes.Switch(true)">Passer en mode expert</button></div></div>
            </div>
        }

    </div>
</div>

@code {
    [SupplyParameterFromQuery(Name = "tab")] public string? TabParam { get; set; }

    private record NavItem(string Id, string Label, string Icon, bool Growth = false);

    private static readonly (string Group, NavItem[] Items)[] Groups =
    {
        ("Vue d'ensemble", new[] { new NavItem("utilisation", "Utilisation", "chart") }),
        ("Organisation", new[] { new NavItem("organisation", "Identité et équipe", "building") }),
        ("Diffusion", new[] { new NavItem("diffusion", "Contenus et écrans", "monitor"), new NavItem("veille", "Veille et luminosité", "moon") }),
        ("Suivi", new[] { new NavItem("supervision", "Alertes et pause", "bell", Growth: true) }),
        ("Abonnement", new[] { new NavItem("abonnement", "Plan et paiement", "file") }),
        ("Mon compte", new[] { new NavItem("compte", "Compte et confidentialité", "user") }),
    };

    private static readonly (int Min, string Label)[] AlertDelays = { (1, "1 minute"), (5, "5 minutes"), (10, "10 minutes"), (15, "15 minutes"), (30, "30 minutes"), (60, "1 heure") };
    private static readonly (int Min, string Label)[] PauseDelays = { (15, "15 minutes"), (30, "30 minutes"), (60, "1 heure"), (240, "4 heures"), (0, "Jamais (reprise manuelle)") };

    // Alertes et pause (Pro)
    private bool growth, alertsOn, alertMail, alertPush;
    private HashSet<string> alertTypes = new();
    private int pushDevices;   // téléphones des administrateurs qui reçoivent les notifications
    private int alertMinutes = 10, pauseMinutes = 60;
    private string alertTarget = "admins", alertEmail = "";
    private readonly AppField pauseField = new() { Key = "pause", Type = "media", Accept = "image", Label = "Visuel de pause" };
    private Dictionary<string, string> pauseValues = new() { ["pause"] = "" };

    private static readonly string[] Timezones =
    {
        "Europe/Zurich", "Europe/Paris", "Europe/Brussels", "Europe/London", "Europe/Berlin", "Europe/Rome",
        "America/Montreal", "America/New_York", "Africa/Casablanca", "UTC"
    };

    // Mode simple : Utilisation, Veille et luminosité, Compte et confidentialité seulement (le reste est en mode expert).
    private static readonly string[] SimpleTabs = { "utilisation", "veille", "abonnement", "compte" };
    private IEnumerable<(string Group, NavItem[] Items)> VisibleGroups => Modes.Expert ? Groups
        : Groups.Select(g => (g.Group, Items: g.Items.Where(i => SimpleTabs.Contains(i.Id)).ToArray())).Where(g => g.Items.Length > 0);
    private string Shown(string id) => Modes.Expert || SimpleTabs.Contains(id) ? id : "utilisation";

    private string? tab;
    private string Tab => Shown(tab ?? (TabParam == "parametres" ? "diffusion" : Groups.SelectMany(g => g.Items).Any(t => t.Id == TabParam) ? TabParam! : "utilisation"));
    private bool dirty, sub;   // sub : look « app », une rubrique ouverte (liste des rubriques masquée)
    private void Touch() => dirty = true;
    private AreaSleep? sleepRef;
    private AreaDim? dimRef;

    private string name = "", timezone = "", email = "";
    private int duration, reloadHour;
    private string oldPwd = "", newPwd = "";
    private string? externalProvider;   // compte Microsoft ou Google, sans mot de passe Linkii
    private ScreenSpec spec = new();
    private int areaCount;
    private bool sleepEnabled, dimEnabled;
    private Guid soleAreaId;   // l'aire, quand il n'y en a qu'une : ses plages se règlent ici

    // Utilisation
    private int screenCount, screensOnline, playlistCount, playlistsUsed, zoneCount, wallCount;
    private int imageCount, videoCount, accountCount, integrationCount, integrationTotal;
    private long imageBytes, videoBytes;
    private string areaNames = "", accountNames = "", integrationNames = "";

    protected override void OnInitialized()
    {
        // Ancien onglet « Applications » (liens enregistrés, retour de Canva) : devenu la page Intégrations.
        if (TabParam == "applications") { Nav.NavigateTo("/integrations" + new Uri(Nav.Uri).Query.Replace("tab=applications&", "").Replace("?tab=applications", ""), replace: true); return; }
        var t = Store.Read(d => d.Tenant);
        name = t.Name; timezone = t.Timezone; duration = t.DefaultDurationSec; reloadHour = t.ReloadHour;
        growth = t.IsGrowth; (alertsOn, alertMail, alertPush, alertTypes) = (t.AlertsOn, t.AlertMail, t.AlertPush, t.AlertTypes.ToHashSet());
        var cid = t.Id;
        pushDevices = Root.Read(d => { var admins = d.Users.Where(u => u.ClientId == cid && u.Role == Roles.ClientAdmin && !u.Disabled).Select(u => u.Id).ToHashSet(); return d.PushDevices.Count(p => admins.Contains(p.UserId)); });
        alertMinutes = AlertDelays.Any(a => a.Min == t.AlertOfflineMinutes) ? t.AlertOfflineMinutes : 10;
        alertTarget = t.AlertEmail.Length > 0 ? "custom" : "admins"; alertEmail = t.AlertEmail;
        pauseMinutes = PauseDelays.Any(p => p.Min == t.PauseResumeMinutes) ? t.PauseResumeMinutes : 60;
        pauseValues["pause"] = t.PauseMediaId?.ToString() ?? "";
        if (Nav.Uri.Contains("saved=1")) Toast.Ok("Réglages enregistrés.");
        email = Ctx.Email;
        var uid = Ctx.UserId;
        externalProvider = Root.Read(d => d.Users.FirstOrDefault(u => u.Id == uid) is { HasPassword: false } u ? u.ExternalProvider : null);
        areaCount = Store.Read(d => d.Areas.Count);
        (sleepEnabled, dimEnabled) = (t.SleepEnabled, t.DimEnabled);
        (techPinOn, techPin, techPinLocal, techPinUtc, techPinBy) = (t.TechPinOn, t.TechPin, t.TechPinLocal, t.TechPinUtc, t.TechPinBy);
        autoStart = t.DefaultAutoStart; mergePres = t.MergePresentations;
        LoadPinState(t);
        soleAreaId = areaCount == 1 ? Store.Read(d => d.Areas.First().Id) : Guid.Empty;
        spec = ScreenSpec.From(t);
        LoadUsage(t);
    }

    // Chiffres de l'onglet « Utilisation » (lus une fois à l'ouverture de la page).
    private void LoadUsage(Tenant t)
    {
        var (screens, playlists, areas, media) = Store.Read(d => (d.Screens.Where(s => s.Token != null).ToList(), d.Playlists.ToList(), d.Areas.ToList(), d.Media.ToList()));
        screenCount = screens.Count;
        screensOnline = screens.Count(s => Store.Read(d => d.Status(s)) != "Hors ligne");
        playlistCount = playlists.Count;
        var used = screens.SelectMany(s => s.ZonePlaylists()).Concat(areas.SelectMany(a => a.Zones).Select(z => z.PlaylistId)).OfType<Guid>().ToHashSet();
        playlistsUsed = playlists.Count(p => used.Contains(p.Id));
        zoneCount = areas.Sum(a => a.Zones.Count);
        wallCount = areas.Sum(a => a.Zones.Count(z => z.IsWall));
        var names = areas.Select(a => a.Name).ToList();
        areaNames = names.Count <= 3 ? string.Join(", ", names) : string.Join(", ", names.Take(3)) + "…";

        var files = media.Where(m => m.Type is "image" or "video" && m.AppId == null && m.Status != "failed").ToList();
        imageCount = files.Count(m => m.Type == "image"); videoCount = files.Count - imageCount;
        imageBytes = files.Where(m => m.Type == "image").Sum(m => m.Size ?? 0);
        videoBytes = files.Where(m => m.Type == "video").Sum(m => m.Size ?? 0);

        var accounts = ConnectedAccounts.Of(t);
        accountCount = accounts.Count;
        accountNames = string.Join(", ", accounts.Select(a => a.Kind));
        var installed = Apps.Installed();
        integrationCount = installed.Count; integrationTotal = Apps.Catalog.Count;
        var inst = installed.Select(i => Apps.Find(i.AppId)?.Name ?? i.AppId).ToList();
        integrationNames = inst.Count <= 3 ? string.Join(", ", inst) : string.Join(", ", inst.Take(3)) + "…";
    }

    // Menu technicien : état du code
    private bool techPinOn, techPinLocal, techShow;
    private bool autoStart = true;   // démarrage automatique des nouveaux écrans
    private bool mergePres = true;   // fusion automatique des doublons de présentations (§103)
    private string techPin = "", techPinBy = "";
    private DateTime? techPinUtc;
    private int pinApplied, pinTotal;
    private string pinWaiting = "";

    // Écrans Android appairés : ont-ils renvoyé l'empreinte du code actuel ?
    private void LoadPinState(Tenant t)
    {
        var expected = TechPin.Expected(t);
        var android = Store.Read(d => d.Screens.Where(s => s.Token != null && s.DeviceKind is "android" or "androidtv").ToList());
        pinTotal = expected == null ? 0 : android.Count;
        pinApplied = android.Count(s => s.DevicePinSig == expected);
        var waiting = android.Where(s => s.DevicePinSig != expected).Select(s => s.Name).ToList();
        pinWaiting = waiting.Count <= 3 ? string.Join(", ", waiting) : string.Join(", ", waiting.Take(3)) + "…";
    }

    // Enregistrement automatique : à chaque réglage modifié (changement de champ, bascule, clic), sans bouton.
    // Différé de quelques instants : la valeur liée au champ (@bind) et les clics enfants sont déjà appliqués au moment d'enregistrer.
    private bool saving;
    private CancellationTokenSource? saveCts;
    private void Changed() { dirty = true; ScheduleSave(); }
    private void Clicked() { if (dirty) ScheduleSave(); }
    private void ScheduleSave()
    {
        saveCts?.Cancel();
        var cts = saveCts = new CancellationTokenSource();
        _ = SaveLater(cts.Token);
    }
    private async Task SaveLater(CancellationToken ct)
    {
        try { await Task.Delay(300, ct); } catch (TaskCanceledException) { return; }
        await InvokeAsync(async () =>
        {
            if (!dirty || saving || Tab is "utilisation" or "compte" or "abonnement") return;
            saving = true;
            try { await Save(); } finally { saving = false; }
            StateHasChanged();
        });
    }

    private async Task Save()
    {
        if (string.IsNullOrWhiteSpace(name)) { Toast.Error("Le nom de l'organisation est obligatoire."); return; }
        if (duration < 1) { Toast.Error("La durée par défaut doit être d'au moins 1 seconde."); return; }
        techPin = techPin.Trim();
        if (techPinOn && techPin.Length > 0 && !TechPin.Valid(techPin)) { Toast.Error("Le code du menu technicien doit comporter 4 à 8 chiffres."); return; }
        var target = alertTarget == "custom" ? alertEmail.Trim() : "";
        if (growth && alertsOn && alertMail && alertTarget == "custom" && !System.Net.Mail.MailAddress.TryCreate(target, out _)) { Toast.Error("L'adresse des alertes n'est pas valide."); return; }
        // plages de veille et profils de luminosité (composants de l'aire) : enregistrés avec le reste, sans second bouton
        if (sleepEnabled && sleepRef != null) await sleepRef.Persist();
        if (dimEnabled && dimRef != null && !await dimRef.Persist()) return;
        var pauseImage = AppField.MediaIds(pauseValues.GetValueOrDefault("pause")) is { Count: > 0 } ids ? ids[0] : (Guid?)null;
        var mergeNow = false;

        Store.Write(d =>
        {
            var t = d.Tenant;
            t.Name = name.Trim(); t.Timezone = timezone;
            t.DefaultDurationSec = duration; t.ReloadHour = reloadHour;
            t.SleepEnabled = sleepEnabled; t.DimEnabled = dimEnabled;
            if (t.TechPinOn != techPinOn || t.TechPin != techPin || t.TechPinLocal != techPinLocal)
            {
                t.TechPinOn = techPinOn; t.TechPin = techPin; t.TechPinLocal = techPinLocal;
                t.TechPinUtc = DateTime.UtcNow; t.TechPinBy = Ctx.Email ?? "";
            }
            t.DefaultScreenType = spec.Type; t.DefaultOrientation = spec.Orientation; t.DefaultResolution = spec.Resolution;
            mergeNow = mergePres && !t.MergePresentations;
            t.DefaultAutoStart = autoStart; t.MergePresentations = mergePres;
            if (t.IsGrowth)   // alertes et pause : licence Pro (contrôlée ici aussi, pas seulement dans l'interface)
            {
                t.AlertsOn = alertsOn; t.AlertMail = alertMail; t.AlertPush = alertPush;
                t.AlertTypes = Alerts.All.Select(a => a.Id).Where(alertTypes.Contains).ToList();
                t.AlertOfflineMinutes = alertMinutes;
                t.AlertEmail = target;   // e-mail coupé : le choix reste (masqué) pour plus tard
                t.PauseResumeMinutes = pauseMinutes;
                t.PauseMediaId = pauseImage is { } pm && d.Media.Any(m => m.Id == pm && m.Type == "image") ? pauseImage : null;
            }
        });
        if (mergeNow) Merge.Run(Store.ClientId);   // réglage activé à l'instant : les doublons sont fusionnés tout de suite
        await Notifier.NotifyClient(Store.ClientId);   // fuseau / redémarrage : les écrans rechargent leur configuration
        dirty = false;
        LoadPinState(Store.Read(d => d.Tenant));
        Toast.Ok("Réglages enregistrés.");
    }

    private void ChangePassword()
    {
        var uid = Ctx.UserId;
        if (oldPwd.Length == 0 || newPwd.Length == 0) return;   // enregistré dès que les deux champs sont remplis
        var hash = Root.Read(d => d.Users.FirstOrDefault(u => u.Id == uid)?.PasswordHash ?? "");
        if (Ctx.IsImpersonating || !Passwords.Verify(hash, oldPwd)) { Toast.Error("Mot de passe actuel incorrect."); return; }
        if (newPwd.Length < 8) { Toast.Error("Le nouveau mot de passe est trop court (8 caractères minimum)."); return; }
        Root.Write(d => { d.Users.First(u => u.Id == uid).PasswordHash = Passwords.Hash(newPwd); });
        oldPwd = newPwd = "";
        Toast.Ok("Mot de passe modifié.");
    }
}
