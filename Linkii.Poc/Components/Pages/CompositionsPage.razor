@code {
    // ---------- Dossiers (25 octobre 2026) : comme la Médiathèque et les Listes de lecture, liés aux onglets ----------
    private static readonly Guid RootDrop = Guid.Empty;   // cible « racine » du glisser-déposer (fil d'Ariane)
    private bool canCreateRoot, inApp;
    private Guid? folderId;                                  // dossier ouvert ; null : racine
    private List<CompositionFolderRow> folderRows = new();   // dossiers vus par la personne
    private List<CompositionFolderRow> subfolders = new(), crumbs = new();
    private HashSet<Guid> tabFolders = new();                // dossiers montrés par le filtre « Afficher » (et leurs sous-dossiers)
    private List<MediaItem> scopeItems = new();              // compositions montrées par le filtre « Afficher », dossiers compris
    private Dictionary<Guid, ShareSummary> folderShares = new();
    private bool creatingFolder;

    // ---------- Créer avec l'IA : une phrase, une composition à retoucher ----------

    private bool aiOpen, aiBusy, aiPortrait;
    private string aiText = "", aiError = "";
    private static readonly string[] AiExamples =
    {
        "Menu du jour : soupe, poulet rôti, tarte aux pommes, 16.– le menu",
        "Bienvenue à la réunion annuelle, vendredi 20 mars à 19 h",
        "Fermé le lundi de Pâques, réouverture mardi à 8 h",
    };

    private void OpenAi() { aiOpen = true; aiError = ""; }
    private void CloseAi() { if (!aiBusy) aiOpen = false; }

    private async Task CreateWithAi()
    {
        aiBusy = true; aiError = "";
        StateHasChanged();
        try
        {
            var r = await AiComp.FromSentence(Store.ClientId, aiText, aiPortrait);
            if (!r.Ok) { aiError = r.Message; return; }
            var slide = r.Slides[0];
            if (Compositions.Clean(slide.Doc) is not { } c) { aiError = "La composition n'a pas pu être préparée."; return; }
            var (item, errors) = Svc.SaveInstance(Compositions.AppId, null, slide.Name, new Dictionary<string, string> { ["doc"] = c.Doc, ["images"] = string.Join(",", c.Images) });
            if (item == null) { aiError = string.Join(" ", errors); return; }
            Folders.PlaceNew(item.Id, folderId);
            aiOpen = false;
            Nav.NavigateTo("/compositions/" + item.Id + "?back=%2Fcompositions");
        }
        finally { aiBusy = false; }
    }

    private string newFolderName = "", renameFolderValue = "";
    private string? folderError;
    private CompositionFolderRow? renamingFolder, deletingFolder;
    private (Guid Id, string Name)? reparenting;
    private List<(Guid Id, string Name)>? compMove;
    private List<Guid> dragIds = new();
    private Guid? dragFolder, dropOver;

    private CompositionFolderRow? currentRow => folderId is { } id ? folderRows.FirstOrDefault(r => r.Folder.Id == id) : null;
    // Une composition se crée à la racine comme avant ; dans un dossier, il faut y écrire. Rien ne se crée à la racine de « Partagées avec moi » (dossiers).
    private bool CanCreateHere => canWrite && (folderId is null || currentRow is { } c && c.Right >= FolderRight.Write);
    private bool CanCreateFolderHere => Modes.Expert && (folderId is null ? canCreateRoot && tab != LibraryTab.Shared : currentRow is { } c && c.Right >= FolderRight.Write);

    private ShareSummary FolderSum(Guid id) => folderShares.GetValueOrDefault(id, ShareSummary.None);
    private void ShareFolder(CompositionFolderRow r) => Share(ShareKind.CompositionFolder, r.Folder.Id, r.Folder.Name);
    private static string Plural(int n, string one, string many) => $"{n} {(n > 1 ? many : one)}";

    private string RightLabel(CompositionFolderRow r) =>
        r.Folder.OwnerId == me ? (r.Shared ? "Votre dossier" : "Votre dossier · privé")
        : r.Right switch
        {
            FolderRight.Read => $"Lecture seule · dossier de {r.OwnerName}",
            FolderRight.Write => $"Écriture · dossier de {r.OwnerName}",
            _ => $"Administrateur · dossier de {r.OwnerName}"
        };

    private string FolderTitle(CompositionFolderRow r) => (r.Folder.OwnerId == me ? "Votre dossier" : $"Dossier de {r.OwnerName}") + (r.Right == FolderRight.Read ? " · lecture seule" : r.Shared ? " · partagé" : " · privé");

    private static readonly System.Globalization.CultureInfo Fr = new("fr-FR");
    private string FolderDate(CompositionFolderRow r)
    {
        var d = r.Folder.CreatedUtc.ToLocalTime();
        return "créé le " + d.ToString(d.Year == DateTime.Now.Year ? "d MMM" : "d MMM yyyy", Fr);
    }

    private int ChildCount(Guid id) => items.Count(c => c.FolderId == id) + folderRows.Count(r => r.Folder.ParentId == id);
    private string FolderUnit(Guid id) => FolderShape.UnitFor(items.Count(c => c.FolderId == id), folderRows.Count(r => r.Folder.ParentId == id), "composition", "compositions");

    // les trois premières compositions d'un dossier : vignettes de sa carte
    private List<MediaItem> FolderPreview(Guid folder) => items.Where(c => c.FolderId == folder).OrderBy(c => c.Name, StringComparer.CurrentCultureIgnoreCase).Take(3).ToList();

    // Le dossier et tous ses sous-dossiers
    private HashSet<Guid> FolderTree(Guid id)
    {
        var tree = new HashSet<Guid>();
        var queue = new Queue<Guid>(new[] { id });
        while (queue.Count > 0)
        {
            var cur = queue.Dequeue();
            if (!tree.Add(cur)) continue;
            foreach (var r in folderRows.Where(x => x.Folder.ParentId == cur)) queue.Enqueue(r.Folder.Id);
        }
        return tree;
    }

    // Ce qui dépend de l'onglet et du dossier ouvert : dossiers de l'onglet, compositions de sa portée, dossiers affichés et fil d'Ariane
    private void Rebuild()
    {
        (HashSet<Guid> Folders, List<MediaItem> Items) Scope(string t)
        {
            var fs = LibraryTab.Folders(t, folderRows.Select(r => (r.Folder.Id, r.Folder.ParentId, r.Tab)), me, isAdmin);
            return (fs, items.Where(m => (tabs.TryGetValue(m.Id, out var i) ? LibraryTab.InTab(t, i, me, isAdmin) : t == LibraryTab.All) || m.FolderId is { } f && fs.Contains(f)).ToList());
        }
        (tabFolders, scopeItems) = Scope(tab);
        (mineCount, sharedCount) = multi && !readAll ? (Scope(LibraryTab.Mine).Items.Count, Scope(LibraryTab.Shared).Items.Count) : (0, 0);
        subfolders = Modes.Simple ? new()   // mode simple : pas de dossiers, toutes les compositions à plat (voir Shown)
            : folderRows.Where(r => folderId is { } fid ? r.Folder.ParentId == fid : tabFolders.Contains(r.Folder.Id) && (r.Folder.ParentId is not { } p || !tabFolders.Contains(p))).ToList();
        crumbs = new();
        for (var cur = currentRow; cur != null && crumbs.Count < FolderAccess.MaxDepth; cur = cur.Folder.ParentId is { } p ? folderRows.FirstOrDefault(r => r.Folder.Id == p) : null)
            crumbs.Insert(0, cur);
    }

    private void OpenFolder(Guid? id) { folderId = id; picked.Clear(); menuFor = null; scopeAll = true; Rebuild(); }

    // ---------- Bloc des compositions : recherche, filtres, tri, affichage Cartes / Liste (comme les Listes de lecture) ----------
    private string view = "cards", sort = "name", filter = "", search = "";   // filter : "" | used | unused
    private bool scopeAll = true, newMenu;   // recherche et filtres : toutes les compositions (défaut) ou le dossier ouvert
    private bool Active => search.Length > 0 || filter != "";
    private bool ShowPath => Active && scopeAll;
    private int UsedIn(MediaItem c) => usage.TryGetValue(c.Id, out var l) ? l.Count : 0;

    // Menu « Filtres » : afficher (à plusieurs dans l'organisation, §212), utilisation
    private IReadOnlyList<FilterGroup> FilterGroups
    {
        get
        {
            var list = new List<FilterGroup>();
            if (multi && !readAll)
                list.Add(new("owner", "Afficher", OwnerOn ? tab : "", new FilterOption[]
                {
                    new("", isAdmin ? "Toute l'organisation" : "Toutes"),   // un membre ne voit que ses compositions et celles qu'on lui partage
                    new(LibraryTab.Mine, "Mes compositions", mineCount),
                    new(LibraryTab.Shared, "Partagées avec moi", sharedCount)
                }));
            list.Add(new FilterGroup("use", "Utilisation", filter, new List<FilterOption>
            {
                new("", "Toutes"),
                new("used", "Dans une liste", scopeItems.Count(c => UsedIn(c) > 0), "Placées dans au moins une liste de lecture"),
                new("unused", "Dans aucune liste", scopeItems.Count(c => UsedIn(c) == 0))
            }));
            return list;
        }
    }
    private IReadOnlyList<FilterExtra> FilterExtras => folderId != null && !scopeAll ? new[] { new FilterExtra("Dans : ce dossier", () => scopeAll = true) } : Array.Empty<FilterExtra>();
    private void PickFilter((string Key, string Value) p)
    {
        if (p.Key == "owner") { var t = p.Value == "" ? LibraryTab.All : p.Value; if (t != tab) SetTab(t); }
        else filter = p.Value;
    }
    private void ClearFilter(string key) => PickFilter((key, ""));
    private void ResetFilters() { scopeAll = true; filter = ""; if (OwnerOn) SetTab(LibraryTab.All); }
    private void ClearAll() { search = ""; ResetFilters(); }

    // Position ouverte (sauf recherche ou filtre dans toutes les compositions), puis filtrées et triées
    private IEnumerable<MediaItem> Sorted
    {
        get
        {
            var pool = ShowPath ? scopeItems : Shown;
            var q = pool.Where(c => filter switch { "used" => UsedIn(c) > 0, "unused" => UsedIn(c) == 0, _ => true })
                .Where(c => search.Length == 0 || c.Name.Contains(search, StringComparison.OrdinalIgnoreCase));
            return sort == "used"
                ? q.OrderByDescending(UsedIn).ThenBy(c => c.Name, StringComparer.CurrentCultureIgnoreCase)
                : q.OrderBy(c => c.Name, StringComparer.CurrentCultureIgnoreCase);
        }
    }

    // Emplacement d'une composition : chemin de son dossier, ou la racine
    private string PathOf(MediaItem c)
    {
        if (c.FolderId is not { } fid || folderRows.FirstOrDefault(r => r.Folder.Id == fid) is not { } row) return !multi ? "Compositions" : OwnerName(c.OwnerId) is { } ow ? $"Compositions de {ow}" : "Mes compositions";
        var names = new List<string>();
        for (var cur = row; cur != null && names.Count < FolderAccess.MaxDepth; cur = cur.Folder.ParentId is { } pid ? folderRows.FirstOrDefault(r => r.Folder.Id == pid) : null)
            names.Insert(0, cur.Folder.Name);
        return string.Join(" › ", names);
    }

    // Menu ⋮ d'une composition (carte et ligne de la liste)
    private RenderFragment Menu(MediaItem it) => __builder =>
    {
        var r = rights.GetValueOrDefault(it.Id);
        <div class="kebab">
            <button type="button" class="kebab-btn" aria-label="Actions pour @it.Name" aria-haspopup="menu" aria-expanded="@(menuFor == it.Id ? "true" : "false")" @onclick="() => menuFor = menuFor == it.Id ? null : it.Id"><Ico Name="dots-v" Size="18" /></button>
            @if (menuFor == it.Id)
            {
                <div class="kebab-backdrop" @onclick="() => menuFor = null"></div>
                <div class="kebab-menu" role="menu">
                    @if (r >= FolderRight.Write)
                    {
                        <a role="menuitem" href="/compositions/@it.Id"><Ico Name="edit" Size="16" /> Modifier</a>
                        <button type="button" role="menuitem" @onclick="() => StartRename(it.Id, it.Name, false)"><Ico Name="pencil-square" Size="16" /> Renommer…</button>
                    }
                    @if (canWrite) { <button type="button" role="menuitem" @onclick="() => Duplicate(it)"><Ico Name="copy" Size="16" /> Dupliquer</button> }
                    @if (Modes.Expert && r >= FolderRight.Write) { <button type="button" role="menuitem" @onclick="() => { menuFor = null; compMove = new() { (it.Id, it.Name) }; }"><Ico Name="folder" Size="16" /> Ranger dans un dossier…</button> }
                    @if (multi && r == FolderRight.Owner) { <button type="button" role="menuitem" @onclick="() => Share(ShareKind.Composition, it.Id, it.Name)"><Ico Name="share" Size="16" /> Partager…</button> }
                    @if (canWrite) { <button type="button" role="menuitem" @onclick="() => SaveAsTemplate(it)"><Ico Name="grid" Size="16" /> Enregistrer comme modèle</button> }
                    @if (OwnerName(it.OwnerId) != null && tabs.GetValueOrDefault(it.Id)?.SharedIn == true) { <button type="button" role="menuitem" class="danger" @onclick="() => Leave(ShareKind.Composition, it.Id, it.Name)"><Ico Name="eye-off" Size="16" /> Ne plus voir</button> }
                    @if (r == FolderRight.Owner) { <button type="button" role="menuitem" class="danger" @onclick="() => { menuFor = null; deleting = it; }"><Ico Name="trash" Size="16" /> Supprimer…</button> }
                </div>
            }
        </div>
    };

    private void OpenNewFolder() { newMenu = false; newFolderName = ""; folderError = null; creatingFolder = true; }

    private void CreateFolder()
    {
        var (error, _) = Folders.CreateFolder(newFolderName, folderId);
        if (error != null) { folderError = error; return; }
        creatingFolder = false;
        Toast.Ok($"Dossier « {newFolderName.Trim()} » créé.");
        Load();
    }

    private void RenameFolder(CompositionFolderRow rf)
    {
        var error = Folders.RenameFolder(rf.Folder.Id, renameFolderValue);
        if (error != null) { folderError = error; return; }
        renamingFolder = null;
        Toast.Ok("Dossier renommé.");
        Load();
    }

    private void DeleteFolder(CompositionFolderRow df)
    {
        var error = Folders.DeleteFolder(df.Folder.Id);
        deletingFolder = null;
        if (error != null) { Toast.Error(error); return; }
        if (folderId == df.Folder.Id) folderId = df.Folder.ParentId;
        Toast.Ok($"Dossier « {df.Folder.Name} » supprimé.");
        Load();
    }

    private void MovedFolder(bool moved) { reparenting = null; if (moved) Load(); }

    // Glisser-déposer : une composition, ou un dossier, vers un dossier (ou la racine, null)
    private void StartDrag(MediaItem c) => dragIds = new List<Guid> { c.Id };
    private void EndDrag() { dragIds = new(); dragFolder = null; dropOver = null; }

    private void DropOn(Guid? target)
    {
        if (dragFolder is { } df)   // un dossier glissé sur un autre : il y entre
        {
            EndDrag();
            if (target is { } t && t != df) { var err = Folders.MoveFolder(df, t); if (err != null) Toast.Error(err); else Toast.Ok("Dossier déplacé."); Load(); }
            return;
        }
        var ids = dragIds.ToList();
        EndDrag();
        if (ids.Count == 0) return;
        var (moved, refused) = Folders.MoveCompositions(ids, target);
        if (refused.Count > 0) Toast.Error(refused[0] + (refused.Count > 1 ? $" (et {refused.Count - 1} autre{(refused.Count > 2 ? "s" : "")})" : ""));
        if (moved > 0) Toast.Ok(moved > 1 ? $"{moved} compositions rangées." : "Composition rangée.");
        Load();
    }
}

