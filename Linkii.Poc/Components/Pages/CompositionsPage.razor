        if (error != null) { folderError = error; return; }
        renamingFolder = null;
        Toast.Ok("Dossier renommé.");
        Load();
    }

    private void DeleteFolder(CompositionFolderRow df)
    {
        var error = Folders.DeleteFolder(df.Folder.Id);
        deletingFolder = null;
        if (error != null) { Toast.Error(error); return; }
        if (folderId == df.Folder.Id) folderId = df.Folder.ParentId;
        Toast.Ok($"Dossier « {df.Folder.Name} » supprimé.");
        Load();
    }

    private void MovedFolder(bool moved) { reparenting = null; if (moved) Load(); }

    // Glisser-déposer : une composition, ou un dossier, vers un dossier (ou la racine, null)
    private void StartDrag(MediaItem c) => dragIds = new List<Guid> { c.Id };
    private void EndDrag() { dragIds = new(); dragFolder = null; dropOver = null; }

    private void DropOn(Guid? target)
    {
        if (dragFolder is { } df)   // un dossier glissé sur un autre : il y entre
        {
            EndDrag();
            if (target is { } t && t != df) { var err = Folders.MoveFolder(df, t); if (err != null) Toast.Error(err); else Toast.Ok("Dossier déplacé."); Load(); }
            return;
        }
        var ids = dragIds.ToList();
        EndDrag();
        if (ids.Count == 0) return;
        var (moved, refused) = Folders.MoveCompositions(ids, target);
        if (refused.Count > 0) Toast.Error(refused[0] + (refused.Count > 1 ? $" (et {refused.Count - 1} autre{(refused.Count > 2 ? "s" : "")})" : ""));
        if (moved > 0) Toast.Ok(moved > 1 ? $"{moved} compositions rangées." : "Composition rangée.");
        Load();
    }
}

@code {
