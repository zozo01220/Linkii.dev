        (me, multi, isAdmin, canWrite, people) = Store.Read(d => (d.Access.UserId, d.Users.Count(u => !u.Disabled) > 1, d.Access.IsOrgAdmin,
            d.Access.CanWrite(LevelPages.Media), d.Users.ToDictionary(u => u.Id, u => u.Label)));
        readAll = !isAdmin && !canWrite;   // médiathèque (et donc compositions) en « Voit tout · lecture seule »
        (rights, tabs, shares, tplRights, tplTabs, tplShares) = Store.Read(d => (
            items.ToDictionary(m => m.Id, m => CompositionRights.RightOf(d, m)),
            items.ToDictionary(m => m.Id, m => CompositionRights.TabOf(d, ShareKind.Composition, m.Id, m.OwnerId, m.FolderId)),
            ItemShareOps.Summaries(d, ShareKind.Composition),
            templates.ToDictionary(t => t.Id, t => CompositionRights.RightOf(d, t)),
            templates.ToDictionary(t => t.Id, t => CompositionRights.TabOf(d, ShareKind.Template, t.Id, t.OwnerId)),
            ItemShareOps.Summaries(d, ShareKind.Template)));
        if (tab != "models")
        {
            if (!multi || readAll) tab = LibraryTab.All;
            else if (tab == LibraryTab.All && !isAdmin) tab = LibraryTab.Mine;
        }
        if (sub == "shared" && SharedTemplates.Count == 0) sub = "mine";
        canCreateRoot = Store.Read(CompositionFolderOps.CanCreateAtRoot);
        (folderRows, folderShares) = Store.Read(d => (CompositionFolderOps.Rows(d), ItemShareOps.Summaries(d, ShareKind.CompositionFolder)));
        if (folderId is { } open && !folderRows.Any(r => r.Folder.Id == open)) folderId = null;   // dossier retiré entre-temps
        Rebuild();
        files = Library.PickableFiles().Where(m => m.Type == "image" && m.Status == null && m.FileName != null).ToList();
        usage = Store.Read(d => d.Playlists.SelectMany(p => p.Draft.Select(i => (i.MediaId, p.Name)))
            .Where(x => items.Any(c => c.Id == x.MediaId)).GroupBy(x => x.MediaId).ToDictionary(g => g.Key, g => g.Select(x => x.Name).Distinct().ToList()));
    }

    // La vignette d'un modèle utilise le même rendu qu'une composition
    private static MediaItem TemplateItem(CompositionTemplate t) => new() { Id = t.Id, Name = t.Name, Settings = new() { ["doc"] = t.Doc } };

    private void SetTab(string t)
    {
        tab = t; menuFor = null; galDrawn = false; galKey++; folderId = null;
        Rebuild();
        if (t == "models") return;
        try { Store.Write(d => { if (d.Users.FirstOrDefault(u => u.Id == d.Access.UserId) is { } u) u.LibraryTabs["compositions"] = t; }); }
        catch (UnauthorizedAccessException) { }   // lecture seule : l'onglet n'est pas retenu
    }
    private void SetSub(string s) { sub = s; menuFor = null; galDrawn = false; galKey++; }

    private void Create() => Nav.NavigateTo("/compositions/new?back=%2Fcompositions" + (folderId is { } f ? "&folder=" + f : ""));

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            try { inApp = await JS.InvokeAsync<bool>("linkiiPrefs.isApp"); if (inApp) StateHasChanged(); } catch (JSException) { } catch (InvalidOperationException) { } catch (JSDisconnectedException) { }
        }
        if (tab != "models" || sub != "gallery" || galDrawn || !installed) return;
        galDrawn = true;
        self ??= DotNetObjectReference.Create(this);
        try { await JS.InvokeVoidAsync("LinkiiCompoEditor.gallery", gal, self); }
        catch (JSDisconnectedException) { }
    }

    /// <summary>Un modèle de la galerie : l'éditeur s'ouvre dessus (rien n'est enregistré avant « Enregistrer »).</summary>
    [JSInvokable]
    public void Template(int index) => Nav.NavigateTo($"/compositions/new?tpl={index}&back=%2Fcompositions");

    private void UseTemplate(CompositionTemplate t) => Nav.NavigateTo($"/compositions/new?mytpl={t.Id}&back=%2Fcompositions");

    private void StartRename(Guid id, string current, bool template)
    {
        menuFor = null;
        renaming = (id, template);
        renameValue = current;
    }

    private void SaveRename()
    {
        if (renaming is not { } rn) return;
        string? err;
        try { err = rn.Template ? Store.Write(d => CompositionTemplates.Rename(d, rn.Id, renameValue)) : Svc.RenameInstance(rn.Id, renameValue); }
        catch (UnauthorizedAccessException e) { err = e.Message; }
        if (err != null) { Toast.Error(err); return; }
        renaming = null;
        Toast.Ok($"Renommé en « {renameValue.Trim()} ».");
        Load();
    }

    private void SaveAsTemplate(MediaItem it)
    {
        menuFor = null;
        string? err;
        try { err = Store.Write(d => CompositionTemplates.Save(d, it.Name, it.Settings.GetValueOrDefault("doc") ?? "").Error); }
        catch (UnauthorizedAccessException e) { err = e.Message; }
        if (err != null) { Toast.Error(err); return; }
        Toast.Ok($"« {it.Name} » ajouté à Mes modèles.");
        Load();
    }

    private void Duplicate(MediaItem it)
    {
        menuFor = null;
        var name = it.Name.Length > 70 ? it.Name[..70] : it.Name;
        var (copy, errors) = Svc.SaveInstance(Compositions.AppId, null, name + " (copie)", new Dictionary<string, string>(it.Settings));
        if (errors.Count > 0 || copy == null) { Toast.Error(errors.FirstOrDefault() ?? "Duplication impossible."); return; }
        Folders.PlaceNew(copy.Id, it.FolderId);   // la copie reste dans le dossier de l'original si on peut y écrire
        Toast.Ok($"« {copy.Name} » créée.");
        Load();
    }

    private void Delete(MediaItem it)
    {
        deleting = null;
        Svc.DeleteInstance(it.Id);   // retirée aussi des listes de lecture qui l'utilisent
        Toast.Ok($"« {it.Name} » supprimée.");
        Load();
    }

    private void DeleteTemplate(CompositionTemplate t)
    {
        deletingTpl = null;
        try { Store.Write(d => { CompositionTemplates.Delete(d, t.Id); }); }
        catch (UnauthorizedAccessException e) { Toast.Error(e.Message); return; }
        Toast.Ok($"Modèle « {t.Name} » supprimé.");
        Load();
    }
}
