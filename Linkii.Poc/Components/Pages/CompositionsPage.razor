    private string view = "cards", sort = "name", filter = "", search = "";   // filter : "" | used | unused
    private bool scopeAll = true, newMenu;   // recherche et filtres : toutes les compositions (défaut) ou le dossier ouvert
    private bool Active => search.Length > 0 || filter != "";
    private bool ShowPath => Active && scopeAll;
