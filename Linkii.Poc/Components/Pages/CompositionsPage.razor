    private IReadOnlyList<FilterExtra> FilterExtras => folderId != null && !scopeAll ? new[] { new FilterExtra("Dans : ce dossier", () => scopeAll = true) } : Array.Empty<FilterExtra>();
    private void PickFilter((string Key, string Value) p) => filter = p.Value;
