@page "/compositions"
@attribute [Microsoft.AspNetCore.Authorization.Authorize(Policy = "Page:compositions")]
@implements IDisposable
@using Microsoft.JSInterop
@inject AppService Svc
@inject MediaLibrary Library
@inject TenantStore Store
@inject Toaster Toast
@inject NavigationManager Nav
@inject IJSRuntime JS

@* Compositions (§80-81, §84) : Mes compositions, et les modèles (galerie Linkii et « Mes modèles » de l'aire). La page n'existe que si l'intégration
   « Compositions » est dans Mes intégrations. Les compositions de « Mes compositions » se placent ensuite dans les listes de lecture. *@
<HeadContent><link rel="stylesheet" href="compo-editor.css?v=6" /></HeadContent>

<div class="page-head">
    <div>
        <h1>Compositions</h1>
        <p class="sub">Vos propres pages d'affichage : textes, formes, images, QR codes et horloge, à placer dans vos listes de lecture.</p>
    </div>
    @if (installed && canWrite)
    {
        <div class="row head-actions">
            <button type="button" class="btn" data-fab="Créer une composition" @onclick="Create"><Ico Name="plus" Size="16" /> Créer une composition</button>
        </div>
    }
</div>

@if (!installed)
{
    <div class="empty">
        <div class="big">L'intégration « Compositions » n'est pas dans Mes intégrations</div>
        <p>Ajoutez-la depuis le Store des intégrations (bouton « Utiliser ») pour créer vos compositions et les placer dans vos listes de lecture.@(items.Count > 0 ? $" Vos {items.Count} composition{(items.Count > 1 ? "s" : "")} existante{(items.Count > 1 ? "s" : "")} sont conservées." : "")</p>
        <a class="btn" href="/integrations">Ouvrir les intégrations</a>
    </div>
}
else
{
    @* Onglets (24 octobre 2026) : ses compositions, celles qu'on lui partage, et pour l'administrateur toute l'organisation ; puis les modèles.
       Seul dans l'organisation ou en lecture seule : un seul onglet « Compositions » (tout). *@
    <nav class="tabs" role="tablist" aria-label="Compositions et modèles">
        @foreach (var t in Tabs)
        {
            var key = t.Key;
            <button type="button" role="tab" class="@(tab == key ? "on" : "")" aria-selected="@(tab == key ? "true" : "false")" @onclick="() => SetTab(key)">@t.Label @if (t.Count > 0) { <span class="cat-count">@t.Count</span> }</button>
        }
        <button type="button" role="tab" class="@(tab == "models" ? "on" : "")" aria-selected="@(tab == "models" ? "true" : "false")" @onclick='() => SetTab("models")'>Modèles</button>
    </nav>

    @if (tab != "models") { <NewMark Kind="composition" Ids="@items.Select(c => c.Id)" /> }
    else if (sub != "gallery") { <NewMark Kind="template" Ids="@templates.Select(t => t.Id)" /> }

    @if (tab == "models")
    {
        <div class="cmp-sub" role="tablist" aria-label="Galerie et Mes modèles">
            <button type="button" role="tab" class="@(sub == "gallery" ? "on" : "")" aria-selected="@(sub == "gallery" ? "true" : "false")" @onclick='() => SetSub("gallery")'>Galerie</button>
            <button type="button" role="tab" class="@(sub == "mine" ? "on" : "")" aria-selected="@(sub == "mine" ? "true" : "false")" @onclick='() => SetSub("mine")'>Mes modèles <span class="cat-count">@MyTemplates.Count</span></button>
            @if (SharedTemplates.Count > 0) { <button type="button" role="tab" class="@(sub == "shared" ? "on" : "")" aria-selected="@(sub == "shared" ? "true" : "false")" @onclick='() => SetSub("shared")'>Partagés avec moi <span class="cat-count">@SharedTemplates.Count</span></button> }
        </div>
        @if (sub == "gallery")
        {
            <p class="hint cmp-hint">Choisissez un modèle pour démarrer : tout reste modifiable, et rien n'est enregistré tant que vous ne l'avez pas fait.</p>
            <div @key="galKey" @ref="gal"></div>
        }
        else if (ShownTemplates.Count == 0)
        {
            <div class="empty">
                <div class="big">Aucun modèle pour l'instant</div>
                <p>Enregistrez une composition comme modèle (menu ⋮ d'une composition, ou « Enregistrer ▾ › Enregistrer comme modèle… » dans l'éditeur) pour la réutiliser comme point de départ.</p>
            </div>
        }
        else
        {
            <p class="hint cmp-hint">@(sub == "shared" ? "Les modèles que des collègues vous partagent." : "Vos modèles.") Partir d'un modèle crée une nouvelle composition ; le modèle ne change pas.</p>
            <div class="cmp-grid">
                @foreach (var t in ShownTemplates)
                {
                    var tp = t;
                    var tr = tplRights.GetValueOrDefault(tp.Id);
                    var tsum = tplShares.GetValueOrDefault(tp.Id, ShareSummary.None);
                    var tsize = Compositions.Size(new Dictionary<string, string> { ["doc"] = tp.Doc });
                    <article class="cmp-card" data-nid="@tp.Id">
                        <button type="button" class="cmp-open cmp-use" @onclick="() => UseTemplate(tp)" aria-label="Créer une composition à partir de « @tp.Name »"><CompositionThumb Item="TemplateItem(tp)" Files="files" Contain Label="@("Aperçu de " + tp.Name)" /></button>
                        <div class="cmp-info">
                            <div class="cmp-t">
                                <b title="@tp.Name">@tp.Name</b>
                                <div class="kebab">
                                    <button type="button" class="kebab-btn" aria-label="Actions pour le modèle @tp.Name" aria-haspopup="menu" aria-expanded="@(menuFor == tp.Id ? "true" : "false")" @onclick="() => menuFor = menuFor == tp.Id ? null : tp.Id"><Ico Name="dots-v" Size="18" /></button>
                                    @if (menuFor == tp.Id)
                                    {
                                        <div class="kebab-backdrop" @onclick="() => menuFor = null"></div>
                                        <div class="kebab-menu" role="menu">
                                            <button type="button" role="menuitem" @onclick="() => UseTemplate(tp)"><Ico Name="plus" Size="16" /> Créer une composition</button>
                                            @if (multi && tr == FolderRight.Owner) { <button type="button" role="menuitem" @onclick="() => Share(ShareKind.Template, tp.Id, tp.Name)"><Ico Name="share" Size="16" /> Partager…</button> }
                                            @if (tr >= FolderRight.Write) { <button type="button" role="menuitem" @onclick="() => StartRename(tp.Id, tp.Name, true)"><Ico Name="edit" Size="16" /> Renommer…</button> }
                                            @if (sub == "shared") { <button type="button" role="menuitem" class="danger" @onclick="() => Leave(ShareKind.Template, tp.Id, tp.Name)"><Ico Name="eye-off" Size="16" /> Ne plus voir</button> }
                                            @if (tr == FolderRight.Owner) { <button type="button" role="menuitem" class="danger" @onclick="() => { menuFor = null; deletingTpl = tp; }"><Ico Name="trash" Size="16" /> Supprimer…</button> }
                                        </div>
                                    }
                                </div>
                            </div>
                            <span class="cmp-m">@(tsize is { } ts ? $"{ts.W} × {ts.H}" : "Format inconnu") · ajouté le @tp.CreatedUtc.ToLocalTime().ToString("d MMMM yyyy", System.Globalization.CultureInfo.GetCultureInfo("fr-CH"))</span>
                            @if (OwnerName(tp.OwnerId) is { } tow) { <span class="lx-chip cmp-own" title="Modèle de @tow"><Ico Name="users" Size="12" /> @First(tow)</span> }
                            else if (tsum.Any) { <SharePill Summary="tsum" Clickable="multi && tr == FolderRight.Owner" OnClick="() => Share(ShareKind.Template, tp.Id, tp.Name)" /> }
                        </div>
                    </article>
                }
            </div>
        }
    }
    else if (Shown.Count == 0 && tab == LibraryTab.Shared)
    {
        <div class="empty">
            <div class="big">Rien n'a encore été partagé avec vous</div>
            <p>Quand un collègue vous partage une composition, elle apparaît ici. Vous pouvez la placer dans vos listes de lecture, ou la dupliquer pour l'adapter.</p>
        </div>
    }
    else if (Shown.Count == 0)
    {
        <div class="empty">
            <div class="big">Aucune composition</div>
            <p>Créez une page vide ou partez d'un modèle (horaires d'ouverture, accueil, orientation, annonce…). Vos compositions apparaîtront ici et pourront être ajoutées à vos listes de lecture.</p>
            <div class="row" style="justify-content:center;gap:10px">
                <button type="button" class="btn" @onclick="Create"><Ico Name="plus" Size="16" /> Créer une composition</button>
                <button type="button" class="btn ghost" @onclick='() => SetTab("models")'>Voir les modèles</button>
            </div>
        </div>
    }
    else
    {
        <div class="cmp-grid">
            @foreach (var c in Shown)
            {
                var it = c;
                var lists = usage.GetValueOrDefault(it.Id) ?? new();
                var size = Compositions.Size(it.Settings);
                var r = rights.GetValueOrDefault(it.Id);
                var csum = shares.GetValueOrDefault(it.Id, ShareSummary.None);
                <article class="cmp-card" data-nid="@it.Id">
                    @if (r >= FolderRight.Write) { <a class="cmp-open" href="/compositions/@it.Id" aria-label="Modifier « @it.Name »"><CompositionThumb Item="it" Files="files" Contain Label="@("Aperçu de " + it.Name)" /></a> }
                    else { <div class="cmp-open" title="Lecture seule : dupliquez-la pour l'adapter"><CompositionThumb Item="it" Files="files" Contain Label="@("Aperçu de " + it.Name)" /></div> }
                    <div class="cmp-info">
                        <div class="cmp-t">
                            <b title="@it.Name">@it.Name</b>
                            <div class="kebab">
                                <button type="button" class="kebab-btn" aria-label="Actions pour @it.Name" aria-haspopup="menu" aria-expanded="@(menuFor == it.Id ? "true" : "false")" @onclick="() => menuFor = menuFor == it.Id ? null : it.Id"><Ico Name="dots-v" Size="18" /></button>
                                @if (menuFor == it.Id)
                                {
                                    <div class="kebab-backdrop" @onclick="() => menuFor = null"></div>
                                    <div class="kebab-menu" role="menu">
                                        @if (r >= FolderRight.Write)
                                        {
                                            <a role="menuitem" href="/compositions/@it.Id"><Ico Name="edit" Size="16" /> Modifier</a>
                                            <button type="button" role="menuitem" @onclick="() => StartRename(it.Id, it.Name, false)"><Ico Name="pencil-square" Size="16" /> Renommer…</button>
                                        }
                                        @if (canWrite) { <button type="button" role="menuitem" @onclick="() => Duplicate(it)"><Ico Name="copy" Size="16" /> Dupliquer</button> }
                                        @if (multi && r == FolderRight.Owner) { <button type="button" role="menuitem" @onclick="() => Share(ShareKind.Composition, it.Id, it.Name)"><Ico Name="share" Size="16" /> Partager…</button> }
                                        @if (canWrite) { <button type="button" role="menuitem" @onclick="() => SaveAsTemplate(it)"><Ico Name="grid" Size="16" /> Enregistrer comme modèle</button> }
                                        @if (tab == LibraryTab.Shared && tabs.GetValueOrDefault(it.Id)?.SharedIn == true) { <button type="button" role="menuitem" class="danger" @onclick="() => Leave(ShareKind.Composition, it.Id, it.Name)"><Ico Name="eye-off" Size="16" /> Ne plus voir</button> }
                                        @if (r == FolderRight.Owner) { <button type="button" role="menuitem" class="danger" @onclick="() => { menuFor = null; deleting = it; }"><Ico Name="trash" Size="16" /> Supprimer…</button> }
                                    </div>
                                }
                            </div>
                        </div>
                        <span class="cmp-m">@(size is { } s ? $"{s.W} × {s.H}" : "Format inconnu") · @(lists.Count == 0 ? "dans aucune liste" : lists.Count == 1 ? "dans « " + lists[0] + " »" : $"dans {lists.Count} listes")</span>
                        @if (OwnerName(it.OwnerId) is { } ow) { <span class="lx-chip cmp-own" title="@OwnerTitle(ow, r)"><Ico Name="users" Size="12" /> @First(ow)</span> }
                        else if (csum.Any) { <SharePill Summary="csum" Clickable="multi && r == FolderRight.Owner" OnClick="() => Share(ShareKind.Composition, it.Id, it.Name)" /> }
                    </div>
                </article>
            }
        </div>
    }
}

@if (renaming is { } rn)
{
    <div class="modal-backdrop" @onclick="() => renaming = null"></div>
    <div class="modal" role="dialog" aria-modal="true" aria-labelledby="cmp-rn-title">
        <h3 id="cmp-rn-title">@(rn.Template ? "Renommer le modèle" : "Renommer la composition")</h3>
        <p class="hint">@(rn.Template ? "Le nom s'affiche dans « Mes modèles »." : "Le nom s'affiche dans le back-office (listes de lecture, Compositions), pas sur les écrans.")</p>
        <input style="width:100%" maxlength="80" aria-label="Nouveau nom" @bind="renameValue" @bind:event="oninput" @onkeydown='e => { if (e.Key == "Enter") SaveRename(); }' />
        <div class="modal-actions">
            <button class="btn ghost" @onclick="() => renaming = null">Annuler</button>
            <button class="btn" disabled="@string.IsNullOrWhiteSpace(renameValue)" @onclick="SaveRename">Renommer</button>
        </div>
    </div>
}

@if (deleting is { } del)
{
    var lists = usage.GetValueOrDefault(del.Id) ?? new();
    <div class="modal-backdrop" @onclick="() => deleting = null"></div>
    <div class="modal" role="alertdialog" aria-modal="true" aria-labelledby="cmp-del-title">
        <h3 id="cmp-del-title">Supprimer « @del.Name » ?</h3>
        @if (lists.Count > 0)
        {
            <p class="hint">Elle est utilisée par @(lists.Count == 1 ? "la liste" : $"{lists.Count} listes") : <b>@string.Join(", ", lists.Take(5))@(lists.Count > 5 ? $" et {lists.Count - 5} autre(s)" : "")</b>. Elle en sera retirée ; les écrans gardent leur version actuelle jusqu'à leur prochaine publication.</p>
        }
        else { <p class="hint">Aucune liste de lecture ne l'utilise.</p> }
        <p class="hint">Les images de la médiathèque ne sont pas supprimées. Cette action est définitive.</p>
        <div class="modal-actions">
            <button class="btn ghost" @onclick="() => deleting = null">Annuler</button>
            <button class="btn danger-solid" @onclick="() => Delete(del)">Supprimer</button>
        </div>
    </div>
}

@if (deletingTpl is { } dt)
{
    <div class="modal-backdrop" @onclick="() => deletingTpl = null"></div>
    <div class="modal" role="alertdialog" aria-modal="true" aria-labelledby="cmp-dt-title">
        <h3 id="cmp-dt-title">Supprimer le modèle « @dt.Name » ?</h3>
        <p class="hint">Les compositions créées à partir de ce modèle ne changent pas. Les images de la médiathèque ne sont pas supprimées.</p>
        <div class="modal-actions">
            <button class="btn ghost" @onclick="() => deletingTpl = null">Annuler</button>
            <button class="btn danger-solid" @onclick="() => DeleteTemplate(dt)">Supprimer</button>
        </div>
    </div>
}

@if (sharing is { } sh)
{
    <ShareDialog Kind="@sh.Kind" Items="new() { (sh.Id, sh.Name) }" OnClose="() => sharing = null" OnShared="Load" />
}

@code {
    private bool installed;
    private string tab = LibraryTab.Mine, sub = "gallery";

    // ---------- Propriétaire, onglets et partage (24 octobre 2026) : comme la médiathèque ----------
    private Guid? me;
    private bool multi, readAll, isAdmin, canWrite;
    private Dictionary<Guid, FolderRight> rights = new(), tplRights = new();
    private Dictionary<Guid, LibraryTab.Info> tabs = new(), tplTabs = new();
    private Dictionary<Guid, ShareSummary> shares = new(), tplShares = new();
    private Dictionary<Guid, string> people = new();
    private (string Kind, Guid Id, string Name)? sharing;
    private record TabItem(string Key, string Label, int Count);

    private List<MediaItem> Shown => items.Where(m => tabs.TryGetValue(m.Id, out var i) ? LibraryTab.InTab(tab, i, me, isAdmin) : tab == LibraryTab.All).ToList();
    private List<CompositionTemplate> MyTemplates => templates.Where(t => !tplTabs.TryGetValue(t.Id, out var i) || readAll || LibraryTab.IsMine(i, me, isAdmin)).ToList();
    private List<CompositionTemplate> SharedTemplates => readAll ? new() : templates.Where(t => tplTabs.TryGetValue(t.Id, out var i) && LibraryTab.InTab(LibraryTab.Shared, i, me, isAdmin)).ToList();
    private List<CompositionTemplate> ShownTemplates => sub == "shared" ? SharedTemplates : MyTemplates;

    private List<TabItem> Tabs => !multi || readAll
        ? new() { new(LibraryTab.All, "Compositions", items.Count) }
        : new List<TabItem>
        {
            new(LibraryTab.Mine, "Mes compositions", items.Count(m => tabs.TryGetValue(m.Id, out var i) && LibraryTab.IsMine(i, me, isAdmin))),
            new(LibraryTab.Shared, "Partagées avec moi", items.Count(m => tabs.TryGetValue(m.Id, out var i) && LibraryTab.InTab(LibraryTab.Shared, i, me, isAdmin)))
        }.Concat(isAdmin ? [new TabItem(LibraryTab.All, "Toute l'organisation", 0)] : Array.Empty<TabItem>()).ToList();

    // Élément d'un autre : nom de son propriétaire (null : le sien, ou un élément de l'organisation vu par un administrateur)
    private string? OwnerName(Guid? owner) =>
        !multi || owner is { } o && o == me ? null : owner is { } o2 && people.TryGetValue(o2, out var n) ? n : isAdmin ? null : "l'organisation";
    private static string OwnerTitle(string owner, FolderRight r) => $"Composition de {owner}, " + (r >= FolderRight.Write ? "vous pouvez la modifier" : "vous pouvez l'utiliser");
    private static string First(string name) => name.Split(' ', StringSplitOptions.RemoveEmptyEntries).FirstOrDefault() ?? name;

    private void Share(string kind, Guid id, string name) { menuFor = null; sharing = (kind, id, name); }

    private void Leave(string kind, Guid id, string name)
    {
        menuFor = null;
        string? err;
        try { err = Store.Write(d => ItemShareOps.Leave(d, kind, id)); }
        catch (UnauthorizedAccessException e) { err = e.Message; }
        if (err != null) { Toast.Error(err); return; }
        Toast.Ok($"« {name} » n'apparaît plus dans vos partages.");
        Load();
    }
    private List<MediaItem> items = new(), files = new();
    private List<CompositionTemplate> templates = new();
    private Dictionary<Guid, List<string>> usage = new();
    private Guid? menuFor;
    private MediaItem? deleting;
    private CompositionTemplate? deletingTpl;
    private (Guid Id, bool Template)? renaming;
    private string renameValue = "";
    private ElementReference gal;
    private int galKey;
    private bool galDrawn;
    private DotNetObjectReference<CompositionsPage>? self;

    protected override void OnInitialized()
    {
        Svc.InstallsChanged += OnInstalls;
        tab = Store.Read(d => d.Users.FirstOrDefault(u => u.Id == d.Access.UserId)?.LibraryTabs.GetValueOrDefault("compositions")) ?? LibraryTab.Mine;
        Load();
    }

    private void OnInstalls() => InvokeAsync(() => { Load(); StateHasChanged(); });
    public void Dispose() { Svc.InstallsChanged -= OnInstalls; self?.Dispose(); }

    private void Load()
    {
        installed = Svc.IsInstalled(Compositions.AppId);
        items = Svc.Instances(Compositions.AppId);
        templates = Store.Read(d => CompositionTemplates.Visible(d).OrderByDescending(t => t.CreatedUtc).ToList());
        (me, multi, isAdmin, canWrite, people) = Store.Read(d => (d.Access.UserId, d.Users.Count(u => !u.Disabled) > 1, d.Access.IsOrgAdmin,
            d.Access.CanWrite(LevelPages.Media), d.Users.ToDictionary(u => u.Id, u => u.Label)));
        readAll = !isAdmin && !canWrite;   // médiathèque (et donc compositions) en « Voit tout · lecture seule »
        (rights, tabs, shares, tplRights, tplTabs, tplShares) = Store.Read(d => (
            items.ToDictionary(m => m.Id, m => CompositionRights.RightOf(d, m)),
            items.ToDictionary(m => m.Id, m => CompositionRights.TabOf(d, ShareKind.Composition, m.Id, m.OwnerId)),
            ItemShareOps.Summaries(d, ShareKind.Composition),
            templates.ToDictionary(t => t.Id, t => CompositionRights.RightOf(d, t)),
            templates.ToDictionary(t => t.Id, t => CompositionRights.TabOf(d, ShareKind.Template, t.Id, t.OwnerId)),
            ItemShareOps.Summaries(d, ShareKind.Template)));
        if (tab != "models")
        {
            if (!multi || readAll) tab = LibraryTab.All;
            else if (tab == LibraryTab.All && !isAdmin) tab = LibraryTab.Mine;
        }
        if (sub == "shared" && SharedTemplates.Count == 0) sub = "mine";
        files = Library.PickableFiles().Where(m => m.Type == "image" && m.Status == null && m.FileName != null).ToList();
        usage = Store.Read(d => d.Playlists.SelectMany(p => p.Draft.Select(i => (i.MediaId, p.Name)))
            .Where(x => items.Any(c => c.Id == x.MediaId)).GroupBy(x => x.MediaId).ToDictionary(g => g.Key, g => g.Select(x => x.Name).Distinct().ToList()));
    }

    // La vignette d'un modèle utilise le même rendu qu'une composition
    private static MediaItem TemplateItem(CompositionTemplate t) => new() { Id = t.Id, Name = t.Name, Settings = new() { ["doc"] = t.Doc } };

    private void SetTab(string t)
    {
        tab = t; menuFor = null; galDrawn = false; galKey++;
        if (t == "models") return;
        try { Store.Write(d => { if (d.Users.FirstOrDefault(u => u.Id == d.Access.UserId) is { } u) u.LibraryTabs["compositions"] = t; }); }
        catch (UnauthorizedAccessException) { }   // lecture seule : l'onglet n'est pas retenu
    }
    private void SetSub(string s) { sub = s; menuFor = null; galDrawn = false; galKey++; }

    private void Create() => Nav.NavigateTo("/compositions/new?back=%2Fcompositions");

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (tab != "models" || sub != "gallery" || galDrawn || !installed) return;
        galDrawn = true;
        self ??= DotNetObjectReference.Create(this);
        try { await JS.InvokeVoidAsync("LinkiiCompoEditor.gallery", gal, self); }
        catch (JSDisconnectedException) { }
    }

    /// <summary>Un modèle de la galerie : l'éditeur s'ouvre dessus (rien n'est enregistré avant « Enregistrer »).</summary>
    [JSInvokable]
    public void Template(int index) => Nav.NavigateTo($"/compositions/new?tpl={index}&back=%2Fcompositions");

    private void UseTemplate(CompositionTemplate t) => Nav.NavigateTo($"/compositions/new?mytpl={t.Id}&back=%2Fcompositions");

    private void StartRename(Guid id, string current, bool template)
    {
        menuFor = null;
        renaming = (id, template);
        renameValue = current;
    }

    private void SaveRename()
    {
        if (renaming is not { } rn) return;
        string? err;
        try { err = rn.Template ? Store.Write(d => CompositionTemplates.Rename(d, rn.Id, renameValue)) : Svc.RenameInstance(rn.Id, renameValue); }
        catch (UnauthorizedAccessException e) { err = e.Message; }
        if (err != null) { Toast.Error(err); return; }
        renaming = null;
        Toast.Ok($"Renommé en « {renameValue.Trim()} ».");
        Load();
    }

    private void SaveAsTemplate(MediaItem it)
    {
        menuFor = null;
        string? err;
        try { err = Store.Write(d => CompositionTemplates.Save(d, it.Name, it.Settings.GetValueOrDefault("doc") ?? "").Error); }
        catch (UnauthorizedAccessException e) { err = e.Message; }
        if (err != null) { Toast.Error(err); return; }
        Toast.Ok($"« {it.Name} » ajouté à Mes modèles.");
        Load();
    }

    private void Duplicate(MediaItem it)
    {
        menuFor = null;
        var name = it.Name.Length > 70 ? it.Name[..70] : it.Name;
        var (copy, errors) = Svc.SaveInstance(Compositions.AppId, null, name + " (copie)", new Dictionary<string, string>(it.Settings));
        if (errors.Count > 0 || copy == null) { Toast.Error(errors.FirstOrDefault() ?? "Duplication impossible."); return; }
        Toast.Ok($"« {copy.Name} » créée.");
        Load();
    }

    private void Delete(MediaItem it)
    {
        deleting = null;
        Svc.DeleteInstance(it.Id);   // retirée aussi des listes de lecture qui l'utilisent
        Toast.Ok($"« {it.Name} » supprimée.");
        Load();
    }

    private void DeleteTemplate(CompositionTemplate t)
    {
        deletingTpl = null;
        try { Store.Write(d => { CompositionTemplates.Delete(d, t.Id); }); }
        catch (UnauthorizedAccessException e) { Toast.Error(e.Message); return; }
        Toast.Ok($"Modèle « {t.Name} » supprimé.");
        Load();
    }
