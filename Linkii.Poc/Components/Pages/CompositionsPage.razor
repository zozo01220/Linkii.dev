@page "/compositions"
@attribute [Microsoft.AspNetCore.Authorization.Authorize(Policy = "Page:compositions")]
@implements IDisposable
@using Microsoft.JSInterop
@inject AppService Svc
@inject MediaLibrary Library
@inject CompositionLibrary Folders
@inject TenantStore Store
@inject Toaster Toast
@inject NavigationManager Nav
@inject IJSRuntime JS

@* Compositions (§80-81, §84) : Mes compositions, et les modèles (galerie Linkii et « Mes modèles » de l'aire). La page n'existe que si l'intégration
   « Compositions » est dans Mes intégrations. Les compositions de « Mes compositions » se placent ensuite dans les listes de lecture. *@
<HeadContent><link rel="stylesheet" href="compo-editor.css?v=6" /></HeadContent>

<div class="page-head">
    <div>
        <h1 class="cmp-h1">
            @if (tab != "models" && currentRow is { } cur)
            {
                <button type="button" class="lx-crumb @(dropOver == RootDrop ? "drop-target" : "")" @onclick="() => OpenFolder(null)"
                        @ondragover="() => { }" @ondragover:preventDefault="true" @ondragenter="() => { if (dragIds.Count > 0) dropOver = RootDrop; }" @ondragleave="() => { if (dropOver == RootDrop) dropOver = null; }" @ondrop:preventDefault="true" @ondrop="() => DropOn(null)">Compositions</button>
                @foreach (var c in crumbs.Take(crumbs.Count - 1))
                {
                    var row = c;
                    <span class="lx-sl">/</span>
                    <button type="button" class="lx-crumb @(dropOver == row.Folder.Id ? "drop-target" : "")" @onclick="() => OpenFolder(row.Folder.Id)"
                            @ondragover="() => { }" @ondragover:preventDefault="true" @ondragenter="() => { if (dragIds.Count > 0) dropOver = row.Folder.Id; }" @ondragleave="() => { if (dropOver == row.Folder.Id) dropOver = null; }" @ondrop:preventDefault="true" @ondrop="() => DropOn(row.Folder.Id)">@row.Folder.Name</button>
                }
                <span class="lx-sl">/</span>
                <span>@cur.Folder.Name</span>
                <span class="lx-right @(cur.Right == FolderRight.Read ? "ro" : "")"><Ico Name="@(cur.Right == FolderRight.Read ? "lock" : "folder")" Size="12" /> @RightLabel(cur)</span>
                <SharePill Summary="FolderSum(cur.Folder.Id)" Long="true" Clickable="multi && cur.Right == FolderRight.Owner" ReadOnly="cur.Right == FolderRight.Read" OwnerName="@(cur.Folder.OwnerId == me ? null : cur.OwnerName)" OnClick="() => ShareFolder(cur)" />
            }
            else
            {
                <span>Compositions</span>
            }
        </h1>
        <p class="sub">Vos propres pages d'affichage : textes, formes, images, QR codes et horloge, à placer dans vos listes de lecture.</p>
    </div>
    @if (installed && (CanCreateHere || CanCreateFolderHere || (multi && currentRow is { Right: FolderRight.Owner })))
    {
        <div class="row head-actions">
            @if (multi && tab != "models" && currentRow is { Right: FolderRight.Owner } here)
            {
                <button type="button" class="btn btn-share lx-share" @onclick="() => ShareFolder(here)"><Ico Name="users" Size="16" /> Partager…</button>
            }
            @if (CanCreateHere)
            {
                <div class="lx-split">
                    <button type="button" class="btn" data-fab="Créer une composition" @onclick="Create"><Ico Name="plus" Size="16" /> Créer une composition</button>
                    @if (CanCreateFolderHere) { <button type="button" class="btn ghost lx-appfolder" data-fab="Nouveau dossier" @onclick="OpenNewFolder"><Ico Name="folder" Size="16" /> Nouveau dossier</button> }
                    @if (CanCreateFolderHere)
                    {
                        <button type="button" class="btn lx-car" aria-label="Autres créations" aria-haspopup="menu" aria-expanded="@(newMenu ? "true" : "false")" @onclick="() => newMenu = !newMenu"><Ico Name="chevron" Size="14" /></button>
                        @if (newMenu)
                        {
                            <div class="kebab-backdrop" @onclick="() => newMenu = false"></div>
                            <div class="kebab-menu" role="menu">
                                <button type="button" role="menuitem" @onclick="() => { newMenu = false; Create(); }"><Ico Name="grid" Size="16" /> Nouvelle composition</button>
                                <button type="button" role="menuitem" @onclick="OpenNewFolder"><Ico Name="folder" Size="16" /> Nouveau dossier@(currentRow is { } cf ? $" dans « {cf.Folder.Name} »" : "")</button>
                            </div>
                        }
                    }
                </div>
            }
            else if (CanCreateFolderHere) { <button type="button" class="btn ghost" data-fab="Nouveau dossier" @onclick="OpenNewFolder"><Ico Name="folder" Size="16" /> Nouveau dossier</button> }
        </div>
    }
</div>

@if (!installed)
{
    <div class="empty">
        <div class="big">L'intégration « Compositions » n'est pas dans Mes intégrations</div>
        <p>Ajoutez-la depuis le Store des intégrations (bouton « Utiliser ») pour créer vos compositions et les placer dans vos listes de lecture.@(items.Count > 0 ? $" Vos {items.Count} composition{(items.Count > 1 ? "s" : "")} existante{(items.Count > 1 ? "s" : "")} sont conservées." : "")</p>
        <a class="btn" href="/integrations">Ouvrir les intégrations</a>
    </div>
}
else
{
    @* Onglets (24 octobre 2026) : ses compositions, celles qu'on lui partage, et pour l'administrateur toute l'organisation ; puis les modèles.
       Seul dans l'organisation ou en lecture seule : un seul onglet « Compositions » (tout). *@
    <nav class="tabs" role="tablist" aria-label="Compositions et modèles">
        @foreach (var t in Tabs)
        {
            var key = t.Key;
            <button type="button" role="tab" class="@(tab == key ? "on" : "")" aria-selected="@(tab == key ? "true" : "false")" @onclick="() => SetTab(key)">@t.Label @if (t.Count > 0) { <span class="cat-count">@t.Count</span> }<TabNew Family="compositions" Tab="@key" /></button>
        }
        <button type="button" role="tab" class="@(tab == "models" ? "on" : "")" aria-selected="@(tab == "models" ? "true" : "false")" @onclick='() => SetTab("models")'>Modèles</button>
    </nav>

    @if (tab != "models") { <NewMark Family="compositions" Tab="@tab" Ids="@items.Select(c => c.Id).Concat(folderRows.Select(r => r.Folder.Id))" /> }
    else if (sub != "gallery") { <NewMark Kind="template" Ids="@templates.Select(t => t.Id)" /> }

    @if (tab == "models")
    {
        <div class="cmp-sub" role="tablist" aria-label="Galerie et Mes modèles">
            <button type="button" role="tab" class="@(sub == "gallery" ? "on" : "")" aria-selected="@(sub == "gallery" ? "true" : "false")" @onclick='() => SetSub("gallery")'>Galerie</button>
            <button type="button" role="tab" class="@(sub == "mine" ? "on" : "")" aria-selected="@(sub == "mine" ? "true" : "false")" @onclick='() => SetSub("mine")'>Mes modèles <span class="cat-count">@MyTemplates.Count</span></button>
            @if (SharedTemplates.Count > 0) { <button type="button" role="tab" class="@(sub == "shared" ? "on" : "")" aria-selected="@(sub == "shared" ? "true" : "false")" @onclick='() => SetSub("shared")'>Partagés avec moi <span class="cat-count">@SharedTemplates.Count</span></button> }
        </div>
        @if (sub == "gallery")
        {
            <p class="hint cmp-hint">Choisissez un modèle pour démarrer : tout reste modifiable, et rien n'est enregistré tant que vous ne l'avez pas fait.</p>
            <div @key="galKey" @ref="gal"></div>
        }
        else if (ShownTemplates.Count == 0)
        {
            <div class="empty">
                <div class="big">Aucun modèle pour l'instant</div>
                <p>Enregistrez une composition comme modèle (menu ⋮ d'une composition, ou « Enregistrer ▾ › Enregistrer comme modèle… » dans l'éditeur) pour la réutiliser comme point de départ.</p>
            </div>
        }
        else
        {
            <p class="hint cmp-hint">@(sub == "shared" ? "Les modèles que des collègues vous partagent." : "Vos modèles.") Partir d'un modèle crée une nouvelle composition ; le modèle ne change pas.</p>
            <div class="cmp-grid">
                @foreach (var t in ShownTemplates)
                {
                    var tp = t;
                    var tr = tplRights.GetValueOrDefault(tp.Id);
                    var tsum = tplShares.GetValueOrDefault(tp.Id, ShareSummary.None);
                    var tsize = Compositions.Size(new Dictionary<string, string> { ["doc"] = tp.Doc });
                    <article class="cmp-card" data-nid="@tp.Id">
                        <button type="button" class="cmp-open cmp-use" @onclick="() => UseTemplate(tp)" aria-label="Créer une composition à partir de « @tp.Name »"><CompositionThumb Item="TemplateItem(tp)" Files="files" Contain Label="@("Aperçu de " + tp.Name)" /></button>
                        <div class="cmp-info">
                            <div class="cmp-t">
                                <b title="@tp.Name">@tp.Name</b>
                                <div class="kebab">
                                    <button type="button" class="kebab-btn" aria-label="Actions pour le modèle @tp.Name" aria-haspopup="menu" aria-expanded="@(menuFor == tp.Id ? "true" : "false")" @onclick="() => menuFor = menuFor == tp.Id ? null : tp.Id"><Ico Name="dots-v" Size="18" /></button>
                                    @if (menuFor == tp.Id)
                                    {
                                        <div class="kebab-backdrop" @onclick="() => menuFor = null"></div>
                                        <div class="kebab-menu" role="menu">
                                            <button type="button" role="menuitem" @onclick="() => UseTemplate(tp)"><Ico Name="plus" Size="16" /> Créer une composition</button>
                                            @if (multi && tr == FolderRight.Owner) { <button type="button" role="menuitem" @onclick="() => Share(ShareKind.Template, tp.Id, tp.Name)"><Ico Name="share" Size="16" /> Partager…</button> }
                                            @if (tr >= FolderRight.Write) { <button type="button" role="menuitem" @onclick="() => StartRename(tp.Id, tp.Name, true)"><Ico Name="edit" Size="16" /> Renommer…</button> }
                                            @if (sub == "shared") { <button type="button" role="menuitem" class="danger" @onclick="() => Leave(ShareKind.Template, tp.Id, tp.Name)"><Ico Name="eye-off" Size="16" /> Ne plus voir</button> }
                                            @if (tr == FolderRight.Owner) { <button type="button" role="menuitem" class="danger" @onclick="() => { menuFor = null; deletingTpl = tp; }"><Ico Name="trash" Size="16" /> Supprimer…</button> }
                                        </div>
                                    }
                                </div>
                            </div>
                            <span class="cmp-m">@(tsize is { } ts ? $"{ts.W} × {ts.H}" : "Format inconnu") · ajouté le @tp.CreatedUtc.ToLocalTime().ToString("d MMMM yyyy", System.Globalization.CultureInfo.GetCultureInfo("fr-CH"))</span>
                            @if (OwnerName(tp.OwnerId) is { } tow) { <span class="lx-chip cmp-own" title="Modèle de @tow"><Ico Name="users" Size="12" /> @First(tow)</span> }
                            else if (tsum.Any) { <SharePill Summary="tsum" Clickable="multi && tr == FolderRight.Owner" OnClick="() => Share(ShareKind.Template, tp.Id, tp.Name)" /> }
                        </div>
                    </article>
                }
            </div>
        }
    }
    else if (scopeItems.Count == 0 && subfolders.Count == 0 && folderId == null && tab == LibraryTab.Shared)
    {
        <div class="empty">
            <div class="big">Rien n'a encore été partagé avec vous</div>
            <p>Quand un collègue vous partage une composition ou un dossier, il apparaît ici. Vous pouvez la placer dans vos listes de lecture, ou la dupliquer pour l'adapter.</p>
        </div>
    }
    else if (scopeItems.Count == 0 && subfolders.Count == 0 && folderId == null)
    {
        <div class="empty">
            <div class="big">Aucune composition</div>
            <p>Créez une page vide ou partez d'un modèle (horaires d'ouverture, accueil, orientation, annonce…). Vos compositions apparaîtront ici et pourront être ajoutées à vos listes de lecture.</p>
            <div class="row" style="justify-content:center;gap:10px">
                <button type="button" class="btn" @onclick="Create"><Ico Name="plus" Size="16" /> Créer une composition</button>
                <button type="button" class="btn ghost" @onclick='() => SetTab("models")'>Voir les modèles</button>
            </div>
        </div>
    }
    else
    {
        <div class="lx-status">
            <span class="lx-appoff">@Plural(Shown.Count, "composition", "compositions")@(folderRows.Count > 0 ? $" · {Plural(folderRows.Count, "dossier", "dossiers")}" : "")</span>
            @if (currentRow is { Right: FolderRight.Read })
            {
                <span>Vous pouvez utiliser ces compositions, pas les modifier. Dupliquez-en une pour l'adapter.</span>
            }
        </div>

        <section class="lx-fzone" aria-label="Dossiers">
        @* Dossiers de la position ouverte : mêmes formes, aperçus et actions que la Médiathèque (FolderShape, .lx-fcard), cibles du glisser-déposer. *@
        @if (subfolders.Count > 0 || CanCreateFolderHere)
        {
            <div class="lx-fstrip lx-fgrid" role="list" aria-label="Dossiers">
                @foreach (var row in subfolders)
                {
                    var r = row;
                    var mine = r.Folder.OwnerId == me;
                    var sum = FolderSum(r.Folder.Id);
                    var preview = FolderPreview(r.Folder.Id);
                    var canMenu = r.Right == FolderRight.Owner;
                    <div data-nid="@r.Folder.Id" class="lx-fcard @(dropOver == r.Folder.Id ? "drop-target" : "")" role="listitem" tabindex="0" draggable="@(r.Right == FolderRight.Owner && !inApp ? "true" : null)" @ondragstart="() => { dragFolder = r.Folder.Id; }" @ondragend="EndDrag" title="@FolderTitle(r)" aria-label="Ouvrir le dossier @r.Folder.Name"
                         @onclick="() => OpenFolder(r.Folder.Id)" @onkeydown='e => { if (e.Key == "Enter") OpenFolder(r.Folder.Id); }'
                         @ondragover="() => { }" @ondragover:preventDefault="true" @ondragenter="() => { if (dragIds.Count > 0 || (dragFolder != null && dragFolder != r.Folder.Id)) dropOver = r.Folder.Id; }" @ondragleave="() => { if (dropOver == r.Folder.Id) dropOver = null; }" @ondrop:preventDefault="true" @ondrop="() => DropOn(r.Folder.Id)"
                         @oncontextmenu="() => { if (canMenu) menuFor = r.Folder.Id; }" @oncontextmenu:preventDefault="inApp && canMenu">
                        <FolderShape Preview="preview" All="files" Count="ChildCount(r.Folder.Id)" Unit="@FolderUnit(r.Folder.Id)">
                            <Thumb Context="pm"><CompositionThumb Item="pm" Files="files" Contain Label="@("Aperçu de " + pm.Name)" /></Thumb>
                            <Badge>
                                @if (r.Right == FolderRight.Read) { <span class="fbadge ro" title="Dossier de @r.OwnerName"><Ico Name="lock" Size="11" /> @(tab == LibraryTab.Mine ? "Lecture seule" : First(r.OwnerName))</span> }
                                else if (r.Right == FolderRight.Write) { <span class="fbadge lvl" title="Dossier de @r.OwnerName, vous pouvez le modifier"><Ico Name="users" Size="11" /> @First(r.OwnerName)</span> }
                                else if (sum.Any) { <span class="fbadge @(sum.Everyone != null ? "lvl" : "sh")"><Ico Name="users" Size="11" /> @(sum.Everyone != null ? "Partagé · tous" : $"Partagé · {sum.People}")</span> }
                                else if (!mine && tab != LibraryTab.Mine && r.Folder.OwnerId != null) { <span class="fbadge sh" title="Dossier de @r.OwnerName">@First(r.OwnerName)</span> }
                            </Badge>
                        </FolderShape>
                        <div class="fn"><span>@r.Folder.Name</span><small>@FolderDate(r)</small></div>
                        @if (canMenu)
                        {
                            <button type="button" class="fk" aria-label="Actions pour le dossier @r.Folder.Name" aria-haspopup="menu" aria-expanded="@(menuFor == r.Folder.Id ? "true" : "false")"
                                    @onclick:stopPropagation="true" @onclick="() => menuFor = menuFor == r.Folder.Id ? null : r.Folder.Id"><Ico Name="dots-v" Size="16" /></button>
                        }
                        @if (menuFor == r.Folder.Id)
                        {
                            <div class="kebab-backdrop" @onclick:stopPropagation="true" @onclick="() => menuFor = null"></div>
                            <div class="kebab-menu" role="menu" @onclick:stopPropagation="true">
                                <span class="kebab-note">@r.Folder.Name · @(mine ? "votre dossier" : $"dossier de {r.OwnerName}") · @(sum.Any ? "partagé" : "non partagé")</span>
                                @if (multi) { <button type="button" role="menuitem" @onclick="() => { menuFor = null; ShareFolder(r); }"><Ico Name="users" Size="16" /> Partager…</button> }
                                @if (r.Right == FolderRight.Owner)
                                {
                                    <button type="button" role="menuitem" @onclick="() => { menuFor = null; renamingFolder = r; renameFolderValue = r.Folder.Name; folderError = null; }"><Ico Name="edit" Size="16" /> Renommer</button>
                                    <button type="button" role="menuitem" @onclick="() => { menuFor = null; reparenting = (r.Folder.Id, r.Folder.Name); }"><Ico Name="move" Size="16" /> Déplacer…</button>
                                    <button type="button" role="menuitem" class="danger" @onclick="() => { menuFor = null; deletingFolder = r; }"><Ico Name="trash" Size="16" /> Supprimer</button>
                                }
                            </div>
                        }
                    </div>
                }
                @if (CanCreateFolderHere)
                {
                    <button type="button" class="lx-fcard add" @onclick="OpenNewFolder">
                        <div class="fv"><span class="fbk"></span><span class="ffr"><Ico Name="plus" Size="22" /></span></div>
                        <div class="fn"><span>Nouveau dossier</span></div>
                    </button>
                }
            </div>
        }
        </section>

        <section class="lx-blk lx-blk-main" aria-label="Compositions">
        <div class="lx-bh"><Ico Name="grid" Size="16" /> <span>Compositions</span> <small>@Sorted.Count()</small></div>
        <div class="lx-tools" role="region" aria-label="Recherche et filtres">
            <div class="search-box">
                <Ico Name="search" Size="16" />
                <input placeholder="Rechercher dans toutes les compositions" aria-label="Rechercher des compositions" @bind="search" @bind:event="oninput" />
            </div>
            @if (Active) { <span class="lx-count" aria-live="polite">@Plural(Sorted.Count(), "résultat", "résultats")</span> }
            <FilterMenu Groups="FilterGroups" Extra="@(folderId != null && !scopeAll ? 1 : 0)" OnPick="PickFilter" OnReset="ResetFilters">
                <Footer>
                    @if (folderId != null)
                    {
                        <div class="fm-note"><span>Chercher dans : @(scopeAll ? "toutes les compositions" : "ce dossier")</span><button type="button" class="linklike" @onclick="() => scopeAll = !scopeAll">Changer</button></div>
                    }
                </Footer>
            </FilterMenu>
            <select @bind="sort" class="tb-sort" aria-label="Trier">
                <option value="name">Nom</option>
                <option value="used">Plus utilisées</option>
            </select>
            <ViewToggle StorageKey="compositions" @bind-Value="view" />
        </div>
        <FilterChips Groups="FilterGroups" Extra="FilterExtras" OnClear="ClearFilter" OnResetAll="ResetFilters" />

        @if (!Sorted.Any())
        {
            @if (Active) { <div class="empty"><div class="big">Aucune composition ne correspond</div><button type="button" class="btn ghost sm" @onclick='() => { search = ""; filter = ""; }'>Effacer la recherche et les filtres</button></div> }
            else if (subfolders.Count == 0 && currentRow is { } fe)
            {
                <div class="empty compact">
                    <div class="big">Ce dossier est vide</div>
                    @if (CanCreateHere)
                    {
                        <p>Créez une composition dans « @fe.Folder.Name », ou glissez-y des compositions depuis « Compositions ».</p>
                        <button type="button" class="btn" @onclick="Create"><Ico Name="plus" Size="16" /> Créer une composition</button>
                    }
                </div>
            }
            else
            {
                <div class="empty compact">
                    <div class="big">@(currentRow is { } re ? $"Aucune composition dans « {re.Folder.Name} »" : "Aucune composition à la racine")</div>
                    <p>@(folderId == null ? "Vos compositions sont rangées dans les dossiers ci-dessus." : "Ses compositions sont rangées dans les sous-dossiers ci-dessus.")@(CanCreateHere ? " Créez ici une composition qui n'a pas besoin de dossier." : "")</p>
                    @if (CanCreateHere) { <button type="button" class="btn" @onclick="Create"><Ico Name="plus" Size="16" /> Créer une composition</button> }
                </div>
            }
        }
        else
        {
        @if (view == "list")
        {
        <div class="lx-tbl-wrap">
            <table class="lx-tbl">
                <thead>
                    <tr>
                        <th><button type="button" class="@(sort == "name" ? "on" : "")" @onclick='() => sort = "name"'>Nom</button></th>
                        <th>Emplacement</th>
                        <th>Format</th>
                        <th><button type="button" class="@(sort == "used" ? "on" : "")" @onclick='() => sort = "used"'>Listes</button></th>
                        <th>Propriétaire</th>
                        <th style="width:44px"><span class="sr-only">Actions</span></th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var c in Sorted)
                    {
                        var it = c;
                        var lists = usage.GetValueOrDefault(it.Id) ?? new();
                        var size = Compositions.Size(it.Settings);
                        var r = rights.GetValueOrDefault(it.Id);
                        var csum = shares.GetValueOrDefault(it.Id, ShareSummary.None);
                        <tr data-nid="@it.Id" class="@(dragIds.Contains(it.Id) ? "dragging" : "")" draggable="@(r >= FolderRight.Write ? "true" : "false")" @ondragstart="() => StartDrag(it)" @ondragend="EndDrag">
                            <td><div class="nm"><span class="mini"><CompositionThumb Item="it" Files="files" Contain Label="@("Aperçu de " + it.Name)" /></span>
                                @if (r >= FolderRight.Write) { <a href="/compositions/@it.Id">@it.Name</a> } else { <span title="Lecture seule : dupliquez-la pour l'adapter">@it.Name</span> }
                                @if (csum.Any) { <SharePill Summary="csum" Clickable="multi && r == FolderRight.Owner" OnClick="() => Share(ShareKind.Composition, it.Id, it.Name)" /> }
                                @if (r == FolderRight.Read) { <span title="Lecture seule"><Ico Name="lock" Size="13" /></span> }</div></td>
                            <td><small>@PathOf(it)</small></td>
                            <td><small>@(size is { } s ? $"{s.W} × {s.H}" : "Format inconnu")</small></td>
                            <td><small>@(lists.Count == 0 ? "aucune liste" : lists.Count == 1 ? "« " + lists[0] + " »" : $"{lists.Count} listes")</small></td>
                            <td><small>@(OwnerName(it.OwnerId) ?? "Moi")</small></td>
                            <td>@Menu(it)</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
        }
        @* sur mobile, toujours en cartes (pas de bascule) *@
        <div class="cmp-grid @(view == "list" ? "lx-mobile-only" : "")">
            @foreach (var c in Sorted)
            {
                var it = c;
                var lists = usage.GetValueOrDefault(it.Id) ?? new();
                var size = Compositions.Size(it.Settings);
                var r = rights.GetValueOrDefault(it.Id);
                var csum = shares.GetValueOrDefault(it.Id, ShareSummary.None);
                <article class="cmp-card @(dragIds.Contains(it.Id) ? "dragging" : "")" data-nid="@it.Id" draggable="@(r >= FolderRight.Write ? "true" : "false")" @ondragstart="() => StartDrag(it)" @ondragend="EndDrag">
                    @if (r >= FolderRight.Write) { <a class="cmp-open" href="/compositions/@it.Id" aria-label="Modifier « @it.Name »"><CompositionThumb Item="it" Files="files" Contain Label="@("Aperçu de " + it.Name)" /></a> }
                    else { <div class="cmp-open" title="Lecture seule : dupliquez-la pour l'adapter"><CompositionThumb Item="it" Files="files" Contain Label="@("Aperçu de " + it.Name)" /></div> }
                    <div class="cmp-info">
                        <div class="cmp-t">
                            <b title="@it.Name">@it.Name</b>
                            @Menu(it)
                        </div>
                        <span class="cmp-m">@(size is { } s ? $"{s.W} × {s.H}" : "Format inconnu") · @(lists.Count == 0 ? "dans aucune liste" : lists.Count == 1 ? "dans « " + lists[0] + " »" : $"dans {lists.Count} listes")</span>
