    private void ResetFilters() { scopeAll = true; filter = ""; }

    // Position ouverte (sauf recherche ou filtre dans toutes les compositions), puis filtrées et triées
    private IEnumerable<MediaItem> Sorted
    {
        get
        {
            var pool = ShowPath ? scopeItems : Shown;
            var q = pool.Where(c => filter switch { "used" => UsedIn(c) > 0, "unused" => UsedIn(c) == 0, _ => true })
