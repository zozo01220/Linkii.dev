    // les trois premières compositions d'un dossier : vignettes de sa carte
    private List<MediaItem> FolderPreview(Guid folder) => items.Where(c => c.FolderId == folder).OrderBy(c => c.Name, StringComparer.CurrentCultureIgnoreCase).Take(3).ToList();

    // Le dossier et tous ses sous-dossiers
    private HashSet<Guid> FolderTree(Guid id)
    {
        var tree = new HashSet<Guid>();
        var queue = new Queue<Guid>(new[] { id });
        while (queue.Count > 0)
        {
            var cur = queue.Dequeue();
            if (!tree.Add(cur)) continue;
            foreach (var r in folderRows.Where(x => x.Folder.ParentId == cur)) queue.Enqueue(r.Folder.Id);
