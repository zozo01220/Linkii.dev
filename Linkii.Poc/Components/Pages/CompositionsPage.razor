        (HashSet<Guid> Folders, List<MediaItem> Items) Scope(string t)
        {
            var fs = LibraryTab.Folders(t, folderRows.Select(r => (r.Folder.Id, r.Folder.ParentId, r.Tab)), me, isAdmin);
