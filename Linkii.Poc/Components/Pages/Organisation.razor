@page "/organisation"
@attribute [Microsoft.AspNetCore.Authorization.Authorize(Policy = "ClientAdmin")]
@inject TenantStore Store
@inject NavigationManager Nav
@inject Toaster Toast

@* Membres (24 octobre 2026, maquette membres-proprietaire-partage.html) : une ligne par personne, son rôle et ce qu'elle fait dans les trois pages.
   Tout se règle dans la fiche membre (tiroir du bas, <MemberSheet>). Les aires restent une vue à part : elles rangent les écrans, sans effet sur les droits. *@

<div class="page-head">
    <div>
        <h1>@(view == "areas" ? "Aires de gestion" : "Membres")<span class="lx-cntpill">@(view == "areas" ? areas.Count : rows.Count)</span></h1>
        <p class="sub sc-intro">@(view == "areas" ? "Où sont vos écrans : aires et zones." : "Qui gère quoi, en un coup d'œil. Cliquez une ligne pour la modifier.")</p>
    </div>
    <div class="row head-actions">
        @if (view == "areas") { <button type="button" class="btn" data-fab="Nouvelle aire" @onclick="OpenNewArea"><Ico Name="plus" Size="16" /> Nouvelle aire</button> }
        else { <button type="button" class="btn" data-fab="Nouveau membre" @onclick="() => sheet = Guid.Empty"><Ico Name="plus" Size="16" /> Nouveau membre</button> }
    </div>
</div>

<div class="tabs int-tabs og-views" role="tablist" aria-label="Vue">
    <button type="button" role="tab" class="@(view == "people" ? "on" : "")" aria-selected="@(view == "people" ? "true" : "false")" @onclick='() => view = "people"'>Membres <span class="cat-count">@rows.Count</span></button>
    <button type="button" role="tab" class="@(view == "areas" ? "on" : "")" aria-selected="@(view == "areas" ? "true" : "false")" @onclick='() => view = "areas"'>Aires <span class="cat-count">@areas.Count</span></button>
</div>

@if (view == "people")
{
    var shown = rows.Where(r => q.Length == 0 || r.User.Label.Contains(q, StringComparison.CurrentCultureIgnoreCase) || r.User.Email.Contains(q, StringComparison.CurrentCultureIgnoreCase)).ToList();
    @if (rows.Count > 8)
    {
        <div class="og-fb"><label class="search og-search"><Ico Name="search" Size="16" /><input placeholder="Rechercher un nom ou un e-mail" aria-label="Rechercher" @bind="q" @bind:event="oninput" /></label></div>
    }
    <div class="card og-list">
        @if (shown.Count == 0)
        {
            <div class="og-empty">Aucune personne ne correspond.</div>
        }
        else
        {
            <table class="tbl og-tbl mb-tbl">
                <thead><tr><th>Membre</th><th>Rôle</th><th>Écrans</th><th>Médiathèque</th><th>Listes de lecture</th><th style="width:30px"></th></tr></thead>
                <tbody>
                @foreach (var r in shown)
                {
                    var row = r;
                    <tr data-nid="@row.User.Id" class="og-r @(row.User.Disabled ? "dim" : "")" @onclick="() => sheet = row.User.Id">
                        <td><div class="og-who"><span class="avatar @(row.User.Disabled ? "off" : "")">@Initials(row.User)</span><div class="og-nm"><b>@row.User.Label</b><small>@(row.User.IsInvited ? "Invitation envoyée" : row.User.Email)@(row.User.Id == me ? " · vous" : "")</small></div></div></td>
                        <td>@if (row.Admin) { <span class="pill dark">Administrateur</span> } else { <span>Utilisateur</span> }@if (row.User.Disabled) { <span class="pill">Désactivé</span> }</td>
                        @if (row.Admin)
                        {
                            <td colspan="3" class="muted">Voit et gère tout, crée des membres</td>
                        }
                        else
                        {
                            <td>@if (row.Rights.Screens == PageMode.Read) { @ReadPill() } else if (row.Screens == 0 && row.Rights.ZoneIds.Count == 0) { <span class="pill warn">Aucun écran</span> } else { <div class="mb-acc">@Pl(row.Screens, "écran", "écrans")<small>@Where(row.Rights)</small></div> }</td>
                            <td>@if (row.Rights.Media == PageMode.Read) { @ReadPill() } else { <span>Les siens</span> }</td>
                            <td>@if (row.Rights.Playlists == PageMode.Read) { @ReadPill() } else { <span>Les siennes</span> }</td>
                        }
                        <td class="muted"><Ico Name="chevron-right" Size="14" /></td>
                    </tr>
                }
                </tbody>
            </table>
        }
    </div>
    @if (rows.Count <= 1)
    {
        <p class="hint">Vous êtes seul dans l'organisation : rien ne change pour vous. Ajoutez un membre pour lui confier des écrans et partager vos médias et vos listes.</p>
    }
}
else
{
    <div class="ag-bar">
        <span class="ag-tot">@Pl(areas.Count, "aire", "aires")</span><span class="ag-tot">@Pl(areas.Sum(x => x.Zones.Count), "zone", "zones")</span><span class="ag-tot">@Pl(screens.Count, "écran", "écrans")</span>
        <span class="ag-sp"></span>
        <button type="button" class="btn ghost sm" @onclick="() => SetAllOpen(true)">Tout déplier</button>
        <button type="button" class="btn ghost sm" @onclick="() => SetAllOpen(false)">Tout replier</button>
    </div>
    @foreach (var a in areas)
    {
        var area = a;
        var open = IsOpen(area.Id);
        var scrN = screens.Count(s => s.AreaId == area.Id);
        <div class="card ag-card @(open ? "open" : "")" data-nid="@area.Id">
            <button type="button" class="ag-hd" aria-expanded="@(open ? "true" : "false")" @onclick="() => ToggleOpen(area.Id)">
                <span class="ag-ic"><Ico Name="map-pin" Size="18" /></span>
                <span class="ag-tx"><b>@area.Name</b><small>@Pl(area.Zones.Count, "zone", "zones") · @(scrN == 0 ? "aucun écran" : Pl(scrN, "écran", "écrans"))</small></span>
                <span class="ag-ch"><Ico Name="chevron-right" Size="16" /></span>
            </button>
            @if (open)
            {
                <div class="ag-bd">
                    @foreach (var z in area.Zones)
                    {
                        var zone = z;
                        var n = screens.Count(s => s.ZoneId == zone.Id);
                        <div class="ag-z @(n == 0 ? "empty" : "")">
                            <Ico Name="@(zone.IsWall ? "monitor" : "box")" Size="15" /><span>@zone.Name</span>
                            @if (zone.IsWall) { <span class="pill blue">Mur</span> }
                            @if (zone.Sync && !zone.IsWall) { <span class="pill blue">Synchronisée</span> }
                            <span class="ag-n">@(n == 0 ? "aucun écran" : Pl(n, "écran", "écrans"))</span>
                        </div>
                    }
                    <div class="ag-act"><button type="button" class="btn ghost sm" @onclick="() => OpenAreaSheet(area)"><Ico Name="plus" Size="14" /> Ajouter une zone</button><button type="button" class="btn ghost sm" @onclick="() => OpenAreaSheet(area)">Modifier l'aire</button></div>
                </div>
            }
        </div>
    }
    <p class="hint">Les aires et les zones rangent les écrans. Elles ne donnent aucun droit : on attribue des zones ou des écrans à une personne depuis sa fiche membre.</p>
}

@if (sheet is { } sid)
{
    <MemberSheet UserId="@(sid == Guid.Empty ? null : sid)" OnClose="() => sheet = null" OnSaved="Saved" />
}

@if (areaSheet is { } aid && areas.FirstOrDefault(a => a.Id == aid) is { } ar)
{
    var scrN = screens.Count(s => s.AreaId == ar.Id);
    <Sheet Title="@ar.Name" Sub="@($"{Pl(ar.Zones.Count, "zone", "zones")} · {Pl(scrN, "écran", "écrans")}")" OnClose="CloseArea">
        <ChildContent>
            <div class="og-sec">
                <div class="lbl" style="margin-top:0">Zones <small>(elles classent les écrans de l'aire ; un mur se crée dans Écrans)</small></div>
                <AreaZones AreaId="ar.Id" OnChanged="Reload" />
            </div>
            <div class="og-sec">
                <label class="lbl" for="og-an">Nom de l'aire</label>
                <div class="row" style="flex-wrap:nowrap"><input id="og-an" class="full" maxlength="60" @bind="renameText" @bind:event="oninput" @onkeydown="OnRenameKey" /><button type="button" class="btn ghost" @onclick="RenameArea">Renommer</button></div>
            </div>
            @if (sleepOn)
            {
                <div class="og-sec"><div class="lbl">Mise en veille <small>(plages et fuseau de l'aire)</small></div><AreaSleep AreaId="ar.Id" /></div>
            }
            @if (dimOn)
            {
                <div class="og-sec"><div class="lbl">Luminosité et contraste <small>(écrans Android, selon l'heure)</small></div><AreaDim AreaId="ar.Id" /></div>
            }
            @if (formError != null) { <div class="err">@formError</div> }
        </ChildContent>
        <Foot>
            <button type="button" class="btn danger" @onclick="() => { deleting = ar; deleteError = null; }">Supprimer l'aire</button>
            <span class="muted" style="font-size:13px">Une aire ne se supprime que sans écran.</span>
            <span class="grow"></span>
            <button type="button" class="btn" @onclick="CloseArea">Fermer</button>
        </Foot>
    </Sheet>
}

@if (newArea)
{
    <Sheet Title="Nouvelle aire de gestion" Class="sm" OnClose="() => newArea = false">
        <ChildContent>
            <label class="lbl" for="na-name" style="margin-top:0">Nom</label>
            <input id="na-name" class="full" maxlength="60" @bind="newName" @bind:event="oninput" @onkeydown="OnNewAreaKey" placeholder="Ex. : Site de Genève, Bâtiment B" />
            <p class="hint" style="margin:12px 0 0">L'aire démarre vide : connectez-y des écrans, ou déplacez-en depuis une autre aire.</p>
            @if (formError != null) { <div class="err">@formError</div> }
        </ChildContent>
        <Foot>
            <span class="grow"></span>
            <button type="button" class="btn ghost" @onclick="() => newArea = false">Annuler</button>
            <button type="button" class="btn" @onclick="CreateArea">Créer l'aire</button>
        </Foot>
    </Sheet>
}

@if (deleting is { } del)
{
    <Sheet Title="@($"Supprimer l'aire « {del.Name} » ?")" Class="sm" Over="true" OnClose="() => deleting = null">
        <ChildContent>
            <p class="hint" style="margin:0">Une aire ne se supprime que sans écran. Ses zones disparaissent, et ceux à qui elles étaient attribuées les perdent.</p>
            @if (deleteError != null) { <div class="err">@deleteError</div> }
        </ChildContent>
        <Foot>
            <span class="grow"></span>
            <button type="button" class="btn ghost" @onclick="() => deleting = null">Annuler</button>
            <button type="button" class="btn danger-solid" @onclick="DeleteArea">Supprimer</button>
        </Foot>
    </Sheet>
}

@if (view == "areas")
{
    <NewMark Kind="area" Ids="@areas.Select(a => a.Id)" />
}
else
{
    <NewMark Kind="member" Ids="@rows.Select(r => r.User.Id)" />
}

@code {
    private List<MemberRow> rows = new();
    private List<Area> areas = new();
    private List<Screen> screens = new();
    private string view = "people", q = "";
    private bool sleepOn, dimOn, newArea;
    private string? formError, deleteError;
    private Guid? me, currentId, areaSheet, sheet;
    private readonly HashSet<Guid> openAreas = new();
    private Area? deleting;
    private string renameText = "", newName = "";

    [SupplyParameterFromQuery(Name = "tab")] public string? TabParam { get; set; }
    [SupplyParameterFromQuery(Name = "created")] public string? Created { get; set; }
    [SupplyParameterFromQuery(Name = "deleted")] public string? Deleted { get; set; }
    [Inject] private TenantContext Ctx { get; set; } = default!;

    protected override void OnInitialized()
    {
        if (Created != null) Toast.Ok($"Aire « {Created} » créée.");
        if (Deleted != null) Toast.Ok($"Aire « {Deleted} » supprimée.");
        (sleepOn, dimOn) = Store.Read(d => (d.Tenant.SleepEnabled, d.Tenant.DimEnabled));
        me = Ctx.UserId;
        view = TabParam is "areas" || Created != null || Deleted != null ? "areas" : "people";
        Load();
    }

    private void Load()
    {
        (rows, areas, screens, currentId) = Store.Read(d =>
        {
            var list = d.Areas.OrderBy(a => a.CreatedUtc).ToList();
            return (MemberOps.Rows(d), list, d.Root.Screens.Where(s => s.ClientId == d.ClientId && s.Token != null).ToList(), d.Area?.Id);
        });
    }

    private Task Reload() { Load(); StateHasChanged(); return Task.CompletedTask; }
    private void Saved() { sheet = null; Load(); }

    private static string Pl(int n, string one, string many) => $"{n} {(n == 1 ? one : many)}";
    private static string Initials(User u) => string.Concat(u.Label.Split(' ', '.', '@').Where(w => w.Length > 0).Take(2).Select(w => char.ToUpperInvariant(w[0])));
    private static RenderFragment ReadPill() => __builder => { <span class="pill dark"><Ico Name="eye" Size="12" /> Tout · lecture</span> };

    // « Caisses, Vitrines » : ses zones, puis le nombre d'écrans attribués un à un
    private string Where(MemberRights r)
    {
        var names = areas.SelectMany(a => a.Zones.Where(z => r.ZoneIds.Contains(z.Id)).Select(z => areas.Count > 1 ? $"{a.Name} › {z.Name}" : z.Name)).ToList();
        var single = screens.Count(s => r.ScreenIds.Contains(s.Id) && !(s.ZoneId is { } z && r.ZoneIds.Contains(z)));
        if (single > 0) names.Add(Pl(single, "écran", "écrans"));
        var text = string.Join(", ", names);
        return text.Length > 40 ? text[..38] + "…" : text;
    }

    // ---------- Aires ----------

    private bool areasTouched;
    private bool IsOpen(Guid id) => areasTouched ? openAreas.Contains(id) : areas.Count > 0 && areas[0].Id == id;
    private void ToggleOpen(Guid id)
    {
        if (!areasTouched) { areasTouched = true; if (areas.Count > 0) openAreas.Add(areas[0].Id); }
        if (!openAreas.Remove(id)) openAreas.Add(id);
    }
    private void SetAllOpen(bool on) { areasTouched = true; openAreas.Clear(); if (on) foreach (var x in areas) openAreas.Add(x.Id); }
    private void OpenAreaSheet(Area a) { formError = null; renameText = a.Name; areaSheet = a.Id; }
    private void CloseArea() { areaSheet = null; formError = null; }
    private void OpenNewArea() { formError = null; newName = ""; newArea = true; }
    private void OnNewAreaKey(KeyboardEventArgs e) { if (e.Key == "Enter") CreateArea(); }

    private void CreateArea()
    {
        var name = newName;
        Area? created = null;
        formError = Store.Write(d =>
        {
            var (a, err) = AreaOps.Create(d, name);
            if (a == null) return err;
            created = a;
            return null;
        });
        if (formError != null) return;
        newArea = false;
        Nav.NavigateTo("/organisation?created=" + Uri.EscapeDataString(created!.Name), forceLoad: true);   // le menu affiche le sélecteur d'aire dès la deuxième
    }

    private void RenameArea()
    {
        if (areaSheet is not { } id) return;
        var n = renameText;
        formError = Store.Write(d => AreaOps.Rename(d, id, n));
        if (formError == null) { Toast.Ok($"Aire renommée en « {n.Trim()} »."); Load(); }
    }

    private void OnRenameKey(KeyboardEventArgs e) { if (e.Key == "Enter") RenameArea(); }

    private void DeleteArea()
    {
        if (deleting is not { } del) return;
        deleteError = Store.Write(d => AreaOps.Delete(d, del.Id));
        if (deleteError != null) return;
        deleting = null;
        Nav.NavigateTo("/organisation?deleted=" + Uri.EscapeDataString(del.Name), forceLoad: true);
    }
}
