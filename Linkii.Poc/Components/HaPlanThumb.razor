@* Vignette d'un étage dessiné (§195) : pièces et murs en SVG, pour la carte d'un plan et l'aperçu du widget. *@
@if (Floor is { Drawn: true } f)
{
    var walls = HomeAssistantRules.WallsOf(f, Devices ?? new());
    <svg class="hpl-thumb @Class" viewBox="-0.3 -0.3 @(f.W + .6) @(f.H + .6)" preserveAspectRatio="xMidYMid meet" aria-hidden="true">
        @foreach (var r in f.Rooms)
        {
            <rect class="r" x="@r.X" y="@r.Y" width="@r.W" height="@r.H" />
        }
        @foreach (var w in walls)
        {
            <line class="w" x1="@w.X" y1="@w.Y" x2="@(w.D == 0 ? w.X + w.Len : w.X)" y2="@(w.D == 0 ? w.Y : w.Y + w.Len)" />
        }
    </svg>
}

@code {
    [Parameter] public HomeAssistantRules.PlanFloor? Floor { get; set; }
    [Parameter] public List<HomeAssistantRules.PlanDevice>? Devices { get; set; }
    [Parameter] public string? Class { get; set; }
}
