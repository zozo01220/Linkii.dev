@implements IDisposable
@inject Toaster Toaster

@* Popups de confirmation (vert) ou d'erreur (rouge), en haut de page et centrées. *@
<div class="toasts" aria-live="polite">
    @foreach (var t in Toaster.Items)
    {
        var toast = t;
        <div class="toast @(toast.Ok ? "ok" : "bad")" role="@(toast.Ok ? "status" : "alert")" @key="toast.Id">
            <Ico Name="@(toast.Ok ? "check" : "x")" Size="18" />
            <span class="toast-text">@toast.Text</span>
            <button type="button" class="toast-x" aria-label="Fermer" @onclick="() => Toaster.Dismiss(toast.Id)"><Ico Name="x" Size="15" /></button>
        </div>
    }
</div>

@code {
    protected override void OnInitialized() => Toaster.Changed += Refresh;

    private void Refresh() => _ = InvokeAsync(StateHasChanged);

    public void Dispose() => Toaster.Changed -= Refresh;
}
