@* Logo Home Assistant (marque simplifiée : une maison bleue avec un œil), pour les comptes connectés et les widgets Home Assistant. *@
<svg class="ha-logo" width="@Size" height="@Size" viewBox="0 0 24 24" role="img" aria-label="Home Assistant">
    <path d="M12 2.5 L21.5 10.5 V21.5 H14.5 V15.5 H9.5 V21.5 H2.5 V10.5 Z" fill="@Fill" />
    <circle cx="12" cy="11.2" r="2.4" fill="@Eye" />
</svg>

@code {
    [Parameter] public int Size { get; set; } = 24;
    /// <summary>Couleur de la maison : bleu Home Assistant par défaut, blanc sur une pastille bleue.</summary>
    [Parameter] public string Fill { get; set; } = "#18BCF2";
    /// <summary>Couleur de l'œil : la couleur du fond derrière le logo.</summary>
    [Parameter] public string Eye { get; set; } = "#FFFFFF";
}
