@* Visuel d'un dossier (Médiathèque, Listes de lecture) : dos et onglet couleur Nuit, jusqu'à trois vignettes de son contenu qui dépassent,
   rabat avant avec le nombre d'éléments et la pastille d'accès. Le nom, les actions et le glisser-déposer restent dans la page (.lx-fcard). *@
<div class="fv">
    <span class="fbk"></span>
    @for (var i = 0; i < Preview.Count; i++)
    {
        var item = Preview[i];
        <span class="fpp fpp-@(i + 1)-@Preview.Count">@if (Thumb != null) { @Thumb(item) } else { <MediaThumb Media="item" All="All" /> }</span>
    }
    <span class="ffr">
        <span class="fnum">@if (Count == 0) { <text>Vide</text> } else { @Count<small>@Unit</small> }</span>
        @Badge
    </span>
</div>

@code {
    [Parameter] public IReadOnlyList<MediaItem> Preview { get; set; } = Array.Empty<MediaItem>();
    [Parameter] public IReadOnlyList<MediaItem>? All { get; set; }
    /// <summary>Rendu d'une vignette autre que celui d'un média (ex. aperçu d'une composition).</summary>
    [Parameter] public RenderFragment<MediaItem>? Thumb { get; set; }
    [Parameter] public int Count { get; set; }
    /// <summary>« listes », « médias », « éléments »… (affiché après le nombre)</summary>
    [Parameter] public string Unit { get; set; } = "";
    /// <summary>Pastille d'accès (privé, partagé, lecture seule, aire d'origine)</summary>
    [Parameter] public RenderFragment? Badge { get; set; }

    /// <summary>« 3 listes », « 2 dossiers », « 5 éléments » (dossiers et contenus mélangés) : l'unité seule, le nombre est affiché à part.</summary>
    public static string UnitFor(int items, int folders, string one, string many) =>
        folders == 0 ? (items > 1 ? many : one) : items == 0 ? (folders > 1 ? "dossiers" : "dossier") : "éléments";
}
