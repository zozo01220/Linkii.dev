@* Contenu de la fiche d'une app : partagé par la fenêtre « Détails » et la page /apps/{id}. *@
<p>@App.Description</p>
<label class="lbl">Où l'afficher</label>
<div class="row" style="gap:6px">
    @foreach (var p in App.Placements) { <span class="pill">@Label(p)</span> }
</div>
@if (App.Duration == "content") { <small class="note-line">Dans une boucle, l'écran passe au contenu suivant quand l'app a terminé (fin de la vidéo), dans la limite d'une durée maximale.</small> }
@if (App.Validity) { <small class="note-line">Peut être limitée à une période (dates de début et de fin).</small> }

<label class="lbl">Ce que vous pourrez régler</label>
<table class="tbl">
    <tbody>
    @foreach (var f in App.Settings)
    {
        <tr><td>@f.Label@(f.Required ? " *" : "")</td><td><small>@TypeLabel(f)</small></td></tr>
    }
    </tbody>
</table>
<small class="note-line">Les modifications ne partent sur un écran qu'à sa prochaine publication (page Écrans).</small>

@code {
    [Parameter, EditorRequired] public AppManifest App { get; set; } = default!;

    private static string Label(string placement) => ScreenOptions.Placements.FirstOrDefault(o => o.Id == placement)?.Label ?? placement;

    private static string TypeLabel(AppField f) => f.Type switch
    {
        "text" => "Texte", "textarea" => "Texte long", "number" => "Nombre", "select" => "Choix", "bool" => "Oui / non",
        "color" => "Couleur", "url" => "Adresse web", "secret" => "Secret (chiffré)", "textfile" => "Fichier importé", "date" => "Date", "youtube" => "Lien YouTube", "mailbox" => "Calendrier Microsoft 365", _ => f.Type
    };
}
