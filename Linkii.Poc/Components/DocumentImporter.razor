@inject TenantStore Store
@inject CloudFileService Cloud
@inject PdfService Pdf
@inject Toaster Toast
@inject NavigationManager Nav

@* Tiroir « Depuis le cloud » de la médiathèque (maquette mediatheque-import-boutons-page.html) : toutes les sources qui apportent des fichiers,
   les comptes connectés d'abord, puis les autres, verrouillées, par ordre alphabétique.
   - un document OneDrive (PowerPoint, Word, Excel…), une présentation, un document ou un tableur Google : choisi ici, chaque page devient une image,
     rangée dans une présentation du dossier « intégration_médias » ;
   - Canva et les Drives (Google Drive, SharePoint, Dropbox, Nextcloud, SFTP) : des dossiers synchronisés, choisis dans l'assistant de l'intégration.
   Une source verrouillée ouvre l'assistant d'ajout de son intégration ; à sa fermeture, on revient sur la médiathèque, tiroir ouvert. *@
<section class="di" aria-label="Sources cloud">
    @foreach (var grp in new[] { true, false })
    {
        var rows = grp ? Tiles.Where(Connected).ToList() : Tiles.Where(t => !Connected(t)).OrderBy(t => t.Name, StringComparer.OrdinalIgnoreCase).ToList();
        if (rows.Count == 0) continue;
        <h4>@(grp ? "Vos comptes connectés" : "À connecter")<small>@(grp ? $" · {rows.Count}" : " · par ordre alphabétique · un clic ouvre l'assistant d'ajout")</small></h4>
        <div class="di-tiles">
            @foreach (var t in rows)
            {
                var tile = t;
                <button type="button" class="di-tile @(grp ? "" : "lock")" disabled="@busy" title="@(grp ? tile.Kind is { } k ? $"Choisir {k.Noun} dans {tile.Drive}" : $"Choisir les dossiers {tile.Name} synchronisés" : $"Connecter {tile.Name}")" @onclick="() => Open(tile, grp)">
                    @if (grp) { <span class="di-dot" title="Compte connecté"></span> } else { <span class="di-lk"><Ico Name="lock" Size="15" /></span> }
                    <BrandLogo Id="@tile.Logo" Size="44" />
                    <span class="di-nm">@tile.Name@if (!grp) { <small class="di-go">Connecter</small> } else if (tile.Formats.Length > 0) { <small>@tile.Formats</small> }</span>
                </button>
            }
        </div>
    }
    @if (busy)
    {
        <div class="pr-prog di-prog" role="status" aria-live="polite">
            <span class="spinner"></span>
            <div class="grow">
                <b>@(title.Length > 0 ? $"Import de « {title} »…" : "Import en cours…")</b>
                <small>@status</small>
                <div class="pr-bar-track @(pct == null ? "indet" : "")"><i style="@(pct == null ? "" : $"width:{pct}%")"></i></div>
            </div>
        </div>
    }
    @if (error != null) { <div class="err">@error</div> }
</section>

@if (picking is { } kind)
{
    @* rendu dans la mise en page : la fenêtre d'import, centrée par transform, décalerait et rognerait le sélecteur *@
    <SectionContent SectionName="overlay">
        <CloudFilePicker Over="true" Kind="kind" OnPicked="n => Picked(kind, n)" OnClose="() => picking = null" />
    </SectionContent>
}

@code {
    /// <summary>Un document vient d'entrer dans la médiathèque (ou y était déjà) : la page se relit.</summary>
    [Parameter] public EventCallback OnImported { get; set; }

    private CloudFileKind? picking;
    private bool busy;
    private string status = "", title = "";
    private string? error;
    private int? pct;

    // Document à choisir (compte connecté) ; sinon l'assistant de l'intégration, au pas « dossiers » si le compte est déjà connecté
    private void Open(Tile tile, bool connected)
    {
        error = null;
        if (connected && tile.Kind is { } kind) { picking = kind; return; }
        Nav.NavigateTo($"/integrations?ajouter={Uri.EscapeDataString(tile.Wizard)}&etape={(connected ? 2 : 1)}&retour=media");
    }

    private void OnProgress(string s)
    {
        status = s;
        var m = System.Text.RegularExpressions.Regex.Match(s, @"page (\d+) / (\d+)");
        pct = m.Success && int.TryParse(m.Groups[1].Value, out var n) && int.TryParse(m.Groups[2].Value, out var total) && total > 0 ? Math.Clamp(n * 100 / total, 4, 100) : null;
        _ = InvokeAsync(StateHasChanged);
    }

    private async Task Picked(CloudFileKind kind, DriveNode node)
    {
        picking = null; busy = true; error = null; title = node.Name; status = "Lecture du fichier…"; pct = null;
        StateHasChanged();
        try
        {
            var src = kind.SrcOf(node.Name);
            var (done, err) = await Cloud.Import(Store.Read(d => d.Tenant), Store.ClientId, Store.AreaId, kind, node.Ref, null,
                new PdfService.Options("", "none", "landscape", Pres.Unit(src), src), new Progress<string>(OnProgress));
            if (done == null) { Fail(err ?? "Import impossible."); return; }
            await Finish(done.Source, done.Result, src, done.How == CloudFileService.ImportKind.Reused, done.How == CloudFileService.ImportKind.Updated);
        }
        finally { busy = false; }
    }

    /// <summary>Kind : document importé ici ; null : dossiers synchronisés (Source : Canva ou source Drive). Wizard : intégration dont l'assistant connecte le compte.</summary>
    private record Tile(CloudFileKind? Kind, string Source, string Name, string Formats, string Logo, string Drive, string Wizard);

    private static readonly Tile[] Tiles =
    {
        new(CloudFileKind.MsDocument, "", "OneDrive", "PowerPoint, Word, Excel", "drv-onedrive", "OneDrive", "ms-powerpoint"),
        new(CloudFileKind.Slides, "", "Google Slides", "", "google-slides", "Google Drive", "google-slides"),
        new(CloudFileKind.Docs, "", "Google Docs", "", "google-docs", "Google Drive", "google-docs"),
        new(CloudFileKind.Sheets, "", "Google Sheets", "", "google-sheets", "Google Drive", "drv-gdrive"),
        new(null, "canva", "Canva", "Dossiers synchronisés", "canva", "Canva", "canva"),
        new(null, "gdrive", "Google Drive", "Dossiers synchronisés", "drv-gdrive", "Google Drive", "drv-gdrive"),
        new(null, "onedrive", "SharePoint", "Dossiers synchronisés", "drv-sharepoint", "SharePoint", "drv-onedrive"),
        new(null, "dropbox", "Dropbox", "Dossiers synchronisés", "drv-dropbox", "Dropbox", "drv-dropbox"),
        new(null, "nextcloud", "Nextcloud", "Dossiers synchronisés", "drv-nextcloud", "Nextcloud", "drv-nextcloud"),
        new(null, "sftp", "SFTP", "Dossiers synchronisés", "drv-sftp", "SFTP", "drv-sftp"),
    };

    private bool Connected(Tile t)
    {
        var tenant = Store.Read(d => d.Tenant);
        return t.Kind is { } k ? k.Connected(tenant) : t.Source == "canva" ? tenant.CanvaRefreshToken.Length > 0 : DriveSources.Configured(tenant, t.Source);
    }

    private async Task Finish(PdfService.Source source, PdfService.ConvertResult res, string src, bool reused, bool updated)
    {
        var folder = Pres.FolderName(src);
        if (res.Presentation == null)
        {
            // une seule page : une image ordinaire, rangée elle aussi dans « intégration_médias » ; le PDF d'origine n'a plus d'usage
            Store.Write(d =>
            {
                var f = Pres.FolderFor(d.Root, Store.ClientId, Store.AreaId ?? Guid.Empty, src);
                foreach (var img in res.Files) if (d.Media.FirstOrDefault(m => m.Id == img.Id) is { } live) live.FolderId = f;
            });
            Pdf.Release(source.Id);
            Toast.Ok($"« {source.Title} » importé : 1 image dans la médiathèque › {folder}.");
        }
        else if (reused) Toast.Ok($"« {source.Title} » est déjà dans la médiathèque : réutilisé.");
        else if (updated) Toast.Ok($"« {source.Title} » avait changé : mis à jour.");
        else Toast.Ok($"« {source.Title} » importé : {source.Pages} page{(source.Pages > 1 ? "s" : "")} dans la médiathèque › {folder}.");
        await OnImported.InvokeAsync();
    }

    private void Fail(string message) { error = message; Toast.Error(message); }
}
