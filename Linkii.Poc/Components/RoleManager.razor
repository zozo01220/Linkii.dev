    private RenderFragment Check(string state, string label, Action click, string css = "", string? appId = null) => @<div class="lv-row @css">
        <button type="button" role="switch" aria-checked="@(state == "all" ? "true" : "false")" aria-label="@(label + (state == "some" ? " (en partie)" : ""))" class="switch sm @(state == "all" ? "on" : state == "some" ? "some" : "")" @onclick="click"><span></span></button>
        @if (appId != null) { <span class="lv-appico" @onclick="click"><AppIcon Id="@appId" Small="true" /></span> }
        <span class="lv-lbl" @onclick="click">@label</span>
    </div>;
}
