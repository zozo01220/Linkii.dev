@* Choix du moniteur d'un PC Windows : une tuile par moniteur remonté par le PC (« 1 · principal », taille).
   Un moniteur déjà pris en plein écran par un autre écran du même PC est signalé ; il reste possible en fenêtre (tests). *@
<div class="sp-mons" role="radiogroup" aria-labelledby="@LabelledBy">
    @foreach (var m in Monitors)
    {
        var mon = m;
        var by = Taken.GetValueOrDefault(mon.N);
        var blocked = by != null && !Windowed;
        <button type="button" role="radio" class="sp-mon @(mon.N == Value ? "on" : "") @(by != null ? "taken" : "")" aria-checked="@(mon.N == Value ? "true" : "false")"
                disabled="@blocked" title="@(by != null ? $"Moniteur {mon.N} : pris par « {by} »" : $"Moniteur {mon.N}")" @onclick="() => ValueChanged.InvokeAsync(mon.N)">
            <b>@mon.N@(mon.Primary && by == null ? " · principal" : "")</b>
            <span>@(by != null ? "pris par " + by : $"{mon.W} × {mon.H}")</span>
        </button>
    }
</div>

@code {
    [Parameter, EditorRequired] public List<DeviceMonitor> Monitors { get; set; } = new();
    [Parameter] public int Value { get; set; } = 1;
    [Parameter] public EventCallback<int> ValueChanged { get; set; }
    /// <summary>Moniteur → nom de l'écran du même PC qui l'occupe en plein écran.</summary>
    [Parameter] public Dictionary<int, string> Taken { get; set; } = new();
    /// <summary>Affichage en fenêtre : un moniteur pris reste possible.</summary>
    [Parameter] public bool Windowed { get; set; }
    [Parameter] public string? LabelledBy { get; set; }
}
