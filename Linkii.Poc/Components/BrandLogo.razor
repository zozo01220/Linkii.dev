@* Logo d'un fournisseur ou d'une source (BrandLogos), tel quel. Id sans logo : rien n'est affiché. *@
@if (BrandLogos.Symbol(Id) is { } s)
{
    <svg class="brand-logo" width="@Size" height="@Size" role="img" aria-hidden="true"><use href="@("/brand-logos.svg#" + s)" width="100%" height="100%" /></svg>
}

@code {
    [Parameter] public string? Id { get; set; }
    [Parameter] public int Size { get; set; } = 24;
}
