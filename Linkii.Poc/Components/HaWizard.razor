@inject TenantStore Store
@inject AppService Svc
@inject AccountManager Accounts

@* Intégrations › Home Assistant : assistant d'ajout, dans un tiroir du haut (maquette canva-assistant-ajout.html).
   1. Connexion (HaConnectionForm : direct ou par le relais, testée à l'enregistrement) ; 2. entités trouvées par famille ; 3. validation, puis ajout.
   Dès la connexion, les widgets Home Assistant sont activés et la source de données « Home Assistant » est créée.
   Annuler pendant un ajout déconnecte le compte saisi et retire ce que la connexion avait mis en place : rien ne reste. *@
<WizardShell Icon="homeassistant" Title="@(Adding ? "Ajouter Home Assistant" : "Home Assistant")" Subtitle="@StepLine" Labels="@Labels" Step="step" Done="done" Running="done"
             CanBack="@(step > 1 && !done)" Hint="@Hint" NextLabel="@NextLabel" NextDisabled="NextDisabled"
             OnCancel="Cancel" OnClose="Close" OnBack="Back" OnNext="Next">
    @if (step == 1)
    {
        <div class="cw-body">
            <HaConnectionForm Account="account" Prefix="haw" OnSaved="Saved" />
            @if (account != null)
            {
                <div class="cvs-account"><BrandLogo Id="homeassistant" Size="28" /><div class="grow"><b>@(account.AuthMode == "password" ? account.User : "Jeton d'accès")</b><small>@account.Url · connecté · @account.Entities.Count entité(s) trouvée(s)</small></div></div>
            }
        </div>
    }
    else if (step == 2 && account != null)
    {
        <div class="cw-body">
            <div class="cw-crumb">Aperçu · <b>@account.Entities.Count entités</b> trouvées sur @account.Url</div>
            <HaEntityBrowser Account="account" Limit="60" Searchable="false" />
        </div>
    }
    else if (account != null)
    {
        <div class="cw-body">
            <div class="cw-kpis">
                @foreach (var f in HomeAssistantRules.Families.Where(f => CountOf(f) > 0).Take(4))
                {
                    <div><b>@CountOf(f)</b><small>@f.Noun</small></div>
                }
            </div>
            <HaUses />
            @if (done) { <div class="cw-run"><span>Terminé : Home Assistant est dans Mes intégrations.</span><span>100 %</span></div><div class="cw-bar"><i class="ok" style="width:100%"></i></div> }
        </div>
    }
</WizardShell>

@code {
    [Parameter] public int StartStep { get; set; } = 1;
    [Parameter] public bool Adding { get; set; }
    [Parameter] public EventCallback OnAdded { get; set; }
    [Parameter] public EventCallback OnClose { get; set; }
    [Parameter] public EventCallback OnChanged { get; set; }

    private static readonly string[] Labels = { "Connexion", "Entités", "Validation" };

    private int step = 1;
    private bool done, connectedHere;
    private HomeAssistantAccount? account;

    private bool Connected => account is { LastError.Length: 0 };
    private int CountOf(HomeAssistantRules.Family f) => account?.Entities.Count(e => f.Domains.Contains(e.Domain)) ?? 0;
    private string StepLine => step switch
    {
        1 => "Étape 1 sur 3 — connectez votre Home Assistant",
        2 => "Étape 2 sur 3 — entités trouvées",
        _ => done ? "Étape 3 sur 3 — terminé" : "Étape 3 sur 3 — vérifiez, puis ajoutez l'intégration"
    };
    private bool NextDisabled => step == 1 && !Connected;
    private string NextLabel => step < 3 ? "Suivant" : done ? "Terminer" : "Ajouter";
    private string Hint => step == 1 && !Connected ? "Enregistrez la connexion pour continuer." : "";

    protected override void OnInitialized()
    {
        account = Store.Read(d => d.Tenant.HomeAssistant?.Copy());
        step = !Connected ? 1 : Math.Clamp(StartStep, 1, 2);
    }

    private async Task Saved(HomeAssistantAccount fresh)
    {
        account = fresh;
        connectedHere = true;
        await OnChanged.InvokeAsync();
    }

    private Task Close() => OnClose.InvokeAsync();

    private async Task Cancel()
    {
        if (Adding && connectedHere)   // rien ne reste : compte, widgets activés et source de données de cette connexion
        {
            await Accounts.Disconnect(ConnectedAccounts.HomeAssistant);
            HomeAssistantSetup.Uninstall(Svc, Store);
        }
        await OnClose.InvokeAsync();
    }

    private void Back() { if (step > 1) step--; }

    private async Task Next()
    {
        if (step < 3) step++;
        else if (!done) await Run();
        else await Close();
    }

    private async Task Run()
    {
        if (Adding) { Svc.Mark("ha-home"); await OnAdded.InvokeAsync(); }
        done = true;
        await OnChanged.InvokeAsync();
    }
}
