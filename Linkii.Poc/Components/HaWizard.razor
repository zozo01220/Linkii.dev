@inject TenantStore Store
@inject AppService Svc
@inject AccountManager Accounts

@* Applications › Home Assistant : assistant d'ajout, dans un tiroir du haut (maquette canva-assistant-ajout.html).
   1. Connexion (HaConnectionForm : direct ou par le relais, testée à l'enregistrement) ; 2. entités trouvées par famille ; 3. validation, puis ajout.
   Dès la connexion, les widgets Home Assistant sont activés et la source de données « Home Assistant » est créée.
   Annuler pendant un ajout déconnecte le compte saisi et retire ce que la connexion avait mis en place : rien ne reste. *@
<WizardShell Icon="homeassistant" Title="@(Adding ? "Ajouter Home Assistant" : "Home Assistant")" Labels="@Labels" Step="step" Done="done" Running="done"
             CanBack="@(step == 2)" Hint="@Hint" NextLabel="@NextLabel" NextDisabled="NextDisabled"
             OnCancel="Cancel" OnClose="Close" OnBack="Back" OnNext="Next">
    @if (step == 1)
    {
        <div class="cw-body">
            <HaConnectionForm Account="account" Prefix="haw" OnSaved="Saved" />
            @if (account != null)
            {
                <div class="cvs-account"><BrandLogo Id="homeassistant" Size="28" /><div class="grow"><b>@(account.AuthMode == "password" ? account.User : "Jeton d'accès")</b><small>@account.Url · connecté · @account.Entities.Count entité(s) trouvée(s)</small></div></div>
            }
        </div>
    }
    else if (step == 2 && account != null)
    {
        <div class="cw-body">
            <h2 class="cw-h">Que voulez-vous utiliser ?</h2>
            <p class="cw-lead">Nous avons trouvé @account.Entities.Count entités sur votre Home Assistant. Décochez celles que vous ne voulez pas proposer sur vos écrans.</p>
            <HaEntityBrowser Account="account" Chosen="chosen" />
        </div>
    }
    else if (account != null)
    {
        <div class="cw-body cw-final">
            <div class="cw-bigok">✓</div>
            <h2 class="cw-h">Home Assistant est prêt</h2>
            <p class="cw-lead">@chosen.Count entité@(chosen.Count > 1 ? "s" : "") disponible@(chosen.Count > 1 ? "s" : "") pour vos widgets et vos écrans.</p>
        </div>
    }
</WizardShell>

@code {
    [Parameter] public int StartStep { get; set; } = 1;
    [Parameter] public bool Adding { get; set; }
    [Parameter] public EventCallback OnAdded { get; set; }
    [Parameter] public EventCallback OnClose { get; set; }
    [Parameter] public EventCallback OnChanged { get; set; }

    private static readonly string[] Labels = { "Connexion", "Sélection", "Terminé" };

    private int step = 1;
    private bool done, connectedHere;
    private HomeAssistantAccount? account;

    private bool Connected => account is { LastError.Length: 0 };
    private readonly HashSet<string> chosen = new();
    private bool NextDisabled => step == 1 && !Connected || step == 2 && chosen.Count == 0;
    private string NextLabel => step == 1 ? "Suivant" : $"Ajouter {chosen.Count} entité{(chosen.Count > 1 ? "s" : "")}";
    private string Hint => step == 1 && !Connected ? "Enregistrez la connexion pour continuer." : step == 2 && Adding ? "Rien n'est enregistré tant que vous n'avez pas ajouté." : "";

    protected override void OnInitialized()
    {
        account = Store.Read(d => d.Tenant.HomeAssistant?.Copy());
        step = !Connected ? 1 : Math.Clamp(StartStep, 1, 2);
        ResetChosen();
    }

    private void ResetChosen()
    {
        chosen.Clear();
        if (account != null) chosen.UnionWith(account.Entities.Where(e => !e.Off).Select(e => e.Id));
    }

    private async Task Saved(HomeAssistantAccount fresh)
    {
        account = fresh;
        ResetChosen();
        connectedHere = true;
        await OnChanged.InvokeAsync();
    }

    private Task Close() => OnClose.InvokeAsync();

    private async Task Cancel()
    {
        if (Adding && connectedHere)   // rien ne reste : compte, widgets activés et source de données de cette connexion
        {
            await Accounts.Disconnect(ConnectedAccounts.HomeAssistant);
            HomeAssistantSetup.Uninstall(Svc, Store);
        }
        await OnClose.InvokeAsync();
    }

    private void Back() { if (step > 1) step--; }

    private async Task Next()
    {
        if (step == 1) step = 2;
        else if (step == 2) { step = 3; await Run(); }
        else await Close();
    }

    private async Task Run()
    {
        if (Adding) { Svc.Mark("ha-home"); await OnAdded.InvokeAsync(); }
        var all = account!.Entities.Select(e => e.Id).Distinct().ToList();
        Svc.SetContentsOn(all.Where(chosen.Contains).Select(id => ("entity", id)), true);
        Svc.SetContentsOn(all.Where(id => !chosen.Contains(id)).Select(id => ("entity", id)), false);
        done = true;
        await OnChanged.InvokeAsync();
    }
}
