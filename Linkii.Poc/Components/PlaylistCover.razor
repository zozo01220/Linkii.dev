@* Zone d'affichage d'une carte de liste de diffusion (maquette liste-diffusion-carte-apercu.html, variante A) : une seule vignette fixe, celle du premier contenu,
   en plein cadre, avec en bas à droite le nombre de contenus et la durée de la boucle. Plus de carrousel : l'aperçu animé est le bouton ▶ de la carte. Un clic ouvre la liste. *@
@if (Slides.Count > 0)
{
    var s = Slides[0];
    <div class="pl-cover single lx-cov @(Portrait ? "port" : "")">
        <a class="lx-cov-link" href="@Href" tabindex="-1" aria-hidden="true" title="@s.Media.Name"></a>
        <div class="pl-tile lx-cov-flat">
            @if (s.Media.AppId == Compositions.AppId) { <CompositionThumb Item="s.Media" Files="All ?? Array.Empty<MediaItem>()" Contain="true" /> }
            else { <MediaThumb Media="s.Media" All="All" Wide="true" /> }
        </div>
        <div class="lx-cov-pills">
            <span>@(Count == 1 ? "1 contenu" : $"{Count} contenus")@(Total > 0 ? " · " + Helpers.FormatDuration(Total) : "")</span>
        </div>
    </div>
}

@code {
    public record Slide(MediaItem Media, int Seconds, string Label);

    [Parameter, EditorRequired] public IReadOnlyList<Slide> Slides { get; set; } = Array.Empty<Slide>();
    [Parameter] public IReadOnlyList<MediaItem>? All { get; set; }
    [Parameter] public string Href { get; set; } = "#";
    /// <summary>Liste au format portrait (<see cref="PlaylistShape"/>).</summary>
    [Parameter] public bool Portrait { get; set; }
    /// <summary>Nombre de contenus de la liste et durée de la boucle (secondes), affichés sur la vignette.</summary>
    [Parameter] public int Count { get; set; }
    [Parameter] public int Total { get; set; }
}
