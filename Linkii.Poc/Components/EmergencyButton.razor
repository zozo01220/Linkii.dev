@inherits EmergencyComponent

@* Bouton « Urgence » du pied du menu latéral (§159, §241, maquettes/urgence.html), toujours visible quand l'application « Alerte d'urgence » est installée.
   Hors urgence : bouton rouge qui ouvre le formulaire. Pendant l'urgence : pastille rouge qui clignote ; un clic ouvre la confirmation pour la lever. *@
@{ var s = Snap; }
@if (s.Enabled)
{
    @if (s.Main is { } e)
    {
        <button type="button" class="emchip" data-tip="Lever l'urgence" aria-label="Urgence active depuis @Hm(e.StartedUtc). Lever l'urgence" @onclick="() => Click(s)">
            <i></i>@(s.ActiveCount > 1 ? $"{s.ActiveCount} urgences actives" : $"Urgence active · depuis {Hm(e.StartedUtc)}")<b>@(s.ActiveCount > 1 ? "Voir" : "Lever")</b>
        </button>
    }
    else
    {
        <button type="button" class="embtn" data-tip="Déclencher une urgence" aria-haspopup="dialog" @onclick="Ui.OpenForm"><Ico Name="alert" Size="16" />Urgence</button>
    }
}

@code {
    private void Click(EmergencySnapshot s)
    {
        if (s.ActiveCount > 1) Ui.OpenHistory();
        else if (s.Main != null) Ui.AskLift(s.Main.Id);
    }
}
