@* Choix de la luminosité et du contraste d'un écran : aucun réglage (par défaut), comme l'aire, ou réglage propre. *@
<div class="cseg" role="radiogroup" aria-label="Luminosité et contraste">
    @foreach (var (key, label) in Modes.Where(m => AllowNever || m.Item1 != Dim.Never))
    {
        var k = key;
        <label><input type="radio" name="@Name" checked="@(Mode == k)" @onchange="() => Pick(k)" /><span>@label</span></label>
    }
</div>
@if (Mode == Dim.Own)
{
    <p class="hint" style="margin:12px 0">Partez du réglage de l'aire et changez ce qui doit différer pour cet écran.@if (Dim.Active(AreaPlan)) { <text> </text><button type="button" class="linklike" style="padding:0;font-size:13px" @onclick="FromArea">Repartir de l'aire</button> }</p>
    <DimEditor Plan="Plan" PlanChanged="PlanChanged" Asleep="@Asleep" />
    <small class="muted">Les heures suivent le fuseau de l'aire.</small>
}
else if (Mode == Dim.Inherit)
{
    <div class="dm-inh">
        <div class="top">@Inherited</div>
        <DimStrip Plan="AreaPlan" />
    </div>
}
else
{
    <p class="hint" style="margin:10px 0 0">L'image est affichée telle quelle, quelle que soit l'heure.</p>
}

@code {
    [Parameter] public string Mode { get; set; } = Dim.Never;
    [Parameter] public EventCallback<string> ModeChanged { get; set; }
    [Parameter] public DimPlan? Plan { get; set; }
    [Parameter] public EventCallback<DimPlan?> PlanChanged { get; set; }
    /// <summary>Phrase affichée quand l'écran suit son aire (ce que fait l'aire).</summary>
    [Parameter] public string Inherited { get; set; } = "L'écran suit le réglage de son aire.";
    /// <summary>Grille de veille qui s'applique à l'écran, pour hachurer ces heures dans l'éditeur.</summary>
    [Parameter] public string? Asleep { get; set; }
    /// <summary>Réglage de l'aire de l'écran : montré quand l'écran la suit, et point de départ d'un réglage propre.</summary>
    [Parameter] public DimPlan? AreaPlan { get; set; }
    [Parameter] public string Name { get; set; } = "dim-mode";
    /// <summary>false : seulement « Suit l'aire » et « Personnalisé » (« aucun réglage » s'obtient en coupant l'interrupteur).</summary>
    [Parameter] public bool AllowNever { get; set; } = true;

    private static readonly (string, string)[] Modes = { (Dim.Never, "Aucun réglage"), (Dim.Inherit, "Suit l'aire"), (Dim.Own, "Personnalisé") };

    private Task FromArea() { Plan = AreaPlan!.Clone(); return PlanChanged.InvokeAsync(Plan); }

    private async Task Pick(string mode)
    {
        Mode = mode;
        if (mode == Dim.Own && !Dim.Valid(Plan)) { Plan = Dim.Active(AreaPlan) ? AreaPlan!.Clone() : Dim.Suggested(); await PlanChanged.InvokeAsync(Plan); }
        await ModeChanged.InvokeAsync(mode);
    }
}
