@* Assistant de l'écran (DEV-POC.md §126, refait au §190, maquette maquettes/assistant-premiers-pas.html) : 1. relier l'écran (appareil, bouton
   « Ouvrir le player » ou « Télécharger pour… », code à 6 chiffres, liste à afficher) ; 2. « C'est en ligne ». Le contenu se prépare avant, dans
   l'assistant « Premiers pas » (WelcomeWizard). La page Écrans fournit l'appairage (Pair) : facturation et publication comme le tiroir. *@
@implements IAsyncDisposable
@using Microsoft.JSInterop
@inject TenantStore Store
@inject AppService Svc
@inject IJSRuntime JS
@inject NavigationManager Nav

<div class="fs-wiz">
<div class="fs-modal s@(step == 1 ? 2 : 1)" role="dialog" aria-modal="true" aria-labelledby="fs-q">
    <div class="fs-top">
        <Logo Size="26" />
        <div class="pp-steps" aria-label="Étape @step sur 2">
            <span class="@(step == 1 ? "on" : "done")"><i>@if (step > 1) { <Ico Name="check" Size="12" /> } else { <text>1</text> }</i>Relier l'écran</span><b></b><span class="@(step == 2 ? "on" : "")"><i>2</i>En ligne</span>
        </div>
        @if (step == 1) { <button type="button" class="fs-later" title="@(first ? "Fermer, je le ferai plus tard" : "Fermer sans connecter d'écran")" @onclick="Later">@(first ? "Plus tard" : "Annuler") <Ico Name="x" Size="16" /></button> }
        else { <button type="button" class="fs-later" title="Fermer" @onclick="Finish">Fermer <Ico Name="x" Size="16" /></button> }
    </div>

    @if (step == 1)
    {
        <div class="fs-q">
            <h1 id="fs-q">@(first ? "Allumez votre écran" : "Connecter un nouvel écran")</h1>
            <p>Il va vous montrer un code. Recopiez-le ici, c'est tout.</p>
        </div>
        <div class="fs-pair">
            <div>
                <div class="fs-tv"><div class="fs-scr fs-player">
                    <span class="pw">linkivi</span>
                    <span class="pc"><span>4</span><span>8</span><span>1</span><span>2</span><span>9</span><span>3</span></span>
                    <small>Ce que vous verrez sur l'écran</small>
                </div><div class="fs-tvfoot"></div></div>
                <div class="fs-stand"></div>
                <div class="fs-ask">Sur quel appareil s'affiche votre écran ?</div>
                <div class="fs-devs" role="tablist" aria-label="Appareil">
                    <button type="button" role="tab" aria-selected="@(device == "web")" class="@(device == "web" ? "on" : "")" @onclick='() => device = "web"'>
                        <span class="fs-tag">Le plus simple</span><PlayerLogo Kind="Navigateur" Size="30" /><b>Navigateur</b><small>TV connectée</small>
                    </button>
                    <button type="button" role="tab" aria-selected="@(device == "android")" class="@(device == "android" ? "on" : "")" @onclick='() => device = "android"'>
                        <PlayerLogo Kind="Android" Size="30" /><b>TV Android</b><small>Application</small>
                    </button>
                    <button type="button" role="tab" aria-selected="@(device == "windows")" class="@(device == "windows" ? "on" : "")" @onclick='() => device = "windows"'>
                        <PlayerLogo Kind="Windows" Size="30" /><b>PC Windows</b><small>Installateur</small>
                    </button>
                    <button type="button" role="tab" aria-selected="@(device == "linux")" class="@(device == "linux" ? "on" : "")" @onclick='() => device = "linux"'>
                        <PlayerLogo Kind="Linux" Size="30" /><b>Linux</b><small>Raspberry Pi</small>
                    </button>
                </div>
                <div class="fs-where">
                    @if (device == "web")
                    {
                        @* le player s'ouvre directement, à la bonne adresse : sur l'écran lui-même, c'est le chemin le plus court *@
                        <a class="btn fs-cta pp-oscta" href="/player/" target="_blank" rel="noopener" title="Ouvre @PlayerAddress dans un nouvel onglet">
                            <span class="pp-osb"><PlayerLogo Kind="Navigateur" Size="18" /></span><span>Ouvrir le player dans le navigateur</span><Ico Name="external" Size="16" />
                        </a>
                        <div class="fs-st"><span class="fs-n">1</span><span>Sur l'écran lui-même ? Cliquez ci-dessus. Sinon, ouvrez son navigateur à cette adresse :</span></div>
                        <div class="fs-addrbox"><code>@PlayerAddress</code><button type="button" class="fs-copy" @onclick="CopyAddress"><Ico Name="copy" Size="14" /> @(copied ? "Copié" : "Copier")</button></div>
                        <div class="fs-st"><span class="fs-n">2</span><span>Recopiez le code à 6 chiffres affiché</span></div>
                    }
                    else
                    {
                        var (kind, name, href, fmt, file) = device switch
                        {
                            "android" => ("Android", "Android", "/download/android", "APK", androidPlayer),
                            "linux" => ("Linux", "Linux", "/download/linux", "TAR.GZ", linuxPlayer),
                            _ => ("Windows", "Windows", "/download/windows", "MSI", winPlayer)
                        };
                        <div class="fs-st"><span class="fs-n">1</span><span>
                            @if (device == "android") { <text>Sur la TV ou le boîtier Android, installez l'app <b>Linkivi Player</b>.</text> }
                            else if (device == "linux") { <text>Sur le Raspberry Pi ou le mini-PC, installez <b>Linkivi Player pour Linux</b>.</text> }
                            else { <text>Sur le PC, installez <b>Linkivi Player pour Windows</b>. Il démarre ensuite avec le PC.</text> }
                        </span></div>
                        @if (file != null)
                        {
                            <a class="btn fs-cta pp-oscta" href="@href" download title="Version @file.Version">
                                <span class="pp-osb"><PlayerLogo Kind="@kind" Size="18" /></span><span>Télécharger pour @name</span><small class="pp-fmt">@fmt</small>
                            </a>
                        }
                        else
                        {
                            <span class="btn fs-cta pp-oscta off" aria-disabled="true"><span class="pp-osb"><PlayerLogo Kind="@kind" Size="18" /></span><span>@name : bientôt disponible</span></span>
                        }
                        <div class="fs-st"><span class="fs-n">2</span><span>Lancez-le, puis recopiez le code à 6 chiffres</span></div>
                    }
                </div>
            </div>
            <div class="fs-enter">
                <h2>Le code de votre écran</h2>
                <p>Les 6 chiffres affichés sur l'écran.</p>
                <div class="fs-code" @ref="codeRef">
                    @for (var i = 0; i < 6; i++)
                    {
                        <input inputmode="numeric" autocomplete="one-time-code" maxlength="6" aria-label="Chiffre @(i + 1)" disabled="@pairing" />
                    }
                </div>
                <div class="fs-state @(codeError != null ? "bad" : "")" aria-live="polite">
                    @if (pairing) { <span class="fs-spin"></span> <span>Connexion à l'écran…</span> }
                    else if (codeError != null) { <span>@codeError</span> }
                    else { <span>L'écran se relie dès que le code est complet.</span> }
                </div>
                <div class="pp-show">
                    <label for="fs-list">Ce qu'il affichera</label>
                    <div class="pp-pick">
                        @if (Chosen is { } cl)
                        {
                            <span class="th">@if (FirstOf(cl) is { } fm) { @Thumb(fm) }</span>
                            <span class="tx"><b>@cl.Name</b><small>@Summary(cl)</small></span>
                        }
                        else
                        {
                            <span class="th logo"><Logo Size="18" /></span>
                            <span class="tx"><b>Écran d'accueil Linkivi</b><small>En attendant une liste de lecture</small></span>
                        }
                        <Ico Name="chevron" Size="16" />
                        <select id="fs-list" value="@(listId?.ToString() ?? "")" @onchange="PickList" disabled="@pairing" aria-label="Liste de lecture affichée par l'écran">
                            <option value="">Écran d'accueil Linkivi (aucune liste)</option>
                            @foreach (var p in lists) { <option value="@p.Id">@p.Name</option> }
                        </select>
                    </div>
                </div>
                @if (first) { <div class="fs-noscreen">Pas d'écran sous la main ? <button type="button" class="fs-linkbtn" @onclick="Later">Je le relierai plus tard</button>.</div> }
                @if (OnMoreOptions.HasDelegate) { <div class="fs-noscreen"><button type="button" class="fs-linkbtn" @onclick="() => OnMoreOptions.InvokeAsync()">Plus d'options</button> : nom, zone, format, calendrier.</div> }
            </div>
        </div>
    }
    else
    {
        <div class="fs-q">
            <div class="fs-ok"><Ico Name="check" Size="26" /></div>
            <h1 id="fs-q">C'est en ligne !</h1>
            <p>Regardez votre écran : il affiche maintenant @(Chosen is { } on ? $"« {on.Name} »" : "l'écran d'accueil Linkivi").</p>
        </div>
        <div class="fs-tvw">
            <div class="fs-tv"><div class="fs-scr @(Chosen == null ? "fs-player" : "pp-scr")">
                @if (Chosen is { } live && FirstOf(live) is { } lm) { <div class="pp-scrth">@Thumb(lm)</div> }
                else { <span class="pw">linkivi</span> }
                <div class="fs-live"><i></i>En direct</div>
            </div><div class="fs-tvfoot"></div></div>
            <div class="fs-stand"></div>
        </div>
        <div class="fs-after">
            <button class="btn" @onclick="Finish">Aller à mes écrans</button>
            <button class="btn ghost" @onclick="Another">Relier un autre écran</button>
            <button class="btn ghost" @onclick="Invite">Inviter un collègue</button>
        </div>
    }
</div>
</div>

@code {
    /// <summary>Premier écran de l'organisation (« Plus tard » possible) ; sinon un écran de plus (« Annuler »).</summary>
    [Parameter] public bool First { get; set; } = true;
    /// <summary>Liste proposée d'office (celle des Premiers pas, la plus récente…) ; null : écran d'accueil Linkivi.</summary>
    [Parameter] public Guid? ListId { get; set; }
    /// <summary>Appairage par la page Écrans : code et liste à diffuser. Renvoie null si l'écran est relié, sinon le message à afficher.</summary>
    [Parameter, EditorRequired] public Func<string, Guid?, Task<string?>> Pair { get; set; } = default!;
    /// <summary>L'assistant se ferme (plus tard, annulé ou terminé) : la page Écrans se recharge.</summary>
    [Parameter] public EventCallback OnClose { get; set; }
    /// <summary>« Plus d'options » : le tiroir complet de connexion (nom, zone, format, calendrier).</summary>
    [Parameter] public EventCallback OnMoreOptions { get; set; }

    private int step = 1;
    private bool first;   // reçu de First ; « Relier un autre écran » le passe à false
    private string device = "web";
    private bool pairing, copied;
    private string? codeError;
    private Guid? listId;
    private List<Playlist> lists = new();
    private List<MediaItem> all = new();
    private PlayerDownloads.Item? winPlayer, androidPlayer, linuxPlayer;
    private ElementReference codeRef;
    private DotNetObjectReference<FirstScreenWizard>? self;
    private int boundStep;

    private string PlayerAddress => new Uri(Nav.BaseUri).Authority + "/player";
    private Playlist? Chosen => listId is { } id ? lists.FirstOrDefault(p => p.Id == id) : null;

    protected override void OnInitialized()
    {
        first = First;
        lists = Store.Read(d => d.Playlists.Where(p => PlaylistOps.RightOf(d, p) != FolderRight.None).OrderByDescending(p => p.UpdatedAt).ToList());
        all = Store.Read(d => d.Media.ToList());
        listId = ListId is { } wanted && lists.Any(p => p.Id == wanted) ? wanted : null;
        winPlayer = PlayerDownloads.Latest("windows"); androidPlayer = PlayerDownloads.Latest("android"); linuxPlayer = PlayerDownloads.Latest("linux");
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (boundStep == step) return;   // la saisie du code se branche une fois, à l'affichage de l'étape 1
        boundStep = step;
        if (step != 1) return;
        self ??= DotNetObjectReference.Create(this);
        try { await JS.InvokeVoidAsync("LinkiiFirstScreen.code", codeRef, self); } catch (JSDisconnectedException) { }
    }

    private MediaItem? FirstOf(Playlist p) => p.Draft.Select(i => all.FirstOrDefault(m => m.Id == i.MediaId)).FirstOrDefault(m => m != null);

    private string Summary(Playlist p)
    {
        var secs = p.Draft.Sum(i => all.FirstOrDefault(m => m.Id == i.MediaId) is { } m ? Helpers.ItemSeconds(i, m, Svc.Find(m.AppId), all) : 0);
        return $"{p.Draft.Count} contenu{(p.Draft.Count > 1 ? "s" : "")} · {Helpers.FormatDuration(secs)}";
    }

    private RenderFragment Thumb(MediaItem m) => __builder =>
    {
        if (m.AppId == Compositions.AppId) { <CompositionThumb Item="m" Files="all" Contain="true" /> }
        else { <MediaThumb Media="m" All="all" Wide="true" /> }
    };

    private void PickList(ChangeEventArgs e) => listId = Guid.TryParse(e.Value?.ToString(), out var g) ? g : null;

    private async Task CopyAddress()
    {
        try { await JS.InvokeVoidAsync("navigator.clipboard.writeText", PlayerAddress); copied = true; } catch { }
    }

    // ---------- Le code ----------
    [JSInvokable]
    public async Task CodeEntered(string code)
    {
        if (pairing) return;
        pairing = true; codeError = null;
        await InvokeAsync(StateHasChanged);
        string? err;
        try { err = await Pair(code, listId); }
        finally { pairing = false; }
        if (err == null) { step = 2; }
        else
        {
            codeError = err == "Code inconnu." ? "Ce code ne correspond à aucun écran. Vérifiez les 6 chiffres affichés." : err;
            await InvokeAsync(StateHasChanged);
            try { await JS.InvokeVoidAsync("LinkiiFirstScreen.clearCode", codeRef); } catch (JSDisconnectedException) { }
        }
        await InvokeAsync(StateHasChanged);
    }

    /// <summary>La page Écrans a relié l'écran après un paiement (fenêtre de paiement) : l'assistant passe à « C'est en ligne ».</summary>
    public void Connected() { step = 2; StateHasChanged(); }

    private void Another() { codeError = null; first = false; step = 1; }

    private async Task Later()
    {
        if (first) Store.Write(d => { if (d.Tenant.FirstScreen == null) d.Tenant.FirstScreen = FirstScreen.Later; });
        await OnClose.InvokeAsync();
    }

    private async Task Finish() => await OnClose.InvokeAsync();

    private async Task Invite() { await OnClose.InvokeAsync(); Nav.NavigateTo("/organisation"); }

    public ValueTask DisposeAsync() { self?.Dispose(); return ValueTask.CompletedTask; }
}
