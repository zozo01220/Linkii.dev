@* Frise d'une journée d'un réglage de luminosité (lundi) et sa phrase ; hachurée quand rien n'est réglé. *@
@if (Dim.Active(Plan))
{
    <div class="dm-mini" role="img" aria-label="@Dim.Summary(Plan)">
        @foreach (var (h, p) in Dim.Strip(Plan!))
        {
            <i style="width:@((h / 24.0 * 100).ToString("0.##", System.Globalization.CultureInfo.InvariantCulture))%;background:@Dim.Shade(p)" title="@p.Name"></i>
        }
    </div>
}
else
{
    <div class="dm-mini off"></div>
}
<div class="dm-minicap">@Dim.Summary(Plan)</div>

@code {
    [Parameter] public DimPlan? Plan { get; set; }
}
