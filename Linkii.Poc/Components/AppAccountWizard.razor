@inject TenantStore Store
@inject DriveService Drives
@inject AppService Svc
@inject AccountManager Accounts
@inject GoogleAuth GoogleAuth
@inject MicrosoftAuth MsAuth
@inject FacebookAuth FacebookAuth
@inject LinkedinAuth LinkedinAuth
@inject CloudFileService Importer

@* Applications › Google Slides, Google Docs, Microsoft PowerPoint, Facebook : assistant d'ajout, fenêtre centrée (maquette assistant-ajout-simplifie.html).
   1. Compte ; 2. fichiers du Drive à ajouter (cochés : ils entrent dans la médiathèque) ou Pages Facebook, « Ajouter » lance l'import ;
   3. progression puis « prêt » (seul Fermer reste). Rien n'est gardé avant « Ajouter » ; Annuler déconnecte le compte connecté pendant l'assistant
   (sauf s'il sert à une autre application). *@
<WizardShell Icon="@AppId" Title="@(Adding ? "Ajouter " + Name : Name)" Labels="@Labels" Step="step" Done="done" Running="importing || done"
             CanBack="@(step == 2 && !importing)" Hint="@Hint" NextLabel="@NextLabel" NextDisabled="NextDisabled"
             OnCancel="Cancel" OnClose="Close" OnBack="Back" OnNext="Next">
    @if (step == 1)
    {
        <WizardAccount Kind="@Kind" Provider="@Provider" Ready="ready" Connected="connected" Lost="lost" User="@user" Since="since" ConnectUrl="@ConnectUrl"
                       Missing="@Missing" Permissions="@Permissions" CanDo="@CanDo" CannotDo="@CannotDo" />
    }
    else if (step == 2)
    {
        <div class="cw-body">
            @if (loading) { <div class="dfp-empty">Lecture du compte…</div> }
            else if (error != null) { <div class="dfp-empty err">@error</div> }
            else if (AppId == "facebook")
            {
                <h2 class="cw-h">Vos Pages Facebook</h2>
                <p class="cw-lead">@(pages.Count == 0 ? "Nous n'avons trouvé aucune Page." : $"Nous avons trouvé {pages.Count} Page{(pages.Count > 1 ? "s" : "")} dans votre compte.")</p>
                @if (pages.Count == 0) { <div class="dfp-empty">Ce compte n'administre aucune Page (ou n'a pas accordé l'accès aux Pages). Reconnectez-vous en cochant vos Pages.</div> }
                else
                {
                    <div class="cw-tools">
                        <span class="cw-count"><b>@chosenPages.Count</b> sur @pages.Count sélectionnée@(chosenPages.Count > 1 ? "s" : "")</span>
                        <button type="button" class="btn ghost sm" @onclick="ToggleAllPages">@(chosenPages.Count == pages.Count ? "Tout désélectionner" : "Tout sélectionner")</button>
                    </div>
                    <div class="cw-rows">
                        @foreach (var p in pages)
                        {
                            var pid = p.Id;
                            var on = chosenPages.Contains(pid);
                            <button type="button" class="cw-row @(on ? "on" : "")" @onclick="() => TogglePage(pid)"><span class="cw-av">@(p.Name.Length > 0 ? p.Name[..1] : "?")</span><b>@p.Name</b><span class="cw-ck">@(on ? "✓" : "")</span></button>
                        }
                    </div>
                }
                <div class="cw-after"><span>ℹ</span><span>Les Pages cochées seront proposées dans vos listes de lecture.</span></div>
            }
            else if (Li)
            {
                @* LinkedIn (§255) : pages où la personne a un rôle ; seules celles d'un administrateur ou d'un éditeur de contenu sont lisibles *@
                var readable = liPages.Where(p => p.CanRead).ToList();
                <h2 class="cw-h">Vos pages LinkedIn</h2>
                <p class="cw-lead">@(liPages.Count == 0 ? "Nous n'avons trouvé aucune page." : $"Nous avons trouvé {liPages.Count} page{(liPages.Count > 1 ? "s" : "")} dans votre compte. Chaque page cochée pourra être ajoutée à vos listes de lecture (une page par contenu).")</p>
                @if (readable.Count == 0)
                {
                    <div class="dfp-empty">@(liPages.Count == 0 ? "Ce compte ne gère aucune page entreprise. LinkedIn ne permet pas d'afficher les publications d'un profil personnel." : "Votre rôle sur ces pages ne permet pas de lire leurs publications.") Connectez-vous avec le compte qui gère la page, ou demandez à un administrateur de la page de vous donner le rôle « Éditeur de contenu ».</div>
                    <p><a class="cw-sub" href="@ConnectUrl" target="_top">Utiliser un autre compte</a></p>
                }
                else
                {
                    <div class="cw-tools">
                        <span class="cw-count"><b>@chosenPages.Count</b> sur @readable.Count sélectionnée@(chosenPages.Count > 1 ? "s" : "")</span>
                        <button type="button" class="btn ghost sm" @onclick="ToggleAllLi">@(chosenPages.Count == readable.Count ? "Tout désélectionner" : "Tout sélectionner")</button>
                    </div>
                    <div class="cw-rows">
                        @foreach (var p in liPages.OrderBy(p => p.CanRead ? 0 : 1))
                        {
                            var urn = p.Urn;
                            var on = chosenPages.Contains(urn);
                            <button type="button" class="cw-row @(on ? "on" : "") @(p.CanRead ? "" : "dis")" disabled="@(!p.CanRead)" title="@(p.CanRead ? null : "Ce rôle ne permet pas de lire les publications de la page")" @onclick="() => TogglePage(urn)"><span class="cw-av">@(p.Name.Length > 0 ? p.Name[..1] : "?")</span><b>@p.Name</b><span class="cw-role">@LinkedinAuth.RoleLabel(p.Role)</span><span class="cw-ck">@(on ? "✓" : "")</span></button>
                        }
                    </div>
                }
                @if (liPages.Any(p => !p.CanRead) && readable.Count > 0)
                {
                    <div class="cw-after"><span>ℹ</span><span>Les pages grisées ne peuvent pas être affichées : votre rôle ne permet pas de lire leurs publications. Demandez le rôle « Éditeur de contenu » à un administrateur de la page.</span></div>
                }
            }
            else
            {
                <h2 class="cw-h">Que voulez-vous ajouter ?</h2>
                <p class="cw-lead">@(files.Count == 0 ? $"Aucun fichier de ce type n'a été trouvé à la racine de votre {(Cloud.IsGoogle ? "Google Drive" : "OneDrive")}." : $"Nous avons trouvé {files.Count}{(more ? " ou plus" : "")} {Noun(files.Count)} dans votre {(Cloud.IsGoogle ? "Google Drive" : "OneDrive")}.")</p>
                @if (files.Count == 0) { <div class="dfp-empty">Vous pourrez chercher dans tous vos dossiers depuis une liste de lecture.</div> }
                else
                {
                    var shown = files.Take(20).ToList();
                    <div class="cw-tools">
                        <span class="cw-count"><b>@chosen.Count</b> sur @shown.Count sélectionné@(chosen.Count > 1 ? "s" : "")</span>
                        <button type="button" class="btn ghost sm" @onclick="ToggleAll">@(chosen.Count == shown.Count ? "Tout désélectionner" : "Tout sélectionner")</button>
                    </div>
                    <div class="cw-cards">
                        @foreach (var f in shown)
                        {
                            var fr = f.Ref;
                            var on = chosen.Contains(fr);
                            <button type="button" class="cw-card @(on ? "on" : "")" @onclick="() => Toggle(fr)">
                                <span class="cw-ck">@(on ? "✓" : "")</span>
                                <b>@f.Name</b><small>@f.Info</small>
                            </button>
                        }
                    </div>
                }
                <div class="cw-after"><span>ℹ</span><span>Les fichiers cochés sont copiés dans votre Médiathèque et convertis en images, lues même hors ligne. Vos originaux ne sont pas modifiés.</span></div>
            }
        </div>
    }
    else
    {
        <div class="cw-body cw-final">
            @if (done)
            {
                <div class="cw-bigok">✓</div>
                <h2 class="cw-h">@Name est prêt</h2>
                <p class="cw-lead">@(Li ? $"{chosenPages.Count} page{(chosenPages.Count > 1 ? "s" : "")} prête{(chosenPages.Count > 1 ? "s" : "")} à être affichée{(chosenPages.Count > 1 ? "s" : "")}. Ajoutez LinkedIn à une liste de lecture pour l'afficher sur vos écrans." : AppId == "facebook" ? $"{chosenPages.Count} Page{(chosenPages.Count > 1 ? "s" : "")} prête{(chosenPages.Count > 1 ? "s" : "")} à être affichée{(chosenPages.Count > 1 ? "s" : "")}." : chosen.Count == 0 ? "Vous pourrez ajouter vos fichiers depuis une liste de lecture." : $"{chosen.Count - importErrors.Count} {Noun(chosen.Count - importErrors.Count)} ajoutée{(chosen.Count - importErrors.Count > 1 ? "s" : "")} à votre Médiathèque.")</p>
            }
            else
            {
                <div class="cw-spin"></div>
                <h2 class="cw-h">Ajout en cours…</h2>
                <p class="cw-lead">@status</p>
                <div class="cw-bar"><i style="width:@(Progress)%"></i></div>
            }
            @foreach (var e in importErrors) { <div class="dfp-empty err">@e</div> }
        </div>
    }
</WizardShell>

@code {
    [Parameter, EditorRequired] public string AppId { get; set; } = "";   // google-slides | google-docs | ms-powerpoint | facebook
    [Parameter] public int StartStep { get; set; } = 1;
    [Parameter] public bool Adding { get; set; }
    [Parameter] public bool AccountShared { get; set; }
    [Parameter] public EventCallback OnAdded { get; set; }
    [Parameter] public EventCallback OnClose { get; set; }
    [Parameter] public EventCallback OnChanged { get; set; }

    private static readonly string[] Labels = { "Compte", "Sélection", "Terminé" };
    private CloudFileKind Cloud => CloudFileKind.Of(AppId)!;
    private string Name => Svc.Find(AppId)?.Name ?? AppId;
    private bool Li => AppId == "linkedin";
    private string Kind => Li ? ConnectedAccounts.Linkedin : AppId == "facebook" ? ConnectedAccounts.Facebook : Cloud.IsGoogle ? ConnectedAccounts.Google : ConnectedAccounts.Microsoft;
    private string Provider => Li ? "LinkedIn" : AppId == "facebook" ? "Facebook" : Cloud.IsGoogle ? "Google" : "Microsoft";
    private string ConnectUrl => Li ? "/linkedin/pages/connect?wiz=linkedin" : AppId == "facebook" ? "/facebook/connect?wiz=facebook"
        : Cloud.IsGoogle ? $"/google/connect?for=drive&wiz={AppId}" : $"/microsoft/connect?for=drive&wiz={AppId}";
    private string Noun(int n) => AppId switch { "google-slides" => n > 1 ? "présentations" : "présentation", "google-docs" => n > 1 ? "documents" : "document", _ => n > 1 ? "présentations PowerPoint" : "présentation PowerPoint" };
    private string FileNoun => AppId switch { "google-slides" => "Présentations", "google-docs" => "Documents", _ => "Présentations PowerPoint" };
    private string[] Permissions => Li
        ? new[] { "Lire la liste des pages que vous gérez et votre rôle (r_organization_admin)", "Lire les publications de ces pages, leurs photos, vidéos et nombres de réactions (r_organization_social)", "Connexion valable environ 60 jours : Linkivi vous prévient 7 jours avant", "Rien n'est modifié ni publié chez LinkedIn" }
        : AppId == "facebook"
        ? new[] { "Lire la liste des Pages que vous administrez", "Lire les publications de ces Pages" }
        : new[] { "Lire vos fichiers (" + FileNoun.ToLowerInvariant() + ")", "Les convertir en images pour vos écrans", "Lire le nom de votre profil" };

    private int step = 1;
    private bool ready, connected, lost, loading, done, importing;
    private readonly HashSet<string> chosen = new();
    private readonly List<string> importErrors = new();
    private string status = "";
    private string user = "", Missing = "";
    private string? error;
    private DateTime? since;
    private List<DriveNode> files = new();
    private bool more;
    private List<FacebookPageAccess> pages = new();
    private readonly HashSet<string> chosenPages = new();

    private void TogglePage(string id) { if (!chosenPages.Remove(id)) chosenPages.Add(id); }
    private void ToggleAllPages() { if (chosenPages.Count == pages.Count) chosenPages.Clear(); else chosenPages.UnionWith(pages.Select(p => p.Id)); }
    private List<LinkedinPageAccess> liPages = new();
    private void ToggleAllLi()
    {
        var readable = liPages.Where(p => p.CanRead).Select(p => p.Urn).ToList();
        if (chosenPages.Count == readable.Count) chosenPages.Clear(); else chosenPages.UnionWith(readable);
    }

    private bool NextDisabled => importing || step == 1 && !connected || step == 2 && (loading || error != null
        || (Li ? chosenPages.Count == 0 : AppId == "facebook" ? pages.Count > 0 && chosenPages.Count == 0 : chosen.Count == 0 && files.Count > 0));
    private string NextLabel => step == 1 ? "Suivant"
        : step == 2 && Li ? (chosenPages.Count > 0 ? $"Ajouter {chosenPages.Count} page{(chosenPages.Count > 1 ? "s" : "")}" : "Ajouter")
        : step == 2 ? (AppId == "facebook" ? (chosenPages.Count > 0 ? $"Ajouter {chosenPages.Count} Page{(chosenPages.Count > 1 ? "s" : "")}" : "Ajouter Facebook") : chosen.Count > 0 ? $"Ajouter {chosen.Count} {Noun(chosen.Count)}" : "Ajouter " + Name)
        : "Ajout en cours…";
    private string Hint => step == 3 ? "" : Adding ? "Rien n'est enregistré tant que vous n'avez pas ajouté." : "";
    private int Progress => doneCount * 100 / Math.Max(1, chosen.Count);
    private int doneCount;
    private string[]? CanDo => Li ? new[] { "Voir les pages que vous gérez", "Afficher leurs publications sur vos écrans" }
        : AppId == "facebook" ? new[] { "Voir la liste de vos Pages", "Afficher leurs publications sur vos écrans" } : null;
    private string[]? CannotDo => Li ? new[] { "Publier, commenter ou réagir à votre place", "Voir votre profil, vos messages ou vos contacts" }
        : AppId == "facebook" ? new[] { "Publier à votre place", "Voir votre profil personnel" } : null;

    protected override async Task OnInitializedAsync()
    {
        Refresh();
        step = !connected ? 1 : Math.Clamp(StartStep, 1, 2);
        if (step == 2) await Load();
    }

    private void Refresh()
    {
        var t = Store.Read(d => d.Tenant);
        lost = false;
        Missing = $"Connectez le compte {Provider} qui a accès à vos fichiers.";
        if (Li)
        {
            ready = LinkedinAuth.IsConfigured;
            connected = LinkedinAuth.Has(t);
            lost = t.LinkedinConnectedUtc != null && !connected;
            user = t.LinkedinUser.Length > 0 ? t.LinkedinUser : "Compte LinkedIn"; since = t.LinkedinConnectedUtc;
            Missing = "Connectez le compte LinkedIn qui gère la page de votre organisation (administrateur ou éditeur de contenu).";
        }
        else if (AppId == "facebook")
        {
            ready = FacebookAuth.IsConfigured;
            connected = FacebookAuth.Has(t);
            lost = t.FacebookLostUtc != null;
            user = t.FacebookUser; since = t.FacebookConnectedUtc;
            Missing = "Connectez le compte Facebook qui administre vos Pages.";
        }
        else if (Cloud.IsGoogle)
        {
            ready = GoogleAuth.IsConfigured;
            connected = GoogleAuth.Has(t, GoogleAuth.DriveScope);
            var g = GoogleAuth.ConnectionOf(t);
            (user, since) = (g.User, g.Since);
            if (g.Connected && !connected) Missing = "Compte connecté pour Google Calendar : autorisez aussi la lecture de vos fichiers Drive.";
        }
        else
        {
            ready = MsAuth.IsConfigured;
            connected = MicrosoftAuth.Has(t, MicrosoftAuth.DriveScope);
            var m = MicrosoftAuth.ConnectionOf(t);
            (user, since) = (m.User, m.Since);
            if (m.Connected && !connected) Missing = "Compte connecté pour les agendas : autorisez aussi la lecture de vos fichiers.";
        }
    }

    private async Task Load()
    {
        loading = true; error = null;
        StateHasChanged();
        var t = Store.Read(d => d.Tenant);
        try
        {
            if (Li)
            {
                // pages et rôles relus chez LinkedIn (un rôle a pu changer depuis la connexion) ; à défaut, ceux de la connexion
                if (!Adding) { await LinkedinAuth.RefreshPages(t); t = Store.Read(d => d.Tenant); }
                liPages = t.LinkedinPages.ToList();
                chosenPages.Clear(); chosenPages.UnionWith(liPages.Where(p => p.CanRead && !p.Off).Select(p => p.Urn));
            }
            else if (AppId == "facebook") { pages = FacebookAuth.Pages(t); chosenPages.Clear(); chosenPages.UnionWith(pages.Where(p => !p.Off).Select(p => p.Id)); }
            else
            {
                var l = await Drives.BrowseFiles(t, Cloud, DriveSources.Roots(Cloud.Source)[0].Key, null);
                files = l.Files; more = l.More;
                chosen.Clear(); chosen.UnionWith(files.Take(20).Select(f => f.Ref));   // tout est coché : on décoche ce qu'on ne veut pas
            }
        }
        catch (Exception ex) when (ex is InvalidOperationException or HttpRequestException or System.Text.Json.JsonException or KeyNotFoundException or TaskCanceledException) { error = ex.Message; }
        loading = false;
    }

    private Task Close() => OnClose.InvokeAsync();

    private async Task Cancel()
    {
        // rien ne reste : le compte connecté pendant l'assistant part (sauf s'il sert à une autre application)
        if (Adding && !AccountShared && connected) await Accounts.Disconnect(Kind);
        await OnClose.InvokeAsync();
    }

    private void Back() { if (step > 1 && !importing) step--; }

    private void Toggle(string fileRef) { if (!chosen.Remove(fileRef)) chosen.Add(fileRef); }

    private void ToggleAll()
    {
        var all = files.Take(20).Select(f => f.Ref).ToList();
        if (chosen.Count == all.Count) chosen.Clear(); else chosen.UnionWith(all);
    }

    private async Task Next()
    {
        if (step == 1) { step = 2; await Load(); }
        else if (step == 2) { step = 3; await Run(); }
        else await Close();
    }

    private async Task Run()
    {
        if (Adding) { Svc.Mark(AppId); await OnAdded.InvokeAsync(); }
        Svc.Enable(AppId);
        if (AppId == "facebook")
        {
            Svc.SetContentsOn(pages.Where(p => chosenPages.Contains(p.Id)).Select(p => ("page", p.Id)), true);
            Svc.SetContentsOn(pages.Where(p => !chosenPages.Contains(p.Id)).Select(p => ("page", p.Id)), false);
        }
        if (Li)
        {
            Svc.SetContentsOn(liPages.Where(p => chosenPages.Contains(p.Urn)).Select(p => ("lipage", p.Urn)), true);
            Svc.SetContentsOn(liPages.Where(p => !chosenPages.Contains(p.Urn)).Select(p => ("lipage", p.Urn)), false);
        }
        if (AppId != "facebook" && !Li && chosen.Count > 0)
        {
            importing = true; importErrors.Clear(); doneCount = 0; var k = 0;
            var tenant = Store.Read(d => d.Tenant);
            foreach (var node in files.Where(f => chosen.Contains(f.Ref)).ToList())
            {
                doneCount = k++;
                status = $"Import de « {node.Name} »…";
                StateHasChanged();
                var src = Cloud.SrcOf(node.Name);
                try
                {
                    var (imported, err) = await Importer.Import(tenant, Store.ClientId, Store.AreaId, Cloud, node.Ref, null,
                        new PdfService.Options("", "none", "landscape", Pres.Unit(src), src), new Progress<string>(s => { status = $"« {node.Name} » : {s}"; _ = InvokeAsync(StateHasChanged); }));
                    if (imported == null) { importErrors.Add($"« {node.Name} » : {err ?? "import impossible."}"); continue; }
                    if (imported.Result.Presentation == null)   // une seule page : une image ordinaire, à la racine, rattachée au fichier d'origine
                        Store.Write(d => { foreach (var img in imported.Result.Files) if (d.Media.FirstOrDefault(m => m.Id == img.Id) is { } live) { live.FolderId = null; live.Info["key"] = Cloud.KeyOf(node.Ref); live.Info["src"] = src; live.Info["file"] = node.Name; } });
                }
                catch (Exception ex) { importErrors.Add($"« {node.Name} » : {ex.Message}"); }
            }
            importing = false;
        }
        done = true;
        await OnChanged.InvokeAsync();
    }
}
