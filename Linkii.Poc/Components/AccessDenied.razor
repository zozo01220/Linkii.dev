@inject NavigationManager Nav
@inject AuthenticationStateProvider Auth

@* Page réservée à un autre rôle : on renvoie l'utilisateur vers son accueil (ou vers la connexion). *@
<div style="padding:40px"><h2>Accès refusé</h2><p>Cette page n'est pas disponible pour votre compte.</p></div>

@code {
    protected override async Task OnInitializedAsync()
    {
        var user = (await Auth.GetAuthenticationStateAsync()).User;
        var path = "/" + Nav.ToBaseRelativePath(Nav.Uri).Split('?')[0].TrimEnd('/');
        var target = user.Identity?.IsAuthenticated == true ? Claims.Home(user) : "/login";
        if (target != path && !(target == "/" && path == "/")) Nav.NavigateTo(target, forceLoad: true);
    }
}
