@using Microsoft.JSInterop
@inject TenantStore Store
@inject AppCatalog Catalog
@inject HomeAssistantLive Live
@inject Toaster Toast
@inject NavigationManager Nav
@inject IJSRuntime JS

@* Un plan du bâtiment en pleine page (§208, BuildingPlanEditor), d'abord dans le tiroir de la page Plans (§202-§204) :
   - barre du haut calquée sur l'éditeur de compositions : ← Quitter, nom du plan modifiable sur place, onglets Plan / Affichages / Où il s'affiche,
     puis à droite l'état, Aperçu, Annuler, Enregistrer (selon l'onglet) ;
   - corps : l'éditeur (HaPlanEditor), les affichages (HaViewsEditor) ou « où il s'affiche ». *@
<header class="ce-top hpx-top">
    <button type="button" class="ce-tb ce-back" title="Quitter" aria-label="Quitter" @onclick="Close"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M19 12H5M11 6l-6 6 6 6" /></svg></button>
    <input type="text" class="ce-name" maxlength="60" placeholder="Nom du plan (Maison, Bureaux…)" aria-label="Nom du plan" title="@Stats" @bind="nameValue" @bind:event="oninput" />
    <span class="ce-sep"></span>
    <nav class="hpd-tabs" role="tablist" aria-label="Plan du bâtiment">
        @Tab("plan", "Plan", plan == null ? null : parsed.Devices.Count, false)
        @Tab("affichages", "Affichages", plan?.Views.Count, IsNew)
        @Tab("diffusion", "Où il s'affiche", plan == null ? null : uses.Count, IsNew)
    </nav>
    <span style="flex:1"></span>
    <span class="ce-dirty">@Status</span>
    <button type="button" class="ce-btn ghost" title="Voir le plan tel que l'écran l'affichera, avant d'enregistrer" disabled="@(tab != "plan" || ed?.CanPreview != true)" @onclick="() => ed?.TogglePreview()"><Ico Name="eye" Size="17" />@(tab == "plan" && ed?.Previewing == true ? "Fermer l'aperçu" : "Aperçu")</button>
    <button type="button" class="ce-btn ghost" disabled="@(!CanRevert)" @onclick="Revert">Annuler</button>
    <button type="button" class="ce-btn" disabled="@(!CanSave)" @onclick="SaveTop">Enregistrer</button>
</header>

<div class="hpd-b">
    @if (!IsNew && plan == null)
    {
        <div class="card empty"><div class="big">Plan introuvable</div><p>Il a peut-être été supprimé.</p></div>
    }
    else
    {
        <div class="hpd-pane" hidden="@(tab != "plan")">
            <HaPlanEditor @ref="ed" @key="editorKey" Name="@nameValue" Json="@(plan?.Json ?? "")" OnSave="Save" OnState="Refresh" />
        </div>
        @if (tab == "affichages" && plan != null)
        {
            <div class="hpd-pane"><HaViewsEditor @ref="vw" @key="viewsKey" PlanId="plan.Id" OnSaved="ViewsSaved" OnState="Refresh" /></div>
        }
        else if (tab == "diffusion" && plan != null)
        {
            <div class="hpd-pane col">
                <div class="hpg-uses-head">
                    <div class="grow"><b>Où il s'affiche</b> <small>Modifier le plan ou un de ses affichages met à jour tous ces écrans.</small></div>
                    <button type="button" class="btn primary" @onclick="OpenAdd"><Ico Name="plus" Size="16" /> Ajouter à…</button>
                </div>
                <div class="hpg-utab">
                    @if (uses.Count == 0)
                    {
                        <div class="card empty"><div class="big">Ce plan ne s'affiche encore nulle part</div><p>« Ajouter à… » le met dans une liste de lecture, sur un écran ou sur une borne, déjà réglé.</p></div>
                    }
                    else
                    {
                        <div class="hpg-uses" role="table">
                            <div class="hpg-ur hd" role="row"><span>Où</span><span>Affichage</span><span>Diffusé</span><span></span></div>
                            @foreach (var u in uses)
                            {
                                <div class="hpg-ur" role="row">
                                    <span class="hpg-un"><Ico Name="@KindIcon(u.Kind)" Size="17" /><span><b>@u.Name</b><small>@KindLabel(u.Kind)</small></span></span>
                                    <span><span class="hpg-pill">@ViewName(u.ViewId)</span></span>
                                    <span class="hpg-uw">@u.Where</span>
                                    <span>@if (UseHref(u) is { } href) { <a class="btn ghost sm" href="@href">Ouvrir</a> }</span>
                                </div>
                            }
                        </div>
                    }
                </div>
            </div>
        }
    }
</div>

@if (adding && plan != null)
{
    <SectionContent SectionName="overlay">
        <div class="modal-backdrop" @onclick="() => adding = false"></div>
        <div class="modal app-modal hpg-add" role="dialog" aria-modal="true" aria-label="Ajouter le plan">
            <div class="modal-head">
                <span class="app-ico" style="--app-c:#41BDF5"><Ico Name="home" Size="22" /></span>
                <div class="grow"><h3>Ajouter « @plan.Name » à…</h3><small>Le contenu, le widget ou la tuile est créé déjà relié au plan et à l'affichage.</small></div>
                <button type="button" class="modal-x" aria-label="Fermer" @onclick="() => adding = false"><Ico Name="x" Size="20" /></button>
            </div>
            <div class="modal-body">
                <div class="hpg-where">
                    @Where("list", "play-box", "Une liste de lecture", "Contenu « Vue du bâtiment » ajouté à la fin du fil")
                    @Where("screen", "monitor", "Un écran", "Widget posé sur l'écran, à placer ensuite")
                    @Where("kiosk", "hand", "Une borne", "Tuile qui ouvre le plan en grand")
                </div>
                @{ var targets = Targets(); }
                <div class="hpg-f">
                    <label for="hpg-target">@(addKind == "list" ? "Quelle liste ?" : addKind == "screen" ? "Quel écran ?" : "Quelle borne ?")</label>
                    @if (targets.Count == 0)
                    {
                        <div class="dw-note">@(addKind == "list" ? "Aucune liste de lecture." : addKind == "screen" ? "Aucun écran." : "Aucune borne interactive.")</div>
                    }
                    else
                    {
                        <select id="hpg-target" @bind="addTarget">
                            @foreach (var (id, label) in targets) { <option value="@id">@label</option> }
                        </select>
                    }
                </div>
                <div class="hpg-f">
                    <label for="hpg-view">Affichage</label>
                    <select id="hpg-view" @bind="addView">
                        @if (addKind == "screen") { <option value="">Auto : selon la taille de la case</option> }
                        @foreach (var v in plan.Views) { <option value="@v.Id">@v.Name · @HaViews.ModeLabel(v.Mode).ToLowerInvariant()</option> }
                    </select>
                    <small>@AddNote</small>
                </div>
            </div>
            <div class="modal-foot">
                <span class="grow"></span>
                <button type="button" class="btn" @onclick="() => adding = false">Annuler</button>
                <button type="button" class="btn primary" disabled="@(targets.Count == 0)" @onclick="Add"><Ico Name="plus" Size="15" /> Ajouter</button>
            </div>
        </div>
    </SectionContent>
}

@code {
    /// <summary>Plan ouvert ; null : nouveau plan.</summary>
    [Parameter] public Guid? PlanId { get; set; }
    /// <summary>Onglet demandé par l'adresse (?onglet=affichages | diffusion) ; sinon « Plan ».</summary>
    [Parameter] public string? Onglet { get; set; }
    /// <summary>Le plan a changé (enregistré, affichages, ajout).</summary>
    [Parameter] public EventCallback OnChanged { get; set; }
    /// <summary>Page d'où l'on vient : Quitter y ramène.</summary>
    [Parameter] public string Back { get; set; } = "/plans";

    private HaPlan? plan;
    private HaPlanEditor? ed;
    private HaViewsEditor? vw;
    private string nameValue = "", loadedFor = "";
    private bool PlanDirty => ed?.Dirty == true;
    private void Refresh() { }   // un état de l'éditeur a changé : le pied suit (l'appel d'un EventCallback redessine le tiroir)
    private HomeAssistantRules.Plan parsed = new(new(), new());
    private HomeAssistantAccount? account;
    private List<HaPlanUses.Use> uses = new();
    private string tab = "plan";
    private Guid editorKey = Guid.NewGuid(), viewsKey = Guid.NewGuid();
    private bool adding;
    private string addKind = "list", addTarget = "", addView = "";

    private bool IsNew => PlanId == null;

    private string Stats => plan == null ? "Dessinez les pièces de chaque étage, ou importez son plan, puis posez-y les appareils de Home Assistant."
        : $"{parsed.Floors.Count} étage{S(parsed.Floors.Count)} · {parsed.Floors.Sum(f => f.Rooms.Count)} pièce{S(parsed.Floors.Sum(f => f.Rooms.Count))} · {parsed.Devices.Count} appareil{S(parsed.Devices.Count)} · {(uses.Count == 0 ? "affiché nulle part" : $"affiché {uses.Count} fois")}";
    private static string S(int n) => n > 1 ? "s" : "";

    private string Status => tab switch
    {
        "plan" => PlanDirty ? "Modifications non enregistrées" : IsNew ? "Nouveau plan : nommez-le, dessinez, puis enregistrez" : "",
        "affichages" => vw?.Dirty == true ? "Modifications non enregistrées" : "",
        _ => "",
    };
    private bool CanRevert => tab switch { "plan" => IsNew || PlanDirty, "affichages" => vw?.Dirty == true, _ => false };
    private bool CanSave => tab switch { "plan" => nameValue.Trim().Length > 0 && (IsNew || PlanDirty), "affichages" => vw?.Dirty == true, _ => false };
    private Task SaveTop() => tab == "affichages" ? SaveViews() : SaveClick();
    private void Revert() { if (tab == "affichages") viewsKey = Guid.NewGuid(); else ResetEditor(); }

    protected override void OnParametersSet()
    {
        tab = !IsNew && Onglet is "affichages" or "diffusion" ? Onglet! : "plan";
        Load();
        var key = PlanId?.ToString() ?? "nouveau";
        if (loadedFor != key) { loadedFor = key; nameValue = plan?.Name ?? ""; }   // le nom saisi n'est pas écrasé quand le parent se redessine
    }

    private void Load()
    {
        account = Store.Read(d => d.Tenant.HomeAssistant);
        if (PlanId is not { } id) { plan = null; return; }
        // un plan reçoit une fois les affichages proposés d'office (Diffusion, Borne, Compact)
        plan = Store.Write<HaPlan?>(d =>
        {
            var p = d.Tenant.HaPlans.FirstOrDefault(x => x.Id == id);
            if (p == null) return null;
            HaViews.Ensure(p);
            return new HaPlan { Id = p.Id, Name = p.Name, Json = p.Json, UpdatedUtc = p.UpdatedUtc, Views = p.Views.ToList(), ViewsVersion = p.ViewsVersion };
        });
        parsed = HomeAssistantRules.ParsePlan(plan?.Json);
        uses = plan == null ? new() : Store.Read(d => HaPlanUses.Of(d, id));
    }

    private RenderFragment Tab(string key, string label, int? count, bool disabled) => @<button type="button" role="tab" class="@(tab == key ? "on" : "")" aria-selected="@(tab == key ? "true" : "false")" disabled="@disabled"
        title="@(disabled ? "Enregistrez d'abord le plan" : null)" @onclick="() => Go(key)">@label@if (count is { } n) { <span class="n">@n</span> }</button>;

    private void Go(string key)
    {
        tab = key;
        Nav.NavigateTo(Nav.GetUriWithQueryParameter("onglet", key == "plan" ? null : key), replace: true);
    }

    private void Save((string Name, string Json) r)
    {
        var id = plan?.Id ?? Guid.NewGuid();
        var name = r.Name.Trim();
        var taken = Store.Read(d => d.Tenant.HaPlans.Any(p => p.Id != id && p.Name.Equals(name, StringComparison.CurrentCultureIgnoreCase)));
        if (taken) { Toast.Error($"Un plan « {name} » existe déjà."); return; }
        var json = r.Json;
        Store.Write(d =>
        {
            if (d.Tenant.HaPlans.FirstOrDefault(p => p.Id == id) is not { } p) d.Tenant.HaPlans.Add(p = new HaPlan { Id = id, Name = name, Json = json });
            p.Name = name; p.Json = json; p.UpdatedUtc = DateTime.UtcNow;
            HaViews.Ensure(p);
            var pp = HomeAssistantRules.ParsePlan(json);
            p.Views = p.Views.Select(v => HaViews.Normalize(v, pp)).ToList();
        });
        Live.Nudge(Store.ClientId);   // les écrans qui affichent ce plan relisent ses appareils
        Toast.Ok($"Plan « {name} » enregistré.");
        nameValue = name;
        if (IsNew) { Nav.NavigateTo($"/plans/{id}{(Back == "/plans" ? "" : "?back=" + Uri.EscapeDataString(Back))}", replace: true); _ = OnChanged.InvokeAsync(); return; }
        Load();
        editorKey = Guid.NewGuid();   // l'éditeur repart du plan enregistré : plus de modifications en attente
        _ = OnChanged.InvokeAsync();
    }

    private Task SaveClick() => ed == null ? Task.CompletedTask : ed.Apply();
    private Task SaveViews() => vw == null ? Task.CompletedTask : vw.SaveAsync();

    /// <summary>Quitter : retour à la page d'où l'on vient ; des modifications en attente demandent confirmation.</summary>
    private async Task Close()
    {
        if ((PlanDirty || vw?.Dirty == true) && !await JS.InvokeAsync<bool>("confirm", "Quitter sans enregistrer vos modifications ?")) return;
        Nav.NavigateTo(Back);
    }

    /// <summary>« Annuler les modifications » : l'éditeur repart du plan enregistré, le nom aussi (nouveau plan : retour à la liste).</summary>
    private void ResetEditor()
    {
        if (IsNew && !PlanDirty) { Nav.NavigateTo(Back); return; }
        nameValue = plan?.Name ?? "";
        editorKey = Guid.NewGuid();
    }

    private void ViewsSaved() { Live.Nudge(Store.ClientId); viewsKey = Guid.NewGuid(); Load(); _ = OnChanged.InvokeAsync(); }

    // ---------- Où il s'affiche ----------
    private static string KindIcon(string k) => k switch { "list" => "play-box", "tile" => "hand", "kiosk" => "hand", _ => "monitor" };
    private static string KindLabel(string k) => k switch { "list" => "Contenu de liste", "tile" => "Tuile de borne", "kiosk" => "Widget de borne", _ => "Widget d'écran" };
    private string ViewName(Guid? id) => id is { } v && plan?.Views.FirstOrDefault(x => x.Id == v) is { } vv ? vv.Name : id == null ? "Auto" : "Affichage supprimé";
    private static string? UseHref(HaPlanUses.Use u) => u.Kind switch
    {
        "list" when u.PlaylistId is { } p => $"/playlists/{p}",
        "tile" when u.ListId is { } l => $"/interactive/{l}",
        "screen" or "kiosk" when u.ScreenId is { } s => $"/?edit={s}",
        _ => null,
    };

    private RenderFragment Where(string key, string icon, string title, string text) => @<button type="button" class="@(addKind == key ? "on" : "")" @onclick="() => PickKind(key)">
        <b><Ico Name="@icon" Size="17" /> @title</b><span>@text</span></button>;

    private void OpenAdd() { adding = true; PickKind("list"); }

    private void PickKind(string k)
    {
        addKind = k;
        addTarget = Targets().FirstOrDefault().Id.ToString();
        // affichage proposé selon l'endroit : diffusion dans une liste, borne sur une borne, auto sur un écran
        var mode = k == "list" ? "signage" : k == "kiosk" ? "interactive" : null;
        addView = mode == null ? "" : (plan?.Views.FirstOrDefault(v => v.Mode == mode) ?? plan?.Views.FirstOrDefault())?.Id.ToString() ?? "";
    }

    private List<(Guid Id, string Label)> Targets() => Store.Read(d => addKind switch
    {
        "list" => d.Playlists.OrderBy(p => p.Name, StringComparer.CurrentCultureIgnoreCase).Select(p => (p.Id, p.Name)).ToList(),
        "screen" => d.Screens.Where(s => s.Kiosk == null).OrderBy(s => s.Name, StringComparer.CurrentCultureIgnoreCase).Select(s => (s.Id, s.Name)).ToList(),
        _ => d.Screens.Where(s => s.Kiosk != null).OrderBy(s => s.Name, StringComparer.CurrentCultureIgnoreCase).Select(s => (s.Id, s.Name)).ToList(),
    });

    private HaPlanView? AddViewSel => plan?.Views.FirstOrDefault(v => v.Id.ToString() == addView);

    private string AddNote => addKind switch
    {
        "list" => AddViewSel is { } v && HaViews.TourSeconds(v) is { } sec ? $"Durée dans la liste : {sec} s, la visite complète." : "Durée dans la liste : la durée par défaut (réglable dans le fil).",
        "screen" => AddViewSel == null ? "Auto : le résumé seul dans une petite case, le plan dès qu'il y a la place." : "Le widget suit cet affichage ; ses autres réglages ne servent plus.",
        _ => "La tuile est ajoutée à la première page de la liste interactive de la borne ; ajustez sa place, puis publiez la borne.",
    };

    private void Add()
    {
        if (plan == null || !Guid.TryParse(addTarget, out var target)) return;
        var view = AddViewSel;
        var targetName = Targets().FirstOrDefault(t => t.Id == target).Label;
        var p = plan;
        string? err = Store.Write<string?>(d =>
        {
            switch (addKind)
            {
                case "list":
                    if (view == null) return "Choisissez un affichage.";
                    if (HaPlanUses.NewContent(d, Catalog, p, view) is not { } c) return "Le contenu « Vue du bâtiment » n'est pas disponible : activez Home Assistant dans Applications.";
                    return HaPlanUses.AddToList(d, target, c, view);
                case "screen":
                    return HaPlanUses.AddWidget(d, Catalog, target, p.Id, view?.Id);
                default:
                    if (view == null) return "Choisissez un affichage.";
                    if (HaPlanUses.NewContent(d, Catalog, p, view) is not { } k) return "Le contenu « Vue du bâtiment » n'est pas disponible : activez Home Assistant dans Applications.";
                    return HaPlanUses.AddTile(d, target, k, p.Name);
            }
        });
        if (err != null) { Toast.Error(err); return; }
        adding = false;
        Toast.Ok(addKind switch
        {
            "list" => $"Ajouté à la fin de la liste « {targetName} ». Les écrans qui la diffusent sont à publier.",
            "screen" => $"Widget posé sur « {targetName} », en haut à gauche : placez-le dans l'éditeur de l'écran, puis publiez.",
            _ => $"Tuile « {p.Name} » ajoutée à la liste interactive de « {targetName} » : ajustez sa place, puis publiez la borne.",
        });
        Load();
        _ = OnChanged.InvokeAsync();
    }
}
