@* Assembler des écrans en mur (ou réorganiser un mur) : une seule fenêtre, au standard de configuration (DEV-POC.md §30-31).
   Ligne 1 : la liste de lecture du mur ; à gauche la disposition (deux clics sur des places pour les échanger),
   à droite la grille et les conseils ; le miroir est dans « Options avancées » (icône du bandeau) ; le nom, dans « Renommer ».
   « Identifier » affiche le numéro de chaque place sur l'écran physique. *@
@inject TenantStore Store
@inject Notifier Notifier
@inject Toaster Toast

<div class="modal-backdrop" @onclick="() => OnClose.InvokeAsync(false)"></div>
<div class="modal app-modal wall-dlg" role="dialog" aria-modal="true" aria-labelledby="wall-title">
    <div class="modal-head">
        <div class="grow">
            <div class="ci-title"><h3 id="wall-title">@Title</h3> <button type="button" class="btn ghost sm" @onclick="OpenRename"><Ico Name="edit" Size="15" /> Renommer</button></div>
            <small class="muted">@(ZoneId == null ? $"Assembler {order.Count} écrans en mur" : "Réorganiser le mur")</small>
        </div>
        <button type="button" class="modal-x" aria-label="Options avancées" title="Options avancées" @onclick="OpenAdvanced"><Ico Name="sliders" Size="20" /></button>
        <button type="button" class="modal-x" aria-label="Fermer" @onclick="() => OnClose.InvokeAsync(false)"><Ico Name="x" Size="20" /></button>
    </div>
    <div class="modal-body">
        @* une colonne, sans défilement : grille et conseil de résolution en haut, puis le mur à ses vraies proportions (borné en largeur et en hauteur) *@
        <div class="wall-opts">
            <div>
                <label class="lbl" style="margin-top:0">Grille</label>
                <div class="wall-shapes" role="group" aria-label="Grille">
                    @foreach (var sh in shapes)
                    {
                        var shape = sh;
                        <button type="button" class="chip @(shape.Cols == cols && shape.Rows == rows ? "on" : "")" @onclick="() => SetShape(shape)">@shape.Cols × @shape.Rows</button>
                    }
                </div>
            </div>
            <span class="wall-note">Contenus à créer en <b class="mono">@(unitW * cols) × @(unitH * rows)</b> px</span>
        </div>
        @if (mixed)
        {
            <div class="wall-note warn">Les écrans n'ont pas tous le même format : le mur sera plus net avec des écrans identiques.</div>
        }
        @if (error != null) { <div class="err">@error</div> }

        <section aria-label="Disposition">
            <h4 class="ci-t">Disposition</h4>
            <div class="wall-box wall-stage">
                <div class="wall-grid" style="grid-template-columns:repeat(@cols, 1fr);--ar:@((16.0 * cols / (9.0 * rows)).ToString("0.####", System.Globalization.CultureInfo.InvariantCulture))">
                    @for (var i = 0; i < order.Count; i++)
                    {
                        var idx = i;
                        var s = screens.First(x => x.Id == order[idx]);
                        var cx = idx % cols;
                        var cy = idx / cols;
                        <button type="button" class="wall-cell @(thumb != null ? "has-img" : "") @(swap == idx ? "sel" : "")" title="@s.Name · place @Helpers.WallLabel(idx, cols, rows)" @onclick="() => Cell(idx)">
                            @* reflet de ce que la place affichera : la vignette de la liste du mur, découpée à la place de l'écran *@
                            @if (thumb != null) { <span class="wc-img" style="width:@(cols * 100)%;height:@(rows * 100)%;left:-@(cx * 100)%;top:-@(cy * 100)%"><MediaThumb Media="thumb" All="media" /></span> }
                            <span class="n">@(idx + 1)</span>
                            <b>@s.Name</b>
                            @if (s.Orientation == "portrait") { <small>portrait</small> }
                        </button>
                    }
                </div>
            </div>
            <div class="row" style="margin-top:10px;gap:10px;flex-wrap:wrap">
                <button type="button" class="btn ghost sm" disabled="@identifying" @onclick="Identify"><Ico Name="monitor" Size="14" /> Identifier sur les écrans</button>
                <small class="muted">Ordre : gauche → droite, haut → bas</small>
                <span class="se-info" tabindex="0" title="Cliquez deux places pour les échanger. « Identifier » affiche le numéro de chaque place sur l'écran physique pendant 5 s.">i</span>
            </div>
        </section>
        @if (ZoneId == null)
        {
            <small class="muted" style="display:block;margin-top:12px">Les écrans jouent la liste du mur, en écran plein, et sont publiés aussitôt. Dissoudre le mur les remet dans la zone « @Zone.DefaultName ».</small>
        }
    </div>    <div class="modal-foot">
        <small class="muted grow">@order.Count écrans · @cols × @rows</small>
        <button type="button" class="btn ghost" @onclick="() => OnClose.InvokeAsync(false)">Annuler</button>
        <button type="button" class="btn" disabled="@saving" @onclick="Save">@(ZoneId == null ? "Créer le mur" : "Enregistrer")</button>
    </div>
</div>

@if (renaming)
{
    <div class="modal-backdrop picker-backdrop" @onclick="() => renaming = false"></div>
    <div class="modal app-modal ci-adv" role="dialog" aria-modal="true" aria-labelledby="wall-ren-title">
        <div class="modal-head">
            <div class="grow"><h3 id="wall-ren-title">Renommer le mur</h3></div>
            <button type="button" class="modal-x" aria-label="Fermer" @onclick="() => renaming = false"><Ico Name="x" Size="20" /></button>
        </div>
        <div class="modal-body">
            <div class="dw"><div class="dw-field">
                <label>Nom *</label>
                <input type="text" maxlength="60" placeholder="@DefaultName" @bind="renameDraft" @bind:event="oninput" @onkeydown="RenameKey" />
            </div></div>
        </div>
        <div class="modal-foot">
            <button type="button" class="btn ghost" @onclick="() => renaming = false">Annuler</button>
            <button type="button" class="btn" @onclick="ApplyRename">Valider</button>
        </div>
    </div>
}

@if (advanced)
{
    <div class="modal-backdrop picker-backdrop" @onclick="CancelAdvanced"></div>
    <div class="modal app-modal ci-adv" role="dialog" aria-modal="true" aria-labelledby="wall-adv-title">
        <div class="modal-head">
            <div class="grow"><h3 id="wall-adv-title">Options avancées</h3><small>@Title</small></div>
            <button type="button" class="modal-x" aria-label="Fermer" @onclick="CancelAdvanced"><Ico Name="x" Size="20" /></button>
        </div>
        <div class="modal-body">
            <div class="mirror-opts">
                <label class="lbl" style="margin-top:0">Miroir du mur</label>
                <label class="mirror-row"><button type="button" class="switch @(mirrorH ? "on" : "")" role="switch" aria-checked="@(mirrorH ? "true" : "false")" aria-label="Miroir horizontal du mur" @onclick="() => mirrorH = !mirrorH"><span></span></button> <span><b>Horizontal</b><small>Inverse la gauche et la droite du mur entier.</small></span></label>
                <label class="mirror-row"><button type="button" class="switch @(mirrorV ? "on" : "")" role="switch" aria-checked="@(mirrorV ? "true" : "false")" aria-label="Miroir vertical du mur" @onclick="() => mirrorV = !mirrorV"><span></span></button> <span><b>Vertical</b><small>Inverse le haut et le bas du mur entier.</small></span></label>
                <small class="muted">Pour un mur vu par réflexion. Un seul écran monté à l'envers se règle dans son édition.</small>
            </div>
        </div>
        <div class="modal-foot">
            <button type="button" class="btn ghost" @onclick="CancelAdvanced">Annuler</button>
            <button type="button" class="btn" @onclick="() => advanced = false">Valider</button>
        </div>
    </div>
}
@code {
    /// <summary>Écrans, dans l'ordre de sélection (création) ; ignoré en réorganisation (les écrans du mur, dans leur ordre).</summary>
    [Parameter] public List<Guid> ScreenIds { get; set; } = new();
    /// <summary>Mur à réorganiser (null : création).</summary>
    [Parameter] public Guid? ZoneId { get; set; }
    [Parameter] public EventCallback<bool> OnClose { get; set; }

    private List<Screen> screens = new();
    private List<Guid> order = new();
    private List<Playlist> playlists = new();
    private List<(int Cols, int Rows)> shapes = new();
    private int cols, rows, unitW = 1920, unitH = 1080;
    private int? swap;
    private bool mixed, saving, identifying, mirrorH, mirrorV;
    private string name = "", playlistValue = "", zoneName = "", renameDraft = "";
    private bool renaming, advanced, renamed, mirrorBackH, mirrorBackV;   // renamed : nom choisi par l'utilisateur (le nom proposé suit la grille)

    private string? error;
    private Guid areaId;
    private List<MediaItem> media = new();
    private MediaItem? thumb;   // premier contenu plein écran de la liste du mur : l'image que le mur affichera, répartie sur les places

    private string DefaultName => $"Mur {cols} × {rows}";
    private string Title => renamed && name.Trim().Length > 0 ? name.Trim() : ZoneId == null ? DefaultName : zoneName;

    private void OpenRename() { renameDraft = renamed ? name : Title; renaming = true; }

    private void ApplyRename()
    {
        if (!string.IsNullOrWhiteSpace(renameDraft)) { name = renameDraft.Trim(); renamed = true; }
        renaming = false;
    }

    private void RenameKey(KeyboardEventArgs e)
    {
        if (e.Key == "Enter") ApplyRename();
        else if (e.Key == "Escape") renaming = false;
    }

    private void OpenAdvanced() { (mirrorBackH, mirrorBackV) = (mirrorH, mirrorV); advanced = true; }

    private void CancelAdvanced() { (mirrorH, mirrorV) = (mirrorBackH, mirrorBackV); advanced = false; }

    protected override void OnInitialized()
    {
        (areaId, playlists) = Store.Read(d => (d.Area?.Id ?? Guid.Empty, d.Playlists.OrderBy(p => p.Name).ToList()));
        if (ZoneId is { } zid)
        {
            var zone = Store.Read(d => d.Area?.Zones.FirstOrDefault(z => z.Id == zid));
            zoneName = zone?.Name ?? "";
            (mirrorH, mirrorV) = (zone?.MirrorH ?? false, zone?.MirrorV ?? false);
            screens = Store.Read(d => d.Screens.Where(s => s.Token != null && s.ZoneId == zid).OrderBy(s => s.WallPos ?? int.MaxValue).ToList());
            if (zone != null && zone.WallCols * zone.WallRows == screens.Count) (cols, rows) = (zone.WallCols, zone.WallRows);
        }
        else
        {
            var all = Store.Read(d => d.Screens.Where(s => s.Token != null).ToList());
            screens = ScreenIds.Distinct().Select(id => all.FirstOrDefault(s => s.Id == id)).OfType<Screen>().ToList();   // un écran = une place
            var first = screens.FirstOrDefault()?.PlaylistId;
            playlistValue = playlists.Any(p => p.Id == first) ? first.ToString()! : "";
        }
        media = Store.Read(d => d.Media.Where(m => m.Status == null).ToList());
        var wallPlId = ZoneId is { } wz ? Store.Read(d => d.Area?.Zones.FirstOrDefault(z => z.Id == wz)?.PlaylistId) : Guid.TryParse(playlistValue, out var wp) ? wp : (Guid?)null;
        thumb = playlists.FirstOrDefault(p => p.Id == wallPlId)?.Draft.Where(i => i.Placement == "full").Select(i => media.FirstOrDefault(m => m.Id == i.MediaId)).FirstOrDefault(m => m != null);
        order = screens.Select(s => s.Id).ToList();
        shapes = Helpers.WallShapes(order.Count);
        if (!shapes.Contains((cols, rows))) (cols, rows) = shapes.FirstOrDefault((order.Count, 1));
        mixed = screens.Select(s => (s.Orientation, s.Resolution)).Distinct().Count() > 1;
        (unitW, unitH) = UnitSize(screens.FirstOrDefault());
    }

    // Taille d'un écran (pour la résolution conseillée) : sa résolution réglée, sinon détectée, sinon Full HD ; dans le sens de l'écran.
    private static (int W, int H) UnitSize(Screen? s)
    {
        int a = 1920, b = 1080;
        if (s?.Resolution is { } r && r.Split('x') is [var x, var y] && int.TryParse(x, out var px) && int.TryParse(y, out var py)) (a, b) = (px, py);
        else if (s?.DetectedW is int dw && s.DetectedH is int dh) (a, b) = (dw, dh);
        var (big, small) = (Math.Max(a, b), Math.Min(a, b));
        return s?.Orientation == "portrait" ? (small, big) : (big, small);
    }

    private void SetShape((int Cols, int Rows) s) { (cols, rows) = s; swap = null; }

    private void Cell(int i)
    {
        if (swap is not { } j) { swap = i; return; }
        (order[i], order[j]) = (order[j], order[i]);
        swap = null;
    }

    private async Task Identify()
    {
        identifying = true;
        try { await Notifier.Identify(order); }
        finally { identifying = false; }
    }

    // Miroir du mur : les écrans le reçoivent avec leur place (révision), sans republier.
    private void SetMirror(Guid zoneId)
    {
        var (h, v) = (mirrorH, mirrorV);
        Store.Write(d => { if (d.Area?.Zones.FirstOrDefault(z => z.Id == zoneId) is { } z) { z.MirrorH = h; z.MirrorV = v; } });
    }

    private async Task Save()
    {
        error = null;
        saving = true;
        try
        {
            var ids = order.ToList(); var c = cols; var r = rows; var aid = areaId;
            if (ZoneId is { } zid)
            {
                var newName = name.Trim();
                error = Store.Write(d =>
                {
                    var e = AreaOps.ArrangeWall(d, aid, zid, ids, c, r);
                    if (e == null && renamed && newName.Length > 0) e = AreaOps.RenameZone(d, aid, zid, newName);
                    return e;
                });
                if (error != null) return;
                SetMirror(zid);
                await Notifier.NotifyZone(zid);   // nouvelle place : chaque écran recadre sa portion
                Toast.Ok("Mur réorganisé.");
            }
            else
            {
                Guid? pl = Guid.TryParse(playlistValue, out var g) ? g : null;
                var n = renamed && name.Trim().Length > 0 ? name : DefaultName;
                var (zone, err) = Store.Write(d => AreaOps.CreateWall(d, aid, ids, c, r, pl, n));
                if (zone == null) { error = err; return; }
                if (mirrorH || mirrorV) SetMirror(zone.Id);
                foreach (var id in ids) await Notifier.PublishScreen(id);   // la liste du mur part aussitôt sur chaque écran
                Toast.Ok($"Mur « {zone.Name} » créé : {ids.Count} écrans.");
            }
            await OnClose.InvokeAsync(true);
        }
        finally { saving = false; }
    }
}
