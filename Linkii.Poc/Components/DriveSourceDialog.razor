@inject TenantStore Store
@inject DriveService Drives
@inject AppService Svc
@inject GoogleAuth GoogleAuth
@inject MicrosoftAuth MsAuth
@inject DropboxAuth DropboxAuth
@inject Toaster Toast

@* Intégrations › Drives › Gérer : la connexion de la source, puis ses dossiers synchronisés.
   Google Drive : compte Google de l'organisation (« Se connecter avec Google »), partagé avec Google Calendar.
   OneDrive et SharePoint : compte Microsoft de l'organisation (« Se connecter avec Microsoft »), partagé avec les calendriers Microsoft 365.
   Un dossier se choisit en parcourant le compte (DriveFolderPicker) ou en collant son lien de partage ; ses sous-dossiers peuvent être inclus.
   Un dossier ajouté est synchronisé aussitôt, puis toutes les 15 minutes ; les écrans suivent sans republier. *@
<div class="modal-backdrop" @onclick="Close"></div>
<div class="modal app-modal wide" role="dialog" aria-modal="true" aria-labelledby="dsd-title">
    <div class="modal-head">
        <AppIcon Id="@("drv-" + Source)" />
        <div class="grow">
            <h3 id="dsd-title">@Def.Name</h3>
            <small>@HeadLine</small>
        </div>
        <button type="button" class="modal-x" aria-label="Fermer" @onclick="Close"><Ico Name="x" Size="20" /></button>
    </div>
    <div class="modal-body">
        @if (IsGoogle)
        {
            <h4 class="pe-sub csd-first">Compte Google</h4>
            @if (google.Connected && hasDrive)
            {
                <div class="cvs-account">
                    <span class="cat-avatar gd-avatar">@GoogleInitial</span>
                    <div class="grow">
                        <b>@(google.User.Length > 0 ? google.User : "Compte Google")</b>
                        <small>Connecté@(google.Since is { } since ? $" le {since.ToLocalTime():dd.MM.yyyy}" : "") · lecture seule : rien n'est modifié dans votre Drive.</small>
                    </div>
                    <button type="button" class="btn ghost sm" @onclick="() => OnShowAccount.InvokeAsync(ConnectedAccounts.Google)">Voir le compte</button>
                </div>
                <p class="csd-shared"><Ico Name="folder" Size="14" /> Collez le lien de n'importe quel dossier accessible à ce compte : ses dossiers, ceux partagés avec lui ou un Drive partagé. Aucun partage public n'est nécessaire.</p>
            }
            else if (google.Connected && GoogleAuth.IsConfigured)
            {
                <div class="cvs-account">
                    <span class="cat-avatar gd-avatar">@GoogleInitial</span>
                    <div class="grow">
                        <b>@(google.User.Length > 0 ? google.User : "Compte Google")</b>
                        <small>Connecté pour Google Calendar. Autorisez aussi la lecture de vos fichiers Drive (l'accès aux agendas est conservé).</small>
                    </div>
                    <a class="btn sm" href="/google/connect?for=drive" target="_top">Autoriser Drive</a>
                </div>
            }
            else if (GoogleAuth.IsConfigured)
            {
                <div class="cvs-account">
                    <div class="grow">
                        <b>Aucun compte connecté</b>
                        <small>Connectez le compte Google qui a accès à vos dossiers. Linkii demande uniquement un accès en lecture.</small>
                    </div>
                    <a class="btn sm" href="/google/connect?for=drive" target="_top">Se connecter avec Google</a>
                </div>
            }
            else
            {
                <div class="dw-note">Google Drive n'est pas encore disponible : la connexion Google de la plateforme doit d'abord être configurée sur le serveur par l'administrateur Linkii.</div>
            }
        }
        else if (Source == "onedrive")
        {
            <h4 class="pe-sub csd-first">Compte Microsoft</h4>
            @if (configured)
            {
                <div class="cvs-account">
                    <span class="cat-avatar gd-avatar">@MsInitial</span>
                    <div class="grow">
                        <b>@(ms.User.Length > 0 ? ms.User : "Compte Microsoft")</b>
                        <small>Connecté@(ms.Since is { } since ? $" le {since.ToLocalTime():dd.MM.yyyy}" : "") · lecture seule : rien n'est modifié dans vos fichiers.</small>
                    </div>
                    <button type="button" class="btn ghost sm" @onclick="() => OnShowAccount.InvokeAsync(ConnectedAccounts.Microsoft)">Voir le compte</button>
                </div>
                <p class="csd-shared"><Ico Name="folder" Size="14" /> Collez le lien de partage de n'importe quel dossier accessible à ce compte : OneDrive, bibliothèque SharePoint ou dossier partagé avec lui.</p>
            }
            else if (ms.Connected && MsAuth.IsConfigured)
            {
                <div class="cvs-account">
                    <span class="cat-avatar gd-avatar">@MsInitial</span>
                    <div class="grow">
                        <b>@(ms.User.Length > 0 ? ms.User : "Compte Microsoft")</b>
                        <small>Connecté pour les agendas Microsoft 365. Autorisez aussi la lecture de vos fichiers (l'accès aux agendas est conservé).</small>
                    </div>
                    <a class="btn sm" href="/microsoft/connect?for=drive" target="_top">Autoriser les fichiers</a>
                </div>
            }
            else if (MsAuth.IsConfigured)
            {
                <div class="cvs-account">
                    <div class="grow">
                        <b>Aucun compte connecté</b>
                        <small>Connectez le compte Microsoft qui a accès à vos dossiers. Linkii demande uniquement un accès en lecture.</small>
                    </div>
                    <a class="btn sm" href="/microsoft/connect?for=drive" target="_top">Se connecter avec Microsoft</a>
                </div>
                <p class="csd-shared"><Ico Name="lock" Size="14" /> Vous passez par la page de connexion Microsoft : Linkii ne voit jamais votre mot de passe.</p>
            }
            else
            {
                <div class="dw-note">OneDrive et SharePoint ne sont pas encore disponibles : la connexion Microsoft de la plateforme doit d'abord être configurée sur le serveur par l'administrateur Linkii.</div>
            }
        }
        else if (Source == "dropbox")
        {
            <h4 class="pe-sub csd-first">Compte Dropbox</h4>
            @if (configured)
            {
                <div class="cvs-account">
                    <Ico Name="folder" Size="22" />
                    <div class="grow">
                        <b>@(dropboxUser.Length > 0 ? dropboxUser : "Compte Dropbox")</b>
                        <small>Connecté · lecture seule : rien n'est modifié dans votre Dropbox.</small>
                    </div>
                    <button type="button" class="btn ghost sm" @onclick="() => OnShowAccount.InvokeAsync(ConnectedAccounts.Dropbox)">Voir le compte</button>
                </div>
                <p class="csd-shared"><Ico Name="folder" Size="14" /> Parcourez votre Dropbox, ou saisissez le chemin d'un dossier (/Affichage/Hall).</p>
            }
            else if (DropboxAuth.IsConfigured)
            {
                <div class="cvs-account">
                    <div class="grow">
                        <b>@(dropboxLost ? "Connexion expirée" : "Aucun compte connecté")</b>
                        <small>@(dropboxLost ? "Reconnectez votre compte Dropbox : ses dossiers ne sont plus mis à jour." : "Connectez le compte Dropbox qui a accès à vos dossiers. Linkii demande uniquement un accès en lecture.")</small>
                    </div>
                    <a class="btn sm" href="/dropbox/connect" target="_top">@(dropboxLost ? "Reconnecter Dropbox" : "Se connecter avec Dropbox")</a>
                </div>
                <p class="csd-shared"><Ico Name="lock" Size="14" /> Vous passez par la page de connexion Dropbox : Linkii ne voit jamais votre mot de passe.</p>
            }
            else
            {
                <div class="dw-note">Dropbox n'est pas encore disponible : la connexion Dropbox de la plateforme doit d'abord être configurée sur le serveur par l'administrateur Linkii.</div>
            }
        }
        else
        {
            <h4 class="pe-sub csd-first">Connexion</h4>
            <DriveAccountForm Source="@Source" OnSaved="Changed" OnShowAccount="OnShowAccount" />
        }


        <DriveSyncBar />
        <h4 class="pe-sub">Dossiers <span class="cat-count">@folders.Count</span></h4>
        <div class="cal-list dsd-list">
            @foreach (var f in folders)
            {
                var folder = f;
                var (contents, lists) = uses.GetValueOrDefault(folder.Id.ToString());
                var web = DriveSources.WebUrl(folder);
                <div class="cal-row @(flashId == folder.Id ? "flash" : "")">
                    <Ico Name="folder" Size="16" />
                    <div class="cal-id">
                        @if (renameId == folder.Id)
                        {
                            <input class="dsd-rename" maxlength="80" aria-label="Nom affiché" @bind="renameText" @bind:event="oninput" @onkeydown="e => OnRenameKey(e, folder)" @onblur="() => Rename(folder)" autofocus />
                        }
                        else { <b>@folder.Name</b> }
                        <small title="@folder.Location">@folder.Location · @folder.FileCount fichier@(folder.FileCount > 1 ? "s" : "") · synchronisé @DriveSources.Ago(folder.SyncedUtc)</small>
                        @if (folder.Subfolders) { <span class="dsd-tags"><span class="badge dsd-sub"><Ico Name="subfolders" Size="12" /> Avec sous-dossiers@(folder.SubfolderCount > 0 ? $" · {folder.SubfolderCount}" : "")</span></span> }
                        @if (folder.Skipped > 0)
                        {
                            <small class="dsd-warn">Limite de @DriveService.MaxFiles fichiers atteinte : @folder.Skipped fichier@(folder.Skipped > 1 ? "s" : "") ne @(folder.Skipped > 1 ? "sont" : "est") pas affiché@(folder.Skipped > 1 ? "s" : "").@(folder.Subfolders ? " Choisissez un sous-dossier plus précis, ou retirez l'option des sous-dossiers." : "")</small>
                        }
                        @if (folder.LastError.Length > 0) { <small class="cal-err" title="@folder.LastError">@folder.LastError</small> }
                    </div>
                    <span class="badge neutre">@(lists > 0 ? $"{lists} liste{(lists > 1 ? "s" : "")}" : contents > 0 ? $"{contents} contenu{(contents > 1 ? "s" : "")}" : "Non utilisé")</span>
                    <div class="kebab">
                        <button type="button" class="kebab-btn" aria-label="Actions pour @folder.Name" aria-haspopup="menu" aria-expanded="@(menuId == folder.Id ? "true" : "false")"
                                @onclick="() => menuId = menuId == folder.Id ? null : folder.Id"><Ico Name="dots-v" Size="18" /></button>
                        @if (menuId == folder.Id)
                        {
                            <div class="kebab-backdrop" @onclick="() => menuId = null"></div>
                            <div class="kebab-menu" role="menu">
                                <button type="button" role="menuitemcheckbox" aria-checked="@(folder.Subfolders ? "true" : "false")" disabled="@busy" @onclick="() => ToggleSubfolders(folder)">
                                    <span class="dsd-chk">@if (folder.Subfolders) { <Ico Name="check" Size="16" /> }</span> Inclure les sous-dossiers
                                </button>
                                <button type="button" role="menuitem" @onclick="() => StartRename(folder)"><Ico Name="edit" Size="16" /> Renommer</button>
                                @if (web.Length > 0) { <a role="menuitem" href="@web" target="_blank" rel="noopener" @onclick="() => menuId = null"><Ico Name="external" Size="16" /> Ouvrir dans @OpenIn</a> }
                                <button type="button" role="menuitem" class="danger" @onclick="() => { menuId = null; confirmId = folder.Id; }"><Ico Name="trash" Size="16" /> Retirer</button>
                            </div>
                        }
                    </div>
                    @if (confirmId == folder.Id)
                    {
                        <div class="cal-confirm" role="alert">
                            <span class="grow">@ConfirmText(contents)</span>
                            <button type="button" class="btn ghost sm" @onclick="() => confirmId = null">Annuler</button>
                            <button type="button" class="btn danger sm" @onclick="() => Remove(folder)">Retirer</button>
                        </div>
                    }
                </div>
            }
            @if (folders.Count == 0) { <div class="cal-empty">@(configured ? "Aucun dossier pour l'instant. Ajoutez le premier ci-dessous." : NotReady)</div> }
            <div class="dsd-add">
                <div class="dsd-add-line">
                    <button type="button" class="btn ghost sm" disabled="@(busy || !configured)" @onclick="() => picking = true"><Ico Name="folder" Size="14" /> Choisir un dossier…</button>
                    <button type="button" class="dsd-or" @onclick="() => pasteOpen = !pasteOpen">@(pasteOpen ? "masquer" : Def.PasteLabel)</button>
                </div>
                @if (pasteOpen)
                {
                    <div class="cal-add">
                        <input aria-label="Nom affiché" placeholder="Nom affiché (facultatif)" maxlength="80" @bind="newName" />
                        <input aria-label="@Def.PasteAria" class="mono" placeholder="@Def.LinkPlaceholder" @bind="newLink" spellcheck="false" autocomplete="off" />
                        <button type="button" class="btn ghost sm" disabled="@busy" @onclick="Add"><Ico Name="plus" Size="14" /> Ajouter</button>
                    </div>
                }
                <small>Les images et vidéos du dossier sont affichées, et celles de ses sous-dossiers si vous le demandez : @DriveService.MaxFiles fichiers au plus. Les dossiers sont synchronisés toutes les 15 minutes.</small>
            </div>
        </div>
    </div>
    <div class="modal-foot">
        @if (IsGoogle ? hasDrive : configured) { <button class="btn ghost" disabled="@busy" @onclick="Test">@(testing ? "Test en cours…" : "Tester la connexion")</button> }
        <button class="btn ghost" disabled="@(busy || folders.Count == 0)" @onclick="SyncAll"><Ico Name="refresh" Size="16" /> @(syncing ? "Synchronisation…" : "Synchroniser maintenant")</button>
        <span class="grow"></span>
        <button class="btn" @onclick="Close">Fermer</button>
    </div>
</div>

@if (picking)
{
    <DriveFolderPicker Source="@Source" Existing="@folders.Select(f => f.RemoteId).ToList()" OnPicked="Picked" OnClose="() => picking = false" />
}

@code {
    [Parameter, EditorRequired] public string Source { get; set; } = "";
    [Parameter] public EventCallback OnClose { get; set; }
    /// <summary>Connexion ou dossiers modifiés : la page Intégrations se met à jour.</summary>
    [Parameter] public EventCallback OnChanged { get; set; }
    /// <summary>« Voir le compte » : le compte Google ou Microsoft s'affiche dans Intégrations › Comptes connectés (connexion, accès, déconnexion).</summary>
    [Parameter] public EventCallback<string> OnShowAccount { get; set; }

    private DriveSourceDef Def => DriveSources.Find(Source)!;
    private bool IsGoogle => Source == "gdrive";   // sinon OneDrive et SharePoint : compte Microsoft connecté (« Se connecter avec Microsoft »), rien à saisir

    private bool configured, testing, syncing;   // configured : le compte connecté a l'accès aux fichiers (Drive ou OneDrive)
    private GoogleAuth.Connection google = new(false, "", null);
    private MicrosoftAuth.Connection ms = new(false, "", null);
    private bool hasDrive;   // le compte Google connecté a autorisé la lecture des fichiers Drive

    private string GoogleInitial => google.User.Length > 0 ? char.ToUpperInvariant(google.User[0]).ToString() : "G";
    private string MsInitial => ms.User.Length > 0 ? char.ToUpperInvariant(ms.User[0]).ToString() : "M";

    private string HeadLine => configured ? "Dossiers copiés dans la médiathèque et lus même hors ligne"
        : IsGoogle ? (GoogleAuth.IsConfigured ? "Connectez votre compte Google, puis ajoutez vos dossiers" : "Pas encore disponible sur cette plateforme")
        : Source == "dropbox" ? (DropboxAuth.IsConfigured ? "Connectez votre compte Dropbox, puis ajoutez vos dossiers" : "Pas encore disponible sur cette plateforme")
        : Source is "nextcloud" or "sftp" ? "Renseignez la connexion au serveur, puis ajoutez vos dossiers"
        : MsAuth.IsConfigured ? "Connectez votre compte Microsoft, puis ajoutez vos dossiers" : "Pas encore disponible sur cette plateforme";

    /// <summary>Pourquoi on ne peut pas encore ajouter de dossier.</summary>
    private string NotReady => Source switch
    {
        "gdrive" => GoogleAuth.IsConfigured ? "Connectez d'abord votre compte Google." : "Google Drive n'est pas encore disponible sur cette plateforme.",
        "dropbox" => DropboxAuth.IsConfigured ? "Connectez d'abord votre compte Dropbox." : "Dropbox n'est pas encore disponible sur cette plateforme.",
        "nextcloud" or "sftp" => "Renseignez d'abord la connexion au serveur.",
        _ => MsAuth.IsConfigured ? "Connectez d'abord votre compte Microsoft." : "OneDrive et SharePoint ne sont pas encore disponibles sur cette plateforme."
    };

    /// <summary>« Ouvrir dans … » : le service du dossier.</summary>
    private string OpenIn => Source switch { "gdrive" => "Google Drive", "onedrive" => "OneDrive", _ => Def.Name };
    private string dropboxUser = "";
    private bool dropboxLost;
    private bool busy => testing || syncing;
    private List<DriveFolder> folders = new();
    private Dictionary<string, (int Contents, int Lists)> uses = new();   // par dossier : contenus qui l'affichent, listes de lecture qui les contiennent
    private string newName = "", newLink = "", renameText = "";
    private Guid? confirmId, menuId, renameId, flashId;
    private bool picking, pasteOpen;   // sélecteur de dossier ouvert ; champ « lien de partage » affiché

    protected override void OnInitialized() => Load();

    private void Load()
    {
        var t = Store.Read(d => d.Tenant);
        configured = DriveSources.Configured(t, Source);
        google = GoogleAuth.ConnectionOf(t);
        ms = MicrosoftAuth.ConnectionOf(t);
        hasDrive = GoogleAuth.Has(t, GoogleAuth.DriveScope);
        dropboxUser = DriveSources.Account(t, "dropbox")?.User ?? "";
        dropboxLost = DriveSources.Account(t, "dropbox")?.LostUtc != null;
        folders = t.DriveFolders.Where(f => f.Source == Source).OrderBy(f => f.Name, StringComparer.CurrentCultureIgnoreCase).ToList();
        uses = Store.Read(d =>
        {
            var byFolder = d.Media.Where(m => m.AppId == "drive" && m.Settings.GetValueOrDefault("folder") is { Length: > 0 })
                .GroupBy(m => m.Settings["folder"]).ToDictionary(g => g.Key, g => g.Select(m => m.Id).ToHashSet());
            return byFolder.ToDictionary(kv => kv.Key, kv => (kv.Value.Count, d.Playlists.Count(p => p.Draft.Any(i => kv.Value.Contains(i.MediaId)))));
        });
    }

    private async Task Changed()
    {
        Load();
        await OnChanged.InvokeAsync();
    }

    private Task Close() => OnClose.InvokeAsync();

    private static string ConfirmText(int contents) => contents switch
    {
        0 => "Retirer ce dossier ? Ses fichiers quittent le serveur (rien n'est supprimé du Drive).",
        1 => "Utilisé par 1 contenu, qui n'affichera plus rien. Retirer ce dossier ?",
        _ => $"Utilisé par {contents} contenus, qui n'afficheront plus rien. Retirer ce dossier ?"
    };

    // ---------- Connexion ----------

    private async Task Test()
    {
        testing = true;
        StateHasChanged();
        try { Toast.Ok(await Drives.TestConnection(Store.Read(d => d.Tenant), Source)); }
        catch (Exception ex) when (ex is InvalidOperationException or HttpRequestException or System.Text.Json.JsonException or KeyNotFoundException or TaskCanceledException)
        {
            Toast.Error("Échec : " + ex.Message);
        }
        finally { testing = false; }
    }

    // ---------- Dossiers ----------

    /// <summary>Lien de partage collé : vérifié, puis ajouté comme un dossier choisi.</summary>
    private async Task Add()
    {
        if (!configured) { Toast.Error(NotReady); return; }
        var link = newLink.Trim();
        if (link.Length == 0) { Toast.Error(DriveSources.IsRemote(Source) ? "Saisissez le chemin du dossier." : "Collez le lien de partage du dossier."); return; }
        syncing = true;
        StateHasChanged();
        try
        {
            var (remoteId, name, location, web) = await Drives.Resolve(Store.Read(d => d.Tenant), Source, link);
            var display = newName.Trim().Length > 0 ? newName.Trim() : name;
            if (await AddFolder(new(remoteId, display, location, web, false))) newName = newLink = "";
        }
        catch (Exception ex) when (ex is InvalidOperationException or HttpRequestException or System.Text.Json.JsonException or KeyNotFoundException)
        {
            Toast.Error(ex.Message);
        }
        finally { syncing = false; }
    }

    /// <summary>Dossier choisi dans le sélecteur.</summary>
    private async Task Picked(DriveFolderPicker.Picked p)
    {
        picking = false;
        syncing = true;
        StateHasChanged();
        try { await AddFolder(p); }
        finally { syncing = false; }
    }

    /// <summary>Ajoute le dossier, active la source au besoin, puis le synchronise aussitôt. Rend false s'il était déjà là.</summary>
    private async Task<bool> AddFolder(DriveFolderPicker.Picked p)
    {
        var t = Store.Read(d => d.Tenant);
        if (t.DriveFolders.Any(f => f.Source == Source && DriveSources.SameRemote(Source, f.RemoteId, p.RemoteId))) { Toast.Error("Ce dossier est déjà dans la liste."); return false; }
        var folder = new DriveFolder
        {
            Source = Source, Name = p.Name.Length > 80 ? p.Name[..80] : p.Name, RemoteId = p.RemoteId,
            Location = p.Location, WebUrl = p.WebUrl, Subfolders = p.Subfolders
        };
        Store.Write(d => d.Tenant.DriveFolders.Add(folder));
        if (!DriveSources.Enabled(t, Source)) Svc.SetDriveSource(Source, true);
        flashId = folder.Id;
        await Changed();
        StateHasChanged();
        var error = await Drives.Sync(Store.ClientId, folder.Id);
        await Changed();
        var n = folders.FirstOrDefault(f => f.Id == folder.Id)?.FileCount ?? 0;
        if (error == null) Toast.Ok($"« {folder.Name} » ajouté{(folder.Subfolders ? " avec ses sous-dossiers" : "")} : {n} fichier{(n > 1 ? "s" : "")} synchronisé{(n > 1 ? "s" : "")}.");
        else Toast.Error($"« {folder.Name} » ajouté, mais la synchronisation a échoué : {error}");
        return true;
    }

    /// <summary>Inclut ou retire les sous-dossiers, puis resynchronise : les fichiers concernés arrivent ou partent des écrans.</summary>
    private async Task ToggleSubfolders(DriveFolder f)
    {
        menuId = null;
        var on = !f.Subfolders;
        Store.Write(d => { if (d.Tenant.DriveFolders.FirstOrDefault(x => x.Id == f.Id) is { } x) x.Subfolders = on; });
        syncing = true;
        await Changed();
        StateHasChanged();
        try
        {
            var error = await Drives.Sync(Store.ClientId, f.Id);
            await Changed();
            if (error != null) Toast.Error($"« {f.Name} » : {error}");
            else Toast.Ok(on ? $"« {f.Name} » : les images et vidéos des sous-dossiers sont ajoutées." : $"« {f.Name} » : seuls les fichiers du dossier lui-même restent affichés.");
        }
        finally { syncing = false; }
    }

    private void StartRename(DriveFolder f)
    {
        menuId = null;
        renameId = f.Id;
        renameText = f.Name;
    }

    private async Task OnRenameKey(KeyboardEventArgs e, DriveFolder f)
    {
        if (e.Key == "Enter") await Rename(f);
        else if (e.Key == "Escape") renameId = null;
    }

    private async Task Rename(DriveFolder f)
    {
        if (renameId != f.Id) return;
        renameId = null;
        var name = renameText.Trim();
        if (name.Length == 0 || name == f.Name) return;
        if (name.Length > 80) name = name[..80];
        Store.Write(d => { if (d.Tenant.DriveFolders.FirstOrDefault(x => x.Id == f.Id) is { } x) x.Name = name; });
        await Changed();
    }

    private async Task SyncAll()
    {
        syncing = true;
        StateHasChanged();
        try
        {
            var errors = new List<string>();
            foreach (var f in folders.ToList())
                if (await Drives.Sync(Store.ClientId, f.Id) is { } e) errors.Add($"« {f.Name} » : {e}");
            await Changed();
            if (errors.Count == 0) Toast.Ok("Dossiers synchronisés. Les écrans concernés se mettent à jour.");
            else Toast.Error(errors[0]);
        }
        finally { syncing = false; }
    }

    private async Task Remove(DriveFolder f)
    {
        confirmId = null;
        await Drives.RemoveFolder(Store.ClientId, f.Id);
        await Changed();
        Toast.Ok($"« {f.Name} » retiré des Drives.");
    }
}
