@* Partager un dossier de listes de lecture avec des personnes ou des niveaux de droits, en lecture ou en écriture (propriétaire seulement). *@
@inject PlaylistLibrary Library

<div class="modal-backdrop" @onclick="Close"></div>
<div class="modal app-modal sh-modal" role="dialog" aria-modal="true" aria-labelledby="pfs-title">
    @if (info is not { } i)
    {
        <h3 id="pfs-title">Dossier introuvable</h3>
        <div class="modal-actions"><button class="btn" @onclick="Close">Fermer</button></div>
    }
    else
    {
        <div class="modal-head">
            <h3 id="pfs-title">Partager « @i.Folder.Name »</h3>
            <span class="grow"></span>
            <button type="button" class="modal-x" aria-label="Fermer" @onclick="Close"><Ico Name="x" Size="20" /></button>
        </div>
        <div class="modal-body sh-body">
            @if (i.CanShare)
            {
                <div class="sh-add">
                    <Ico Name="user-plus" Size="16" />
                    <input type="text" autocomplete="off" placeholder="Ajouter une personne ou un niveau…" aria-label="Ajouter une personne ou un niveau"
                           @bind="query" @bind:event="oninput" @onfocus="() => open = true" @onblur="() => open = false" />
                    @if (open)
                    {
                        var people = PeopleToAdd.Where(Match).ToList();
                        var levels = LevelsToAdd.Where(Match).ToList();
                        <div class="sh-dd">
                            @if (people.Count == 0 && levels.Count == 0)
                            {
                                <div class="sh-none">Aucun résultat.</div>
                            }
                            @if (people.Count > 0) { <h5>Personnes</h5> }
                            @foreach (var p in people)
                            {
                                var c = p;
                                <button type="button" class="sh-opt" disabled="@(c.Reason != null)" @onmousedown='() => Add("user", c)' @onmousedown:preventDefault>
                                    <span class="sh-av">@Initials(c.Label)</span>
                                    <span class="grow"><b>@c.Label</b> <small>@(c.Reason ?? c.Detail)</small></span>
                                </button>
                            }
                            @if (levels.Count > 0) { <h5>Niveaux de droits</h5> }
                            @foreach (var l in levels)
                            {
                                var c = l;
                                <button type="button" class="sh-opt" @onmousedown='() => Add("level", c)' @onmousedown:preventDefault>
                                    <span class="sh-av lv"><Ico Name="shield" Size="14" /></span>
                                    <span class="grow"><b>@c.Label</b> <small>@c.Detail</small></span>
                                </button>
                            }
                        </div>
                    }
                </div>
            }
            else
            {
                <p class="sh-lead">Seul le propriétaire du dossier le partage, avec un niveau de droits qui le permet. Vous ne pouvez que voir les accès en place.</p>
            }

            @if (i.Shares.Count == 0)
            {
                <p class="sh-empty"><Ico Name="lock" Size="18" />Dossier privé : vous seul y avez accès.</p>
            }
            else
            {
                <div class="sh-list">
                    @foreach (var s in i.Shares)
                    {
                        var row = s;
                        <div class="sh-row">
                            @if (row.Kind == FolderShareKind.Level) { <span class="sh-av lv"><Ico Name="shield" Size="14" /></span> }
                            else { <span class="sh-av">@Initials(row.Label)</span> }
                            <span class="grow"><b>@row.Label</b><small>@(row.Kind == FolderShareKind.Level ? "Niveau de droits" : "Personne")</small></span>
                            @if (i.CanShare)
                            {
                                <div class="sh-seg" role="group" aria-label="Droit de @row.Label">
                                    <button type="button" class="@(row.Write ? "" : "on")" title="Lecture : voir et diffuser les listes." @onclick="() => ChangeMode(row, false)">Lecture</button>
                                    <button type="button" class="@(row.Write ? "on" : "")" title="Écriture : en plus, modifier, renommer, ranger et supprimer." @onclick="() => ChangeMode(row, true)">Écriture</button>
                                </div>
                                <button type="button" class="kebab-btn" aria-label="Retirer le partage de @row.Label" title="Retirer" @onclick="() => Remove(row)"><Ico Name="x" Size="16" /></button>
                            }
                            else
                            {
                                <span class="pill @(row.Write ? "ok" : "blue")">@(row.Write ? "Écriture" : "Lecture")</span>
                            }
                        </div>
                    }
                </div>
            }
            <p class="sh-lead">Le partage vaut pour les sous-dossiers. Un membre dont le niveau est en lecture seule garde la lecture, même avec un partage en écriture.</p>
            @if (error != null) { <div class="err">@error</div> }
        </div>
        <div class="modal-foot sh-foot">
            <span class="sh-total">
                @if (i.Shares.Count > 0)
                {
                    <Ico Name="users" Size="16" />
                    @if (i.Audience.Count == 0) { <text>Personne n'a encore accès : aucun membre ne correspond à ces partages.</text> }
                    else { <text>@i.Audience.Count personne@(i.Audience.Count > 1 ? "s" : "") y ont accès@(Breakdown(i.Audience))</text> }
                }
            </span>
            <button type="button" class="btn" @onclick="Close">Terminé</button>
        </div>
    }
</div>

@code {
    [Parameter] public Guid FolderId { get; set; }
    [Parameter] public EventCallback OnClose { get; set; }

    private PlaylistShareInfo? info;
    private string query = "";
    private bool open;
    private string? error;

    private bool Match(ShareCandidate c) => query.Length == 0 || c.Label.Contains(query, StringComparison.CurrentCultureIgnoreCase);
    private static string Initials(string label) => string.Concat(label.Split(' ', StringSplitOptions.RemoveEmptyEntries).Take(2).Select(w => char.ToUpperInvariant(w[0])));

    private void Add(string kind, ShareCandidate c)
    {
        if (c.Reason != null) return;
        error = Library.SetShare(FolderId, kind, c.Id, false);
        query = "";
        open = false;
        Reload();
    }


    private IEnumerable<ShareCandidate> PeopleToAdd => info == null ? Enumerable.Empty<ShareCandidate>()
        : info.People.Where(p => !info.Shares.Any(s => s.Kind == FolderShareKind.User && s.TargetId == p.Id));
    private IEnumerable<ShareCandidate> LevelsToAdd => info == null ? Enumerable.Empty<ShareCandidate>()
        : info.Levels.Where(l => !info.Shares.Any(s => s.Kind == FolderShareKind.Level && s.TargetId == l.Id));

    protected override void OnInitialized() => Reload();

    private void Reload() => info = Library.ShareInfo(FolderId);

    private void ChangeMode(ShareRow row, bool write)
    {
        error = Library.SetShare(FolderId, row.Kind, row.TargetId, write);
        Reload();
    }

    private void Remove(ShareRow row)
    {
        error = Library.SetShare(FolderId, row.Kind, row.TargetId, null);
        Reload();
    }

    // « 2 choisies une à une, 3 par le niveau « Éditeur » » : chaque personne n'est comptée qu'une fois
    private static string Breakdown(FolderAudience a)
    {
        var parts = new List<string>();
        if (a.Direct > 0) parts.Add($"{a.Direct} choisie{(a.Direct > 1 ? "s" : "")} une à une");
        foreach (var g in a.People.Where(p => p.LevelName != null).GroupBy(p => p.LevelName))
            parts.Add($"{g.Count()} par le niveau « {g.Key} »");
        return parts.Count == 0 ? "" : " : " + string.Join(", ", parts) + ".";
    }

    private Task Close() => OnClose.InvokeAsync();
}
