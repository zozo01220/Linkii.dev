@* Ce qu'une suppression de listes de lecture touche : écrans qui les ont choisies et créneaux de planning retirés (§51). *@
@if (Impact.Screens.Count == 0 && Impact.Slots.Count == 0)
{
    <p class="hint">Aucun écran ne les diffuse et aucun planning ne les programme.</p>
}
else
{
    <div class="lx-impact">
        @if (Impact.Screens.Count > 0)
        {
            <div>
                <Ico Name="monitor" Size="15" />
                <span class="grow"><b>@Impact.Screens.Count écran@(Impact.Screens.Count > 1 ? "s" : "")</b> : @Names(Impact.Screens)<br /><small>Ils gardent ce qu'ils diffusent jusqu'à leur prochaine publication, puis n'auront plus cette liste.</small></span>
            </div>
        }
        @if (Impact.Slots.Count > 0)
        {
            <div>
                <Ico Name="calendar" Size="15" />
                <span class="grow"><b>@Impact.Slots.Count créneau@(Impact.Slots.Count > 1 ? "x" : "") de planning</b> retiré@(Impact.Slots.Count > 1 ? "s" : "") :<br /><small>@string.Join(" ; ", Impact.Slots.Take(4))@(Impact.Slots.Count > 4 ? $" ; et {Impact.Slots.Count - 4} autre{(Impact.Slots.Count > 5 ? "s" : "")}" : "")</small></span>
            </div>
        }
    </div>
}

@code {
    [Parameter, EditorRequired] public PlaylistDeleteImpact Impact { get; set; } = default!;

    private static string Names(List<string> names) => string.Join(", ", names.Take(5)) + (names.Count > 5 ? $" et {names.Count - 5} autre{(names.Count > 6 ? "s" : "")}" : "");
}
