@inject PdfService Pdf
@inject TenantStore Store
@inject AppService Apps
@inject Toaster Toast

@* Création / modification d'une instance d'app : fenêtre de configuration standard de tous les contenus (voir DEV-POC.md,
   « Standard de configuration d'un contenu »). Réutilisé par la page d'édition et par l'assistant.
   Ligne 1 : la source (lien, fichiers, dossier, calendrier : champs « source » du manifeste) ;
   ligne 2, à gauche : l'aperçu (carrousel 3D dès plusieurs éléments) ; à droite : la configuration (champs « main ») ;
   les champs « advanced » sont dans la fenêtre « Options avancées » (icône du bandeau, voir OpenAdvanced). *@
@if (manifest == null)
{
    <div class="err">App introuvable.</div>
}
else if (!installed)
{
    <div class="dw-note">Cette app n'est pas activée pour votre espace. <a href="/integrations">Activez-la dans la page Intégrations</a>.</div>
}
else
{
    var sources = manifest.InZone("source").ToList();
    var hasPreview = ContentPreview.Has(manifest);
    var tabsUnder = ConfTabs != null && hasPreview;   // onglets sous l'aperçu ; sans aperçu, en tête de la colonne de droite
    <div class="ci">
        @* résultats de recherche, d'import, de test, erreurs : un bandeau collé en haut de la fenêtre, visible sans défilement *@
        @if (Banner() is { } bn)
        {
            <div class="ci-notice @bn.Kind" role="status" aria-live="polite">
                <span>@bn.Text</span>
                @if (!testing) { <button type="button" class="ci-notice-x" aria-label="Fermer le message" @onclick="ClearNotice"><Ico Name="x" Size="16" /></button> }
            </div>
        }
        @if (ShowActions)
        {
            @* page d'édition : pas de bandeau de fenêtre, la barre porte le nom (modifiable) et l'icône « Options avancées » *@
            <div class="ci-bar">
                <span class="ci-name" title="@name">@name</span>
                <button type="button" class="btn ghost sm icon" title="Renommer" aria-label="Renommer" @onclick="OpenRename"><Ico Name="edit" Size="15" /></button><span class="grow"></span>
                @if (manifest.HasAdvanced) { <button type="button" class="ci-gear" aria-label="Options avancées" title="Options avancées" @onclick="OpenAdvanced"><Ico Name="sliders" Size="20" /></button> }
            </div>
        }

        @if (sources.Count > 0 && !hasPreview)
        {
            <div class="ci-src">
                <div class="ci-src-row">
                    <AppForm Manifest="manifest" Values="values" StoredSecrets="storedSecrets" InstanceId="instance?.Id" Zone="source" OnChange="SourceChanged" />
                    @if (hasPreview && manifest.Provider != null && sources[0].Type is not ("calendar" or "mailbox"))
                    {
                        <button type="button" class="btn" @onclick="Search">Rechercher</button>
                    }
                </div>
            </div>
        }

        <div class="ci-cols @(hasPreview || OtherTab ? "" : "one")">
            @* colonne de gauche : aperçu, puis les onglets de l'appelant (« Contenu / QR code ») sous l'aperçu *@
            <div class="ci-left" hidden="@(!(hasPreview || OtherTab))">
            @* autre onglet de l'appelant (ex. « QR code ») : sa propre colonne d'aperçu ; l'aperçu du contenu est seulement masqué, il garde son état *@
            @if (OtherTab && OtherPreview != null)
            {
                <section class="ci-prev" aria-label="Aperçu de l'écran">@OtherPreview</section>
            }
            @if (hasPreview)
            {
                <section class="ci-prev" aria-label="Aperçu" hidden="@(OtherTab && OtherPreview != null)">
                    <h4 class="ci-t">Aperçu</h4>
                    @* La source (lien, fichier, dossier, calendrier…) se choisit dans l'aperçu : « + » tant que rien n'est choisi, puis bouton « Changer » sur l'aperçu. *@
                    @if (sourceOpen && sources.Count > 0)
                    {
                        <div class="ci-empty open">
                            <div class="ci-srccard">
                                <div class="ci-src-row">
                                    <AppForm Manifest="manifest" Values="values" StoredSecrets="storedSecrets" InstanceId="instance?.Id" Zone="source" OnChange="SourceChanged" AutoOpen="autoOpen" />
                                    @if (NeedsSearch(sources[0]))
                                    {
                                        <button type="button" class="btn" @onclick="Search">Rechercher</button>
                                    }
                                </div>
                                <button type="button" class="linklike ci-srcclose" @onclick="CloseSource">@(SourceReady ? "Terminé" : "Annuler")</button>
                            </div>
                        </div>
                    }
                    else if (!SourceReady && sources.Count > 0)
                    {
                        <div class="ci-empty">
                            <div class="ci-add">
                                <button type="button" class="ci-plus" aria-label="@AddTitle(sources[0])" @onclick="OpenSourceFromEmpty">+</button>
                                <b>@AddTitle(sources[0])</b>
                                <span>@AddHint(sources[0])</span>
                            </div>
                        </div>
                    }
                    <div class="ci-prevbody" hidden="@(sources.Count > 0 && (sourceOpen || !SourceReady))">
                        @if (sources.Count > 0 && SourceReady) { <button type="button" class="ci-chg" @onclick="OpenSource"><Ico Name="edit" Size="14" /> @ChangeLabel(sources[0])</button> }
                        <ContentPreview @ref="previewRef" Manifest="manifest" Values="values" Instance="instance" Qr="PreviewQr" Portrait="PreviewPortrait" Place="PreviewPlace" OnNotice="OnPreviewNotice" />
                    </div>
                </section>
            }
            @* onglets de l'appelant sous l'aperçu (ils restent à la même place quel que soit l'onglet) *@
            @if (tabsUnder) { @ConfTabs }
            </div>
            <section class="ci-conf" aria-label="Configuration">
                @* sans aperçu, les onglets restent en tête de la colonne de droite (même emplacement que « Écran / Widgets » de l'éditeur d'écran) *@
                @if (!tabsUnder) { @ConfTabs }
                @if (OtherTab) { @OtherPane }
                <div class="ci-conf-main" hidden="@OtherTab">
                    @if (ConfTabs == null || tabsUnder) { <h4 class="ci-t">Configuration</h4> }
                    <AppForm Manifest="manifest" Values="values" StoredSecrets="storedSecrets" InstanceId="instance?.Id" Zone="main" OnChange="Touch" />
                    @* réglages propres à l'appelant (ex. « Dans cette liste de lecture »), à droite de l'aperçu *@
                    @Extra
                </div>
            </section>
        </div>

        @if (ShowActions)
        {
            <div class="row" style="margin-top:14px">
                <button type="button" class="btn" @onclick="Save">@SaveLabel</button>
                @if (NeedsTestButton)
                {
                    <button type="button" class="btn ghost" disabled="@testing" @onclick="Test">@(testing ? "Test…" : "Tester")</button>
                }
                @if (OnCancel.HasDelegate) { <button type="button" class="linklike" @onclick="OnCancel">Annuler</button> }
            </div>
        }
    </div>

    @if (renaming)
    {
        <SectionContent SectionName="overlay">
            <div class="modal-backdrop picker-backdrop" @onclick="() => renaming = false"></div>
            <div class="modal app-modal ci-adv" role="dialog" aria-modal="true" aria-labelledby="ci-ren-title">
                <div class="modal-head">
                    <div class="grow"><h3 id="ci-ren-title">Renommer le contenu</h3><small>Le nom sous lequel vous le retrouverez dans la médiathèque et les listes de lecture.</small></div>
                    <button type="button" class="modal-x" aria-label="Fermer" @onclick="() => renaming = false"><Ico Name="x" Size="20" /></button>
                </div>
                <div class="modal-body">
                    <div class="dw"><div class="dw-field">
                        <label>Nom *</label>
                        <input type="text" maxlength="80" placeholder="@manifest.Name" @bind="renameDraft" @bind:event="oninput" @onkeydown="RenameKey" />
                    </div></div>
                </div>
                <div class="modal-foot">
                    <button type="button" class="btn ghost" @onclick="() => renaming = false">Annuler</button>
                    <button type="button" class="btn" @onclick="ApplyRename">Valider</button>
                </div>
            </div>
        </SectionContent>
    }

    @if (advanced)
    {
        @* rendu dans la mise en page (SectionOutlet « overlay ») : la fenêtre de l'app, centrée par transform, décalerait et rognerait celle-ci *@
        <SectionContent SectionName="overlay">
            <div class="modal-backdrop picker-backdrop" @onclick="CancelAdvanced"></div>
            <div class="modal app-modal ci-adv" role="dialog" aria-modal="true" aria-labelledby="ci-adv-title">
                <div class="modal-head">
                    <div class="grow"><h3 id="ci-adv-title">Options avancées</h3><small>@manifest.Name</small></div>
                    <button type="button" class="modal-x" aria-label="Fermer" @onclick="CancelAdvanced"><Ico Name="x" Size="20" /></button>
                </div>
                <div class="modal-body">
                    <AppForm Manifest="manifest" Values="values" StoredSecrets="storedSecrets" InstanceId="instance?.Id" Zone="advanced" OnChange="Touch" />
                </div>
                <div class="modal-foot">
                    <button type="button" class="btn ghost" @onclick="CancelAdvanced">Annuler</button>
                    <button type="button" class="btn" @onclick="ApplyAdvanced">Valider</button>
                </div>
            </div>
        </SectionContent>
    }
}

@code {
    [Parameter, EditorRequired] public string AppId { get; set; } = "";
    [Parameter] public Guid? InstanceId { get; set; }
    [Parameter] public string SaveLabel { get; set; } = "Enregistrer";
    [Parameter] public EventCallback<MediaItem> OnSaved { get; set; }
    [Parameter] public EventCallback OnCancel { get; set; }
    /// <summary>Le nom a été modifié (bouton « Éditer » du bandeau) : la fenêtre appelante met son titre à jour.</summary>
    [Parameter] public EventCallback<string> OnRenamed { get; set; }
    /// <summary>false : les boutons sont fournis par l'appelant (pied d'une fenêtre modale) via Save(), et l'icône « Options avancées » par son bandeau (OpenAdvanced).</summary>
    [Parameter] public bool ShowActions { get; set; } = true;

    private AppManifest? manifest;
    private MediaItem? instance;
    private Dictionary<string, string> values = new();
    private HashSet<string> storedSecrets = new();
    private string name = "";
    private List<string> errors = new();
    private bool installed, testing, advanced, renaming, converting;
    private string renameDraft = "";
    private ContentPreview? previewRef;
    private Dictionary<string, string>? advancedBackup;

    /// <summary>Le bouton « Tester » reste pour les apps à fournisseur qui n'ont pas d'aperçu (ex. météo) ; sinon l'aperçu fait le test.</summary>
    public static bool NeedsTest(AppManifest m) => m.Provider != null && !ContentPreview.Has(m);
    private bool NeedsTestButton => manifest != null && NeedsTest(manifest);

    protected override void OnInitialized()
    {
        manifest = Apps.Find(AppId);
        if (manifest == null) return;
        installed = InstanceId != null || Apps.IsInstalled(AppId);   // un contenu existant reste modifiable même si l'app a été désactivée
        if (InstanceId is { } id) instance = Apps.Instances(AppId).FirstOrDefault(m => m.Id == id);
        values = AppCatalog.WithDefaults(manifest, instance?.Settings);
        storedSecrets = instance?.Secrets.Keys.ToHashSet() ?? new();
        name = instance?.Name ?? manifest.Name;
    }

    private void Touch() { }   // une valeur a changé : le formulaire (donc l'aperçu) se redessine

    /// <summary>Cadrage de l'aperçu (réglage « fit » de l'app), comme l'onglet Contenu.</summary>
    public string PreviewFit => values.GetValueOrDefault("fit") == "cover" ? "cover" : "contain";

    /// <summary>Premier fichier choisi dans le formulaire (image de fond de l'aperçu du QR code, avant que le contenu soit créé).</summary>
    public MediaItem? PickedMedia()
    {
        if (manifest == null) return null;
        var ids = manifest.Settings.Where(f => f.IsMedia && AppCatalog.IsVisible(f, values))
            .SelectMany(f => AppField.MediaIds(values.GetValueOrDefault(f.Key))).ToList();
        return ids.Count == 0 ? null : Store.Read(d => d.Media.FirstOrDefault(x => x.Id == ids[0]));
    }

    // Source modifiée : un calendrier ou une Page Facebook (liste de choix) met l'aperçu à jour d'emblée ; un lien attend « Rechercher ».
    private async Task SourceChanged()
    {
        if (previewRef != null && manifest!.Provider != null && manifest.InZone("source").FirstOrDefault()?.Type is "calendar" or "mailbox" or "facebookpage"
            && !string.IsNullOrEmpty(values.GetValueOrDefault(manifest.InZone("source").First().Key)))
            await previewRef.Refresh();
        // première source choisie dans la carte ouverte par le « + » : l'aperçu prend la place (un lien attend « Rechercher »)
        if (sourceOpen && openedFromEmpty && manifest!.InZone("source").FirstOrDefault() is { } src && !NeedsSearch(src) && SourceFilled) CloseSource();
    }

    private async Task Search()
    {
        errors = new();
        if (previewRef == null) return;
        await previewRef.Refresh();
        if (previewRef.Succeeded) CloseSource();
    }

    // ---------- La source dans l'aperçu ----------
    private bool sourceOpen, openedFromEmpty, autoOpen;

    private bool SourceFilled => manifest!.InZone("source").FirstOrDefault() is { } s && !string.IsNullOrEmpty(values.GetValueOrDefault(s.Key));

    /// <summary>Source prête : l'aperçu peut s'afficher. Un lien (YouTube, flux, page web) l'est une fois recherché, ou déjà enregistré.</summary>
    private bool SourceReady => SourceFilled && (!NeedsSearch(manifest!.InZone("source").First()) || instance != null || previewRef?.Succeeded == true);

    /// <summary>Un lien ou une adresse : il faut cliquer « Rechercher » (les listes de choix et les fichiers mettent l'aperçu à jour d'emblée).</summary>
    private bool NeedsSearch(AppField src) => manifest!.Provider != null && src.Type is not ("calendar" or "mailbox" or "facebookpage" or "drive" or "media" or "medias" or "gfile" or "pdf" or "canva");

    private void OpenSourceFromEmpty() { openedFromEmpty = true; autoOpen = true; sourceOpen = true; }
    private void OpenSource() { openedFromEmpty = false; autoOpen = false; sourceOpen = true; }
    private void CloseSource() { sourceOpen = false; openedFromEmpty = false; autoOpen = false; }

    private static string AddTitle(AppField s) => s.Type switch
    {
        "media" => s.Accept == "video" ? "Choisir une vidéo" : "Choisir une image",
        "medias" => s.Accept == "video" ? "Ajouter des vidéos" : "Ajouter des images",
        "gfile" => s.Accept switch { "document" => "Choisir un document", "powerpoint" => "Choisir une présentation PowerPoint", _ => "Choisir une présentation" },
        "pdf" => "Ajouter un fichier PDF",
        "canva" => "Choisir un design Canva",
        "drive" => "Choisir un dossier",
        "calendar" => "Choisir un calendrier",
        "mailbox" => "Choisir une salle",
        "facebookpage" => "Choisir une Page Facebook",
        "city" => "Choisir une ville",
        _ => "Ajouter le lien"
    };

    private static string AddHint(AppField s) => s.Type switch
    {
        "media" or "medias" => "Depuis la médiathèque, ou en important un fichier.",
        "gfile" => "Depuis votre Drive : le fichier est converti en images.",
        "pdf" => "Chaque page est convertie en image.",
        "canva" => "Chaque page du design devient une image.",
        "drive" => "Les fichiers du dossier sont diffusés.",
        "city" => "Saisissez le nom d'une ville : sa météo s'affiche aussitôt.",
        _ => s.Help ?? s.Label
    };

    private static string ChangeLabel(AppField s) => s.Type switch
    {
        "media" => "Remplacer",
        "medias" => "Modifier la sélection",
        "gfile" => "Changer de fichier",
        "pdf" => "Remplacer le PDF",
        "canva" => "Changer de design",
        "drive" => "Changer de dossier",
        "calendar" => "Changer de calendrier",
        "mailbox" => "Changer de salle",
        "facebookpage" => "Changer de Page",
        "city" => "Changer de ville",
        _ => "Modifier le lien"
    };

    /// <summary>Réglages de l'appelant, affichés sous la configuration (colonne de droite).</summary>
    [Parameter] public RenderFragment? Extra { get; set; }

    /// <summary>Onglets de l'appelant, en tête de la colonne de droite. Le premier onglet est la configuration de l'app.</summary>
    [Parameter] public RenderFragment? ConfTabs { get; set; }
    /// <summary>Un autre onglet est affiché : sa colonne de droite (<see cref="OtherPane"/>) remplace la configuration, masquée sans perdre l'état du formulaire.</summary>
    [Parameter] public bool OtherTab { get; set; }
    [Parameter] public RenderFragment? OtherPane { get; set; }
    /// <summary>Colonne de gauche de l'autre onglet (à la place de l'aperçu du contenu).</summary>
    [Parameter] public RenderFragment? OtherPreview { get; set; }
    /// <summary>QR code de comptage des scans, dessiné sur l'aperçu du contenu.</summary>
    [Parameter] public PublishedQr? PreviewQr { get; set; }
    /// <summary>L'aperçu reproduit un écran portrait (carrousel et image debout).</summary>
    [Parameter] public bool PreviewPortrait { get; set; }
    /// <summary>Position choisie dans la liste de lecture (full, top-left…) : l'aperçu de la Météo la reproduit.</summary>
    [Parameter] public string PreviewPlace { get; set; } = "full";

    // Résultat de la recherche, du test ou du dossier : une notification (toast) comme partout dans l'app, qui disparaît seule.
    private Task OnPreviewNotice((string Kind, string Text) n) { Notify(n.Kind != "bad", n.Text); return Task.CompletedTask; }

    private void Notify(bool ok, string text) { if (ok) Toast.Ok(text); else Toast.Error(text); }

    private void ClearNotice() { errors = new(); }

    // Le bandeau ne garde que les états en cours (« Test en cours… ») ; les erreurs de saisie passent par la notification (toast), sans doublon.
    private (string Kind, string Text)? Banner()
    {
        if (testing) return ("info", "Test en cours…");
        if (converting) return ("info", "Conversion du PDF…");
        return null;
    }

    /// <summary>Nom du contenu (le nom n'est plus un champ de la configuration : il se modifie par le bouton « Éditer » du bandeau).</summary>
    public string Name => name;

    /// <summary>Ouvre la petite fenêtre « Renommer » (bouton du bandeau).</summary>
    public void OpenRename() { renameDraft = name; renaming = true; }

    private async Task ApplyRename()
    {
        if (!string.IsNullOrWhiteSpace(renameDraft)) { name = renameDraft.Trim(); await OnRenamed.InvokeAsync(name); }
        renaming = false;
    }

    private async Task RenameKey(KeyboardEventArgs e)
    {
        if (e.Key == "Enter") await ApplyRename();
        else if (e.Key == "Escape") renaming = false;
    }

    /// <summary>Ouvre la fenêtre « Options avancées » (icône du bandeau).</summary>
    public void OpenAdvanced()
    {
        if (manifest == null || !manifest.HasAdvanced) return;
        advancedBackup = manifest.InZone("advanced").ToDictionary(f => f.Key, f => values.GetValueOrDefault(f.Key) ?? "");
        advanced = true;
    }

    // Valider les options avancées. Document PDF, Google Slides, Google Docs et Microsoft PowerPoint : les pages à afficher et le fond sont appliqués à la conversion, le PDF gardé est donc converti à nouveau.
    private async Task ApplyAdvanced()
    {
        advanced = false;
        if (manifest?.Id != "pdf" && !CloudFileKind.IsCloudApp(manifest?.Id) || advancedBackup == null) return;
        if (!PdfService.RenderKeys.Any(k => (advancedBackup.GetValueOrDefault(k) ?? "") != (values.GetValueOrDefault(k) ?? ""))) return;
        if (PdfService.SourceOf(values) is not { } source) return;   // pas encore de PDF : les réglages serviront à la première conversion
        converting = true; StateHasChanged();
        try
        {
            var res = await Pdf.Convert(Store.ClientId, Store.AreaId, source, PdfService.Options.From(values));
            if (res.Error != null)
            {
                foreach (var k in PdfService.RenderKeys) if (advancedBackup.TryGetValue(k, out var old)) values[k] = old;   // réglages précédents conservés
                Toast.Error(res.Error);
                return;
            }
            PdfService.Apply(values, source, res);
            Toast.Ok(res.Truncated ? $"PDF converti : {res.Selected} premières pages sur {source.Pages}." : $"PDF converti : {res.Selected} page{(res.Selected > 1 ? "s" : "")}.");
        }
        finally { converting = false; }
    }

    private void CancelAdvanced()
    {
        if (advancedBackup != null) foreach (var (k, v) in advancedBackup) values[k] = v;
        advanced = false;
    }

    public async Task Save()
    {
        errors = new();
        var (item, errs) = Apps.SaveInstance(AppId, instance?.Id, name, values);
        if (item == null) { errors = errs; Toast.Error(errs.Count > 1 ? $"{errs.Count} champs à corriger : {string.Join(" · ", errs)}" : errs.FirstOrDefault()); return; }
        instance = item;
        storedSecrets = item.Secrets.Keys.ToHashSet();
        foreach (var f in manifest!.Settings.Where(f => f.IsSecret)) values[f.Key] = "";   // un secret saisi n'est jamais réaffiché
        await OnSaved.InvokeAsync(item);
    }

    public async Task Test()
    {
        errors = new(); testing = true; StateHasChanged();
        try { var r = await Apps.Test(manifest!, values, instance); Notify(r.Ok, r.Message); }
        finally { testing = false; }
    }
}
