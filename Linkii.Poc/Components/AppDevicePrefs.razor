@using Microsoft.JSInterop
@inject Toaster Toast
@inject IJSRuntime JS

@* Réglages de l'application Android : verrouillage biométrique (par appareil). Les notifications se règlent pour l'organisation, dans Alertes et pause. *@

@if (inApp)
{
    <div class="rg-card">
        <header><h3>Verrouillage de l'application</h3><small>Cet appareil</small></header>
        <div class="sv-row"><div class="t"><b>Empreinte, visage ou code de l'appareil</b>
            <small>Demandé à l'ouverture de l'application Linkivi et à chaque retour après 30 secondes d'absence.</small>
            @if (!bioAvailable) { <small style="color:var(--warn-ink)">Indisponible sur cet appareil : il faut Android 11 ou plus et un verrouillage d'écran (code, schéma, empreinte ou visage) configuré dans les réglages du téléphone.</small> }</div>
            <div class="ctl"><button type="button" class="switch @(bioOn ? "on" : "")" role="switch" aria-checked="@(bioOn ? "true" : "false")" aria-label="Verrouiller l'application" disabled="@(!bioAvailable)" @onclick="ToggleBio"><span></span></button></div></div>
    </div>
}

@code {
    private bool inApp, bioAvailable, bioOn;

    // Verrouillage biométrique : proposé seulement dans l'application Android.
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender) return;
        try
        {
            inApp = await JS.InvokeAsync<bool>("linkiiBio.inApp");
            bioAvailable = inApp && await JS.InvokeAsync<bool>("linkiiBio.available");
            if (bioAvailable) bioOn = await JS.InvokeAsync<bool>("linkiiBio.enabled");
            StateHasChanged();
        }
        catch (JSException) { }
        catch (InvalidOperationException) { }   // rendu statique ou circuit fermé
    }

    private async Task ToggleBio()
    {
        try { await JS.InvokeVoidAsync("linkiiBio.set", !bioOn); bioOn = await JS.InvokeAsync<bool>("linkiiBio.enabled"); }
        catch (JSException) { return; }
        Toast.Ok(bioOn ? "Verrouillage activé sur cet appareil." : "Verrouillage désactivé.");
    }
}
