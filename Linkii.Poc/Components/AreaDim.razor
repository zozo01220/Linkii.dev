@inject TenantStore Store
@inject Notifier Notifier
@inject Toaster Toast

@* Luminosité et contraste d'une aire : réglage par défaut de ses écrans Android, selon l'heure (chacun peut le remplacer). Voir Dim. *@
@if (loaded)
{
    <div class="sv-row" style="padding-top:0">
        <div class="t"><b>Adapter l'image selon l'heure</b><small>Désactivé : l'image est affichée telle quelle, sans réglage.</small></div>
        <div class="ctl"><button type="button" class="switch @(on ? "on" : "")" role="switch" aria-checked="@(on ? "true" : "false")" aria-label="Adapter l'image selon l'heure" @onclick="Toggle"><span></span></button></div>
    </div>
    @if (on)
    {
        <DimEditor @bind-Plan="plan" Asleep="@asleep" />
        <p class="hint" style="margin:10px 0 0">Les heures sont celles du fuseau de l'aire (voir Mise en veille, à défaut celui de l'organisation). Seuls les écrans de l'app Android sont concernés.</p>
    }
    <div style="margin-top:14px"><button type="button" class="btn" @onclick="Save">Enregistrer la luminosité</button></div>
}

@code {
    [Parameter, EditorRequired] public Guid AreaId { get; set; }
    /// <summary>Appelé après l'enregistrement (la page appelante se met à jour).</summary>
    [Parameter] public EventCallback OnSaved { get; set; }

    private bool loaded, on;
    private DimPlan? plan;
    private string? asleep;

    protected override void OnInitialized()
    {
        var (saved, sleepGrid, sleepOn) = Store.Read(d =>
        {
            var a = d.Areas.FirstOrDefault(x => x.Id == AreaId);
            return (a?.Dimming?.Clone(), a?.SleepGrid, d.Tenant.SleepEnabled);
        });
        on = Dim.Valid(saved);
        plan = on ? saved : Dim.Suggested();
        asleep = sleepOn && Sleep.Any(sleepGrid) ? sleepGrid : null;
        loaded = true;
    }

    private void Toggle() => on = !on;

    private async Task Save()
    {
        var p = on && Dim.Valid(plan) ? plan!.Clone() : null;
        if (on && p == null) { Toast.Error("Réglage invalide : vérifiez les profils."); return; }
        Store.Write(d =>
        {
            if (d.Areas.FirstOrDefault(a => a.Id == AreaId) is { } a) a.Dimming = p;
        });
        await Notifier.NotifyArea(AreaId);   // les écrans de l'aire rechargent leur configuration
        Toast.Ok("Luminosité et contraste enregistrés.");
        await OnSaved.InvokeAsync();
    }
}
