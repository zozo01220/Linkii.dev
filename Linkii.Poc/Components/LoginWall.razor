@* Mur d'écrans vivant de la page de connexion (maquette login-mur-ecrans.html) : décor seulement, animé en CSS ;
   login-wall.js met l'horloge à l'heure, fait suivre la souris au mur et lance la vague de confirmation à l'envoi du formulaire. *@
<section class="lw-stage" aria-hidden="true">
    <div class="lw-halo"></div>
    <div class="lw-pitch">
        <small><span class="lw-live"></span>En direct sur vos écrans</small>
        <h2>Informez tout le monde,<br><em>en 30 secondes.</em></h2>
        <p>Publiez un message et affichez-le en temps réel sur tous vos écrans, des alertes urgentes aux horaires du jour.</p>
    </div>

    <div class="lw-wall">
        <div class="lw-scr lw-tall" style="--i:0"><div class="lw-view">
            <div class="lw-s lw-agenda"><span class="lw-k">Aujourd'hui</span><div class="lw-big">Au programme</div>
                <ul><li><b>09:00</b>Accueil des nouveaux</li><li><b>11:30</b>Point d'équipe</li><li><b>14:00</b>Visite guidée</li><li><b>16:30</b>Atelier ouvert à tous</li><li><b>18:00</b>Verre de l'amitié</li></ul></div>
            <div class="lw-s lw-qr"><span class="lw-k">Programme complet</span>
                <svg viewBox="0 0 21 21" shape-rendering="crispEdges" fill="#0B1F3A"><path d="M0 0h7v7H0zM1 1v5h5V1zM2 2h3v3H2zM14 0h7v7h-7zM15 1v5h5V1zM16 2h3v3h-3zM0 14h7v7H0zM1 15v5h5v-5zM2 16h3v3H2z" fill-rule="evenodd" /><path d="M9 0h1v2H9zM11 1h2v1h-2zM8 3h2v1H8zM11 3h1v3h-1zM9 5h1v2H9zM0 8h2v1H0zM3 8h1v2H3zM5 9h3v1H5zM9 8h2v2H9zM12 8h1v1h-1zM14 8h2v1h-2zM17 9h1v2h-1zM19 8h2v1h-2zM0 11h1v2H0zM2 11h3v1H2zM6 11h1v2H6zM8 11h2v1H8zM11 10h2v2h-2zM14 11h2v2h-2zM19 11h2v1h-2zM9 13h2v2H9zM12 13h1v3h-1zM14 14h1v1h-1zM16 14h2v2h-2zM19 13h1v3h-1zM8 16h1v3H8zM10 17h2v1h-2zM14 17h1v2h-1zM16 18h3v1h-3zM20 17h1v2h-1zM9 20h3v1H9zM13 20h2v1h-2zM17 20h2v1h-2z" /></svg>
                <p>Scannez<br>avec votre téléphone</p></div>
            <div class="lw-ok"><svg viewBox="0 0 24 24"><path d="M5 12.5l4.5 4.5L19 7.5" /></svg></div>
        </div></div>

        <div class="lw-scr" style="--i:1"><div class="lw-view">
            <div class="lw-s lw-welcome"><span class="lw-k">Hall d'accueil</span><div class="lw-mt"><div class="lw-big">Bienvenue</div><p>Journée portes ouvertes · samedi dès 10 h</p></div></div>
            <div class="lw-s lw-photo"><span class="lw-sun"></span><span class="lw-k">À ne pas manquer</span><div class="lw-mt"><div class="lw-big">Visite guidée</div><p>Départ à 14 h devant l'entrée</p></div></div>
            <div class="lw-ok"><svg viewBox="0 0 24 24"><path d="M5 12.5l4.5 4.5L19 7.5" /></svg></div>
        </div></div>

        <div class="lw-scr" style="--i:2"><div class="lw-view">
            <div class="lw-s lw-clock"><div class="lw-t"><span data-lw-hh>10</span><i>:</i><span data-lw-mm>24</span></div><div class="lw-d" data-lw-date></div></div>
            <div class="lw-s lw-meteo"><span class="lw-k">Météo</span><div class="lw-row"><svg viewBox="0 0 48 48" fill="none" stroke="#fff" stroke-width="3" stroke-linecap="round"><circle cx="24" cy="24" r="9" fill="#FFE08A" stroke="none" /><path d="M24 4v6M24 38v6M4 24h6M38 24h6M10 10l4 4M34 34l4 4M38 10l-4 4M14 34l-4 4" /></svg><div class="lw-big">18°</div></div><div class="lw-days lw-mt"><span>Sam. 16°</span><span>Dim. 14°</span><span>Lun. 17°</span></div></div>
            <div class="lw-ok"><svg viewBox="0 0 24 24"><path d="M5 12.5l4.5 4.5L19 7.5" /></svg></div>
        </div></div>

        <div class="lw-scr" style="--i:3"><div class="lw-view">
            <div class="lw-s lw-chart"><span class="lw-k">Visiteurs cette semaine</span><div class="lw-big">1 248</div>
                <div class="lw-bars"><i style="--h:42%;--n:0"></i><i style="--h:58%;--n:1"></i><i style="--h:50%;--n:2"></i><i style="--h:76%;--n:3"></i><i style="--h:66%;--n:4"></i><i style="--h:100%;--n:5"></i><i style="--h:84%;--n:6"></i></div></div>
            <div class="lw-s lw-goal"><div class="lw-ring"><b><span>82 %</span></b></div><div><span class="lw-k">Objectif du mois</span><div class="lw-big">Presque !</div><p>Encore 18 % et c'est gagné.</p></div></div>
            <div class="lw-ok"><svg viewBox="0 0 24 24"><path d="M5 12.5l4.5 4.5L19 7.5" /></svg></div>
        </div></div>

        <div class="lw-scr" style="--i:4"><div class="lw-view">
            <div class="lw-s lw-room"><span class="lw-k">Salle Horizon</span><div class="lw-big">Libre</div><p>jusqu'à 14:00</p><div class="lw-bar"><span>Ensuite · Comité de projet</span><span>14:00 – 15:30</span></div></div>
            <div class="lw-s lw-info"><span class="lw-k">Information</span><div class="lw-big">Exercice d'évacuation</div><p>Mardi à 9 h · suivez les consignes affichées</p></div>
            <div class="lw-ok"><svg viewBox="0 0 24 24"><path d="M5 12.5l4.5 4.5L19 7.5" /></svg></div>
        </div></div>
    </div>

    @* Bandeau d'état : la liste est doublée pour défiler sans couture *@
    <div class="lw-ticker"><div>
        @for (var pass = 0; pass < 2; pass++)
        {
            foreach (var n in Names) { <span>@n · en ligne</span> }
        }
    </div></div>
</section>

@code {
    private static readonly string[] Names = { "Hall d'accueil", "Cafétéria", "Salle Horizon", "Couloir 2e étage", "Entrée nord", "Vitrine", "Salle de pause", "Réception" };
}
