@* Pastille d'un plan : icône + couleur propres à chaque plan (Essential éclair, Pro couronne, Enterprise immeuble). Une seule définition pour toute l'app. *@
<span class="plan-chip @Cls" title="@Title"><Ico Name="@IconName" Size="@Size" />@Text</span>

@code {
    /// <summary>Plans.Base, Plans.Growth ou "enterprise".</summary>
    [Parameter] public string? Plan { get; set; }
    [Parameter] public int Size { get; set; } = 13;
    [Parameter] public string? Title { get; set; }

    public const string Enterprise = "enterprise";

    private string Cls => Plan == Plans.Growth ? "pro" : Plan == Enterprise ? "ent" : "ess";
    private string IconName => Plan == Plans.Growth ? "crown" : Plan == Enterprise ? "office" : "bolt";
    private string Text => Plan == Enterprise ? "Enterprise" : Plans.Label(Plan);
}
