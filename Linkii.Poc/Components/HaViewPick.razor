@inject NavigationManager Nav
@inject TenantStore Store

@* Champ « affichage » (§200, renommé au §202) : un des affichages du plan choisi juste au-dessus (réglage planId) : Diffusion, Borne, Compact…
   Contenu « Vue du bâtiment » : obligatoire. Widget « Plan du bâtiment » : facultatif, « Auto » garde les réglages propres du widget.
   Un plan sans affichage reçoit ceux proposés d'office. Les affichages se règlent dans Contenus › Plans › (le plan) › Affichages. *@
@if (plan == null)
{
    <div class="dw-note">Choisissez d'abord un plan.</div>
}
else
{
    <select @bind="Values[Field.Key]" @bind:after="Changed">
        @if (Field.Required) { <option value="">— Choisir un affichage —</option> }
        else { <option value="">Auto : selon la taille de la case</option> }
        @foreach (var v in plan.Views)
        {
            <option value="@v.Id">@v.Name · @HaViews.ModeLabel(v.Mode).ToLowerInvariant()</option>
        }
        @if (Values[Field.Key].Length > 0 && plan.Views.All(v => v.Id.ToString() != Values[Field.Key])) { <option value="@Values[Field.Key]">Affichage supprimé</option> }
    </select>
    @if (Current is { Mode: "interactive" })
    {
        <small>Borne : à ouvrir depuis une borne (tuile ou liste interactive). Sur un écran sans toucher, le plan s'affiche sans commande.</small>
    }
    else
    {
        <small>Un affichage manque ou doit changer ? <a href="/plans/@(plan.Id)?onglet=affichages&back=@(Uri.EscapeDataString("/" + Nav.ToBaseRelativePath(Nav.Uri)))">Réglez les affichages du plan</a>.</small>
    }
}

@code {
    [Parameter, EditorRequired] public AppField Field { get; set; } = default!;
    [Parameter, EditorRequired] public Dictionary<string, string> Values { get; set; } = default!;
    [Parameter] public EventCallback OnChange { get; set; }

    private HaPlan? plan;
    private string planKey = "";
    private HaPlanView? Current => plan?.Views.FirstOrDefault(v => v.Id.ToString() == Values.GetValueOrDefault(Field.Key));

    protected override void OnParametersSet()
    {
        Values.TryAdd(Field.Key, "");
        var pid = Values.GetValueOrDefault("planId") ?? "";
        if (pid == planKey) return;
        planKey = pid;
        plan = null;
        if (!Guid.TryParse(pid, out var id)) return;
        // un plan sans affichage reçoit ceux proposés d'office
        plan = Store.Write<HaPlan?>(d => { var p = d.Tenant.HaPlans.FirstOrDefault(x => x.Id == id); if (p == null) return null; HaViews.Ensure(p); return new HaPlan { Id = p.Id, Name = p.Name, Views = p.Views.ToList() }; });
        if (plan != null && plan.Views.All(v => v.Id.ToString() != Values[Field.Key]))
            Values[Field.Key] = Field.Required ? plan.Views.FirstOrDefault()?.Id.ToString() ?? "" : "";   // plan changé : sa première vue (contenu) ou « Auto » (widget)
    }

    private Task Changed() => OnChange.InvokeAsync();
}
