@using Microsoft.JSInterop
@inject IJSRuntime JS
@inject TenantStore Store
@inject MenuBadges Badges
@* Rebond de ce qui est nouveau (§116, §125). Deux façons de savoir ce qui est nouveau :
   - Family (pages Écrans, Listes de lecture, Médiathèque, Compositions) : c'est le serveur (MenuBadges) qui le sait, le même que celui des pastilles rouges du menu
     et des onglets. À chaque affichage d'un onglet (Tab), ce qui y était nouveau (partagé avec la personne, ajouté par un collègue) est marqué lu et rebondit.
     Ids ne sert qu'à repérer qu'un élément est arrivé ou parti de la page, pour relire.
   - Kind (autres pages) : la liste complète des éléments de la page (avant filtres) est comparée à celle de la dernière visite de cette personne, dans cette aire
     (wwwroot/newitems.js, mémoire du navigateur). La première visite d'une liste sert de point de départ : rien ne rebondit.
   Ce qui est nouveau reçoit la classe « landed » : même rebond que les imports de la médiathèque (§113). Les éléments se repèrent par data-nid="identifiant".
   Via : identifiant -> élément à faire rebondir quand l'élément lui-même n'est pas à l'écran (ex. un média rangé dans un dossier de la vue). *@

@code {
    /// <summary>Famille d'éléments (« media », « folder », « screen », « playlist »…) : une mémoire par famille, dans le navigateur. Vide avec <see cref="Family"/>.</summary>
    [Parameter] public string Kind { get; set; } = "";
    /// <summary>Famille suivie par le serveur (voir MenuBadges) : « screens », « playlists », « media », « compositions ».</summary>
    [Parameter] public string? Family { get; set; }
    /// <summary>Onglet affiché (« mine », « shared », « all »), avec <see cref="Family"/> : ce qui est nouveau dans cet onglet est lu.</summary>
    [Parameter] public string? Tab { get; set; }
    /// <summary>Tous les éléments de la famille que la personne voit sur cette page, sans filtre de recherche ni de dossier.</summary>
    [Parameter] public IEnumerable<Guid> Ids { get; set; } = Array.Empty<Guid>();
    /// <summary>Même chose pour les éléments identifiés par un texte (intégrations du catalogue).</summary>
    [Parameter] public IEnumerable<string>? Keys { get; set; }
    [Parameter] public IReadOnlyDictionary<Guid, Guid>? Via { get; set; }

    private string? sig;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        var list = Ids.Select(i => i.ToString()).Concat(Keys ?? Array.Empty<string>()).ToArray();
        var h = new HashCode();
        foreach (var i in list) h.Add(i);
        var s = list.Length + ":" + h.ToHashCode() + ":" + Tab;
        if (s == sig) return;
        sig = s;
        try
        {
            if (Family != null)
            {
                var fresh = Badges.View(Family, Tab);
                if (fresh.Count > 0)
                    await JS.InvokeVoidAsync("linkiiNew.play", fresh.Select(i => i.ToString()).ToArray(), Via?.ToDictionary(p => p.Key.ToString(), p => p.Value.ToString()));
                return;
            }
            var scope = $"{Store.ClientId:N}:{Store.UserId?.ToString("N") ?? "-"}:{Store.AreaId?.ToString("N") ?? "-"}";
            await JS.InvokeVoidAsync("linkiiNew.mark", scope, Kind, list, Via?.ToDictionary(p => p.Key.ToString(), p => p.Value.ToString()));
        }
        catch (JSException) { }
        catch (InvalidOperationException) { }
        catch (JSDisconnectedException) { }
        catch (TaskCanceledException) { }
    }
}
