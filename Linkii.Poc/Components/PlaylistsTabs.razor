@* Les deux familles de la page « Listes de lecture » : les boucles de contenus, et les listes interactives des bornes tactiles (§168). *@
<nav class="tabs int-tabs il-tabs" aria-label="Type de liste">
    <a href="/playlists" class="@(Active == "playlists" ? "on" : "")" aria-current="@(Active == "playlists" ? "page" : null)">Listes de lecture</a>
    <a href="/interactive-lists" class="@(Active == "interactive" ? "on" : "")" aria-current="@(Active == "interactive" ? "page" : null)">Listes interactives</a>
</nav>

@code {
    [Parameter] public string Active { get; set; } = "playlists";
}
