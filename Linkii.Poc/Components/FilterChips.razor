@* Filtres actifs d'une barre d'outils, en puces qu'on retire d'un clic, avec « Tout effacer » (rien tant qu'aucun filtre n'est actif). *@
@if (Items.Count > 0)
{
    <div class="fc" role="group" aria-label="Filtres actifs">
        @foreach (var g in Items)
        {
            var grp = g;
            <span class="fc-chip">@grp.Title : @grp.Options.First(o => o.Value == grp.Value).Label
                <button type="button" aria-label="Retirer le filtre @grp.Title" @onclick="() => OnClear.InvokeAsync(grp.Key)"><Ico Name="x" Size="12" /></button></span>
        }
        @foreach (var x in Extra)
        {
            var ex = x;
            <span class="fc-chip">@ex.Label <button type="button" aria-label="Retirer : @ex.Label" @onclick="() => ex.Clear()"><Ico Name="x" Size="12" /></button></span>
        }
        <button type="button" class="linklike" @onclick="OnResetAll">Tout effacer</button>
    </div>
}

@code {
    [Parameter, EditorRequired] public IReadOnlyList<FilterGroup> Groups { get; set; } = Array.Empty<FilterGroup>();
    [Parameter] public IReadOnlyList<FilterExtra> Extra { get; set; } = Array.Empty<FilterExtra>();
    [Parameter] public EventCallback<string> OnClear { get; set; }
    [Parameter] public EventCallback OnResetAll { get; set; }

    private List<FilterGroup> Items => Groups.Where(g => g.Value != "" && g.Options.Any(o => o.Value == g.Value)).ToList();
}
