@inject TenantStore Store
@inject DriveService Drives
@inject AppService Svc
@inject AccountManager Accounts
@inject GoogleAuth GoogleAuth
@inject MicrosoftAuth MsAuth
@inject DropboxAuth DropboxAuth
@implements IDisposable

@* Applications › Drives : assistant d'ajout, dans un tiroir du haut (maquette canva-assistant-ajout.html).
   1. Connexion du compte (OneDrive et SharePoint, Google Drive, Dropbox : « Se connecter avec… » ; Nextcloud et SFTP : adresse et identifiants) ;
   2. choix des dossiers en parcourant le compte, avec l'aperçu de leurs fichiers ; 3. validation, puis import avec aperçu dans la médiathèque.
   Rien n'est gardé avant « Importer » : la source n'est activée et les dossiers ne sont ajoutés qu'à ce moment ; Annuler déconnecte le compte
   connecté pendant l'assistant. Rouvert depuis le menu de la carte, il sert à gérer les dossiers (étape 2) ou à changer de compte (étape 1). *@
<WizardShell Icon="@("drv-" + Source)" Title="@(Adding ? "Ajouter " + Def.Name : Def.Name)" Labels="@Labels" Step="step" Done="done" Running="running"
             CanBack="@(step == 2)" Hint="@Hint" NextLabel="@NextLabel" NextDisabled="NextDisabled"
             OnCancel="Cancel" OnClose="Close" OnBack="Back" OnNext="Next">
    @if (step == 1)
    {
        @if (Source is "nextcloud" or "sftp")
        {
            <div class="cw-body">
                <DriveAccountForm Source="@Source" InWizard="true" OnSaved="Refreshed" />
            </div>
        }
        else
        {
            <WizardAccount Kind="@Kind" Provider="@Provider" Ready="ready" Connected="connected" Lost="lost" User="@user" Since="since" ConnectUrl="@ConnectUrl"
                           Missing="@Missing" Permissions="@Permissions" />
        }
    }
    else if (step == 2)
    {
        <div class="cw-body">
            <h2 class="cw-h">Quels dossiers voulez-vous ajouter ?</h2>
            <p class="cw-lead">Cochez les dossiers à copier dans votre Médiathèque. Les sous-dossiers sont inclus. Vos originaux ne sont pas modifiés.</p>
            <DriveFolderTree Source="@Source" Chosen="chosen" OnChanged="Changed" />
        </div>
    }
    else
    {
        <div class="cw-body cw-final">
            @if (done)
            {
                <div class="cw-bigok">✓</div>
                <h2 class="cw-h">@Def.Name est prêt</h2>
                <p class="cw-lead">@importedCount fichier@(importedCount > 1 ? "s" : "") dans votre Médiathèque.</p>
            }
            else
            {
                <div class="cw-spin"></div>
                <h2 class="cw-h">Ajout en cours…</h2>
                <p class="cw-lead">Fichier @Math.Min(doneNow + 1, Math.Max(totalNow, 1)) sur @Math.Max(totalNow, 1) · vous pouvez fermer, l'import continue en arrière-plan.</p>
                <div class="cw-bar"><i style="width:@Percent%"></i></div>
            }
            @foreach (var f in Targets().Where(f => f.LastError.Length > 0)) { <small class="cal-err">@f.Name : @f.LastError</small> }
            @if (imported.Count > 0) { <div class="cw-grid">@foreach (var m in imported.Take(12)) { <div class="cw-th"><div class="cw-im"><MediaThumb Media="m" /></div><span>@m.Name</span></div> }</div> }
        </div>
    }
</WizardShell>

@code {
    [Parameter, EditorRequired] public string Source { get; set; } = "";
    [Parameter] public int StartStep { get; set; } = 1;
    /// <summary>L'application n'est pas encore dans Mes applications : elle n'y entre qu'au lancement de l'import.</summary>
    [Parameter] public bool Adding { get; set; }
    /// <summary>Une autre application de Mes applications utilise le même compte (Google, Microsoft) : Annuler ne le déconnecte pas.</summary>
    [Parameter] public bool AccountShared { get; set; }
    [Parameter] public EventCallback OnAdded { get; set; }
    [Parameter] public EventCallback OnClose { get; set; }
    [Parameter] public EventCallback OnChanged { get; set; }

    private static readonly string[] Labels = { "Compte", "Sélection", "Terminé" };
    private DriveSourceDef Def => DriveSources.Find(Source)!;
    private string Kind => Source switch { "gdrive" => ConnectedAccounts.Google, "onedrive" => ConnectedAccounts.Microsoft, _ => Source };
    private string Provider => Source switch { "gdrive" => "Google", "onedrive" => "Microsoft", "dropbox" => "Dropbox", _ => Def.Name };
    private string ConnectUrl => Source switch { "gdrive" => "/google/connect?for=drive&wiz=drv-gdrive", "onedrive" => "/microsoft/connect?for=drive&wiz=drv-onedrive", _ => "/dropbox/connect?wiz=drv-dropbox" };
    private string[] Permissions => new[] { "Lire vos dossiers", "Lire les images et vidéos qu'ils contiennent", "Lire le nom de votre profil" };

    private int step = 1;
    private bool ready, connected, lost;
    private string user = "", Missing = "";
    private DateTime? since;
    private List<DriveFolder> folders = new();       // déjà synchronisés
    private readonly List<DriveFolder> chosen = new();   // choisis dans l'assistant : rien n'est enregistré avant « Importer »
    private List<DriveFolder> Removed => folders.Where(f => !chosen.Any(c => c.Id == f.Id)).ToList();

    private bool running, done;
    private int doneNow, totalNow, importedCount;
    private DateTime started;
    private List<MediaItem> imported = new();
    private Timer? timer;
    private int Percent => done ? 100 : totalNow == 0 ? 0 : Math.Min(99, doneNow * 100 / totalNow);

    private bool NextDisabled => step switch { 1 => !connected, 2 => chosen.Count == 0 && folders.Count == 0, _ => running && !done };
    private string NextLabel => step == 1 ? "Suivant"
        : step == 2 ? (chosen.Count > 0 ? $"Ajouter {chosen.Count} dossier{(chosen.Count > 1 ? "s" : "")}" : "Enregistrer")
        : "Ajout en cours…";
    private string Hint => step switch
    {
        1 => connected ? "" : Source is "nextcloud" or "sftp" ? "Enregistrez la connexion pour continuer." : "Connectez un compte pour continuer.",
        2 => chosen.Count == 0 ? "Choisissez au moins un dossier." : Removed.Count > 0 ? $"{Removed.Count} dossier{(Removed.Count > 1 ? "s" : "")} sera retiré avec ses fichiers." : Adding ? "Rien n'est enregistré tant que vous n'avez pas ajouté." : "",
        _ => ""
    };

    protected override void OnInitialized()
    {
        Refresh();
        chosen.AddRange(folders.Select(f => new DriveFolder { Id = f.Id, Source = f.Source, Name = f.Name, RemoteId = f.RemoteId, Location = f.Location, WebUrl = f.WebUrl, Subfolders = f.Subfolders, OnlyFiles = f.OnlyFiles.ToList() }));
        step = !connected ? 1 : Math.Clamp(StartStep, 1, 2);
    }

    private void Refresh()
    {
        var t = Store.Read(d => d.Tenant);
        folders = t.DriveFolders.Where(f => f.Source == Source).OrderBy(f => f.Name, StringComparer.CurrentCultureIgnoreCase).ToList();
        connected = DriveSources.Configured(t, Source);
        lost = false; Missing = $"Connectez le compte {Provider} qui a accès à vos dossiers.";
        switch (Source)
        {
            case "gdrive":
                ready = GoogleAuth.IsConfigured;
                var g = GoogleAuth.ConnectionOf(t);
                (user, since) = (g.User, g.Since);
                if (g.Connected && !connected) Missing = "Compte connecté pour Google Calendar : autorisez aussi la lecture de vos fichiers Drive.";
                break;
            case "onedrive":
                ready = MsAuth.IsConfigured;
                var m = MicrosoftAuth.ConnectionOf(t);
                (user, since) = (m.User, m.Since);
                if (m.Connected && !connected) Missing = "Compte connecté pour les agendas : autorisez aussi la lecture de vos fichiers.";
                break;
            case "dropbox":
                ready = DropboxAuth.IsConfigured;
                var a = DriveSources.Account(t, "dropbox");
                (user, since, lost) = (a?.User ?? "", a?.ConnectedUtc, a?.LostUtc != null);
                break;
            default:   // Nextcloud, SFTP : la connexion a été enregistrée et testée sans erreur
                ready = true;
                connected = connected && DriveSources.Account(t, Source) is { LastError.Length: 0 };
                break;
        }
    }

    private Task Refreshed() { Refresh(); StateHasChanged(); return Task.CompletedTask; }

    private Task Close() => OnClose.InvokeAsync();

    private async Task Cancel()
    {
        // rien ne reste : le compte connecté pendant l'assistant part (sauf s'il sert à une autre application)
        if (Adding && !AccountShared && connected) await Accounts.Disconnect(Kind);
        await OnClose.InvokeAsync();
    }

    private void Back() { if (step > 1) step--; }

    private async Task Next()
    {
        if (step == 1) step = 2;
        else if (step == 2) { step = 3; await Run(); }
        else if (done) await Close();
    }

    private Task Changed() => Task.CompletedTask;

    private List<DriveFolder> Targets() => folders.Where(f => chosen.Any(c => c.Id == f.Id)).ToList();

    private async Task Run()
    {
        if (Adding) { Svc.Mark("drv-" + Source); Svc.SetDriveSource(Source, true); await OnAdded.InvokeAsync(); }
        else if (!Store.Read(d => DriveSources.Enabled(d.Tenant, Source))) Svc.SetDriveSource(Source, true);
        foreach (var f in Removed) await Drives.RemoveFolder(Store.ClientId, f.Id);
        foreach (var c in chosen.Where(c => !folders.Any(f => f.Id == c.Id))) Store.Write(d => d.Tenant.DriveFolders.Add(c));
        foreach (var c in chosen.Where(c => folders.Any(f => f.Id == c.Id)))   // dossier déjà ajouté dont les options ont changé
            Store.Write(d => { if (d.Tenant.DriveFolders.FirstOrDefault(x => x.Id == c.Id) is { } x) (x.Subfolders, x.OnlyFiles) = (c.Subfolders, c.OnlyFiles.ToList()); });
        Refresh();
        started = DateTime.UtcNow;
        running = true; done = false;
        var clientId = Store.ClientId;
        foreach (var c in chosen) _ = Task.Run(async () => { await Drives.Sync(clientId, c.Id); });
        timer?.Dispose();
        timer = new Timer(_ => _ = InvokeAsync(Tick), null, 600, 1500);
        await OnChanged.InvokeAsync();
    }

    private async Task Tick()
    {
        Refresh();
        var mine = Targets();
        var run = Drives.Running(Store.ClientId).Where(p => mine.Any(f => f.Id == p.FolderId)).ToList();
        (doneNow, totalNow) = (run.Sum(p => p.Done), run.Sum(p => p.Total));
        var keys = mine.Select(f => f.Id.ToString()).ToHashSet();
        var all = Store.Read(d => d.Media.Where(m => m.Info.TryGetValue("drive", out var k) && keys.Contains(k)).OrderByDescending(m => m.AddedUtc).ToList());
        importedCount = all.Count;
        imported = all.Take(18).ToList();
        if (totalNow == 0) totalNow = importedCount;
        var finished = mine.Count == chosen.Count && mine.All(f => f.SyncedUtc is { } s && s >= started) && run.Count == 0;
        if (finished && !done)
        {
            done = true; timer?.Dispose();
            await OnChanged.InvokeAsync();
        }
        StateHasChanged();
    }

    public void Dispose() => timer?.Dispose();
}
