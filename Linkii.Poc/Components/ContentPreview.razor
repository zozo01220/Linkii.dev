@using System.Globalization
@using System.Text.Json
@inject AppService Apps
@inject MediaLibrary Library
@inject TenantStore Store
@inject NavigationManager Nav
@using Microsoft.JSInterop
@inject IJSRuntime JS
@inject SafeHttp Http

@* Zone « Aperçu » de la fenêtre de configuration d'un contenu (standard Linkivi, voir DEV-POC.md) : montre ce que le contenu affichera.
   - fichiers (Image, Vidéo, diaporamas, Canva) et dossier Drive : une image fixe pour un seul élément, carrousel 3D dès qu'il y en a plusieurs ;
   - apps à fournisseur (YouTube, flux RSS, calendrier, page web) : rendu des données lues par le serveur, avec le résultat du test en dessous. *@
<div class="cp pv-box">
    @switch (kind)
    {
        case "composition":
            @* Compositions : la page telle qu'elle sera diffusée ; un clic ouvre l'éditeur de compositions. *@
            <div class="cp-stage cmp-stage" style="@Compositions.StageStyle(Values)">
                <CompositionThumb Item="new MediaItem { Settings = Values }" Files="allFiles" Contain="true" />
                @if (Instance != null) { <button type="button" class="cmp-pvlink" aria-label="Modifier dans l'éditeur de compositions" @onclick="OpenEditor"><span><Ico Name="edit" Size="15" /> Modifier dans l'éditeur</span></button> }
                <QrBadge Qr="Qr" OnMoved="OnQrMoved" />
            </div>
            break;

        case "clock":
            <div class="cp-stage @(Portrait ? "portrait" : "")"><ClockPreview Values="Values" OrgZone="@Zone().Id" /></div>
            break;

        case "media" or "drive":
            @if (files.Count == 0)
            {
                <div class="cp-empty"><b>Aucun aperçu</b><span>@(kind == "drive" ? "Choisissez un dossier ci-dessus." : "Choisissez un fichier ci-dessus.")</span></div>
            }
            else if (files.Count == 1)
            {
                <div class="cp-stage @(Fit == "cover" ? "fit-cover" : "") @StageShape(VideoRatio(files[0]))" style="@RatioStyle(VideoRatio(files[0]))">
                    @if (files[0].FileName != null && files[0].Status == null && (files[0].Type == "image" || Converter.CanPoster)) { <img src="/media/@files[0].FileName?w=640" alt="@files[0].Name" /> }
                    else { <MediaThumb Media="files[0]" /> }
                    @if (files[0].Type == "video") { <span class="car-play" aria-hidden="true"></span> }
                    <QrBadge Qr="Qr" OnMoved="OnQrMoved" />
                </div>
                <div class="cp-info"><b>@files[0].Name</b><span>@(files[0].Type == "video" ? "Vidéo" : "Image")</span></div>
            }
            else
            {
                <Carousel3D Items="files" Fit="@Fit" Qr="Qr" Portrait="Portrait" @key="files.Count" />
            }
            break;

        case "provider":
            @if (loading)
            {
                <div class="cp-empty"><span class="spinner"></span><span>Recherche en cours…</span></div>
            }
            else if (!loaded)
            {
                <div class="cp-empty"><b>Aucun aperçu</b><span>@EmptyHint</span></div>
            }
            else
            {
                @if (Manifest.Id == "weather-slide" && result.Data is { } wx)
                {
                    <WeatherPreview Data="wx" Values="Values" Place="Place" Portrait="Portrait" />
                }
                else if (Manifest.Id == "youtube" && YouTube.ExtractId(SourceValue) is { } yt)
                {
                    <div class="cp-stage fit-cover @StageShape(YtShown)" style="@RatioStyle(YtShown)"><img src="https://i.ytimg.com/vi/@yt/@(YtShown is < 1 ? "hqdefault" : "mqdefault").jpg" alt="" /><span class="car-play" aria-hidden="true"></span><QrBadge Qr="Qr" OnMoved="OnQrMoved" /></div>
                    <div class="seg cp-fmt" role="group" aria-label="Format de l'aperçu"><button type="button" class="@(fmtPortrait ? "" : "on")" @onclick="SetLandscape">Paysage</button><button type="button" class="@(fmtPortrait ? "on" : "")" @onclick="SetPortrait">Portrait</button></div>
                }
                else if (Manifest.Id == "webpage")
                {
                    <div class="cp-browser"><div class="cp-url">@SourceValue</div><div class="cp-frame"><iframe src="@SourceValue" title="Aperçu de la page" loading="lazy" referrerpolicy="no-referrer" sandbox="allow-scripts allow-same-origin allow-forms" tabindex="-1"></iframe></div><QrBadge Qr="Qr" OnMoved="OnQrMoved" /></div>
                }
                else if (result.Data is { } fb && fb.TryGetProperty("posts", out var posts) && posts.ValueKind == JsonValueKind.Array)
                {
                    var shown = posts.EnumerateArray().Take(4).ToList();
                    <div class="cp-fb">
                        <div class="cp-fb-h"><b aria-hidden="true">f</b><span>@Str(fb, "page")</span></div>
                        <div class="cp-fb-grid">
                            @foreach (var p in shown)
                            {
                                <div class="cp-fb-post">
                                    @if (Str(p, "picture") is { Length: > 0 } pic) { <img src="@pic" alt="" /> }
                                    <div class="cp-fb-t">@Str(p, "message")</div>
                                </div>
                            }
                        </div>
                        @if (shown.Count == 0) { <div class="cp-row">Aucune publication lisible pour le moment.</div> }
                        <QrBadge Qr="Qr" OnMoved="OnQrMoved" />
                    </div>
                }
                else if (result.Data is { } d && d.TryGetProperty("items", out var items) && items.ValueKind == JsonValueKind.Array)
                {
                    <div class="cp-paper">
                        <h4>@Str(d, "title")</h4>
                        @foreach (var it in items.EnumerateArray().Take(4))
                        {
                            <div class="cp-row"><span><b>@Str(it, "title")</b>@if (Str(it, "summary") is { Length: > 0 } su) { <small>@su</small> }</span></div>
                        }
                        <QrBadge Qr="Qr" OnMoved="OnQrMoved" />
                    </div>
                }
                else if (result.Data is { } dd && dd.TryGetProperty("events", out var evs) && evs.ValueKind == JsonValueKind.Array)
                {
                    var tz = Zone();
                    string? lastDay = null;
                    var list = evs.EnumerateArray().Take(4).ToList();
                    <div class="cp-paper">
                        <h4>@Str(dd, "title")</h4>
                        @foreach (var e in list)
                        {
                            var start = TimeZoneInfo.ConvertTimeFromUtc(e.GetProperty("start").GetDateTime().ToUniversalTime(), tz);
                            var day = start.ToString("dddd d MMMM", CultureInfo.GetCultureInfo("fr-CH"));
                            var newDay = day != lastDay;
                            lastDay = day;
                            @if (newDay) { <div class="cp-day">@day</div> }
                            <div class="cp-row">
                                <em>@(e.TryGetProperty("allDay", out var ad) && ad.ValueKind == JsonValueKind.True ? "Journée" : start.ToString("HH:mm"))</em>
                                <span><b>@Str(e, "title")</b>@if (Str(e, "location") is { Length: > 0 } loc) { <small>@loc</small> }</span>
                            </div>
                        }
                        @if (list.Count == 0) { <div class="cp-row">Aucun événement à venir sur cette période.</div> }
                        <QrBadge Qr="Qr" OnMoved="OnQrMoved" />
                    </div>
                }
            }
            break;
    }
</div>
@if (kind == "composition" && Compositions.Size(Values) is { } pg)
{
    <div class="cmp-meta"><span>@pg.W × @pg.H · @(pg.W >= pg.H ? "Paysage" : "Portrait")</span><span>@Compositions.ElementCount(Values) élément@(Compositions.ElementCount(Values) > 1 ? "s" : "")</span></div>
}

@code {
    [Inject] private VideoConverter Converter { get; set; } = default!;

    [Parameter, EditorRequired] public AppManifest Manifest { get; set; } = default!;
    [Parameter, EditorRequired] public Dictionary<string, string> Values { get; set; } = default!;
    /// <summary>Contenu déjà enregistré (ses secrets servent au test) ; null pour un nouveau contenu.</summary>
    [Parameter] public MediaItem? Instance { get; set; }
    /// <summary>Résultat de la recherche (ok / warn / bad) ou état du dossier Drive : la fenêtre l'affiche en bandeau, en haut, sans défilement.</summary>
    [Parameter] public EventCallback<(string Kind, string Text)> OnNotice { get; set; }
    /// <summary>QR code de comptage des scans de ce contenu (réglages en cours) : dessiné sur l'image et sur chaque diapositive, comme sur l'écran.</summary>
    [Parameter] public PublishedQr? Qr { get; set; }
    /// <summary>Le QR code se déplace directement dans l'aperçu (position en % de l'aperçu) ; sans appelant, il reste fixe.</summary>
    [Parameter] public EventCallback<(double X, double Y)> OnQrMoved { get; set; }
    /// <summary>Format de l'écran qui jouera le contenu : portrait (9:16) ou paysage (16:9, par défaut).</summary>
    [Parameter] public bool Portrait { get; set; }
    /// <summary>Position du contenu dans la liste de lecture (full, top-left, top-right, bottom-left, bottom-right) : la Météo la montre telle qu'à l'écran.</summary>
    [Parameter] public string Place { get; set; } = "full";
    private string? lastDriveInfo;

    // Format des vidéos : l'aperçu prend celui de la vidéo (portrait, carré, paysage) et non celui de l'écran.
    // Fichiers de la médiathèque : dimensions déjà lues dans le fichier ; à défaut (webm, mov…), le navigateur les lit dans les métadonnées.
    private readonly Dictionary<Guid, double> probed = new();
    private readonly HashSet<Guid> probing = new();
    private double? ytRatio;
    /// <summary>Format de l'aperçu YouTube (landscape / portrait), purement visuel : détecté, puis modifiable pour placer le QR code au bon endroit. Partagé avec l'onglet QR code.</summary>
    [Parameter] public string? Format { get; set; }
    [Parameter] public EventCallback<string> FormatChanged { get; set; }
    private double? YtShown => Format == "portrait" ? 9 / 16.0 : Format == "landscape" ? 16 / 9.0 : ytRatio;
    private bool fmtPortrait => YtShown is < 1;
    private Task SetFormat(string f) { Format = f; return FormatChanged.InvokeAsync(f); }
    private Task SetLandscape() => SetFormat("landscape");
    private Task SetPortrait() => SetFormat("portrait");   // YouTube : lu par le serveur (oEmbed, Shorts) quand la vidéo est recherchée
    private double? VideoRatio(MediaItem f) =>
        f.Type != "video" ? null : f.Width is > 0 && f.Height is > 0 ? f.Width.Value / (double)f.Height.Value : probed.TryGetValue(f.Id, out var r) ? r : null;
    /// <summary>Format inconnu : celui de l'écran. Plus haut que large, ou presque carré : cadre debout (hauteur limitée).</summary>
    private string StageShape(double? ratio) => ratio is { } r ? (r < 1.6 ? "portrait" : "") : Portrait ? "portrait" : "";
    private static string? RatioStyle(double? ratio) => ratio is { } r ? "aspect-ratio:" + Math.Round(Math.Clamp(r, 0.3, 4), 4).ToString(CultureInfo.InvariantCulture) : null;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (files.Count != 1 || files[0].Type != "video" || files[0].FileName == null || VideoRatio(files[0]) != null || !probing.Add(files[0].Id)) return;
        var f = files[0];
        try
        {
            var d = await JS.InvokeAsync<int[]?>("linkiiVideo.size", "/media/" + f.FileName);
            if (d is { Length: 2 } && d[0] > 0 && d[1] > 0) { probed[f.Id] = d[0] / (double)d[1]; StateHasChanged(); }
        }
        catch { }
    }

    // Cadrage choisi (réglage « fit » de l'app) : l'aperçu le reproduit.
    private string Fit => Values.GetValueOrDefault("fit") == "cover" ? "cover" : "contain";

    private string kind = "none";
    private List<MediaItem> files = new(), allFiles = new();
    private string EditorHref => Instance == null ? "#" : $"/compositions/{Instance.Id}?back={Uri.EscapeDataString(new Uri(Nav.Uri).PathAndQuery)}";
    /// <summary>Composition : ouvrir l'éditeur. La fenêtre qui l'appelle enregistre d'abord ses réglages (sinon on les perdrait) ; sans elle, on y va directement.</summary>
    [Parameter] public EventCallback OnEdit { get; set; }
    private async Task OpenEditor() { if (OnEdit.HasDelegate) await OnEdit.InvokeAsync(); else Nav.NavigateTo(EditorHref); }
    private string? driveInfo;
    private bool loading, loaded;
    private (bool Ok, string Message, JsonElement? Data) result;

    /// <summary>La dernière recherche (apps à fournisseur) a réussi : l'aperçu peut remplacer le « + ».</summary>
    public bool Succeeded => loaded && result.Ok;

    private string EmptyHint => Manifest.Settings.FirstOrDefault(f => f.Zone == "source")?.Type switch
    {
        "calendar" => "Choisissez un calendrier ci-dessus.",
        "facebookpage" => "Choisissez une Page ci-dessus : son aperçu s'affiche aussitôt.",
        "city" => "Saisissez une ville ci-dessus, puis cliquez sur « Rechercher ».",
        _ => "Saisissez l'adresse ci-dessus, puis cliquez sur « Rechercher »."
    };

    /// <summary>Un aperçu existe pour cette app (sinon la fenêtre n'affiche que la configuration, sur toute la largeur).</summary>
    public static bool Has(AppManifest m) => m.Id is Compositions.AppId or "clock-slide" ||m.Settings.Any(f => f.IsMedia || f.Type == "drive") || m.Provider != null && m.Settings.Any(f => f.Zone == "source");

    protected override async Task OnInitializedAsync()
    {
        kind = Manifest.Id == Compositions.AppId ? "composition"
             : Manifest.Id == "clock-slide" ? "clock"
             : Manifest.Settings.Any(f => f.Type == "drive") ? "drive"
             : Manifest.Settings.Any(f => f.IsMedia) ? "media"
             : Manifest.Provider != null ? "provider" : "none";
        if (kind == "provider" && Instance != null) await Refresh();   // contenu existant : aperçu d'emblée
    }

    protected override void OnParametersSet() => Collect();

    /// <summary>(Re)charge l'aperçu d'une app à fournisseur : test + données lues par le serveur. Appelé par « Rechercher ».</summary>
    public async Task Refresh()
    {
        if (kind != "provider") return;
        loading = true; loaded = false; StateHasChanged();
        try
        {
            result = await Apps.Preview(Manifest, Values, Instance); loaded = true;
            ytRatio = Manifest.Id == "youtube" && result.Ok && YouTube.ExtractId(SourceValue) is { } vid ? await YouTubeProvider.Ratio(Http, vid) : null;
            if (Manifest.Id == "youtube" && Format == null) await SetFormat(ytRatio is < 1 ? "portrait" : "landscape");
        }
        finally { loading = false; }
        await OnNotice.InvokeAsync((!result.Ok ? "bad" : result.Message.StartsWith("⚠") ? "warn" : "ok", result.Message));
    }

    // Fichiers à montrer : champs « média » visibles (Canva : pages ou vidéo selon l'export) ou fichiers du dossier Drive choisi.
    private void Collect()
    {
        if (kind == "composition") allFiles = Library.Files().Where(m => m.Type == "image" && m.Status == null && m.FileName != null).ToList();
        else if (kind == "media")
        {
            var all = Library.Files().ToDictionary(m => m.Id);
            files = Manifest.Settings.Where(f => f.IsMedia && AppCatalog.IsVisible(f, Values))
                .SelectMany(f => AppField.MediaIds(Values.GetValueOrDefault(f.Key)))
                .Where(all.ContainsKey).Select(id => all[id]).ToList();
        }
        else if (kind == "drive")
        {
            var folder = Values.GetValueOrDefault("folder") ?? "";
            var kinds = Values.GetValueOrDefault("kinds") ?? "all";
            var list = Library.Files().Where(m => m.Info.GetValueOrDefault("drive") == folder && m.Status == null && m.FileName != null
                                                  && (kinds == "all" || m.Type == (kinds == "videos" ? "video" : "image"))).ToList();
            files = (Values.GetValueOrDefault("order") == "date"
                    ? list.OrderByDescending(m => m.Info.GetValueOrDefault("driveTime"), StringComparer.Ordinal)
                    : list.OrderBy(m => m.Info.GetValueOrDefault("drivePath") ?? m.Info.GetValueOrDefault("driveName") ?? m.Name, StringComparer.CurrentCultureIgnoreCase))
                .Take(24).ToList();
            driveInfo = Library.DriveFolders().TryGetValue(folder, out var f)
                ? $"{f.FileCount} fichier{(f.FileCount > 1 ? "s" : "")} · synchronisé {DriveSources.Ago(f.SyncedUtc)}" : null;
            if (driveInfo != null && driveInfo != lastDriveInfo) _ = OnNotice.InvokeAsync(("ok", driveInfo));
            lastDriveInfo = driveInfo;
        }
    }

    private string SourceValue => Values.GetValueOrDefault(Manifest.Settings.FirstOrDefault(f => f.Zone == "source")?.Key ?? "url") ?? "";

    private static string Str(JsonElement e, string name) => e.TryGetProperty(name, out var v) && v.ValueKind == JsonValueKind.String ? v.GetString() ?? "" : "";

    private TimeZoneInfo Zone()
    {
        try { return TimeZoneInfo.FindSystemTimeZoneById(Store.Read(d => d.Tenant.Timezone)); } catch { return TimeZoneInfo.Utc; }
    }
}
