@inherits EmergencyComponent

@* Bandeau rouge sous la barre du haut (toutes les pages) tant qu'une urgence est active : un clic ouvre la confirmation pour la lever, « Voir le rapport » le suivi
   écran par écran. Sur mobile (app) : bouton rouge flottant « Urgence » hors urgence, bandeau collé en haut pendant l'urgence. Maquette : urgence.html (scène 4). *@
<HeadContent><link rel="stylesheet" href="emergency.css?v=4" /></HeadContent>
@{ var s = Snap; }
@if (s.Enabled)
{
    @if (s.Main is { } e)
    {
        <div class="em-bar" role="alert" title="Cliquer pour lever l'urgence" @onclick="() => Click(s)">
            <Ico Name="alert" Size="20" />
            <div class="x"><b>@(s.ActiveCount > 1 ? $"{s.ActiveCount} urgences en cours" : $"Urgence en cours : {e.Title}")</b> · depuis @Hm(e.StartedUtc) · @s.Displayed écran@(s.Displayed > 1 ? "s" : "") sur @s.Targeted l'affiche@(s.Displayed > 1 ? "nt" : "") · <u>@(s.ActiveCount > 1 ? "cliquer pour voir" : "cliquer pour la lever")</u></div>
            <button type="button" class="b" @onclick="() => Ui.OpenReport(e.Id)" @onclick:stopPropagation="true">Voir le rapport</button>
        </div>
    }
    else
    {
        <button type="button" class="em-fab" aria-haspopup="dialog" @onclick="Ui.OpenForm"><Ico Name="alert" Size="18" />Urgence</button>
    }
}

@code {
    private void Click(EmergencySnapshot s)
    {
        if (s.ActiveCount > 1) Ui.OpenHistory();
        else if (s.Main != null) Ui.AskLift(s.Main.Id);
    }
}
