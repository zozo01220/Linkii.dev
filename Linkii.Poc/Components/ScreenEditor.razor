    private ScreenWidget? Sel => widgets.FirstOrDefault(w => w.Id == selected);

    protected override void OnInitialized()
    {
        // Proposés : les widgets actifs (page Widgets). Un widget désactivé déjà posé reste réglable.
        manifests = Svc.Catalog.Where(a => a.ScreenWidget).ToDictionary(a => a.Id);
        var on = Svc.Installed().Select(a => a.AppId).ToHashSet();
        available = manifests.Values.Where(a => on.Contains(a.Id)).OrderBy(a => a.Name).ToList();
        var s = Store.Read(d => d.Screens.First(x => x.Id == ScreenId));
        playlists = Store.Read(d => d.Playlists.OrderBy(p => p.Name).ToList());
        media = Store.Read(d => d.Media.Where(m => m.Status == null).ToList());
        zones = Store.Read(d => d.Area?.Zones.OrderByDescending(z => z.IsDefault).ThenBy(z => z.Name, StringComparer.CurrentCultureIgnoreCase).ToList() ?? new());
        wall = zones.FirstOrDefault(z => z.Id == s.ZoneId && z.IsWall);
        screenWallPos = s.WallPos;
        zoneValue = (zones.FirstOrDefault(z => z.Id == s.ZoneId) ?? zones.FirstOrDefault(z => z.IsDefault))?.Id.ToString() ?? "";
        name = s.Name;
        (mirrorH, mirrorV) = (s.MirrorH, s.MirrorV);
        (sleepOn, sleepMode, sleepGrid) = (Store.Read(d => d.Tenant.SleepEnabled), Sleep.Mode(s), s.SleepGrid);
        var ar = Store.Read(d => d.Areas.FirstOrDefault(a => a.Id == s.AreaId));
        sleepInherited = Sleep.Any(ar?.SleepGrid)
            ? $"L'écran suit les plages de l'aire « {ar!.Name} » ({Math.Round(ar.SleepGrid!.Count(c => c == '1') / 7.0, 1).ToString("0.#", Fr)} h de veille par jour en moyenne)."
            : $"L'aire « {ar?.Name} » n'a pas de plage : l'écran reste allumé.";
        (dimOn, dimMode, dimPlan) = (Store.Read(d => d.Tenant.DimEnabled), Dim.Mode(s), s.Dimming?.Clone());
        areaSleepGrid = ar?.SleepGrid;
        areaDimActive = Dim.Active(ar?.Dimming);
        dimInherited = Dim.Active(ar?.Dimming)
            ? $"L'écran suit le réglage de l'aire « {ar!.Name} »."
            : $"L'aire « {ar?.Name} » n'a pas de réglage : l'image est affichée telle quelle.";
        for (var z = 0; z < zonePl.Count; z++) zonePl[z] = s.ZonePlaylist(z);
        spec =new ScreenSpec { Type = s.ScreenType, Orientation = s.Orientation, Resolution = s.Resolution };
        layoutId = ScreenLayouts.Fit(ScreenLayouts.Find(s.Layout).Id, spec);   // découpage encore permis par le format
        if (s.DetectedW > 0) detected = $"{s.DetectedW}×{s.DetectedH}";
        // copie de travail : rien n'est enregistré avant « Enregistrer »
        widgets = wall != null ? new() : s.Widgets.Select(w => new ScreenWidget { Id = w.Id, AppId = w.AppId, X = w.X, Y = w.Y, Scale = w.Scale, Settings = new(w.Settings) }).ToList();
        foreach (var w in widgets) if (manifests.GetValueOrDefault(w.AppId) is { } m) w.Settings = AppCatalog.WithDefaults(m, w.Settings);
        selected = widgets.FirstOrDefault()?.Id;
    }

