@using Microsoft.JSInterop
@implements IDisposable
@inject TenantStore Store
@inject AppService Svc
@inject Notifier Notifier
@inject Toaster Toast
@inject IJSRuntime JS
@inject NavigationManager Nav

@* Édition d'un écran : nom, playlist, format et widgets (horloge, météo) posés librement sur un aperçu à l'échelle.
   La liste de lecture et les widgets partent sur l'écran à la publication ; le format s'applique dès l'enregistrement. *@
<div class="modal-backdrop" @onclick="Close"></div>
<div class="modal app-modal wg-modal" role="dialog" aria-modal="true" aria-labelledby="se-title">
    <div class="modal-head">
        <span class="app-ico" style="--app-c:#0B1F3A"><Ico Name="monitor" Size="22" /></span>
        <div class="grow" style="min-width:0">
            @if (headRename)
            {
                @* renommage direct : enregistré aussitôt (le nom n'est pas diffusé) *@
                <div class="row se-rename">
                    <input class="grow" maxlength="80" @ref="headInput" @bind="headValue" @bind:event="oninput" @onkeydown="OnHeadKey" aria-label="Nom de l'écran" />
                    <button type="button" class="btn sm" disabled="@string.IsNullOrWhiteSpace(headValue)" @onclick="SaveHeadRename">Renommer</button>
                    <button type="button" class="btn ghost sm" @onclick="() => headRename = false">Annuler</button>
                </div>
            }
            else
            {
                <div class="row" style="gap:8px;flex-wrap:nowrap">
                    <h3 id="se-title" class="se-title">@(string.IsNullOrWhiteSpace(name) ? "Écran" : name)</h3>
                    <button type="button" class="btn ghost sm" title="Renommer l'écran" @onclick="StartHeadRename"><Ico Name="edit" Size="15" /> Renommer</button>
                </div>
            }
            <small>Modifier l'écran</small>
        </div>
        @if (wall == null && dimOn)
        {
            <button type="button" class="modal-x @(DimActive ? "set" : "")" aria-label="Luminosité et contraste" title="Luminosité et contraste : @DimSummary" @onclick="OpenDimDialog"><Ico Name="@(DimActive ? "sun" : "sun-off")" Size="20" /></button>
        }
        @if (wall == null && sleepOn)
        {
            <button type="button" class="modal-x @(DimAsleep != null ? "set" : "")" aria-label="Mise en veille" title="Mise en veille : @SleepSummary" @onclick="OpenSleepDialog"><Ico Name="@(DimAsleep != null ? "moon" : "moon-off")" Size="20" /></button>
        }
        @if (wall == null)
        {
            <button type="button" class="modal-x" aria-label="Planning de l'écran" title="Planning de l'écran : quelle liste passe, quand" @onclick="OpenPlanning"><Ico Name="calendar" Size="20" /></button>
        }
        <button type="button" class="modal-x" aria-label="Options avancées" title="Options avancées" @onclick="OpenAdvanced"><Ico Name="sliders" Size="20" /></button>
        <button type="button" class="modal-x" aria-label="Fermer" @onclick="Close"><Ico Name="x" Size="20" /></button>
    </div>
    <div class="modal-body wg-body">
        <div class="wg-stage-wrap" style="--z: @zoom.ToString(Inv)">
            <div class="wg-stage @(spec.Orientation == "portrait" ? "portrait" : "")" @ref="canvas">
                @* Zones du découpage, sous les widgets : chacune reçoit sa liste de lecture par son « + » *@
                <div class="wg-zones @(spec.Orientation == "portrait" ? "dir-col" : "dir-row")">
                    @for (var z = 0; z < Def.Sizes.Length; z++)
                    {
                        var zone = z;
                        var zp = playlists.FirstOrDefault(p => p.Id == zonePl[zone]);
                        var zt = ZoneThumb(zp);
                        <div class="wg-zone @(zp == null ? "empty" : "") @(zt != null ? "has-img" : "")" style="flex:@Def.Sizes[zone].ToString("0.##", Inv) 1 0">
                            @* reflet de ce que la zone affichera : le premier contenu plein écran de sa liste de lecture *@
                            @if (zt != null) { <span class="wg-zone-img"><MediaThumb Media="zt" All="media" /></span> }
                            @if (Def.Sizes.Length > 1) { <span class="wg-zone-n">Zone @(zone + 1)</span> }
                            @if (zp == null)
                            {
                                <button type="button" class="wg-zone-add" title="Choisir la liste de lecture de la zone @(zone + 1)" @onclick="() => pickZone = pickZone == zone ? null : zone">
                                    <Ico Name="plus" Size="22" /><span>Liste de lecture</span>
                                </button>
                            }
                            else
                            {
                                <button type="button" class="wg-zone-pl" title="Changer la liste de lecture de la zone @(zone + 1)" @onclick="() => pickZone = pickZone == zone ? null : zone">
                                    <Ico Name="menu" Size="14" /> @zp.Name
                                </button>
                            }
                            @if (pickZone == zone)
                            {
                                <div class="kebab-backdrop" @onclick="() => pickZone = null"></div>
                                <div class="kebab-menu wg-zone-menu" role="menu">
                                    @foreach (var p in playlists)
                                    {
                                        var pl = p;
                                        <button type="button" role="menuitem" class="@(pl.Id == zonePl[zone] ? "on" : "")" @onclick="() => SetZone(zone, pl.Id)"><Ico Name="menu" Size="16" /> @pl.Name</button>
                                    }
                                    @if (playlists.Count == 0) { <span class="hint" style="padding:8px 10px">Aucune liste de lecture. Créez-en une dans Listes de lecture.</span> }
                                    @if (zp != null) { <button type="button" role="menuitem" class="danger" @onclick="() => SetZone(zone, null)"><Ico Name="x" Size="16" /> Vider la zone</button> }
                                </div>
                            }
                        </div>
                    }
                </div>
                @foreach (var w in widgets)
                {
                    var wid = w;
                    <div class="wg-item @(selected == wid.Id ? "sel" : "")" data-wid="@wid.Id" tabindex="0" role="button"
                         aria-label="@Label(wid) — flèches pour déplacer, Entrée pour régler"
                         style="left:@Pct(wid.X);top:@Pct(wid.Y);--s:@wid.Scale.ToString(Inv);@TextStyle(wid)"
                         @onclick="() => OpenSettings(wid)" @onfocus="() => selected = wid.Id" @onkeydown="e => OnItemKey(e, wid)">
                        <button type="button" class="wg-gear" title="Régler « @Label(wid) »" aria-label="Régler « @Label(wid) »" @onclick="() => OpenSettings(wid)" @onclick:stopPropagation="true"><Ico Name="sliders" Size="14" /></button>
                        @if (wid.AppId == "clock")
                        {
                            <div class="wg-time">@ClockText(wid)</div>
                            @if (wid.Settings.GetValueOrDefault("showDate") != "false") { <div class="wg-sub">@DateTime.Now.ToString("dddd d MMMM", Fr)</div> }
                        }
                        else if (wid.AppId == "text")
                        {
                            @* texte libre : mêmes tailles que sur l'écran (apps.js « text ») *@
                            var title = wid.Settings.GetValueOrDefault("title") ?? "";
                            var body = wid.Settings.GetValueOrDefault("body") is { Length: > 0 } bt ? bt : "Votre texte…";
                            @if (wid.Settings.GetValueOrDefault("scroll") == "loop")
                            {
                                <div class="wg-tk"><span class="wg-tk-run" style="animation-duration:@(ScrollSeconds(wid))s">@if (title.Length > 0) { <b>@title</b><span class="wg-tk-sep">·</span> }@body.ReplaceLineEndings(" · ")</span></div>
                            }
                            else
                            {
                                @if (title.Length > 0) { <div class="wg-tx-t">@title</div> }
                                <div class="wg-tx-b">@body</div>
                            }
                        }
                        else if (wid.AppId == "qrcode")
                        {
                            @* même tracé que sur l'écran (calculé par QrCodes) *@
                            if (QrCodes.Build(wid.Settings.GetValueOrDefault("content") is { Length: > 0 } qc ? qc : "https://linkii.ch") is { } qr)
                            {
                                <svg class="wg-qr" viewBox="0 0 @qr.Size @qr.Size" shape-rendering="crispEdges" aria-hidden="true"><path d="@qr.Path" fill="#0B1F3A" /></svg>
                            }
                            @if (wid.Settings.GetValueOrDefault("label") is { Length: > 0 } ql) { <div class="wg-ql">@ql</div> }
                        }
                        else if (wid.AppId == "countdown")
                        {
                            var cd = Countdown.Compute(DateTime.Now, wid.Settings.GetValueOrDefault("date"), wid.Settings.GetValueOrDefault("format") == "detailed", wid.Settings.GetValueOrDefault("after") != "keep", wid.Settings.GetValueOrDefault("doneText"));
                            <div class="wg-cd @(cd.Hidden ? "off" : "")">
                                <div class="wg-cd-l">@(wid.Settings.GetValueOrDefault("label") is { Length: > 0 } cl ? cl : "Intitulé ?")</div>
                                <div class="wg-cd-n @(cd.Unit.Length == 0 ? "txt" : "")">@cd.Big</div>
                                @if (cd.Unit.Length > 0) { <div class="wg-cd-u">@cd.Unit</div> }
                                @if (cd.Hidden) { <div class="wg-cd-u">(masqué : date passée)</div> }
                            </div>
                        }
                        else if (wid.AppId == "quote")
                        {
                            var qs = Quotes.Parse(wid.Settings.GetValueOrDefault("quotes"));
                            var q = qs.Count == 0 ? ("Votre citation…", (string?)null) : qs[Quotes.Index(DateTime.Now, wid.Settings.GetValueOrDefault("mode"), int.TryParse(wid.Settings.GetValueOrDefault("interval"), out var qi) ? qi : 30, qs.Count)];
                            <div class="wg-q-t">“@q.Item1”</div>
                            @if (q.Item2 is { Length: > 0 }) { <div class="wg-q-a">— @q.Item2</div> }
                        }
                        else
                        {
                            @* même mise en page que le widget de l'écran (apps.js « weather ») ; valeurs d'exemple *@
                            <div class="wg-wx">
                                <span class="wg-ico">⛅</span><span class="wg-temp">18°</span>
                                <span class="wg-info"><b class="wg-city">@(string.IsNullOrWhiteSpace(wid.Settings.GetValueOrDefault("city")) ? "Ville ?" : wid.Settings["city"])</b><span class="wg-rng">↓ 12°  ↑ 20°  ·  💨 8 km/h</span></span>
                            </div>
                        }
                    </div>
                }
                <button type="button" class="wg-sim" title="Voir ce qu'affiche l'écran (dernière publication)" @onclick="() => simulate = true" @onclick:stopPropagation="true" @onpointerdown:stopPropagation="true"><Ico Name="play" Size="14" /> Simuler</button>
            </div>
            @* zoom de l'aperçu : agrandit ou réduit l'écran dans la zone bleu nuit, la zone défile si besoin *@
            <div class="wg-zoom" role="group" aria-label="Zoom de l'aperçu">
                <button type="button" aria-label="Réduire" title="Réduire" disabled="@(zoom <= MinZoom + 0.001)" @onclick="() => ZoomBy(-0.1)"><Ico Name="minus" Size="16" /></button>
                <span>@Math.Round(zoom * 100) %</span>
                <button type="button" aria-label="Agrandir" title="Agrandir" disabled="@(zoom >= MaxZoom - 0.001)" @onclick="() => ZoomBy(0.1)"><Ico Name="plus" Size="16" /></button>
            </div>
        </div>

        <div class="wg-side">
            @if (wall != null)
            {
                <p class="hint wall-note">Cet écran est la place @(screenWallPos is { } wp ? Helpers.WallLabel(wp, wall.WallCols, wall.WallRows) : "?") du mur « @wall.Name » : il joue la liste du mur, en écran plein. Pour le sortir du mur, dissolvez le mur depuis la page Écrans.</p>
            }
            else if (zones.Count(z => !z.IsWall) > 1)
            {
                @* zone de son aire : classement seulement, rien à publier *@
                <div class="dw">
                    <div class="dw-field">
                        <label for="se-zone">Zone</label>
                        <select id="se-zone" @bind="zoneValue">
                            @foreach (var z in zones.Where(z => !z.IsWall)) { <option value="@z.Id">@z.Name</option> }
                        </select>
                    </div>
                </div>
            }
            @if (wall == null)
            {
                <div class="se-utabs" role="tablist">
                    <button type="button" role="tab" aria-selected="@(tab == "screen" ? "true" : "false")" class="@(tab == "screen" ? "on" : "")" @onclick='() => tab = "screen"'><Ico Name="monitor" Size="18" /> Écran</button>
                    <button type="button" role="tab" aria-selected="@(tab == "widgets" ? "true" : "false")" class="@(tab == "widgets" ? "on" : "")" @onclick='() => tab = "widgets"'><Ico Name="grid" Size="18" /> Widgets <small>@widgets.Count</small></button>
                </div>
            }

            @if (tab == "screen" || wall != null)
            {
                <ScreenFormat Spec="spec" Layout="@layoutId" LayoutChanged="SetLayout" OnChange="StateHasChanged" Compact="true" />
            }
            else
            {
                @* widgets : posés sur l'aperçu par glisser-déposer (ou un clic) ; la liste du dessus permet de les régler ou de les retirer *@
                @* une seule liste : d'abord les widgets déjà sur l'écran (régler, retirer), puis ceux qu'on peut ajouter (+) *@
                var free = available.Where(x => widgets.All(w => w.AppId != x.Id)).ToList();
                @if (free.Count > 6) { <input id="wg-search" type="text" placeholder="Rechercher" aria-label="Rechercher un widget" @bind="search" @bind:event="oninput" style="margin-bottom:8px" /> }
                @if (widgets.Count + free.Count > 0)
                {
                    <div class="wg-list">
                        @foreach (var w in widgets)
                        {
                            var wid = w;
                            <div class="wg-lrow on @(selected == wid.Id ? "sel" : "")">
                                <button type="button" class="wg-lmain" title="Régler « @Label(wid) »" @onclick="() => OpenSettings(wid)">
                                    <AppIcon Id="@wid.AppId" Small="true" Size="16" /> <span class="wg-placed-t"><b>@Label(wid)</b><small>@Where(wid)</small></span>
                                </button>
                                <button type="button" class="btn ghost sm icon" title="Régler « @Label(wid) »" aria-label="Régler « @Label(wid) »" @onclick="() => OpenSettings(wid)"><Ico Name="sliders" Size="15" /></button>
                                <button type="button" class="btn ghost sm icon" title="Retirer « @Label(wid) »" aria-label="Retirer « @Label(wid) »" @onclick="() => Remove(wid)"><Ico Name="trash" Size="15" /></button>
                            </div>
                        }
                        @foreach (var a in free.Where(x => string.IsNullOrWhiteSpace(search) || x.Name.Contains(search.Trim(), StringComparison.CurrentCultureIgnoreCase)))
                        {
                            var app = a;
                            <div class="wg-lrow" draggable="true" title="Glissez vers l'aperçu, ou cliquez sur + pour ajouter"
                                 ondragstart="event.dataTransfer.setData('text/plain', '@app.Id'); event.dataTransfer.effectAllowed = 'copy';">
                                <span class="wg-lmain"><AppIcon Id="@app.Id" Small="true" Size="16" /> <span class="wg-placed-t"><b>@app.Name</b></span></span>
                                <button type="button" class="btn sm icon" title="Ajouter « @app.Name »" aria-label="Ajouter « @app.Name »" @onclick="() => Add(app)"><Ico Name="plus" Size="15" /></button>
                            </div>
                        }
                    </div>
                }
                @if (available.Count == 0 && widgets.Count == 0) { <p class="hint">Aucun widget actif. <a href="/widgets">Activez-les dans la page Widgets</a>.</p> }
            }            @foreach (var e in errors) { <div class="err">@e</div> }
        </div>
    </div>
    <div class="modal-foot">
        @if (confirmPublish)
        {
            <span class="confirm-line" role="alert">Publier maintenant ? L'écran affichera aussitôt « @ZonesText »@(widgets.Count > 0 ? $" et {widgets.Count} widget{(widgets.Count > 1 ? "s" : "")}" : "").</span>
            <button class="btn ghost" @onclick="() => confirmPublish = false">Retour</button>
            <button class="btn" disabled="@saving" @onclick="() => Save(true)"><Ico Name="upload" Size="16" /> Confirmer la publication</button>
        }
        else
        {
            <button class="btn ghost" @onclick="Close">Annuler</button>
            <button class="btn ghost" disabled="@saving" @onclick="() => Save(false)">Enregistrer</button>
            <button class="btn" disabled="@saving" @onclick="() => confirmPublish = true">Enregistrer et publier</button>
        }
    </div>
</div>

@if (dimDlg)
{
    @* formulaire de luminosité et contraste de l'écran : Valider garde le réglage, Annuler le laisse comme il était *@
    <div class="modal-backdrop picker-backdrop" @onclick="CancelDimDialog"></div>
    <div class="modal app-modal sl-dlg" role="dialog" aria-modal="true" aria-labelledby="se-dm-title">
        <div class="modal-head">
            <div class="grow"><h3 id="se-dm-title">Luminosité et contraste</h3><small>@name</small></div>
            <button type="button" class="modal-x" aria-label="Fermer" @onclick="CancelDimDialog"><Ico Name="x" Size="20" /></button>
        </div>
        <div class="modal-body">
            <DimChoice @bind-Mode="draftDimMode" @bind-Plan="draftDimPlan" Inherited="@dimInherited" Asleep="@DimAsleep" Name="se-dim-dlg" />
        </div>
        <div class="modal-foot">
            <button type="button" class="btn ghost" @onclick="CancelDimDialog">Annuler</button>
            <button type="button" class="btn" @onclick="ValidateDimDialog">Valider</button>
        </div>
    </div>
}

@if (sleepDlg)
{
    @* formulaire de la mise en veille propre à l'écran : Valider garde le réglage, Annuler le laisse comme il était *@
    <div class="modal-backdrop picker-backdrop" @onclick="CancelSleepDialog"></div>
    <div class="modal app-modal sl-dlg" role="dialog" aria-modal="true" aria-labelledby="se-sl-title">
        <div class="modal-head">
            <div class="grow"><h3 id="se-sl-title">Mise en veille</h3><small>@name</small></div>
            <button type="button" class="modal-x" aria-label="Fermer" @onclick="CancelSleepDialog"><Ico Name="x" Size="20" /></button>
        </div>
        <div class="modal-body">
            <SleepChoice @bind-Mode="draftMode" @bind-Grid="draftGrid" Inherited="@sleepInherited" Name="se-sleep-dlg" />
        </div>
        <div class="modal-foot">
            <button type="button" class="btn ghost" @onclick="CancelSleepDialog">Annuler</button>
            <button type="button" class="btn" @onclick="ValidateSleepDialog">Valider</button>
        </div>
    </div>
}

@if (advanced)
{
    @* options avancées de l'écran : matériel, résolution et miroir ; Annuler rétablit les valeurs d'ouverture *@
    <div class="modal-backdrop picker-backdrop" @onclick="CancelAdvanced"></div>
    <div class="modal app-modal ci-adv" role="dialog" aria-modal="true" aria-labelledby="se-adv-title">
        <div class="modal-head">
            <div class="grow"><h3 id="se-adv-title">Options avancées</h3><small>@name</small></div>
            <button type="button" class="modal-x" aria-label="Fermer" @onclick="CancelAdvanced"><Ico Name="x" Size="20" /></button>
        </div>
        <div class="modal-body">
            <ScreenFormat Spec="spec" Layout="@layoutId" LayoutChanged="SetLayout" OnChange="StateHasChanged" Compact="true" AdvancedOnly="true" Detected="@detected" />
            @* Miroir : écran monté à l'envers ou vu dans un miroir ; s'applique dès l'enregistrement, sans publier *@
            <div class="fmt-block mirror-opts">
                <label>Miroir de l'affichage</label>
                <label class="mirror-row"><button type="button" class="switch @(mirrorH ? "on" : "")" role="switch" aria-checked="@(mirrorH ? "true" : "false")" aria-label="Miroir horizontal" @onclick="() => mirrorH = !mirrorH"><span></span></button> <span><b>Horizontal</b><small>Inverse la gauche et la droite.</small></span></label>
                <label class="mirror-row"><button type="button" class="switch @(mirrorV ? "on" : "")" role="switch" aria-checked="@(mirrorV ? "true" : "false")" aria-label="Miroir vertical" @onclick="() => mirrorV = !mirrorV"><span></span></button> <span><b>Vertical</b><small>Inverse le haut et le bas. Les deux ensemble : écran fixé à l'envers.@(wall != null ? " Dans un mur, le miroir de l'écran s'ajoute à celui du mur." : "")</small></span></label>
            </div>
        </div>
        <div class="modal-foot">
            <button type="button" class="btn ghost" @onclick="CancelAdvanced">Annuler</button>
            <button type="button" class="btn" @onclick="() => advanced = false">Valider</button>
        </div>
    </div>
}
@if (simulate)
{
    <SimulatorDialog ScreenId="ScreenId" Stacked="true" OnClose="() => simulate = false" />
}

@if (settingsOpen && Sel is { } sw && manifests.GetValueOrDefault(sw.AppId) is { } m)
{
    @* réglages du widget : fenêtre au-dessus de l'éditeur ; les valeurs s'écrivent dans la copie de travail, rien n'est enregistré avant « Enregistrer » *@
    <div class="modal-backdrop picker-backdrop" @onclick="CloseSettings"></div>
    <div class="modal app-modal sm wg-settings" role="dialog" aria-modal="true" aria-label="Réglages : @m.Name">
        <div class="modal-head">
            <AppIcon Id="@m.Id" Small="true" Size="18" />
            <div class="grow" style="min-width:0"><h3>@m.Name</h3><small>Réglages du widget</small></div>
            <button type="button" class="modal-x" aria-label="Fermer" @onclick="CloseSettings"><Ico Name="x" Size="20" /></button>
        </div>
        <div class="modal-body">
            <div class="dw">
                <div class="dw-field">
                    <label>Taille</label>
                    <select value="@sw.Scale.ToString(Inv)" @onchange="e => SetScale(sw, e)">
                        @foreach (var (v, l) in Sizes) { <option value="@v.ToString(Inv)" selected="@(Math.Abs(sw.Scale - v) < 0.01)">@l</option> }
                    </select>
                </div>
                <AppForm @key="sw.Id" Manifest="m" Values="sw.Settings" />
            </div>
        </div>
        <div class="modal-foot">
            <button type="button" class="btn danger" @onclick="() => Remove(sw)"><Ico Name="trash" Size="16" /> Retirer</button>
            <span class="grow"></span>
            <button type="button" class="btn" @onclick="CloseSettings">OK</button>
        </div>
    </div>
}

@code {
    [Parameter, EditorRequired] public Guid ScreenId { get; set; }
    [Parameter] public EventCallback OnClose { get; set; }

    private static readonly System.Globalization.CultureInfo Fr = new("fr-CH");
    private static readonly System.Globalization.CultureInfo Inv = System.Globalization.CultureInfo.InvariantCulture;
    private static readonly (double Value, string Label)[] Sizes = { (0.6, "Petite"), (1, "Moyenne"), (1.5, "Grande"), (2.2, "Très grande") };

    private ElementReference canvas;
    private DotNetObjectReference<ScreenEditor>? self;
    private List<ScreenWidget> widgets = new();
    private List<AppManifest> available = new();
    private Dictionary<string, AppManifest> manifests = new();
    private List<Playlist> playlists = new();
    private List<MediaItem> media = new();

    // Premier contenu plein écran d'une liste de lecture : ce que la zone affichera au démarrage.
    private MediaItem? ZoneThumb(Playlist? p) =>
        p?.Draft.Where(i => i.Placement == "full").Select(i => media.FirstOrDefault(m => m.Id == i.MediaId)).FirstOrDefault(m => m != null);
    private List<Zone> zones = new();
    private string zoneValue = "";
    private Zone? wall;          // mur dont l'écran fait partie (sa liste et son découpage sont ceux du mur)
    private int? screenWallPos;
    private Guid? selected;
    private string layoutId = ScreenLayouts.Full;
    private readonly List<Guid?> zonePl = new() { null, null, null };   // playlist de chaque zone (copie de travail)
    private int? pickZone;   // zone dont le choix de liste de lecture est ouvert

    private ScreenLayouts.Def Def => ScreenLayouts.Find(layoutId);

    // « Accueil » ou « Accueil · Menus · — » : ce que l'écran diffusera, zone par zone
    private string ZonesText => Def.Sizes.Length == 1
        ? playlists.FirstOrDefault(p => p.Id == zonePl[0])?.Name ?? "aucune liste de lecture"
        : string.Join(" · ", Enumerable.Range(0, Def.Sizes.Length).Select(z => playlists.FirstOrDefault(p => p.Id == zonePl[z])?.Name ?? "—"));
    private List<string> errors = new();
    private string name = "", tab = "screen";
    private string? detected;
    private string search = "";
