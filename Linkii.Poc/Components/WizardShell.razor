@* Assistant d'ajout d'une application avec compte connecté : fenêtre modale centrée (feuille du bas sur téléphone), pastilles d'étapes, pied de page (maquette assistant-ajout-simplifie.html).
   Annuler (en bas à gauche) ferme sans rien garder ; une fois l'import lancé (Running), il devient « Fermer ». Sur l'écran de fin, seul Fermer reste. Pas de croix, pas de fermeture au clic sur le voile. *@
<div class="modal-backdrop"></div>
<div class="cw-top" role="dialog" aria-modal="true" aria-labelledby="cw-title">
    <div class="cw-wrap">
        <div class="cw-head">
            <AppIcon Id="@Icon" />
            <div class="grow">
                <h3 id="cw-title">@Title</h3>
                @if (Subtitle.Length > 0) { <small>@Subtitle</small> }
            </div>
            <div class="cw-dots" aria-label="Étape @Step sur @Labels.Length">
                @for (var i = 1; i <= Labels.Length; i++)
                {
                    var n = i;
                    <i class="@(n == Step && !Done ? "on" : "") @(n < Step || (n == Labels.Length && Done) ? "ok" : "")"></i>
                }
                <span>@Step/@Labels.Length · @Labels[Math.Clamp(Step, 1, Labels.Length) - 1]</span>
            </div>
        </div>
        @ChildContent
        <div class="cw-foot">
            @if (!Running) { <button type="button" class="btn ghost" @onclick="OnCancel">Annuler</button> }
            else if (!Done) { <button type="button" class="btn ghost" @onclick="OnClose">Fermer</button> }
            <span class="grow cw-hint">@Hint</span>
            @if (CanBack && !Done) { <button type="button" class="btn ghost" @onclick="OnBack">Retour</button> }
            <button type="button" class="btn" disabled="@NextDisabled" @onclick="OnNext">@(Done ? "Fermer" : NextLabel)</button>
        </div>
    </div>
</div>

@code {
    [Parameter, EditorRequired] public string Icon { get; set; } = "";
    [Parameter, EditorRequired] public string Title { get; set; } = "";
    [Parameter] public string Subtitle { get; set; } = "";
    [Parameter, EditorRequired] public string[] Labels { get; set; } = Array.Empty<string>();
    [Parameter] public int Step { get; set; } = 1;
    /// <summary>Dernière étape terminée : sa pastille passe au vert et seul « Fermer » reste.</summary>
    [Parameter] public bool Done { get; set; }
    /// <summary>L'import (ou la finalisation) est lancé : Annuler laisse la place à Fermer.</summary>
    [Parameter] public bool Running { get; set; }
    [Parameter] public bool CanBack { get; set; }
    [Parameter] public string Hint { get; set; } = "";
    [Parameter] public string NextLabel { get; set; } = "Suivant";
    [Parameter] public bool NextDisabled { get; set; }
    [Parameter] public EventCallback OnCancel { get; set; }
    [Parameter] public EventCallback OnClose { get; set; }
    [Parameter] public EventCallback OnBack { get; set; }
    [Parameter] public EventCallback OnNext { get; set; }
    [Parameter] public RenderFragment? ChildContent { get; set; }
}
