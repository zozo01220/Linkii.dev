@* Assistant d'ajout d'une intégration avec compte connecté : tiroir du haut, étapes, pied de page (maquette canva-assistant-ajout.html).
   Annuler (en bas à gauche) ferme sans rien garder ; une fois l'import lancé (Running), il devient « Fermer ». Pas de croix, pas de fermeture au clic sur le voile. *@
<div class="modal-backdrop"></div>
<div class="cw-top" role="dialog" aria-modal="true" aria-labelledby="cw-title">
    <div class="cw-wrap">
        <div class="cw-head">
            <AppIcon Id="@Icon" />
            <div class="grow">
                <h3 id="cw-title">@Title</h3>
                <small>@Subtitle</small>
            </div>
        </div>
        <ol class="cw-steps">
            @for (var i = 1; i <= Labels.Length; i++)
            {
                var n = i;
                var finished = n < Step || (n == Labels.Length && Done);
                <li class="@(n == Step ? "on" : "") @(finished ? "done" : "")"><i>@(finished ? "✓" : n.ToString())</i><b>@Labels[n - 1]</b></li>
            }
        </ol>
        @ChildContent
        <div class="cw-foot">
            @if (!Running) { <button type="button" class="btn ghost" @onclick="OnCancel">Annuler</button> }
            else if (!Done) { <button type="button" class="btn ghost" @onclick="OnClose">Fermer</button> }
            @if (CanBack) { <button type="button" class="btn ghost" @onclick="OnBack">Précédent</button> }
            <span class="grow cw-hint">@Hint</span>
            <button type="button" class="btn" disabled="@NextDisabled" @onclick="OnNext">@NextLabel</button>
        </div>
    </div>
</div>

@code {
    [Parameter, EditorRequired] public string Icon { get; set; } = "";
    [Parameter, EditorRequired] public string Title { get; set; } = "";
    [Parameter] public string Subtitle { get; set; } = "";
    [Parameter, EditorRequired] public string[] Labels { get; set; } = Array.Empty<string>();
    [Parameter] public int Step { get; set; } = 1;
    /// <summary>Dernière étape terminée : sa pastille passe au vert.</summary>
    [Parameter] public bool Done { get; set; }
    /// <summary>L'import (ou la finalisation) est lancé : Annuler laisse la place à Fermer.</summary>
    [Parameter] public bool Running { get; set; }
    [Parameter] public bool CanBack { get; set; }
    [Parameter] public string Hint { get; set; } = "";
    [Parameter] public string NextLabel { get; set; } = "Suivant";
    [Parameter] public bool NextDisabled { get; set; }
    [Parameter] public EventCallback OnCancel { get; set; }
    [Parameter] public EventCallback OnClose { get; set; }
    [Parameter] public EventCallback OnBack { get; set; }
    [Parameter] public EventCallback OnNext { get; set; }
    [Parameter] public RenderFragment? ChildContent { get; set; }
}
