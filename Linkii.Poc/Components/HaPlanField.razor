@using System.Text.Json
@using Microsoft.JSInterop
@inject TenantStore Store
@inject IJSRuntime JS
@inject Toaster Toast
@implements IAsyncDisposable

@* Champ « plan du bâtiment » du widget Home Assistant (§193) : résumé du plan et fenêtre d'édition.
   Étages dans l'ordre du bas vers le haut ; chaque étage a un plan (image de la médiathèque) sur lequel on pose les appareils du compte Home Assistant.
   Les positions sont des fractions du plan : l'écran garde les mêmes proportions quelle que soit sa taille. L'enregistrement écrit « plan » et « entities ». *@
<div class="ci-pick">
    <span class="ci-pick-sum">
        @if (Saved.Floors.Count == 0) { <span class="muted">Aucun plan</span> }
        else { <b>@Saved.Floors.Count étage@(Saved.Floors.Count > 1 ? "s" : "") · @Saved.Devices.Count appareil@(Saved.Devices.Count > 1 ? "s" : "")</b> }
    </span>
    <button type="button" class="btn @(Saved.Floors.Count == 0 ? "" : "ghost")" @onclick="Open"><Ico Name="home" Size="15" /> @(Saved.Floors.Count == 0 ? "Créer le plan" : "Modifier le plan")</button>
</div>

@if (open)
{
    <SectionContent SectionName="overlay">
        <div class="modal-backdrop picker-backdrop" @onclick="Cancel"></div>
        <div class="modal app-modal picker hpe" role="dialog" aria-modal="true" aria-label="Plan du bâtiment">
            <div class="modal-head">
                <span class="app-ico" style="--app-c:#41BDF5"><Ico Name="home" Size="22" /></span>
                <div class="grow"><h3>Plan du bâtiment</h3><small>Un plan par étage : glissez-y les appareils de Home Assistant.</small></div>
                <button type="button" class="modal-x" aria-label="Fermer" @onclick="Cancel"><Ico Name="x" Size="20" /></button>
            </div>
            <div class="modal-body hpe-body" @ref="root">
                <div class="hpe-main">
                    <div class="hpe-tabs" role="tablist" aria-label="Étages">
                        @foreach (var f in floors.AsEnumerable().Reverse())
                        {
                            var fid = f.Id;
                            <button type="button" role="tab" class="hpe-ft @(fid == floorId ? "on" : "")" aria-selected="@(fid == floorId ? "true" : "false")" @onclick="() => PickFloor(fid)">@f.Name <small>@Count(fid)</small></button>
                        }
                        @if (floors.Count < HomeAssistantRules.MaxPlanFloors)
                        {
                            <button type="button" class="hpe-ft add" title="Ajouter un étage" @onclick="AddFloor"><Ico Name="plus" Size="14" /> Étage</button>
                        }
                    </div>
                    <div class="hpe-stage">
                        @if (Floor is { } fl)
                        {
                            <div class="hpe-plan @(fl.Img == null ? "blank" : "")" style="--r:@fl.Ratio.ToString("0.####", Inv)">
                                @if (fl.Img != null) { <div class="hpe-img" style="background-image:url('@fl.Img')"></div> }
                                else { <div class="hpe-blank"><b>@fl.Name</b><span>Aucun plan importé. Posez les appareils sur la grille, ou importez une image du plan.</span></div> }
                                @foreach (var d in devs.Where(d => d.Floor == fl.Id))
                                {
                                    var e = Entity(d.Id);
                                    <div class="hpe-pin @(d.Id == selId ? "sel" : "") @(e == null ? "lost" : "")" data-hp-drag="@d.Id" style="left:@((d.X * 100).ToString("0.##", Inv))%;top:@((d.Y * 100).ToString("0.##", Inv))%" title="@(e?.Name ?? d.Id)">
                                        @Icon(e)
                                        @if (d.Id == selId) { <span class="hpe-lab">@(e?.Name ?? d.Id)</span> }
                                    </div>
                                }
                            </div>
                            <div class="hpe-hint">Glissez un appareil de la liste sur le plan, ou glissez une pastille pour la déplacer.</div>
                        }
                    </div>
                </div>
                <aside class="hpe-side">
                    <div class="hpe-stabs">
                        <button type="button" class="@(tab == "devices" ? "on" : "")" @onclick='() => tab = "devices"'>Appareils</button>
                        <button type="button" class="@(tab == "floors" ? "on" : "")" @onclick='() => tab = "floors"'>Étages</button>
                    </div>
                    @if (tab == "devices")
                    {
                        @if (entities.Count == 0)
                        {
                            <div class="hpe-empty">Aucune entité. Connectez Home Assistant dans Intégrations, puis actualisez la liste.</div>
                        }
                        else
                        {
                            @if (selDev is { } sd)
                            {
                                var se = Entity(sd.Id);
                                <div class="hpe-card">
                                    <span class="hpe-ic">@Icon(se)</span>
                                    <div class="hpe-t"><b>@(se?.Name ?? sd.Id)</b><small>@sd.Id · @FloorName(sd.Floor)@(se == null ? " · introuvable dans Home Assistant" : "")</small></div>
                                    <button type="button" class="btn ghost sm" @onclick="() => Unplace(sd.Id)">Retirer du plan</button>
                                </div>
                            }
                            <div class="hp-bar hpe-search">
                                <input type="search" class="hp-search" placeholder="Rechercher un appareil" aria-label="Rechercher un appareil" @bind="search" @bind:event="oninput" />
                            </div>
                            <div class="hpe-cats">
                                @foreach (var (k, l) in Cats)
                                {
                                    var key = k;
                                    <button type="button" class="@(cat == key ? "on" : "")" @onclick="() => cat = key">@l</button>
                                }
                            </div>
                            var shown = Filtered().ToList();
                            var todo = shown.Where(e => !onPlan.Contains(e.Id)).ToList();
                            var placed = shown.Where(e => onPlan.Contains(e.Id)).ToList();
                            <div class="hpe-sec">À placer <b>@todo.Count</b></div>
                            @if (todo.Count == 0) { <div class="hpe-none">@(shown.Count == 0 ? "Aucun appareil ne correspond." : "Tout est placé.")</div> }
                            @foreach (var e in todo.Take(Limit)) { @Row(e) }
                            @if (todo.Count > Limit) { <div class="hpe-none">@(todo.Count - Limit) autres : affinez la recherche.</div> }
                            <div class="hpe-sec">Sur le plan <b>@placed.Count</b></div>
                            @foreach (var e in placed.Take(Limit)) { @Row(e) }
                        }
                    }
                    else
                    {
                        <div class="hpe-note">Les étages sont rangés du bas vers le haut. Un plan est une image de la médiathèque (dessin, PDF converti, photo).</div>
                        @for (var i = 0; i < floors.Count; i++)
                        {
                            var idx = i; var f = floors[idx];
                            <div class="hpe-fl @(f.Id == floorId ? "on" : "")">
                                <input type="text" maxlength="40" value="@f.Name" aria-label="Nom de l'étage" @onchange="e => Rename(f, e)" @onfocus="() => PickFloor(f.Id)" />
                                <div class="hpe-fa">
                                    <button type="button" class="btn ghost sm" @onclick="() => { PickFloor(f.Id); picking = true; }"><Ico Name="image" Size="14" /> @(f.Img == null ? "Importer le plan" : "Changer le plan")</button>
                                    @if (f.Img != null) { <button type="button" class="btn ghost sm" @onclick="() => f.Img = null">Retirer l'image</button> }
                                    <span class="grow"></span>
                                    <button type="button" class="btn ghost sm icon hpe-dn" aria-label="Descendre d'un étage" disabled="@(idx == 0)" @onclick="() => Move(idx, -1)"><Ico Name="arrow-up" Size="14" /></button>
                                    <button type="button" class="btn ghost sm icon" aria-label="Monter d'un étage" disabled="@(idx == floors.Count - 1)" @onclick="() => Move(idx, 1)"><Ico Name="arrow-up" Size="14" /></button>
                                    <button type="button" class="btn ghost sm icon" aria-label="Supprimer l'étage" disabled="@(floors.Count == 1)" @onclick="() => RemoveFloor(f.Id)"><Ico Name="trash" Size="14" /></button>
                                </div>
                            </div>
                        }
                        @if (floors.Count < HomeAssistantRules.MaxPlanFloors) { <button type="button" class="btn ghost" @onclick="AddFloor"><Ico Name="plus" Size="15" /> Ajouter un étage</button> }
                    }
                </aside>
            </div>
            <div class="modal-foot">
                <span class="hpe-count">@devs.Count appareil@(devs.Count > 1 ? "s" : "") sur @floors.Count étage@(floors.Count > 1 ? "s" : "")</span>
                <span class="grow"></span>
                <button type="button" class="btn" @onclick="Cancel">Annuler</button>
                <button type="button" class="btn primary" @onclick="Apply">Appliquer</button>
            </div>
        </div>
        @if (picking)
        {
            <MediaPicker Accept="image" Multiple="false" OnPicked="Picked" OnClose="() => picking = false" />
        }
    </SectionContent>
}

@code {
    [Parameter, EditorRequired] public Dictionary<string, string> Values { get; set; } = default!;
    [Parameter] public EventCallback OnChange { get; set; }

    private static readonly System.Globalization.CultureInfo Inv = System.Globalization.CultureInfo.InvariantCulture;
    private static readonly (string, string)[] Cats = { ("all", "Tous"), ("light", "Lumières"), ("plug", "Prises"), ("climate", "Thermostats"), ("cover", "Volets"), ("sensor", "Capteurs"), ("lock", "Serrures") };
    private const int Limit = 80;

    private sealed class EFloor { public string Id = ""; public string Name = ""; public string? Img; public double Ratio = 1.6; }
    private sealed class EDev { public string Id = ""; public string Floor = ""; public double X = .5, Y = .5; }

    private bool open, picking, inited;
    private string tab = "devices", cat = "all", search = "", floorId = "";
    private string? selId;
    private List<EFloor> floors = new();
    private List<EDev> devs = new();
    private List<HomeAssistantEntity> entities = new();
    private HashSet<string> onPlan = new();
    private ElementReference root;
    private DotNetObjectReference<HaPlanField>? self;

    private HomeAssistantRules.Plan Saved => HomeAssistantRules.ParsePlan(Values.GetValueOrDefault("plan"));
    private EFloor? Floor => floors.FirstOrDefault(f => f.Id == floorId);
    private EDev? selDev => selId == null ? null : devs.FirstOrDefault(d => d.Id == selId);
    private HomeAssistantEntity? Entity(string id) => entities.FirstOrDefault(e => e.Id == id);
    private int Count(string fid) => devs.Count(d => d.Floor == fid);
    private string FloorName(string fid) => floors.FirstOrDefault(f => f.Id == fid)?.Name ?? "";

    private void Open()
    {
        var plan = Saved;
        floors = plan.Floors.Select(f => new EFloor { Id = f.Id, Name = f.Name, Img = f.Img, Ratio = f.Ratio }).ToList();
        devs = plan.Devices.Select(d => new EDev { Id = d.Id, Floor = d.Floor, X = d.X, Y = d.Y }).ToList();
        if (floors.Count == 0) floors.Add(new EFloor { Id = NewId(), Name = "Rez-de-chaussée" });
        floorId = floors[0].Id;
        selId = null; search = ""; cat = "all"; tab = "devices"; picking = false;
        // scènes et scripts n'ont pas de place sur un plan ; les entités déjà posées mais disparues de Home Assistant restent listées (en rouge)
        entities = (Store.Read(d => d.Tenant.HomeAssistant)?.Entities ?? new())
            .Where(e => e.Domain is not (HomeAssistantRules.Scene or HomeAssistantRules.Script)).OrderBy(e => e.Name, StringComparer.CurrentCultureIgnoreCase).ToList();
        Sync();
        open = true; inited = false;
    }

    private static string NewId() => "f" + Guid.NewGuid().ToString("N")[..6];
    private void Sync() => onPlan = devs.Select(d => d.Id).ToHashSet();

    private void PickFloor(string id) { floorId = id; }

    private static void Rename(EFloor f, ChangeEventArgs e) { var n = (e.Value?.ToString() ?? "").Trim(); if (n.Length > 0) f.Name = n; }

    private void AddFloor()
    {
        if (floors.Count >= HomeAssistantRules.MaxPlanFloors) return;
        var f = new EFloor { Id = NewId(), Name = floors.Count == 0 ? "Rez-de-chaussée" : floors.Count == 1 ? "Étage" : "Étage " + floors.Count };
        floors.Add(f); floorId = f.Id;
    }

    private void RemoveFloor(string id)
    {
        if (floors.Count <= 1) return;
        floors.RemoveAll(f => f.Id == id);
        devs.RemoveAll(d => d.Floor == id);
        if (floorId == id) floorId = floors[0].Id;
        if (selId != null && !devs.Any(d => d.Id == selId)) selId = null;
        Sync();
    }

    private void Move(int i, int by)
    {
        var j = i + by;
        if (j < 0 || j >= floors.Count) return;
        (floors[i], floors[j]) = (floors[j], floors[i]);
    }

    private void Picked(List<MediaItem> items)
    {
        picking = false;
        if (items.Count == 0 || items[0].FileName is not { Length: > 0 } fn || Floor is not { } f) return;
        f.Img = "/media/" + fn;
        f.Ratio = items[0].Width is > 0 && items[0].Height is > 0 ? Math.Round((double)items[0].Width!.Value / items[0].Height!.Value, 4) : 1.6;
    }

    private void Unplace(string id) { devs.RemoveAll(d => d.Id == id); selId = null; Sync(); }

    private IEnumerable<HomeAssistantEntity> Filtered()
    {
        var q = search.Trim();
        return entities.Where(e => (cat == "all" || CatOf(e.Domain) == cat)
            && (q.Length == 0 || e.Name.Contains(q, StringComparison.OrdinalIgnoreCase) || e.Id.Contains(q, StringComparison.OrdinalIgnoreCase)));
    }

    private static string CatOf(string domain) => domain switch
    {
        HomeAssistantRules.Light => "light",
        HomeAssistantRules.Switch or HomeAssistantRules.InputBoolean or HomeAssistantRules.Fan => "plug",
        HomeAssistantRules.Climate => "climate",
        HomeAssistantRules.Cover => "cover",
        HomeAssistantRules.Lock => "lock",
        _ => "sensor",
    };

    // ---------- appelé par haplan.js ----------
    [JSInvokable]
    public Task Clicked(string id)
    {
        if (devs.FirstOrDefault(d => d.Id == id) is { } d) { selId = id; floorId = d.Floor; tab = "devices"; }
        else if (Entity(id) != null && Floor is { } f)
        {
            if (!CanAdd()) return InvokeAsync(StateHasChanged);
            var n = devs.Count(x => x.Floor == f.Id);   // un clic pose l'appareil au centre, décalé pour ne pas empiler les pastilles
            devs.Add(new EDev { Id = id, Floor = f.Id, X = Math.Clamp(.2 + (n % 6) * .12, 0, 1), Y = Math.Clamp(.35 + (n / 6 % 4) * .1, 0, 1) });
            selId = id; Sync();
        }
        return InvokeAsync(StateHasChanged);
    }

    [JSInvokable]
    public Task Dropped(string id, double x, double y)
    {
        x = Math.Clamp(x, 0, 1); y = Math.Clamp(y, 0, 1);
        if (devs.FirstOrDefault(d => d.Id == id) is { } d) { d.X = x; d.Y = y; }
        else if (Entity(id) != null && Floor is { } f)
        {
            if (!CanAdd()) return InvokeAsync(StateHasChanged);
            devs.Add(new EDev { Id = id, Floor = f.Id, X = x, Y = y });
            Sync();
        }
        selId = id;
        return InvokeAsync(StateHasChanged);
    }

    [JSInvokable] public Task Refresh() => InvokeAsync(StateHasChanged);

    private bool CanAdd()
    {
        if (devs.Count < HomeAssistantRules.MaxPlanDevices) return true;
        Toast.Error($"{HomeAssistantRules.MaxPlanDevices} appareils au plus sur un plan.");
        return false;
    }

    // ---------- enregistrement ----------
    private async Task Apply()
    {
        var json = JsonSerializer.Serialize(new
        {
            floors = floors.Select(f => new { id = f.Id, name = f.Name, img = f.Img ?? "", ratio = f.Ratio }),
            devices = devs.Select(d => new { id = d.Id, floor = d.Floor, x = d.X, y = d.Y }),
        });
        var (clean, ents) = HomeAssistantRules.NormalizePlan(json);
        Values["plan"] = clean;
        Values["entities"] = ents;
        await Close();
        await OnChange.InvokeAsync();
    }

    private Task Cancel() => Close();

    private async Task Close()
    {
        open = false; picking = false;
        await Dispose2();
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!open || inited) return;
        try
        {
            self ??= DotNetObjectReference.Create(this);
            await JS.InvokeVoidAsync("haPlanDrag.init", root, self);
            inited = true;
        }
        catch (InvalidOperationException) { /* la page se ferme */ }
        catch (JSException) { /* ancien script en cache : rechargez la page */ }
    }

    private async Task Dispose2()
    {
        if (!inited) return;
        inited = false;
        try { await JS.InvokeVoidAsync("haPlanDrag.dispose", root); } catch (Exception e) when (e is JSDisconnectedException or InvalidOperationException or JSException) { }
    }

    public async ValueTask DisposeAsync()
    {
        await Dispose2();
        self?.Dispose();
    }

    // ---------- éléments d'affichage ----------
    private RenderFragment Row(HomeAssistantEntity e) => @<div class="hpe-row @(onPlan.Contains(e.Id) ? "" : "todo") @(e.Id == selId ? "sel" : "")" data-hp-drag="@e.Id">
        <span class="hpe-ic">@Icon(e)</span>
        <span class="hpe-t"><b>@e.Name</b><small>@e.Id</small></span>
        @if (onPlan.Contains(e.Id)) { <span class="hpe-where">@FloorName(devs.First(d => d.Id == e.Id).Floor)</span> }
    </div>;

    // même pictogrammes que le player (apps.js, haIcon)
    private static readonly Dictionary<string, string> Paths = new()
    {
        ["thermo"] = "<path d='M14 14.76V3.5a2.5 2.5 0 0 0-5 0v11.26a4.5 4.5 0 1 0 5 0z'/>",
        ["drop"] = "<path d='M12 2.7l5.7 5.6a8 8 0 1 1-11.4 0z'/>",
        ["bolt"] = "<path d='M13 2L3 14h9l-1 8 10-12h-9l1-8z'/>",
        ["battery"] = "<rect x='2' y='7' width='18' height='10' rx='2'/><path d='M22 11v2'/>",
        ["sun"] = "<circle cx='12' cy='12' r='4'/><path d='M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4'/>",
        ["gauge"] = "<path d='M12 14l4-4'/><path d='M3.3 19a10 10 0 1 1 17.4 0'/>",
        ["door"] = "<rect x='5' y='3' width='14' height='18' rx='1'/><path d='M15 12v.01'/>",
        ["window"] = "<rect x='3' y='3' width='18' height='18' rx='2'/><path d='M12 3v18M3 12h18'/>",
        ["motion"] = "<circle cx='13' cy='4' r='2'/><path d='M7 21l3-6 3 3v3M10 15l1-5 4 3 3-1M8 9l3-1'/>",
        ["person"] = "<circle cx='12' cy='8' r='4'/><path d='M4 21a8 8 0 0 1 16 0'/>",
        ["alert"] = "<path d='M12 3L2 21h20z'/><path d='M12 10v4M12 17v.01'/>",
        ["bulb"] = "<path d='M9 18h6M10 22h4M12 2a7 7 0 0 0-4 12.7V17h8v-2.3A7 7 0 0 0 12 2z'/>",
        ["plug"] = "<path d='M9 2v6M15 2v6M6 8h12v4a6 6 0 0 1-12 0zM12 18v4'/>",
        ["toggle"] = "<rect x='2' y='7' width='20' height='10' rx='5'/><circle cx='16' cy='12' r='3'/>",
        ["fan"] = "<circle cx='12' cy='12' r='2'/><path d='M12 10c0-4 1-7 4-7s3 4-2 7M14 12c4 0 7 1 7 4s-4 3-7-2M12 14c0 4-1 7-4 7s-3-4 2-7M10 12c-4 0-7-1-7-4s4-3 7 2'/>",
        ["cover"] = "<rect x='3' y='3' width='18' height='18' rx='1'/><path d='M3 8h18M3 13h18M12 13v5'/>",
        ["lock"] = "<rect x='4' y='11' width='16' height='10' rx='2'/><path d='M8 11V7a4 4 0 0 1 8 0v4'/>",
        ["air"] = "<path d='M9.6 4.6A2 2 0 1 1 11 8H2M12.6 19.4A2 2 0 1 0 14 16H2M17.7 7.7A2.5 2.5 0 1 1 19.5 12H2'/>",
    };

    private static string IconKey(HomeAssistantEntity? e)
    {
        if (e == null) return "alert";
        var dc = e.DeviceClass; var u = e.Unit;
        return e.Domain switch
        {
            "light" => "bulb", "switch" => "plug", "input_boolean" => "toggle", "fan" => "fan", "climate" => "thermo", "lock" => "lock",
            "cover" => dc == "window" ? "window" : dc is "door" or "garage" or "gate" ? "door" : "cover",
            "binary_sensor" => dc switch
            {
                "door" or "garage_door" or "opening" => "door", "window" => "window", "motion" => "motion", "occupancy" or "presence" => "person",
                "moisture" => "drop", "smoke" or "gas" or "problem" or "safety" => "alert", "battery" => "battery", "lock" => "lock", "plug" => "plug", "power" => "bolt", "light" => "sun",
                _ => "gauge",
            },
            _ => dc switch
            {
                "temperature" => "thermo", "humidity" or "moisture" => "drop", "power" or "energy" or "current" or "voltage" or "apparent_power" => "bolt", "battery" => "battery",
                "illuminance" or "irradiance" => "sun", "carbon_dioxide" or "pm25" or "pm10" or "aqi" or "volatile_organic_compounds" => "air",
                _ => u.EndsWith("°C") || u.EndsWith("°F") ? "thermo" : u is "W" or "kW" or "kWh" or "Wh" or "V" or "A" or "mA" ? "bolt" : u is "lx" or "lm" ? "sun" : "gauge",
            },
        };
    }

    private static MarkupString Icon(HomeAssistantEntity? e) =>
        new($"<svg class='hpe-i' viewBox='0 0 24 24' aria-hidden='true'>{Paths[IconKey(e)]}</svg>");
}
