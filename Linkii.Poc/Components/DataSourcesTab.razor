@inject TenantStore Store
@inject DataSetService Data
@inject RelayBroker Relays
@inject Toaster Toast
@implements IDisposable

@* Page Sources de données (§139, maquettes/sources-de-donnees-hub.html) : un sous-onglet « Sources » et un « Relais » (paramètre Section), en cartes ou en liste,
   avec recherche et filtres comme le Store ; un clic ouvre un tiroir à droite (trajet, jeux de données, modifier, supprimer avec confirmation). Plan Pro ; administrateurs.
   Le bouton d'ajout est dans l'en-tête de la page (DataSources.razor) et appelle AddSource / AddRelay. *@
<HeadContent><link rel="stylesheet" href="data-sources.css?v=4" /></HeadContent>

@if (!allowed)
{
    <div class="dsx-lock">
        <PlanTag Plan="@Plans.Growth" Size="15" />
        <h3>Vos propres données dans vos compositions</h3>
        <p>Branchez une API web, une base de données ou un fichier (CSV, JSON, Excel) : Linkii le lit à la fréquence choisie, garde la dernière copie et l'affiche dans vos compositions (champs, listes reliées). Disponible avec le plan Pro.</p>
        <a class="btn" href="/settings?tab=abonnement">Voir les plans</a>
    </div>
}
else if (onRelays ? relays.Count == 0 : connections.Count == 0 && relays.Count == 0)
{
    @if (onRelays)
    {
        <div class="dsx-first">
            <h2>Atteignez vos sources internes</h2>
            <p>Un relais est un petit programme installé chez vous : il lit les sources de votre réseau interne et les transmet à Linkii.</p>
            <button type="button" class="btn" disabled="@(!CanAddRelay)" @onclick="AddRelay"><Ico Name="plus" Size="15" /> Installer un relais</button>
        </div>
    }
    else
    {
        <div class="dsx-first">
            <h2>Affichez vos propres données sur vos écrans</h2>
            <p>Connectez une fois votre source ; Linkii garde une copie à jour et l'envoie aux écrans.</p>
            <div class="dsx-steps">
                <div><em>1</em><b>Connecter</b><span>API web, base de données, fichier CSV, JSON ou Excel.</span></div>
                <div><em>2</em><b>Choisir un jeu de données</b><span>Un chemin d'API, une feuille, une requête, sa fréquence.</span></div>
                <div><em>3</em><b>L'utiliser</b><span>Reliez ses champs à un bloc dans l'éditeur de compositions.</span></div>
            </div>
            <button type="button" class="btn" @onclick="AddSource"><Ico Name="plus" Size="15" /> Connecter une source</button>
        </div>
    }
}
else
{
    var rs = !onRelays ? new List<DataRelay>() : relays.Where(r => (filter is "" || (filter == "on") == Relays.Online(r.Id)) && Match(r.Name + " " + r.Machine)).ToList();
    var cs = onRelays ? new List<DataConnection>() : connections.Where(c => (filter is "" || filter == c.Kind) && Match(c.Name + " " + Describe(c))).ToList();
    var noun = onRelays ? "un relais" : "une source";
    <div class="lib-tools">
        <div class="search-box grow" style="margin:0">
            <Ico Name="search" Size="16" />
            <input placeholder="Rechercher @noun" aria-label="Rechercher @noun" @bind="search" @bind:event="oninput" />
        </div>
        <ViewToggle StorageKey="datasources" @bind-Value="view" />
    </div>
    <div class="int-chips" role="group" aria-label="Filtrer">
        @if (onRelays)
        {
            var nOn = relays.Count(r => Relays.Online(r.Id));
            <button type="button" class="chip @(filter == "" ? "on" : "")" aria-pressed="@(filter == "" ? "true" : "false")" @onclick='() => filter = ""'>Tous <small>@relays.Count</small></button>
            <button type="button" class="chip @(filter == "on" ? "on" : "")" aria-pressed="@(filter == "on" ? "true" : "false")" @onclick='() => filter = "on"'>En ligne <small>@nOn</small></button>
            <button type="button" class="chip @(filter == "off" ? "on" : "")" aria-pressed="@(filter == "off" ? "true" : "false")" @onclick='() => filter = "off"'>Hors ligne <small>@(relays.Count - nOn)</small></button>
        }
        else
        {
            <button type="button" class="chip @(filter == "" ? "on" : "")" aria-pressed="@(filter == "" ? "true" : "false")" @onclick='() => filter = ""'>Toutes <small>@connections.Count</small></button>
            @foreach (var k in new[] { DataKinds.Api, DataKinds.Db, DataKinds.File })
            {
                var kind = k;
                var n = connections.Count(c => c.Kind == kind);
                if (n == 0) { continue; }
                <button type="button" class="chip @(filter == kind ? "on" : "")" aria-pressed="@(filter == kind ? "true" : "false")" @onclick="() => filter = kind">@KindLabel(kind) <small>@n</small></button>
            }
        }
    </div>

    @if (rs.Count + cs.Count == 0)
    {
        <p class="dsx-note"><b>Aucun résultat.</b> Essayez un autre mot ou retirez le filtre.</p>
    }
    @if (rs.Count > 0)
    {
        <div class="@(view == "list" ? "dsx-list" : "dsx-grid")">
            @if (view == "list") { <div class="dsx-lrow hd"><span></span><span>Relais</span><span>Machine</span><span>État</span><span>Connexions</span></div> }
            @foreach (var x in rs)
            {
                var rl = x;
                var online = Relays.Online(rl.Id);
                var uses = connections.Count(c => c.Via == "relay" && c.RelayId == rl.Id);
                var pill = StatePill(rl.TokenHash.Length == 0 ? "warn" : online ? "ok" : "bad", rl.TokenHash.Length == 0 ? "En attente d'appairage" : online ? "En ligne" : "Hors ligne");
                @if (view == "list")
                {
                    <button type="button" class="dsx-lrow" @onclick="() => ShowRelay(rl.Id)"><span class="dsx-ico relay">⇄</span><b>@rl.Name</b><span class="muted">@(rl.Machine.Length > 0 ? rl.Machine : "—")</span><span>@pill</span><span class="muted">@(uses == 0 ? "aucune" : uses.ToString())</span></button>
                }
                else
                {
                    <button type="button" class="dsx-card dsx-relay" @onclick="() => ShowRelay(rl.Id)">
                        <div class="dsx-top">
                            <span class="dsx-ico relay">⇄</span>
                            <div class="grow" style="min-width:0"><b>@rl.Name</b><small>@(rl.Machine.Length > 0 ? rl.Machine : "machine non annoncée")</small></div>
                            @pill
                        </div>
                        <div class="dsx-foot">@(uses == 0 ? "Aucune connexion" : $"{uses} connexion{(uses > 1 ? "s" : "")} servie{(uses > 1 ? "s" : "")}")@if (rl.Version.Length > 0) { <span class="grow"></span><span>v@(rl.Version)</span> }</div>
                    </button>
                }
            }
        </div>
    }
    @if (cs.Count > 0)
    {
        <div class="@(view == "list" ? "dsx-list" : "dsx-grid")">
            @if (view == "list") { <div class="dsx-lrow hd"><span></span><span>Source</span><span>Type</span><span>État</span><span>Jeux de données</span></div> }
            @foreach (var c in cs)
            {
                var conn = c;
                var sets = dataSets.Where(d => d.ConnectionId == conn.Id).ToList();
                var level = ConnLevel(conn, sets);
                var pill = StatePill(level, StateText(conn, level));
                var last = sets.Select(s => Data.Last(clientId, s.Id)).Where(l => l != null).OrderByDescending(l => l!.Utc).FirstOrDefault();
                @if (view == "list")
                {
                    <button type="button" class="dsx-lrow" @onclick="() => ShowConn(conn.Id)"><span class="dsx-ico @(conn.Kind)">@IcoText(conn)</span><span class="dsx-lname"><b>@conn.Name</b>@if (conn.Via == "relay") { <small>⇄ par un relais</small> }</span><span class="muted">@Describe(conn, false)</span><span>@pill</span><span class="muted">@(sets.Count == 0 ? "aucun" : sets.Count.ToString())</span></button>
                }
                else
                {
                    <button type="button" class="dsx-card" @onclick="() => ShowConn(conn.Id)">
                        <div class="dsx-top">
                            <span class="dsx-ico @(conn.Kind)">@IcoText(conn)</span>
                            <div class="grow" style="min-width:0"><b>@conn.Name</b><small>@Describe(conn, false)</small></div>
                            @pill
                        </div>
                        <div class="dsx-foot">@(sets.Count == 0 ? "Aucun jeu de données" : $"{sets.Count} jeu{(sets.Count > 1 ? "x" : "")} de données")@if (conn.Via == "relay") { <span class="dsx-via">⇄ relais</span> }<span class="grow"></span><span>@Ago(last)</span></div>
                    </button>
                }
            }
        </div>
    }
}

@if (drawerRelay is { } dr)
{
    var online = Relays.Online(dr.Id);
    var served = connections.Where(c => c.Via == "relay" && c.RelayId == dr.Id).ToList();
    <div class="dsx-veil" @onclick="CloseDrawer"></div>
    <aside class="dsx-drawer" role="dialog" aria-label="@dr.Name">
        <div class="dsx-dh">
            <span class="dsx-ico relay">⇄</span>
            <div class="grow" style="min-width:0"><h3>@dr.Name</h3>@StatePill(dr.TokenHash.Length == 0 ? "warn" : online ? "ok" : "bad", dr.TokenHash.Length == 0 ? "En attente d'appairage" : online ? "En ligne" : "Hors ligne")</div>
            <button type="button" class="modal-x" aria-label="Fermer" @onclick="CloseDrawer"><Ico Name="x" Size="18" /></button>
        </div>
        <div class="dsx-db">
            <h4>Informations</h4>
            <dl class="dsx-kv">
                <dt>Machine</dt><dd>@(dr.Machine.Length > 0 ? dr.Machine : "—")</dd>
                <dt>Version</dt><dd>@(dr.Version.Length > 0 ? dr.Version : "—")</dd>
                <dt>Créé le</dt><dd>@dr.CreatedUtc.ToLocalTime().ToString("dd.MM.yyyy")</dd>
            </dl>
            <h4>Connexions servies <span class="cat-count">@served.Count</span></h4>
            @if (served.Count == 0) { <p class="dsx-muted">Aucune source n'utilise ce relais.</p> }
            @foreach (var s in served)
            {
                var sc = s;
                <button type="button" class="dsx-set" @onclick="() => ShowConn(sc.Id)"><span>@sc.Name</span><small>@KindLabel(sc.Kind)</small></button>
            }
        </div>
        @DrawerFoot(() => OpenRelay(dr.Id), $"Le relais « {dr.Name} » sera supprimé et son jeton refusé : il s'arrêtera.", DeleteRelay)
    </aside>
}
@if (drawerConn is { } dc)
{
    var sets = dataSets.Where(d => d.ConnectionId == dc.Id).ToList();
    var level = ConnLevel(dc, sets);
    var relay = dc.Via == "relay" ? relays.FirstOrDefault(r => r.Id == dc.RelayId) : null;
    var used = sets.Sum(s => usage.GetValueOrDefault(s.Id));
    <div class="dsx-veil" @onclick="CloseDrawer"></div>
    <aside class="dsx-drawer" role="dialog" aria-label="@dc.Name">
        <div class="dsx-dh">
            <span class="dsx-ico @(dc.Kind)">@IcoText(dc)</span>
            <div class="grow" style="min-width:0"><h3>@dc.Name</h3><div class="dsx-meta">@Describe(dc, false) @StatePill(level, StateText(dc, level))</div></div>
            <button type="button" class="modal-x" aria-label="Fermer" @onclick="CloseDrawer"><Ico Name="x" Size="18" /></button>
        </div>
        <div class="dsx-db">
            <div class="dsx-route">
                <span class="dsx-node">Linkii<small>copie conservée</small></span><i></i>
                @if (dc.Via == "relay") { <span class="dsx-node r">⇄ @(relay?.Name ?? "relais supprimé")<small>relais</small></span><i></i> }
                <span class="dsx-node">@KindLabel(dc.Kind)<small>la source</small></span>
            </div>
            @if (dc.LastError.Length > 0) { <div class="dsx-alert">@dc.LastError — les écrans gardent la dernière copie.</div> }
            <div class="dsx-sech"><h4>Jeux de données <span class="cat-count">@sets.Count</span></h4><button type="button" class="btn ghost sm" disabled="@(dataSets.Count >= DataKinds.MaxDataSets)" @onclick="() => NewDataSet(dc)"><Ico Name="plus" Size="14" /> Jeu de données</button></div>
            @if (sets.Count == 0) { <p class="dsx-muted">Aucun jeu de données : ajoutez-en un pour l'utiliser dans une composition.</p> }
            @foreach (var d in sets)
            {
                var ds = d;
                var n = usage.GetValueOrDefault(ds.Id);
                <button type="button" class="dsx-dsrow" @onclick="() => OpenDataSet(ds, dc)">
                    <span><b>@ds.Name</b><small>@(dc is { Kind: DataKinds.File, FileMode: "upload" } ? "à chaque import du fichier" : DataKinds.RefreshLabel(ds.RefreshMin).ToLowerInvariant()) · @(Data.Table(clientId, ds.Id)?.Rows.Count.ToString() ?? "—") lignes</small></span>
                    <span class="r">@(n > 0 ? $"{n} composition{(n > 1 ? "s" : "")}" : "Inutilisé")<small>@Ago(Data.Last(clientId, ds.Id))</small></span>
                </button>
            }
        </div>
        @DrawerFoot(() => OpenConnection(dc), (sets.Count > 0 ? $"Ses {sets.Count} jeu{(sets.Count > 1 ? "x" : "")} de données seront supprimés aussi" + (used > 0 ? $", utilisés dans {used} composition{(used > 1 ? "s" : "")}." : ".") : "La source sera supprimée."), DeleteConn)
    </aside>
}

@if (editConn != null)
{
    <DataConnectionDialog Connection="editConn" OnClose="CloseDialogs" OnSaved="ConnectionSaved" />
}
@if (editSet != null && setConn != null)
{
    <DataSetDialog DataSet="editSet" Connection="setConn" IsNew="setIsNew" OnClose="CloseDialogs" OnSaved="Reload" />
}
@if (relayOpen)
{
    <RelayDialog RelayId="relayId" OnClose="CloseRelay" OnChanged="RelayChanged" />
}

@code {
    private Guid clientId;
    private bool allowed;
    private List<DataConnection> connections = new();
    private List<DataSet> dataSets = new();
    private List<DataRelay> relays = new();
    private bool relayOpen;
    private Guid? relayId;
    private Dictionary<Guid, int> usage = new();
    private DataConnection? editConn, setConn;
    private DataSet? editSet;
    private bool setIsNew;
    private Timer? timer;
    private string search = "", filter = "", view = "cards";   // filter : "" | "relay" | api | db | file ; view mémorisée dans le navigateur
    private Guid? drawerConnId, drawerRelayId;
    private bool confirmDel;
    private string? delError;

    /// <summary>Sous-onglet affiché : « sources » ou « relais ».</summary>
    [Parameter] public string Section { get; set; } = "sources";
    private bool onRelays => Section == "relays";
    private string shownSection = "sources";

    /// <summary>Prévient la page quand le nombre de sources ou de relais change (pastilles des onglets).</summary>
    [Parameter] public EventCallback OnCountChanged { get; set; }
    private int lastCount = -1;

    protected override void OnParametersSet()
    {
        if (shownSection != Section) { shownSection = Section; search = filter = ""; CloseDrawer(); }   // chaque sous-onglet repart sans recherche ni filtre
    }

    private DataConnection? drawerConn => drawerConnId is { } i ? connections.FirstOrDefault(c => c.Id == i) : null;
    private DataRelay? drawerRelay => drawerRelayId is { } i ? relays.FirstOrDefault(r => r.Id == i) : null;

    protected override void OnInitialized()
    {
        Reload();
        timer = new Timer(_ => InvokeAsync(StateHasChanged), null, 20000, 20000);   // états et heures de lecture tenus à jour
    }

    private void Reload()
    {
        (clientId, allowed, connections, dataSets) = Store.Read(d => (d.ClientId, DataSourceOps.Allowed(d.Tenant),
            d.Tenant.DataConnections.Select(c => c.Copy()).OrderBy(c => c.Name, StringComparer.CurrentCultureIgnoreCase).ToList(),
            d.Tenant.DataSets.Select(x => x.Copy()).OrderBy(x => x.Name, StringComparer.CurrentCultureIgnoreCase).ToList()));
        usage = Store.Read(d => dataSets.ToDictionary(x => x.Id, x => DataSourceOps.UsedBy(d, x.Id).Count));
        relays = Store.Read(d => d.Tenant.DataRelays.Select(r => r.Copy()).OrderBy(r => r.Name, StringComparer.CurrentCultureIgnoreCase).ToList());
        var count = connections.Count * 1000 + relays.Count;
        if (lastCount >= 0 && lastCount != count) _ = InvokeAsync(OnCountChanged.InvokeAsync);
        lastCount = count;
    }

    // ---- appelés par le bouton « Ajouter » de l'en-tête de la page ----
    public bool CanAddSource => allowed && connections.Count < DataKinds.MaxConnections;
    public bool CanAddRelay => allowed && relays.Count < RelayBroker.MaxPerOrg;
    public void AddSource() { if (CanAddSource) { CloseDrawer(); OpenConnection(null); StateHasChanged(); } }
    public void AddRelay() { if (CanAddRelay) { CloseDrawer(); OpenRelay(null); StateHasChanged(); } }

    private void ShowConn(Guid id) { drawerRelayId = null; drawerConnId = id; confirmDel = false; delError = null; }
    private void ShowRelay(Guid id) { drawerConnId = null; drawerRelayId = id; confirmDel = false; delError = null; }
    private void CloseDrawer() { drawerConnId = drawerRelayId = null; confirmDel = false; delError = null; }

    private void OpenRelay(Guid? id) { relayId = id; relayOpen = true; }
    private void CloseRelay() { relayOpen = false; Reload(); }
    private void RelayChanged(Guid? id) { relayId = id; Reload(); }

    private void OpenConnection(DataConnection? c) => editConn = c?.Copy() ?? new DataConnection();
    private void OpenDataSet(DataSet ds, DataConnection? c) { if (c == null) return; editSet = ds.Copy(); setConn = c.Copy(); setIsNew = false; }
    private void NewDataSet(DataConnection c) { editSet = new DataSet { ConnectionId = c.Id, Name = dataSets.Any(d => d.ConnectionId == c.Id) ? "" : c.Name }; setConn = c.Copy(); setIsNew = true; }
    private void CloseDialogs() { editConn = null; editSet = null; setConn = null; Reload(); }

    /// <summary>Connexion créée : on enchaîne sur son premier jeu de données (étape 2 de la maquette).</summary>
    private void ConnectionSaved((DataConnection C, bool Created) r)
    {
        editConn = null;
        Reload();
        if (r.Created && connections.FirstOrDefault(c => c.Id == r.C.Id) is { } c) NewDataSet(c);
    }

    /// <summary>Pied du tiroir : Modifier, Supprimer ; un premier clic sur Supprimer affiche le message de confirmation.</summary>
    private RenderFragment DrawerFoot(Action edit, string warning, Func<Task> delete) => @<div class="dsx-df">
        @if (delError != null) { <div class="dsx-alert">@delError</div> }
        @if (confirmDel)
        {
            <div class="dsx-confirm" role="alertdialog" aria-label="Confirmer la suppression">
                <b>Supprimer définitivement ?</b>
                <span>@warning</span>
                <div class="dsx-confirm-b">
                    <button type="button" class="btn ghost sm" @onclick="() => { confirmDel = false; delError = null; }">Annuler</button>
                    <button type="button" class="btn danger sm" @onclick="delete">Oui, supprimer</button>
                </div>
            </div>
        }
        else
        {
            <div class="dsx-df-b">
                <button type="button" class="btn ghost sm" @onclick="edit">Modifier</button>
                <span class="grow"></span>
                <button type="button" class="btn danger sm" @onclick="() => { confirmDel = true; delError = null; }">Supprimer</button>
            </div>
        }
    </div>;

    private Task DeleteConn()
    {
        if (drawerConn is not { } c) return Task.CompletedTask;
        var cid = Store.ClientId;
        var (ids, file) = Store.Write(db =>
        {
            var ids = db.Tenant.DataSets.Where(x => x.ConnectionId == c.Id).Select(x => x.Id).ToList();
            db.Tenant.DataSets.RemoveAll(x => x.ConnectionId == c.Id);
            var file = db.Tenant.DataConnections.FirstOrDefault(x => x.Id == c.Id)?.FileName ?? "";
            db.Tenant.DataConnections.RemoveAll(x => x.Id == c.Id);
            return (ids, file);
        });
        foreach (var id in ids) Data.Forget(cid, id);
        DataSetService.DeleteFile(cid, file);
        Toast.Ok($"Source « {c.Name} » supprimée.");
        CloseDrawer();
        Reload();
        return Task.CompletedTask;
    }

    private Task DeleteRelay()
    {
        if (drawerRelay is not { } r) return Task.CompletedTask;
        var id = r.Id;
        delError = Store.Write(d =>
        {
            if (!d.Access.IsOrgAdmin) return "Seuls les administrateurs de l'organisation gèrent les relais.";
            var used = d.Tenant.DataConnections.Where(c => c.Via == "relay" && c.RelayId == id).Select(c => c.Name).ToList();
            if (used.Count > 0) return $"Utilisé par {string.Join(", ", used.Select(u => "« " + u + " »"))} : changez d'abord leur accès.";
            d.Tenant.DataRelays.RemoveAll(x => x.Id == id);
            return null;
        });
        if (delError != null) { confirmDel = false; return Task.CompletedTask; }
        Toast.Ok("Relais supprimé.");
        CloseDrawer();
        Reload();
        return Task.CompletedTask;
    }

    private bool Match(string text) => search.Trim().Length == 0 || text.Contains(search.Trim(), StringComparison.OrdinalIgnoreCase);
    private static string KindLabel(string kind) => kind == DataKinds.Api ? "API web" : kind == DataKinds.Db ? "Base de données" : "Fichier";
    private static string IcoText(DataConnection c) => c.Kind == DataKinds.Api ? "{ }" : c.Kind == DataKinds.Db ? "SQL" : FileExt(c);

    private static string StateText(DataConnection c, string level) =>
        c.LastError.Length > 0 ? "Erreur" : level == "bad" ? "Lecture en échec" : level == "warn" ? "Copie conservée" : "Connectée";

    private string ConnLevel(DataConnection c, List<DataSet> sets)
    {
        if (c.LastError.Length > 0) return "bad";
        var levels = sets.Select(s => Data.Last(clientId, s.Id)?.Level).ToList();
        return levels.Contains("bad") ? "bad" : levels.Contains("warn") ? "warn" : "ok";
    }

    private static string FileExt(DataConnection c) =>
        Path.GetExtension(c.FileMode == "url" ? new Uri(c.FileUrl.Length > 0 ? c.FileUrl : "https://x/").AbsolutePath : c.FileLabel).TrimStart('.').ToUpperInvariant() is { Length: > 0 and <= 4 } e ? e : "CSV";

    private string Describe(DataConnection c, bool withRelay = true) => (c.Kind switch
    {
        DataKinds.Api => "API web · " + (c.Auth switch { "key" => "clé API", "bearer" => "jeton", "basic" => "utilisateur et mot de passe", "login" => "identifiants puis jeton", _ => "sans authentification" }),
        DataKinds.Db => DataSql.Engines.FirstOrDefault(e => e.Id == c.Engine).Label + (c.Database.Length > 0 ? " · " + c.Database : ""),
        _ => c.FileMode == "url" ? "Fichier · lu à son adresse" : "Fichier importé · " + c.FileLabel
    }) + (withRelay && c.Via == "relay" ? " · par " + (relays.FirstOrDefault(r => r.Id == c.RelayId)?.Name ?? "un relais supprimé") : "");

    internal static string Ago(DataReadLog? l)
    {
        if (l == null) return "pas encore lu";
        var s = (DateTime.UtcNow - l.Utc).TotalSeconds;
        return s < 60 ? $"il y a {Math.Max(1, (int)s)} s" : s < 3600 ? $"il y a {(int)(s / 60)} min" : s < 86400 ? $"il y a {(int)(s / 3600)} h" : "le " + l.Utc.ToLocalTime().ToString("dd.MM à HH:mm");
    }

    internal static RenderFragment StatePill(string level, string text) => @<span class="pill @(level is "ok" or "warn" or "bad" ? level : "") dsx-pill"><i></i>@text</span>;

    public void Dispose() => timer?.Dispose();
}
