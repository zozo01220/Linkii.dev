@inject TenantStore Store
@inject Notifier Notifier
@inject Toaster Toast
@inject ModeService Modes

@* « Paramètres de l'écran » : Affichage (matériel, résolution, miroir) et Appareil (démarrage automatique ; sur un PC Windows, fenêtre et moniteur).
   Tout s'applique dès l'enregistrement, sans publier. La section Appareil n'apparaît qu'une fois l'appareil connu (player Windows ou Android). *@
<div class="modal-backdrop picker-backdrop" @onclick="Cancel"></div>
<div class="modal app-modal ci-adv sp-dlg" role="dialog" aria-modal="true" aria-labelledby="sp-title">
    <div class="modal-head">
        <div class="grow" style="min-width:0">
            <h3 id="sp-title">Paramètres de l'écran</h3>
            <small>@name@if (kind != null && kind != "web") { <text> · </text><span class="sp-dev"><DeviceLogo Kind="@kind" Size="16" />@(os ?? "Appareil")@if (app is { Length: > 0 } && app != "web") { <text> · App @app</text> }</span> }</small>
        </div>
        <button type="button" class="modal-x" aria-label="Fermer" @onclick="Cancel"><Ico Name="x" Size="20" /></button>
    </div>
    <div class="modal-body">
        <div class="sp-sec">Affichage</div>
        <ScreenFormat Spec="spec" Compact="true" AdvancedOnly="true" Detected="@detected" OnChange="StateHasChanged" />
        <div class="fmt-block sp-mirror">
            <label>Miroir de l'affichage</label>
            <div class="sp-mirror-row">
                <button type="button" class="switch @(mirrorH ? "on" : "")" role="switch" aria-checked="@(mirrorH ? "true" : "false")" aria-label="Miroir horizontal" title="Inverse la gauche et la droite" @onclick="() => mirrorH = !mirrorH"><span></span></button><span>Horizontal</span>
                <button type="button" class="switch @(mirrorV ? "on" : "")" role="switch" aria-checked="@(mirrorV ? "true" : "false")" aria-label="Miroir vertical" title="Inverse le haut et le bas ; les deux ensemble : écran fixé à l'envers" @onclick="() => mirrorV = !mirrorV"><span></span></button><span>Vertical</span>
            </div>
        </div>

        @if (Modes.Expert)
        {
        @* mode simple : pas de paramètres pour les compositions (ceux déjà saisis restent enregistrés) *@
        <div class="sp-sec">Paramètres pour les compositions</div>
        <p class="hint" style="margin-top:0">Valeurs propres à cet écran (par ex. Étage = 2), lues par les compositions : un champ « Cet écran », ou le filtre d'une liste reliée. Un seul modèle sert ainsi à tous les écrans.</p>
        <div class="sp-params">
            @foreach (var p in screenParams)
            {
                var sp = p;
                <div class="sp-param">
                    <input type="text" @bind="sp.Name" maxlength="40" placeholder="Nom (Étage)" aria-label="Nom du paramètre" />
                    <input type="text" @bind="sp.Value" maxlength="200" placeholder="Valeur" aria-label="Valeur du paramètre" />
                    <button type="button" class="modal-x" aria-label="Retirer le paramètre" @onclick="() => screenParams.Remove(sp)"><Ico Name="x" Size="16" /></button>
                </div>
            }
            @if (screenParams.Count < 12) { <button type="button" class="btn ghost sm" @onclick="() => screenParams.Add(new ScreenParam())"><Ico Name="plus" Size="14" /> Ajouter un paramètre</button> }
        </div>
        }

        @if (roomCalendars.Count > 0 && !isRoomScreen && !isKiosk)   @* écran de salle : sa salle se choisit dans « Modifier l'écran de salle » *@
        {
            <div class="sp-sec">Calendrier de la salle</div>
            <p class="hint" style="margin-top:0">Pour les compositions « Réservation de salle » : la porte de salle de cet écran lit ce calendrier. Une même composition sert toutes les tablettes. Sans calendrier choisi, l'écran affiche « Salle non choisie » en gris, jamais un faux « Libre ».</p>
            <select class="sp-room" style="width:100%" aria-label="Calendrier de la salle" @bind="roomCalendar">
                <option value="">(aucun)</option>
                @foreach (var r in roomCalendars) { <option value="@r.Id">@r.Name</option> }
                @if (roomCalendar != "" && !roomCalendars.Any(r => r.Id.ToString() == roomCalendar)) { <option value="@roomCalendar">Calendrier introuvable ou plus utilisé comme salle</option> }
            </select>
        }

        <div class="sp-sec">Localisation</div>
        <div class="sp-row">
            <div class="grow"><b>Afficher cet écran sur la carte</b><small>Seul le pays est utilisé, jamais l'adresse IP. Désactivé : l'écran n'apparaît pas sur la carte de la plateforme et aucune position n'est conservée.</small></div>
            <button type="button" class="switch @(geoOn ? "on" : "")" role="switch" aria-checked="@(geoOn ? "true" : "false")" aria-label="Afficher cet écran sur la carte" @onclick="() => geoOn = !geoOn"><span></span></button>
        </div>
        @if (geoOn)
        {
            <div class="fmt-block">
                <label>Mode</label>
                <div class="sp-seg" role="radiogroup" aria-label="Mode de localisation">
                    <button type="button" role="radio" aria-checked="@(!geoManual ? "true" : "false")" class="@(!geoManual ? "on" : "")" @onclick="() => geoManual = false">Automatique</button>
                    <button type="button" role="radio" aria-checked="@(geoManual ? "true" : "false")" class="@(geoManual ? "on" : "")" @onclick="() => geoManual = true">Manuel</button>
                </div>
            </div>
            @if (!geoManual)
            {
                <p class="hint">Pays déduit de l'adresse IP de l'écran.@(geoCountry != null ? " Détecté : " + WorldGeo.NameOf(geoCountry) + (geoUtc is { } gu ? " (" + gu.ToLocalTime().ToString("d MMM HH:mm", System.Globalization.CultureInfo.GetCultureInfo("fr-CH")) + ")" : "") + "." : " Rien de détecté pour l'instant : l'écran doit d'abord se connecter depuis Internet.")</p>
            }
            else
            {
                <div class="fmt-block">
                    <label id="sp-geo-l">Pays</label>
                    <select style="width:100%" aria-labelledby="sp-geo-l" @bind="geoManualCountry">
                        <option value="">(choisir un pays)</option>
                        @foreach (var c in WorldGeo.Countries) { <option value="@c.Code">@c.Name</option> }
                    </select>
                    <p class="hint">Prime sur la détection automatique : utile derrière un VPN ou un réseau d'entreprise centralisé.</p>
                </div>
            }
        }

        @if (HasDevice)
        {
            <div class="sp-sec">Appareil</div>
            <div class="sp-row">
                <div class="grow"><b>Démarrage automatique</b><small>@(IsPc ? "Le player démarre avec Windows et revient tout seul après une coupure." : kind == "raspberrypi" ? "Le player démarre avec la session du Raspberry et revient tout seul après une coupure." : "Le player démarre avec le boîtier.")</small></div>
                <button type="button" class="switch @(autoStart ? "on" : "")" role="switch" aria-checked="@(autoStart ? "true" : "false")" aria-label="Démarrage automatique" @onclick="() => autoStart = !autoStart"><span></span></button>
            </div>
            @if (IsPc)
            {
                <div class="sp-row">
                    <div class="grow"><b>Afficher dans une fenêtre</b><small>Pour les tests : une fenêtre à la taille de la résolution (réduite si le moniteur est plus petit) au lieu du plein écran.</small></div>
                    <button type="button" class="switch @(windowed ? "on" : "")" role="switch" aria-checked="@(windowed ? "true" : "false")" aria-label="Afficher dans une fenêtre" @onclick="() => windowed = !windowed"><span></span></button>
                </div>
                @if (monitors.Count > 1)
                {
                    <div class="fmt-block sp-monitor">
                        <label id="sp-mon-l">Moniteur</label>
                        <MonitorPicker Monitors="monitors" Value="monitor" ValueChanged="v => monitor = v" Taken="taken" Windowed="windowed" LabelledBy="sp-mon-l" />
                        <p class="hint">Liste remontée par le PC. Un moniteur déjà pris par un autre écran de ce PC est signalé.</p>
                    </div>
                }
            }
            else
            {
                <p class="hint">Pas de fenêtre ni de choix du moniteur : un boîtier n'a qu'un écran.</p>
            }
        }
    </div>
    <div class="modal-foot">
        <button type="button" class="btn ghost" @onclick="Cancel">Annuler</button>
        <button type="button" class="btn" disabled="@saving" @onclick="Save">Enregistrer</button>
    </div>
</div>

@code {
    [Parameter, EditorRequired] public Guid ScreenId { get; set; }
    /// <summary>Orientation en cours d'édition (éditeur d'écran), pour afficher la résolution dans le bon sens.</summary>
    [Parameter] public string? Orientation { get; set; }
    [Parameter] public EventCallback OnClose { get; set; }
    /// <summary>Après l'enregistrement (l'éditeur d'écran relit le format).</summary>
    [Parameter] public EventCallback OnSaved { get; set; }

    private ScreenSpec spec = new();
    private string name = "";
    private string? kind, os, app, detected;
    private bool mirrorH, mirrorV, autoStart, windowed, saving;
    private int monitor = 1;
    private List<DeviceMonitor> monitors = new();
    private Dictionary<int, string> taken = new();   // moniteur → écran du même PC qui l'occupe en plein écran
    private List<ScreenParam> screenParams = new();   // paramètres pour les compositions (§139)
    private List<(Guid Id, string Name)> roomCalendars = new();   // calendriers utilisés comme salle (interrupteur « Salle » dans Applications)
    private string roomCalendar = "";
    private bool isKiosk;
    private bool isRoomScreen;   // écran de salle (application Réservation de salle)

    private bool geoOn = true, geoManual;   // localisation (carte de l'admin) : affichée sur la carte, mode manuel
    private string? geoCountry;             // pays détecté ou choisi
    private DateTime? geoUtc;
    private string geoManualCountry = "";

    private bool IsPc => kind == "windows";
    private bool HasDevice => kind is "windows" or "androidtv" or "android" or "raspberrypi";

    protected override void OnInitialized()
    {
        var s = Store.Read(d => d.Screens.First(x => x.Id == ScreenId));
        name = s.Name;
        (kind, os, app) = (s.DeviceKind, s.DeviceOs, s.DeviceApp);
        spec = new ScreenSpec { Type = s.ScreenType, Orientation = Orientation ?? s.Orientation, Resolution = s.Resolution };
        if (s.DetectedW > 0) detected = $"{s.DetectedW} × {s.DetectedH}";
        (mirrorH, mirrorV) = (s.MirrorH, s.MirrorV);
        (autoStart, windowed, monitor) = (s.AutoStart, s.Windowed, s.Monitor);
        monitors = s.DeviceMonitors.OrderBy(m => m.N).ToList();
        (geoOn, geoManual, geoCountry, geoUtc) = (s.GeoMode != Geo.Off, s.GeoMode == Geo.Manual, s.GeoCountry, s.GeoUtc);
        geoManualCountry = s.GeoMode == Geo.Manual ? s.GeoCountry ?? "" : "";
        screenParams = s.Params.Select(p => new ScreenParam { Name = p.Name, Value = p.Value }).ToList();
        roomCalendars = Store.Read(d => SharedCalendarSources.RoomContents(d.Tenant).Select(m => (m.Id, m.Name)).ToList());
        roomCalendar = s.RoomCalendarId?.ToString() ?? "";
        isRoomScreen = s.Room != null; isKiosk = s.Kiosk != null;
        taken = Store.Read(d => DeviceConfig.SamePc(d.Screens, s).Where(x => !x.Windowed).GroupBy(x => x.Monitor).ToDictionary(g => g.Key, g => g.First().Name));
    }

    private Task Cancel() => OnClose.InvokeAsync();

    private async Task Save()
    {
        saving = true;
        var sp = spec; var (mh, mv, au, wi, mo) = (mirrorH, mirrorV, autoStart, windowed, monitor);
        Guid? room = Guid.TryParse(roomCalendar, out var rg) ? rg : null;
        // paramètres nommés, sans doublon de clé (« Étage » et « etage » sont le même paramètre : le premier est gardé)
        var pars = screenParams.Select(p => new ScreenParam { Name = p.Name.Trim(), Value = p.Value.Trim() }).Where(p => p.Name.Length > 0)
            .GroupBy(p => DataTables.Slug(p.Name)).Select(g => g.First()).ToList();
        try
        {
            var changed = Store.Write(d =>
            {
                var s = d.Screens.First(x => x.Id == ScreenId);
                var c = s.RoomCalendarId != room || s.ScreenType != sp.Type || s.Resolution != sp.Resolution || s.MirrorH != mh || s.MirrorV != mv
                    || s.AutoStart != au || s.Windowed != wi || s.Monitor != mo;
                s.ScreenType = sp.Type; s.Resolution = sp.Resolution;
                s.Layout = ScreenLayouts.Fit(ScreenLayouts.Find(s.Layout).Id, new ScreenSpec { Type = sp.Type, Orientation = s.Orientation, Resolution = sp.Resolution });   // découpage encore permis
                s.MirrorH = mh; s.MirrorV = mv;
                s.AutoStart = au; s.Windowed = wi; s.Monitor = mo;
                // localisation : rien à envoyer à l'écran ni à publier. Manuel sans pays choisi = automatique.
                var manualCc = geoManual ? Geo.Valid(geoManualCountry) : null;
                if (!geoOn) { s.GeoMode = Geo.Off; s.GeoCountry = null; s.GeoUtc = null; }
                else if (manualCc != null) { s.GeoMode = Geo.Manual; s.GeoCountry = manualCc; s.GeoUtc = null; }
                else { if (s.GeoMode != Geo.Auto) { s.GeoCountry = null; s.GeoUtc = null; } s.GeoMode = Geo.Auto; }
                s.RoomCalendarId = room;   // lu avec la source « Cet écran » : rien à publier
                s.Params = pars;   // lus par l'écran à la prochaine lecture de la source « Cet écran » : rien à publier
                return c;
            });
            if (changed) await Notifier.NotifyScreen(ScreenId);   // l'écran recharge sa configuration, sans publication
        }
        finally { saving = false; }
        Toast.Ok($"Paramètres de « {name} » enregistrés.");
        await OnSaved.InvokeAsync();
        await OnClose.InvokeAsync();
    }
}
