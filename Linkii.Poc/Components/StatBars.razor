@* Barres verticales d'une répartition (passages ou scans), par heure ou par jour. *@
<div class="st-chart" role="img" aria-label="@Label">
    @foreach (var b in Data)
    {
        <div class="st-col" title="@b.Label : @b.Count">
            <span class="st-col-bar" style="height:@(b.Count == 0 ? 0 : Math.Max(3, b.Count * 100 / Max))%"></span>
            <span class="st-col-lbl">@b.Short</span>
        </div>
    }
</div>

@code {
    [Parameter, EditorRequired] public List<(string Label, string Short, int Count)> Data { get; set; } = new();
    [Parameter] public string Label { get; set; } = "Répartition";

    private int Max => Math.Max(1, Data.Count == 0 ? 1 : Data.Max(b => b.Count));
}
