@implements IDisposable
@inject MenuBadges Badges
@* Pastille rouge d'un onglet de bibliothèque (« Partagés avec moi »…) : nombre d'éléments nouveaux qu'il montre. Elle s'éteint quand l'onglet est ouvert (voir NewMark). *@

@if (Badges.TabNew(Family, Tab) is > 0 and var n)
{
    <span class="nbadge red tab @(Badges.Bumping(Family) ? "bump" : "")" title="@n nouveau@(n > 1 ? "x" : "")">@n</span>
}

@code {
    [Parameter, EditorRequired] public string Family { get; set; } = "";
    [Parameter, EditorRequired] public string Tab { get; set; } = "";

    protected override void OnInitialized() => Badges.Changed += OnChanged;
    private void OnChanged() => InvokeAsync(StateHasChanged);
    public void Dispose() => Badges.Changed -= OnChanged;
}
