@* « Continuer avec Microsoft / Google » (création d'un espace ou connexion). Navigation complète : le départ redirige vers le fournisseur. *@
@if (WithMicrosoft || WithGoogle)
{
    <div class="sso">
        @if (WithMicrosoft)
        {
            <a class="sso-btn" href="/login/sso/microsoft?mode=@Mode" data-enhance-nav="false"><ProviderLogo Provider="@SignupSources.Microsoft" Size="18" />Continuer avec Microsoft</a>
        }
        @if (WithGoogle)
        {
            <a class="sso-btn" href="/login/sso/google?mode=@Mode" data-enhance-nav="false"><ProviderLogo Provider="@SignupSources.Google" Size="18" />Continuer avec Google</a>
        }
    </div>
}

@code {
    [Parameter] public string Mode { get; set; } = "login";
    [Parameter] public bool WithMicrosoft { get; set; }
    [Parameter] public bool WithGoogle { get; set; }
}
