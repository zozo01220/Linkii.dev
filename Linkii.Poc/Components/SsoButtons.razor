@* « Continuer avec Microsoft / Google / LinkedIn / GitHub » (création d'un espace ou connexion). Navigation complète : le départ redirige vers le fournisseur. *@
@if (Shown.Any())
{
    <div class="sso">
        @foreach (var p in Shown)
        {
            var label = $"Continuer avec {SignupSources.Label(p)}";
            <a class="sso-btn" href="/login/sso/@p?mode=@Mode" data-enhance-nav="false"><ProviderLogo Provider="@p" Size="18" />@label</a>
        }
    </div>
}

@code {
    [Parameter] public string Mode { get; set; } = "login";
    [Parameter] public bool WithMicrosoft { get; set; }
    [Parameter] public bool WithGoogle { get; set; }
    [Parameter] public bool WithLinkedIn { get; set; }
    [Parameter] public bool WithGitHub { get; set; }

    private IEnumerable<string> Shown => new[]
    {
        (SignupSources.Microsoft, WithMicrosoft), (SignupSources.Google, WithGoogle),
        (SignupSources.LinkedIn, WithLinkedIn), (SignupSources.GitHub, WithGitHub)
    }.Where(x => x.Item2).Select(x => x.Item1);
}
