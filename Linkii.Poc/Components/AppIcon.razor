@inject AppService Svc
@* Icône d'une app : pastille ronde de couleur et pictogramme blanc (Tile), ou pictogramme seul (vignettes sur fond sombre).
   Une app sans pictogramme connu garde l'emoji de son manifeste, sur fond neutre. *@
@if (BrandLogos.Has(Id))
{
    @* vrai logo du fournisseur, sans pastille de couleur ; sur fond sombre, une pastille blanche pour les logos sans fond propre *@
    <span class="app-ico is-brand @(Small ? "sm" : "") @(!Tile && BrandLogos.NeedsWhiteOnDark(Id) ? "on-dark" : "")" style="@(Tile ? "" : $"--bs:{Size}px")"><BrandLogo Id="@Id" Size="@(Tile ? (Small ? 34 : 46) : Size)" />@if (Tile && Connected is { } bc) { <span class="app-dot @(bc ? "ok" : "off")" title="@(bc ? "Connectée" : "Non connectée")"><span class="sr-only">@(bc ? "Connectée" : "Non connectée")</span></span> }</span>
}
else if (Tile)
{
    <span class="app-ico @(Small ? "sm" : "")" style="--app-c:@Look.Color">@Glyph@if (Connected is { } c) { <span class="app-dot @(c ? "ok" : "off")" title="@(c ? "Connectée" : "Non connectée")"><span class="sr-only">@(c ? "Connectée" : "Non connectée")</span></span> }</span>
}
else
{
    @Glyph
}

@code {
    [Parameter] public string? Id { get; set; }
    [Parameter] public bool Tile { get; set; } = true;
    [Parameter] public bool Small { get; set; }
    [Parameter] public int Size { get; set; } = 24;
    /// <summary>App reliée à un compte externe (Canva…) : pastille verte si connectée, rouge sinon ; null : pas de pastille.</summary>
    [Parameter] public bool? Connected { get; set; }

    // Couleur de la pastille et pictogramme (Ico) de chaque app du catalogue.
    public static (string Color, string? Icon) LookOf(string? id) => id switch
    {
        "homeassistant" => ("#41BDF5", "home"),
        "ha-sensors" => ("#41BDF5", "gauge"),
        "ha-switches" => ("#41BDF5", "power"),
        "ha-lights" => ("#F2B01E", "bulb"),
        "text" => ("#4F6BED", "type"),
        "rss" => ("#F2541B", "rss"),
        "facebook" => ("#1877F2", "facebook"),
        "agenda" => ("#2FA66A", "calendar"),
        "clock" => ("#0B1F3A", "clock"),
        "weather" => ("#3D63F2", "sun"),
        "weather-slide" => ("#3D63F2", "sun"),
        "qrcode" => ("#0B1F3A", "qr"),
        "countdown" => ("#E8590C", "hourglass"),
        "quote" => ("#7B5CC4", "quote"),
        "webpage" => ("#3A9399", "globe"),
        "image" => ("#F0A92E", "image"),
        "slideshow-images" => ("#F0A92E", "images"),
        "video" => ("#7B5CC4", "play"),
        "slideshow-videos" => ("#7B5CC4", "play-box"),
        "youtube" => ("#E3261D", "play"),
        "canva" => ("#00A3B4", "palette"),
        "composition" => ("#4F6BED", "grid"),
        "pdf" => ("#C0392B", "file"),
        "google-slides" => ("#F4B400", "images"),
        "google-docs" => ("#4285F4", "file"),
        "ms-powerpoint" => ("#C43E1C", "images"),
        // sources des calendriers partagés : la couleur de l'app Calendrier partagé, le pictogramme de la source
        "cal-m365" => ("#2FA66A", "windows"),
        "cal-google" => ("#2FA66A", "google"),
        "cal-caldav" => ("#2FA66A", "server"),
        "cal-ics" => ("#2FA66A", "link"),
        "cal-ews" => ("#2FA66A", "mail"),
        // Drives : l'app Dossier Drive et ses sources
        "drive" => ("#0F6CBD", "folder"),
        "drv-gdrive" => ("#0F6CBD", "google"),
        "drv-onedrive" => ("#0F6CBD", "cloud"),
        "drv-nextcloud" => ("#0F6CBD", "cloud"),
        "drv-sftp" => ("#0F6CBD", "server"),
        "drv-dropbox" => ("#0F6CBD", "folder"),
        _ => ("#5A6B80", null)
    };

    private (string Color, string? Icon) Look => LookOf(Id);

    private RenderFragment Glyph => b =>
    {
        if (Id is "homeassistant" or "ha-sensors" or "ha-switches" or "ha-lights")   // logo Home Assistant : blanc sur la pastille de l'app
        {
            b.OpenComponent<HaLogo>(1);
            b.AddComponentParameter(2, nameof(HaLogo.Size), Tile ? (Small ? 17 : 22) : Size);
            b.AddComponentParameter(3, nameof(HaLogo.Fill), Tile ? "#FFFFFF" : Look.Color);
            b.AddComponentParameter(4, nameof(HaLogo.Eye), Tile ? Look.Color : "#FFFFFF");
            b.CloseComponent();
        }
        else if (Look.Icon is { } name)
        {
            b.OpenComponent<Ico>(1);
            b.AddComponentParameter(2, nameof(Ico.Name), name);
            b.AddComponentParameter(3, nameof(Ico.Size), Tile ? (Small ? 17 : 22) : Size);
            b.CloseComponent();
        }
        else b.AddContent(4, Svc.Find(Id)?.Icon ?? "🧩");
    };
}
