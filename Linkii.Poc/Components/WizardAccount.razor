@* Étape « Compte » d'un compte OAuth, identique pour toutes les applications (maquette assistant-ajout-simplifie.html) :
   grand bouton de connexion, ce que Linkivi fait et ne fait jamais, détails techniques repliés ; compte déjà connecté : carte + « Utiliser un autre compte ». *@
<div class="cw-body">
    @if (Connected)
    {
        <h2 class="cw-h">Votre compte @Provider est connecté</h2>
        <p class="cw-lead">Linkivi l'utilisera pour cette application.</p>
        <div class="cw-acct">
            <AccountLogo Kind="@Kind" />
            <div class="grow">
                <b>@(User.Length > 0 ? User : Provider)</b>
                <small>Connecté@(Since is { } s ? $" le {s.ToLocalTime():dd.MM.yyyy}" : "")</small>
            </div>
            <span class="cw-okmark">✓ Prêt</span>
        </div>
        @if (Ready) { <p><a class="cw-sub" href="@ConnectUrl" target="_top">Utiliser un autre compte</a></p> }
    }
    else if (!Ready)
    {
        <h2 class="cw-h">Connectez votre compte @Provider</h2>
        <div class="dw-note">@Provider n'est pas encore disponible sur cette plateforme (connexion @Provider à configurer par l'administrateur Linkivi).</div>
    }
    else
    {
        <h2 class="cw-h">@(Lost ? "Reconnectez votre compte " + Provider : "Connectez votre compte " + Provider)</h2>
        <p class="cw-lead">@(Lost ? "La connexion a expiré : une nouvelle autorisation est nécessaire." : Missing)</p>
        <div class="cw-connect">
            <AccountLogo Kind="@Kind" />
            <a class="cw-bigbtn" href="@ConnectUrl" target="_top">Continuer avec @Provider</a>
            <small>Une fenêtre @Provider s'ouvre pour confirmer. Vous reviendrez ici ensuite.</small>
        </div>
    }
    @if (Ready)
    {
        <div class="cw-can">
            <div>@foreach (var t in Does) { <div class="y"><i>✓</i>@t</div> }</div>
            <div>@foreach (var t in Never) { <div class="n"><i>✕</i>@t</div> }</div>
        </div>
        <p class="csd-shared"><Ico Name="lock" Size="14" /> Vous pouvez retirer l'accès à tout moment depuis Réglages › Connexions. Linkivi ne voit jamais votre mot de passe.</p>
        @if (Permissions.Length > 0)
        {
            <details class="cw-tech"><summary>Voir les détails techniques</summary>
                <ul>@foreach (var p in Permissions) { <li>@p</li> }<li>Rien n'est modifié ni supprimé chez @Provider</li></ul>
            </details>
        }
    }
</div>

@code {
    /// <summary>Type de compte (<see cref="ConnectedAccounts"/>) : logo.</summary>
    [Parameter, EditorRequired] public string Kind { get; set; } = "";
    [Parameter, EditorRequired] public string Provider { get; set; } = "";
    [Parameter] public bool Ready { get; set; } = true;
    [Parameter] public bool Connected { get; set; }
    [Parameter] public bool Lost { get; set; }
    [Parameter] public string User { get; set; } = "";
    [Parameter] public DateTime? Since { get; set; }
    [Parameter] public string ConnectUrl { get; set; } = "";
    [Parameter] public string Missing { get; set; } = "";
    [Parameter] public string[] Permissions { get; set; } = Array.Empty<string>();
    [Parameter] public string[]? CanDo { get; set; }
    [Parameter] public string[]? CannotDo { get; set; }
    private string[] Does => CanDo ?? new[] { "Voir vos contenus " + Provider, "Les afficher sur vos écrans" };
    private string[] Never => CannotDo ?? new[] { "Modifier ou supprimer vos fichiers", "Publier à votre place" };
}
