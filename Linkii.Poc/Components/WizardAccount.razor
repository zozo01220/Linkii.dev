@* Étape « Connexion » d'un compte OAuth, identique pour toutes les intégrations (maquette canva-assistant-ajout.html) :
   carte du compte (avatar, nom, état), bouton de connexion ou « Changer de compte », droits demandés, note sur le mot de passe. *@
<div class="cw-body">
    <div class="cvs-account">
        <AccountLogo Kind="@Kind" />
        <div class="grow">
            <b>@(Connected ? (User.Length > 0 ? User : Provider) : Lost ? "Connexion expirée" : "Aucun compte connecté")</b>
            <small>@(Connected ? $"Connecté{(Since is { } s ? $" le {s.ToLocalTime():dd.MM.yyyy}" : "")} · lecture seule : rien n'est modifié chez {Provider}." : Lost ? $"Reconnectez votre compte {Provider}." : Missing)</small>
        </div>
        @if (Ready)
        {
            <a class="btn @(Connected ? "ghost" : "") sm" href="@ConnectUrl" target="_top">@(Connected ? "Changer de compte" : Lost ? $"Reconnecter {Provider}" : $"Se connecter avec {Provider}")</a>
        }
    </div>
    @if (!Ready) { <div class="dw-note">@Provider n'est pas encore disponible sur cette plateforme (connexion @Provider à configurer par l'administrateur Linkivi).</div> }
    else
    {
        <ul class="cw-perm">@foreach (var p in Permissions) { <li>@p</li> }<li>Rien n'est modifié ni supprimé chez @Provider</li></ul>
        <p class="csd-shared"><Ico Name="lock" Size="14" /> Vous passez par la page de connexion de @Provider : Linkivi ne voit jamais votre mot de passe.</p>
    }
</div>

@code {
    /// <summary>Type de compte (<see cref="ConnectedAccounts"/>) : logo.</summary>
    [Parameter, EditorRequired] public string Kind { get; set; } = "";
    [Parameter, EditorRequired] public string Provider { get; set; } = "";
    [Parameter] public bool Ready { get; set; } = true;
    [Parameter] public bool Connected { get; set; }
    [Parameter] public bool Lost { get; set; }
    [Parameter] public string User { get; set; } = "";
    [Parameter] public DateTime? Since { get; set; }
    [Parameter] public string ConnectUrl { get; set; } = "";
    [Parameter] public string Missing { get; set; } = "";
    [Parameter] public string[] Permissions { get; set; } = Array.Empty<string>();
}
