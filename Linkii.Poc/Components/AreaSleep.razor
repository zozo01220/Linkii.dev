@inject TenantStore Store
@inject Notifier Notifier
@inject Toaster Toast
@inject HistoryLog Hist
@inject TenantContext HCtx

@* Mise en veille d'une aire : son fuseau horaire et ses plages, par défaut de tous ses écrans (chacun peut les remplacer). Voir Sleep. *@
@if (loaded)
{
    <div class="sl-tzrow"><label class="lbl" for="sl-tz" style="margin:0">Fuseau des plages</label>
    <select id="sl-tz" class="full" @bind="tz">
        <option value="">Celui de l'organisation (@orgTz)</option>
        @foreach (var z in Zones) { <option value="@z">@z</option> }
    </select></div>
    <label class="lbl">Plages de veille <small>(cliquez ou glissez pour peindre)</small></label>
    <SleepGrid @bind-Grid="grid" @bind-Grid:after="Edited" />
    @if (!Embedded) { <div class="rg-stick" style="margin-top:14px"><button type="button" class="btn" @onclick="Save">Enregistrer la mise en veille</button></div> }
    <p class="hint sl-hint" style="margin:10px 0 0">Les écrans de l'aire s'éteignent pendant ces plages. Un écran peut suivre l'aire, ne jamais s'éteindre ou avoir ses propres plages (fenêtre de l'écran).</p>
}

@code {
    [Parameter, EditorRequired] public Guid AreaId { get; set; }
    /// <summary>Appelé après l'enregistrement (la page appelante se met à jour).</summary>
    [Parameter] public EventCallback OnSaved { get; set; }
    /// <summary>Dans les Réglages : le bouton « Enregistrer » de la page enregistre aussi les plages (pas de bouton ici).</summary>
    [Parameter] public bool Embedded { get; set; }
    [Parameter] public EventCallback OnEdited { get; set; }
    private Task Edited() => OnEdited.InvokeAsync();

    internal static readonly string[] Zones =
    {
        "Europe/Zurich", "Europe/Paris", "Europe/Brussels", "Europe/London", "Europe/Berlin", "Europe/Rome",
        "America/Montreal", "America/New_York", "Africa/Casablanca", "UTC"
    };

    private bool loaded;
    private string? grid;
    private string tz = "", orgTz = "";

    protected override void OnInitialized()
    {
        (grid, tz, orgTz) = Store.Read(d => (d.Areas.FirstOrDefault(a => a.Id == AreaId)?.SleepGrid, d.Areas.FirstOrDefault(a => a.Id == AreaId)?.SleepTz ?? "", d.Tenant.Timezone));
        if (!Sleep.Any(grid)) grid = Sleep.Suggested();   // première ouverture : nuits et week-ends, à ajuster
        loaded = true;
    }

    private Task Save() => Persist();

    /// <summary>Résumé lisible d'une grille pour l'historique : « 52 h de veille par semaine (Europe/Zurich) ».</summary>
    private static string Describe(string? g, string? z) =>
        !Sleep.Any(g) ? "Aucune plage de veille" : $"{g!.Count(c => c == '1')} h de veille par semaine{(string.IsNullOrEmpty(z) ? "" : $" ({z})")}";

    /// <summary>Enregistre le fuseau et les plages (appelé par le bouton de la fenêtre, ou par « Enregistrer » des Réglages).</summary>
    public async Task<bool> Persist()
    {
        var g = Sleep.Valid(grid) ? grid! : new string('0', Sleep.Cells);
        var z = tz;
        string? areaName = null, before = null;
        Store.Write(d =>
        {
            if (d.Areas.FirstOrDefault(a => a.Id == AreaId) is not { } a) return;
            areaName = a.Name; before = Describe(a.SleepGrid, a.SleepTz);
            a.SleepGrid = Sleep.Any(g) ? g : null;
            a.SleepTz = string.IsNullOrEmpty(z) ? null : z;
        });
        var after = Describe(Sleep.Any(g) ? g : null, string.IsNullOrEmpty(z) ? null : z);
        if (before != after) Hist.By(HCtx, History.Sleep, $"Plage de veille de l'aire « {areaName} » modifiée", Notifs.Info, null, "area", AreaId, areaName, null, before, after, channel: History.Screens);
        await Notifier.NotifyArea(AreaId);   // les écrans de l'aire rechargent leur configuration
        Toast.Ok("Mise en veille enregistrée.");
        await OnSaved.InvokeAsync();
        return true;
    }
}
