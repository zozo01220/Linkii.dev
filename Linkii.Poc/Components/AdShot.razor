@* Aperçu d'un visuel de spot, au format de l'écran (paysage ou portrait), avec l'étiquette « Publicité » ajoutée par Linkivi.
   Blur : rendu d'un format approché (autre orientation) — visuel centré sur un fond flouté, jamais déformé ni recadré. *@
<div class="ad-shot @(Portrait ? "port" : "land") @(Small ? "sm" : "")">
    @if (Blur && Type != "video") { <div class="bg" style="background-image:url('@Url')"></div> }
    @if (Type == "video") { <video src="@Url" muted autoplay loop playsinline></video> }
    else { <img src="@Url" alt="" /> }
    <span class="tag">@Ads.Tag</span>
</div>

@code {
    [Parameter] public string Url { get; set; } = "";
    [Parameter] public string? Type { get; set; }
    [Parameter] public bool Portrait { get; set; }
    [Parameter] public bool Blur { get; set; }
    [Parameter] public bool Small { get; set; }
}
