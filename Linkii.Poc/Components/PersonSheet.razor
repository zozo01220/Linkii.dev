@inject TenantStore Store
@inject TenantContext Ctx
@inject Mailer Mail
@inject ResellerResolver Resolver
@inject NavigationManager Nav
@inject Toaster Toast
@inject AlertService Alerter

@* Fiche d'une personne (tiroir du bas) : ses accès en cartes (rôle + lieux), ou l'invitation d'une nouvelle personne.
   Maquette organisation-echelle.html (étape 4). Un administrateur de l'organisation n'a pas d'accès à choisir : tous les droits, partout. *@
<Sheet Title="@(isNew ? "Inviter une personne" : name)" Sub="@(isNew ? null : email)" OnClose="Cancel">
    <ChildContent>
        <div class="og-form">
            <div class="form-grid">
                <div><label class="lbl" for="pf-name" style="margin-top:0">Nom</label><input id="pf-name" class="full" maxlength="80" @bind="name" placeholder="Prénom Nom" /></div>
                <div><label class="lbl" for="pf-mail" style="margin-top:0">E-mail</label><input id="pf-mail" class="full" type="email" maxlength="120" @bind="email" disabled="@(!isNew)" autocomplete="off" placeholder="prenom.nom@organisation.ch" /></div>
            </div>
            @if (!isNew)
            {
                <div class="og-state">
                    <span class="pill @(status == "Actif" ? "ok" : status == "Invité" ? "warn" : "")">@status</span>
                    @if (status == "Invité") { <button type="button" class="linklike" disabled="@busy" @onclick="Resend">Renvoyer l'invitation</button> }
                </div>
            }

            <label class="og-admin @(admin ? "on" : "")">
                <button type="button" role="switch" aria-checked="@(admin ? "true" : "false")" class="switch sm @(admin ? "on" : "")" disabled="@(userId == Ctx.UserId)" aria-label="Administrateur de l'organisation" @onclick="() => { admin = !admin; error = null; }"><span></span></button>
                <span class="grow"><b>Administrateur de l'organisation</b><small>Tous les droits, partout : écrans, listes, médias, intégrations, organisation.</small></span>
            </label>

            @if (!admin)
            {
                @for (var i = 0; i < accs.Count; i++)
                {
                    var acc = accs[i];
                    var idx = i;
                    var level = Guid.TryParse(acc.Level, out var lid) ? levels.FirstOrDefault(l => l.Id == lid) : null;
                    <section class="og-acc">
                        <div class="og-acc-h">
                            <span class="og-acc-n">Accès @(idx + 1)</span>
                            <select class="og-role" aria-label="Rôle de l'accès @(idx + 1)" value="@acc.Level" @onchange="e => { acc.Level = e.Value?.ToString() ?? string.Empty; error = null; }">
                                <option value="">Choisir un rôle…</option>
                                @foreach (var l in levels) { <option value="@l.Id">@l.Name</option> }
                            </select>
                            <span class="grow"></span>
                            @if (accs.Count > 1) { <button type="button" class="linklike og-del" @onclick="() => accs.RemoveAt(idx)">Retirer</button> }
                        </div>
                        @if (level != null) { <p class="hint" style="margin:6px 0 0">@AccessLevels.PagesText(level, Catalog)@(level.ReadOnly ? " · lecture seule" : "")</p> }
                        <div class="og-where">
                            @foreach (var w in WhereChips(acc)) { <span class="og-wc"><Ico Name="@w.Icon" Size="13" />@w.Text</span> }
                            @if (acc.Places.Any || acc.ScreenIds.Count > 0) { }
                            else { <span class="muted">Aucun lieu choisi</span> }
                            <button type="button" class="btn ghost sm" @onclick="() => EditPlaces(acc)">Modifier les lieux…</button>
                        </div>
                        @if (foldersOn && level != null)
                        {
                            @foreach (var dom in new[] { LevelPages.Playlists, LevelPages.Media })
                            {
                                if (level.AccessTo(dom) == DomainAccess.None) { continue; }
                                var d2 = dom;
                                <div class="mb-vis">
                                    <label class="lbl">@(d2 == LevelPages.Playlists ? "Dossiers de listes de lecture" : "Dossiers de la médiathèque")</label>
                                    <select class="full" value="@VisOf(acc, d2)" @onchange="e => SetVis(acc, d2, e.Value?.ToString())">
                                        <option value="@LevelVisibility.Chosen">Les siens et ceux qu'on lui partage</option>
                                        <option value="@LevelVisibility.AllRead">Tous ceux de l'organisation, en lecture seule</option>
                                        <option value="@LevelVisibility.All">Tous ceux de l'organisation</option>
                                    </select>
                                </div>
                            }
                        }
                    </section>
                }
                @if (OverlapNote() is { } note) { <p class="hint og-overlap">@note</p> }
                <button type="button" class="btn ghost og-add" @onclick="() => accs.Add(new AccForm { Level = DefaultRole() })"><Ico Name="plus" Size="16" /> Ajouter un accès</button>
                @if (accs.Count > 0 && accs.All(a => Guid.TryParse(a.Level, out _) && a.Places.Any)) { <div class="og-sum">@Summary()</div> }
            }
            else { <div class="og-sum">Administrateur de l'organisation : tous les droits, partout.</div> }
            @if (isNew) { <p class="hint" style="margin:12px 0 0">La personne reçoit par e-mail un mot de passe provisoire, à changer à la première connexion.</p> }
            @if (error != null) { <div class="err">@error</div> }
        </div>
    </ChildContent>
    <Foot>
        @if (!isNew && userId != Ctx.UserId)
        {
            <button type="button" class="linklike og-del" @onclick="ToggleDisabled">@(status == "Désactivé" ? "Réactiver" : "Désactiver")</button>
            <button type="button" class="linklike og-del" @onclick="() => confirmDelete = true">Supprimer</button>
        }
        <span class="grow"></span>
        <button type="button" class="btn ghost" @onclick="Cancel">Annuler</button>
        <button type="button" class="btn" disabled="@busy" @onclick="Save">@(isNew ? (busy ? "Envoi…" : "Envoyer l'invitation") : "Enregistrer")</button>
    </Foot>
</Sheet>

@if (placeEdit != null)
{
    <Sheet Title="Où ?" Sub="Une aire cochée vaut pour ses zones, ses écrans et ce qui s'y ajoutera." Over="true" Class="sm" OnClose="ClosePlaces">
        <ChildContent>
            <PlacePicker Areas="areas" Sel="placeSel" Mode="full" OnChange="StateHasChanged" />
            <div class="og-sum" style="margin-top:12px">@PlaceText(placeSel)</div>
        </ChildContent>
        <Foot>
            <span class="grow"></span>
            <button type="button" class="btn ghost" @onclick="ClosePlaces">Annuler</button>
            <button type="button" class="btn" @onclick="ApplyPlaces">Appliquer</button>
        </Foot>
    </Sheet>
}

@if (confirmDelete)
{
    <Sheet Title="@($"Supprimer le compte de {name} ?")" Over="true" Class="sm" OnClose="CloseConfirm">
        <ChildContent><p class="hint" style="margin:0">La personne ne pourra plus se connecter. Les écrans, listes de lecture et médias restent dans leurs aires.</p></ChildContent>
        <Foot>
            <span class="grow"></span>
            <button type="button" class="btn ghost" @onclick="() => confirmDelete = false">Annuler</button>
            <button type="button" class="btn danger-solid" @onclick="Delete">Supprimer</button>
        </Foot>
    </Sheet>
}

@code {
    /// <summary>La personne à modifier ; null : inviter une nouvelle personne.</summary>
    [Parameter] public Guid? UserId { get; set; }
    [Parameter] public EventCallback OnClose { get; set; }
    /// <summary>Enregistré, invité, désactivé ou supprimé : la page recharge ses listes.</summary>
    [Parameter] public EventCallback OnSaved { get; set; }
    [Inject] private AppCatalog Catalog { get; set; } = default!;

    private class AccForm
    {
        /// <summary>Identifiant du rôle, ou vide.</summary>
        public string Level = "";
        public PlaceSel Places = new();
        /// <summary>Écrans cochés un à un dans l'ancien formulaire : conservés tels quels.</summary>
        public List<Guid> ScreenIds = new();
        public string? PlaylistsVis, MediaVis;
    }

    private List<Area> areas = new();
    private List<Screen> screens = new();
    private List<AccessLevel> levels = new();
    private bool foldersOn, isNew, admin, busy, confirmDelete;
    private Guid? userId;
    private string name = "", email = "", status = "", orgName = "";
    private string? error;
    private List<AccForm> accs = new();
    private AccForm? placeEdit;
    private PlaceSel placeSel = new();

    protected override void OnInitialized()
    {
        userId = UserId;
        isNew = UserId == null;
        User? user = null;
        (areas, screens, levels, foldersOn, orgName, user) = Store.Read(d => (
            d.Areas.OrderBy(a => a.CreatedUtc).ToList(),
            d.Root.Screens.Where(s => s.ClientId == d.ClientId && s.Token != null).ToList(),
            d.Tenant.Levels.OrderBy(l => l.Kind == null ? 1 : 0).ThenBy(l => l.Kind == LevelKinds.Reader ? 1 : 0).ThenBy(l => l.Name, StringComparer.CurrentCultureIgnoreCase).ToList(),
            d.Tenant.FoldersOn, d.Tenant.Name, UserId is { } id ? d.Users.FirstOrDefault(u => u.Id == id) : null));
        if (user != null)
        {
            name = user.Name; email = user.Email; status = OrgView.StatusOf(user);
            admin = user.Role == Roles.ClientAdmin;
            if (!admin)
                accs = user.AccessList(levels).Where(a => levels.Any(l => l.Id == a.LevelId)).Select(a => new AccForm
                {
                    Level = a.LevelId.ToString(),
                    Places = new PlaceSel { All = a.Perimeter.AllAreas, Areas = [.. a.Perimeter.AreaIds], Zones = [.. a.Perimeter.ZoneIds] },
                    ScreenIds = [.. a.Perimeter.ScreenIds], PlaylistsVis = a.Perimeter.PlaylistsVisibility, MediaVis = a.Perimeter.MediaVisibility
                }).ToList();
        }
        else accs = [new AccForm { Level = DefaultRole(), Places = new PlaceSel { All = true } }];
        if (accs.Count == 0 && !admin) accs.Add(new AccForm { Level = DefaultRole() });
    }

    private string DefaultRole() => (levels.FirstOrDefault(l => l.Kind == LevelKinds.Editor) ?? levels.FirstOrDefault())?.Id.ToString() ?? "";

    // ---------- Lieux ----------

    private record Chip(string Icon, string Text);

    private IEnumerable<Chip> WhereChips(AccForm a)
    {
        if (a.Places.All) { yield return new Chip("map-pin", "Toute l'organisation"); }
        else
        {
            foreach (var id in a.Places.Areas) if (areas.FirstOrDefault(x => x.Id == id) is { } ar) yield return new Chip("map-pin", ar.Name);
            foreach (var id in a.Places.Zones)
                if (areas.FirstOrDefault(x => x.Zones.Any(z => z.Id == id)) is { } ar) yield return new Chip("box", ar.Name + " › " + ar.Zones.First(z => z.Id == id).Name);
        }
        if (a.ScreenIds.Count > 0) yield return new Chip("monitor", $"{a.ScreenIds.Count} écran{(a.ScreenIds.Count > 1 ? "s" : "")}");
    }

    private string PlaceText(PlaceSel s) =>
        s.All ? "Toute l'organisation, y compris les futures aires."
        : s.Areas.Count + s.Zones.Count == 0 ? "Aucun lieu choisi."
        : $"{Pl(s.Areas.Count, "aire", "aires")}{(s.Zones.Count > 0 ? " · " + Pl(s.Zones.Count, "zone", "zones") : "")} choisie{(s.Areas.Count + s.Zones.Count > 1 ? "s" : "")}.";

    private static string Pl(int n, string one, string many) => $"{n} {(n == 1 ? one : many)}";

    private void EditPlaces(AccForm a) { placeEdit = a; placeSel = a.Places.Copy(); }
    private void ClosePlaces() => placeEdit = null;
    private void CloseConfirm() => confirmDelete = false;
    private void ApplyPlaces()
    {
        if (placeEdit == null) return;
        placeEdit.Places = placeSel;
        if (placeSel.All) placeEdit.ScreenIds.Clear();
        placeEdit = null;
    }

    private string VisOf(AccForm a, string dom) => (dom == LevelPages.Playlists ? a.PlaylistsVis : a.MediaVis) is LevelVisibility.All or LevelVisibility.AllRead ? (dom == LevelPages.Playlists ? a.PlaylistsVis : a.MediaVis)! : LevelVisibility.Chosen;
    private void SetVis(AccForm a, string dom, string? v) { if (dom == LevelPages.Playlists) a.PlaylistsVis = v; else a.MediaVis = v; }

    /// <summary>Deux accès qui atteignent la même aire : ce qui s'applique dans l'aire ouverte (voir <see cref="AreaAccess.For"/>).</summary>
    private string? OverlapNote()
    {
        var valid = accs.Where(a => Guid.TryParse(a.Level, out _) && a.Places.Any).ToList();
        foreach (var area in areas)
        {
            var reach = valid.Where(a => a.Places.All || a.Places.Areas.Contains(area.Id) || area.Zones.Any(z => a.Places.Zones.Contains(z.Id))).ToList();
            if (reach.Count < 2) continue;
            var wholes = reach.Where(a => a.Places.All || a.Places.Areas.Contains(area.Id)).ToList();
            return wholes.Count > 0
                ? $"Dans « {area.Name} », un accès couvre l'aire entière : son rôle s'applique à toute l'aire, les accès plus petits n'y changent rien."
                : $"Dans « {area.Name} », plusieurs accès se partagent des zones : le rôle le plus restreint s'applique à l'aire.";
        }
        return null;
    }

    private string Summary()
    {
        var first = name.Trim().Split(' ', StringSplitOptions.RemoveEmptyEntries).FirstOrDefault() ?? "La personne";
        var parts = accs.Select(a =>
        {
            var l = levels.FirstOrDefault(x => x.Id.ToString() == a.Level);
            var n = a.Places.All ? "partout" : "sur " + Pl(a.Places.Areas.Count + a.Places.Zones.Count, "lieu", "lieux");
            return (l?.Name ?? "?") + " " + n;
        });
        return $"{first} : {string.Join(" · ", parts)}.";
    }

    // ---------- Enregistrement ----------

    private Task Cancel() => OnClose.InvokeAsync();

    private bool Validate(out List<MemberAccess> list)
    {
        list = new();
        error = null;
        if (name.Trim().Length == 0) { error = "Saisissez le nom."; return false; }
        if (isNew && !System.Text.RegularExpressions.Regex.IsMatch(email.Trim(), @"^[^@\s]+@[^@\s]+\.[^@\s]+$")) { error = "Saisissez une adresse e-mail valide."; return false; }
        if (admin) return true;
        foreach (var a in accs)
        {
            if (!Guid.TryParse(a.Level, out var lid)) { error = "Choisissez un rôle pour chaque accès, ou faites de la personne un administrateur."; return false; }
            if (!a.Places.Any && a.ScreenIds.Count == 0) { error = "Choisissez au moins une aire ou une zone pour chaque accès : sans cela, la personne ne verrait rien."; return false; }
            list.Add(new MemberAccess
            {
                LevelId = lid,
                Perimeter = new Perimeter
                {
                    AllAreas = a.Places.All, AreaIds = a.Places.All ? [] : [.. a.Places.Areas], ZoneIds = a.Places.All ? [] : [.. a.Places.Zones], ScreenIds = a.Places.All ? [] : [.. a.ScreenIds],
                    PlaylistsVisibility = a.PlaylistsVis, MediaVisibility = a.MediaVis
                }
            });
        }
        if (list.Count == 0) { error = "Ajoutez au moins un accès, ou faites de la personne un administrateur."; return false; }
        return true;
    }

    private static string? KeepsAnOrgAdmin(IEnumerable<User> all, Guid changing) =>
        all.Any(u => u.Id != changing && u.Role == Roles.ClientAdmin && !u.Disabled) ? null : "L'organisation doit garder au moins un autre administrateur actif.";

    private async Task Save()
    {
        if (busy || !Validate(out var list)) return;
        var nm = name.Trim();
        if (userId is { } id)
        {
            error = Store.Write(d =>
            {
                if (!d.Access.IsOrgAdmin) return "Seul un administrateur de l'organisation modifie ce compte.";
                var u = d.Users.FirstOrDefault(x => x.Id == id);
                if (u == null) return "Compte introuvable.";
                if (!admin && list.Any(a => d.Tenant.Levels.All(l => l.Id != a.LevelId))) return "Rôle introuvable.";
                if (u.Role == Roles.ClientAdmin && !admin)
                {
                    if (u.Id == Ctx.UserId) return "Vous ne pouvez pas vous retirer ce rôle : demandez-le à un autre administrateur de l'organisation.";
                    if (KeepsAnOrgAdmin(d.Users, u.Id) is { } e) return e;
                }
                u.Name = nm;
                u.Role = admin ? Roles.ClientAdmin : Roles.ClientMember;
                u.SetAccesses(admin ? new() : list);
                return null;
            });
            if (error != null) return;
            Toast.Ok($"Accès de {nm} enregistrés.");
            await OnSaved.InvokeAsync();
            return;
        }

        // Invitation : mot de passe provisoire envoyé par e-mail, à changer à la première connexion.
        var mail = email.Trim().ToLowerInvariant();
        var pwd = Passwords.Generate();
        Reseller? reseller = null;
        error = Store.Write(d =>
        {
            if (!d.Access.IsOrgAdmin) return "Seul un administrateur de l'organisation invite une personne.";
            if (d.EmailTaken(mail)) return d.Users.Any(u => u.Email == mail) ? "Cette personne fait déjà partie de l'organisation : modifiez ses accès dans la liste." : "Cette adresse e-mail est déjà utilisée.";
            if (!admin && list.Any(a => d.Tenant.Levels.All(l => l.Id != a.LevelId))) return "Rôle introuvable.";
            var nu = new User { Email = mail, Name = nm, PasswordHash = Passwords.Hash(pwd), Role = admin ? Roles.ClientAdmin : Roles.ClientMember, MustChangePassword = true, CreatedUtc = DateTime.UtcNow };
            if (!admin) nu.SetAccesses(list);
            d.AddUser(nu);
            reseller = d.Reseller;
            return null;
        });
        if (error != null) return;
        busy = true;
        try
        {
            var mailErr = await Mail.SendWelcome(reseller!, Resolver.LoginUrl(reseller!, Nav.BaseUri), $"Vous avez été invité à gérer les écrans de « {orgName} ».", nm, mail, pwd);
            if (mailErr == null) Toast.Ok($"Invitation envoyée à {mail}.");
            else Toast.Error($"Compte créé, mais l'e-mail n'a pas pu être envoyé : {mailErr}. Communiquez vous-même le mot de passe provisoire à {mail} : {pwd}");
        }
        finally { busy = false; }
        _ = Alerter.Raise(Ctx.RequireClientId(), Alerts.Members, "Nouvelle personne dans l'organisation", $"{(string.IsNullOrWhiteSpace(nm) ? mail : nm)} a été ajouté(e).", "/organisation", except: Ctx.UserId);
        await OnSaved.InvokeAsync();
    }

    private async Task Resend()
    {
        if (userId is not { } id) return;
        busy = true;
        try
        {
            var r = await InviteOps.ResendAsync(Store, Mail, Resolver, Nav.BaseUri, orgName, [id]);
            if (r.Count == 0) Toast.Error("Cette personne n'est plus en attente d'invitation.");
            else if (r[0].MailError == null) Toast.Ok($"Invitation renvoyée à {r[0].User.Email}.");
            else Toast.Error($"L'e-mail n'a pas pu être envoyé : {r[0].MailError}. Communiquez vous-même le nouveau mot de passe provisoire à {r[0].User.Email} : {r[0].Password}");
        }
        finally { busy = false; }
    }

    private async Task ToggleDisabled()
    {
        if (userId is not { } id) return;
        var disable = status != "Désactivé";
        (int Changed, string? Error) r = Store.Write(d => AccessLevels.SetDisabled(d, [id], disable));
        if (r.Error != null) { error = r.Error; return; }
        Toast.Ok(disable ? $"{name} est désactivé." : $"{name} est réactivé.");
        await OnSaved.InvokeAsync();
    }

    private async Task Delete()
    {
        if (userId is not { } id) return;
        confirmDelete = false;
        error = Store.Write(d =>
        {
            if (!d.Access.IsOrgAdmin) return "Seul un administrateur de l'organisation supprime un compte.";
            var u = d.Users.FirstOrDefault(x => x.Id == id);
            if (u == null) return "Compte introuvable.";
            if (u.Id == Ctx.UserId) return "Vous ne pouvez pas supprimer votre propre compte.";
            if (u.Role == Roles.ClientAdmin && !u.Disabled && KeepsAnOrgAdmin(d.Users, u.Id) is { } e) return e;
            d.RemoveUser(u.Id);
            return null;
        });
        if (error != null) return;
        Toast.Ok($"Compte de {name} supprimé.");
        await OnSaved.InvokeAsync();
    }
}
