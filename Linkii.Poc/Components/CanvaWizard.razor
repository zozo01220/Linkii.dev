@inject TenantStore Store
@inject CanvaService Canva
@inject Toaster Toast
@inject AppService Svc
@implements IDisposable

@* Applications › Canva : assistant d'ajout, dans un tiroir du haut (maquette canva-assistant-ajout.html).
   1. Connexion du compte Canva ; 2. choix des dossiers, avec l'aperçu de leurs designs ;
   3. validation, puis import avec aperçu : chaque design est exporté en images à la racine de la médiathèque.
   Rouvert depuis le menu de la carte, il sert aussi à gérer les dossiers (étape 2) ou à changer de compte (étape 1). *@
<WizardShell Icon="canva" Title="@(folders.Count > 0 ? "Canva" : "Ajouter Canva")" Labels="@Labels" Step="step" Done="done" Running="running"
             CanBack="@(step == 2 || step == 3 && !running && !planning)" Hint="@Hint" NextLabel="@NextLabel" NextDisabled="NextDisabled"
             OnCancel="Cancel" OnClose="Close" OnBack="Back" OnNext="Next">
    @if (step == 1)
    {
        <WizardAccount Kind="@ConnectedAccounts.Canva" Provider="Canva" Ready="ready" Connected="connected" Lost="lost" User="@user" Since="since" ConnectUrl="/canva/connect"
                       Missing="Connectez le compte Canva qui contient vos designs."
                       Permissions="@(new[] { "Lire vos designs et leur contenu", "Lire vos dossiers", "Lire le nom de votre profil" })" />
    }
    else if (step == 2)
    {
        <div class="cw-body">
            <h2 class="cw-h">Quels dossiers voulez-vous ajouter ?</h2>
            <p class="cw-lead">Cochez les dossiers dont vous voulez copier les designs dans votre Médiathèque.</p>
            <div class="cw-tools">
                <span class="cw-count"><b>@chosen.Count</b> dossier@(chosen.Count > 1 ? "s" : "") coché@(chosen.Count > 1 ? "s" : "")</span>
                <button type="button" class="btn ghost sm" @onclick="ToggleAll">@(chosen.ContainsKey("root") ? "Tout désélectionner" : "Tout sélectionner")</button>
            </div>
            <div class="cw-tree2" role="tree">
                @if (treeError != null) { <div class="dfp-empty err">@treeError</div> }
                else if (!cache.ContainsKey("root")) { <div class="dfp-empty">Chargement…</div> }
                else { @Node("root", "Tous les designs", "Tous les designs", 0) }
            </div>
            <label class="cw-subopt">
                <input type="checkbox" class="ios" checked="@sub" @onchange="e => sub = e.Value is true" />
                <span><b>Inclure les sous-dossiers</b><small>@CanvaService.MaxDesigns designs au plus par dossier</small></span>
            </label>
        </div>
    }
    else
    {
        <div class="cw-body cw-final">
            @if (planning) { <div class="cw-spin"></div><h2 class="cw-h">Lecture des dossiers…</h2> }
            else if (planError != null) { <div class="dfp-empty err">@planError</div> }
            else if (done)
            {
                <div class="cw-bigok">✓</div>
                <h2 class="cw-h">Canva est prêt</h2>
                <p class="cw-lead">@plan.Sum(p => p.Designs.Count) design@(plan.Sum(p => p.Designs.Count) > 1 ? "s" : "") ajouté@(plan.Sum(p => p.Designs.Count) > 1 ? "s" : "") à votre Médiathèque (@importedCount image@(importedCount > 1 ? "s" : "")).</p>
            }
            else if (running)
            {
                <div class="cw-spin"></div>
                <h2 class="cw-h">Ajout en cours…</h2>
                <p class="cw-lead">Design @Math.Min(doneNow + 1, Math.Max(totalNow, 1)) sur @Math.Max(totalNow, 1) · vous pouvez fermer, l'import continue en arrière-plan.</p>
                <div class="cw-bar"><i style="width:@Percent%"></i></div>
            }
            @foreach (var p in plan.Where(p => p.Skipped > 0)) { <div class="dsd-warn">« @p.Name » : limite de @CanvaService.MaxDesigns designs atteinte, @p.Skipped ne seront pas copiés.</div> }
            @foreach (var f in folders.Where(f => f.LastError.Length > 0)) { <small class="cal-err">@f.Name : @f.LastError</small> }
            @if (imported.Count > 0) { <div class="cw-grid">@foreach (var m in imported.Take(12)) { <div class="cw-th"><div class="cw-im"><MediaThumb Media="m" /></div><span>@m.Name</span></div> }</div> }
        </div>
    }
</WizardShell>

@code {
    [Parameter] public int StartStep { get; set; } = 1;
    [Parameter] public EventCallback OnClose { get; set; }
    [Parameter] public EventCallback OnChanged { get; set; }
    /// <summary>L'application n'est pas encore dans Mes applications : elle n'y entre qu'au lancement de l'import. Annuler ne laisse rien (le compte connecté pendant l'assistant est déconnecté).</summary>
    [Parameter] public bool Adding { get; set; }
    [Parameter] public EventCallback OnAdded { get; set; }

    private int step = 1;
    private bool ready, connected, lost;
    private string user = "";
    private DateTime? since;
    private List<CanvaFolder> folders = new();

    // étape 2
    private readonly Dictionary<string, CanvaService.CanvaListing> cache = new();
    private readonly HashSet<string> open = new() { "root" };
    private readonly Dictionary<string, (string Name, string Location)> chosen = new();
    private string? treeError;
    private bool sub;

    // étape 3
    private record Planned(string CanvaId, string Name, string Location, List<CanvaService.Design> Designs, int Skipped);
    private List<Planned> plan = new();
    private bool planning, running, done;
    private string? planError;
    private DateTime started;
    private List<MediaItem> imported = new();
    private int importedCount, doneNow, totalNow, totalImages;
    private Timer? timer;
    private static readonly string[] Labels = { "Compte", "Sélection", "Terminé" };

    private List<CanvaFolder> Removed => folders.Where(f => !chosen.ContainsKey(f.CanvaId)).ToList();
    private int Percent => done ? 100 : totalNow == 0 ? 0 : Math.Min(99, doneNow * 100 / totalNow);

    private bool NextDisabled => step switch { 1 => !connected, 2 => chosen.Count == 0 && folders.Count == 0, _ => !done };
    private string NextLabel => step == 1 ? "Suivant"
        : step == 2 ? (chosen.Count > 0 ? $"Ajouter {chosen.Count} dossier{(chosen.Count > 1 ? "s" : "")}" : "Enregistrer")
        : planning ? "Lecture…" : "Ajout en cours…";
    private string Hint => step switch
    {
        1 => connected ? "" : "Connectez un compte pour continuer.",
        2 => chosen.Count == 0 ? "Cochez au moins un dossier." : Removed.Count > 0 ? $"{Removed.Count} dossier{(Removed.Count > 1 ? "s" : "")} sera retiré avec ses fichiers." : Adding ? "Rien n'est enregistré tant que vous n'avez pas ajouté." : "",
        _ => ""
    };

    protected override async Task OnInitializedAsync()
    {
        Refresh();
        foreach (var f in folders) chosen[f.CanvaId] = (f.Name, f.Location);
        sub = folders.Count > 0 && folders.All(f => f.Subfolders);
        step = !connected ? 1 : Math.Clamp(StartStep, 1, 2);
        if (step == 2) await EnterStep2();
    }

    private void Refresh()
    {
        ready = Canva.IsConfigured;
        var c = Canva.ConnectionOf(Store.ClientId);
        (connected, user, since) = (c.Connected, c.User, c.Since);
        lost = Store.Read(d => d.Tenant.CanvaLostUtc != null);
        folders = Store.Read(d => d.Tenant.CanvaFolders.OrderBy(f => f.Name, StringComparer.CurrentCultureIgnoreCase).ToList());
    }

    private List<CanvaFolder> Folders() => folders;

    private Task Close() => OnClose.InvokeAsync();

    private Task Cancel()
    {
        if (Adding && Canva.ConnectionOf(Store.ClientId).Connected) Canva.Disconnect(Store.ClientId);
        return OnClose.InvokeAsync();
    }

    // ---------- Navigation ----------

    private async Task Next()
    {
        if (step == 1) { step = 2; await EnterStep2(); }
        else if (step == 2)
        {
            step = 3;
            await Prepare();
            if (planError == null) await Run();
        }
        else if (done) await Close();
    }

    private void Back() { if (step > 1) step--; }

    // ---------- Étape 2 : dossiers ----------

    private async Task EnterStep2()
    {
        if (cache.ContainsKey("root")) return;
        await Load("root");
    }

    private async Task Load(string id)
    {
        if (cache.ContainsKey(id)) return;
        treeError = null;
        try { cache[id] = await Canva.ListFolder(Store.ClientId, id); }
        catch (CanvaService.CanvaException ex) { treeError = ex.Message; }
        catch (HttpRequestException) { treeError = "Canva est injoignable. Réessayez dans un instant."; }
        StateHasChanged();
    }

    private async Task Toggle(string id, string name, string location)
    {
        if (!open.Remove(id)) { open.Add(id); await Load(id); }
    }

    private void Check(string id, string name, string location)
    {
        if (!chosen.Remove(id)) chosen[id] = (name, location);
    }

    private void ToggleAll()
    {
        if (chosen.ContainsKey("root")) { chosen.Clear(); return; }
        chosen.Clear();
        chosen["root"] = ("Tous les designs", "Tous les designs");
        sub = true;
    }

    private RenderFragment Node(string id, string name, string location, int depth) => __builder =>
    {
        var isOpen = open.Contains(id);
        var kids = cache.GetValueOrDefault(id)?.Folders;
        var on = chosen.ContainsKey(id);
        <div class="cw-tn @(on ? "on" : "")" style="--d:@depth" role="treeitem" aria-expanded="@(isOpen ? "true" : "false")" @onclick="() => Check(id, name, location)">
            <span class="cw-ex" role="button" aria-label="@(isOpen ? "Réduire" : "Développer") @name" @onclick="() => Toggle(id, name, location)" @onclick:stopPropagation="true">@(isOpen ? "▾" : "▸")</span>
            <i class="cw-bx @(on ? "on" : "")">@(on ? "✓" : "")</i>
            <Ico Name="folder" Size="16" />
            <span class="cw-nm2">@name</span>
            @if (cache.GetValueOrDefault(id) is { } l) { <small class="cw-n">@l.Designs design@(l.Designs > 1 ? "s" : "")</small> }
        </div>
        @if (isOpen && kids != null)
        {
            @foreach (var k in kids) { @Node(k.Id, k.Name, location + " › " + k.Name, depth + 1) }
        }
    };

    // ---------- Étape 3 : validation et import ----------

    private async Task Prepare()
    {
        planning = true; planError = null; plan = new();
        StateHasChanged();
        try
        {
            foreach (var (id, c) in chosen)
            {
                var (designs, skipped) = await Canva.CollectDesigns(Store.ClientId, id, sub);
                plan.Add(new(id, c.Name, c.Location, designs, skipped));
            }
        }
        catch (CanvaService.CanvaException ex) { planError = ex.Message; }
        catch (Exception ex) when (ex is HttpRequestException or KeyNotFoundException) { planError = "Canva est injoignable ou a répondu de façon inattendue."; }
        planning = false;
    }

    private async Task Run()
    {
        if (Adding) { Svc.Mark("canva"); Svc.Enable("canva"); await OnAdded.InvokeAsync(); }
        // dossiers décochés : retirés avec leurs fichiers ; dossiers cochés : ajoutés ou mis à jour, puis synchronisés
        foreach (var f in Removed) Canva.RemoveFolder(Store.ClientId, f.Id);
        var toSync = new List<Guid>();
        foreach (var p in plan)
        {
            var existing = Store.Read(d => d.Tenant.CanvaFolders.FirstOrDefault(f => f.CanvaId == p.CanvaId));
            if (existing != null)
            {
                if (existing.Subfolders != sub) Store.Write(d => { if (d.Tenant.CanvaFolders.FirstOrDefault(x => x.Id == existing.Id) is { } x) x.Subfolders = sub; });
                toSync.Add(existing.Id);
            }
            else
            {
                var f = new CanvaFolder { CanvaId = p.CanvaId, Name = p.Name, Location = p.Location, Subfolders = sub };
                Store.Write(d => d.Tenant.CanvaFolders.Add(f));
                toSync.Add(f.Id);
            }
        }
        Refresh();
        started = DateTime.UtcNow;
        totalImages = plan.Sum(p => p.Designs.Sum(d => d.Pages ?? 1));
        running = true; done = false;
        var (clientId, areaId) = (Store.ClientId, Store.AreaId);
        foreach (var id in toSync) _ = Task.Run(async () => { await Canva.SyncFolder(clientId, id, areaId); });
        timer?.Dispose();
        timer = new Timer(_ => _ = InvokeAsync(Tick), null, 600, 1500);
        await OnChanged.InvokeAsync();
    }

    private async Task Tick()
    {
        Refresh();
        var ids = plan.Select(p => folders.FirstOrDefault(f => f.CanvaId == p.CanvaId)).Where(f => f != null).Select(f => f!).ToList();
        var states = ids.Select(f => Canva.Syncing(f.Id)).Where(s => s != null).ToList();
        (doneNow, totalNow) = (states.Sum(s => s!.Done), states.Sum(s => s!.Total));
        var keys = ids.Select(f => f.Id.ToString()).ToHashSet();
        var all = Store.Read(d => d.Media.Where(m => m.Info.TryGetValue("canvaFolder", out var k) && keys.Contains(k)).OrderByDescending(m => m.AddedUtc).ToList());
        importedCount = all.Count;
        imported = all.Take(18).ToList();
        var finished = ids.Count == plan.Count && ids.All(f => f.SyncedUtc is { } s && s >= started) && states.Count == 0;
        if (finished && !done)
        {
            done = true; timer?.Dispose();
            await OnChanged.InvokeAsync();
        }
        StateHasChanged();
    }

    public void Dispose() => timer?.Dispose();
}
