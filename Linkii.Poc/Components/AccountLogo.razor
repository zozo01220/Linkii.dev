@* Logo d'un compte connecté : Microsoft ou Google (logo du fournisseur), Canva, serveur CalDAV ou Exchange (icône de l'intégration, réduite). *@
<span class="acc-logo" style="--s:@(Size)px" aria-hidden="true">
    @switch (Kind)
    {
        case ConnectedAccounts.Microsoft or ConnectedAccounts.Google:
            <ProviderLogo Provider="@Kind" Size="@Size" />
            break;
        case ConnectedAccounts.Canva:
            <AppIcon Id="canva" Small="true" />
            break;
        default:
            <AppIcon Id="@("cal-" + Kind)" Small="true" />
            break;
    }
</span>

@code {
    [Parameter, EditorRequired] public string Kind { get; set; } = "";
    [Parameter] public int Size { get; set; } = 18;
}
