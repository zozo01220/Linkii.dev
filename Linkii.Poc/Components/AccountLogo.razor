@* Logo d'un compte connecté : le vrai logo du fournisseur (Microsoft, Google, Canva, Facebook, Home Assistant, Dropbox, Nextcloud), ou celui de la source (SFTP, CalDAV, Exchange). *@
<span class="acc-logo" style="--s:@(Size)px" aria-hidden="true">
    @switch (Kind)
    {
        case ConnectedAccounts.Microsoft or ConnectedAccounts.Google or ConnectedAccounts.Canva or ConnectedAccounts.Facebook:
            <BrandLogo Id="@Kind" Size="@Size" />
            break;
        case ConnectedAccounts.HomeAssistant:
            <BrandLogo Id="homeassistant" Size="@Size" />
            break;
        case ConnectedAccounts.Nextcloud or ConnectedAccounts.Sftp or ConnectedAccounts.Dropbox:
            <BrandLogo Id="@("drv-" + Kind)" Size="@Size" />
            break;
        default:
            <BrandLogo Id="@("cal-" + Kind)" Size="@Size" />
            break;
    }
</span>

@code {
    [Parameter, EditorRequired] public string Kind { get; set; } = "";
    [Parameter] public int Size { get; set; } = 18;
}
