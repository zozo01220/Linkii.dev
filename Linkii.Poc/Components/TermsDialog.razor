@* Conditions générales dans une fenêtre (élément dialog, ouvert par un bouton data-open-dialog="terms-dialog", voir auth.js).
   « J'accepte » active l'interrupteur des conditions du formulaire. *@
<dialog id="terms-dialog" class="terms-dialog" aria-labelledby="terms-title">
    <div class="modal-head">
        <div class="grow"><h3 id="terms-title">Conditions générales de Linkii</h3><small class="muted">Version @Terms.Version · @Terms.PublishedUtc.ToString("d MMMM yyyy", Signup.Fr) · texte provisoire</small></div>
        <button type="button" class="modal-x" aria-label="Fermer" data-close-dialog><Ico Name="x" Size="20" /></button>
    </div>
    <div class="terms-body"><TermsText /></div>
    <div class="modal-foot">
        <button type="button" class="btn ghost" data-close-dialog>Fermer</button>
        @if (Accept) { <button type="button" class="btn" data-accept-terms>J'accepte</button> }
    </div>
</dialog>

@code {
    /// <summary>Bouton « J'accepte » (page de création d'un espace) ; absent pour un simple aperçu (console).</summary>
    [Parameter] public bool Accept { get; set; } = true;
}
