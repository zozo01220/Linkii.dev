@* Tiroir du bas : toute fenêtre à formulaire de la page Organisation (voile, tête, corps, pied), comme « Importer » (.imp-bottom).
   Over : par-dessus un autre tiroir (sélecteur de lieux, rôles). *@
<div class="modal-backdrop @(Over ? "over" : "")" @onclick="Close"></div>
<div class="imp-bottom og-sheet @Class @(Over ? "over" : "")" role="dialog" aria-modal="true" aria-label="@Title">
    <div class="imp-head">
        <h3>@Title@if (Sub != null) { <small>@Sub</small> }</h3>
        <button type="button" class="modal-x" aria-label="Fermer" @onclick="Close"><Ico Name="x" Size="20" /></button>
    </div>
    <div class="imp-body">@ChildContent</div>
    @if (Foot != null) { <div class="imp-foot">@Foot</div> }
</div>

@code {
    [Parameter, EditorRequired] public string Title { get; set; } = "";
    [Parameter] public string? Sub { get; set; }
    /// <summary>Classe de largeur : « sm » (560 px), « md » (760 px, défaut), « lg » (1040 px).</summary>
    [Parameter] public string Class { get; set; } = "";
    [Parameter] public bool Over { get; set; }
    [Parameter] public EventCallback OnClose { get; set; }
    [Parameter] public RenderFragment? ChildContent { get; set; }
    [Parameter] public RenderFragment? Foot { get; set; }

    private Task Close() => OnClose.InvokeAsync();
}
