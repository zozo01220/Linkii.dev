@* QR code de comptage des scans, dessiné par-dessus un aperçu (vignette de la ligne, image seule, diapositives du carrousel et de la grille) :
   même position et même taille que sur l'écran (en % de l'aperçu, qui a les proportions de l'écran). Le parent doit être positionné (position: relative / absolute).
   Mini : vignette de liste, sans le texte (trop petit pour être lu). *@
@if (n > 0)
{
    <div class="qr-badge @(Mini ? "mini" : "")" style="left:@Pct(Qr!.X);top:@Pct(Qr.Y);width:@Pct(Qr.Size)" aria-hidden="true">
        <svg viewBox="0 0 @n @n" shape-rendering="crispEdges"><path d="@path" fill="#0B1F3A" /></svg>
        @if (!Mini && !string.IsNullOrWhiteSpace(Qr.Label)) { <span class="qr-lbl">@Qr.Label</span> }
    </div>
}

@code {
    [Parameter] public PublishedQr? Qr { get; set; }
    [Parameter] public bool Mini { get; set; }

    private int n;
    private string path = "";

    private static string Pct(double v) => v.ToString("0.##", System.Globalization.CultureInfo.InvariantCulture) + "%";

    protected override void OnParametersSet()
    {
        var parts = (Qr?.Data ?? "").Split('|');
        (n, path) = parts.Length == 2 && int.TryParse(parts[0], out var side) && side > 0 ? (side, parts[1]) : (0, "");
    }
}
