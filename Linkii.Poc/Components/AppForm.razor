@inject TenantStore Store
@inject GraphService Graph

@* Formulaire de paramétrage généré à partir du manifeste de l'app. Values : une entrée par champ. *@
<div class="dw">
    @foreach (var f in Manifest.Settings)
    {
        if (!AppCatalog.IsVisible(f, Values) || f.Type == "hidden" || f.Managed) continue;
        if (Zone != null && f.Zone != Zone) continue;
        var k = f.Key;
        <div class="dw-field">
            @if (f.Type == "bool")
            {
                <label class="dw-check"><input type="checkbox" class="ios" checked="@(Values[k] == "true")" @onchange='e => Values[k] = (bool)e.Value! ? "true" : "false"' /> @f.Label</label>
            }
            else
            {
                <label>@f.Label@(f.Required ? " *" : "")</label>
                @switch (f.Type)
                {
                    case "textarea":
                        <textarea rows="4" maxlength="@f.MaxLength" placeholder="@f.Placeholder" @bind="Values[k]" @bind:event="oninput"></textarea>
                        break;
                    case "number":
                        <div class="@(f.Unit != null ? "unit" : "")" data-u="@f.Unit">
                            <input type="number" min="@f.Min" max="@f.Max" @bind="Values[k]" @bind:event="oninput" />
                        </div>
                        break;
                    case "select" when f.Ui == "segmented":
                        <div class="cseg" role="radiogroup" aria-label="@f.Label">
                            @foreach (var o in f.Options)
                            {
                                var opt = o;
                                <label><input type="radio" name="seg-@Manifest.Id-@k" checked="@(Values[k] == opt.Value)" @onchange="() => Pick(k, opt.Value)" /><span>@opt.Label</span></label>
                            }
                        </div>
                        break;
                    case "select":
                        <select @bind="Values[k]" @bind:after="Changed">
                            @foreach (var o in f.Options) { <option value="@o.Value">@o.Label</option> }
                        </select>
                        break;
                    case "calendar":
                        @if (calendars.Count == 0)
                        {
                            <div class="dw-note">Aucun calendrier disponible. <a href="/integrations">Ajoutez-en dans Intégrations › Calendriers partagés</a>.</div>
                        }
                        else
                        {
                            <select @bind="Values[k]" @bind:after="Changed">
                                <option value="">— Choisir un calendrier —</option>
                                @foreach (var g in calendars.GroupBy(c => c.Source))
                                {
                                    <optgroup label="@(SharedCalendarSources.Find(g.Key)?.Name ?? g.Key)">
                                        @foreach (var c in g) { <option value="@c.Id">@c.Name</option> }
                                    </optgroup>
                                }
                            </select>
                            <small>Un calendrier manque ? <a href="/integrations">Gérez les calendriers partagés dans Intégrations</a>.</small>
                        }
                        break;
                    case "drive":
                        @if (folders.Count == 0)
                        {
                            <div class="dw-note">Aucun dossier disponible. <a href="/integrations">Ajoutez-en dans Intégrations › Drives</a>.</div>
                        }
                        else
                        {
                            <select @bind="Values[k]" @bind:after="Changed">
                                <option value="">— Choisir un dossier —</option>
                                @foreach (var g in folders.GroupBy(x => x.Source))
                                {
                                    <optgroup label="@(DriveSources.Find(g.Key)?.Name ?? g.Key)">
                                        @foreach (var x in g) { <option value="@x.Id">@x.Name</option> }
                                    </optgroup>
                                }
                            </select>
                            @if (folders.FirstOrDefault(x => x.Id.ToString() == Values[k]) is { } chosen)
                            {
                                <small>@chosen.Location · @chosen.FileCount fichier@(chosen.FileCount > 1 ? "s" : "") · synchronisé @DriveSources.Ago(chosen.SyncedUtc). Un fichier ajouté au dossier apparaît sur les écrans à la synchronisation suivante, sans republier.</small>
                            }
                            else
                            {
                                <small>Un dossier manque ? <a href="/integrations">Gérez les Drives dans Intégrations</a>.</small>
                            }
                        }
                        break;
                    case "color":
                        <input type="color" style="padding:2px;width:64px;height:38px" @bind="Values[k]" @bind:event="oninput" />
                        break;
                    case "date":
                        <input type="date" value="@Values[k]" @onchange='e => Values[k] = e.Value?.ToString() ?? string.Empty' />
                        break;
                    case "secret":
                        <input type="password" autocomplete="off" maxlength="@f.MaxLength" placeholder="@(StoredSecrets.Contains(k) ? "•••••• enregistré — laisser vide pour le conserver" : f.Placeholder)" @bind="Values[k]" @bind:event="oninput" />
                        break;
                    case "textfile":
                        <div class="file-pick">
                            <label class="btn ghost sm file-btn">
                                <InputFile OnChange="e => LoadFile(f, e)" accept=".csv,.txt,text/csv,text/plain" />
                                @(string.IsNullOrEmpty(Values[k]) && !StoredSecrets.Contains(k) ? "Choisir un fichier" : "Remplacer le fichier")
                            </label>
                            @if (!string.IsNullOrEmpty(Values[k])) { <span class="msg">Fichier prêt : @LineCount(Values[k]) ligne(s). Enregistrez pour l'appliquer.</span> }
                            else if (StoredSecrets.Contains(k)) { <span class="muted">Un fichier est enregistré (il n'est pas réaffiché).</span> }
                            @if (!string.IsNullOrEmpty(f.Template) && f.Template.StartsWith('/') && !f.Template.StartsWith("//")) { <a href="@f.Template" download>Télécharger un modèle</a> }
                        </div>
                        @if (fileErrors.TryGetValue(k, out var fe)) { <div class="err">@fe</div> }
                        break;
                    case "media" or "medias":
                        <MediaField Field="f" Values="Values" OnChange="Changed" OpenOnStart="AutoOpen" />
                        break;
                    case "canva":
                        <CanvaField Field="f" Values="Values" OnChange="CanvaChanged" OpenOnStart="AutoOpen" />
                        break;
                    case "pdf":
                        <PdfField Field="f" Values="Values" InstanceId="InstanceId" OnChange="CanvaChanged" />
                        break;
                    case "gfile":
                        <CloudFileField Field="f" Values="Values" InstanceId="InstanceId" OnChange="CanvaChanged" OpenOnStart="AutoOpen" />
                        break;
                    case "facebookpage":
                        @if (fbPages.Count > 0)
                        {
                            <select @bind="Values[k]" @bind:after="Changed">
                                <option value="">— Choisir une Page —</option>
                                @foreach (var pg in fbPages) { <option value="@pg.Id">@pg.Name</option> }
                                @if (Values[k].Length > 0 && fbPages.All(x => x.Id != Values[k])) { <option value="@Values[k]">@Values[k]</option> }
                            </select>
                        }
                        else
                        {
                            <input type="text" maxlength="@f.MaxLength" placeholder="@f.Placeholder" @bind="Values[k]" @bind:event="oninput" />
                            <small>@(fbLost ? "Le compte Facebook est à reconnecter" : "Aucun compte Facebook connecté") : <a href="/integrations?tab=comptes">connectez-le dans Intégrations › Comptes connectés</a>, ou saisissez la Page ici et collez son jeton dans les options avancées.</small>
                        }
                        break;
                    case "mailbox":
                        @if (rooms.Count > 0)
                        {
                            <select value="@Values[k]" @onchange="e => Values[k] = e.Value?.ToString() ?? string.Empty">
                                <option value="">— Choisir une salle / un calendrier —</option>
                                @foreach (var r in rooms)
                                {
                                    <option value="@r.Email" selected="@(r.Email == Values[k])">@r.Name@(r.Capacity > 0 ? $" · {r.Capacity} pl." : "")</option>
                                }
                            </select>
                        }
                        else
                        {
                            <input type="text" maxlength="@f.MaxLength" placeholder="@f.Placeholder" @bind="Values[k]" @bind:event="oninput" />
                            @if (!msConfigured) { <small>Aucun compte Microsoft connecté : <a href="/integrations">le connecter dans Intégrations › Microsoft 365</a>, ou saisissez l'adresse du calendrier.</small> }
                        }
                        break;
                    default:   // text, url
                        <input type="text" maxlength="@f.MaxLength" placeholder="@f.Placeholder" @bind="Values[k]" @bind:event="oninput" />
                        break;
                }
            }
            @if (!string.IsNullOrEmpty(f.Help)) { <small>@f.Help</small> }
        </div>
    }
</div>

@code {
    [Parameter, EditorRequired] public AppManifest Manifest { get; set; } = default!;
    [Parameter, EditorRequired] public Dictionary<string, string> Values { get; set; } = default!;
    [Parameter] public ISet<string> StoredSecrets { get; set; } = new HashSet<string>();
    /// <summary>Instance en cours de modification (null : pas encore enregistrée).</summary>
    [Parameter] public Guid? InstanceId { get; set; }
    /// <summary>Seulement les champs de cette zone (source | main | advanced) ; null : tous (voir AppField.Zone).</summary>
    [Parameter] public string? Zone { get; set; }
    /// <summary>Une valeur a changé : la fenêtre de configuration met l'aperçu à jour.</summary>
    [Parameter] public EventCallback OnChange { get; set; }
    /// <summary>Les champs à sélecteur (fichiers, Drive, Canva) ouvrent leur sélecteur d'emblée : le « + » de l'aperçu vient d'être cliqué.</summary>
    [Parameter] public bool AutoOpen { get; set; }

    private Task Changed() => OnChange.InvokeAsync();
    private Task Pick(string key, string value) { Values[key] = value; return Changed(); }
    private Task CanvaChanged() { StateHasChanged(); return Changed(); }

    private List<GraphService.RoomInfo> rooms = new();
    private readonly Dictionary<string, string> fileErrors = new();

    private static int LineCount(string text) => text.Split((char)10).Count(l => !string.IsNullOrWhiteSpace(l));

    // Lit le fichier choisi : UTF-8, ou ISO-8859-1 pour les exports Excel (« é » correct dans les deux cas).
    private async Task LoadFile(AppField f, InputFileChangeEventArgs e)
    {
        fileErrors.Remove(f.Key);
        try
        {
            await using var s = e.File.OpenReadStream(f.MaxLength * 4L);
            using var ms = new MemoryStream();
            await s.CopyToAsync(ms);
            var bytes = ms.ToArray();
            string text;
            try { text = new System.Text.UTF8Encoding(false, true).GetString(bytes); }
            catch (System.Text.DecoderFallbackException) { text = System.Text.Encoding.Latin1.GetString(bytes); }
            text = text.TrimStart((char)0xFEFF);
            if (text.Length > f.MaxLength) { fileErrors[f.Key] = $"Fichier trop volumineux ({f.MaxLength:N0} caractères maximum)."; return; }
            if (string.IsNullOrWhiteSpace(text)) { fileErrors[f.Key] = "Le fichier est vide."; return; }
            Values[f.Key] = text;
        }
        catch (IOException) { fileErrors[f.Key] = "Fichier trop volumineux."; }
    }
    private bool msConfigured;
    private List<SharedCalendar> calendars = new();
    private List<DriveFolder> folders = new();
    private List<FacebookPageAccess> fbPages = new();
    private bool fbLost;

    protected override async Task OnInitializedAsync()
    {
        if (Manifest.Settings.Any(f => f.Type == "facebookpage"))
        {
            // Pages du compte Facebook connecté ; la Page déjà choisie reste affichée si le compte a changé
            var t = Store.Read(d => d.Tenant);
            fbPages = FacebookAuth.Pages(t);
            fbLost = t.FacebookLostUtc != null;
        }
        if (Manifest.Settings.FirstOrDefault(f => f.Type == "drive") is { } df)
        {
            // dossiers des sources actives ; le dossier déjà choisi reste affiché même si sa source a été désactivée
            var t = Store.Read(d => d.Tenant);
            var current = Values.GetValueOrDefault(df.Key);
            folders = DriveSources.Offered(t).ToList();
            if (t.DriveFolders.FirstOrDefault(x => x.Id.ToString() == current) is { } chosen && !folders.Contains(chosen)) folders.Insert(0, chosen);
        }
        if (Manifest.Settings.FirstOrDefault(f => f.Type == "calendar") is { } cf)
        {
            // calendriers des sources actives ; le calendrier déjà choisi reste affiché même si sa source a été désactivée
            var t = Store.Read(d => d.Tenant);
            var current = Values.GetValueOrDefault(cf.Key);
            calendars = SharedCalendarSources.Offered(t).ToList();
            if (t.SharedCalendars.FirstOrDefault(c => c.Id.ToString() == current) is { } chosen && !calendars.Contains(chosen)) calendars.Insert(0, chosen);
        }
        if (!Manifest.Settings.Any(f => f.Type == "mailbox")) return;
        var tenant = Store.Read(d => d.Tenant);
        msConfigured = MicrosoftAuth.Has(tenant, MicrosoftAuth.CalendarScope);
        if (msConfigured)
        {
            try { rooms = await Graph.ListRooms(tenant); } catch { /* annuaire inaccessible : saisie libre */ }
        }
    }
}
