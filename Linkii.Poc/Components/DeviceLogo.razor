@* Logo de l'appareil d'un écran : Android TV, Android (tablette, téléphone) ou navigateur. Aucun logo tant que l'écran n'a rien remonté. *@
@if (Kind == "androidtv")
{
    <svg class="dev-logo" width="@Size" height="@Size" viewBox="0 0 24 24" role="img" aria-label="Android TV"><title>Android TV</title><rect x="1.5" y="3.5" width="21" height="14" rx="2.2" fill="#0B1F3A" /><path d="M7.2 12.8a4.8 4.8 0 0 1 9.6 0z" fill="#3DDC84" /><circle cx="9.9" cy="11.3" r=".65" fill="#0B1F3A" /><circle cx="14.1" cy="11.3" r=".65" fill="#0B1F3A" /><path d="M8.9 7.6l1 1.5M15.1 7.6l-1 1.5" stroke="#3DDC84" stroke-width="1" stroke-linecap="round" /><path d="M8 20.5h8" stroke="#5A6B80" stroke-width="1.6" stroke-linecap="round" /></svg>
}
else if (Kind == "android")
{
    <svg class="dev-logo" width="@Size" height="@Size" viewBox="0 0 24 24" role="img" aria-label="Android"><title>Android</title><path d="M5.5 15.5a6.5 6.5 0 0 1 13 0z" fill="#3DDC84" /><circle cx="9.3" cy="12.4" r=".8" fill="#fff" /><circle cx="14.7" cy="12.4" r=".8" fill="#fff" /><path d="M8.2 6.6l1.5 2.2M15.8 6.6l-1.5 2.2" stroke="#3DDC84" stroke-width="1.3" stroke-linecap="round" /><rect x="5.5" y="16.5" width="13" height="4" rx="1.5" fill="#3DDC84" opacity=".35" /></svg>
}
else if (Kind == "web")
{
    <span class="dev-logo" title="Navigateur" style="display:inline-flex;color:var(--muted)"><Ico Name="globe" Size="@(Size - 2)" /></span>
}

@code {
    [Parameter] public string? Kind { get; set; }
    [Parameter] public int Size { get; set; } = 22;
}
