@* Icône Partage d'un élément (§53, refait le 24 octobre 2026) : picto + nombre de personnes, ou « Tous », et une infobulle (qui, avec quel droit).
   Cliquable (ouvre le partage) seulement pour le propriétaire et l'administrateur ; sinon, l'infobulle seule. Rien pour un élément non partagé. *@
@if (Summary.Any)
{
    var text = Long ? (Summary.Everyone != null ? "Toute l'organisation" : $"{Summary.People} personne{(Summary.People > 1 ? "s" : "")}") : Summary.Everyone != null ? "Partagé · tous" : $"Partagé · {Summary.People}";
    var label = Summary.Everyone != null ? "Partagé avec toute l'organisation" : $"Partagé avec {Summary.People} personne{(Summary.People > 1 ? "s" : "")}";
    var cls = ReadOnly ? "ro" : Summary.Everyone != null ? "lvl" : "";
    <span class="share-wrap" @onclick:stopPropagation="true">
        @if (Clickable)
        {
            <button type="button" class="share @cls" aria-label="@label : gérer le partage" @onclick="OnClick"><Ico Name="@(ReadOnly ? "lock" : "users")" Size="13" /> @text</button>
        }
        else
        {
            <span class="share @cls" tabindex="0" role="note" aria-label="@label"><Ico Name="@(ReadOnly ? "lock" : "users")" Size="13" /> @text</span>
        }
        <span class="share-tip" role="tooltip">
            <b class="share-h">@label</b>
            @if (!string.IsNullOrEmpty(OwnerName))
            {
                <span class="share-r"><span class="grow">@OwnerName <small>propriétaire</small></span></span>
            }
            @if (Summary.Everyone is { } all)
            {
                <span class="share-r"><span class="grow">Toute l'organisation</span><span class="pill @(all ? "ok" : "blue")">@(all ? "Peut modifier" : "Peut utiliser")</span></span>
            }
            @foreach (var p in Summary.Names.Take(8))
            {
                <span class="share-r"><span class="grow">@p.Label</span><span class="pill @(p.Edit ? "ok" : "blue")">@(p.Edit ? "Peut modifier" : "Peut utiliser")</span></span>
            }
            @if (Summary.Names.Count > 8) { <span class="share-r"><small>et @(Summary.Names.Count - 8) autre@(Summary.Names.Count - 8 > 1 ? "s" : "")</small></span> }
            @if (!Clickable) { <small class="share-n">Seul le propriétaire gère le partage.</small> }
        </span>
    </span>
}

@code {
    [Parameter, EditorRequired] public ShareSummary Summary { get; set; } = ShareSummary.None;
    /// <summary>Ouvre la fenêtre de partage (propriétaire, administrateur).</summary>
    [Parameter] public bool Clickable { get; set; }
    /// <summary>Élément d'un autre, vu en lecture seule : cadenas ambre.</summary>
    [Parameter] public bool ReadOnly { get; set; }
    /// <summary>« 5 personnes » (titre du dossier ouvert) au lieu de « 5 » (puce).</summary>
    [Parameter] public bool Long { get; set; }
    /// <summary>Nom du propriétaire, cité dans l'infobulle quand ce n'est pas la personne connectée.</summary>
    [Parameter] public string? OwnerName { get; set; }
    [Parameter] public EventCallback OnClick { get; set; }
}
