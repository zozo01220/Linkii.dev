@using System.Globalization
@* Éditeur de luminosité et de contraste (voir Dim) : profils (curseurs toujours visibles), horaires en trois repères valables tous les jours
   ou semaine peinte « jour par jour », aperçu. Maquette : maquettes/luminosite-simplification.html. *@
@if (Plan != null)
{
    var t = daily ? null : Dim.Thresholds(Plan);
    <div class="dm-cols">
        <div>
            <label class="lbl" style="margin-top:0">Profils <small>(luminosité et contraste de chaque moment de la journée)</small></label>
            <div class="dm-profs">
                @for (var i = 0; i < Plan.Profiles.Count; i++)
                {
                    var p = Plan.Profiles[i];
                    <div class="dm-prof">
                        <div class="dm-prof-h"><span class="dm-chip" style="background:@Dim.Shade(p)"></span><span class="n">@p.Name</span></div>
                        <div class="dm-pr2">
                            <div class="dm-rng"><label>Luminosité<output>@p.Brightness %</output></label><input type="range" min="@Dim.MinBrightness" max="@Dim.MaxBrightness" value="@p.Brightness" aria-label="Luminosité de @p.Name" @oninput="e => SetB(p, e)" /></div>
                            <div class="dm-rng"><label>Contraste<output>@p.Contrast %</output></label><input type="range" min="@Dim.MinContrast" max="@Dim.MaxContrast" value="@p.Contrast" aria-label="Contraste de @p.Name" @oninput="e => SetC(p, e)" /></div>
                        </div>
                    </div>
                }
            </div>

            <div class="dm-when">
                <label class="lbl" style="margin:0">Horaires <small>@(t != null ? "(valables tous les jours)" : "(cliquez ou glissez pour peindre avec le profil choisi)")</small></label>
                <div class="dm-seg2" role="group" aria-label="Mode des horaires">
                    <button type="button" class="@(t != null ? "on" : "")" @onclick="() => SetDaily(false)">Tous les jours</button>
                    <button type="button" class="@(t == null ? "on" : "")" @onclick="() => SetDaily(true)">Jour par jour</button>
                </div>
            </div>

            @if (t != null)
            {
                <div class="dm-tl" role="group" aria-label="Profil de chaque heure de la journée" @onmouseleave="() => hover = 14">
                    @for (var h = 0; h < 24; h++)
                    {
                        var hour = h; var asleep = IsAsleep(hour);
                        <span class="dm-th @(asleep ? "asleep" : "")" style="@(asleep ? "" : "background:" + Dim.Shade(Profile(hour)))" title="@hour h" @onmouseover="() => hover = hour"></span>
                    }
                </div>
                <div class="dm-ticks"><span>0 h</span><span>6 h</span><span>12 h</span><span>18 h</span><span>24 h</span></div>
                <div class="dm-thr">
                    @for (var i = 0; i < 3; i++)
                    {
                        var idx = i;
                        <label><span><i class="dm-chip sm" style="background:@Dim.Shade(Plan.Profiles[idx])"></i>@Plan.Profiles[idx].Name dès</span>
                            <select @onchange="e => SetT(idx, e)">
                                @for (var h = 0; h < 24; h++) { <option value="@h" selected="@(t[idx] == h)">@h.ToString("00") h</option> }
                            </select></label>
                    }
                </div>
            }
            else
            {
                <div class="dm-brush">Pinceau :
                    @for (var i = 0; i < Plan.Profiles.Count; i++)
                    {
                        var idx = i; var p = Plan.Profiles[i];
                        <button type="button" class="@(idx == brush ? "on" : "")" @onclick="() => brush = idx"><i style="background:@Dim.Shade(p)"></i>@p.Name</button>
                    }
                    <span class="grow"></span>
                    <button type="button" class="linklike" @onclick="Suggest">Jour, soirée et nuit</button>
                </div>
                <div class="dm-grid" role="group" aria-label="Profil de chaque heure de la semaine" @onmouseup="Stop" @onmouseleave="Stop">
                    <span></span>
                    @for (var h = 0; h < 24; h++) { <span class="sl-h">@(h % 3 == 0 ? h.ToString() : "")</span> }
                    @for (var d = 0; d < 7; d++)
                    {
                        var dd = d;
                        <span class="sl-d">@Days[dd]</span>
                        @for (var h = 0; h < 24; h++)
                        {
                            var hour = h; var k = dd * 24 + hour;
                            var asleep = IsAsleep(k);
                            <button type="button" class="dm-c @(asleep ? "asleep" : "")" style="@(asleep ? "" : "background:" + Dim.Shade(Profile(k)))" tabindex="-1" aria-label="@Days[dd] @(hour) h : @(asleep ? "veille" : Profile(k).Name)"
                                    @onmousedown="() => Start(k)" @onmousedown:preventDefault @onmouseover="() => Over(k)"></button>
                        }
                    }
                </div>
            }
            @if (Asleep != null)
            {
                <div class="sl-legend"><span><i class="sl-key dm-hatch"></i> Veille (réglée dans « Mise en veille »)</span></div>
            }
        </div>

        <div>
            <label class="lbl" style="margin-top:0">Aperçu <small>(survolez les horaires)</small></label>
            <div class="dm-tv"><div class="dm-scr"><div class="dm-in" style="filter:@(IsAsleep(hover) ? "brightness(.08)" : Filter(Profile(hover)))">
                <div class="dm-ph"></div><div class="dm-tx"><b>Accueil — bienvenue</b><i></i><i></i><i></i></div>
            </div></div></div>
            <div class="dm-cap"><span class="mono">@(t != null ? "Tous les jours" : Days[hover / 24]) @((hover % 24).ToString("00")) h</span><span>@(IsAsleep(hover) ? "En veille" : Profile(hover).Name + " · " + Profile(hover).Brightness + " % · " + Profile(hover).Contrast + " %")</span></div>
            <details class="dm-dv">
                <summary>Ce qui s'applique selon l'appareil</summary>
                <div><span>Smartphone, tablette</span><span>luminosité réelle, contraste simulé</span></div>
                <div><span>Android TV, box</span><span>luminosité et contraste simulés</span></div>
                <div><span>Autres players (PC, web)</span><span>sans effet sur l'écran</span></div>
                <p class="hint">« Simulé » : l'image est assombrie ou contrastée, mais le rétroéclairage ne change pas.</p>
            </details>
        </div>
    </div>
}

@code {
    [Parameter] public DimPlan? Plan { get; set; }
    [Parameter] public EventCallback<DimPlan> PlanChanged { get; set; }
    /// <summary>Grille de veille qui s'applique (168 « 0 » / « 1 »), pour hachurer ces heures ; null : pas de veille.</summary>
    [Parameter] public string? Asleep { get; set; }

    private static readonly string[] Days = { "Lun", "Mar", "Mer", "Jeu", "Ven", "Sam", "Dim" };
    private static readonly CultureInfo Inv = CultureInfo.InvariantCulture;
    private int brush, hover = 14;   // pinceau (profil), case survolée (heure du lundi dans la frise)
    private bool painting, daily, inited;

    protected override void OnParametersSet()
    {
        // à l'ouverture : « Tous les jours » si le réglage suit le schéma jour › soirée › nuit, sinon « Jour par jour »
        if (!inited && Plan != null) { daily = Dim.Thresholds(Plan) == null; inited = true; }
    }

    private bool IsAsleep(int k) => Sleep.Valid(Asleep) && Asleep![k] == '1';
    private DimProfile Profile(int k) => Plan!.Profiles[Math.Min(Plan.Grid[k] - '0', Plan.Profiles.Count - 1)];
    private static int Num(ChangeEventArgs e, int fallback) => int.TryParse(e.Value?.ToString(), out var n) ? n : fallback;
    private static string Filter(DimProfile p) => $"brightness({(p.Brightness / 100.0).ToString(Inv)}) contrast({(p.Contrast / 100.0).ToString(Inv)})";

    private Task Changed() => PlanChanged.InvokeAsync(Plan!);
    private Task SetB(DimProfile p, ChangeEventArgs e) { p.Brightness = Math.Clamp(Num(e, p.Brightness), Dim.MinBrightness, Dim.MaxBrightness); return Changed(); }
    private Task SetC(DimProfile p, ChangeEventArgs e) { p.Contrast = Math.Clamp(Num(e, p.Contrast), Dim.MinContrast, Dim.MaxContrast); return Changed(); }

    /// <summary>Change un repère : l'ordre jour › soirée › nuit est gardé (au moins une heure entre deux repères).</summary>
    private Task SetT(int i, ChangeEventArgs e)
    {
        var t = Dim.Thresholds(Plan) ?? Dim.Thresholds(Dim.Suggested())!;
        var v = Num(e, t[i]);
        if (i == 0) v = Math.Min(v, t[1] - 1);
        else if (i == 1) v = Math.Max(t[0] + 1, Math.Min(v, t[2] - 1));
        else v = Math.Max(v, t[1] + 1);
        t[i] = Math.Clamp(v, 0, 23);
        Plan!.Grid = Dim.GridFrom(t);
        return Changed();
    }

    private Task SetDaily(bool on)
    {
        if (on == daily) return Task.CompletedTask;
        daily = on; hover = on ? 9 : 14;
        if (!on && Dim.Thresholds(Plan) == null)
        {
            // retour à « Tous les jours » : trois profils et horaires par défaut (la semaine peinte à la main est remplacée)
            while (Plan!.Profiles.Count < 3) Plan.Profiles.Add(new DimProfile { Name = "Profil " + (Plan.Profiles.Count + 1) });
            Plan.Grid = Dim.GridFrom(Dim.Thresholds(Dim.Suggested())!);
            return Changed();
        }
        return Task.CompletedTask;
    }

    private Task Start(int k) { if (IsAsleep(k)) return Task.CompletedTask; painting = true; hover = k; return Paint(k); }
    private Task Over(int k) { hover = k; return painting ? Paint(k) : Task.CompletedTask; }
    private void Stop() => painting = false;

    private Task Paint(int k)
    {
        if (IsAsleep(k) || Plan!.Grid[k] - '0' == brush) return Task.CompletedTask;
        var c = Plan.Grid.ToCharArray(); c[k] = (char)('0' + brush);
        Plan.Grid = new string(c);
        return Changed();
    }

    private Task Suggest()
    {
        while (Plan!.Profiles.Count < 3) Plan.Profiles.Add(new DimProfile { Name = "Profil " + (Plan.Profiles.Count + 1) });
        Plan.Grid = Dim.SuggestedGrid();
        return Changed();
    }
}
