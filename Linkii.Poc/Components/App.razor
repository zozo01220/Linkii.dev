<!DOCTYPE html>
<html lang="fr">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <base href="/" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=IBM+Plex+Sans:wght@400;500&family=JetBrains+Mono:wght@500&display=swap" />
    <link rel="stylesheet" href="app.css" />
    @* Installation sur l'écran d'accueil (Android, iPhone, iPad) : manifeste par revendeur, icônes, mode « application » iOS *@
    <link rel="manifest" href="/manifest.webmanifest" />
    <meta name="theme-color" content="@BrandColor" />
    <meta name="mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-title" content="@AppName" />
    <meta name="apple-mobile-web-app-status-bar-style" content="default" />
    <link rel="icon" type="image/png" href="/icons/icon-192.png" />
    <link rel="apple-touch-icon" href="/icons/apple-touch-icon.png" />
    <HeadOutlet @rendermode="PageRenderMode" />
</head>
<body class="@(IsApp ? "is-app" : null)">
    <Routes @rendermode="PageRenderMode" />
    <div id="pwa-install" class="pwa-install" data-permanent hidden role="region" aria-label="Installer l'application"></div>
    <script src="app-mode.js"></script>
    <script src="app-fab.js?v=2"></script>
    <script src="pwa.js"></script>
    <script src="yt-probe.js"></script>
    <script src="widget-canvas.js"></script>
    <script src="prefs.js?v=2"></script>
    <script src="library.js"></script>
    <script src="sort-list.js"></script>
    <script src="playlist-flow.js"></script>
    <script src="qr-place.js"></script>
    <script src="carousel3d.js"></script>
    <script src="player/composition.js?v=85"></script>
    <script src="compo-templates.js?v=1"></script>
    <script src="compo-editor.js?v=89"></script>
    <script src="auth.js"></script>
    <script src="sim.js"></script>
    <script src="adm-cards.js"></script>
    <script src="push-register.js?v=2"></script>
    <script src="_framework/blazor.web.js" autostart="false"></script>
    <script src="reconnect.js"></script>
</body>
</html>

@code {
    [CascadingParameter] private HttpContext HttpContext { get; set; } = default!;

    private Reseller? Brand => HttpContext.Items["reseller"] as Reseller;
    private string BrandColor => Brand?.BrandColor is { Length: > 0 } c ? c : "#0B1F3A";
    // L'app Android du back-office ajoute « LinkiiBackOffice/x.y » à son identifiant : seule elle reçoit le look « app » (barre du bas, cartes, Réglages en liste). Le site PC et le navigateur mobile ne changent pas.
    private bool IsApp => HttpContext.Request.Headers.UserAgent.ToString().Contains("LinkiiBackOffice/", StringComparison.Ordinal);
    private string AppName => Brand?.DisplayName is { Length: > 0 } n ? n : "Linkii";

    // La page /login reste en rendu statique : il leur faut le HttpContext pour poser le cookie.
    private IComponentRenderMode? PageRenderMode => HttpContext.Request.Path.StartsWithSegments("/login") ? null : InteractiveServer;
}
