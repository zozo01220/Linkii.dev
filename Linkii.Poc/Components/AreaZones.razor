@* Zones d'une aire (corps de fenêtre) : renommer, supprimer, ajouter, synchroniser. Chaque action est enregistrée aussitôt. Les zones classent les écrans, sans effet sur les droits.
   La zone par défaut est dans chaque aire : elle se renomme mais ne se supprime pas. Dans une zone synchronisée, les écrans qui jouent la même liste sont alignés. *@
@inject TenantStore Store
@inject Notifier Notifier
@inject Toaster Toast

<div class="zlist">
    <div class="zhead">
        <span></span><span>Zone</span><span>Écrans</span><span>Synchronisation</span><span></span>
    </div>
    @foreach (var z in zones)
    {
        var zone = z;
        var n = counts.GetValueOrDefault(zone.Id);
        <div class="zrow @(zone.IsWall ? "wall" : "")">
            <Ico Name="box" Size="16" />
            <input class="zname" maxlength="60" value="@zone.Name" aria-label="Nom de la zone" @onchange="e => Rename(zone, e.Value?.ToString() ?? zone.Name)" />
            <span class="cnt">@n<small>écran@(n > 1 ? "s" : "")</small></span>
            <span class="syn">
                @if (zone.IsWall)
                {
                    <span class="badge sync" title="Une seule image répartie sur @(zone.WallCols * zone.WallRows) écrans">Mur @zone.WallCols × @zone.WallRows</span>
                    <span class="sm">Synchro toujours active</span>
                }
                else
                {
                    <span class="badge neutre" title="Écrans de tout type, chacun avec sa liste de lecture">Zone libre</span>
                    @if (zone.Sync) { <span class="sm on">Synchronisée</span> }
                }
            </span>
            <div class="kebab">
                <button type="button" class="kebab-btn" aria-label="Actions pour la zone @zone.Name" aria-haspopup="menu" aria-expanded="@(menuFor == zone.Id ? "true" : "false")" @onclick="() => menuFor = menuFor == zone.Id ? null : zone.Id"><Ico Name="dots-v" Size="18" /></button>
                @if (menuFor == zone.Id)
                {
                    <div class="kebab-backdrop" @onclick="() => menuFor = null"></div>
                    <div class="kebab-menu" role="menu">
                        @if (!zone.IsWall)
                        {
                            <button type="button" role="menuitem" @onclick="() => ToggleSync(zone)">@(zone.Sync ? "Couper la synchronisation" : "Synchroniser les écrans de cette zone")</button>
                        }
                        @if (!zone.IsDefault)
                        {
                            <button type="button" role="menuitem" class="danger" @onclick="() => Delete(zone)"><Ico Name="trash" Size="16" /> @(zone.IsWall ? "Dissoudre le mur" : "Supprimer la zone")</button>
                        }
                    </div>
                }
            </div>
        </div>
    }
    <div class="zadd">
        <Ico Name="plus" Size="16" />
        <input maxlength="60" placeholder="Nouvelle zone (ex. : Accueil, Bâtiment B)" @bind="newName" @bind:event="oninput" @onkeydown="OnKey" aria-label="Nouvelle zone" />
        <button type="button" class="btn ghost sm" @onclick="Add">Ajouter</button>
    </div>
</div>
@if (error != null) { <div class="err">@error</div> }

@code {
    [Parameter] public Guid AreaId { get; set; }
    [Parameter] public EventCallback OnChanged { get; set; }

    private List<Zone> zones = new();
    private Dictionary<Guid, int> counts = new();
    private string newName = "";
    private string? error;
    private Guid? menuFor;

    protected override void OnParametersSet() => Load();

    private void Load()
    {
        // la zone par défaut d'abord, puis les autres par nom
        zones = Store.Read(d => d.Areas.FirstOrDefault(a => a.Id == AreaId)?.Zones
            .OrderByDescending(z => z.IsDefault).ThenBy(z => z.Name, StringComparer.CurrentCultureIgnoreCase)
            .Select(z => new Zone { Id = z.Id, Name = z.Name, IsDefault = z.IsDefault, Kind = z.Kind, Sync = z.Sync, SyncEpochUtc = z.SyncEpochUtc, WallCols = z.WallCols, WallRows = z.WallRows, PlaylistId = z.PlaylistId }).ToList() ?? new());
        counts = Store.Read(d => d.Root.Screens.Where(s => s.ClientId == d.ClientId && s.AreaId == AreaId && s.Token != null && s.ZoneId != null)
            .GroupBy(s => s.ZoneId!.Value).ToDictionary(g => g.Key, g => g.Count()));
    }

    private async Task Done(string? err, string? ok = null)
    {
        error = err;
        if (err == null && ok != null) Toast.Ok(ok);
        Load();
        await OnChanged.InvokeAsync();
    }

    private async Task Add()
    {
        var n = newName;
        var (_, err) = Store.Write(d => AreaOps.AddZone(d, AreaId, n));
        if (err == null) newName = "";
        await Done(err, err == null ? $"Zone « {n.Trim()} » ajoutée." : null);
    }

    private async Task OnKey(KeyboardEventArgs e) { if (e.Key == "Enter") await Add(); }

    private async Task Rename(Zone z, string name)
    {
        if (name.Trim() == z.Name) return;
        await Done(Store.Write(d => AreaOps.RenameZone(d, AreaId, z.Id, name)), $"Zone renommée en « {name.Trim()} ».");
    }

    private async Task Delete(Zone z)
    {
        menuFor = null;
        var ids = Store.Read(d => d.Root.Screens.Where(s => s.ClientId == d.ClientId && s.ZoneId == z.Id).Select(s => s.Id).ToList());
        var err = Store.Write(d => AreaOps.DeleteZone(d, AreaId, z.Id));
        if (err == null) { await Notifier.PublishPlanning(ids); foreach (var id in ids) await Notifier.NotifyScreen(id); }   // leur zone change : planning et synchro peuvent changer
        await Done(err, z.IsWall ? $"Mur « {z.Name} » dissous." : $"Zone « {z.Name} » supprimée.");
    }

    private async Task ToggleSync(Zone z)
    {
        menuFor = null;
        var on = !z.Sync;
        var err = Store.Write(d => AreaOps.SetZoneSync(d, AreaId, z.Id, on));
        if (err == null) await Notifier.NotifyZone(z.Id);   // les écrans de la zone rechargent leur configuration
        await Done(err, err == null ? (on ? $"Lecture synchronisée dans la zone « {z.Name} »." : $"Synchronisation coupée dans la zone « {z.Name} ».") : null);
    }
}
