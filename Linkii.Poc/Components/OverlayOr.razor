@* Contenu affiché en fenêtre (section « overlay », au-dessus de la page) ou directement dans la page (Inline) : un même éditeur sert aux deux (§202). *@
@if (Inline)
{
    @ChildContent
}
else
{
    <SectionContent SectionName="overlay">@ChildContent</SectionContent>
}

@code {
    [Parameter] public bool Inline { get; set; }
    [Parameter] public RenderFragment? ChildContent { get; set; }
}
