@* Consentements demandés à la création d'un espace : conditions générales (obligatoire, sans elles « Créer mon espace » reste inactif),
   démarches commerciales et nouveautés (facultatifs, désactivés par défaut). Les conditions s'ouvrent dans une fenêtre (TermsDialog). *@
<div class="consents">
    <label class="consent">
        <InputCheckbox @bind-Value="Model.Terms" name="@($"{Prefix}.Terms")" class="switch-input" data-terms required />
        <span class="switch-ui" aria-hidden="true"></span>
        <span class="txt">J'accepte les <button type="button" class="linkish" data-open-dialog="terms-dialog">conditions générales de Linkii</button> <span class="req">obligatoire</span></span>
    </label>
    <label class="consent">
        <InputCheckbox @bind-Value="Model.Marketing" name="@($"{Prefix}.Marketing")" class="switch-input" />
        <span class="switch-ui" aria-hidden="true"></span>
        <span class="txt">J'accepte de recevoir les offres commerciales de Linkii <span class="opt">facultatif</span></span>
    </label>
    <label class="consent">
        <InputCheckbox @bind-Value="Model.News" name="@($"{Prefix}.News")" class="switch-input" />
        <span class="switch-ui" aria-hidden="true"></span>
        <span class="txt">Je souhaite être informé des nouveautés et astuces <span class="opt">facultatif</span><small>Désinscription à tout moment, depuis votre compte ou chaque e-mail.</small></span>
    </label>
</div>

@code {
    [Parameter, EditorRequired] public Linkii.Poc.Components.Pages.Login.SignupModel Model { get; set; } = default!;
    /// <summary>Nom du formulaire côté serveur (paramètre [SupplyParameterFromForm] de la page) : préfixe des champs postés.</summary>
    [Parameter, EditorRequired] public string Prefix { get; set; } = "";
}
