@inherits LayoutComponentBase
@inject JsonStore Root
@inject TenantContext Ctx
@inject IServiceProvider Services
@inject NavigationManager Nav
@inject AppCatalog Catalog
@inject ModeService Modes
@inject MenuBadges Badges
@implements IDisposable

<HeadContent>
    <style>:root { --brand: @brand; }</style>
</HeadContent>

<div class="shell @(Ctx.ClientId != null || AdminSpace ? "has-tabs" : "")">
    @if (navOpen) { <div class="nav-backdrop" @onclick="() => { navOpen = false; open = false; }"></div> }
    <aside class="sidebar @(navOpen ? "open" : "")" @onclick="() => { navOpen = false; open = false; }">
        @* En-tête : logo long (menu déplié) ou petit logo (menu replié), plan et version à sa droite, bouton de pliage (nav-fold.js). *@
        <div class="brand">
            @if (PlanLabel is { } pls) { <span class="brand-plan plan-chip @(pls == "Pro" ? "pro" : "ess")" title="Plan de votre organisation"><Ico Name="@(pls == "Pro" ? "crown" : "bolt")" Size="11" />@pls</span> }
            @if (reseller == null || reseller.IsDefault)
            {
                <span class="brand-logo" data-tip="Linkivi@(PlanLabel is { } pt ? " · " + pt : "") · v@(AppVersion.Short)"><img class="bl-long" src="brand/logo-long.png" alt="Linkivi" /><img class="bl-short" src="brand/logo-court.png" alt="" /></span>
            }
            else
            {
                <span class="brand-logo" data-tip="@reseller.DisplayName"><span class="bl-long"><BrandMark R="reseller" Size="30" /></span><span class="bl-short mark">@reseller.DisplayName[..1].ToUpperInvariant()</span></span>
            }
            <span class="brand-meta">@if (PlanLabel is { } pl) { <span class="plan-tag @(pl == "Pro" ? "pro" : "")" title="Plan de votre organisation"><Ico Name="@(pl == "Pro" ? "crown" : "bolt")" Size="13" />@pl</span> }<span class="ver" title="@AppVersion.Full">v@(AppVersion.Short)</span></span>
            <button type="button" class="nav-fold" aria-label="Replier le menu" aria-expanded="true" data-tip="Déplier le menu"><svg viewBox="0 0 24 24"><path d="M15 6l-6 6 6 6" /></svg></button>
        </div>

        @if (Ctx.ClientId != null)
        {
            @* Menu en hubs : Écrans, Programmation (listes de lecture + planning), Contenus (médiathèque, compositions, widgets, intégrations), Statistiques.
               Un hub s'ouvre sur sa première page ; ses pages sont des onglets au-dessus du contenu (voir HubBar). Pages ouvertes par le niveau de droits du membre. *@
            @if (Sees(LevelPages.Screens))
            {
                <NavLink class="nav" href="" Match="NavLinkMatch.All">
                    <svg viewBox="0 0 24 24"><rect x="2" y="3" width="20" height="14" rx="2" /><path d="M8 21h8M12 17v4" /></svg> Écrans @Pill("screens")
                </NavLink>
            }
            @if (ProgTabs.Count > 0)
            {
                <NavLink class="@HubClass(ProgTabs)" href="@ProgTabs[0].Path">
                    <svg viewBox="0 0 24 24"><path d="M8 6h13M8 12h13M8 18h13M3 6h.01M3 12h.01M3 18h.01" /></svg> Programmation @Pill("playlists")
                </NavLink>
            }
            @if (ContentTabs.Count > 0)
            {
                <NavLink class="@HubClass(ContentTabs)" href="@ContentTabs[0].Path">
                    <svg viewBox="0 0 24 24"><rect x="3" y="3" width="18" height="18" rx="2" /><circle cx="8.5" cy="8.5" r="1.5" /><path d="M21 15l-5-5L5 21" /></svg> Contenus @Pill(MenuBadges.MediaFam, MenuBadges.Compositions)
                </NavLink>
            }
            @if (Modes.Expert)
            {
                <NavLink class="nav" href="stats">
                    <svg viewBox="0 0 24 24"><path d="M3 3v18h18" /><path d="M7 15l4-4 3 3 6-6" /></svg> Statistiques
                </NavLink>
            }
        }
        else if (Ctx.IsPlatformAdmin)
        {
            <NavLink class="nav" href="admin" Match="NavLinkMatch.All"><Ico Name="gauge" Size="18" /> Tableau de bord</NavLink>
            <div class="nav-sep" role="separator"></div>
            <NavLink class="nav" href="admin/clients"><Ico Name="building" Size="18" /> Clients</NavLink>
            <NavLink class="nav" href="admin/opportunities"><Ico Name="mail-send" Size="18" /> Opportunités</NavLink>
            <NavLink class="nav" href="admin/resellers"><Ico Name="team" Size="18" /> Revendeurs</NavLink>
            <NavLink class="nav" href="admin/billing"><Ico Name="chart" Size="18" /> Facturation</NavLink>
            <NavLink class="nav" href="admin/ads"><Ico Name="megaphone" Size="18" /> Publicité</NavLink>
            <div class="nav-sep" role="separator"></div>
            <NavLink class="nav" href="admin/settings"><Ico Name="gear" Size="18" /> Réglages</NavLink>
        }
        else if (Ctx.IsResellerAdmin)
        {
            <NavLink class="nav" href="reseller" Match="NavLinkMatch.All"><Ico Name="gauge" Size="18" /> Tableau de bord</NavLink>
            <div class="nav-sep" role="separator"></div>
            <NavLink class="nav" href="reseller/clients"><Ico Name="building" Size="18" /> Clients</NavLink>
            <NavLink class="nav" href="reseller/brand"><Ico Name="palette" Size="18" /> Marque</NavLink>
            <NavLink class="nav" href="reseller/team"><Ico Name="team" Size="18" /> Équipe</NavLink>
            <div class="nav-sep" role="separator"></div>
            <NavLink class="nav" href="reseller/billing"><Ico Name="chart" Size="18" /> Facturation</NavLink>
        }

        <div class="spacer"></div>
        @if (Ctx.ClientId != null && ((Modes.Expert && (orgAdmin || Sees(LevelPages.Zones))) || orgAdmin))
        {
            @* Administration, en bas juste au-dessus du compte : Organisation (aires, zones, membres, rôles) pour l'administrateur ; un membre qui peut gérer les zones garde « Zones ». *@
            @if (Modes.Expert && orgAdmin)
            {
                <NavLink class="nav" href="organisation">
                    <Ico Name="team" Size="18" /> Organisation @Pill("members")
                </NavLink>
            }
            else if (Modes.Expert && Sees(LevelPages.Zones))
            {
                <NavLink class="nav" href="zones">
                    <Ico Name="box" Size="18" /> Zones
                </NavLink>
            }
            @if (orgAdmin)
            {
                <NavLink class="nav" href="settings">
                    <Ico Name="gear" Size="18" /> Réglages @Pill("settings")
                </NavLink>
            }
        }
        @if (Ctx.ClientId != null && !Ctx.IsImpersonating)
        {
            @* Mode d'utilisation : au-dessus du compte. Simple masque la planification, l'administration et les intégrations. *@
            <button type="button" class="nav mode-switch" role="switch" aria-checked="@(Modes.Expert ? "true" : "false")" @onclick="ToggleMode">
                <svg class="mode-ic" viewBox="0 0 24 24"><path d="M4 7h16M4 12h16M4 17h10" /></svg>
                <span>Mode expert</span>
                <span class="switch @(Modes.Expert ? "on" : "")"><span></span></span>
            </button>
        }
        @* Compte : en bas du menu latéral ; le menu s'ouvre vers le haut. *@
        <div class="user side-user" @onclick:stopPropagation="true">
            <button type="button" class="user-btn" @onclick="() => open = !open" aria-haspopup="true" aria-expanded="@(open ? "true" : "false")">
                <span class="avatar">@Initials</span>
                <span class="who"><b title="@orgName">@orgName</b><small title="@userEmail">@userEmail</small></span>
                <svg class="chev" viewBox="0 0 24 24"><path d="M6 15l6-6 6 6" /></svg>
            </button>
            @if (open)
            {
                <div class="menu-backdrop" @onclick="() => open = false"></div>
                <div class="menu" role="menu">
                    @if (Ctx.ClientId == null || Ctx.IsClientMember && !Ctx.IsImpersonating)
                    {
                        <a href="account" role="menuitem" @onclick="() => { open = false; navOpen = false; }"><Ico Name="user" Size="16" /> Mon compte</a>
                    }
                    <button type="button" role="menuitem" class="install-item" data-install @onclick="() => open = false"><Ico Name="download" Size="16" /> Installer l'application</button>
                    <form method="post" action="/logout">
                        <button type="submit" role="menuitem" class="logout"><Ico Name="logout" Size="16" /> Se déconnecter</button>
                    </form>
                </div>
            }
        </div>
        @if (reseller is { ShowPoweredBy: true, IsDefault: false })
        {
            <div class="powered">Propulsé par Linkivi</div>
        }
    </aside>

    <div class="main-col">
        @if (Ctx.IsImpersonating)
        {
            <div class="impersonation">
                <span>Vous êtes dans l'espace de <b>@orgName</b> (accès journalisé).</span>
                <form method="post" action="/space/exit"><button type="submit">Quitter l'espace client</button></form>
            </div>
        }
        @if (suspended)
        {
            <div class="trial-bar ended"><Ico Name="lock" Size="16" /><span><b>Votre espace est suspendu.</b> Vos écrans ne diffusent plus. Vous pouvez toujours consulter et préparer vos contenus. <a href="@siteUrl" target="_blank" rel="noopener">Contactez-nous</a> pour le réactiver.</span></div>
        }
        @if (subEndedLabel != null)
        {
            <div class="trial-bar ended"><Ico Name="hourglass" Size="16" /><span class="grow"><b>Votre abonnement est terminé.</b> Vos écrans ne diffusent plus.@(deleteLabel != null ? $" Vos contenus seront supprimés le {deleteLabel}." : "")</span>@PlanButton("Reprendre un plan")</div>
        }
        else if (trialEnd is { } end)
        {
            var left = (int)Math.Ceiling((end - DateTime.UtcNow).TotalDays);
            @if (left <= 0)
            {
                <div class="trial-bar ended"><Ico Name="hourglass" Size="16" /><span class="grow"><b>Votre essai gratuit est terminé.</b> Vos écrans affichent « Essai terminé ».@(deleteLabel != null ? $" Vos contenus seront supprimés le {deleteLabel}." : "")</span>@PlanButton("Choisir mon plan")</div>
            }
            else
            {
                @* bandeau de l'essai : orange les derniers jours *@
                var total = Math.Max(1, trialTotal);
                <div class="trial-bar @(left <= 2 ? "soon" : "")"><Ico Name="hourglass" Size="16" /><span class="grow"><b>Essai gratuit</b> · @left jour@(left > 1 ? "s" : "") restant@(left > 1 ? "s" : "") (jusqu'au @trialEndLabel)@(left <= 2 ? " : choisissez un plan pour que vos écrans continuent de diffuser." : ", toutes les fonctions incluses.")</span>
                    <span class="trial-meter" aria-hidden="true"><i style="width:@(Math.Clamp(100 - left * 100 / total, 4, 100))%"></i></span>@PlanButton("Choisir mon plan")</div>
            }
        }
        else if (cancelLabel != null && orgAdmin)
        {
            <div class="trial-bar soon"><Ico Name="calendar" Size="16" /><span class="grow">Abonnement résilié : vos écrans diffusent jusqu'au <b>@cancelLabel</b>.</span>@PlanButton("Annuler la résiliation")</div>
        }
        <header class="topbar">
            <button type="button" class="nav-toggle" aria-label="Menu" aria-expanded="@(navOpen ? "true" : "false")" @onclick="() => { navOpen = !navOpen; open = false; }"><Ico Name="menu" Size="22" /></button>
            <div class="org">@orgName</div>
            @if (Ctx.ClientId != null && !Ctx.IsImpersonating)
            {
                @* Look « app » : mode simple / expert toujours visible dans la barre du haut (masqué ailleurs par le CSS). *@
                <button type="button" class="app-mode" role="switch" aria-checked="@(Modes.Expert ? "true" : "false")" aria-label="Mode expert" @onclick="ToggleMode"><span>Expert</span><span class="switch sm @(Modes.Expert ? "on" : "")"><span></span></span></button>
            }
            @if (AdminSpace) { <span class="app-space">@(Ctx.IsPlatformAdmin ? "Admin" : "Revendeur")</span> }
        </header>
        @{ var roDomain = ReadOnlyDomain; }
        @if (readOnly) { <div class="trial-bar"><Ico Name="lock" Size="16" /><span>Vous êtes en <b>lecture seule</b> : vous voyez tout ce que possède l'organisation, sans rien modifier ni publier.</span></div> }
        else if (roDomain != null) { <div class="trial-bar"><Ico Name="lock" Size="16" /><span><b>Lecture seule</b> : vous voyez @(roDomain == LevelPages.Media ? "tous les médias de l'organisation, sans les modifier" : roDomain == LevelPages.Playlists ? "toutes les listes de l'organisation, sans les modifier" : "tous les écrans de l'organisation, sans les modifier ni les publier").</span></div> }
        @if (SimpleLocked) { <div class="trial-bar"><Ico Name="lock" Size="16" /><span><b>Lecture seule en mode simple.</b> Passez en mode expert pour modifier cette page.</span><button type="button" class="btn sm" @onclick="() => Modes.Switch(true)">Passer en mode expert</button></div> }
        <main class="content @(readOnly || roDomain != null || SimpleLocked ? "ro" : "") @(SimpleLocked ? "ro-simple" : "")">
            @if (CurrentHub is { } hub)
            {
                @* Pages d'un hub (Programmation, Contenus) : onglets au-dessus du contenu, avec les pastilles de chaque page. *@
                <nav class="hub-tabs" aria-label="Pages">
                    @foreach (var t in hub)
                    {
                        <NavLink class="hub-tab" href="@t.Path">@t.Label @if (t.Fam != null) { @Pill(t.Fam) }</NavLink>
                    }
                </nav>
            }
            @if (ExpertOnlyHere)
            {
                <div class="card empty"><div class="big">Disponible en mode expert</div><p>Cette page fait partie des fonctions avancées (planning, aires de gestion, zones, membres, intégrations, widgets). Elle n'est pas affichée en mode simple.</p><button type="button" class="btn" @onclick="() => Modes.Switch(true)">Passer en mode expert</button></div>
            }
            else
            {
                <RightsBoundary @ref="boundary">@Body</RightsBoundary>
            }
        </main>
        @* Fenêtres empilées au-dessus d'une autre (sélecteur de médias) : rendues ici, hors de la fenêtre parente (son transform décalerait position: fixed). *@
        <SectionOutlet SectionName="overlay" />
        <Toasts />
        @if (Ctx.ClientId != null)
        {
            @* Look « app » (classe is-app, posée seulement pour l'app Android) : barre d'onglets en bas et menu « Plus » en feuille. Masqués partout ailleurs par le CSS. *@
            @if (more)
            {
                <div class="app-dim" @onclick="() => more = false"></div>
                <div class="app-more" role="dialog" aria-label="Plus">
                    <div class="grab"></div>
                    <div class="mh"><span class="avatar">@Initials</span><div class="who2"><b>@(userName)</b><small>@orgName</small></div><button type="button" class="mx" aria-label="Fermer" @onclick="() => more = false"><Ico Name="x" Size="16" /></button></div>
                    <div class="mg">
                        @if (orgAdmin && Modes.Expert) { <NavLink href="organisation" @onclick="CloseMore"><span class="ic"><Ico Name="team" Size="22" /></span>Membres</NavLink> }
                        @if (Modes.Expert && !orgAdmin && Sees(LevelPages.Zones)) { <NavLink href="zones" @onclick="CloseMore"><span class="ic"><Ico Name="box" Size="22" /></span>Zones</NavLink> }
                        @if (CompositionsMenu) { <NavLink href="compositions" @onclick="CloseMore"><span class="ic"><Ico Name="images" Size="22" /></span>Compositions</NavLink> }
                        @if (Sees(LevelPages.Widgets)) { <NavLink href="widgets" @onclick="CloseMore"><span class="ic"><Ico Name="grid" Size="22" /></span>Widgets</NavLink> }
                        @if (Modes.Expert && Sees(LevelPages.Integrations)) { <NavLink href="integrations" @onclick="CloseMore"><span class="ic"><Ico Name="link" Size="22" /></span>Intégrations</NavLink> }
                        @if (Modes.Expert) { <NavLink href="stats" @onclick="CloseMore"><span class="ic n"><Ico Name="chart" Size="22" /></span>Statistiques</NavLink> }
                    </div>
                    <div class="ml">
                        @if (orgAdmin) { <NavLink href="settings" @onclick="CloseMore"><span class="ic n"><Ico Name="gear" Size="18" /></span><b>Réglages</b><Ico Name="chevron-right" Size="16" /></NavLink> }
                        @* « Mon compte » est dans Réglages pour l'administrateur ; le membre sans Réglages le garde ici *@
                        @if (!orgAdmin && !Ctx.IsImpersonating)
                        {
                            <NavLink href="account" @onclick="CloseMore"><span class="ic"><Ico Name="user" Size="18" /></span><b>Mon compte</b><Ico Name="chevron-right" Size="16" /></NavLink>
                        }
                        <form method="post" action="/logout"><button type="submit" class="logout"><span class="ic d"><Ico Name="logout" Size="18" /></span><b>Se déconnecter</b></button></form>
                    </div>
                </div>
            }
            <nav class="app-tabs @(more ? "more" : "")" aria-label="Navigation">
                @if (Sees(LevelPages.Media)) { <NavLink href="media" @onclick="CloseMore"><svg viewBox="0 0 24 24"><rect x="3" y="3" width="18" height="18" rx="2" /><circle cx="8.5" cy="8.5" r="1.5" /><path d="M21 15l-5-5L5 21" /></svg><span>Médias</span></NavLink> }
                @if (Sees(LevelPages.Playlists)) { <NavLink href="playlists" @onclick="CloseMore"><svg viewBox="0 0 24 24"><path d="M8 6h13M8 12h13M8 18h13M3 6h.01M3 12h.01M3 18h.01" /></svg><span>Listes</span></NavLink> }
                @if (Sees(LevelPages.Screens)) { <NavLink class="hero" href="" Match="NavLinkMatch.All" @onclick="CloseMore"><span class="b"><svg viewBox="0 0 24 24"><rect x="2" y="3" width="20" height="14" rx="2" /><path d="M8 21h8M12 17v4" /></svg></span><span>Écrans</span></NavLink> }
                @if (!Modes.Expert && Sees(LevelPages.Integrations)) { <NavLink href="integrations" @onclick="CloseMore"><svg viewBox="0 0 24 24"><path d="M9 2v6M15 2v6M6 8h12v3a6 6 0 0 1-12 0V8zM12 17v5" /></svg><span>Intégrations</span></NavLink> }
                @if (Sees(LevelPages.Planning) && Modes.Expert) { <NavLink href="planning" @onclick="CloseMore"><svg viewBox="0 0 24 24"><rect x="3" y="5" width="18" height="16" rx="2" /><path d="M3 10h18M8 3v4M16 3v4" /></svg><span>Planning</span></NavLink> }
                <button type="button" class="@(more ? "on" : "")" aria-haspopup="dialog" aria-expanded="@(more ? "true" : "false")" @onclick="() => more = !more"><svg viewBox="0 0 24 24"><circle cx="5" cy="12" r="1.3" /><circle cx="12" cy="12" r="1.3" /><circle cx="19" cy="12" r="1.3" /></svg><span>Plus</span></button>
            </nav>
        }
        else if (AdminSpace)
        {
            @* Look « app » de la console Linkivi et de l'espace revendeur : même barre du bas et même feuille « Plus » que l'espace client. *@
            var adm = Ctx.IsPlatformAdmin;
            var root = adm ? "admin" : "reseller";
            @if (more)
            {
                <div class="app-dim" @onclick="() => more = false"></div>
                <div class="app-more" role="dialog" aria-label="Plus">
                    <div class="grab"></div>
                    <div class="mh"><span class="avatar">@Initials</span><div class="who2"><b>@(userName)</b><small>@orgName</small></div><button type="button" class="mx" aria-label="Fermer" @onclick="() => more = false"><Ico Name="x" Size="16" /></button></div>
                    <div class="ml">
                        @if (adm) { <NavLink href="admin/opportunities" @onclick="CloseMore"><span class="ic"><Ico Name="mail-send" Size="18" /></span><b>Opportunités</b><Ico Name="chevron-right" Size="16" /></NavLink> }
                        @if (adm) { <NavLink href="admin/ads" @onclick="CloseMore"><span class="ic"><Ico Name="megaphone" Size="18" /></span><b>Publicité</b><Ico Name="chevron-right" Size="16" /></NavLink> }
                        @if (adm) { <NavLink href="admin/settings" @onclick="CloseMore"><span class="ic n"><Ico Name="gear" Size="18" /></span><b>Réglages</b><Ico Name="chevron-right" Size="16" /></NavLink> }
                        else { <NavLink href="reseller/brand" @onclick="CloseMore"><span class="ic n"><Ico Name="palette" Size="18" /></span><b>Marque</b><Ico Name="chevron-right" Size="16" /></NavLink> }
                        <NavLink href="account" @onclick="CloseMore"><span class="ic"><Ico Name="user" Size="18" /></span><b>Mon compte</b><Ico Name="chevron-right" Size="16" /></NavLink>
                        <button type="button" class="install-item" data-install @onclick="CloseMore"><span class="ic"><Ico Name="download" Size="18" /></span><b>Installer l'application</b></button>
                        <form method="post" action="/logout"><button type="submit" class="logout"><span class="ic d"><Ico Name="logout" Size="18" /></span><b>Se déconnecter</b></button></form>
                    </div>
                </div>
            }
            <nav class="app-tabs @(more ? "more" : "")" aria-label="Navigation">
                <NavLink href="@root" Match="NavLinkMatch.All" @onclick="CloseMore"><Ico Name="gauge" Size="22" /><span>Accueil</span></NavLink>
                @if (adm) { <NavLink href="admin/resellers" @onclick="CloseMore"><Ico Name="team" Size="22" /><span>Revendeurs</span></NavLink> }
                else { <NavLink href="reseller/team" @onclick="CloseMore"><Ico Name="team" Size="22" /><span>Équipe</span></NavLink> }
                <NavLink class="hero" href="@(root + "/clients")" @onclick="CloseMore"><span class="b"><Ico Name="building" Size="22" /></span><span>Clients</span></NavLink>
                <NavLink href="@(root + "/billing")" @onclick="CloseMore"><Ico Name="chart" Size="22" /><span>Facturation</span></NavLink>
                <button type="button" class="@(more ? "on" : "")" aria-haspopup="dialog" aria-expanded="@(more ? "true" : "false")" @onclick="() => more = !more"><svg viewBox="0 0 24 24"><circle cx="5" cy="12" r="1.3" /><circle cx="12" cy="12" r="1.3" /><circle cx="19" cy="12" r="1.3" /></svg><span>Plus</span></button>
            </nav>
        }
    </div>
</div>

@* Présentation unique du mode expert, au premier passage en expert. *@
@if (Modes.IntroDue)
{
    <div class="modal-backdrop"></div>
    <div class="modal app-modal sm" role="dialog" aria-modal="true" aria-labelledby="expert-title">
        <div class="modal-head"><h3 id="expert-title">Mode expert activé</h3></div>
        <div class="modal-body">
            <p class="hint">Ces fonctions sont maintenant visibles. Elles restent masquées en mode simple.</p>
            <ul class="opt-list">
                <li><b>Planning</b> · programmer les diffusions par créneau et par zone.</li>
                <li><b>Organisation</b> · vos aires, leurs zones, et qui y a accès avec quels droits.</li>
                <li><b>Membres</b> · inviter des personnes et définir leurs droits.</li>
                <li><b>Intégrations</b> · relier Google, Microsoft, Facebook et les autres sources.</li>
                <li><b>Widgets</b> · ajouter horloge, météo et autres contenus animés.</li>
            </ul>
        </div>
        <div class="modal-foot">
            <label class="grow" style="display:flex;align-items:center;gap:8px;font-size:13px;color:var(--muted)"><input type="checkbox" class="ios" @bind="dontShowAgain" /> Ne plus afficher ce message</label>
            <button type="button" class="btn" @onclick="() => Modes.DismissIntro(dontShowAgain)">Compris</button>
        </div>
    </div>
}

@code {
    private bool more;
    private void CloseMore() => more = false;
    private bool open, navOpen, orgAdmin = true, readOnly;
    private HashSet<string> writable = new();   // domaines (écrans, listes, médiathèque) que le niveau modifie
    // Page d'un domaine que le niveau ne fait que voir : bandeau et boutons d'en-tête masqués, comme en lecture seule
    private string? ReadOnlyDomain => orgAdmin ? null : Services.GetRequiredService<TenantStore>().PageDomain is { } dom && !writable.Contains(dom) ? dom : null;
    private HashSet<string> pages = new(LevelPages.All);
    private RightsBoundary? boundary;

    private bool Sees(string page) => orgAdmin || pages.Contains(page);
    private bool compositionsOn;   // l'intégration « Compositions » est dans Mes intégrations
    private bool CompositionsMenu => Ctx.ClientId != null && compositionsOn && Sees(LevelPages.Compositions);
    // Console Linkivi ou espace revendeur (hors espace client) : barre du bas et feuille « Plus » dans l'app
    private bool AdminSpace => Ctx.ClientId == null && (Ctx.IsPlatformAdmin || Ctx.IsResellerAdmin);

    // Pages du mode expert : en mode simple, leur adresse directe affiche « Disponible en mode expert ».
    private static readonly string[] ExpertPaths = { "planning", "organisation", "areas", "zones", "members", "stats" };
    private string CurrentPath => Nav.ToBaseRelativePath(Nav.Uri).Split('?')[0].Trim('/');
    private bool ExpertOnlyHere => !Modes.Expert && Ctx.ClientId != null && ExpertPaths.Any(p => CurrentPath == p || CurrentPath.StartsWith(p + "/"));
    private static readonly string[] SimpleReadOnlyPaths = { "integrations", "widgets" };
    private bool SimpleLocked => !Modes.Expert && Ctx.ClientId != null && SimpleReadOnlyPaths.Any(p => CurrentPath == p || CurrentPath.StartsWith(p + "/"));
    private bool dontShowAgain;

    // Hubs du menu : chaque entrée s'ouvre sur sa première page ; les pages du hub sont des onglets (avec leur pastille) au-dessus du contenu.
    private record HubTab(string Path, string Label, string? Fam);
    private List<HubTab> ProgTabs => Ctx.ClientId == null ? new() : new[]
    {
        Sees(LevelPages.Playlists) ? new HubTab("playlists", "Listes de lecture", MenuBadges.Playlists) : null,
        Sees(LevelPages.Planning) && Modes.Expert ? new HubTab("planning", "Planning", null) : null
    }.OfType<HubTab>().ToList();
    private List<HubTab> ContentTabs => Ctx.ClientId == null ? new() : new[]
    {
        Sees(LevelPages.Media) ? new HubTab("media", "Médiathèque", MenuBadges.MediaFam) : null,
        CompositionsMenu ? new HubTab("compositions", "Compositions", MenuBadges.Compositions) : null,
        Sees(LevelPages.Widgets) ? new HubTab("widgets", "Widgets", null) : null,
        Sees(LevelPages.Integrations) ? new HubTab("integrations", "Intégrations", MenuBadges.Integrations) : null
    }.OfType<HubTab>().ToList();
    private string HubClass(List<HubTab> tabs) => InHub(tabs) ? "nav active" : "nav";
    private bool InHub(List<HubTab> tabs) => tabs.Any(t => t.Path == CurrentPath.Split('/')[0]);
    // Onglets à afficher : seulement sur la page d'un onglet elle-même (pas dans un éditeur) et si le hub a au moins deux pages.
    private List<HubTab>? CurrentHub => Ctx.ClientId == null ? null
        : new[] { ProgTabs, ContentTabs }.FirstOrDefault(h => h.Count > 1 && h.Any(t => t.Path == CurrentPath));

    private void ToggleMode() => Modes.Switch(!Modes.Expert);
    private void OnModeChanged() => InvokeAsync(StateHasChanged);
    // Ajout ou retrait d'une intégration (page Intégrations) : le menu se met à jour sans recharger.
    private void OnInstallsChanged() => InvokeAsync(() => { if (Ctx.ClientId != null) { LoadAreas(); Badges.Start(() => BadgeFamily, CompositionsMenu, orgAdmin); } StateHasChanged(); });
    public void Dispose() { Modes.Changed -= OnModeChanged; Nav.LocationChanged -= OnLocationForBadges; Badges.Changed -= OnBadgesChanged; if (apps != null) apps.InstallsChanged -= OnInstallsChanged; }

    // Pastilles du menu : nombre d'éléments (clair), nouveau depuis la dernière visite (rouge), écran hors ligne (orange). Elles se mettent à jour seules (voir MenuBadges).
    private static readonly Dictionary<string, string> BadgePaths = new()
    {
        [""] = MenuBadges.Screens, ["playlists"] = MenuBadges.Playlists, ["media"] = MenuBadges.MediaFam, ["compositions"] = MenuBadges.Compositions,
        ["organisation"] = MenuBadges.Members, ["integrations"] = MenuBadges.Integrations, ["settings"] = MenuBadges.Settings
    };
    private string? BadgeFamily => BadgePaths.GetValueOrDefault(CurrentPath.Split('/')[0]);
    private void OnBadgesChanged()
    {
        InvokeAsync(StateHasChanged);
        _ = Task.Delay(1000).ContinueWith(_ => InvokeAsync(StateHasChanged));   // retire le rebond une fois joué
    }
    private void OnLocationForBadges(object? sender, Microsoft.AspNetCore.Components.Routing.LocationChangedEventArgs e) => Badges.Refresh();
    // Plusieurs familles sur une même pastille (entrée « Contenus » : médiathèque + compositions) : les nombres s'additionnent.
    private RenderFragment Pill(string fam, params string[] more) => builder =>
    {
        var all = new[] { fam }.Concat(more).ToArray();
        var b = all.Select(Badges.Of).Aggregate((x, y) => new Badge(x.Count + y.Count, x.New + y.New, x.Offline + y.Offline));
        var ads = fam == MenuBadges.Settings && b.Count > 0;   // Réglages : spots de publicité à valider (nombre, orange)
        var dot = fam == MenuBadges.Settings && !ads;
        if (dot ? b.New == 0 : b.Count == 0 && b.New == 0) return;
        var cls = ads ? "orange" : b.New > 0 ? "red" : b.Offline > 0 ? "orange" : "lt";
        var tip = ads ? $"{b.Count} spot{(b.Count > 1 ? "s" : "")} de publicité à valider"
            : dot ? "Nouveauté dans les réglages"
            : b.New > 0 ? $"{b.New} nouveau{(b.New > 1 ? "x" : "")}" + (b.Offline > 0 ? $" · {b.Offline} hors ligne" : "")
            : b.Offline > 0 ? $"{b.Offline} écran{(b.Offline > 1 ? "s" : "")} hors ligne" : "";
        builder.OpenElement(0, "span");
        builder.AddAttribute(1, "class", $"nbadge {cls}{(dot ? " dot" : "")}{(all.Any(Badges.Bumping) ? " bump" : "")}");
        if (tip != "") builder.AddAttribute(2, "title", tip);
        if (!dot)
        {
            builder.AddContent(3, b.Count > 999 ? "999+" : b.Count.ToString());
            if (b.New > 0 && b.Offline > 0) { builder.OpenElement(4, "i"); builder.AddAttribute(5, "class", "od"); builder.CloseElement(); }
        }
        builder.CloseElement();
    };
    private AppService? apps;

    // Droits de la personne connectée : pages du menu, lecture seule (l'aire n'est plus un filtre global : seulement celui des pages Écrans, Planning et Zones).
    private void LoadAreas()
    {
        var store = Services.GetRequiredService<TenantStore>();
        (orgAdmin, readOnly, pages) = store.Read(d => (d.Access.IsOrgAdmin, d.Access.ReadOnly, LevelPages.All.Where(p => d.Access.CanSee(p, Catalog)).ToHashSet()));
        compositionsOn = store.Read(d => d.AppInstalls.Any(a => a.AppId == Compositions.AppId));
        writable = store.Read(d => new[] { LevelPages.Screens, LevelPages.Playlists, LevelPages.Media }.Where(d.Access.CanWrite).ToHashSet());
    }

    private string brand = "#0B1F3A", orgName = "", userName = "", userEmail = "";
    private bool suspended;   // organisation suspendue : écrans coupés, back-office ouvert (bandeau)
    private DateTime? trialEnd;   // essai gratuit de l'organisation ouverte (bandeau)
    private string trialEndLabel = "", siteUrl = "";
    private int trialTotal;
    private string? subEndedLabel, cancelLabel, deleteLabel;   // abonnement terminé ou résilié, suppression prévue
    // « Choisir mon plan » : vers Réglages › Abonnement pour un administrateur (y compris l'équipe Linkivi qui est entrée dans l'espace) ; un membre voit seulement le bandeau
    private RenderFragment PlanButton(string label) => orgAdmin
        ? @<a class="btn sm" href="/settings?tab=abonnement">@label</a>
        : @<span></span>;
    private Reseller? reseller;
    private string? PlanLabel => Ctx.ClientId is { } pc ? Root.Read(d => d.Clients.FirstOrDefault(c => c.Id == pc) is { } t ? Plans.Label(t.Plan) : null) : null;

    private string Initials =>
        string.Concat((orgName.Length > 0 ? orgName : userName).Split(' ', StringSplitOptions.RemoveEmptyEntries).Take(2).Select(w => char.ToUpperInvariant(w[0])));

    protected override void OnInitialized()
    {
        Modes.Changed += OnModeChanged;
        reseller = Ctx.Reseller;
        brand = reseller?.BrandColor ?? brand;
        var cid = Ctx.ClientId;
        orgName = cid != null ? Root.Read(d => d.Clients.FirstOrDefault(c => c.Id == cid)?.Name ?? "")
                : Ctx.IsPlatformAdmin ? "Console administrateur Linkivi" : reseller?.Name ?? "";
        if (cid != null) { suspended = Root.Read(d => d.Clients.FirstOrDefault(c => c.Id == cid) is { } cl && (cl.Suspended || d.Resellers.FirstOrDefault(r => r.Id == cl.ResellerId)?.Suspended == true)); siteUrl = Services.GetRequiredService<Mailer>().SiteUrl; }
        if (cid != null && Root.Read(d => d.Clients.FirstOrDefault(c => c.Id == cid)) is { } client)
        {
            var now = DateTime.UtcNow;
            if (client is { TrialEndsUtc: { } end, Subscribed: false } && !client.SubscriptionEnded(now))
            {
                trialEnd = end;
                trialEndLabel = Signup.Day(client, end);
                trialTotal = Root.Read(d => Signup.TrialDaysOf(d, client));
            }
            if (client.SubscriptionEnded(now)) subEndedLabel = Signup.Day(client, client.CancelAtUtc!.Value);
            else if (client.CancelAtUtc is { } cancel) cancelLabel = Signup.Day(client, cancel);
            if (client.DeleteOnUtc is { } del) deleteLabel = Signup.Day(client, del);
        }
        if (cid == null && Ctx.IsResellerAdmin && reseller?.Suspended == true) suspended = true;   // revendeur suspendu : les écrans de ses clients sont coupés
        if (cid != null)
        {
            LoadAreas(); apps = Services.GetRequiredService<AppService>(); apps.InstallsChanged += OnInstallsChanged;
            Badges.Changed += OnBadgesChanged; Nav.LocationChanged += OnLocationForBadges;
            Badges.Start(() => BadgeFamily, CompositionsMenu, orgAdmin);
        }
        userEmail = Ctx.Email;
        userName = string.IsNullOrWhiteSpace(Ctx.DisplayName) ? userEmail : Ctx.DisplayName;
    }
}
