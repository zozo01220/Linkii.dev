    private string trialEndLabel = "", siteUrl = "";
    private Reseller? reseller;

    private string Initials =>
        string.Concat((orgName.Length > 0 ? orgName : userName).Split(' ', StringSplitOptions.RemoveEmptyEntries).Take(2).Select(w => char.ToUpperInvariant(w[0])));

    protected override void OnInitialized()
    {
        Modes.Changed += OnModeChanged;
        reseller = Ctx.Reseller;
        brand = reseller?.BrandColor ?? brand;
        var cid = Ctx.ClientId;
        orgName = cid != null ? Root.Read(d => d.Clients.FirstOrDefault(c => c.Id == cid)?.Name ?? "")
                : Ctx.IsPlatformAdmin ? "Console administrateur Linkii" : reseller?.Name ?? "";
        if (cid != null) { suspended = Root.Read(d => d.Clients.FirstOrDefault(c => c.Id == cid) is { } cl && (cl.Suspended || d.Resellers.FirstOrDefault(r => r.Id == cl.ResellerId)?.Suspended == true)); siteUrl = Services.GetRequiredService<Mailer>().SiteUrl; }
        if (cid != null && Root.Read(d => d.Clients.FirstOrDefault(c => c.Id == cid)) is { TrialEndsUtc: { } end } client)
        {
            trialEnd = end;
            trialEndLabel = Signup.Day(client, end);
            siteUrl = Services.GetRequiredService<Mailer>().SiteUrl;
        }
        if (cid == null && Ctx.IsResellerAdmin && reseller?.Suspended == true) suspended = true;   // revendeur suspendu : les écrans de ses clients sont coupés
        if (cid != null) { LoadAreas(); apps = Services.GetRequiredService<AppService>(); apps.InstallsChanged += OnInstallsChanged; }
        userEmail = Ctx.Email;
        userName = string.IsNullOrWhiteSpace(Ctx.DisplayName) ? userEmail : Ctx.DisplayName;
    }
