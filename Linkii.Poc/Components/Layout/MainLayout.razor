    private static readonly string[] ExpertPaths = { "planning", "organisation", "areas", "zones", "members", "stats" };
    private string CurrentPath => Nav.ToBaseRelativePath(Nav.Uri).Split('?')[0].Trim('/');
    private bool ExpertOnlyHere => !Modes.Expert && Ctx.ClientId != null && ExpertPaths.Any(p => CurrentPath == p || CurrentPath.StartsWith(p + "/"));
    private static readonly string[] SimpleReadOnlyPaths = { "integrations", "widgets" };
    private bool SimpleLocked => !Modes.Expert && Ctx.ClientId != null && SimpleReadOnlyPaths.Any(p => CurrentPath == p || CurrentPath.StartsWith(p + "/"));
    private bool dontShowAgain;

    private void ToggleMode() => Modes.Switch(!Modes.Expert);
    private void OnModeChanged() => InvokeAsync(StateHasChanged);
    // Ajout ou retrait d'une intégration (page Intégrations) : le menu se met à jour sans recharger.
    private void OnInstallsChanged() => InvokeAsync(() => { if (Ctx.ClientId != null) LoadAreas(); StateHasChanged(); });
    public void Dispose() { Modes.Changed -= OnModeChanged; if (apps != null) apps.InstallsChanged -= OnInstallsChanged; }
    private AppService? apps;

    // Aires visibles dès qu'il y en a deux, ou dès qu'une personne a été invitée : une organisation seule ne voit rien de nouveau.
    private void LoadAreas()
    {
        var store = Services.GetRequiredService<TenantStore>();
        (areas, currentArea, orgAdmin, readOnly, pages, multi) = store.Read(d => (d.Access.Areas, d.Access.Current, d.Access.IsOrgAdmin, d.Access.ReadOnly,
            LevelPages.All.Where(p => d.Access.CanSee(p, Catalog)).ToHashSet(),
            d.Access.OrgAreaCount > 1 || d.Users.Any(u => u.Role == Roles.ClientMember)));
        compositionsOn = store.Read(d => d.AppInstalls.Any(a => a.AppId == Compositions.AppId));
        writable = store.Read(d => new[] { LevelPages.Screens, LevelPages.Playlists, LevelPages.Media }.Where(d.Access.CanWrite).ToHashSet());
    }

    private void SwitchArea(Guid id)
    {
        areaMenu = false;
        if (id == currentArea?.Id) return;
        if (Services.GetRequiredService<TenantStore>().SwitchArea(id)) Nav.NavigateTo(Nav.Uri.Contains("/playlists/") ? "/playlists" : Nav.Uri, forceLoad: true);   // tout est relu dans la nouvelle aire
    }
    private string brand = "#0B1F3A", orgName = "", userName = "", userEmail = "";
    private bool suspended;   // organisation suspendue : écrans coupés, back-office ouvert (bandeau)
