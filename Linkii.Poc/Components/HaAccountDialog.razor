@inject TenantStore Store
@inject HomeAssistantClient Ha
@inject HomeAssistantLive Live
@inject Toaster Toast

@* Applications › Home Assistant : un compte pour toute l'organisation. Connexion (HaConnectionForm), état de l'instance (en ligne, temps réel ou relevé,
   panne en cours), entités par famille (HaEntityBrowser) et ce que l'application met à disposition (widgets, source de données). *@
@if (Open)
{
    <div class="modal-backdrop" @onclick="CloseDialog"></div>
    <div class="modal app-modal as-drawer" role="dialog" aria-modal="true" aria-labelledby="ha-title">
        <div class="modal-head">
            <AppIcon Id="homeassistant" />
            <div class="grow">
                <h3 id="ha-title">Home Assistant</h3>
                <small>Un compte pour toute l'organisation. Ses entités alimentent les widgets Home Assistant et la source de données « Home Assistant ».</small>
            </div>
        </div>
        <div class="modal-body">
            @if (account != null && !editing)
            {
                <div class="hac-acct">
                    <div class="hac-who">
                        <b>@(account.AuthMode == "password" ? account.User : "Jeton d'accès")</b>
                        <small>@account.Url · @(account.Via == "relay" ? "par le relais " + RelayName : "accès direct")</small>
                    </div>
                    @if (account.LastError.Length > 0)
                    {
                        <span class="hac-pill hac-pill-err">Injoignable</span>
                    }
                    else
                    {
                        <span class="hac-pill">@(Live.Mode(Store.ClientId) ?? "Connecté")</span>
                    }
                    <button type="button" class="btn ghost sm" disabled="@busy" @onclick="() => editing = true">Modifier</button>
                </div>
                @if (account.LastError.Length > 0)
                {
                    <div class="err">@account.LastError@(account.FailingSinceUtc is { } since ? $" (depuis le {since.ToLocalTime():dd.MM.yyyy à HH:mm})" : "") — les écrans gardent la dernière valeur.</div>
                }
                <p class="hac-note">Liste mise à jour @(account.EntitiesUtc is { } u ? $"le {u.ToLocalTime():dd.MM.yyyy à HH:mm}" : "jamais") (chaque jour d'office) · @account.Entities.Count entité(s)</p>
                <HaUses />
                <HaEntityBrowser Account="account" />
            }
            else
            {
                <HaConnectionForm Account="account" Prefix="ha" CanCancel="account != null" OnCancel="() => editing = false" OnSaved="Saved" />
            }
        </div>
        <div class="modal-foot hac-foot">
            @if (account != null && !editing)
            {
                @if (!confirmOff)
                {
                    <button type="button" class="btn danger sm" disabled="@busy" @onclick="() => confirmOff = true">Déconnecter</button>
                }
                else
                {
                    <span class="hac-warn">Les widgets Home Assistant ne fonctionneront plus.</span>
                    <button type="button" class="btn danger sm" disabled="@busy" @onclick="Disconnect">Confirmer</button>
                    <button type="button" class="btn ghost sm" disabled="@busy" @onclick="() => confirmOff = false">Annuler</button>
                }
                <span class="hac-spacer"></span>
                <button type="button" class="btn ghost sm" disabled="@busy" @onclick="RefreshList">@(busy ? "Actualisation…" : "Actualiser la liste")</button>
            }
            else
            {
                <span class="hac-spacer"></span>
            }
            <button type="button" class="btn ghost" @onclick="CloseDialog">Fermer</button>
        </div>
    </div>
}

@code {
    [Parameter] public bool Open { get; set; }
    [Parameter] public EventCallback OnClose { get; set; }
    /// <summary>Compte enregistré, modifié, actualisé ou supprimé : la page Applications se met à jour.</summary>
    [Parameter] public EventCallback OnChanged { get; set; }

    private HomeAssistantAccount? account;
    private bool editing, busy, confirmOff, wasOpen;

    private string RelayName => Store.Read(d => d.Tenant.DataRelays.FirstOrDefault(r => r.Id == account?.RelayId)?.Name) is { Length: > 0 } n ? $"« {n} »" : "Linkii";

    protected override void OnParametersSet()
    {
        if (Open && !wasOpen) Load();   // chaque ouverture repart de la connexion enregistrée
        wasOpen = Open;
    }

    private void Load()
    {
        account = Store.Read(d => d.Tenant.HomeAssistant?.Copy());
        editing = account == null;
        confirmOff = false;
    }

    private async Task CloseDialog() => await OnClose.InvokeAsync();

    private async Task Saved(HomeAssistantAccount fresh)
    {
        account = fresh;
        editing = false;
        Toast.Ok($"Home Assistant connecté : {fresh.Entities.Count} entité(s). Les widgets Home Assistant sont proposés dans l'édition des écrans.");
        await OnChanged.InvokeAsync();
    }

    private async Task RefreshList()
    {
        if (account == null) return;
        busy = true;
        try
        {
            account = await Live.RefreshEntities(Store.ClientId);
            Toast.Ok($"Liste actualisée : {account.Entities.Count} entité(s).");
        }
        catch (InvalidOperationException ex)
        {
            account = Store.Read(d => d.Tenant.HomeAssistant?.Copy());
            Toast.Error("Liste non actualisée : " + ex.Message);
        }
        finally { busy = false; }
        await OnChanged.InvokeAsync();
    }

    private async Task Disconnect()
    {
        busy = true;
        try { await Ha.Disconnect(Store.ClientId, Store); }
        finally { busy = false; }
        account = null;
        editing = true;
        confirmOff = false;
        Toast.Ok("Home Assistant déconnecté.");
        await OnChanged.InvokeAsync();
    }
}
