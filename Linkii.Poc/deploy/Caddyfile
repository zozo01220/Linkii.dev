# Linkii : HTTPS pour tous les domaines des revendeurs (exemple de configuration, hors POC local).
#
# 1. *.linkii.com : un certificat générique (challenge DNS, plugin du fournisseur DNS requis).
# 2. Domaines propres (affichage.revendeur.ch) : certificat généré à la demande, uniquement
#    si Linkii connaît le domaine (voir /internal/tls-allow : 200 = autorisé, 403 = refusé).
{
	on_demand_tls {
		ask http://localhost:5080/internal/tls-allow
	}
}

*.linkii.com, linkii.com {
	tls {
		dns <fournisseur-dns> {env.DNS_API_TOKEN}
	}
	reverse_proxy localhost:5080
}

https:// {
	tls {
		on_demand
	}
	reverse_proxy localhost:5080
}
