{
  "id": "text",
  "name": "Texte libre",
  "version": "1.0.0",
  "category": "Widget d'écran",
  "icon": "📝",
  "kind": "nocode",
  "screenWidget": true,
  "defaultOn": true,
  "summary": "Un texte libre posé sur l'écran : titre, texte, couleurs et période de validité.",
  "description": "Widget d'écran : posez-le sur l'aperçu de l'écran, saisissez le message et choisissez les couleurs. Il reste affiché par-dessus les listes de lecture ; avec une période de validité, il apparaît et disparaît tout seul. Fonctionne sans connexion internet.",
  "placements": [
    "full",
    "top-left",
    "top-right",
    "bottom-left",
    "bottom-right",
    "top",
    "bottom"
  ],
  "validity": true,
  "settings": [
    {
      "key": "title",
      "label": "Titre",
      "type": "text",
      "maxLength": 120,
      "placeholder": "Ex. : Fermeture exceptionnelle"
    },
    {
      "key": "body",
      "label": "Texte",
      "type": "textarea",
      "required": true,
      "maxLength": 1000,
      "placeholder": "Le message à afficher…"
    },
    {
      "key": "bg",
      "label": "Couleur de fond",
      "type": "color",
      "default": "#0B1F3A"
    },
    {
      "key": "fg",
      "label": "Couleur du texte",
      "type": "color",
      "default": "#ffffff"
    },
    {
      "key": "width",
      "label": "Largeur (% de la largeur de l'écran)",
      "type": "number",
      "default": "40",
      "min": 10,
      "max": 100,
      "required": true,
      "help": "La taille du texte se règle avec « Taille », comme pour l'horloge et la météo."
    },
    {
      "key": "scroll",
      "label": "Défilement",
      "type": "select",
      "default": "none",
      "options": [
        {
          "value": "none",
          "label": "Texte fixe (retour à la ligne)"
        },
        {
          "value": "loop",
          "label": "Défilement continu, de droite à gauche"
        }
      ]
    },
    {
      "key": "scrollSpeed",
      "label": "Vitesse de défilement",
      "type": "select",
      "default": "normal",
      "showIf": "scroll=loop",
      "options": [
        {
          "value": "slow",
          "label": "Lente"
        },
        {
          "value": "normal",
          "label": "Normale"
        },
        {
          "value": "fast",
          "label": "Rapide"
        }
      ]
    },
    {
      "key": "align",
      "label": "Alignement",
      "type": "select",
      "default": "center",
      "options": [
        {
          "value": "center",
          "label": "Centré"
        },
        {
          "value": "left",
          "label": "À gauche"
        }
      ],
      "showIf": "scroll=none"
    },
    {
      "key": "validFrom",
      "label": "Afficher à partir du",
      "type": "date",
      "help": "Facultatif."
    },
    {
      "key": "validTo",
      "label": "Afficher jusqu'au (inclus)",
      "type": "date",
      "help": "Facultatif."
    }
  ]
}
