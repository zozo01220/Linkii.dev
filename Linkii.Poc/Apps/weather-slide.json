{
  "id": "weather-slide",
  "name": "Météo",
  "version": "1.0.0",
  "category": "Service en ligne",
  "icon": "⛅",
  "defaultOn": true,
  "kind": "builtin",
  "summary": "La météo d'une ville : aujourd'hui, 3 jours, qualité de l'air et alertes.",
  "description": "Choisissez une ville : le serveur lit la météo (WeatherAPI.com, au plus toutes les 30 minutes) et l'écran l'affiche en pleine page ou dans un angle. Prévisions sur 3 jours, qualité de l'air et alertes météo (Europe) s'activent dans les options avancées. Une ville par contenu : ajoutez-le deux fois pour deux villes. L'écran garde la dernière valeur reçue sans connexion.",
  "placements": [
    "full",
    "top-left",
    "top-right",
    "bottom-left",
    "bottom-right"
  ],
  "provider": "weather-slide",
  "data": true,
  "refreshSec": 600,
  "settings": [
    {
      "key": "city",
      "label": "Ville",
      "type": "city",
      "required": true,
      "zone": "source",
      "maxLength": 80,
      "placeholder": "Ex. : Lausanne",
      "help": "Une ville par contenu. Pour afficher deux villes, ajoutez la Météo deux fois à la liste de lecture."
    },
    {
      "key": "unit",
      "label": "Unité",
      "type": "select",
      "ui": "segmented",
      "default": "C",
      "options": [
        { "value": "C", "label": "°C" },
        { "value": "F", "label": "°F" }
      ]
    },
    {
      "key": "theme",
      "label": "Fond",
      "type": "select",
      "ui": "segmented",
      "default": "dark",
      "options": [
        { "value": "dark", "label": "Sombre" },
        { "value": "light", "label": "Clair" }
      ]
    },
    {
      "key": "forecast",
      "label": "Prévisions sur 3 jours",
      "type": "bool",
      "default": "true",
      "zone": "advanced"
    },
    {
      "key": "airQuality",
      "label": "Qualité de l'air",
      "type": "bool",
      "default": "true",
      "zone": "advanced"
    },
    {
      "key": "alerts",
      "label": "Alertes météo (Europe)",
      "type": "bool",
      "default": "true",
      "zone": "advanced",
      "help": "Affichées seulement lorsqu'une alerte est en cours. Disponibles pour les villes d'Europe."
    },
    {
      "key": "feel",
      "label": "Température ressentie",
      "type": "bool",
      "default": "true",
      "zone": "advanced"
    },
    {
      "key": "wind",
      "label": "Vent",
      "type": "bool",
      "default": "true",
      "zone": "advanced"
    },
    {
      "key": "humidity",
      "label": "Humidité",
      "type": "bool",
      "default": "false",
      "zone": "advanced"
    },
    {
      "key": "uv",
      "label": "Indice UV",
      "type": "bool",
      "default": "false",
      "zone": "advanced"
    },
    {
      "key": "sun",
      "label": "Lever et coucher du soleil",
      "type": "bool",
      "default": "false",
      "zone": "advanced"
    },
    {
      "key": "refresh",
      "label": "Actualiser les données",
      "type": "select",
      "default": "30",
      "zone": "advanced",
      "options": [
        { "value": "30", "label": "Toutes les 30 minutes" },
        { "value": "60", "label": "Toutes les heures" }
      ],
      "help": "Les écrans lisent le cache du serveur, jamais le service météo."
    }
  ]
}
