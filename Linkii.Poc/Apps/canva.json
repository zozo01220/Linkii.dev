{
  "id": "canva",
  "name": "Canva",
  "version": "1.0.0",
  "category": "Service connecté",
  "icon": "🎨",
  "kind": "builtin",
  "summary": "Vos designs Canva, exportés dans la médiathèque pour une lecture même hors ligne.",
  "description": "Connectez votre compte Canva dans Réglages › Applications, puis choisissez un design : ses pages deviennent un diaporama (ou une vidéo pour un design animé). Après une modification dans Canva, cliquez sur « Mettre à jour depuis Canva » puis publiez l'écran.",
  "duration": "content",
  "placements": ["full", "top-left", "top-right", "bottom-left", "bottom-right"],
  "settings": [
    { "key": "design", "label": "Design Canva", "type": "canva", "required": true, "maxLength": 200 },
    { "key": "designTitle", "label": "Titre du design", "type": "hidden", "maxLength": 200 },
    { "key": "kind", "label": "Export", "type": "hidden", "default": "images" },
    { "key": "pages", "label": "Pages exportées", "type": "medias", "accept": "image", "managed": true, "showIf": "kind=images", "maxLength": 20000 },
    { "key": "video", "label": "Vidéo exportée", "type": "media", "accept": "video", "managed": true, "showIf": "kind=video", "maxLength": 200 },
    { "key": "interval", "label": "Durée de chaque page (secondes)", "type": "number", "default": "8", "min": 2, "max": 600, "required": true, "showIf": "kind=images" },
    {
      "key": "fit", "label": "Cadrage", "type": "select", "default": "contain",
      "options": [
        { "value": "contain", "label": "Design entier (bandes si besoin)" },
        { "value": "cover", "label": "Remplir l'écran (rogne les bords)" }
      ]
    },
    {
      "key": "transition", "label": "Transition entre les pages", "type": "select", "default": "fade", "showIf": "kind=images",
      "options": [
        { "value": "fade", "label": "Fondu enchaîné" },
        { "value": "slide", "label": "Glissement (de droite à gauche)" },
        { "value": "zoom", "label": "Zoom avant en fondu" },
        { "value": "none", "label": "Aucune (coupure franche)" }
      ]
    },
    {
      "key": "speed", "label": "Vitesse de la transition", "type": "select", "default": "normal", "showIf": "transition!=none",
      "options": [
        { "value": "fast", "label": "Rapide (0,4 s)" },
        { "value": "normal", "label": "Normale (0,8 s)" },
        { "value": "slow", "label": "Lente (1,5 s)" },
        { "value": "very-slow", "label": "Très lente (3 s)" }
      ]
    },
    { "key": "sound", "label": "Activer le son", "type": "bool", "default": "false", "showIf": "kind=video" }
  ]
}
