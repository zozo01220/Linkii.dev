{
  "id": "clock-slide",
  "name": "Horloge pleine page",
  "version": "1.0.0",
  "category": "Contenu",
  "icon": "🕒",
  "kind": "builtin",
  "defaultOn": true,
  "summary": "L'heure en grand sur toute la page : numérique ou à aiguilles, fond noir par défaut.",
  "description": "Une page entière consacrée à l'heure, à ajouter dans une liste de lecture comme n'importe quel contenu. Choisissez un affichage numérique ou à aiguilles, et la couleur du fond (noir par défaut). La date, les secondes, le format 12 ou 24 heures et le fuseau horaire se règlent dans les options avancées. Fonctionne sans connexion internet.",
  "placements": [
    "full"
  ],
  "settings": [
    {
      "key": "style",
      "label": "Style",
      "type": "select",
      "ui": "segmented",
      "default": "digital",
      "options": [
        { "value": "digital", "label": "Numérique" },
        { "value": "analog", "label": "À aiguilles" }
      ]
    },
    {
      "key": "bg",
      "label": "Fond",
      "type": "select",
      "default": "#000000",
      "options": [
        { "value": "#000000", "label": "Noir" },
        { "value": "#1C1F26", "label": "Anthracite" },
        { "value": "#0B1F3A", "label": "Bleu nuit" },
        { "value": "#FFFFFF", "label": "Blanc" },
        { "value": "#F3E9D7", "label": "Crème" }
      ],
      "help": "Le texte s'adapte : clair sur un fond sombre, foncé sur un fond clair."
    },
    {
      "key": "color",
      "label": "Couleur de l'heure",
      "type": "select",
      "default": "auto",
      "zone": "advanced",
      "options": [
        { "value": "auto", "label": "Automatique" },
        { "value": "#3B82C4", "label": "Bleu" },
        { "value": "#4ADE80", "label": "Vert" },
        { "value": "#FBBF24", "label": "Jaune" },
        { "value": "#F87171", "label": "Rouge" }
      ]
    },
    {
      "key": "showSeconds",
      "label": "Afficher les secondes",
      "type": "bool",
      "default": "true",
      "zone": "advanced"
    },
    {
      "key": "showDate",
      "label": "Afficher la date",
      "type": "bool",
      "default": "true",
      "zone": "advanced"
    },
    {
      "key": "format",
      "label": "Format de l'heure",
      "type": "select",
      "ui": "segmented",
      "default": "24",
      "zone": "advanced",
      "showIf": "style=digital",
      "options": [
        { "value": "24", "label": "24 heures" },
        { "value": "12", "label": "12 heures" }
      ]
    },
    {
      "key": "numbers",
      "label": "Chiffres sur le cadran",
      "type": "bool",
      "default": "true",
      "zone": "advanced",
      "showIf": "style=analog"
    },
    {
      "key": "timezone",
      "label": "Fuseau horaire",
      "type": "select",
      "default": "",
      "zone": "advanced",
      "options": [
        { "value": "", "label": "Fuseau de l'organisation" },
        { "value": "Europe/Zurich", "label": "Europe/Zurich" },
        { "value": "Europe/Paris", "label": "Europe/Paris" },
        { "value": "Europe/Brussels", "label": "Europe/Brussels" },
        { "value": "Europe/London", "label": "Europe/London" },
        { "value": "Europe/Berlin", "label": "Europe/Berlin" },
        { "value": "Europe/Rome", "label": "Europe/Rome" },
        { "value": "America/Montreal", "label": "America/Montreal" },
        { "value": "America/New_York", "label": "America/New_York" },
        { "value": "Asia/Tokyo", "label": "Asia/Tokyo" },
        { "value": "Africa/Casablanca", "label": "Africa/Casablanca" },
        { "value": "UTC", "label": "UTC" }
      ]
    }
  ]
}
