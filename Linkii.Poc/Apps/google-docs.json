{
  "id": "google-docs",
  "name": "Google Docs",
  "version": "1.0.0",
  "category": "Médiathèque",
  "icon": "📝",
  "kind": "builtin",
  "summary": "Un document Google Docs, converti en images, en diaporama.",
  "description": "Choisissez un document dans votre Google Drive : Google l'exporte en PDF, chaque page est convertie en image 1080p sur le serveur, puis les pages défilent comme un diaporama, même hors ligne (50 pages au maximum). Le document est mis à jour tout seul quand il change dans Google (toutes les heures par défaut). Les commentaires et suggestions ne sont pas affichés.",
  "duration": "content",
  "placements": ["full", "top-left", "top-right", "bottom-left", "bottom-right"],
  "settings": [
    { "key": "gfile", "label": "Document Google", "type": "gfile", "accept": "document", "required": true, "maxLength": 200, "zone": "source" },
    { "key": "gfileName", "label": "Nom du fichier", "type": "hidden", "maxLength": 200 },
    { "key": "gfileMod", "label": "Dernière modification exportée", "type": "hidden", "maxLength": 40 },
    { "key": "gkind", "label": "Type de fichier", "type": "hidden", "default": "docs", "maxLength": 10 },
    { "key": "pdf", "label": "PDF exporté", "type": "hidden", "maxLength": 64 },
    { "key": "pdfTitle", "label": "Nom du PDF", "type": "hidden", "maxLength": 200 },
    { "key": "pdfPages", "label": "Pages du document", "type": "hidden", "maxLength": 6 },
    { "key": "pages", "label": "Pages converties", "type": "medias", "accept": "image", "managed": true, "maxLength": 20000 },
    { "key": "interval", "label": "Durée de chaque page", "type": "number", "unit": "secondes", "default": "15", "min": 2, "max": 600, "required": true },
    {
      "key": "fit", "label": "Cadrage", "type": "select", "default": "contain", "ui": "segmented",
      "options": [
        { "value": "contain", "label": "Page entière" },
        { "value": "cover", "label": "Remplir l'écran" }
      ]
    },
    {
      "key": "transition", "label": "Transition entre les pages", "type": "select", "default": "fade",
      "options": [
        { "value": "fade", "label": "Fondu enchaîné" },
        { "value": "slide", "label": "Glissement (de droite à gauche)" },
        { "value": "zoom", "label": "Zoom avant en fondu" },
        { "value": "none", "label": "Aucune (coupure franche)" }
      ]
    },
    { "key": "range", "label": "Pages à afficher", "type": "text", "placeholder": "Toutes · ou par exemple 1-5, 8, 10-12", "maxLength": 200, "zone": "advanced", "help": "Laisser vide pour toutes les pages (50 au maximum). Le fichier est converti à nouveau à la validation." },
    { "key": "auto", "label": "Mettre à jour quand le document change", "type": "bool", "default": "true", "zone": "advanced" },
    {
      "key": "refresh", "label": "Fréquence de vérification", "type": "select", "default": "60", "showIf": "auto=true", "zone": "advanced",
      "options": [
        { "value": "15", "label": "Toutes les 15 minutes" },
        { "value": "60", "label": "Toutes les heures" },
        { "value": "1440", "label": "Une fois par jour" }
      ]
    },
    {
      "key": "background", "label": "Fond autour de la page", "type": "select", "default": "none", "ui": "segmented", "zone": "advanced", "help": "Une page en portrait sur un écran en paysage laisse des bandes : le fond est ajouté aux images à la conversion.",
      "options": [
        { "value": "none", "label": "Noir" },
        { "value": "white", "label": "Blanc" },
        { "value": "blur", "label": "Page floutée" }
      ]
    },
    {
      "key": "canvas", "label": "Sens de l'écran", "type": "select", "default": "landscape", "ui": "segmented", "showIf": "background!=none", "zone": "advanced",
      "options": [
        { "value": "landscape", "label": "Paysage" },
        { "value": "portrait", "label": "Portrait" }
      ]
    },
    {
      "key": "speed", "label": "Vitesse de la transition", "type": "select", "default": "normal", "showIf": "transition!=none", "zone": "advanced",
      "options": [
        { "value": "fast", "label": "Rapide (0,4 s)" },
        { "value": "normal", "label": "Normale (0,8 s)" },
        { "value": "slow", "label": "Lente (1,5 s)" }
      ]
    }
  ]
}
