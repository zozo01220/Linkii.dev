{
  "id": "drive",
  "name": "Dossier Drive",
  "version": "1.0.0",
  "category": "Drive",
  "icon": "📁",
  "kind": "builtin",
  "summary": "Les images et vidéos d'un dossier Google Drive ou OneDrive, mises à jour toutes seules.",
  "description": "Choisissez un des dossiers de vos Drives (Intégrations › Drives) : ses images et ses vidéos défilent comme un diaporama, avec celles de ses sous-dossiers si l'option est activée (l'ordre par nom suit alors le chemin : sous-dossier puis fichier). Les fichiers sont copiés sur le serveur et lus même hors ligne ; un fichier ajouté ou retiré du dossier apparaît ou disparaît des écrans à la synchronisation suivante (toutes les 15 minutes), sans republier. Dans une boucle de plusieurs contenus, l'écran passe au suivant après le dernier fichier.",
  "duration": "content",
  "placements": ["full", "top-left", "top-right", "bottom-left", "bottom-right"],
  "settings": [
    { "key": "folder", "label": "Dossier", "type": "drive", "required": true },
    {
      "key": "kinds", "label": "Fichiers affichés", "type": "select", "default": "all",
      "options": [
        { "value": "all", "label": "Images et vidéos" },
        { "value": "images", "label": "Images seulement" },
        { "value": "videos", "label": "Vidéos seulement" }
      ]
    },
    {
      "key": "order", "label": "Ordre", "type": "select", "default": "name",
      "options": [
        { "value": "name", "label": "Par nom de fichier" },
        { "value": "date", "label": "Les plus récents d'abord" }
      ]
    },
    { "key": "shuffle", "label": "Ordre aléatoire", "type": "bool", "default": "false" },
    { "key": "interval", "label": "Durée de chaque image (secondes)", "type": "number", "default": "8", "min": 2, "max": 600, "required": true, "showIf": "kinds!=videos" },
    {
      "key": "fit", "label": "Cadrage", "type": "select", "default": "contain",
      "options": [
        { "value": "contain", "label": "Fichiers entiers (bandes si besoin)" },
        { "value": "cover", "label": "Remplir l'écran (rogne les bords)" }
      ]
    },
    {
      "key": "transition", "label": "Transition", "type": "select", "default": "fade",
      "options": [
        { "value": "fade", "label": "Fondu enchaîné" },
        { "value": "slide", "label": "Glissement (de droite à gauche)" },
        { "value": "zoom", "label": "Zoom avant en fondu" },
        { "value": "none", "label": "Aucune (coupure franche)" }
      ]
    },
    {
      "key": "speed", "label": "Vitesse de la transition", "type": "select", "default": "normal", "showIf": "transition!=none",
      "options": [
        { "value": "fast", "label": "Rapide (0,4 s)" },
        { "value": "normal", "label": "Normale (0,8 s)" },
        { "value": "slow", "label": "Lente (1,5 s)" },
        { "value": "very-slow", "label": "Très lente (3 s)" }
      ]
    },
    { "key": "sound", "label": "Son des vidéos", "type": "bool", "default": "false", "showIf": "kinds!=images" }
  ]
}
