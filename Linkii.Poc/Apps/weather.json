{
  "id": "weather",
  "name": "Météo",
  "version": "1.0.0",
  "category": "Widget d'écran",
  "icon": "⛅",
  "kind": "builtin",
  "screenWidget": true,
  "defaultOn": true,
  "summary": "Température, minimum, maximum et vent d'une ville.",
  "description": "Données Open-Meteo, actualisées toutes les 10 minutes côté serveur. Sans connexion, l'écran garde la dernière valeur reçue.",
  "placements": [
    "full",
    "top-left",
    "top-right",
    "bottom-left",
    "bottom-right",
    "top",
    "bottom"
  ],
  "provider": "weather",
  "data": true,
  "refreshSec": 600,
  "settings": [
    {
      "key": "city",
      "label": "Ville",
      "type": "text",
      "required": true,
      "placeholder": "Ex. : Lausanne",
      "maxLength": 80
    },
    {
      "key": "unit",
      "label": "Unité",
      "type": "select",
      "default": "C",
      "options": [
        {
          "value": "C",
          "label": "Degrés Celsius (°C)"
        },
        {
          "value": "F",
          "label": "Degrés Fahrenheit (°F)"
        }
      ]
    }
  ]
}
