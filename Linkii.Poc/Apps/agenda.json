{
  "id": "agenda",
  "name": "Calendrier partagé",
  "version": "2.0.0",
  "category": "Calendrier partagé",
  "icon": "📅",
  "kind": "builtin",
  "summary": "Les événements à venir d'un calendrier, en liste ou en bandeau défilant.",
  "description": "Pleine page ou angle : liste groupée par jour. Bandeau haut ou bas : une ligne qui défile si elle est trop longue pour la largeur de l'écran. Choisissez un des calendriers partagés de votre organisation (Microsoft 365, Google Calendar, CalDAV, liens ICS, Exchange) : leurs connexions se configurent une seule fois, dans Intégrations, et ne sont jamais envoyées à l'écran.",
  "placements": [
    "full",
    "top-left",
    "top-right",
    "bottom-left",
    "bottom-right",
    "top",
    "bottom"
  ],
  "provider": "calendar",
  "data": true,
  "refreshSec": 60,
  "settings": [
    {
      "key": "calendar",
      "label": "Calendrier",
      "type": "calendar",
      "required": true,
      "zone": "source"
    },
    {
      "key": "title",
      "label": "Titre affiché",
      "type": "text",
      "default": "Agenda de la semaine",
      "maxLength": 80
    },
    {
      "key": "days",
      "label": "Jours affichés",
      "type": "number",
      "unit": "jours",
      "default": "7",
      "min": 1,
      "max": 14
    },
    {
      "key": "room",
      "label": "Utiliser dans les compositions réservation de salle",
      "type": "bool",
      "default": "false",
      "help": "Ce calendrier devient une salle : état libre, bientôt occupé ou occupé, porte de salle, tableau et plan."
    },
    {
      "key": "roomName",
      "label": "Nom de la salle",
      "type": "text",
      "maxLength": 60,
      "showIf": "room=true"
    },
    {
      "key": "roomCap",
      "label": "Capacité",
      "type": "number",
      "unit": "personnes",
      "min": 0,
      "max": 5000,
      "showIf": "room=true"
    },
    {
      "key": "roomPlace",
      "label": "Lieu (facultatif)",
      "type": "text",
      "maxLength": 80,
      "showIf": "room=true"
    },
    {
      "key": "roomAllDay",
      "label": "Les événements sur la journée entière rendent la salle occupée",
      "type": "bool",
      "default": "false",
      "showIf": "room=true"
    },
    {
      "key": "roomSoon",
      "label": "Bientôt occupé",
      "type": "select",
      "default": "10",
      "options": [
        { "value": "10", "label": "10 minutes avant" },
        { "value": "5", "label": "5 minutes avant" },
        { "value": "0", "label": "Jamais" }
      ],
      "showIf": "room=true"
    },
    {
      "key": "roomPrivacy",
      "label": "Sur l'écran",
      "type": "select",
      "ui": "segmented",
      "default": "busy",
      "options": [
        { "value": "busy", "label": "Seulement « Occupé »" },
        { "value": "title", "label": "Le titre des réunions" }
      ],
      "showIf": "room=true",
      "help": "Avec « Seulement Occupé », les titres ne quittent jamais le serveur."
    }
  ]
}
