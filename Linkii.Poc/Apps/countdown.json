{
  "id": "countdown",
  "name": "Compte à rebours",
  "version": "1.0.0",
  "category": "Widget d'écran",
  "icon": "⏳",
  "kind": "builtin",
  "screenWidget": true,
  "defaultOn": true,
  "summary": "Le nombre de jours restants avant une date.",
  "description": "Widget d'écran : choisissez une date et un intitulé (« Vacances d'été », « Ouverture »…). L'écran affiche le temps restant et se met à jour tout seul, même sans connexion internet. Le jour J, un message s'affiche ; le lendemain il peut disparaître ou rester.",
  "placements": [
    "full",
    "top-left",
    "top-right",
    "bottom-left",
    "bottom-right",
    "top",
    "bottom"
  ],
  "settings": [
    {
      "key": "label",
      "label": "Intitulé",
      "type": "text",
      "required": true,
      "maxLength": 80,
      "placeholder": "Ex. : Vacances d'été"
    },
    {
      "key": "date",
      "label": "Date",
      "type": "date",
      "required": true
    },
    {
      "key": "format",
      "label": "Affichage",
      "type": "select",
      "default": "days",
      "options": [
        { "value": "days", "label": "Nombre de jours" },
        { "value": "detailed", "label": "Jours, heures et minutes" }
      ]
    },
    {
      "key": "doneText",
      "label": "Message le jour J",
      "type": "text",
      "default": "C'est le grand jour !",
      "maxLength": 80
    },
    {
      "key": "after",
      "label": "Le lendemain",
      "type": "select",
      "default": "hide",
      "options": [
        { "value": "hide", "label": "Masquer le widget" },
        { "value": "keep", "label": "Garder le message" }
      ]
    }
  ]
}
