{
  "id": "ms-powerpoint",
  "name": "Microsoft PowerPoint",
  "version": "1.0.0",
  "category": "Médiathèque",
  "icon": "📽️",
  "kind": "builtin",
  "summary": "Une présentation PowerPoint de OneDrive ou SharePoint, convertie en images, en diaporama.",
  "description": "Choisissez une présentation PowerPoint dans OneDrive ou SharePoint (compte Microsoft 365 connecté) : Microsoft la convertit en PDF, chaque diapositive devient une image 1080p sur le serveur, puis les diapositives défilent comme un diaporama, même hors ligne (50 diapositives au maximum). La présentation est mise à jour toute seule quand elle change (toutes les heures par défaut). Les animations, les transitions et les vidéos intégrées ne sont pas conservées.",
  "duration": "content",
  "placements": ["full", "top-left", "top-right", "bottom-left", "bottom-right"],
  "settings": [
    { "key": "gfile", "label": "Présentation PowerPoint", "type": "gfile", "accept": "powerpoint", "required": true, "maxLength": 200, "zone": "source" },
    { "key": "gfileName", "label": "Nom du fichier", "type": "hidden", "maxLength": 200 },
    { "key": "gfileMod", "label": "Dernière modification exportée", "type": "hidden", "maxLength": 40 },
    { "key": "gkind", "label": "Type de fichier", "type": "hidden", "default": "slides", "maxLength": 10 },
    { "key": "pdf", "label": "PDF exporté", "type": "hidden", "maxLength": 64 },
    { "key": "pdfTitle", "label": "Nom du PDF", "type": "hidden", "maxLength": 200 },
    { "key": "pdfPages", "label": "Pages du document", "type": "hidden", "maxLength": 6 },
    { "key": "pages", "label": "Diapositives converties", "type": "medias", "accept": "image", "managed": true, "maxLength": 20000 },
    { "key": "interval", "label": "Durée de chaque diapositive", "type": "number", "unit": "secondes", "default": "10", "min": 2, "max": 600, "required": true },
    {
      "key": "fit", "label": "Cadrage", "type": "select", "default": "contain", "ui": "segmented",
      "options": [
        { "value": "contain", "label": "Diapo entière" },
        { "value": "cover", "label": "Remplir l'écran" }
      ]
    },
    {
      "key": "transition", "label": "Transition entre les diapositives", "type": "select", "default": "fade",
      "options": [
        { "value": "fade", "label": "Fondu enchaîné" },
        { "value": "slide", "label": "Glissement (de droite à gauche)" },
        { "value": "zoom", "label": "Zoom avant en fondu" },
        { "value": "none", "label": "Aucune (coupure franche)" }
      ]
    },
    { "key": "range", "label": "Diapositives à afficher", "type": "text", "placeholder": "Toutes · ou par exemple 1-5, 8, 10-12", "maxLength": 200, "zone": "advanced", "help": "Laisser vide pour toutes les diapositives (50 au maximum). Le fichier est converti à nouveau à la validation." },
    { "key": "auto", "label": "Mettre à jour quand la présentation change", "type": "bool", "default": "true", "zone": "advanced" },
    {
      "key": "refresh", "label": "Fréquence de vérification", "type": "select", "default": "60", "showIf": "auto=true", "zone": "advanced",
      "options": [
        { "value": "15", "label": "Toutes les 15 minutes" },
        { "value": "60", "label": "Toutes les heures" },
        { "value": "1440", "label": "Une fois par jour" }
      ]
    },
    {
      "key": "background", "label": "Fond autour de la diapositive", "type": "select", "default": "none", "ui": "segmented", "zone": "advanced", "help": "Une diapositive sur un écran en portrait laisse des bandes : le fond est ajouté aux images à la conversion.",
      "options": [
        { "value": "none", "label": "Noir" },
        { "value": "white", "label": "Blanc" },
        { "value": "blur", "label": "Diapo floutée" }
      ]
    },
    {
      "key": "canvas", "label": "Sens de l'écran", "type": "select", "default": "landscape", "ui": "segmented", "showIf": "background!=none", "zone": "advanced",
      "options": [
        { "value": "landscape", "label": "Paysage" },
        { "value": "portrait", "label": "Portrait" }
      ]
    },
    {
      "key": "speed", "label": "Vitesse de la transition", "type": "select", "default": "normal", "showIf": "transition!=none", "zone": "advanced",
      "options": [
        { "value": "fast", "label": "Rapide (0,4 s)" },
        { "value": "normal", "label": "Normale (0,8 s)" },
        { "value": "slow", "label": "Lente (1,5 s)" }
      ]
    }
  ]
}
