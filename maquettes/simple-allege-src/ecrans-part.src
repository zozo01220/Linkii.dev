</style>
<style>
/* ===== bandeau de la maquette (hors application) ===== */
.mk-note{position:fixed;left:0;right:0;top:0;z-index:2000;height:42px;display:flex;align-items:center;gap:12px;background:#fff;border-bottom:1px dashed var(--line-2);padding:0 16px;color:var(--muted);font-size:13px;white-space:nowrap;overflow-x:auto}
.mk-note b{color:var(--ink);font-weight:500}
.mk-note .grow{flex:1}
.mk-btn{border:1px solid var(--line-2);background:#fff;border-radius:6px;padding:4px 11px;font:inherit;font-size:13px;cursor:pointer;color:var(--ink)}
.mk-btn.on{background:var(--ink);border-color:var(--ink);color:#fff}
.mk-btn:disabled{opacity:.4;cursor:default}
.mk-seg{display:inline-flex}
.mk-seg .mk-btn:first-child{border-radius:6px 0 0 6px}
.mk-seg .mk-btn:last-child{border-radius:0 6px 6px 0;border-left:0}
body{padding-top:42px}
.shell{min-height:calc(100vh - 42px)}
.sidebar{top:42px;height:calc(100vh - 42px)}
.qbar{top:42px}
.mk-toast{position:fixed;left:50%;bottom:26px;transform:translateX(-50%);background:var(--ink);color:#fff;border-radius:8px;padding:10px 16px;font-size:14px;opacity:0;transition:opacity .2s;z-index:3000;pointer-events:none}
.mk-toast.on{opacity:1}
#mk-view,.mk-aff{display:none}

/* ===== page Écrans allégée : en-tête ===== */
.es-head{display:flex;align-items:flex-end;justify-content:space-between;gap:16px;flex-wrap:wrap;margin-bottom:22px}
.es-head h1{font-size:28px;line-height:1.2;letter-spacing:-.01em}
.es-meta{font-size:14px;color:var(--muted);margin-top:4px;display:flex;flex-wrap:wrap;gap:6px;align-items:center}
.es-f{border:0;background:none;padding:1px 6px;margin:0 -6px;border-radius:6px;font:inherit;font-weight:500;cursor:pointer;display:inline-flex;align-items:center;gap:5px}
.es-f.bad{color:var(--danger)}
.es-f.pe{color:var(--warn-ink)}
.es-f:hover{background:var(--row)}
.es-f.on{background:var(--ink);color:#fff;margin:0;padding:1px 9px;border-radius:99px}
.es-act{display:flex;align-items:center;gap:10px;position:relative}
.es-ib{width:40px;height:40px;border-radius:10px;border:1px solid var(--line-2);background:#fff;color:var(--ink);display:grid;place-items:center;cursor:pointer;position:relative;padding:0}
.es-ib:hover:not(:disabled){border-color:var(--muted);background:var(--row)}
.es-ib:disabled{opacity:.45;cursor:default}
.es-ib.pub{background:var(--warn);border-color:var(--warn);color:#fff}
.es-ib.pub:hover{background:var(--warn-ink);border-color:var(--warn-ink)}
.es-cnt{position:absolute;right:-7px;top:-7px;min-width:18px;height:18px;border-radius:9px;background:var(--ink);color:#fff;font:500 11px/18px var(--mono);text-align:center;padding:0 4px;box-sizing:border-box}
.es-q{display:flex;align-items:center;gap:8px;height:40px;width:0;opacity:0;overflow:hidden;border:1px solid var(--line-2);border-radius:10px;background:#fff;color:var(--muted);padding:0;box-sizing:border-box;transition:width .18s,opacity .18s,padding .18s}
.es-q.on{width:230px;opacity:1;padding:0 10px}
.es-q input{flex:1;min-width:0;border:0;box-shadow:none;background:none;padding:0;font:inherit}
.es-q input:focus{box-shadow:none;outline:0}
.es-add{height:40px;border-radius:10px}
.es-menu{position:absolute;right:0;top:calc(100% + 6px)}
.es-menu[hidden]{display:none}

/* ===== cartes ===== */
.es-grid{display:grid;grid-template-columns:repeat(auto-fill,minmax(252px,1fr));gap:18px}
.es-grid .ec{background:#fff;border:1px solid #DDE3EA;border-radius:14px;position:relative;padding:0;overflow:visible;transition:box-shadow .15s,border-color .15s}
.es-grid .ec:hover{box-shadow:0 8px 22px rgba(11,31,58,.09);border-color:#CFD7E2}
.es-grid .ec.picked{border-color:#2F6FC0;box-shadow:0 0 0 2px rgba(47,111,192,.22)}
.es-z{flex:1 1 0;display:flex;align-items:center;justify-content:center;color:#fff;font-weight:600;font-size:11px;text-align:center;padding:4px;line-height:1.2;min-width:0;min-height:0}
.ec-tvw.p .ec-tv{flex-direction:column}
.g1{background:linear-gradient(135deg,#3b78b8,#274e84)}.g2{background:linear-gradient(135deg,#e8932b,#c8452a)}.g3{background:linear-gradient(135deg,#2f9b66,#1f6b46)}.g4{background:linear-gradient(135deg,#8a52b8,#40246a)}.g5{background:linear-gradient(135deg,#4a5f7d,#2b3a50)}
.es-wall{display:grid;grid-template-columns:repeat(2,88px);gap:3px;padding:4px;background:#11161F;border-radius:5px}
.es-wall .es-z{aspect-ratio:16/9;font-size:9px;border-radius:1px}
.ec-stage{cursor:pointer}
/* allégée : ⋯ et crayon au survol, pas de pied ; « publier » en rond orange sur la ligne de la liste */
.v-new .ec-kw{opacity:0;transition:opacity .12s}
.v-new .ec:hover .ec-kw,.v-new .ec-kw.open{opacity:1}
.v-new .ec-name{cursor:text;border-radius:5px;padding:1px 5px;margin-left:-5px}
.v-new .ec-name:hover{background:var(--row);box-shadow:0 0 0 1px var(--line-2)}
.es-ni{flex:1;min-width:0;font:inherit;font-size:15px;font-weight:500;border:0;outline:2px solid var(--signal);border-radius:5px;padding:1px 5px;margin-left:-5px;background:#fff;box-shadow:none}
.es-plrow{display:flex;align-items:center;gap:6px;margin-top:7px;position:relative}
.es-plrow .ec-pl{margin-top:0;flex:1;min-width:0;width:auto;margin-left:-8px;margin-right:0;cursor:pointer}
.es-pb{flex:none;width:30px;height:30px;border-radius:50%;border:0;background:#E8872B;color:#fff;display:grid;place-items:center;cursor:pointer;padding:0}
.es-pb:hover{background:#D4741C}
.es-lists{position:absolute;left:-8px;top:calc(100% + 4px);z-index:45;min-width:210px}
.es-lists button.cur{font-weight:600}
.ec-kw .kebab-btn{background:none;display:grid;place-items:center;cursor:pointer;padding:0}
[data-tip]{position:relative}
[data-tip]:hover::after{content:attr(data-tip);position:absolute;bottom:calc(100% + 7px);left:50%;transform:translateX(-50%);background:#0B1F3A;color:#fff;font-size:12px;font-weight:400;padding:5px 9px;border-radius:6px;white-space:nowrap;z-index:60;pointer-events:none;line-height:1.35}
[data-tip].tb:hover::after{bottom:auto;top:calc(100% + 7px)}
[data-tip].tl:hover::after{left:0;transform:none}
[data-tip].tr:hover::after{left:auto;right:0;transform:none}

/* ===== lignes : un écran = une ligne (même base que la page d'une liste) ===== */
.es-rows{background:#fff;border:1px solid var(--line);border-radius:var(--card-radius,12px)}
.es-row{display:grid;grid-template-columns:112px minmax(0,1fr) 190px 40px 36px;align-items:center;gap:18px;padding:14px 20px;border-top:1px solid var(--row);cursor:pointer;transition:background .12s;position:relative}
.es-row:first-child{border-top:0;border-radius:11px 11px 0 0}
.es-row:last-child{border-radius:0 0 11px 11px}
.es-row:hover{background:#FAFBFD}
.es-th{width:112px;height:63px;border-radius:8px;overflow:hidden;background:#11161F;border:1px solid var(--line);display:flex;justify-content:center;gap:2px}
.es-th.p{padding:0 38px;background:#E9ECF2}
.es-th.p > span{flex-direction:column}
.es-th.off{filter:grayscale(1);opacity:.5}
.es-th > span{display:flex;flex:1;min-width:0}
.es-th.w{display:grid;grid-template-columns:1fr 1fr;gap:2px;padding:2px}
.es-rn{min-width:0}
.es-rn .ec-name{display:inline-block;max-width:100%;font-size:15px;font-weight:600;flex:none}
.es-rn small{display:flex;align-items:center;gap:6px;color:var(--muted);font-size:13.5px;margin-top:2px;position:relative}
.es-rl{border:0;background:none;font:inherit;color:inherit;padding:1px 5px;margin-left:-5px;border-radius:5px;cursor:pointer;display:inline-flex;align-items:center;gap:6px;max-width:100%}
.es-rl:hover{background:var(--row);color:var(--ink)}
.es-st{display:inline-flex;align-items:center;gap:7px;font-size:13.5px;color:var(--ink);white-space:nowrap}
.es-st .d{width:8px;height:8px;border-radius:50%;background:#2E8B57;flex:none}
.es-st.off .d{background:#C0392B}
.es-st small{color:var(--muted);font-size:13px}
.es-row .ec-kw{margin:0}
.es-row .es-lists{left:0}

/* ===== état vide ===== */
.es-empty{border:2px dashed #B9C8DB;border-radius:14px;background:#fff;padding:58px 28px;text-align:center;color:var(--muted)}
.es-empty b{display:block;color:var(--ink);font-size:19px;font-weight:500;margin-bottom:6px}
.es-empty i{display:inline-grid;place-items:center;width:60px;height:60px;border-radius:16px;background:#EAF1FA;color:var(--signal);margin-bottom:14px}
.es-empty .btn{margin-top:18px}
.es-none{color:var(--muted);text-align:center;padding:40px 0}

/* ===== version « Aujourd'hui » (réplique simplifiée de la page actuelle) ===== */
.v-old .ec-ft{display:flex}
.old-tools{display:flex;gap:8px;align-items:center;margin-bottom:14px}
.old-tools .search-box{flex:1;margin:0}
.es-mode{margin-top:auto}
.es-mode .switch{flex:none !important;width:38px !important;height:22px;margin-left:auto}
@media (max-width:1100px){.es-row{grid-template-columns:112px minmax(0,1fr) 40px 36px}.es-row .es-st{display:none}}
@media (max-width:760px){.es-row{grid-template-columns:84px minmax(0,1fr) 40px 36px;gap:12px;padding:12px 14px}.es-th{width:84px;height:47px}.es-th.p{padding:0 30px}.es-q.on{width:150px}}
</style>
</head>
<body class="v-new">

<div class="mk-note">
  <b>Maquette</b> · Page Écrans allégée, mode Simple — rien n'est codé
  <span class="grow"></span>
  <span class="mk-seg" id="mk-ver"><button type="button" class="mk-btn" data-v="old">Aujourd'hui</button><button type="button" class="mk-btn on" data-v="new">Allégée</button></span>
  <span class="mk-aff">Affichage :</span>
  <span class="mk-seg" id="mk-view"><button type="button" class="mk-btn on" data-v="cards">cartes</button><button type="button" class="mk-btn" data-v="rows">lignes</button></span>
  <span>Écrans :</span>
  <span class="mk-seg" id="mk-demo"><button type="button" class="mk-btn on" data-v="full">connectés</button><button type="button" class="mk-btn" data-v="empty">aucun</button></span>
</div>
<div class="mk-toast" id="toast"></div>

<div class="shell">
  <aside class="sidebar">
<!--BRAND-->
    <a href="#" class="nav active" aria-current="page"><i data-i="monitor"></i> Écrans <span class="nbadges"><span class="nbadge off">1</span></span></a>
    <a href="listes-lecture-simple-allegee.html" class="nav"><i data-i="list"></i> Listes de lecture</a>
    <a href="compositions-simple-allegee.html" class="nav"><i data-i="image"></i> Contenus</a>
    <div class="spacer"></div>
    <button type="button" class="nav mode-switch es-mode"><i data-i="sliders"></i> Mode expert <span class="switch"><span></span></span></button>
  </aside>

  <div class="main-col">
    <header class="qbar" aria-label="Accès rapides">
      <div class="org">LPR Unil</div>
      <div class="grow"></div>
      <button type="button" class="qb-btn" aria-label="Aide"><i data-i="help" data-s="19"></i></button>
      <button type="button" class="qb-btn" aria-label="Notifications"><i data-i="bell" data-s="19"></i></button>
      <button type="button" class="qb-me" aria-label="Compte"><span class="avatar">LU</span><i data-i="chev" data-s="16"></i></button>
    </header>

    <main class="content" id="page"></main>
  </div>
</div>

<script>
const IC = {
  monitor:'<rect x="2" y="3" width="20" height="14" rx="2"/><path d="M8 21h8M12 17v4"/>',
  hand:'<path d="M18 11V6a2 2 0 0 0-4 0v5M14 10V4a2 2 0 0 0-4 0v6M10 10.5V6a2 2 0 0 0-4 0v8"/><path d="M18 8a2 2 0 1 1 4 0v6a8 8 0 0 1-8 8h-2c-2.8 0-4.5-.86-6-2.34l-3.6-3.6a2 2 0 0 1 2.83-2.82L7 15"/>',
  door:'<path d="M5 21V4a1 1 0 0 1 1-1h12a1 1 0 0 1 1 1v17M3 21h18"/><path d="M15 12h.01"/>',
  grid:'<rect x="2" y="3" width="9" height="7" rx="1"/><rect x="13" y="3" width="9" height="7" rx="1"/><rect x="2" y="12" width="9" height="7" rx="1"/><rect x="13" y="12" width="9" height="7" rx="1"/>',
  dots:'<circle cx="12" cy="5" r="1"/><circle cx="12" cy="12" r="1"/><circle cx="12" cy="19" r="1"/>',
  play:'<polygon points="7 4 19 12 7 20 7 4"/>',
  playbox:'<rect x="3" y="3" width="18" height="18" rx="3"/><path d="m10 8 6 4-6 4z"/>',
  upload:'<path d="M12 3v12M7 8l5-5 5 5"/><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/>',
  check:'<path d="M20 6 9 17l-5-5"/>',
  chev:'<path d="m6 9 6 6 6-6"/>',
  edit:'<path d="M17 3a2.85 2.83 0 1 1 4 4L7.5 20.5 2 22l1.5-5.5Z"/>',
  sliders:'<path d="M4 21v-7M4 10V3M12 21v-9M12 8V3M20 21v-5M20 12V3M1 14h6M9 8h6M17 16h6"/>',
  trash:'<path d="M3 6h18M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6M8 6V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2"/>',
  search:'<circle cx="11" cy="11" r="7"/><path d="m21 21-4.3-4.3"/>',
  plus:'<path d="M12 5v14M5 12h14"/>',
  list:'<path d="M8 6h13M8 12h13M8 18h13M3 6h.01M3 12h.01M3 18h.01"/>',
  image:'<rect x="3" y="3" width="18" height="18" rx="2"/><circle cx="8.5" cy="8.5" r="1.5"/><path d="M21 15l-5-5L5 21"/>',
  help:'<circle cx="12" cy="12" r="10"/><path d="M9.1 9a3 3 0 0 1 5.8 1c0 2-3 3-3 3M12 17h.01"/>',
  bell:'<path d="M6 8a6 6 0 0 1 12 0c0 7 3 9 3 9H3s3-2 3-9M10.3 21a1.94 1.94 0 0 0 3.4 0"/>',
  x:'<path d="M18 6 6 18M6 6l12 12"/>',
  crown:'<path d="M3 7l4.5 4L12 5l4.5 6L21 7l-2 11H5z"/>',
  filter:'<path d="M3 5h18l-7 8v6l-4-2v-4z"/>'
};
const ico = (n, s = 18) => `<svg class="ico-svg" viewBox="0 0 24 24" width="${s}" height="${s}" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">${IC[n] || ''}</svg>`;
document.querySelectorAll('[data-i]').forEach(e => { e.outerHTML = ico(e.dataset.i, +(e.dataset.s || 18)); });
const $ = s => document.querySelector(s);
let toastT;
function toast(m) { const t = $('#toast'); t.textContent = m; t.classList.add('on'); clearTimeout(toastT); toastT = setTimeout(() => t.classList.remove('on'), 2400); }

const LISTS = { 'Menu du jour':'g3', 'Promotions':'g2', 'Accueil visiteurs':'g1', 'Consignes':'g5', 'Grand visuel':'g4' };
const DATA = () => [
  { id:1, name:'Accueil', kind:'s', dev:'Android TV · App 1.4', list:'Menu du jour', on:true },
  { id:2, name:'Hall', kind:'s', dev:'Windows · Chrome 156', list:'Promotions', on:true, pend:true },
  { id:3, name:'Vitrine', kind:'s', dev:'Android · App 1.4', list:'Promotions', on:true, p:true, pend:true },
  { id:4, name:'Réserve', kind:'s', dev:'Windows · Chrome 155', list:'Consignes', on:false, ago:'depuis 8 h' },
  { id:5, name:'Borne entrée Sud', kind:'k', dev:'Windows · Firefox 159', list:'Accueil visiteurs', on:true, p:true },
  { id:6, name:'Salle Léman', kind:'r', dev:'Android · tablette', list:'Accueil visiteurs', on:true },
  { id:7, name:'Mur du hall', kind:'w', dev:'4 écrans · Android TV', list:'Grand visuel', on:true, sub:'4/4' }
];
let S = DATA(), ver = 'new', view = 'cards', filter = null, q = '', qOpen = false, menu = null, lists = null, add = false, ren = null;
const KI = { s:'monitor', k:'hand', r:'door', w:'grid' }, KT = { s:'Écran de diffusion', k:'Borne interactive', r:'Écran de salle', w:"Mur d'écrans 2 × 2" };
const shown = () => S.filter(s => (!q || s.name.toLowerCase().includes(q.toLowerCase())) && (filter !== 'off' || !s.on) && (filter !== 'pend' || s.pend));
const pl = (n, w) => `${n} ${w}${n > 1 ? 's' : ''}`;

function zones(s, wall) {
  const g = LISTS[s.list];
  if (s.kind === 'w') return ['Grand', 'visuel', '', ''].map(t => `<span class="es-z ${g}">${wall ? t : ''}</span>`).join('');
  return `<span class="es-z ${g}">${s.list}</span>`;
}
function kebab(s) {
  return `<div class="ec-kw ${menu === s.id ? 'open' : ''}"><button type="button" class="kebab-btn" data-a="menu" aria-label="Actions pour ${s.name}">${ico('dots', 18)}</button>${menu === s.id ? `
    <div class="kebab-menu" role="menu">
      <button type="button" data-a="edit">${ico('sliders', 16)} Paramètres de l'écran</button>
      <button type="button" data-a="sim">${ico('play', 16)} Simuler</button>
      <button type="button" data-a="ren">${ico('edit', 16)} Renommer</button>
      <hr><button type="button" class="danger" data-a="del">${ico('trash', 16)} Supprimer</button>
    </div>` : ''}</div>`;
}
const listMenu = s => lists !== s.id ? '' : `<div class="kebab-menu es-lists" role="menu">${Object.keys(LISTS).map(n => `<button type="button" data-a="setlist" data-l="${n}" class="${n === s.list ? 'cur' : ''}">${n === s.list ? ico('check', 15) : '<span style="width:15px"></span>'} ${n}</button>`).join('')}</div>`;
const nameEl = s => ren === s.id ? `<input class="es-ni" id="ni" value="${s.name}" aria-label="Nom de l'écran">` : `<span class="ec-name" data-a="${ver === 'new' ? 'ren' : 'edit'}" title="${ver === 'new' ? 'Renommer' : ''}">${s.name}</span>`;

function card(s) {
  const tv = s.kind === 'w'
    ? `<div class="ec-tvw"><div class="es-wall">${zones(s, true)}</div><span class="ec-neck"></span><span class="ec-base"></span></div>`
    : `<div class="ec-tvw ${s.p ? 'p' : ''}"><div class="ec-tv">${zones(s)}</div><span class="ec-neck"></span><span class="ec-base"></span></div>`;
  const foot = ver === 'old' ? `<div class="ec-ft">${s.pend ? `<span class="ec-ps pe"><i class="d"></i>À publier</span><span class="ec-ic"></span><button type="button" class="ec-pub" data-a="pub">${ico('upload', 14)}Publier</button>` : !s.on ? `<span class="ec-ps"><i class="d"></i>Publiée à sa reconnexion</span>` : `<span class="ec-ps ok">${ico('check', 14)}Tout est à jour</span>`}</div>` : '';
  return `<div class="pl-card ec" data-id="${s.id}">
    <div class="ec-top">
      <div class="ec-stage ${s.on ? '' : 'dim'}" data-a="edit">${tv}</div>
      <span class="ec-stat ${s.on ? 'on' : 'off'}"><i class="d"></i>${s.on ? 'En ligne' : 'Hors ligne'}${s.ago || s.sub ? ` <small>· ${s.ago || s.sub}</small>` : ''}</span>
      <div class="ec-ov"><input type="checkbox" class="ec-ck" aria-label="Sélectionner ${s.name}"><div class="ec-rb"><button type="button" class="ec-rbtn tb tr" data-tip="Simuler" data-a="sim" aria-label="Simuler">${ico('play', 16)}</button></div></div>
    </div>
    <div class="ec-bd">
      <div class="ec-nm"><span class="ec-kd ${s.kind === 'k' || s.kind === 'r' ? 'k' : ''} tl" data-tip="${KT[s.kind]} · ${s.dev}">${ico(KI[s.kind], 16)}</span>${nameEl(s)}${kebab(s)}</div>
      <div class="es-plrow"><button type="button" class="ec-pl" data-a="lists" aria-expanded="${lists === s.id}">${ico('playbox', 14)}<span class="ec-pln">${s.list}${s.kind === 'w' ? '<span class="z"> · 2×2</span>' : ''}</span><span class="ec-chev">${ico('chev', 14)}</span></button>
        ${ver === 'new' && s.pend ? `<button type="button" class="es-pb tr" data-a="pub" data-tip="Publier sur cet écran" aria-label="Publier sur ${s.name}">${ico('upload', 15)}</button>` : ''}${listMenu(s)}</div>
      ${foot}
    </div></div>`;
}
function row(s) {
  const th = s.kind === 'w' ? `<span class="es-th w ${s.on ? '' : 'off'}">${zones(s)}</span>` : `<span class="es-th ${s.p ? 'p' : ''} ${s.on ? '' : 'off'}"><span>${zones(s).replace(s.list, '')}</span></span>`;
  return `<div class="es-row" data-id="${s.id}" data-a="edit">${th}
    <div class="es-rn"><div class="ec-nm">${nameEl(s)}</div>
      <small><button type="button" class="es-rl" data-a="lists" title="Changer de liste de lecture">${ico('playbox', 14)}${s.list}</button><span>· ${KT[s.kind].replace(' 2 × 2', '')}</span>${listMenu(s)}</small></div>
    <span class="es-st ${s.on ? '' : 'off'}"><i class="d"></i>${s.on ? 'En ligne' : 'Hors ligne'}${s.ago ? ` <small>· ${s.ago}</small>` : ''}</span>
    <span class="es-pbw">${s.pend ? `<button type="button" class="es-pb tr" data-a="pub" data-tip="Publier sur cet écran" aria-label="Publier">${ico('upload', 15)}</button>` : ''}</span>
    ${kebab(s)}</div>`;
}
const addMenu = () => `<div class="kebab-menu lx-add-menu es-menu" role="menu" ${add ? '' : 'hidden'}>
  <button type="button" data-a="new" data-t="Écran de diffusion">${ico('monitor', 18)}<span><b>Écran de diffusion</b><small>Avec le code affiché sur l'écran</small></span></button>
  <button type="button" data-a="new" data-t="Borne interactive">${ico('hand', 18)}<span><b>Borne interactive</b><small>Borne à écran tactile</small></span></button>
  <button type="button" data-a="new" data-t="Écran de salle">${ico('door', 18)}<span><b>Écran de salle</b><small>Tablette à la porte d'une salle</small></span></button></div>`;

function render() {
  document.body.className = 'v-' + ver;
  const off = S.filter(s => !s.on).length, pend = S.filter(s => s.pend).length, list = shown();
  let h = '';
  if (ver === 'old') {
    h += `<div class="page-head"><div><h1>Vos écrans</h1><p class="sub">Choisissez la liste de lecture et les widgets de chaque écran, puis publiez : chaque écran se met à jour indépendamment.</p></div>
      <div class="row head-actions" style="position:relative;display:flex;gap:10px">${pend ? `<button type="button" class="btn publish-btn" data-a="puball">${ico('upload', 16)} Publier <span class="cnt">${pend}</span></button>` : ''}
      <button type="button" class="btn" data-a="add">${ico('plus', 16)} Ajouter ${ico('chev', 14)}</button>${addMenu()}</div></div>`;
    if (S.length) h += `<div class="lx-bh">${ico('monitor', 16)} <span>Écrans</span> <small>${S.length}</small></div>
      <div class="old-tools"><label class="search-box">${ico('search', 16)}<input id="q" placeholder="Rechercher des écrans" value="${q}"></label><button type="button" class="btn ghost">${ico('filter', 15)} Filtres ${ico('chev', 14)}</button></div>`;
  } else {
    h += `<header class="es-head"><div><h1>Écrans</h1>
      <p class="es-meta">${S.length ? `<span>${pl(S.length, 'écran')}</span>` : '<span>Aucun écran pour l\'instant</span>'}
        ${off ? `<span>·</span><button type="button" class="es-f bad ${filter === 'off' ? 'on' : ''}" data-a="f" data-f="off" title="N'afficher que les écrans hors ligne">${off} hors ligne${filter === 'off' ? ico('x', 13) : ''}</button>` : ''}
        ${pend ? `<span>·</span><button type="button" class="es-f pe ${filter === 'pend' ? 'on' : ''}" data-a="f" data-f="pend" title="N'afficher que les écrans à publier">${pend} à publier${filter === 'pend' ? ico('x', 13) : ''}</button>` : ''}</p></div>
      <div class="es-act">
        ${S.length ? `<label class="es-q ${qOpen ? 'on' : ''}">${ico('search', 16)}<input id="q" placeholder="Rechercher" aria-label="Rechercher un écran" value="${q}"></label>
        ${qOpen ? '' : `<button type="button" class="es-ib tb" data-a="q" data-tip="Rechercher" aria-label="Rechercher">${ico('search', 18)}</button>`}
        <button type="button" class="es-ib tb ${pend ? 'pub' : ''}" data-a="puball" ${pend ? '' : 'disabled'} data-tip="${pend ? 'Publier sur ' + pl(pend, 'écran') : 'Tout est publié'}" aria-label="Publier">${ico('upload', 18)}${pend ? `<span class="es-cnt">${pend}</span>` : ''}</button>` : ''}
        <button type="button" class="btn es-add" data-a="add">${ico('plus', 16)} Ajouter</button>${addMenu()}
      </div></header>`;
  }
  if (!S.length) h += ver === 'new'
    ? `<div class="es-empty"><i>${ico('monitor', 28)}</i><b>Connectez votre premier écran</b>Installez le player sur l'écran, puis saisissez ici le code qu'il affiche.<br><button type="button" class="btn" data-a="new" data-t="Écran de diffusion">${ico('plus', 16)} Connecter un écran</button></div>`
    : `<div class="card empty"><div class="big">Aucun écran</div><p>Connectez un écran avec le code qu'il affiche, choisissez sa liste de lecture, puis publiez.</p><button type="button" class="btn" data-a="new" data-t="Écran de diffusion">${ico('plus', 16)} Connecter un écran</button></div>`;
  else if (!list.length) h += `<div class="es-none">Aucun écran trouvé</div>`;
  else h += view === 'rows' && ver === 'new' ? `<div class="es-rows">${list.map(row).join('')}</div>` : `<div class="es-grid">${list.map(card).join('')}</div>`;
  $('#page').innerHTML = h;
  const ni = $('#ni'); if (ni) { ni.focus(); ni.select(); }
}

document.addEventListener('click', e => {
  const a = e.target.closest('[data-a]'), host = e.target.closest('[data-id]'), s = host && S.find(x => x.id == host.dataset.id);
  if (e.target.closest('.ec-ck')) { host.classList.toggle('picked', e.target.checked); return; }
  if (e.target.closest('#ni, #q')) return;
  const hadOpen = menu || lists || add; menu = lists = null; const wasAdd = add; add = false;
  if (!a) { if (hadOpen) render(); return; }
  e.preventDefault();
  switch (a.dataset.a) {
    case 'menu': menu = s.id; break;
    case 'lists': lists = s.id; break;
    case 'setlist': if (s.list !== a.dataset.l) { s.list = a.dataset.l; s.pend = true; toast(`« ${s.name} » diffusera « ${s.list} » après publication`); } break;
    case 'pub': s.pend = false; toast(s.on ? `Publié sur « ${s.name} »` : `« ${s.name} » recevra la publication à sa reconnexion`); break;
    case 'puball': { const n = S.filter(x => x.pend).length; S.forEach(x => x.pend = false); if (filter === 'pend') filter = null; toast(`Publié sur ${pl(n, 'écran')}`); break; }
    case 'edit': toast(`Ouvre « Paramètres de l'écran » de ${s.name}`); break;
    case 'sim': toast(`Ouvre le simulateur de ${s.name}`); break;
    case 'ren': ren = s.id; break;
    case 'del': S = S.filter(x => x !== s); toast(`« ${s.name} » supprimé (après confirmation dans l'application)`); break;
    case 'f': filter = filter === a.dataset.f ? null : a.dataset.f; break;
    case 'q': qOpen = true; render(); $('#q').focus(); return;
    case 'add': add = !wasAdd; break;
    case 'new': toast(`Ouvre l'assistant : ${a.dataset.t}`); break;
  }
  render();
});
document.addEventListener('input', e => { if (e.target.id === 'q') { q = e.target.value; const p = e.target.selectionStart; render(); const n = $('#q'); n.focus(); n.setSelectionRange(p, p); } });
document.addEventListener('keydown', e => {
  if (e.target.id === 'ni' && (e.key === 'Enter' || e.key === 'Escape')) { if (e.key === 'Enter' && e.target.value.trim()) S.find(x => x.id === ren).name = e.target.value.trim(); ren = null; render(); }
  if (e.target.id === 'q' && e.key === 'Escape') { q = ''; qOpen = false; render(); }
});
document.addEventListener('focusout', e => {
  if (e.target.id === 'ni' && ren != null) { const s = S.find(x => x.id === ren); if (e.target.value.trim()) s.name = e.target.value.trim(); ren = null; setTimeout(render); }
  if (e.target.id === 'q' && !q) { qOpen = false; setTimeout(render); }
});
function seg(id, fn) { $(id).addEventListener('click', e => { const b = e.target.closest('.mk-btn'); if (!b || b.disabled) return; $(id).querySelectorAll('.mk-btn').forEach(x => x.classList.toggle('on', x === b)); fn(b.dataset.v); render(); }); }
seg('#mk-ver', v => { ver = v; $('#mk-view').querySelectorAll('.mk-btn').forEach(b => b.disabled = v === 'old' && b.dataset.v === 'rows'); });
seg('#mk-view', v => view = v);
seg('#mk-demo', v => { S = v === 'empty' ? [] : DATA(); filter = null; q = ''; qOpen = false; });
render();
</script>
</body>
</html>
