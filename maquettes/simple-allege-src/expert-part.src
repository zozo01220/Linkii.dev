</style>
<style>
/* ===== bandeau de la maquette (hors application) ===== */
.mk-note{position:fixed;left:0;right:0;top:0;z-index:2000;height:42px;display:flex;align-items:center;gap:12px;background:#fff;border-bottom:1px dashed var(--line-2);padding:0 16px;color:var(--muted);font-size:13px;white-space:nowrap;overflow-x:auto}
.mk-note b{color:var(--ink);font-weight:500}
.mk-note .grow{flex:1}
.mk-btn{border:1px solid var(--line-2);background:#fff;border-radius:6px;padding:4px 11px;font:inherit;font-size:13px;cursor:pointer;color:var(--ink)}
.mk-btn.on{background:var(--ink);border-color:var(--ink);color:#fff}
.mk-seg{display:inline-flex}
.mk-seg .mk-btn{border-radius:0;border-left-width:0}
.mk-seg .mk-btn:first-child{border-radius:6px 0 0 6px;border-left-width:1px}
.mk-seg .mk-btn:last-child{border-radius:0 6px 6px 0}
body{padding-top:42px}
.shell{min-height:calc(100vh - 42px)}
html .shell .sidebar{top:42px;height:calc(100vh - 42px)}
.qbar{top:42px}
.mk-toast{position:fixed;left:50%;bottom:26px;transform:translateX(-50%);background:var(--ink);color:#fff;border-radius:8px;padding:10px 16px;font-size:14px;opacity:0;transition:opacity .2s;z-index:3000;pointer-events:none}
.mk-toast.on{opacity:1}

/* ===== en-tête allégé (même base que les pages du mode Simple) ===== */
.xh{display:flex;align-items:flex-end;justify-content:space-between;gap:16px;flex-wrap:wrap;margin-bottom:22px}
.xh h1{font-size:28px;line-height:1.2;letter-spacing:-.01em}
.xm{font-size:14px;color:var(--muted);margin-top:4px;display:flex;flex-wrap:wrap;gap:6px;align-items:center;min-height:24px}
.xf{border:0;background:none;padding:1px 6px;margin:0 -6px;border-radius:6px;font:inherit;font-weight:500;cursor:pointer;display:inline-flex;align-items:center;gap:5px;color:var(--ink)}
.xf.mu{color:var(--muted);font-weight:400}
.xf.pe{color:var(--warn-ink)}
.xf.bad{color:var(--danger)}
.xf:hover{background:var(--row)}
.xf.on{background:var(--ink);color:#fff;margin:0;padding:1px 9px;border-radius:99px}
.xinfo{display:inline-grid;place-items:center;color:var(--muted);cursor:help;position:relative}
.xinfo:hover::after{content:attr(data-t);position:absolute;left:0;top:24px;width:320px;background:var(--ink);color:#fff;font-size:12.5px;line-height:1.45;padding:8px 10px;border-radius:6px;z-index:40;white-space:normal}
.xa{display:flex;align-items:center;gap:10px;position:relative}
.xib{width:40px;height:40px;border-radius:10px;border:1px solid var(--line-2);background:#fff;color:var(--ink);display:grid;place-items:center;cursor:pointer;position:relative;padding:0}
.xib:hover,.xib.on{border-color:var(--muted);background:var(--row)}
.xib .dot{position:absolute;right:-4px;top:-4px;width:10px;height:10px;border-radius:50%;background:var(--ink);border:2px solid var(--bg)}
.xq{display:flex;align-items:center;gap:8px;height:40px;width:0;opacity:0;overflow:hidden;border:1px solid var(--line-2);border-radius:10px;background:#fff;color:var(--muted);padding:0;box-sizing:border-box;transition:width .18s,opacity .18s,padding .18s}
.xq.on{width:230px;opacity:1;padding:0 10px}
.xq input{flex:1;min-width:0;border:0;box-shadow:none;background:none;padding:0;font:inherit}
.xq input:focus{box-shadow:none;outline:0}
.xadd{height:40px;border-radius:10px}
.xpop{position:absolute;right:0;top:calc(100% + 6px);min-width:220px;background:#fff;border:1px solid var(--line-2);border-radius:10px;box-shadow:0 10px 28px rgba(11,31,58,.16);padding:6px;z-index:45}
.xpop .lab{font-size:11px;text-transform:uppercase;letter-spacing:.06em;color:var(--muted);padding:6px 10px 2px}
.xpop button{display:flex;align-items:center;gap:10px;width:100%;padding:8px 10px;border:0;border-radius:6px;background:none;font:inherit;font-size:14px;color:var(--ink);text-align:left;cursor:pointer}
.xpop button:hover{background:var(--bg)}
.xpop button.on{font-weight:600}
.xpop button.on::after{content:"✓";margin-left:auto;color:var(--signal)}
.xpop button.bad{color:var(--danger)}
.xpop hr{border:0;border-top:1px solid var(--line);margin:4px 0}
.xempty{border:1.5px dashed var(--line-2);border-radius:14px;padding:34px 20px;text-align:center;color:var(--muted);font-size:14px;line-height:1.6}
.xempty b{display:block;color:var(--ink);font-size:16px;font-weight:600}
.xnone{padding:40px 0;text-align:center;color:var(--muted)}
.xdots{width:30px;height:30px;border:0;background:none;border-radius:8px;display:grid;place-items:center;color:var(--muted);cursor:pointer;opacity:0;transition:opacity .12s;flex:none}
.xdots:hover,.xdots.on{background:var(--row);color:var(--ink)}
*:hover>.xdots,.xdots.on,.xrow:hover .xdots,.xcard:hover .xdots{opacity:1}
.xkw{position:relative;flex:none}
.xkw .xpop{top:34px}

/* ===== cartes et lignes ===== */
.xgrid{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:14px}
.xgrid.wide{grid-template-columns:repeat(3,minmax(0,1fr))}
@media (max-width:1250px){.xgrid{grid-template-columns:repeat(3,minmax(0,1fr))}.xgrid.wide{grid-template-columns:repeat(2,minmax(0,1fr))}}
.xcard{background:#fff;border:1px solid var(--line);border-radius:14px;padding:16px;position:relative;min-width:0;cursor:pointer;transition:box-shadow .15s,border-color .15s}
.xcard:hover{box-shadow:0 8px 22px rgba(11,31,58,.09);border-color:#CFD7E2}
.xcard:has(.xpop){z-index:42}
.xcard.dim{opacity:.6}
.xcard>.xkw{position:absolute;right:10px;top:10px}
.xwho{display:flex;align-items:center;gap:12px;min-width:0}
.xwho .avatar{width:40px;height:40px;font-size:14px;flex:none}
.xwho .avatar.inv{background:#fff;color:var(--muted);border:1.5px dashed var(--line-2)}
.xwho .avatar.off{background:#9AA7B6}
.xnm{min-width:0}
.xnm b{display:block;font-weight:600;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
.xnm small{display:block;color:var(--muted);font-size:13px;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
.xtag{display:inline-block;font-size:12px;font-weight:500;color:var(--muted);margin-left:6px}
.xtag.pe{color:var(--warn-ink)}
.xline{margin-top:14px;font-size:14px;color:var(--ink);display:flex;align-items:center;gap:6px}
.xline.mu{margin-top:2px;font-size:13px;color:var(--muted)}
.xline.pe{color:var(--warn-ink)}
.xlist{background:#fff;border:1px solid var(--line);border-radius:14px;overflow:visible}
.xrow{display:flex;align-items:center;gap:16px;min-height:60px;padding:8px 12px 8px 16px;border-top:1px solid var(--row);cursor:pointer;position:relative}
.xrow:first-child{border-top:0;border-radius:14px 14px 0 0}
.xrow:last-child{border-radius:0 0 14px 14px}
.xrow:hover{background:#FAFBFC}
.xrow:has(.xpop){z-index:42}
.xrow.dim{opacity:.6}
.xrow .c1{flex:0 0 30%;min-width:0}
.xrow .c2{flex:0 0 16%;font-size:14px}
.xrow .c3{flex:1;min-width:0;font-size:13.5px;color:var(--muted);white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
.xrow .num{flex:0 0 90px;text-align:right;font-variant-numeric:tabular-nums}
.xrow.sub{min-height:44px;padding-left:56px;font-size:14px}
.xrow.head{min-height:36px;cursor:default;font-size:12px;color:var(--muted);text-transform:uppercase;letter-spacing:.05em}
.xrow.head:hover{background:none}
/* aires */
.xah{display:flex;align-items:center;gap:10px;min-width:0}
.xah b{font-weight:600;font-size:15.5px;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
.xavs{display:flex;margin-left:auto;padding-right:34px}
.xavs .avatar{width:24px;height:24px;font-size:10px;border:2px solid #fff;margin-left:-6px}
.xz{display:flex;align-items:center;gap:9px;padding:7px 0;font-size:14px;border-top:1px solid var(--row)}
.xz:first-child{border-top:0}
.xz svg{color:var(--muted);flex:none}
.xz small{color:var(--muted);font-size:12.5px}
.xz .n{margin-left:auto;color:var(--muted);font-size:13px;font-variant-numeric:tabular-nums}
.xzl{margin-top:12px}
.xchev{transition:transform .15s;color:var(--muted);flex:none}
.xchev.open{transform:rotate(90deg)}
/* statistiques */
.xk{display:flex;gap:56px;flex-wrap:wrap;margin:0 0 26px}
.xk div b{display:block;font-size:30px;font-weight:600;line-height:1.15;letter-spacing:-.01em;font-variant-numeric:tabular-nums}
.xk div b small{font-size:16px;font-weight:400;color:var(--muted)}
.xk div span{font-size:13px;color:var(--muted)}
.xk .bad b{color:var(--danger)}
.xk .ok b{color:#2E8B57}
.x2{display:grid;grid-template-columns:3fr 2fr;gap:14px}
.xc{background:#fff;border:1px solid var(--line);border-radius:14px;padding:18px 20px}
.xc h3{font-size:14px;font-weight:600;margin:0 0 14px}
.xbars{display:flex;align-items:flex-end;gap:10px;height:190px}
.xbars div{flex:1;display:flex;flex-direction:column;justify-content:flex-end;align-items:center;gap:6px;height:100%;font-size:12px;color:var(--muted)}
.xbars i{display:block;width:100%;max-width:46px;background:#3B82C4;border-radius:5px 5px 0 0;min-height:3px}
.xbars div:hover i{background:var(--ink)}
.xtop{display:grid;gap:12px}
.xtop div{font-size:14px}
.xtop div span{float:right;color:var(--muted);font-variant-numeric:tabular-nums}
.xtop i{display:block;height:4px;border-radius:2px;background:var(--row);margin-top:6px;overflow:hidden}
.xtop i u{display:block;height:100%;background:#3B82C4;border-radius:2px}
.xbar{flex:0 0 140px;height:5px;border-radius:3px;background:var(--row);overflow:hidden}
.xbar u{display:block;height:100%;background:#3B82C4}
.xst{display:inline-flex;align-items:center;gap:7px;font-size:14px}
.xst::before{content:"";width:8px;height:8px;border-radius:50%;background:#2E8B57}
.xst.off{color:var(--danger)}
.xst.off::before{background:var(--danger)}
/* historique */
.xday{padding:18px 4px 8px;font-size:12px;text-transform:uppercase;letter-spacing:.06em;color:var(--muted)}
.xday:first-child{padding-top:0}
.xev{display:flex;align-items:center;gap:14px;min-height:52px;padding:6px 16px;border-top:1px solid var(--row);cursor:pointer}
.xev:first-child{border-top:0}
.xev:hover{background:#FAFBFC}
.xev .t{flex:0 0 44px;font:500 12.5px var(--mono);color:var(--muted)}
.xev .d{flex:none;width:8px;height:8px;border-radius:50%;background:#C3CCD8}
.xev .d.ok{background:#2E8B57}.xev .d.warn{background:#E8872B}.xev .d.error{background:var(--danger)}
.xev .w{flex:1;min-width:0}
.xev .w b{font-weight:500}
.xev .w small{display:block;color:var(--muted);font-size:13px;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
.xev .who{flex:none;color:var(--muted);font-size:13px}
.xstrip{display:grid;grid-template-columns:repeat(48,1fr);gap:1px;margin-top:4px}
.xstrip i{height:22px;background:#2E8B57;border-radius:2px}
.xstrip i.sl{background:#C3CCD8}.xstrip i.off{background:var(--danger)}
.xaxis{display:flex;justify-content:space-between;font-size:12px;color:var(--muted);margin-top:6px}
.xmore{display:block;margin:14px auto 0;border:0;background:none;font:inherit;font-size:14px;color:var(--signal);cursor:pointer}
</style>
</head>
<body>

<div class="mk-note">
  <b>Maquette</b> · Organisation, Statistiques et Historique allégées (mode Expert) — rien n'est codé
  <span class="grow"></span>
  <span>Page :</span>
  <span class="mk-seg" id="mk-page"><button type="button" class="mk-btn" data-v="org">Organisation</button><button type="button" class="mk-btn" data-v="stats">Statistiques</button><button type="button" class="mk-btn" data-v="hist">Historique</button></span>
  <span>Contenu :</span>
  <span class="mk-seg" id="mk-demo"><button type="button" class="mk-btn" data-v="full">rempli</button><button type="button" class="mk-btn" data-v="empty">vide</button></span>
</div>
<div class="mk-toast" id="toast"></div>

<div class="shell">
  <aside class="sidebar">
<!--BRAND-->
    <a href="#" class="nav"><i data-i="monitor"></i> Écrans <span class="nbadges"><span class="nbadge off">1</span></span></a>
    <a href="#" class="nav"><i data-i="list"></i> Listes de diffusion</a>
    <a href="#" class="nav"><i data-i="image"></i> Contenus</a>
    <a href="#" class="nav"><i data-i="cal"></i> Programmations</a>
    <div class="nav-sec"><button type="button" class="nav-sec-t open">Applications<svg class="chev" viewBox="0 0 24 24"><path d="M9 6l6 6-6 6"/></svg></button>
      <a href="#" class="nav-sec-btn" title="Gérer mes applications"><i data-i="sliders" data-s="15"></i></a><a href="#" class="nav-sec-btn" title="Ajouter une application (Store)"><i data-i="plus" data-s="16"></i></a></div>
    <div class="nav-sub"><a href="#" class="nav nav-app"><i data-i="sun"></i> Météo</a><a href="#" class="nav nav-app"><i data-i="cal"></i> Google Agenda</a></div>
    <div class="spacer"></div>
    <a href="#org" class="nav nav-min" data-p="org"><i data-i="team"></i> Organisation</a>
    <a href="#stats" class="nav nav-min" data-p="stats"><i data-i="chart"></i> Statistiques</a>
    <a href="#hist" class="nav nav-min" data-p="hist"><i data-i="clock"></i> Historique</a>
    <div class="nav-sep nav-sep-foot"></div>
    <button type="button" class="nav mode-switch"><svg class="mode-ic" viewBox="0 0 24 24"><path d="M4 7h16M4 12h16M4 17h10"/></svg><span>Mode expert</span><span class="switch on"><span></span></span></button>
  </aside>

  <div class="main-col">
    <header class="qbar" aria-label="Accès rapides">
      <nav class="hub-tabs qb-tabs" aria-label="Pages" id="tabs"></nav>
      <div class="grow"></div>
      <button type="button" class="qb-btn qb-ai"><i data-i="spark" data-s="19" data-c="ico-svg"></i><span>Assistant</span></button>
      <button type="button" class="qb-btn" aria-label="Installer le player"><i data-i="down" data-s="19" data-c="ico-svg"></i></button>
      <button type="button" class="qb-btn" aria-label="Aide"><i data-i="help" data-s="19" data-c="ico-svg"></i></button>
      <button type="button" class="qb-btn" aria-label="Notifications"><i data-i="bell" data-s="19" data-c="ico-svg"></i></button>
      <button type="button" class="qb-btn" aria-label="Réglages"><i data-i="gear" data-s="19" data-c="ico-svg"></i></button>
      <button type="button" class="qb-me" aria-label="Compte"><span class="avatar">LP</span><b>Horizon SA</b><i data-i="chev" data-s="14" data-c="ico-svg"></i></button>
    </header>
    <main class="content"><div id="page"></div></main>
  </div>
</div>

<script>
const IC = {
  monitor:'<rect x="2" y="3" width="20" height="14" rx="2"/><path d="M8 21h8M12 17v4"/>',
  list:'<path d="M8 6h13M8 12h13M8 18h13M3 6h.01M3 12h.01M3 18h.01"/>',
  image:'<rect x="3" y="3" width="18" height="18" rx="2"/><circle cx="8.5" cy="8.5" r="1.5"/><path d="M21 15l-5-5L5 21"/>',
  cal:'<rect x="3" y="5" width="18" height="16" rx="2"/><path d="M3 10h18M8 3v4M16 3v4"/>',
  sliders:'<path d="M4 21v-7M4 10V3M12 21v-9M12 8V3M20 21v-5M20 12V3M1 14h6M9 8h6M17 16h6"/>',
  plus:'<path d="M12 5v14M5 12h14"/>', x:'<path d="M18 6 6 18M6 6l12 12"/>',
  sun:'<circle cx="12" cy="12" r="4"/><path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4"/>',
  team:'<path d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M22 21v-2a4 4 0 0 0-3-3.87M16 3.13a4 4 0 0 1 0 7.75"/>',
  chart:'<path d="M3 3v18h18"/><path d="M7 15l4-4 3 3 6-6"/>',
  clock:'<circle cx="12" cy="12" r="9"/><path d="M12 7v5l3 2"/>',
  spark:'<path d="M12 3l1.9 5.6L19.5 10l-5.6 1.9L12 17.5l-1.9-5.6L4.5 10l5.6-1.4z"/>',
  down:'<rect x="2" y="3" width="20" height="14" rx="2"/><path d="M12 7v6M9.5 10.5L12 13l2.5-2.5M8 21h8"/>',
  help:'<circle cx="12" cy="12" r="9"/><path d="M9.2 9a3 3 0 0 1 5.8 1c0 2-3 2.5-3 4.5M12 17.5h.01"/>',
  bell:'<path d="M6 8a6 6 0 0 1 12 0c0 7 3 8 3 8H3s3-1 3-8M10 20a2 2 0 0 0 4 0"/>',
  gear:'<circle cx="12" cy="12" r="3"/><path d="M12 2v3M12 19v3M4.9 4.9l2.1 2.1M17 17l2.1 2.1M2 12h3M19 12h3M4.9 19.1 7 17M17 7l2.1-2.1"/>',
  chev:'<path d="m6 9 6 6 6-6"/>', right:'<path d="M9 6l6 6-6 6"/>',
  search:'<circle cx="11" cy="11" r="7"/><path d="m20 20-3.5-3.5"/>',
  dots:'<circle cx="5" cy="12" r="1.3"/><circle cx="12" cy="12" r="1.3"/><circle cx="19" cy="12" r="1.3"/>',
  grid:'<rect x="3" y="3" width="7" height="7" rx="1.5"/><rect x="14" y="3" width="7" height="7" rx="1.5"/><rect x="3" y="14" width="7" height="7" rx="1.5"/><rect x="14" y="14" width="7" height="7" rx="1.5"/>',
  rows:'<path d="M3 6h18M3 12h18M3 18h18"/>',
  lock:'<rect x="4" y="11" width="16" height="10" rx="2"/><path d="M8 11V7a4 4 0 0 1 8 0v4"/>',
  pin:'<path d="M12 21s7-6.2 7-11.5A7 7 0 0 0 5 9.5c0 5.3 7 11.5 7 11.5z"/><circle cx="12" cy="9.5" r="2.5"/>',
  box:'<path d="M21 8 12 3 3 8v8l9 5 9-5zM3 8l9 5 9-5M12 13v8"/>',
  edit:'<path d="M17 3a2.85 2.83 0 1 1 4 4L7.5 20.5 2 22l1.5-5.5Z"/>',
  mail:'<rect x="2" y="4" width="20" height="16" rx="2"/><path d="m2 7 10 6 10-6"/>',
  power:'<path d="M12 2v10M18.4 6.6a9 9 0 1 1-12.8 0"/>',
  trash:'<path d="M3 6h18M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6M8 6V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2"/>',
  dl:'<path d="M12 3v12M7 10l5 5 5-5"/><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/>',
  filter:'<path d="M3 5h18l-7 8v6l-4-2v-4z"/>',
  info:'<circle cx="12" cy="12" r="9"/><path d="M12 11v5M12 7.5h.01"/>'
};
const ico = (n, s = 18, c = '') => `<svg class="${c}" viewBox="0 0 24 24" width="${s}" height="${s}" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round">${IC[n]}</svg>`;
document.querySelectorAll('[data-i]').forEach(e => { e.outerHTML = ico(e.dataset.i, +(e.dataset.s || 18), e.dataset.c || ''); });
const $ = s => document.querySelector(s);
const pl = (n, a, b) => n + ' ' + (n > 1 ? (b || a + 's') : a);
const esc = s => String(s).replace(/[&<>"]/g, c => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;' }[c]));
let tt; const toast = m => { const t = $('#toast'); t.textContent = m; t.classList.add('on'); clearTimeout(tt); tt = setTimeout(() => t.classList.remove('on'), 2400); };

/* ---------- données de démonstration (génériques) ---------- */
const MEMBERS = () => [
  { id: 1, n: 'Ludovic Prieur', e: 'ludovic@horizon.example', adm: 1, me: 1 },
  { id: 2, n: 'Anne Morel', e: 'anne@horizon.example', adm: 1 },
  { id: 3, n: 'Marc Dubois', e: 'marc@horizon.example', scr: 5, where: 'Site de Lausanne' },
  { id: 4, n: 'Sofia Keller', e: 'sofia@horizon.example', ro: 1 },
  { id: 5, n: 'Paul Rey', e: 'paul@horizon.example', inv: 1, scr: 0 },
  { id: 6, n: 'Nina Favre', e: 'nina@horizon.example', scr: 2, where: 'Cafétéria', off: 1 }
];
const AREAS = () => [
  { id: 1, n: 'Site de Lausanne', who: ['MD', 'AM'], z: [['Accueil', 3], ['Cafétéria', 2], ['Mur du hall', 4, 'Mur']] },
  { id: 2, n: 'Site de Genève', who: ['AM'], z: [['Défaut', 2], ['Salles de réunion', 3, 'Synchronisée']] },
  { id: 3, n: 'Entrepôt', who: [], z: [] }
];
const TOP = [['Menu de la semaine', 'Image', 412, '5 h 43'], ['Film de présentation', 'Vidéo', 388, '4 h 51'], ['Météo', 'Application', 301, '2 h 30'], ['Agenda de juin', 'Application', 244, '2 h 02'], ['Promotions', 'Composition', 198, '1 h 39']];
const BARS = [['lun.', 62], ['mar.', 71], ['mer.', 58], ['jeu.', 80], ['ven.', 100], ['sam.', 34], ['dim.', 22]];
const SCREENS = [['Accueil', 'Site de Lausanne', 1, 'Menu du jour', 412, 'à l\'instant'], ['Hall', 'Site de Lausanne', 1, 'Promotions', 388, 'à l\'instant', 1], ['Vitrine', 'Site de Genève', 1, 'Promotions', 301, 'il y a 1 min'], ['Réserve', 'Entrepôt', 0, 'Consignes', 96, 'il y a 8 h'], ['Salle Léman', 'Site de Genève', 1, 'Accueil visiteurs', 244, 'à l\'instant']];
const EVENTS = () => [
  { tab: 'act', day: "Aujourd'hui", t: '14:32', l: 'ok', cat: 'Publication', ti: 'Liste « Promotions » publiée sur 2 écrans', who: 'Anne Morel' },
  { tab: 'act', day: "Aujourd'hui", t: '11:05', l: '', cat: 'Contenus', ti: 'Média « Affiche soldes » importé', who: 'Marc Dubois' },
  { tab: 'act', day: "Aujourd'hui", t: '09:48', l: '', cat: 'Écrans', ti: 'Écran « Vitrine » renommé', sub: 'Vitrine rue → Vitrine', who: 'Ludovic Prieur' },
  { tab: 'act', day: 'Hier', t: '17:20', l: '', cat: 'Membres', ti: 'Paul Rey invité', who: 'Ludovic Prieur' },
  { tab: 'act', day: 'Hier', t: '08:02', l: 'ok', cat: 'Publication', ti: 'Liste « Menu du jour » publiée sur 1 écran', who: 'Marc Dubois' },
  { tab: 'ecr', day: "Aujourd'hui", t: '06:31', l: 'error', cat: 'Hors ligne', ti: 'Réserve est hors ligne', sub: 'Dernier contact à 06:28', who: 'Réserve' },
  { tab: 'ecr', day: "Aujourd'hui", t: '06:00', l: 'ok', cat: 'Veille', ti: 'Accueil s\'est réveillé à l\'heure', sub: 'Prévu 06:00, constaté 06:00', who: 'Accueil' },
  { tab: 'ecr', day: 'Hier', t: '22:00', l: '', cat: 'Veille', ti: 'Accueil est passé en veille', sub: 'Prévu 22:00, constaté 22:00', who: 'Accueil' },
  { tab: 'ecr', day: 'Hier', t: '15:12', l: 'warn', cat: 'Player', ti: 'Hall : player mis à jour', sub: '1.8.2 → 1.9.0', who: 'Hall' },
  { tab: 'diag', day: "Aujourd'hui", t: '06:31', l: 'error', cat: 'Écrans', ti: 'Réserve ne répond plus', sub: 'Aucun contact depuis 3 min', who: 'Réserve' },
  { tab: 'diag', day: "Aujourd'hui", t: '03:10', l: 'warn', cat: 'Synchronisation', ti: 'Google Agenda : synchronisation lente', sub: '12 s au lieu de 2 s', who: 'Google Agenda' },
  { tab: 'diag', day: 'Hier', t: '19:44', l: 'error', cat: 'Veille', ti: 'Réveil non confirmé : Vitrine', sub: 'Prévu 19:40, aucun signal', who: 'Vitrine' },
  { tab: 'diag', day: 'Hier', t: '10:02', l: 'warn', cat: 'Player', ti: 'Hall : espace disque faible', sub: '8 % libres', who: 'Hall' }
];
const CATS = { act: ['Publication', 'Contenus', 'Écrans', 'Membres'], ecr: ['Hors ligne', 'Veille', 'Player'], diag: ['Écrans', 'Synchronisation', 'Veille', 'Player'] };
const PERIODS = { stats: [['today', "Aujourd'hui"], ['7', '7 jours'], ['30', '30 jours']], hist: [['today', "Aujourd'hui"], ['7', '7 jours'], ['30', '30 jours'], ['90', '90 jours']] };
const TABS = {
  org: [['people', 'Membres'], ['areas', 'Aires']],
  stats: [['vue', "Vue d'ensemble"], ['diff', 'Diffusion'], ['ecr', 'Écrans'], ['qr', 'Scans QR'], ['bor', 'Bornes'], ['pub', 'Publicité']],
  hist: [['act', 'Activité'], ['ecr', 'Écrans'], ['diag', 'Diagnostic']]
};

/* ---------- état ---------- */
const S = { page: (location.hash || '#org').slice(1), tab: { org: 'people', stats: 'vue', hist: 'act' }, view: { people: 'cards', areas: 'cards' }, period: { stats: '7', hist: '7' },
  f: null, q: '', qOpen: false, menu: null, pop: null, cat: null, scr: '', empty: false, openA: { 1: true } };
if (!TABS[S.page]) S.page = 'org';
let M = MEMBERS(), A = AREAS(), E = EVENTS();
const ini = n => n.split(' ').map(x => x[0]).join('').slice(0, 2).toUpperCase();
const reset = () => { S.f = null; S.q = ''; S.qOpen = false; S.menu = null; S.pop = null; S.cat = null; S.scr = ''; };

/* ---------- briques communes ---------- */
const f = (k, label, cls = '') => `<span>·</span><button type="button" class="xf ${cls} ${S.f === k ? 'on' : ''}" data-a="f" data-k="${k}">${label}${S.f === k ? ico('x', 13) : ''}</button>`;
const search = ph => `<label class="xq ${S.qOpen ? 'on' : ''}">${ico('search', 16)}<input id="q" placeholder="${ph}" value="${esc(S.q)}"></label>${S.qOpen ? '' : `<button type="button" class="xib" data-a="q" title="Rechercher">${ico('search', 18)}</button>`}`;
const toggle = k => `<button type="button" class="xib" data-a="view" data-k="${k}" title="${S.view[k] === 'cards' ? 'Afficher en liste' : 'Afficher en cartes'}">${ico(S.view[k] === 'cards' ? 'rows' : 'grid', 18)}</button>`;
const periods = p => PERIODS[p].map((x, i) => `${i ? '<span>·</span>' : ''}<button type="button" class="xf ${S.period[p] === x[0] ? 'on' : 'mu'}" data-a="per" data-k="${x[0]}">${x[1]}</button>`).join('');
const info = t => `<span class="xinfo" data-t="${esc(t)}">${ico('info', 15)}</span>`;
const dots = (id, items) => `<span class="xkw"><button type="button" class="xdots ${S.menu === id ? 'on' : ''}" data-a="menu" data-k="${id}" aria-label="Actions">${ico('dots', 18)}</button>${S.menu === id ? `<div class="xpop">${items.map(i => i === '-' ? '<hr>' : `<button type="button" class="${i[3] || ''}" data-a="do" data-t="${esc(i[2])}">${ico(i[0], 16)}${i[1]}</button>`).join('')}</div>` : ''}</span>`;
const head = (title, meta, acts) => `<div class="xh"><div><h1>${title}</h1><p class="xm">${meta}</p></div><div class="xa">${acts}</div></div>`;

/* ---------- Organisation ---------- */
function mLine(m) {
  if (m.adm) return ['Administrateur', 'Voit et gère tout'];
  if (m.ro) return [`${ico('lock', 14)} Lecture seule`, 'Voit tout, ne modifie rien'];
  if (!m.scr) return ['Utilisateur', '<span style="color:var(--warn-ink)">Aucun écran attribué</span>'];
  return ['Utilisateur', `${pl(m.scr, 'écran')} · ${m.where} · ses médias et ses listes`];
}
const mTag = m => m.me ? '<span class="xtag">Vous</span>' : m.inv ? '<span class="xtag pe">En attente</span>' : m.off ? '<span class="xtag">Désactivé</span>' : '';
const mMenu = m => dots('m' + m.id, [['edit', 'Modifier', `Ouvre la fiche de ${m.n}`]].concat(m.inv ? [['mail', "Renvoyer l'invitation", `Invitation renvoyée à ${m.e}`]] : []).concat(m.me ? [] : [['power', m.off ? 'Réactiver' : 'Désactiver', `${m.n} : ${m.off ? 'réactivé' : 'désactivé'}`]]));
function people() {
  const all = S.empty ? M.slice(0, 1) : M, adm = all.filter(m => m.adm).length, inv = all.filter(m => m.inv).length, off = all.filter(m => m.off).length;
  const list = all.filter(m => (!S.q || (m.n + m.e).toLowerCase().includes(S.q.toLowerCase())) && (S.f !== 'adm' || m.adm) && (S.f !== 'usr' || !m.adm) && (S.f !== 'inv' || m.inv) && (S.f !== 'off' || m.off));
  let h = head('Membres', `<span>${pl(all.length, 'membre')}</span>${adm && adm < all.length ? f('adm', pl(adm, 'administrateur')) + f('usr', pl(all.length - adm, 'utilisateur')) : ''}${inv ? f('inv', inv + ' en attente', 'pe') : ''}${off ? f('off', pl(off, 'désactivé'), 'mu') : ''}`,
    search('Nom ou e-mail') + toggle('people') + `<button type="button" class="btn xadd" data-a="do" data-t="Ouvre la fiche « Nouveau membre »">${ico('plus', 16)} Ajouter</button>`);
  if (!list.length) return h + '<div class="xnone">Aucun résultat</div>';
  if (S.view.people === 'cards') h += `<div class="xgrid">${list.map(m => { const l = mLine(m); return `<div class="xcard ${m.off ? 'dim' : ''}" data-a="do" data-t="Ouvre la fiche de ${m.n}">${mMenu(m)}
      <div class="xwho"><span class="avatar ${m.inv ? 'inv' : m.off ? 'off' : ''}">${ini(m.n)}</span><div class="xnm"><b>${m.n}${mTag(m)}</b><small>${m.inv ? 'Invitation envoyée' : m.e}</small></div></div>
      <div class="xline">${l[0]}</div><div class="xline mu">${l[1]}</div></div>`; }).join('')}</div>`;
  else h += `<div class="xlist">${list.map(m => { const l = mLine(m); return `<div class="xrow ${m.off ? 'dim' : ''}" data-a="do" data-t="Ouvre la fiche de ${m.n}">
      <div class="c1 xwho"><span class="avatar ${m.inv ? 'inv' : m.off ? 'off' : ''}">${ini(m.n)}</span><div class="xnm"><b>${m.n}${mTag(m)}</b><small>${m.inv ? 'Invitation envoyée' : m.e}</small></div></div>
      <div class="c2">${l[0]}</div><div class="c3">${l[1]}</div>${mMenu(m)}</div>`; }).join('')}</div>`;
  if (all.length === 1) h += `<div class="xempty" style="margin-top:14px"><b>Vous êtes seul dans l'organisation</b>Ajoutez un membre pour lui confier des écrans et partager vos médias et vos listes.<br><button type="button" class="btn" style="margin-top:12px" data-a="do" data-t="Ouvre la fiche « Nouveau membre »">${ico('plus', 16)} Ajouter un membre</button></div>`;
  return h;
}
const zIcon = z => ico(z[2] === 'Mur' ? 'monitor' : 'box', 15);
const aMenu = a => dots('a' + a.id, [['edit', 'Modifier', `Ouvre la fiche de l'aire ${a.n}`], ['plus', 'Ajouter une zone', `Ouvre la fiche de l'aire ${a.n}, sur les zones`], '-', ['trash', 'Supprimer', 'Une aire ne se supprime que sans écran', 'bad']]);
function areas() {
  const all = S.empty ? [] : A, zs = all.reduce((n, a) => n + a.z.length, 0), sc = all.reduce((n, a) => n + a.z.reduce((x, z) => x + z[1], 0), 0);
  const list = all.filter(a => !S.q || (a.n + a.z.map(z => z[0]).join(' ')).toLowerCase().includes(S.q.toLowerCase()));
  let h = head('Aires', all.length ? `<span>${pl(all.length, 'aire')}</span><span>·</span><span>${pl(zs, 'zone')}</span><span>·</span><span>${pl(sc, 'écran')}</span>${info('Les aires et les zones rangent les écrans. Elles ne donnent aucun droit : on attribue des zones ou des écrans à une personne depuis sa fiche.')}` : '<span>Aucune aire</span>',
    (all.length ? search('Aire ou zone') + toggle('areas') : '') + `<button type="button" class="btn xadd" data-a="do" data-t="Ouvre la fenêtre « Nouvelle aire »">${ico('plus', 16)} Ajouter</button>`);
  if (!all.length) return h + `<div class="xempty"><b>Rangez vos écrans par lieu</b>Une aire regroupe les écrans d'un site ; ses zones les classent.<br><button type="button" class="btn" style="margin-top:12px" data-a="do" data-t="Ouvre la fenêtre « Nouvelle aire »">${ico('plus', 16)} Nouvelle aire</button></div>`;
  if (!list.length) return h + '<div class="xnone">Aucun résultat</div>';
  const sum = a => { const n = a.z.reduce((x, z) => x + z[1], 0); return `${pl(a.z.length, 'zone')} · ${n ? pl(n, 'écran') : 'aucun écran'}`; };
  const avs = a => `<span class="xavs">${a.who.map(w => `<span class="avatar">${w}</span>`).join('')}</span>`;
  if (S.view.areas === 'cards') return h + `<div class="xgrid wide">${list.map(a => `<div class="xcard" data-a="do" data-t="Ouvre la fiche de l'aire ${a.n}">${aMenu(a)}
      <div class="xah">${ico('pin', 18)}<div class="xnm"><b>${a.n}</b><small>${sum(a)}</small></div>${avs(a)}</div>
      <div class="xzl">${a.z.map(z => `<div class="xz">${zIcon(z)}<span>${z[0]}</span>${z[2] ? `<small>${z[2]}</small>` : ''}<span class="n">${pl(z[1], 'écran')}</span></div>`).join('') || '<div class="xz"><small>Aucune zone pour l\'instant</small></div>'}</div></div>`).join('')}</div>`;
  return h + `<div class="xlist">${list.map(a => `<div class="xrow" data-a="openA" data-k="${a.id}">${ico('right', 14, 'xchev ' + (S.openA[a.id] ? 'open' : ''))}
      <div class="c1 xah">${ico('pin', 17)}<b>${a.n}</b></div><div class="c3">${sum(a)}</div>${avs(a)}${aMenu(a)}</div>` +
      (S.openA[a.id] ? a.z.map(z => `<div class="xrow sub" data-a="do" data-t="Ouvre la fiche de l'aire ${a.n}">${zIcon(z)}<span>${z[0]}</span>${z[2] ? `<small style="color:var(--muted)">${z[2]}</small>` : ''}<span class="num" style="margin-left:auto;color:var(--muted)">${pl(z[1], 'écran')}</span></div>`).join('') : '')).join('')}</div>`;
}

/* ---------- Statistiques ---------- */
function stats() {
  const t = S.tab.stats, none = S.empty;
  const bars = d => `<div class="xbars">${d.map(b => `<div title="${b[1] * 4} passages"><i style="height:${none ? 0 : b[1]}%"></i>${b[0]}</div>`).join('')}</div>`;
  const scrF = `<span>·</span><span class="xkw" style="position:relative"><button type="button" class="xf ${S.scr ? 'on' : ''}" data-a="pop" data-k="scr">${S.scr || 'Tous les écrans'}${ico(S.scr ? 'x' : 'chev', 13)}</button>${S.pop === 'scr' ? `<div class="xpop" style="left:0;right:auto;top:28px"><button type="button" class="${S.scr ? '' : 'on'}" data-a="scr" data-k="">Tous les écrans</button>${SCREENS.map(s => `<button type="button" class="${S.scr === s[0] ? 'on' : ''}" data-a="scr" data-k="${s[0]}">${s[0]}</button>`).join('')}</div>` : ''}</span>`;
  if (t === 'vue') return head('Statistiques', periods('stats'), '') + `<div class="xk"><div><b>${none ? 0 : '1 708'}</b><span>Passages diffusés</span></div><div><b>${none ? '0 h' : '18 h 45'}</b><span>Temps d'affichage</span></div>
      <div class="ok"><b>${none ? 0 : 4}<small> / ${none ? 0 : 5}</small></b><span>Écrans en ligne</span></div>${none ? '' : '<div class="bad"><b>1</b><span>Hors ligne maintenant</span></div>'}</div>
    <div class="x2"><section class="xc"><h3>Passages par jour</h3>${bars(BARS)}</section>
    <section class="xc"><h3>Contenus les plus diffusés</h3>${none ? '<p class="xnone" style="padding:50px 0">Aucune diffusion sur cette période</p>' : `<div class="xtop">${TOP.map(c => `<div>${c[0]}<span>${c[2]}</span><i><u style="width:${c[2] / 4.12}%"></u></i></div>`).join('')}</div>`}</section></div>`;
  if (t === 'diff') return head('Diffusion', periods('stats') + scrF + info('Un passage est un contenu affiché en entier. Une veille, une coupure ou une pause réduit le temps compté.'), '') +
    (none ? '<div class="xempty"><b>Aucune diffusion sur cette période</b>Les écrans envoient leur historique chaque minute ; un écran hors ligne l\'envoie à son retour.</div>'
      : `<div class="xlist"><div class="xrow head"><div class="c1">Contenu</div><div class="c2">Type</div><div class="num">Passages</div><div class="num">Temps</div><div class="xbar" style="background:none"></div></div>${TOP.map(c => `<div class="xrow" style="cursor:default"><div class="c1"><b style="font-weight:500">${c[0]}</b></div><div class="c2" style="color:var(--muted)">${c[1]}</div><div class="num">${c[2]}</div><div class="num">${c[3]}</div><div class="xbar"><u style="width:${c[2] / 4.12}%"></u></div></div>`).join('')}</div>`);
  if (t === 'ecr') return head('Écrans', `<span>${none ? 'Aucun écran connecté' : '5 écrans'}</span>${none ? '' : f('off', '1 hors ligne', 'bad') + f('pend', '1 à publier', 'pe')}`, '') +
    (none ? '<div class="xempty"><b>Aucun écran connecté pour l\'instant</b>L\'état de vos écrans apparaîtra ici.</div>'
      : `<div class="xlist"><div class="xrow head"><div class="c1">Écran</div><div class="c2">État</div><div class="c3">Liste de lecture</div><div class="num">Passages</div><div class="num" style="flex-basis:130px">Dernier contact</div></div>${SCREENS.filter(s => (S.f !== 'off' || !s[2]) && (S.f !== 'pend' || s[6])).map(s => `<div class="xrow" data-a="do" data-t="Ouvre l'écran ${s[0]}">
        <div class="c1 xnm"><b style="font-weight:500">${s[0]}</b><small>${s[1]}</small></div><div class="c2"><span class="xst ${s[2] ? '' : 'off'}">${s[2] ? 'En ligne' : 'Hors ligne'}</span></div>
        <div class="c3">${s[3]}${s[6] ? ' <span style="color:var(--warn-ink);font-weight:500">· à publier</span>' : ''}</div><div class="num">${s[4]}</div><div class="num" style="flex-basis:130px;color:var(--muted);font-size:13.5px">${s[5]}</div></div>`).join('')}</div>`);
  if (t === 'qr') return head('Scans QR', periods('stats') + info("Taux de scan = scans ÷ passages du contenu sur la période. Le comptage ignore les robots et les doubles scans dans les 10 secondes. Aucune adresse IP n'est conservée."), '') +
    `<div class="xk"><div><b>${none ? 0 : 146}</b><span>Scans</span></div><div><b>${none ? 0 : 118}</b><span>Visiteurs estimés</span></div><div><b>${none ? '—' : '3,4 %'}</b><span>Taux de scan</span></div><div><b style="font-size:20px;padding-top:9px">${none ? '—' : 'horizon.example'}</b><span>Destination la plus visitée</span></div></div>
    <div class="x2"><section class="xc"><h3>Scans par jour</h3>${bars(BARS.map(b => [b[0], Math.round(b[1] * .7)]))}</section>
    <section class="xc"><h3>Par contenu</h3>${none ? '<p class="xnone" style="padding:50px 0">Aucun contenu avec un QR code actif</p>' : `<div class="xtop">${[['Promotions', 82, '4,1 %'], ['Menu de la semaine', 51, '2,9 %'], ['Agenda de juin', 13, '1,2 %']].map(c => `<div>${c[0]}<span>${c[1]} · ${c[2]}</span><i><u style="width:${c[1] / .82}%"></u></i></div>`).join('')}</div>`}</section></div>`;
  return head(t === 'bor' ? 'Bornes' : 'Publicité', periods('stats'), '') + `<div class="xempty"><b>Même gabarit que « Vue d'ensemble » et « Scans QR »</b>Quatre chiffres sans cadre, puis deux blocs. ${t === 'bor' ? 'Le choix de la borne passe dans la ligne sous le titre.' : 'Les relevés mensuels deviennent des lignes, comme l\'onglet Diffusion.'}</div>`;
}

/* ---------- Historique ---------- */
function hist() {
  const t = S.tab.hist, all = S.empty ? [] : E.filter(e => e.tab === t);
  const err = all.filter(e => e.l === 'error').length, warn = all.filter(e => e.l === 'warn').length;
  const list = all.filter(e => (!S.q || (e.ti + (e.sub || '') + e.who).toLowerCase().includes(S.q.toLowerCase())) && (!S.cat || e.cat === S.cat) && (S.f !== 'err' || e.l === 'error') && (S.f !== 'warn' || e.l === 'warn') && (!S.scr || e.who === S.scr));
  const whoLab = t === 'act' ? 'Membre' : 'Écran', whos = [...new Set(all.map(e => e.who))];
  const filt = `<span class="xkw" style="position:relative"><button type="button" class="xib ${S.pop === 'filt' ? 'on' : ''}" data-a="pop" data-k="filt" title="Filtrer">${ico('filter', 18)}${S.cat || S.scr ? '<i class="dot"></i>' : ''}</button>${S.pop === 'filt' ? `<div class="xpop" style="top:46px"><div class="lab">Catégorie</div><button type="button" class="${S.cat ? '' : 'on'}" data-a="cat" data-k="">Tout</button>${CATS[t].map(c => `<button type="button" class="${S.cat === c ? 'on' : ''}" data-a="cat" data-k="${c}">${c}</button>`).join('')}
      ${t === 'diag' ? '' : `<hr><div class="lab">${whoLab}</div><button type="button" class="${S.scr ? '' : 'on'}" data-a="scr" data-k="">Tous</button>${whos.map(w => `<button type="button" class="${S.scr === w ? 'on' : ''}" data-a="scr" data-k="${w}">${w}</button>`).join('')}`}</div>` : ''}</span>`;
  const chips = (S.cat ? `<span>·</span><button type="button" class="xf on" data-a="cat" data-k="">${S.cat}${ico('x', 13)}</button>` : '') + (S.scr ? `<span>·</span><button type="button" class="xf on" data-a="scr" data-k="">${S.scr}${ico('x', 13)}</button>` : '');
  let h = head('Historique', periods('hist') + (t === 'diag' && err ? f('err', pl(err, 'erreur'), 'bad') : '') + (t === 'diag' && warn ? f('warn', pl(warn, 'avertissement'), 'pe') : '') + chips + info('Conservation : 90 jours pour l\'activité et les écrans, 30 jours pour le diagnostic. Aucun mot de passe ni jeton n\'est enregistré.'),
    search('Rechercher') + filt + `<button type="button" class="xib" data-a="do" data-t="Télécharge historique.csv" title="Exporter en CSV">${ico('dl', 18)}</button>`);
  if (t === 'ecr' && S.scr && !S.empty) h += `<section class="xc" style="margin-bottom:14px"><h3>${S.scr} · disponibilité, dernières 24 h</h3><div class="xstrip">${Array.from({ length: 48 }, (_, i) => `<i class="${i > 3 && i < 20 ? 'sl' : S.scr === 'Réserve' && i > 30 ? 'off' : ''}"></i>`).join('')}</div><div class="xaxis"><span>-24 h</span><span>-18 h</span><span>-12 h</span><span>-6 h</span><span>maintenant</span></div></section>`;
  if (!all.length) return h + '<div class="xempty"><b>Rien à afficher</b>Aucun événement sur cette période.</div>';
  if (!list.length) return h + '<div class="xnone">Aucun résultat</div>';
  const days = [...new Set(list.map(e => e.day))];
  return h + days.map(d => `<div class="xday">${d}</div><div class="xlist">${list.filter(e => e.day === d).map(e => `<div class="xev" data-a="do" data-t="Ouvre le détail : ${esc(e.ti)}"><span class="t">${e.t}</span><span class="d ${e.l}"></span>
      <div class="w"><b>${e.ti}</b>${e.sub ? `<small>${e.sub}</small>` : ''}</div><span class="who">${t === 'diag' ? e.cat : e.who}</span></div>`).join('')}</div>`).join('') + (S.empty ? '' : '<button type="button" class="xmore" data-a="do" data-t="Affiche les 50 lignes suivantes">Afficher la suite</button>');
}

/* ---------- rendu et interactions ---------- */
function render() {
  const p = S.page;
  document.querySelectorAll('.sidebar [data-p]').forEach(a => a.classList.toggle('active', a.dataset.p === p));
  document.querySelectorAll('#mk-page .mk-btn').forEach(b => b.classList.toggle('on', b.dataset.v === p));
  document.querySelectorAll('#mk-demo .mk-btn').forEach(b => b.classList.toggle('on', (b.dataset.v === 'empty') === S.empty));
  $('#tabs').innerHTML = TABS[p].map(t => `<a href="#" class="hub-tab ${S.tab[p] === t[0] ? 'active' : ''}" data-a="tab" data-k="${t[0]}">${t[1]}${p === 'hist' && t[0] === 'diag' && !S.empty ? ' <span class="nbadge red">2</span>' : ''}${p === 'stats' && t[0] === 'pub' ? '' : ''}</a>`).join('');
  $('#page').innerHTML = p === 'org' ? (S.tab.org === 'people' ? people() : areas()) : p === 'stats' ? stats() : hist();
}
function go(p) { S.page = p; reset(); history.replaceState(null, '', '#' + p); render(); scrollTo(0, 0); }
document.addEventListener('click', e => {
  const seg = e.target.closest('#mk-page, #mk-demo'), b = e.target.closest('.mk-btn');
  if (seg && b) { if (seg.id === 'mk-page') go(b.dataset.v); else { S.empty = b.dataset.v === 'empty'; reset(); render(); } return; }
  const nav = e.target.closest('.sidebar [data-p]');
  if (nav) { e.preventDefault(); go(nav.dataset.p); return; }
  if (e.target.closest('.sidebar a, .qbar button')) { e.preventDefault(); if (e.target.closest('.sidebar a')) toast('Hors maquette'); return; }
  if (e.target.closest('#q')) return;
  const a = e.target.closest('[data-a]'), hadMenu = S.menu, hadPop = S.pop; S.menu = null; S.pop = null;
  if (!a) { if (hadMenu || hadPop) render(); return; }
  e.preventDefault();
  const k = a.dataset.k;
  switch (a.dataset.a) {
    case 'tab': S.tab[S.page] = k; reset(); break;
    case 'f': S.f = S.f === k ? null : k; break;
    case 'per': S.period[S.page] = k; break;
    case 'view': S.view[k] = S.view[k] === 'cards' ? 'list' : 'cards'; break;
    case 'q': S.qOpen = true; render(); $('#q').focus(); return;
    case 'menu': S.menu = hadMenu === k ? null : k; break;
    case 'pop': S.pop = hadPop === k ? null : k; break;
    case 'cat': S.cat = k || null; break;
    case 'scr': S.scr = k; break;
    case 'openA': S.openA[k] = !S.openA[k]; break;
    case 'do': toast(a.dataset.t); break;
  }
  render();
});
document.addEventListener('input', e => { if (e.target.id === 'q') { S.q = e.target.value; const p = e.target.selectionStart; render(); const n = $('#q'); n.focus(); n.setSelectionRange(p, p); } });
document.addEventListener('keydown', e => { if (e.target.id === 'q' && e.key === 'Escape') { S.q = ''; S.qOpen = false; render(); } });
document.addEventListener('focusout', e => { if (e.target.id === 'q' && !S.q) { S.qOpen = false; setTimeout(render); } });
addEventListener('scroll', () => document.documentElement.classList.toggle('page-scrolled', scrollY > 6), { passive: true });
render();
</script>
</body>
</html>
