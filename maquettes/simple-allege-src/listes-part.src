</style>
<style>
/* ===== bandeau de la maquette (hors application) ===== */
.mk-note{position:fixed;left:0;right:0;top:0;z-index:2000;height:42px;display:flex;align-items:center;gap:12px;background:#fff;border-bottom:1px dashed var(--line-2);padding:0 16px;color:var(--muted);font-size:13px;white-space:nowrap;overflow-x:auto}
.mk-note b{color:var(--ink);font-weight:500}
.mk-note .grow{flex:1}
.mk-btn{border:1px solid var(--line-2);background:#fff;border-radius:6px;padding:4px 11px;font:inherit;font-size:13px;cursor:pointer;color:var(--ink)}
.mk-btn.on{background:var(--ink);border-color:var(--ink);color:#fff}
.mk-seg{display:inline-flex}
.mk-seg .mk-btn:first-child{border-radius:6px 0 0 6px}
.mk-seg .mk-btn:last-child{border-radius:0 6px 6px 0;border-left:0}
body{padding-top:42px}
.shell{min-height:calc(100vh - 42px)}
.sidebar{top:42px;height:calc(100vh - 42px)}
.qbar{top:42px}
.mk-toast{position:fixed;left:50%;bottom:26px;transform:translateX(-50%);background:var(--ink);color:#fff;border-radius:8px;padding:10px 16px;font-size:14px;opacity:0;transition:opacity .2s;z-index:3000;pointer-events:none}
.mk-toast.on{opacity:1}
.es-mode{margin-top:auto}
.hub-tabs{overflow-y:hidden}
.es-mode .switch{flex:none !important;width:38px !important;height:22px;margin-left:auto}

/* ===== en-tête allégé (même base que la page Écrans allégée) ===== */
.es-head{display:flex;align-items:flex-end;justify-content:space-between;gap:16px;flex-wrap:wrap;margin-bottom:22px}
.es-head h1{font-size:28px;line-height:1.2;letter-spacing:-.01em}
.es-meta{font-size:14px;color:var(--muted);margin-top:4px;display:flex;flex-wrap:wrap;gap:6px;align-items:center}
.es-f{border:0;background:none;padding:1px 6px;margin:0 -6px;border-radius:6px;font:inherit;font-weight:500;cursor:pointer;display:inline-flex;align-items:center;gap:5px;color:var(--ink)}
.es-f.pe{color:var(--warn-ink)}
.es-f:hover{background:var(--row)}
.es-f.on{background:var(--ink);color:#fff;margin:0;padding:1px 9px;border-radius:99px}
.es-act{display:flex;align-items:center;gap:10px;position:relative}
.es-ib{width:40px;height:40px;border-radius:10px;border:1px solid var(--line-2);background:#fff;color:var(--ink);display:grid;place-items:center;cursor:pointer;position:relative;padding:0}
.es-ib:hover:not(:disabled){border-color:var(--muted);background:var(--row)}
.es-ib:disabled{opacity:.45;cursor:default}
.es-ib.pub{background:var(--warn);border-color:var(--warn);color:#fff}
.es-ib.pub:hover{background:var(--warn-ink);border-color:var(--warn-ink)}
.es-cnt{position:absolute;right:-7px;top:-7px;min-width:18px;height:18px;border-radius:9px;background:var(--ink);color:#fff;font:500 11px/18px var(--mono);text-align:center;padding:0 4px;box-sizing:border-box}
.es-q{display:flex;align-items:center;gap:8px;height:40px;width:0;opacity:0;overflow:hidden;border:1px solid var(--line-2);border-radius:10px;background:#fff;color:var(--muted);padding:0;box-sizing:border-box;transition:width .18s,opacity .18s,padding .18s}
.es-q.on{width:230px;opacity:1;padding:0 10px}
.es-q input{flex:1;min-width:0;border:0;box-shadow:none;background:none;padding:0;font:inherit}
.es-q input:focus{box-shadow:none;outline:0}
.es-add{height:40px;border-radius:10px}
.es-menu{position:absolute;right:0;top:calc(100% + 6px)}
.es-menu[hidden]{display:none}

/* ===== cartes ===== */
.lc-grid{display:grid;grid-template-columns:repeat(auto-fill,minmax(252px,1fr));gap:18px}
.lc{background:#fff;border:1px solid #DDE3EA;border-radius:14px;position:relative;min-width:0;transition:box-shadow .15s,border-color .15s}
.lc:hover{box-shadow:0 8px 22px rgba(11,31,58,.09);border-color:#CFD7E2}
.lc:has(.kebab-menu){z-index:42}
.lc-cov{position:relative;aspect-ratio:16/9;border-radius:13px 13px 0 0;overflow:hidden;background:#0E1726;cursor:pointer}
.lc-cov.none{display:flex;align-items:center;justify-content:center;gap:6px;background:repeating-linear-gradient(45deg,#F2F4F7 0 10px,#EDF0F4 10px 20px);color:var(--muted);font-size:13px}
.lc-art{position:absolute;inset:0}
.lc .lx-play{opacity:0}
.lc:hover .lx-play{opacity:1}
.lc-stat{position:absolute;left:10px;bottom:10px;z-index:3;display:inline-flex;align-items:center;gap:6px;padding:3px 10px 3px 8px;border-radius:999px;background:rgba(255,255,255,.92);backdrop-filter:blur(6px);font-size:12px;font-weight:500;color:#0B1F3A;box-shadow:0 1px 3px rgba(11,31,58,.14)}
.lc-stat .d{width:8px;height:8px;border-radius:50%;background:#2E8B57;flex:none}
.lc-stat.off .d{background:#9AA7B6}
.lc-by{position:absolute;right:10px;bottom:10px;z-index:3;display:inline-flex;align-items:center;gap:5px;padding:3px 9px;border-radius:999px;background:rgba(14,23,38,.82);color:#fff;font-size:12px}
.lc-bd{padding:12px 14px}
.lc-nm{display:flex;align-items:center;gap:8px;min-width:0}
.lc-name{flex:1;min-width:0;font-size:15px;font-weight:500;color:#0B1F3A;white-space:nowrap;overflow:hidden;text-overflow:ellipsis;cursor:pointer}
.lc-row{display:flex;align-items:center;gap:6px;min-height:30px;margin-top:4px}
.lc-m{flex:1;min-width:0;color:#5A6B80;font-size:13px;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
.lc-kw{position:relative;flex:none;margin:-4px -6px -4px 0}
.lc-kw > .kebab-btn{width:30px;height:30px;border:0;border-radius:8px;color:#5A6B80;background:none;display:grid;place-items:center;cursor:pointer;padding:0}
.lc-kw > .kebab-btn:hover,.lc-kw.open > .kebab-btn{background:#EEF1F5;color:#0B1F3A}
.lc-kw > .kebab-menu{top:34px;width:230px;min-width:0;padding:6px;border:1px solid #DDE3EA;border-radius:12px;box-shadow:0 14px 34px rgba(11,31,58,.18)}
.lc-kw > .kebab-menu button{gap:10px;padding:7px 10px;border-radius:8px;font-size:13px}
.lc-kw > .kebab-menu hr{margin:4px 6px;width:auto;border:0;border-top:1px solid #DDE3EA}
.es-pb{flex:none;width:30px;height:30px;border-radius:50%;border:0;background:#E8872B;color:#fff;display:grid;place-items:center;cursor:pointer;padding:0}
.es-pb:hover{background:#D4741C}
/* allégée : ⋯ au survol, nom renommable en place */
.v-new .lc-kw{opacity:0;transition:opacity .12s}
.v-new .lc:hover .lc-kw,.v-new .lc-kw.open{opacity:1}
.v-new .lc-name{cursor:text;border-radius:5px;padding:1px 5px;margin-left:-5px}
.v-new .lc-name:hover{background:var(--row);box-shadow:0 0 0 1px var(--line-2)}
.es-ni{flex:1;min-width:0;font:inherit;font-size:15px;font-weight:500;border:0;outline:2px solid var(--signal);border-radius:5px;padding:1px 5px;margin-left:-5px;background:#fff;box-shadow:none}
/* aujourd'hui : lignes d'état sous le nom */
.lc-st{display:flex;align-items:center;gap:6px;font-size:12.5px;color:#5A6B80;margin-top:2px}
.lc-st .d{width:7px;height:7px;border-radius:50%;background:#2E8B57}
.lc-st.pe{color:#9A530C}.lc-st.pe .d{background:#E8872B}
.lc-st.off .d{background:#9AA7B6}
.lc-ck{position:absolute;left:10px;top:10px;z-index:4;width:18px;height:18px;opacity:0}
.lc:hover .lc-ck{opacity:1}

/* visuels dessinés */
.g1{background:linear-gradient(135deg,#3b78b8,#274e84)}.g2{background:linear-gradient(135deg,#e8932b,#c8452a)}.g3{background:linear-gradient(135deg,#2f9b66,#1f6b46)}.g4{background:linear-gradient(135deg,#8a52b8,#40246a)}.g5{background:linear-gradient(135deg,#4a5f7d,#2b3a50)}.g6{background:linear-gradient(135deg,#d4577b,#8c2748)}
.a-mos{display:grid;grid-template-columns:2fr 1fr;grid-template-rows:1fr 1fr;gap:2px;background:#0E1726}
.a-mos span{display:flex;align-items:center;justify-content:center;color:#fff;font-weight:600;font-size:12px;text-align:center;padding:4px;min-width:0;min-height:0}
.a-mos span:first-child{grid-row:span 2;font-size:15px}
.a-mos.one{grid-template-columns:1fr;grid-template-rows:1fr}
.a-kio{display:flex;flex-direction:column;gap:6px;padding:12px 14px;background:linear-gradient(160deg,#16294A,#0B1F3A)}
.a-kio b{color:#fff;font-size:12px;font-weight:600}
.a-kio div{flex:1;display:grid;gap:6px;min-height:0}
.a-kio i{border-radius:6px;display:block;min-height:0}
.a-kio.p{align-items:center}
.a-kio.p div{width:34%;}
.a-cmp{display:flex;flex-direction:column;justify-content:center;gap:7px;padding:0 9%;color:#fff}
.a-cmp b{font-size:19px;font-weight:700;line-height:1.1}
.a-cmp i{display:block;height:5px;border-radius:3px;background:rgba(255,255,255,.55);width:70%}
.a-cmp i + i{width:48%}
.a-cmp em{position:absolute;right:8%;top:14%;width:22%;aspect-ratio:1;border-radius:10px;background:rgba(255,255,255,.22)}
.a-cmp.p{background:#E9ECF2 !important;padding:0;align-items:center}
.a-cmp.p > span{height:88%;aspect-ratio:9/16;border-radius:5px;display:flex;flex-direction:column;justify-content:center;gap:5px;padding:0 8px;box-sizing:border-box}
.a-cmp.p b{font-size:11px}

[data-tip]{position:relative}
[data-tip]:hover::after{content:attr(data-tip);position:absolute;bottom:calc(100% + 7px);left:50%;transform:translateX(-50%);background:#0B1F3A;color:#fff;font-size:12px;font-weight:400;padding:5px 9px;border-radius:6px;white-space:nowrap;z-index:60;pointer-events:none;line-height:1.35}
[data-tip].tb:hover::after{bottom:auto;top:calc(100% + 7px)}
[data-tip].tr:hover::after{left:auto;right:0;transform:none}

/* état vide */
.es-empty{border:2px dashed #B9C8DB;border-radius:14px;background:#fff;padding:58px 28px;text-align:center;color:var(--muted)}
.es-empty b{display:block;color:var(--ink);font-size:19px;font-weight:500;margin-bottom:6px}
.es-empty i{display:inline-grid;place-items:center;width:60px;height:60px;border-radius:16px;background:#EAF1FA;color:var(--signal);margin-bottom:14px}
.es-empty .btn{margin-top:18px}
.es-none{color:var(--muted);text-align:center;padding:40px 0}
.old-tools{display:flex;gap:8px;align-items:center;margin-bottom:14px}
.old-tools .search-box{flex:1;margin:0}
.old-status{display:flex;gap:18px;flex-wrap:wrap;align-items:center;color:var(--muted);font-size:13.5px;margin:-10px 0 16px}
.old-status i{display:inline-block;width:7px;height:7px;border-radius:50%;background:#E8872B;margin-right:6px}
@media (max-width:760px){.es-q.on{width:150px}}
</style>
</head>
<body class="v-new">

<div class="mk-note">
  <b>Maquette</b> · <span id="mk-title"></span>, mode Simple — rien n'est codé
  <span class="grow"></span>
  <span class="mk-seg" id="mk-ver"><button type="button" class="mk-btn" data-v="old">Aujourd'hui</button><button type="button" class="mk-btn on" data-v="new">Allégée</button></span>
  <span>Contenu :</span>
  <span class="mk-seg" id="mk-demo"><button type="button" class="mk-btn on" data-v="full">rempli</button><button type="button" class="mk-btn" data-v="empty">vide</button></span>
</div>
<div class="mk-toast" id="toast"></div>

<div class="shell">
  <aside class="sidebar">
<!--BRAND-->
    <a href="ecrans-simple-allegee.html" class="nav" data-nav="ecrans"><i data-i="monitor"></i> Écrans <span class="nbadges"><span class="nbadge off">1</span></span></a>
    <a href="listes-lecture-simple-allegee.html" class="nav" data-nav="listes"><i data-i="list"></i> Listes de lecture</a>
    <a href="compositions-simple-allegee.html" class="nav" data-nav="contenus"><i data-i="image"></i> Contenus</a>
    <div class="spacer"></div>
    <button type="button" class="nav mode-switch es-mode"><i data-i="sliders"></i> Mode expert <span class="switch"><span></span></span></button>
  </aside>

  <div class="main-col">
    <header class="qbar" aria-label="Accès rapides">
      <div class="org">LPR Unil</div>
      <div class="grow"></div>
      <button type="button" class="qb-btn" aria-label="Aide"><i data-i="help" data-s="19"></i></button>
      <button type="button" class="qb-btn" aria-label="Notifications"><i data-i="bell" data-s="19"></i></button>
      <button type="button" class="qb-me" aria-label="Compte"><span class="avatar">LU</span><i data-i="chev" data-s="16"></i></button>
    </header>

    <main class="content"><nav class="hub-tabs" aria-label="Pages" id="tabs"></nav><div id="page"></div></main>
  </div>
</div>

<script>
const PAGE = '__PAGE__';
const IC = {
  monitor:'<rect x="2" y="3" width="20" height="14" rx="2"/><path d="M8 21h8M12 17v4"/>',
  hand:'<path d="M18 11V6a2 2 0 0 0-4 0v5M14 10V4a2 2 0 0 0-4 0v6M10 10.5V6a2 2 0 0 0-4 0v8"/><path d="M18 8a2 2 0 1 1 4 0v6a8 8 0 0 1-8 8h-2c-2.8 0-4.5-.86-6-2.34l-3.6-3.6a2 2 0 0 1 2.83-2.82L7 15"/>',
  grid:'<rect x="3" y="3" width="7" height="7" rx="1"/><rect x="14" y="3" width="7" height="7" rx="1"/><rect x="3" y="14" width="7" height="7" rx="1"/><rect x="14" y="14" width="7" height="7" rx="1"/>',
  dots:'<circle cx="12" cy="5" r="1"/><circle cx="12" cy="12" r="1"/><circle cx="12" cy="19" r="1"/>',
  play:'<polygon points="7 4 19 12 7 20 7 4"/>',
  playbox:'<rect x="3" y="3" width="18" height="18" rx="3"/><path d="m10 8 6 4-6 4z"/>',
  upload:'<path d="M12 3v12M7 8l5-5 5 5"/><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/>',
  chev:'<path d="m6 9 6 6 6-6"/>',
  edit:'<path d="M17 3a2.85 2.83 0 1 1 4 4L7.5 20.5 2 22l1.5-5.5Z"/>',
  open:'<path d="M15 3h6v6M10 14 21 3M21 14v5a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h5"/>',
  copy:'<rect x="9" y="9" width="12" height="12" rx="2"/><path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"/>',
  users:'<path d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M22 21v-2a4 4 0 0 0-3-3.87M16 3.13a4 4 0 0 1 0 7.75"/>',
  sliders:'<path d="M4 21v-7M4 10V3M12 21v-9M12 8V3M20 21v-5M20 12V3M1 14h6M9 8h6M17 16h6"/>',
  trash:'<path d="M3 6h18M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6M8 6V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2"/>',
  search:'<circle cx="11" cy="11" r="7"/><path d="m21 21-4.3-4.3"/>',
  plus:'<path d="M12 5v14M5 12h14"/>',
  list:'<path d="M8 6h13M8 12h13M8 18h13M3 6h.01M3 12h.01M3 18h.01"/>',
  image:'<rect x="3" y="3" width="18" height="18" rx="2"/><circle cx="8.5" cy="8.5" r="1.5"/><path d="M21 15l-5-5L5 21"/>',
  images:'<rect x="7" y="3" width="14" height="14" rx="2"/><path d="M3 7v12a2 2 0 0 0 2 2h12"/><path d="M21 13l-4-4-6 6"/>',
  layout:'<rect x="3" y="3" width="18" height="18" rx="2"/><path d="M3 9h18M9 21V9"/>',
  spark:'<path d="M12 3l2 5.5L19.5 10 14 12l-2 5.5L10 12 4.5 10 10 8.5z"/><path d="M19 16v4M17 18h4"/>',
  help:'<circle cx="12" cy="12" r="10"/><path d="M9.1 9a3 3 0 0 1 5.8 1c0 2-3 3-3 3M12 17h.01"/>',
  bell:'<path d="M6 8a6 6 0 0 1 12 0c0 7 3 9 3 9H3s3-2 3-9M10.3 21a1.94 1.94 0 0 0 3.4 0"/>',
  x:'<path d="M18 6 6 18M6 6l12 12"/>',
  crown:'<path d="M3 7l4.5 4L12 5l4.5 6L21 7l-2 11H5z"/>',
  filter:'<path d="M3 5h18l-7 8v6l-4-2v-4z"/>'
};
const ico = (n, s = 18) => `<svg class="ico-svg" viewBox="0 0 24 24" width="${s}" height="${s}" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">${IC[n] || ''}</svg>`;
const $ = s => document.querySelector(s);
const pl = (n, w, ws) => `${n} ${n > 1 ? (ws || w + 's') : w}`;
let toastT;
function toast(m) { const t = $('#toast'); t.textContent = m; t.classList.add('on'); clearTimeout(toastT); toastT = setTimeout(() => t.classList.remove('on'), 2400); }

/* ---------- les trois pages ---------- */
const mos = t => `<div class="lc-art a-mos ${t.length === 1 ? 'one' : ''}">${t.map(x => `<span class="${x[1]}">${x[0]}</span>`).join('')}</div>`;
const kio = (t, cols, g, p) => `<div class="lc-art a-kio ${p ? 'p' : ''}"><b>${t}</b><div style="grid-template-columns:repeat(${cols},1fr)">${g.map(x => `<i class="${x}"></i>`).join('')}</div></div>`;
const cmp = (t, g, p) => p ? `<div class="lc-art a-cmp p"><span class="${g}"><b>${t}</b><i></i><i></i></span></div>` : `<div class="lc-art a-cmp ${g}"><b>${t}</b><i></i><i></i><em></em></div>`;
const PAGES = {
  listes: {
    file: 'listes-lecture-simple-allegee.html', nav: 'listes', title: 'Listes de lecture', mk: 'Page Listes de lecture allégée',
    one: 'liste', many: 'listes', fem: true,
    intro: 'Une liste de lecture est une boucle de contenus (images, vidéos, apps) : composez-la, puis choisissez-la sur vos écrans.',
    tabs: [['Listes de lecture', 'listes-lecture-simple-allegee.html'], ['Listes interactives', 'listes-interactives-simple-allegee.html']],
    add: null, addToast: 'Crée une liste et ouvre sa page', openToast: n => `Ouvre la page de la liste « ${n} »`,
    preview: 'Aperçu', publish: true,
    menu: [['open', 'open', 'Ouvrir'], ['play', 'pv', 'Aperçu'], ['edit', 'ren', 'Renommer'], ['copy', 'dup', 'Dupliquer'], ['users', 'share', 'Partager…']],
    empty: ['list', 'Créez votre première liste', 'Une liste fait défiler vos images et vos vidéos sur vos écrans.', 'Créer une liste'],
    data: () => [
      { id: 1, name: 'Union Café', art: mos([['Menu', 'g3'], ['Lac', 'g1'], ['Promo', 'g2']]), m: '6 contenus · 1 min 20', use: 2, pend: true },
      { id: 2, name: 'Accueil visiteurs', art: mos([['Bienvenue', 'g1'], ['Plan', 'g5'], ['Agenda', 'g4']]), m: '4 contenus · 50 s', use: 3 },
      { id: 3, name: 'Promotions', art: mos([['-20 %', 'g2'], ['Nouveau', 'g6'], ['Hiver', 'g1']]), m: '8 contenus · 2 min', use: 2, pend: true },
      { id: 4, name: 'Consignes', art: mos([['Sécurité', 'g5']]), m: '1 contenu · 15 s', use: 1 },
      { id: 5, name: 'Événement de juin', art: mos([['Juin', 'g4'], ['Programme', 'g3'], ['Accès', 'g5']]), m: '5 contenus · 1 min', use: 0, by: 'De Anne' },
      { id: 6, name: 'Nouvelle liste', art: null, m: 'Aucun contenu', use: 0 }
    ],
    stat: s => s.use ? 'Sur ' + pl(s.use, 'écran') : null, statOff: 'Aucun écran',
    oldSt: s => s.pend ? ['pe', 'Modifications non publiées'] : s.use ? ['', 'Diffusée sur ' + pl(s.use, 'écran')] : ['off', "Sur aucun écran"]
  },
  inter: {
    file: 'listes-interactives-simple-allegee.html', nav: 'listes', title: 'Listes interactives', mk: 'Page Listes interactives allégée',
    one: 'liste', many: 'listes', fem: true,
    intro: "Une liste interactive est l'écran tactile d'une borne : des pages, des tuiles, des textes et des images. Chaque tuile ouvre un contenu ou une autre page.",
    tabs: [['Listes de lecture', 'listes-lecture-simple-allegee.html'], ['Listes interactives', 'listes-interactives-simple-allegee.html']],
    add: null, addToast: "Crée une liste interactive et ouvre son éditeur", openToast: n => `Ouvre l'éditeur de « ${n} »`,
    preview: 'Aperçu tactile', publish: false,
    menu: [['open', 'open', 'Ouvrir'], ['play', 'pv', 'Aperçu tactile'], ['edit', 'ren', 'Renommer'], ['copy', 'dup', 'Dupliquer']],
    empty: ['hand', 'Créez votre première liste interactive', "C'est le menu tactile d'une borne : chaque tuile ouvre un contenu.", 'Créer une liste interactive'],
    data: () => [
      { id: 1, name: 'Accueil du bâtiment', art: kio('Bienvenue', 3, ['g1', 'g3', 'g2', 'g4', 'g5', 'g6']), m: '6 tuiles · 2 pages', use: 1, o: 'paysage' },
      { id: 2, name: 'Menu de la cafétéria', art: kio('Menu', 2, ['g3', 'g2', 'g6', 'g1'], true), m: '4 tuiles · 1 page', use: 1, o: 'portrait' },
      { id: 3, name: 'Plan des étages', art: kio('Étages', 4, ['g5', 'g1', 'g5', 'g1']), m: '4 tuiles · 5 pages', use: 0, o: 'paysage' }
    ],
    stat: s => s.use ? 'Sur ' + pl(s.use, 'borne') : null, statOff: 'Aucune borne',
    oldSt: s => s.use ? ['', 'Sur ' + pl(s.use, 'borne')] : ['off', "Sur aucune borne"]
  },
  compos: {
    file: 'compositions-simple-allegee.html', nav: 'contenus', title: 'Compositions', mk: 'Page Compositions allégée',
    one: 'composition', many: 'compositions', fem: true,
    intro: "Vos propres pages d'affichage : textes, formes, images, QR codes et horloge, à placer dans vos listes de lecture.",
    tabs: [['Médiathèque', '#'], ['Compositions', 'compositions-simple-allegee.html']],
    add: [['layout', 'Page vierge', 'Partir de zéro'], ['images', 'À partir d\'un modèle', '26 modèles prêts à adapter'], ['spark', 'Créer avec l\'IA', 'Décrivez-la en une phrase']],
    addToast: "Ouvre l'éditeur de composition", openToast: n => `Ouvre l'éditeur de « ${n} »`,
    preview: null, publish: false,
    menu: [['edit2', 'open', 'Modifier'], ['edit', 'ren', 'Renommer'], ['copy', 'dup', 'Dupliquer']],
    empty: ['layout', 'Créez votre première composition', 'Une page à vos couleurs : titre, image, horloge, QR code.', 'Choisir un modèle'],
    data: () => [
      { id: 1, name: 'Menu du jour', art: cmp('Menu du jour', 'g3'), m: 'Paysage', dim: '1920 × 1080', use: 2 },
      { id: 2, name: 'Bienvenue', art: cmp('Bienvenue', 'g1'), m: 'Paysage', dim: '1920 × 1080', use: 1 },
      { id: 3, name: 'Promo de la semaine', art: cmp('-20 %', 'g2'), m: 'Paysage', dim: '1920 × 1080', use: 1 },
      { id: 4, name: 'Affiche vitrine', art: cmp('Soldes', 'g6', true), m: 'Portrait', dim: '1080 × 1920', use: 1 },
      { id: 5, name: 'Horaires', art: cmp('Horaires', 'g5'), m: 'Paysage', dim: '1920 × 1080', use: 0 },
      { id: 6, name: 'Agenda de juin', art: cmp('Agenda', 'g4'), m: 'Paysage', dim: '1920 × 1080', use: 0, by: 'De Anne' }
    ],
    stat: s => s.use ? 'Dans ' + pl(s.use, 'liste') : null, statOff: null,
    oldSt: null
  }
};
const P = PAGES[PAGE];
IC.edit2 = IC.sliders;
document.title = P.title + ' allégées (mode Simple)';
$('#mk-title').textContent = P.mk;
document.querySelectorAll('[data-i]').forEach(e => { e.outerHTML = ico(e.dataset.i, +(e.dataset.s || 18)); });
document.querySelectorAll('[data-nav]').forEach(a => { if (a.dataset.nav === P.nav) { a.classList.add('active'); a.setAttribute('aria-current', 'page'); } });
$('#tabs').innerHTML = P.tabs.map(t => `<a class="hub-tab ${t[0] === P.title ? 'active' : ''}" href="${t[1]}">${t[0]}</a>`).join('');

let S = P.data(), ver = 'new', filter = null, q = '', qOpen = false, menu = null, add = false, ren = null;
const shown = () => S.filter(s => (!q || s.name.toLowerCase().includes(q.toLowerCase())) && (filter !== 'pend' || s.pend));

function kebab(s) {
  return `<div class="lc-kw ${menu === s.id ? 'open' : ''}"><button type="button" class="kebab-btn" data-a="menu" aria-label="Actions pour ${s.name}">${ico('dots', 18)}</button>${menu === s.id ? `
    <div class="kebab-menu" role="menu">${P.menu.map(m => `<button type="button" data-a="${m[1]}">${ico(m[0], 16)} ${m[2]}</button>`).join('')}
      <hr><button type="button" class="danger" data-a="del">${ico('trash', 16)} Supprimer</button></div>` : ''}</div>`;
}
function card(s) {
  const st = P.stat(s), neu = ver === 'new';
  const cov = s.art ? `<div class="lc-cov" data-a="open">${s.art}
      ${neu && (st || P.statOff) ? `<span class="lc-stat ${st ? '' : 'off'}" title="${st ? 'Diffusée en ce moment' : ''}"><i class="d"></i>${st || P.statOff}</span>` : ''}
      ${s.by ? `<span class="lc-by">${ico('users', 12)}${s.by}</span>` : ''}
      ${P.preview ? `<button type="button" class="lx-play" data-a="pv" title="${P.preview}" aria-label="${P.preview} de « ${s.name} »">${ico('play', 22)}</button>` : ''}</div>`
    : `<div class="lc-cov none" data-a="open">${ico('plus', 15)} Ajouter des contenus</div>`;
  const name = ren === s.id ? `<input class="es-ni" id="ni" value="${s.name}" aria-label="Nom">` : `<span class="lc-name" data-a="${neu ? 'ren' : 'open'}" title="${neu ? 'Renommer' : s.name}">${s.name}</span>`;
  let body;
  if (neu) body = `<div class="lc-nm">${name}${kebab(s)}</div>
      <div class="lc-row"><span class="lc-m">${s.m}</span>${P.publish && s.pend ? `<button type="button" class="es-pb tr" data-a="pub" data-tip="Publier sur ${pl(s.use, 'écran')}" aria-label="Publier « ${s.name} »">${ico('upload', 15)}</button>` : ''}</div>`;
  else {
    const o = P.oldSt ? P.oldSt(s) : null;
    body = `<div class="lc-nm">${name}${kebab(s)}</div>
      <div class="lc-m" style="margin-top:2px">${PAGE === 'compos' ? `${s.dim} · ${s.use ? 'dans ' + pl(s.use, 'liste') : 'dans aucune liste'}` : PAGE === 'inter' ? `${s.m} · ${s.o}` : s.m}</div>
      ${o ? `<div class="lc-st ${o[0]}"><i class="d"></i>${o[1]}</div>` : ''}`;
  }
  return `<div class="lc" data-id="${s.id}">${neu ? '' : '<input type="checkbox" class="lc-ck sc-check" aria-label="Sélectionner">'}${cov}<div class="lc-bd">${body}</div></div>`;
}
const addMenu = () => !P.add ? '' : `<div class="kebab-menu lx-add-menu es-menu" role="menu" ${add ? '' : 'hidden'}>${P.add.map(a => `<button type="button" data-a="new" data-t="${a[1]}">${ico(a[0], 18)}<span><b>${a[1]}</b><small>${a[2]}</small></span></button>`).join('')}</div>`;

function render() {
  document.body.className = 'v-' + ver;
  const pend = P.publish ? S.filter(s => s.pend).length : 0, list = shown();
  let h = '';
  if (ver === 'old') {
    h += `<div class="page-head"><div><h1>${P.title} ${PAGE !== 'compos' ? `<span class="lx-cntpill">${S.length}</span>` : ''}</h1><p class="sub">${P.intro}</p></div>
      <div class="row head-actions" style="position:relative;display:flex;gap:10px">${PAGE === 'compos' ? `<button type="button" class="btn btn-share" data-a="new" data-t="Modèles">${ico('images', 16)} Modèles</button>` : ''}
      <button type="button" class="btn" data-a="add">${ico('plus', 16)} Ajouter ${P.add ? ico('chev', 14) : ''}</button>${addMenu()}</div></div>`;
    if (S.length) {
      if (PAGE === 'listes') h += `<div class="old-status"><span>${pl(S.length, 'liste')}</span>${pend ? `<span><i></i>${pend} listes ont des modifications non publiées <a href="#" class="linklike">Voir</a></span>` : ''}</div>`;
      h += `<div class="lx-bh">${ico(PAGE === 'compos' ? 'layout' : 'list', 16)} <span>${P.title}</span> <small>${S.length}</small></div>
      <div class="old-tools"><label class="search-box">${ico('search', 16)}<input id="q" placeholder="Rechercher" value="${q}"></label><button type="button" class="btn ghost">${ico('filter', 15)} Filtres ${ico('chev', 14)}</button></div>`;
    }
  } else {
    h += `<header class="es-head"><div><h1>${P.title}</h1>
      <p class="es-meta">${S.length ? `<span>${pl(S.length, P.one, P.many)}</span>` : `<span>Aucune ${P.one} pour l'instant</span>`}
        ${pend ? `<span>·</span><button type="button" class="es-f pe ${filter === 'pend' ? 'on' : ''}" data-a="f" data-f="pend" title="N'afficher que les listes à publier">${pend} à publier${filter === 'pend' ? ico('x', 13) : ''}</button>` : ''}</p></div>
      <div class="es-act">
        ${S.length ? `<label class="es-q ${qOpen ? 'on' : ''}">${ico('search', 16)}<input id="q" placeholder="Rechercher" aria-label="Rechercher" value="${q}"></label>
        ${qOpen ? '' : `<button type="button" class="es-ib tb" data-a="q" data-tip="Rechercher" aria-label="Rechercher">${ico('search', 18)}</button>`}
        ${P.publish ? `<button type="button" class="es-ib tb ${pend ? 'pub' : ''}" data-a="puball" ${pend ? '' : 'disabled'} data-tip="${pend ? 'Publier ' + pl(pend, 'liste') : 'Tout est publié'}" aria-label="Publier">${ico('upload', 18)}${pend ? `<span class="es-cnt">${pend}</span>` : ''}</button>` : ''}` : ''}
        <button type="button" class="btn es-add" data-a="add">${ico('plus', 16)} Ajouter</button>${addMenu()}
      </div></header>`;
  }
  if (!S.length) h += ver === 'new'
    ? `<div class="es-empty"><i>${ico(P.empty[0], 28)}</i><b>${P.empty[1]}</b>${P.empty[2]}<br><button type="button" class="btn" data-a="new" data-t="${P.empty[3]}">${ico('plus', 16)} ${P.empty[3]}</button></div>`
    : `<div class="card empty"><div class="big">Aucune ${P.one}</div><p>${P.intro}</p><button type="button" class="btn" data-a="new" data-t="Nouvelle ${P.one}">${ico('plus', 16)} Nouvelle ${P.one}</button></div>`;
  else if (!list.length) h += `<div class="es-none">Aucun résultat</div>`;
  else h += `<div class="lc-grid">${list.map(card).join('')}</div>`;
  $('#page').innerHTML = h;
  const ni = $('#ni'); if (ni) { ni.focus(); ni.select(); }
}

document.addEventListener('click', e => {
  if (e.target.closest('.mk-note, .sidebar, .hub-tabs, .qbar')) { if (e.target.closest('a[href="#"]')) { e.preventDefault(); toast('Maquette à venir'); } return; }
  const a = e.target.closest('[data-a]'), host = e.target.closest('[data-id]'), s = host && S.find(x => x.id == host.dataset.id);
  if (e.target.closest('#ni, #q, .lc-ck')) return;
  const hadOpen = menu || add; menu = null; const wasAdd = add; add = false;
  if (!a) { if (hadOpen) render(); return; }
  e.preventDefault();
  switch (a.dataset.a) {
    case 'menu': menu = s.id; break;
    case 'open': toast(P.openToast(s.name)); break;
    case 'pv': toast(`Ouvre la fenêtre « ${P.preview} » de ${s.name}`); break;
    case 'pub': s.pend = false; toast(`« ${s.name} » publiée sur ${pl(s.use, 'écran')}`); break;
    case 'puball': { const n = S.filter(x => x.pend).length; S.forEach(x => x.pend = false); filter = null; toast(`${pl(n, 'liste publiée', 'listes publiées')}`); break; }
    case 'ren': ren = s.id; break;
    case 'dup': S.splice(S.indexOf(s) + 1, 0, { ...s, id: Date.now(), name: s.name + ' (copie)', use: 0, pend: false, by: null }); toast('Copie créée'); break;
    case 'share': toast(`Ouvre la fenêtre de partage de « ${s.name} »`); break;
    case 'del': S = S.filter(x => x !== s); toast(`« ${s.name} » supprimée (après confirmation dans l'application)`); break;
    case 'f': filter = filter === a.dataset.f ? null : a.dataset.f; break;
    case 'q': qOpen = true; render(); $('#q').focus(); return;
    case 'add': if (P.add) add = !wasAdd; else toast(P.addToast); break;
    case 'new': toast(a.dataset.t === 'Page vierge' ? P.addToast : `Ouvre : ${a.dataset.t}`); break;
  }
  render();
});
document.addEventListener('input', e => { if (e.target.id === 'q') { q = e.target.value; const p = e.target.selectionStart; render(); const n = $('#q'); n.focus(); n.setSelectionRange(p, p); } });
document.addEventListener('keydown', e => {
  if (e.target.id === 'ni' && (e.key === 'Enter' || e.key === 'Escape')) { if (e.key === 'Enter' && e.target.value.trim()) S.find(x => x.id === ren).name = e.target.value.trim(); ren = null; render(); }
  if (e.target.id === 'q' && e.key === 'Escape') { q = ''; qOpen = false; render(); }
});
document.addEventListener('focusout', e => {
  if (e.target.id === 'ni' && ren != null) { const s = S.find(x => x.id === ren); if (e.target.value.trim()) s.name = e.target.value.trim(); ren = null; setTimeout(render); }
  if (e.target.id === 'q' && !q) { qOpen = false; setTimeout(render); }
});
function seg(id, fn) { $(id).addEventListener('click', e => { const b = e.target.closest('.mk-btn'); if (!b) return; $(id).querySelectorAll('.mk-btn').forEach(x => x.classList.toggle('on', x === b)); fn(b.dataset.v); render(); }); }
seg('#mk-ver', v => ver = v);
seg('#mk-demo', v => { S = v === 'empty' ? [] : P.data(); filter = null; q = ''; qOpen = false; });
render();
</script>
</body>
</html>
