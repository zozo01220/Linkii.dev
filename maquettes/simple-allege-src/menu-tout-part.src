<style>
/* ===== Maquette : tout dans le menu latéral, plus de barre du haut (classes nt-*) ===== */
.mk-note{flex-wrap:wrap;row-gap:6px}
body.mtl .qbar{display:none}
body.mtl .content{padding-top:26px}
body.mtl .sidebar{overflow:visible}

/* plan à côté du logo */
.nm-brand .plan-tag{margin-left:8px}
html.nav-shut body.nm .nm-brand .plan-tag{display:none}

/* Assistant : premier bouton du menu */
.nt-ai{display:flex;align-items:center;gap:9px;height:38px;width:100%;box-sizing:border-box;margin:2px 0 12px;padding:0 10px;border-radius:8px;border:1px solid var(--line);background:#fff;font:inherit;font-size:14px;font-weight:500;color:var(--ink);cursor:pointer;text-align:left;white-space:nowrap}
.nt-ai svg{color:var(--signal);flex:none}
.nt-ai:hover,.nt-ai.on{border-color:var(--line-2)}
.nt-ai.on{box-shadow:0 0 0 3px rgba(11,31,58,.06)}
.nt-ai .t{flex:1}
.nt-ai kbd{font:inherit;font-size:11px;color:var(--muted);border:1px solid var(--line);border-radius:4px;padding:1px 5px;background:var(--bg)}

/* pages d'un hub : sous l'entrée du menu */
.nm-item.par{color:var(--ink);font-weight:600}
.nm-item.par svg{color:var(--ink)}
.nt-sub{display:grid;gap:2px;margin:2px 0 4px 19px;padding-left:10px;border-left:1px solid var(--line-2)}
.nt-sub .nm-item{height:32px;font-size:13.5px;font-weight:400;color:#4A5A70}
.nt-sub .nm-item.on{font-weight:600;color:var(--ink)}
/* ... ou en haut de la page */
.nt-ptabs{margin:0 0 16px -13px}

/* zone du milieu : défile seule si le menu est plus haut que la fenêtre ; le pied reste visible */
.nt-scroll{flex:1;min-height:0;overflow-y:auto;overflow-x:hidden;display:flex;flex-direction:column;margin:0 -10px;padding:0 10px 8px;scrollbar-width:thin}
.nt-low{margin-top:auto;display:grid;gap:2px;padding-top:14px}
body.mtl .nm-foot{margin-top:0;padding-top:8px;border-top:1px solid var(--line)}

/* pied du menu */
.nt-em{color:var(--danger,#C8372D);font-weight:600;background:rgba(200,55,45,.07)}
.nt-em svg{color:var(--danger,#C8372D)}
.nt-em:hover{background:rgba(200,55,45,.13)}
.nt-strip{display:flex;justify-content:space-between;padding:0 2px}
.nt-strip .nm-ib .d{box-shadow:0 0 0 2px var(--bg)}
.nt-strip .nm-ib[data-t]:hover::after{top:auto;bottom:42px}
.nt-num{margin-left:auto;min-width:18px;height:18px;box-sizing:border-box;border-radius:9px;background:#F29100;color:#fff;font-size:11px;font-weight:600;line-height:18px;text-align:center;padding:0 5px}
.nt-me{display:flex;align-items:center;gap:10px;width:100%;box-sizing:border-box;height:48px;padding:0 8px;border-radius:10px;border:1px solid transparent;background:none;font:inherit;color:var(--ink);cursor:pointer;text-align:left}
.nt-me:hover,.nt-me.on{background:#fff;border-color:var(--line)}
.nt-me .avatar{width:30px;height:30px;font-size:11px;flex:none}
.nt-me .w{flex:1;min-width:0;display:grid;line-height:1.25}
.nt-me .w b{font-size:13.5px;font-weight:600;overflow:hidden;text-overflow:ellipsis;white-space:nowrap}
.nt-me .w small{font-size:12px;color:var(--muted);overflow:hidden;text-overflow:ellipsis;white-space:nowrap}
.nt-me>svg{color:var(--muted);flex:none}

/* replié */
html.nav-shut body.mtl .nt-ai{justify-content:center;padding:0;gap:0}
html.nav-shut body.mtl .nt-ai .t,html.nav-shut body.mtl .nt-ai kbd{display:none}
html.nav-shut body.mtl .nt-sub{display:none}
html.nav-shut body.mtl .nt-strip{flex-direction:column;align-items:center;gap:2px;padding:0}
html.nav-shut body.mtl .nt-strip .nm-ib[data-t]:hover::after{bottom:auto;top:50%;left:44px;transform:translateY(-50%)}
html.nav-shut body.mtl .nt-num{position:absolute;right:5px;top:3px;min-width:16px;height:16px;line-height:16px;font-size:10px;padding:0 4px}
html.nav-shut body.mtl .nt-me{justify-content:center;padding:0}
html.nav-shut body.mtl .nm-item{height:36px}
html.nav-shut body.mtl .nt-strip{gap:0}
html.nav-shut body.mtl .nt-me .w,html.nav-shut body.mtl .nt-me>svg{display:none}

/* fenêtres qui s'ouvrent à droite du menu */
#nt-pop{position:fixed;width:300px;background:#fff;border:1px solid var(--line-2);border-radius:10px;box-shadow:0 10px 28px rgba(11,31,58,.16);padding:6px;z-index:60;font-size:14px;color:var(--ink)}
#nt-pop[hidden]{display:none}
#nt-pop .lab{padding:8px 10px 6px;font-size:11.5px;letter-spacing:.06em;text-transform:uppercase;color:var(--muted)}
#nt-pop .who{display:flex;gap:10px;align-items:center;padding:8px 10px 10px}
#nt-pop .who .avatar{width:38px;height:38px;font-size:13px;flex:none}
#nt-pop .who b,#nt-pop .who small{display:block}
#nt-pop .who small{color:var(--muted);font-size:12.5px}
#nt-pop .plan{display:flex;align-items:center;padding:0 10px 8px;font-size:12.5px;color:var(--muted)}
#nt-pop .plan .plan-tag{margin-left:auto}
#nt-pop hr{border:0;border-top:1px solid var(--line);margin:4px 0}
#nt-pop a{display:flex;gap:12px;align-items:center;padding:9px 10px;border-radius:6px;color:var(--ink);text-decoration:none}
#nt-pop a:hover{background:var(--bg)}
#nt-pop a svg{flex:none;color:#6A7A8E}
#nt-pop a.out,#nt-pop a.out svg{color:var(--danger,#C8372D)}
#nt-pop a div{min-width:0;flex:1}
#nt-pop a small{display:block;color:var(--muted);font-size:12.5px}
#nt-pop a .v{color:var(--muted);font-size:12px}
#nt-pop a i.p{flex:none;width:8px;height:8px;border-radius:50%;background:#F29100;margin:0 5px}
#nt-pop a i.p.r{background:var(--danger,#C8372D)}
#nt-pop a i.p.g{background:#C3CCD8}
#nt-pop a.all{justify-content:center;color:var(--muted);font-size:13px}
</style>
<!--SPLIT-->
<div id="nt-pop" role="menu" hidden></div>
<script>
(() => {
const LOGO_L = '__LOGO_L__', LOGO_S = '__LOGO_S__', HERE = '__HERE__';
const FILES = { ecrans: 'menu-tout-lateral.html', contenus: 'menu-tout-lateral-contenus.html' };
const I = {
  monitor:'<rect x="2" y="3" width="20" height="14" rx="2"/><path d="M8 21h8M12 17v4"/>',
  list:'<path d="M8 6h13M8 12h13M8 18h13M3 6h.01M3 12h.01M3 18h.01"/>',
  image:'<rect x="3" y="3" width="18" height="18" rx="2"/><circle cx="8.5" cy="8.5" r="1.5"/><path d="M21 15l-5-5L5 21"/>',
  cal:'<rect x="3" y="5" width="18" height="16" rx="2"/><path d="M3 10h18M8 3v4M16 3v4"/>',
  sliders:'<path d="M4 21v-7M4 10V3M12 21v-9M12 8V3M20 21v-5M20 12V3M1 14h6M9 8h6M17 16h6"/>',
  shield:'<path d="M12 3l8 3v6c0 5-3.5 8-8 9-4.5-1-8-4-8-9V6z"/>',
  team:'<path d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M22 21v-2a4 4 0 0 0-3-3.87M16 3.13a4 4 0 0 1 0 7.75"/>',
  chart:'<path d="M3 3v18h18"/><path d="M7 15l4-4 3 3 6-6"/>',
  clock:'<circle cx="12" cy="12" r="9"/><path d="M12 7v5l3 2"/>',
  plus:'<path d="M12 5v14M5 12h14"/>',
  help:'<circle cx="12" cy="12" r="9"/><path d="M9.2 9a3 3 0 0 1 5.8 1c0 2-3 2.5-3 4.5M12 17.5h.01"/>',
  bell:'<path d="M6 8a6 6 0 0 1 12 0c0 7 3 8 3 8H3s3-1 3-8M10 20a2 2 0 0 0 4 0"/>',
  gear:'<circle cx="12" cy="12" r="3"/><path d="M19.4 15a1.7 1.7 0 0 0 .3 1.8l.1.1a2 2 0 1 1-2.8 2.8l-.1-.1a1.7 1.7 0 0 0-2.8 1.2V21a2 2 0 1 1-4 0v-.1a1.7 1.7 0 0 0-2.9-1.2l-.1.1a2 2 0 1 1-2.8-2.8l.1-.1A1.7 1.7 0 0 0 3.1 14H3a2 2 0 1 1 0-4h.1a1.7 1.7 0 0 0 1.2-2.9l-.1-.1a2 2 0 1 1 2.8-2.8l.1.1a1.7 1.7 0 0 0 2.9-1.2V3a2 2 0 1 1 4 0v.1a1.7 1.7 0 0 0 2.8 1.2l.1-.1a2 2 0 1 1 2.8 2.8l-.1.1a1.7 1.7 0 0 0 1.2 2.9h.2a2 2 0 1 1 0 4h-.1a1.7 1.7 0 0 0-1.5 1z"/>',
  spark:'<path d="M12 3l1.9 5.6L19.5 10l-5.6 1.9L12 17.5l-1.9-5.6L4.5 10l5.6-1.4z"/><path d="M19 15l.7 2.3L22 18l-2.3.7L19 21l-.7-2.3L16 18l2.3-.7z"/>',
  down:'<rect x="2" y="3" width="20" height="14" rx="2"/><path d="M12 7v6M9.5 10.5L12 13l2.5-2.5M8 21h8"/>',
  alert:'<path d="M12 3L2 20h20zM12 10v5M12 17.5h.01"/>',
  chev:'<path d="m6 9 6 6 6-6"/>', updown:'<path d="M8 10l4-4 4 4M8 14l4 4 4-4"/>',
  panel:'<rect x="3" y="4" width="18" height="16" rx="2"/><path d="M9 4v16"/>',
  user:'<circle cx="12" cy="8" r="4"/><path d="M4 21a8 8 0 0 1 16 0"/>',
  card:'<rect x="2" y="5" width="20" height="14" rx="2"/><path d="M2 10h20"/>',
  logout:'<path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4M16 17l5-5-5-5M21 12H9"/>',
  crown:'<path d="M3 18h18M4 8l4 4 4-7 4 7 4-4-1.5 10h-13z"/>',
  sun:'<circle cx="12" cy="12" r="4"/><path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4"/>',
  palette:'<path d="M12 3a9 9 0 1 0 0 18c1.5 0 2-1 2-2s-.5-1.5-.5-2.5S14.5 15 16 15h2a3 3 0 0 0 3-3c0-5-4-9-9-9z"/><circle cx="7.5" cy="11" r="1"/><circle cx="10" cy="7" r="1"/><circle cx="15" cy="7.5" r="1"/>',
  star:'<path d="M12 3l2.7 5.6 6.1.9-4.4 4.3 1 6.1L12 17l-5.4 2.9 1-6.1L3.2 9.5l6.1-.9z"/>',
  ext:'<path d="M14 4h6v6M20 4l-9 9M18 14v5a1 1 0 0 1-1 1H5a1 1 0 0 1-1-1V7a1 1 0 0 1 1-1h5"/>',
  win:'<path d="M3 5l8-1v8H3zM13 4l8-1.2V12h-8zM3 13h8v8l-8-1zM13 13h8v8.2L13 20z"/>',
  phone:'<rect x="7" y="2" width="10" height="20" rx="2"/><path d="M11 18h2"/>',
  globe:'<circle cx="12" cy="12" r="9"/><path d="M3 12h18M12 3c3 3 3 15 0 18M12 3c-3 3-3 15 0 18"/>'
};
const ic = (n, s = 18, c = '') => `<svg class="${c}" viewBox="0 0 24 24" width="${s}" height="${s}" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round">${I[n]}</svg>`;
const $ = s => document.querySelector(s);
let st = { ver: 'new', mode: 'simple', fold: 'open', tabs: 'menu', foot: 'icons' };
try { st = { ...st, ...JSON.parse(localStorage.getItem('mk-menu-tout') || '{}') }; } catch (e) { }
let pop = null, ai = false;
const APPS = [['sun', 'Météo'], ['cal', 'Google Agenda'], ['palette', 'Canva']];
const href = k => FILES[k] || '#', on = k => k === HERE;
const tabsOf = x => HERE === 'contenus' ? ['Médiathèque', 'Compositions'].concat(x ? ['Widgets'] : []) : [];
const it = (k, i, t, extra = '', cls = '') => `<a href="${href(k)}" class="nm-item ${cls} ${on(k) ? 'on' : ''}" title="${t}">${ic(i, cls ? 17 : 19)}<span class="t">${t}</span>${extra}</a>`;
const brand = () => `<div class="nm-brand"><img class="l" src="${LOGO_L}" alt="Linkivi"><img class="s" src="${LOGO_S}" alt="Linkivi"><span class="plan-tag pro">${ic('crown', 13)}Pro</span>
      <button type="button" class="nm-fold" data-m="fold" title="Replier le menu (Ctrl + B)">${ic('panel', 18)}</button></div>`;
const appsSec = () => `<div class="nm-sec"><span>Applications</span><span class="g"></span>
      <button type="button" title="Gérer mes applications">${ic('sliders', 15)}</button><button type="button" title="Ajouter une application (Store)">${ic('plus', 16)}</button></div>
    <div class="nm-list">${APPS.map(a => it('', a[0], a[1], '', 'sm')).join('')}</div>`;
const modeRow = x => `<button type="button" class="nm-item nm-mode ${x ? 'exp' : ''}" data-m="mode" title="Mode expert">${ic('sliders', 17)}<span class="t">Mode expert</span><span class="nm-sw ${x ? 'on' : ''}"></span></button>`;

/* ---------- Aujourd'hui (§237) ---------- */
function oldSide(x) {
  return `${brand()}
    <div class="nm-list">
      <button type="button" class="nm-item nm-open" data-m="fold" title="Déplier le menu (Ctrl + B)">${ic('panel', 19)}</button>
      ${it('ecrans', 'monitor', 'Écrans', '<span class="nm-bad" title="1 écran hors ligne">1</span>')}
      ${it('listes', 'list', 'Listes de diffusion')}
      ${it('contenus', 'image', 'Contenus')}
      ${x ? it('prog', 'cal', 'Programmations') + it('appr', 'shield', 'Approbations') : ''}
    </div>
    ${appsSec()}
    <div class="nm-foot">
      ${x ? it('org', 'team', 'Organisation', '', 'sm') + it('stats', 'chart', 'Statistiques', '', 'sm') + it('hist', 'clock', 'Historique', '', 'sm') + '<div class="nm-rule"></div>' : ''}
      ${modeRow(x)}
    </div>`;
}
function oldBar(x) {
  return `<nav class="nm-tabs" aria-label="Pages">${tabsOf(x).map((t, i) => `<a href="#" class="nm-tab ${i ? '' : 'on'}">${t}</a>`).join('')}</nav><div class="grow"></div>
    ${x ? `<button type="button" class="nm-em">${ic('alert', 16)}Urgence</button>` : ''}
    <button type="button" class="nm-ai" data-t="Assistant (Ctrl + J)">${ic('spark', 17)}Assistant</button>
    ${x ? `<button type="button" class="nm-ib" data-t="Installer le player" aria-label="Installer le player">${ic('down', 19)}</button>` : ''}
    <button type="button" class="nm-ib" data-t="Aide" aria-label="Aide">${ic('help', 19)}</button>
    <button type="button" class="nm-ib" data-t="Notifications" aria-label="Notifications">${ic('bell', 19)}<i class="d"></i></button>
    <button type="button" class="nm-ib" data-t="Réglages" aria-label="Réglages">${ic('gear', 19)}</button>
    <div class="nm-wrap"><button type="button" class="nm-me ${pop === 'me' ? 'on' : ''}" data-m="me" aria-label="Compte"><span class="avatar">LU</span><b>LPR Unil</b>${ic('chev', 14)}</button>
      ${pop === 'me' ? `<div class="nm-pop" role="menu"><div class="nm-who"><span class="avatar">LU</span><div><b>LPR Unil</b><small>ludovic@exemple.ch</small></div></div>
        <div class="plan"><span>Plan</span><span class="plan-tag pro">${ic('crown', 13)}Pro</span></div><hr>
        <a href="#">${ic('user')}Mon compte</a>${x ? `<a href="#">${ic('card')}Abonnement et facturation</a><a href="#">${ic('team')}Organisation</a>` : ''}
        <a href="#">${ic('help')}Aide et contact</a><hr><a href="#" class="out">${ic('logout')}Se déconnecter</a></div>` : ''}</div>`;
}

/* ---------- Proposition : tout dans le menu ---------- */
function newSide(x) {
  const shut = st.fold === 'shut', tabs = tabsOf(x), inMenu = tabs.length > 0 && st.tabs === 'menu' && !shut;
  const hub = (k, i, t) => on(k) && inMenu
    ? `<a href="${href(k)}" class="nm-item par" title="${t}">${ic(i, 19)}<span class="t">${t}</span></a><div class="nt-sub">${tabs.map((n, j) => `<a href="#" class="nm-item ${j ? '' : 'on'}"><span class="t">${n}</span></a>`).join('')}</div>`
    : it(k, i, t);
  const ib = (m, i, t, dot = '') => `<button type="button" class="nm-ib ${pop === m ? 'on' : ''}" data-m="${m}" data-t="${t}" aria-label="${t}">${ic(i, 19)}${dot}</button>`;
  const row = (m, i, t, extra = '') => `<button type="button" class="nm-item sm ${pop === m ? 'on' : ''}" data-m="${m}" title="${t}">${ic(i, 17)}<span class="t">${t}</span>${extra}</button>`;
  const quick = st.foot === 'icons'
    ? `<div class="nt-strip">${ib('notif', 'bell', 'Notifications', '<i class="d"></i>')}${ib('help', 'help', 'Aide')}${x ? ib('player', 'down', 'Installer le player') : ''}${ib('gear', 'gear', 'Réglages')}</div>`
    : row('notif', 'bell', 'Notifications', '<span class="nt-num">3</span>') + row('gear', 'gear', 'Réglages') + row('help', 'help', 'Aide') + (x ? row('player', 'down', 'Installer le player') : '');
  return `${brand()}
    <button type="button" class="nt-ai ${ai ? 'on' : ''}" data-m="ai" title="Assistant (Ctrl + J)">${ic('spark', 18)}<span class="t">Assistant</span><kbd>Ctrl J</kbd></button>
    <div class="nt-scroll">
    <div class="nm-list">
      <button type="button" class="nm-item nm-open" data-m="fold" title="Déplier le menu (Ctrl + B)">${ic('panel', 19)}</button>
      ${it('ecrans', 'monitor', 'Écrans', '<span class="nm-bad" title="1 écran hors ligne">1</span>')}
      ${it('listes', 'list', 'Listes de diffusion')}
      ${hub('contenus', 'image', 'Contenus')}
      ${x ? it('prog', 'cal', 'Programmations') + it('appr', 'shield', 'Approbations') : ''}
    </div>
    ${appsSec()}
    ${x ? `<div class="nt-low">${it('org', 'team', 'Organisation', '', 'sm') + it('stats', 'chart', 'Statistiques', '', 'sm') + it('hist', 'clock', 'Historique', '', 'sm')}</div>` : ''}
    </div>
    <div class="nm-foot">
      ${x ? `<button type="button" class="nm-item sm nt-em" title="Urgence">${ic('alert', 17)}<span class="t">Urgence</span></button>` : ''}
      ${modeRow(x)}
      <div class="nm-rule"></div>
      ${quick}
      <button type="button" class="nt-me ${pop === 'me' ? 'on' : ''}" data-m="me" aria-label="Compte" title="LPR Unil"><span class="avatar">LU</span><span class="w"><b>LPR Unil</b><small>ludovic@exemple.ch</small></span>${ic('updown', 15)}</button>
    </div>`;
}
const POP = {
  me: x => `<div class="who"><span class="avatar">LU</span><div><b>LPR Unil</b><small>ludovic@exemple.ch</small></div></div>
    <div class="plan"><span>Plan</span><span class="plan-tag pro">${ic('crown', 13)}Pro</span></div><hr>
    <a href="#">${ic('user')}Mon compte</a>${x ? `<a href="#">${ic('card')}Abonnement et facturation</a><a href="#">${ic('team')}Organisation</a>` : ''}
    <a href="#">${ic('help')}Aide et contact</a><hr><a href="#" class="out">${ic('logout')}Se déconnecter</a>`,
  notif: () => `<div class="lab">Notifications</div>
    <a href="#"><i class="p r"></i><div>Écran « Accueil » hors ligne<small>Il y a 12 min</small></div></a>
    <a href="#"><i class="p"></i><div>Une publication attend votre approbation<small>Il y a 1 h</small></div></a>
    <a href="#"><i class="p g"></i><div>Canva : compte reconnecté<small>Hier</small></div></a>
    <hr><a href="#" class="all">Tout voir</a>`,
  help: () => `<div class="lab">Aide</div>
    <a href="#">${ic('star')}<div>Premiers pas<small>Ajouter vos contenus et créer une liste</small></div></a>
    <a href="#">${ic('monitor')}<div>Connecter un écran<small>Avec le code affiché sur l'écran</small></div></a>
    <hr><a href="#">${ic('ext')}<div>Centre d'aide<small>linkivi.com</small></div></a>`,
  player: () => `<div class="lab">Installer le player sur un écran</div>
    <a href="#">${ic('win')}<div>Windows<small>.msi · 4,2 Mo</small></div><span class="v">v1.4</span></a>
    <a href="#">${ic('phone')}<div>Android et Android TV<small>.apk · 6,8 Mo</small></div><span class="v">v1.6</span></a>
    <a href="#">${ic('globe')}<div>Navigateur<small>Sans installation</small></div><span class="v">↗</span></a>`
};
function place(x) {
  const p = $('#nt-pop'), a = pop && st.ver === 'new' && POP[pop] ? document.querySelector(`#nm-sb [data-m="${pop}"]`) : null;
  if (!a) { p.hidden = true; return; }
  p.innerHTML = POP[pop](x); p.hidden = false;
  const r = a.getBoundingClientRect(), sb = $('#nm-sb').getBoundingClientRect(), h = p.offsetHeight;
  p.style.left = (sb.right + 8) + 'px';
  p.style.top = Math.max(8, Math.min(r.bottom - h, innerHeight - h - 8)) + 'px';
}
function pageTabs(x) {
  let n = $('#nt-ptabs');
  const tabs = tabsOf(x), show = st.ver === 'new' && tabs.length > 0 && (st.tabs === 'page' || st.fold === 'shut');
  if (!show) { if (n) n.remove(); return; }
  if (!n) { n = document.createElement('nav'); n.id = 'nt-ptabs'; n.className = 'nm-tabs nt-ptabs'; n.setAttribute('aria-label', 'Pages'); const c = $('main.content'); c.insertBefore(n, c.firstChild); }
  n.innerHTML = tabs.map((t, i) => `<a href="#" class="nm-tab ${i ? '' : 'on'}">${t}</a>`).join('');
}
function draw() {
  const x = st.mode === 'expert', nw = st.ver === 'new';
  document.body.classList.add('nm');
  document.body.classList.toggle('mtl', nw);
  document.documentElement.classList.toggle('nav-shut', st.fold === 'shut');
  $('#nm-sb').innerHTML = nw ? newSide(x) : oldSide(x);
  $('#nm-qb').innerHTML = nw ? '' : oldBar(x);
  pageTabs(x); place(x);
  for (const k of ['ver', 'mode', 'fold', 'tabs', 'foot']) document.querySelectorAll(`#mm-${k} .mk-btn`).forEach(b => b.classList.toggle('on', b.dataset.v === st[k]));
  document.querySelectorAll('.mm-new').forEach(e => e.style.display = nw ? '' : 'none');
  try { localStorage.setItem('mk-menu-tout', JSON.stringify(st)); } catch (e) { }
}
document.addEventListener('click', e => {
  const seg = e.target.closest('#mm-ver, #mm-mode, #mm-fold, #mm-tabs, #mm-foot'), b = e.target.closest('.mk-btn'), m = e.target.closest('[data-m]');
  const had = pop; pop = null;
  if (seg && b) { st[seg.id.slice(3)] = b.dataset.v; draw(); return; }
  if (e.target.closest('.content .hub-tabs a, .nm-tabs a, .nm-pop a, #nt-pop a, .nt-sub a')) { e.preventDefault(); e.stopPropagation(); if (had) draw(); return; }
  if (m) {
    e.preventDefault(); e.stopPropagation();
    const k = m.dataset.m;
    if (k === 'fold') st.fold = st.fold === 'shut' ? 'open' : 'shut';
    else if (k === 'mode') st.mode = st.mode === 'expert' ? 'simple' : 'expert';
    else if (k === 'ai') ai = !ai;
    else if (k !== 'gear' && had !== k) pop = k;
    draw(); return;
  }
  if (had) draw();
}, true);
document.addEventListener('keydown', e => { if ((e.ctrlKey || e.metaKey) && e.key.toLowerCase() === 'b') { e.preventDefault(); pop = null; st.fold = st.fold === 'shut' ? 'open' : 'shut'; draw(); } });
addEventListener('scroll', () => document.body.classList.toggle('scrolled', scrollY > 6), { passive: true });
addEventListener('resize', () => { if (pop) draw(); });
$('#nm-sb').addEventListener('transitionend', () => place(st.mode === 'expert'));
draw();
})();
</script>
