<style>
/* ===== Maquette : refonte du menu latéral et de la barre du haut (classes nm-*) ===== */
.mk-note .mk-lab{margin-left:8px}
.qbar .embtn-mk{height:34px;padding:0 13px;border-radius:17px;border:0;background:var(--danger,#C8372D);color:#fff;font:inherit;font-size:13.5px;font-weight:600;display:inline-flex;align-items:center;gap:6px;cursor:pointer;margin-right:6px}

/* --- menu latéral proposé --- */
body.nm .sidebar{width:248px;background:var(--bg);border-radius:0;border-right:1px solid var(--line);padding:0 10px 10px;transition:width .2s}
body.nm .nm-brand{display:flex;align-items:center;height:56px;padding:0 6px 0 10px;flex:none}
body.nm .nm-brand img{height:23px;width:auto;display:block}
body.nm .nm-brand .s{display:none;height:26px}
body.nm .nm-fold{margin-left:auto;width:30px;height:30px;border:0;background:none;border-radius:8px;display:grid;place-items:center;color:var(--muted);cursor:pointer;opacity:0;transition:opacity .15s}
body.nm .sidebar:hover .nm-fold,body.nm .nm-fold:focus-visible{opacity:1}
body.nm .nm-fold:hover{background:rgba(11,31,58,.06);color:var(--ink)}
.nm-list{display:grid;gap:2px}
.nm-item{position:relative;display:flex;align-items:center;gap:11px;height:40px;padding:0 10px;border-radius:8px;border:1px solid transparent;background:none;width:100%;box-sizing:border-box;font:inherit;font-size:14px;font-weight:500;color:#2A3B52;text-decoration:none;cursor:pointer;text-align:left;white-space:nowrap}
.nm-item svg{flex:none;color:#6A7A8E}
.nm-item:hover{background:rgba(11,31,58,.05)}
.nm-item.on{background:#fff;border-color:var(--line);color:var(--ink);font-weight:600}
.nm-item.on svg{color:var(--ink)}
.nm-item.sm{height:34px;font-size:13.5px;font-weight:400}
.nm-item .t{overflow:hidden;text-overflow:ellipsis}
.nm-bad{margin-left:auto;min-width:18px;height:18px;box-sizing:border-box;border-radius:9px;background:var(--danger,#C8372D);color:#fff;font-size:11px;font-weight:600;line-height:18px;text-align:center;padding:0 5px}
.nm-pub{margin-left:auto;color:#D97A12;display:grid}
.nm-pub svg{color:#D97A12}
.nm-sec{display:flex;align-items:center;gap:2px;height:28px;margin:16px 0 2px;padding:0 2px 0 11px;font-size:11.5px;letter-spacing:.06em;text-transform:uppercase;color:var(--muted)}
.nm-sec .g{flex:1}
.nm-sec button{width:26px;height:26px;border:0;background:none;border-radius:6px;display:grid;place-items:center;color:var(--muted);cursor:pointer}
.nm-sec button:hover{background:rgba(11,31,58,.07);color:var(--ink)}
.nm-foot{margin-top:auto;display:grid;gap:2px;padding-top:10px}
.nm-rule{height:1px;background:var(--line);margin:8px 4px}
.nm-mode{color:var(--muted);font-weight:400;font-size:13.5px}
.nm-mode .t{flex:1}
.nm-sw{flex:none;width:32px;height:18px;border-radius:9px;background:#C3CCD8;position:relative;transition:background .15s}
.nm-sw::after{content:"";position:absolute;left:2px;top:2px;width:14px;height:14px;border-radius:50%;background:#fff;transition:left .15s}
.nm-sw.on{background:var(--brand)}
.nm-sw.on::after{left:16px}

/* replié : icônes seules */
html.nav-shut body.nm .sidebar{width:64px}
html.nav-shut body.nm .nm-brand{padding:0;justify-content:center}
html.nav-shut body.nm .nm-brand .l{display:none}
html.nav-shut body.nm .nm-brand .s{display:block}
html.nav-shut body.nm .nm-brand .nm-fold{display:none}
html.nav-shut body.nm .nm-item{justify-content:center;padding:0;gap:0}
html.nav-shut body.nm .nm-item .t,html.nav-shut body.nm .nm-sw,html.nav-shut body.nm .nm-pub{display:none}
html.nav-shut body.nm .nm-bad{position:absolute;right:5px;top:4px;min-width:16px;height:16px;line-height:16px;font-size:10px;padding:0 4px}
html.nav-shut body.nm .nm-sec{height:1px;margin:10px 8px;padding:0;background:var(--line);overflow:hidden}
html.nav-shut body.nm .nm-sec>*{display:none}
html.nav-shut body.nm .nm-mode.exp svg{color:var(--brand)}
.nm-open{display:none}
html.nav-shut body.nm .nm-open{display:flex;color:var(--muted)}

/* --- barre du haut proposée --- */
body.nm .qbar{height:56px;background:transparent;border-bottom:1px solid transparent;padding:0 40px;gap:4px;transition:background .15s,border-color .15s}
body.nm.scrolled .qbar{background:rgba(245,247,250,.9);backdrop-filter:blur(8px);border-bottom-color:var(--line)}
body.nm .content{padding-top:14px}
body.nm .content>.hub-tabs{display:none}
.nm-tabs{display:flex;gap:4px;margin-left:-13px}
.nm-tab{height:34px;padding:0 13px;border-radius:8px;border:1px solid transparent;display:inline-flex;align-items:center;font-size:14px;color:var(--muted);text-decoration:none;white-space:nowrap}
.nm-tab:hover{color:var(--ink);background:rgba(11,31,58,.05)}
.nm-tab.on{background:#fff;border-color:var(--line);color:var(--ink);font-weight:600}
.nm-ib{position:relative;width:36px;height:36px;border:0;background:none;border-radius:8px;display:grid;place-items:center;color:#2A3B52;cursor:pointer}
.nm-ib:hover,.nm-ib.on{background:rgba(11,31,58,.06)}
.nm-ib .d{position:absolute;right:7px;top:7px;width:8px;height:8px;border-radius:50%;background:#F29100;box-shadow:0 0 0 2px var(--bg)}
.nm-ib[data-t]:hover::after,.nm-ai[data-t]:hover::after{content:attr(data-t);position:absolute;top:42px;left:50%;transform:translateX(-50%);background:var(--ink);color:#fff;font-size:12px;font-weight:400;padding:3px 8px;border-radius:4px;white-space:nowrap;z-index:5}
.nm-ai{position:relative;height:34px;padding:0 12px 0 10px;border-radius:8px;border:1px solid var(--line);background:#fff;display:inline-flex;align-items:center;gap:7px;font:inherit;font-size:13.5px;font-weight:500;color:var(--ink);cursor:pointer;margin-right:6px}
.nm-ai svg{color:var(--signal)}
.nm-ai:hover{border-color:var(--line-2)}
.nm-em{height:34px;padding:0 12px 0 10px;border-radius:8px;border:0;background:var(--danger,#C8372D);color:#fff;font:inherit;font-size:13.5px;font-weight:600;display:inline-flex;align-items:center;gap:6px;cursor:pointer;margin-right:6px}
.nm-wrap{position:relative;margin-left:8px}
.nm-me{height:36px;padding:0 9px 0 4px;border-radius:18px;border:1px solid var(--line);background:#fff;display:inline-flex;align-items:center;gap:8px;font:inherit;font-size:13.5px;font-weight:500;color:var(--ink);cursor:pointer;max-width:220px}
.nm-me:hover,.nm-me.on{border-color:var(--line-2)}
.nm-me .avatar{width:28px;height:28px;font-size:11px;flex:none}
.nm-me b{font-weight:500;overflow:hidden;text-overflow:ellipsis;white-space:nowrap}
.nm-me svg{color:var(--muted);flex:none}
.nm-pop{position:absolute;top:calc(100% + 8px);right:0;width:290px;background:#fff;border:1px solid var(--line-2);border-radius:10px;box-shadow:0 10px 28px rgba(11,31,58,.16);padding:6px;z-index:30}
.nm-pop .nm-who{display:flex;gap:10px;align-items:center;padding:8px 10px 10px}
.nm-pop .nm-who .avatar{width:38px;height:38px;font-size:13px;flex:none}
.nm-pop .nm-who b,.nm-pop .nm-who small{display:block}
.nm-pop .nm-who small{color:var(--muted);font-size:12.5px}
.nm-pop .plan{display:flex;align-items:center;padding:0 10px 8px;font-size:12.5px;color:var(--muted)}
.nm-pop .plan .plan-tag{margin-left:auto}
.nm-pop hr{border:0;border-top:1px solid var(--line);margin:4px 0}
.nm-pop a{display:flex;gap:12px;align-items:center;padding:9px 10px;border-radius:6px;color:var(--ink);text-decoration:none;font-size:14px}
.nm-pop a:hover{background:var(--bg)}
.nm-pop a.out{color:var(--danger,#C8372D)}
@media (max-width:1100px){.nm-me b{display:none}}
</style>
<!--SPLIT-->
<script>
(() => {
const LOGO_L = '__LOGO_L__', LOGO_S = '__LOGO_S__', HERE = '__HERE__';
const FILES = { ecrans: 'menu-barre-refonte.html', contenus: 'menu-barre-refonte-contenus.html' };
const I = {
  monitor:'<rect x="2" y="3" width="20" height="14" rx="2"/><path d="M8 21h8M12 17v4"/>',
  list:'<path d="M8 6h13M8 12h13M8 18h13M3 6h.01M3 12h.01M3 18h.01"/>',
  image:'<rect x="3" y="3" width="18" height="18" rx="2"/><circle cx="8.5" cy="8.5" r="1.5"/><path d="M21 15l-5-5L5 21"/>',
  cal:'<rect x="3" y="5" width="18" height="16" rx="2"/><path d="M3 10h18M8 3v4M16 3v4"/>',
  apps:'<rect x="3" y="3" width="7" height="7" rx="1.5"/><rect x="14" y="3" width="7" height="7" rx="1.5"/><rect x="3" y="14" width="7" height="7" rx="1.5"/><rect x="14" y="14" width="7" height="7" rx="1.5"/>',
  store:'<path d="M3 9l1.5-5h15L21 9M3 9v11h18V9M3 9h18M9 20v-6h6v6"/>',
  sliders:'<path d="M4 21v-7M4 10V3M12 21v-9M12 8V3M20 21v-5M20 12V3M1 14h6M9 8h6M17 16h6"/>',
  shield:'<path d="M12 3l8 3v6c0 5-3.5 8-8 9-4.5-1-8-4-8-9V6z"/>',
  team:'<path d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M22 21v-2a4 4 0 0 0-3-3.87M16 3.13a4 4 0 0 1 0 7.75"/>',
  chart:'<path d="M3 3v18h18"/><path d="M7 15l4-4 3 3 6-6"/>',
  clock:'<circle cx="12" cy="12" r="9"/><path d="M12 7v5l3 2"/>',
  plus:'<path d="M12 5v14M5 12h14"/>',
  help:'<circle cx="12" cy="12" r="9"/><path d="M9.2 9a3 3 0 0 1 5.8 1c0 2-3 2.5-3 4.5M12 17.5h.01"/>',
  bell:'<path d="M6 8a6 6 0 0 1 12 0c0 7 3 8 3 8H3s3-1 3-8M10 20a2 2 0 0 0 4 0"/>',
  gear:'<circle cx="12" cy="12" r="3"/><path d="M19.4 15a1.7 1.7 0 0 0 .3 1.8l.1.1a2 2 0 1 1-2.8 2.8l-.1-.1a1.7 1.7 0 0 0-2.8 1.2V21a2 2 0 1 1-4 0v-.1a1.7 1.7 0 0 0-2.9-1.2l-.1.1a2 2 0 1 1-2.8-2.8l.1-.1A1.7 1.7 0 0 0 3.1 14H3a2 2 0 1 1 0-4h.1a1.7 1.7 0 0 0 1.2-2.9l-.1-.1a2 2 0 1 1 2.8-2.8l.1.1a1.7 1.7 0 0 0 2.9-1.2V3a2 2 0 1 1 4 0v.1a1.7 1.7 0 0 0 2.8 1.2l.1-.1a2 2 0 1 1 2.8 2.8l-.1.1a1.7 1.7 0 0 0 1.2 2.9h.2a2 2 0 1 1 0 4h-.1a1.7 1.7 0 0 0-1.5 1z"/>',
  spark:'<path d="M12 3l1.9 5.6L19.5 10l-5.6 1.9L12 17.5l-1.9-5.6L4.5 10l5.6-1.4z"/><path d="M19 15l.7 2.3L22 18l-2.3.7L19 21l-.7-2.3L16 18l2.3-.7z"/>',
  down:'<rect x="2" y="3" width="20" height="14" rx="2"/><path d="M12 7v6M9.5 10.5L12 13l2.5-2.5M8 21h8"/>',
  alert:'<path d="M12 3L2 20h20zM12 10v5M12 17.5h.01"/>',
  chev:'<path d="m6 9 6 6 6-6"/>', right:'<path d="M9 6l6 6-6 6"/>', left:'<path d="M15 6l-6 6 6 6"/>',
  panel:'<rect x="3" y="4" width="18" height="16" rx="2"/><path d="M9 4v16"/>',
  user:'<circle cx="12" cy="8" r="4"/><path d="M4 21a8 8 0 0 1 16 0"/>',
  card:'<rect x="2" y="5" width="20" height="14" rx="2"/><path d="M2 10h20"/>',
  logout:'<path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4M16 17l5-5-5-5M21 12H9"/>',
  crown:'<path d="M3 18h18M4 8l4 4 4-7 4 7 4-4-1.5 10h-13z"/>',
  sun:'<circle cx="12" cy="12" r="4"/><path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4"/>',
  palette:'<path d="M12 3a9 9 0 1 0 0 18c1.5 0 2-1 2-2s-.5-1.5-.5-2.5S14.5 15 16 15h2a3 3 0 0 0 3-3c0-5-4-9-9-9z"/><circle cx="7.5" cy="11" r="1"/><circle cx="10" cy="7" r="1"/><circle cx="15" cy="7.5" r="1"/>',
  up:'<path d="M12 16V4M7 9l5-5 5 5M4 20h16"/>'
};
const ic = (n, s = 18, c = '') => `<svg class="${c}" viewBox="0 0 24 24" width="${s}" height="${s}" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round">${I[n]}</svg>`;
const $ = s => document.querySelector(s);
let st = { ver: 'new', mode: 'simple', fold: 'open' };
try { st = { ...st, ...JSON.parse(localStorage.getItem('mk-menu-refonte') || '{}') }; } catch (e) { }
let pop = false;
const APPS = [['sun', 'Météo'], ['cal', 'Google Agenda'], ['palette', 'Canva']];
const href = k => FILES[k] || '#', on = k => k === HERE;

function oldSide(x) {
  const nav = (k, i, t, extra = '') => `<a href="${href(k)}" class="nav ${on(k) ? 'active' : ''}">${ic(i, 24)} ${t}${extra}</a>`;
  return `<div class="brand"><span class="brand-logo"><img class="bl-long" src="${LOGO_L}" alt="Linkivi"><img class="bl-short" src="${LOGO_S}" alt=""></span>
      <span class="brand-meta"><span class="plan-tag pro">${ic('crown', 13)}Pro</span></span>
      <button type="button" class="nav-fold" data-m="fold" aria-label="Replier le menu"><svg viewBox="0 0 24 24"><path d="M15 6l-6 6 6 6"></path></svg></button></div>
    ${nav('ecrans', 'monitor', 'Écrans', '<span class="nbadges"><span class="nbadge off">1</span></span>')}
    ${nav('listes', 'list', 'Listes de diffusion')}
    ${nav('contenus', 'image', 'Contenus')}
    ${x ? `<div class="nav-sep" role="separator"></div>${nav('prog', 'cal', 'Programmations')}` : ''}
    <div class="nav-sep" role="separator"></div>
    <button type="button" class="nav nav-group open">${ic('apps', 24)} Applications <svg class="chev" viewBox="0 0 24 24"><path d="M9 6l6 6-6 6"/></svg></button>
    <div class="nav-sub">${APPS.map(a => `<a href="#" class="nav nav-app">${ic(a[0], 16)} ${a[1]}</a>`).join('')}
      <a href="#" class="nav nav-store">${ic('store', 16)} Store</a><a href="#" class="nav nav-manage">${ic('sliders', 16)} Gérer mes applications</a></div>
    ${x ? nav('appr', 'shield', 'Approbations') : ''}
    <div class="spacer"></div>
    ${x ? nav('org', 'team', 'Organisation') + nav('stats', 'chart', 'Statistiques') + nav('hist', 'clock', 'Historique') : ''}
    <button type="button" class="nav mode-switch es-mode" data-m="mode">${ic('sliders', 24)} <span>Mode expert</span> <span class="switch ${x ? 'on' : ''}"><span></span></span></button>`;
}
function oldBar(x) {
  return `<div class="org">LPR Unil</div><div class="grow"></div>
    ${x ? `<button type="button" class="embtn-mk">${ic('alert', 16)}Urgence</button><button type="button" class="qb-btn">${ic('down', 19, 'ico-svg')}<span>Player</span></button>` : ''}
    <button type="button" class="qb-btn qb-ai">${ic('spark', 19, 'ico-svg')}<span>Assistant</span></button>
    <button type="button" class="qb-btn store">${ic('store', 19, 'ico-svg')}<span>Store</span></button>
    <span class="sep2" aria-hidden="true"></span>
    <button type="button" class="qb-btn" aria-label="Aide">${ic('help', 19, 'ico-svg')}</button>
    <button type="button" class="qb-btn" aria-label="Notifications">${ic('bell', 19, 'ico-svg')}<span class="nbadge dot"></span></button>
    <button type="button" class="qb-btn" aria-label="Réglages">${ic('gear', 19, 'ico-svg')}</button>
    <button type="button" class="qb-me" aria-label="Compte"><span class="avatar">LU</span>${ic('chev', 14, 'ico-svg')}</button>`;
}
function newSide(x) {
  const it = (k, i, t, extra = '', cls = '') => `<a href="${href(k)}" class="nm-item ${cls} ${on(k) ? 'on' : ''}" title="${t}">${ic(i, cls ? 17 : 19)}<span class="t">${t}</span>${extra}</a>`;
  return `<div class="nm-brand"><img class="l" src="${LOGO_L}" alt="Linkivi"><img class="s" src="${LOGO_S}" alt="Linkivi">
      <button type="button" class="nm-fold" data-m="fold" title="Replier le menu (Ctrl + B)">${ic('panel', 18)}</button></div>
    <div class="nm-list">
      <button type="button" class="nm-item nm-open" data-m="fold" title="Déplier le menu (Ctrl + B)">${ic('panel', 19)}</button>
      ${it('ecrans', 'monitor', 'Écrans', '<span class="nm-bad" title="1 écran hors ligne">1</span>')}
      ${it('listes', 'list', 'Listes de diffusion')}
      ${it('contenus', 'image', 'Contenus')}
      ${x ? it('prog', 'cal', 'Programmations') + it('appr', 'shield', 'Approbations') : ''}
    </div>
    <div class="nm-sec"><span>Applications</span><span class="g"></span>
      <button type="button" title="Gérer mes applications">${ic('sliders', 15)}</button><button type="button" title="Ajouter une application (Store)">${ic('plus', 16)}</button></div>
    <div class="nm-list">${APPS.map(a => it('', a[0], a[1], '', 'sm')).join('')}</div>
    <div class="nm-foot">
      ${x ? it('org', 'team', 'Organisation', '', 'sm') + it('stats', 'chart', 'Statistiques', '', 'sm') + it('hist', 'clock', 'Historique', '', 'sm') + '<div class="nm-rule"></div>' : ''}
      <button type="button" class="nm-item nm-mode ${x ? 'exp' : ''}" data-m="mode" title="Mode expert">${ic('sliders', 17)}<span class="t">Mode expert</span><span class="nm-sw ${x ? 'on' : ''}"></span></button>
    </div>`;
}
function newBar(x) {
  const tabs = HERE === 'contenus' ? ['Médiathèque', 'Compositions'].concat(x ? ['Widgets'] : []) : [];
  return `<nav class="nm-tabs" aria-label="Pages">${tabs.map((t, i) => `<a href="#" class="nm-tab ${i ? '' : 'on'}">${t}</a>`).join('')}</nav><div class="grow"></div>
    ${x ? `<button type="button" class="nm-em">${ic('alert', 16)}Urgence</button>` : ''}
    <button type="button" class="nm-ai" data-t="Assistant (Ctrl + J)">${ic('spark', 17)}Assistant</button>
    ${x ? `<button type="button" class="nm-ib" data-t="Installer le player" aria-label="Installer le player">${ic('down', 19)}</button>` : ''}
    <button type="button" class="nm-ib" data-t="Aide" aria-label="Aide">${ic('help', 19)}</button>
    <button type="button" class="nm-ib" data-t="Notifications" aria-label="Notifications">${ic('bell', 19)}<i class="d"></i></button>
    <button type="button" class="nm-ib" data-t="Réglages" aria-label="Réglages">${ic('gear', 19)}</button>
    <div class="nm-wrap"><button type="button" class="nm-me ${pop ? 'on' : ''}" data-m="me" aria-label="Compte"><span class="avatar">LU</span><b>LPR Unil</b>${ic('chev', 14)}</button>
      ${pop ? `<div class="nm-pop" role="menu"><div class="nm-who"><span class="avatar">LU</span><div><b>LPR Unil</b><small>ludovic@exemple.ch</small></div></div>
        <div class="plan"><span>Plan</span><span class="plan-tag pro">${ic('crown', 13)}Pro</span></div><hr>
        <a href="#">${ic('user')}Mon compte</a>${x ? `<a href="#">${ic('card')}Abonnement et facturation</a><a href="#">${ic('team')}Organisation</a>` : ''}
        <a href="#">${ic('help')}Aide et contact</a><hr><a href="#" class="out">${ic('logout')}Se déconnecter</a></div>` : ''}</div>`;
}
function draw() {
  const x = st.mode === 'expert', nw = st.ver === 'new';
  document.body.classList.toggle('nm', nw);
  document.documentElement.classList.toggle('nav-shut', st.fold === 'shut');
  $('#nm-sb').innerHTML = nw ? newSide(x) : oldSide(x);
  $('#nm-qb').innerHTML = nw ? newBar(x) : oldBar(x);
  for (const k of ['ver', 'mode', 'fold']) document.querySelectorAll(`#mm-${k} .mk-btn`).forEach(b => b.classList.toggle('on', b.dataset.v === st[k]));
  try { localStorage.setItem('mk-menu-refonte', JSON.stringify(st)); } catch (e) { }
}
document.addEventListener('click', e => {
  const seg = e.target.closest('#mm-ver, #mm-mode, #mm-fold'), b = e.target.closest('.mk-btn'), m = e.target.closest('[data-m]');
  const hadPop = pop; pop = false;
  if (seg && b) { st[seg.id.slice(3)] = b.dataset.v; draw(); return; }
  if (e.target.closest('.content .hub-tabs a, .nm-tabs a, .nm-pop a')) { e.preventDefault(); e.stopPropagation(); if (hadPop) draw(); return; }
  if (m) {
    e.preventDefault(); e.stopPropagation();
    if (m.dataset.m === 'fold') st.fold = st.fold === 'shut' ? 'open' : 'shut';
    if (m.dataset.m === 'mode') st.mode = st.mode === 'expert' ? 'simple' : 'expert';
    if (m.dataset.m === 'me') pop = !hadPop;
    draw(); return;
  }
  if (hadPop) draw();
}, true);
document.addEventListener('keydown', e => { if ((e.ctrlKey || e.metaKey) && e.key.toLowerCase() === 'b') { e.preventDefault(); st.fold = st.fold === 'shut' ? 'open' : 'shut'; draw(); } });
addEventListener('scroll', () => document.body.classList.toggle('scrolled', scrollY > 6), { passive: true });
draw();
})();
</script>
