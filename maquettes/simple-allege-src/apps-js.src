/* ---------- Applications : Mes applications, Store, page d'une application ---------- */
document.querySelectorAll('[data-i]').forEach(e => { e.outerHTML = ico(e.dataset.i, +(e.dataset.s || 18)); });
document.querySelectorAll('[data-nav]').forEach(a => { if (a.dataset.nav === 'apps') { a.classList.add('active'); a.setAttribute('aria-current', 'page'); } });
document.title = 'Applications allégées (mode Simple)';
$('#mk-title').textContent = 'Pages Applications allégées';
$('#tabs').remove();
IC.gear = '<circle cx="12" cy="12" r="3"/><path d="M19.4 15a1.7 1.7 0 0 0 .3 1.8l.1.1a2 2 0 1 1-2.8 2.8l-.1-.1a1.7 1.7 0 0 0-2.8 1.2V21a2 2 0 1 1-4 0v-.1a1.7 1.7 0 0 0-2.900-1.200l-.1.1a2 2 0 1 1-2.800-2.800l.1-.1a1.7 1.7 0 0 0-1.200-2.900H3a2 2 0 1 1 0-4h.1a1.7 1.7 0 0 0 1.200-2.900l-.1-.1a2 2 0 1 1 2.800-2.800l.1.1a1.7 1.7 0 0 0 2.900-1.200V3a2 2 0 1 1 4 0v.1a1.7 1.7 0 0 0 2.900 1.200l.1-.1a2 2 0 1 1 2.800 2.800l-.1.1a1.7 1.7 0 0 0 1.200 2.900H21a2 2 0 1 1 0 4h-.1a1.7 1.7 0 0 0-1.500 1z"/>';
IC.check = '<path d="M20 6 9 17l-5-5"/>';
IC.info = '<circle cx="12" cy="12" r="10"/><path d="M12 16v-4M12 8h.01"/>';
IC.back = '<path d="M15 6l-6 6 6 6"/>';
IC.refresh = '<path d="M21 12a9 9 0 1 1-3-6.7L21 8"/><path d="M21 3v5h-5"/>';

const MINE = () => [
  { id: 'image', name: 'Images', c: '#2F6FC0', l: 'Im', cat: 'Médias', n: 12, base: true, menu: false },
  { id: 'video', name: 'Vidéos', c: '#8A52B8', l: 'Vi', cat: 'Médias', n: 4, base: true, menu: false },
  { id: 'slides', name: "Diaporama d'images", c: '#2F9B66', l: 'Di', cat: 'Médias', n: 2, base: true, menu: false },
  { id: 'web', name: 'Page web', c: '#4A5F7D', l: 'Web', cat: 'Web', n: 1, base: true, menu: true },
  { id: 'compo', name: 'Compositions', c: '#E8872B', l: 'Co', cat: 'Création', n: 6, base: true, menu: false },
  { id: 'meteo', name: 'Météo', c: '#4B92D4', l: '☀', cat: 'Infos pratiques', n: 3, menu: true },
  { id: 'youtube', name: 'YouTube', c: '#D93025', l: '▶', cat: 'Web', n: 2, menu: true },
  { id: 'clock', name: 'Horloge', c: '#12315C', l: '◷', cat: 'Infos pratiques', n: 0, menu: false }
];
const STORE = () => [
  { id: 'gslides', name: 'Google Slides', c: '#F4B400', l: 'G', cat: 'Présentations', d: 'Vos présentations, converties en images' },
  { id: 'canva', name: 'Canva', c: '#00C4CC', l: 'C', cat: 'Création', d: 'Vos créations Canva sur vos écrans' },
  { id: 'pdf', name: 'PDF', c: '#C0392B', l: 'PDF', cat: 'Présentations', d: 'Un document, une page par écran' },
  { id: 'rss', name: 'Flux RSS', c: '#E8872B', l: 'RSS', cat: 'Infos pratiques', d: "Les titres d'un site d'actualités" },
  { id: 'qr', name: 'QR code', c: '#0B1F3A', l: 'QR', cat: 'Web', d: 'Un lien à scanner, avec comptage' },
  { id: 'room', name: 'Réservation de salle', c: '#2E8B57', l: 'Sa', cat: 'Bâtiment', d: 'Tablette à la porte des salles' },
  { id: 'ha', name: 'Home Assistant', c: '#18BCF2', l: 'HA', cat: 'Bâtiment', d: 'Capteurs et appareils du bâtiment' },
  { id: 'insta', name: 'Instagram', c: '#D4577B', l: 'In', cat: 'Web', d: "Les dernières publications d'un compte" }
];
const ITEMS = () => [
  { id: 1, name: 'Météo Lausanne', g: 'g1', use: 2, on: true },
  { id: 2, name: 'Météo Genève', g: 'g5', use: 1, on: true },
  { id: 3, name: 'Météo 5 jours', g: 'g4', use: 0, on: false }
];
let A = MINE(), ST = STORE(), IT = ITEMS(), ver = 'new', view = 'mine', q = '', qOpen = false, menu = null, ren = null, cur = 'meteo', win = null;
const icon = (a, big) => `<span class="ap-ic ${big ? 'big' : ''}" style="background:${a.c}">${a.l}</span>`;
const sw = (on, a, label) => `<button type="button" class="switch ${on ? 'on' : ''}" role="switch" aria-checked="${on}" aria-label="${label}" data-a="${a}"><span></span></button>`;
const match = a => !q || a.name.toLowerCase().includes(q.toLowerCase());
const groups = list => [...new Set(list.map(a => a.cat))].map(c => [c, list.filter(a => a.cat === c)]);
const chips = list => `<div class="int-chips" style="display:flex;gap:8px;flex-wrap:wrap;margin:0 0 18px"><button type="button" class="chip on">Toutes <small>${list.length}</small></button>${groups(list).map(g => `<button type="button" class="chip">${g[0]} <small>${g[1].length}</small></button>`).join('')}</div>`;
const search = ph => `<label class="es-q ${qOpen ? 'on' : ''}">${ico('search', 16)}<input id="q" placeholder="${ph}" aria-label="Rechercher" value="${q}"></label>${qOpen ? '' : `<button type="button" class="es-ib tb" data-a="q" data-tip="Rechercher" aria-label="Rechercher">${ico('search', 18)}</button>`}`;
const crumb = `<div class="pt-crumb ap-crumb"><a href="#" data-a="go" data-v="mine">‹ Applications</a></div>`;

function mineCard(a) {
  const neu = ver === 'new';
  const km = menu === a.id ? `<div class="kebab-menu" role="menu">
      <button type="button" data-a="openapp">${ico('open', 16)} Ouvrir</button>
      <button type="button" data-a="conf">${ico('sliders', 16)} Configurer</button>
      <button type="button" data-a="tmenu">${a.menu ? ico('check', 16) : '<span style="width:16px"></span>'} Afficher dans le menu</button>
      ${a.base ? '' : `<hr><button type="button" class="danger" data-a="unin">${ico('trash', 16)} Désinstaller</button>`}</div>` : '';
  return `<div class="ap" data-id="${a.id}" data-a="openapp">${neu ? '' : '<input type="checkbox" class="sc-check ap-ck" aria-label="Sélectionner">'}${icon(a)}
    <div class="ap-t"><b>${a.name}</b><small>${neu ? (a.n ? pl(a.n, 'contenu') : 'Aucun contenu') : `${a.cat} · ${a.n ? pl(a.n, 'contenu') : 'non utilisée'}`}</small></div>
    ${neu ? '' : sw(true, 'noop', 'Active')}
    <div class="lc-kw ${menu === a.id ? 'open' : ''}"><button type="button" class="kebab-btn" data-a="menu" aria-label="Actions pour ${a.name}">${ico('dots', 18)}</button>${km}</div></div>`;
}
const storeCard = a => `<div class="ap st" data-id="${a.id}">${icon(a)}<div class="ap-t"><b>${a.name}</b><small>${a.d}</small></div><button type="button" class="btn ghost sm" data-a="use">Utiliser</button></div>`;
function itemRow(x) {
  const km = menu === 'i' + x.id ? `<div class="kebab-menu" role="menu"><button type="button" data-a="iedit">${ico('edit', 16)} Modifier</button><button type="button" data-a="idup">${ico('copy', 16)} Dupliquer</button><hr><button type="button" class="danger" data-a="idel">${ico('trash', 16)} Supprimer</button></div>` : '';
  const name = ren === x.id ? `<input class="es-ni" id="ni" value="${x.name}" aria-label="Nom">` : `<span class="lc-name" data-a="${ver === 'new' ? 'iren' : 'iedit'}">${x.name}</span>`;
  return `<div class="ar ${x.on ? '' : 'off'}" data-iid="${x.id}"><span class="ar-th ${x.g}">10°</span>
    <div class="ar-n"><div class="lc-nm">${name}</div><small>${x.on ? (x.use ? 'Dans ' + pl(x.use, 'liste') : 'Dans aucune liste') : "Désactivé : n'apparaît plus nulle part"}</small></div>
    ${sw(x.on, 'ion', 'Actif')}
    <div class="lc-kw ${menu === 'i' + x.id ? 'open' : ''}"><button type="button" class="kebab-btn" data-a="imenu" aria-label="Actions">${ico('dots', 18)}</button>${km}</div></div>`;
}
function winHtml() {
  const a = A.find(x => x.id === cur);
  if (!win) return '';
  const body = win === 'conf'
    ? `<label class="ap-f">Ville par défaut<input value="Lausanne"></label><label class="ap-f">Unité<select><option>Celsius</option><option>Fahrenheit</option></select></label>`
    : `<p class="ap-info"><b>Météo</b> · version 1.2 · installée le 02.11.2026</p><p class="ap-info">Affiche le temps qu'il fait et les prévisions, pour la ville de votre choix.</p>`;
  return `<div class="ap-ov" data-a="close"><div class="ap-win" role="dialog" aria-modal="true"><h2>${win === 'conf' ? 'Configurer ' + a.name : 'À propos de ' + a.name}</h2>${body}
    <div class="ap-foot"><button type="button" class="btn ghost" data-a="close">${win === 'conf' ? 'Annuler' : 'Fermer'}</button>${win === 'conf' ? '<button type="button" class="btn" data-a="save">Enregistrer</button>' : ''}</div></div></div>`;
}

function render() {
  document.body.className = 'v-' + ver;
  const neu = ver === 'new';
  let h = '';
  if (view === 'mine') {
    const list = A.filter(match);
    if (neu) h += `<header class="es-head"><div><h1>Applications</h1><p class="es-meta"><span>${pl(A.length, 'application')}</span></p></div>
        <div class="es-act">${search('Rechercher')}<button type="button" class="btn es-add" data-a="go" data-v="store">${ico('plus', 16)} Ajouter</button></div></header>
        ${list.length ? `<div class="ap-grid">${list.map(mineCard).join('')}</div>` : '<div class="es-none">Aucune application trouvée</div>'}`;
    else h += `<div class="page-head"><div><h1>Mes applications</h1><p class="sub">Vos applications installées : leur état, leur configuration, et celles qui apparaissent dans le menu.</p></div></div>
        <div class="old-tools"><label class="search-box">${ico('search', 16)}<input id="q" placeholder="Rechercher une application" value="${q}"></label></div>${chips(A)}
        ${groups(list).map(g => `<h2 class="cat-group">${g[0]} <span class="cat-count">${g[1].length}</span></h2><div class="ap-grid" style="margin-bottom:22px">${g[1].map(mineCard).join('')}</div>`).join('')}`;
  } else if (view === 'store') {
    const list = ST.filter(match);
    if (neu) h += `${crumb}<header class="es-head"><div><h1>Store</h1><p class="es-meta"><span>${ST.length ? pl(ST.length, 'application') + ' à ajouter' : 'Vous utilisez déjà toutes les applications'}</span></p></div>
        <div class="es-act">${ST.length ? search('Rechercher') : ''}</div></header>
        ${list.length ? `<div class="ap-grid">${list.map(storeCard).join('')}</div>` : ST.length ? '<div class="es-none">Aucune application trouvée</div>' : ''}`;
    else h += `<div class="page-head"><div><h1>Store</h1><p class="sub">Les applications que vous pouvez ajouter. « Utiliser » l'installe et la configure.</p></div></div>
        <div class="old-tools"><label class="search-box">${ico('search', 16)}<input id="q" placeholder="Rechercher une application" value="${q}"></label></div>${chips(ST)}
        ${groups(list).map(g => `<h2 class="cat-group">${g[0]} <span class="cat-count">${g[1].length}</span></h2><div class="ap-grid" style="margin-bottom:22px">${g[1].map(storeCard).join('')}</div>`).join('')}`;
  } else {
    const a = A.find(x => x.id === cur) || A[0], act = IT.filter(x => x.on).length;
    if (neu) h += `${crumb}<header class="es-head"><div class="ap-hd">${icon(a, true)}<div><h1>${a.name}</h1><p class="es-meta"><span>${IT.length ? `${pl(IT.length, 'contenu')} · ${pl(act, 'actif')}` : 'Aucun contenu'}</span></p></div></div>
        <div class="es-act"><button type="button" class="es-ib tb" data-a="conf" data-tip="Configurer" aria-label="Configurer">${ico('sliders', 18)}</button>
        <div style="position:relative"><button type="button" class="es-ib tb" data-a="hmenu" data-tip="Plus" aria-label="Plus d'actions">${ico('dots', 18)}</button>${menu === 'head' ? `<div class="kebab-menu es-menu" role="menu" style="min-width:230px">
          <button type="button" data-a="tmenu2">${a.menu ? ico('check', 16) : '<span style="width:16px"></span>'} Afficher dans le menu</button>
          <button type="button" data-a="info">${ico('info', 16)} À propos</button>
          ${a.base ? '' : `<hr><button type="button" class="danger" data-a="unin2">${ico('trash', 16)} Désinstaller</button>`}</div>` : ''}</div></div></header>
        ${IT.length ? `<div class="ar-list">${IT.map(itemRow).join('')}</div>` : `<div class="es-empty"><i>${ico('sliders', 28)}</i><b>Aucun contenu pour l'instant</b>Réglez l'application pour créer son premier contenu.<br><button type="button" class="btn" data-a="conf">Configurer</button></div>`}`;
    else h += `<div class="page-head"><div class="ap-hd">${icon(a, true)}<div><h1>${a.name}</h1><p class="sub">${a.cat} · version 1.2 · installée le 02.11.2026</p></div></div>
        <div class="row head-actions" style="display:flex;gap:10px">${a.base ? '' : '<button type="button" class="btn ghost danger-text">Désinstaller</button>'}</div></div>
        <nav class="tabs int-tabs" role="tablist"><button type="button" role="tab" class="on">Contenus <span class="cat-count">${IT.length}</span></button><button type="button" role="tab">Configuration</button><button type="button" role="tab">Infos</button></nav>
        <div class="ar-list" style="margin-top:16px">${IT.map(itemRow).join('')}</div>`;
  }
  $('#page').innerHTML = h + winHtml();
  const ni = $('#ni'); if (ni) { ni.focus(); ni.select(); }
  $('#mk-view').querySelectorAll('.mk-btn').forEach(b => b.classList.toggle('on', b.dataset.v === view));
}

document.addEventListener('click', e => {
  if (e.target.closest('.mk-note, .sidebar, .qbar')) return;
  if (e.target.closest('#ni, #q, .ap-ck, .ap-win input, .ap-win select')) return;
  const a = e.target.closest('[data-a]'), host = e.target.closest('[data-id]'), app = host && [...A, ...ST].find(x => x.id === host.dataset.id);
  const ih = e.target.closest('[data-iid]'), it = ih && IT.find(x => x.id == ih.dataset.iid);
  const had = menu; menu = null;
  if (!a) { if (had) render(); return; }
  if (a.dataset.a === 'close' && e.target.closest('.ap-win') && !e.target.closest('button')) { menu = had; return; }
  e.preventDefault();
  switch (a.dataset.a) {
    case 'go': view = a.dataset.v; q = ''; qOpen = false; break;
    case 'q': qOpen = true; render(); $('#q').focus(); return;
    case 'menu': menu = app.id; break;
    case 'imenu': menu = 'i' + it.id; break;
    case 'hmenu': menu = had === 'head' ? null : 'head'; break;
    case 'openapp': cur = app.id; view = 'app'; if (app.id !== 'meteo') toast(`La maquette montre la page de Météo ; celle de « ${app.name} » suit le même modèle`); cur = 'meteo'; break;
    case 'conf': if (app) cur = 'meteo'; win = 'conf'; break;
    case 'info': win = 'info'; break;
    case 'close': win = null; break;
    case 'save': win = null; toast('Configuration enregistrée'); break;
    case 'tmenu': app.menu = !app.menu; toast(app.menu ? `« ${app.name} » apparaît dans le menu` : `« ${app.name} » retirée du menu`); break;
    case 'tmenu2': { const x = A.find(y => y.id === cur); x.menu = !x.menu; toast(x.menu ? 'Affichée dans le menu' : 'Retirée du menu'); break; }
    case 'unin': A = A.filter(x => x !== app); ST.unshift({ ...app, d: 'Retirée : « Utiliser » la réinstalle' }); toast(`« ${app.name} » désinstallée (après confirmation dans l'application)`); break;
    case 'unin2': { const x = A.find(y => y.id === cur); A = A.filter(y => y !== x); view = 'mine'; toast(`« ${x.name} » désinstallée (après confirmation dans l'application)`); break; }
    case 'use': ST = ST.filter(x => x !== app); A.push({ ...app, n: 0, menu: true }); view = 'mine'; toast(`Ouvre l'assistant d'ajout de « ${app.name} »`); break;
    case 'ion': it.on = !it.on; break;
    case 'iren': ren = it.id; break;
    case 'iedit': toast(`Ouvre la fiche du contenu « ${it.name} »`); break;
    case 'idup': IT.splice(IT.indexOf(it) + 1, 0, { ...it, id: Date.now(), name: it.name + ' (copie)', use: 0 }); break;
    case 'idel': IT = IT.filter(x => x !== it); toast(`« ${it.name} » supprimé (après confirmation dans l'application)`); break;
  }
  render();
});
document.addEventListener('input', e => { if (e.target.id === 'q') { q = e.target.value; const p = e.target.selectionStart; render(); const n = $('#q'); n.focus(); n.setSelectionRange(p, p); } });
document.addEventListener('keydown', e => {
  if (e.target.id === 'ni' && (e.key === 'Enter' || e.key === 'Escape')) { if (e.key === 'Enter' && e.target.value.trim()) IT.find(x => x.id === ren).name = e.target.value.trim(); ren = null; render(); }
  if (e.target.id === 'q' && e.key === 'Escape') { q = ''; qOpen = false; render(); }
});
document.addEventListener('focusout', e => {
  if (e.target.id === 'ni' && ren != null) { const s = IT.find(x => x.id === ren); if (e.target.value.trim()) s.name = e.target.value.trim(); ren = null; setTimeout(render); }
  if (e.target.id === 'q' && !q) { qOpen = false; setTimeout(render); }
});
function seg(id, fn) { $(id).addEventListener('click', e => { const b = e.target.closest('.mk-btn'); if (!b) return; $(id).querySelectorAll('.mk-btn').forEach(x => x.classList.toggle('on', x === b)); fn(b.dataset.v); render(); }); }
seg('#mk-ver', v => ver = v);
seg('#mk-view', v => { view = v; q = ''; qOpen = false; menu = null; win = null; });
render();
</script>
</body>
</html>
