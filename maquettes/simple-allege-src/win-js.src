/* ---------- Fenêtres de la page Écrans, menu ⋯ d'un écran, contenus d'une application ---------- */
document.querySelectorAll('[data-i]').forEach(e => { e.outerHTML = ico(e.dataset.i, +(e.dataset.s || 18)); });
document.querySelectorAll('[data-nav]').forEach(a => { if (a.dataset.nav === 'ecrans') { a.classList.add('active'); } });
document.title = 'Fenêtres des écrans et contenus allégés (mode Simple)';
$('#mk-title').textContent = "Fenêtres de la page Écrans, menu ⋯ et contenus d'une application";
$('#tabs').remove();
IC.check = '<path d="M20 6 9 17l-5-5"/>';
IC.tool = '<path d="M14.7 6.3a4 4 0 0 0-5.4 5.4L3 18l3 3 6.300-6.300a4 4 0 0 0 5.400-5.400l-2.700 2.700-2.300-2.300z"/>';
IC.info = '<circle cx="12" cy="12" r="10"/><path d="M12 16v-4M12 8h.01"/>';
IC.chevr = '<path d="M9 6l6 6-6 6"/>';
IC.pc = '<rect x="2" y="4" width="14" height="10" rx="1.5"/><rect x="8" y="9" width="14" height="10" rx="1.5"/>';
IC.door = '<path d="M5 21V4a1 1 0 0 1 1-1h12a1 1 0 0 1 1 1v17M3 21h18"/><path d="M15 12h.01"/>';

let ver = 'new', view = 'menu', adv = false, more = false, help = false, orient = 'l', ktab = 'home';
let items = [
  { id: 1, name: 'Météo Lausanne', g: 'g1', t: 'Météo du jour', lists: 2, scr: 3, on: true, d: '02.11.2026' },
  { id: 2, name: 'Météo Genève', g: 'g5', t: 'Météo du jour', lists: 1, scr: 1, on: true, d: '04.11.2026' },
  { id: 3, name: 'Prévisions 5 jours', g: 'g4', t: 'Prévisions', lists: 0, scr: 0, on: false, d: '08.11.2026' }
];
const sw = (on, a, label) => `<button type="button" class="switch ${on ? 'on' : ''}" role="switch" aria-checked="${on}" aria-label="${label || ''}" data-a="${a || 'noop'}"><span></span></button>`;
const fold = (key, open, title, sub, body) => `<div class="wz-fold ${open ? 'open' : ''}"><button type="button" class="wz-fh" data-a="${key}">${ico(open ? 'chev' : 'chevr', 16)}<b>${title}</b><small>${sub}</small></button>${open ? `<div class="wz-fb">${body}</div>` : ''}</div>`;
const field = (l, c) => `<label class="wz-f"><span>${l}</span>${c}</label>`;
const sel = (opts) => `<select>${opts.map(o => `<option>${o}</option>`).join('')}</select>`;
const seg = (a, b, onA, act) => `<span class="wz-seg"><button type="button" class="${onA ? 'on' : ''}" data-a="${act}" data-v="l">${a}</button><button type="button" class="${onA ? '' : 'on'}" data-a="${act}" data-v="p">${b}</button></span>`;
const row = (t, s, c) => `<div class="wz-row"><div><b>${t}</b>${s ? `<small>${s}</small>` : ''}</div>${c}</div>`;
const tv = (label, g, p) => `<div class="wz-tv ${p ? 'p' : ''}"><div class="ec-tvw ${p ? 'p' : ''}"><div class="ec-tv"><span class="es-z ${g}">${label}</span></div><span class="ec-neck"></span><span class="ec-base"></span></div></div>`;
const LISTS = ['Menu du jour', 'Promotions', 'Accueil visiteurs', 'Consignes'];

/* fond : la page Écrans allégée, deux cartes */
function card(name, list, g, on, withMenu) {
  const menu = !withMenu ? '' : ver === 'new'
    ? `<div class="kebab-menu wz-menu" role="menu"><button type="button" data-a="go" data-v="edit">${ico('sliders', 16)} Modifier l'écran</button><button type="button" data-a="t" data-t="Ouvre le simulateur">${ico('play', 16)} Simuler</button><hr><button type="button" class="danger" data-a="t" data-t="Demande une confirmation, puis supprime l'écran">${ico('trash', 16)} Supprimer</button></div>`
    : `<div class="kebab-menu wz-menu" role="menu"><button type="button" data-a="go" data-v="edit">${ico('sliders', 16)} Éditer l'écran</button><button type="button">${ico('play', 16)} Simuler</button><hr><button type="button" data-a="go" data-v="edit">${ico('tool', 16)} Paramètres de l'écran</button><button type="button">${ico('plus', 16)} <span>Ajouter un écran sur ce PC<small style="display:block;color:var(--muted);font-size:12px">Nouvel écran déjà appairé, sans code</small></span></button><hr><button type="button">${ico('edit', 16)} Renommer</button><hr><button type="button" class="danger">${ico('trash', 16)} Supprimer</button></div>`;
  return `<div class="pl-card ec wz-card"><div class="ec-top"><div class="ec-stage ${on ? '' : 'dim'}"><div class="ec-tvw"><div class="ec-tv"><span class="es-z ${g}">${list}</span></div><span class="ec-neck"></span><span class="ec-base"></span></div></div>
    <span class="ec-stat ${on ? 'on' : 'off'}"><i class="d"></i>${on ? 'En ligne' : 'Hors ligne'}</span></div>
    <div class="ec-bd"><div class="ec-nm"><span class="ec-kd">${ico('monitor', 16)}</span><span class="ec-name">${name}</span><div class="ec-kw wz-kw"><button type="button" class="kebab-btn" aria-label="Actions">${ico('dots', 18)}</button>${menu}</div></div>
    <div class="ec-pl" style="width:auto;margin:7px 0 0 -8px">${ico('playbox', 14)}<span class="ec-pln">${list}</span></div></div></div>`;
}
const bg = withMenu => `<header class="es-head"><div><h1>Écrans</h1><p class="es-meta"><span>3 écrans</span><span>·</span><span style="color:var(--danger);font-weight:500">1 hors ligne</span></p></div>
  <div class="es-act"><button type="button" class="es-ib" aria-label="Rechercher">${ico('search', 18)}</button><button type="button" class="es-ib" disabled aria-label="Publier">${ico('upload', 18)}</button><button type="button" class="btn es-add" data-a="go" data-v="pair">${ico('plus', 16)} Ajouter</button></div></header>
  <div class="lc-grid" style="grid-template-columns:repeat(auto-fill,minmax(252px,1fr))">${card('Accueil', 'Menu du jour', 'g3', true, withMenu)}${card('Hall', 'Promotions', 'g2', true)}${card('Réserve', 'Consignes', 'g5', false)}</div>`;
const win = (cls, title, sub, body, foot) => `<div class="wz-ov"><div class="wz-win ${cls}" role="dialog" aria-modal="true"><div class="wz-h"><div><h2>${title}</h2>${sub ? `<small>${sub}</small>` : ''}</div><button type="button" class="wz-x" data-a="go" data-v="menu" aria-label="Fermer">${ico('x', 20)}</button></div><div class="wz-b">${body}</div><div class="wz-ft">${foot}</div></div></div>`;

/* ----- Connecter un écran ----- */
function pair() {
  const picks = `<div class="wz-picks">${[['Windows', '.msi'], ['Android / TV', '.apk'], ['Navigateur', 'Sans installation'], ['Linux', '.tar.gz']].map(p => `<span class="wz-pick"><b>${p[0]}</b><small>${p[1]}</small></span>`).join('')}</div>`;
  if (ver === 'old') return win('wide', 'Connecter un écran', '',
    `<div class="wz-step"><i>1</i> Installez le player sur l'écran <span>(une fois par écran)</span></div>${picks}
     <div class="wz-step"><i>2</i> Saisissez le code à 6 chiffres affiché sur l'écran</div>
     <div class="wz-grid">${field('Code', '<input class="wz-code sm" placeholder="000000" maxlength="6">')}${field("Nom de l'écran", '<input placeholder="Ex. Accueil, salle de pause">')}${field('Liste de lecture', sel(['— Aucune liste de lecture —', ...LISTS]))}
     ${field('Orientation', sel(['Paysage', 'Portrait']))}${field('Résolution', sel(['Automatique', '1920 × 1080', '3840 × 2160']))}</div>
     ${row('Plein écran', 'Coupé : sur un PC Windows, le player passe en fenêtre à la taille de la résolution dès l\'appairage. Pratique pour tester plusieurs écrans sur un PC.', sw(true))}
     <p class="wz-hint">${ico('info', 14)} Cet écran sera facturé 15.90 CHF par mois, au prorata.</p>`,
    `<button type="button" class="btn ghost" data-a="go" data-v="menu">Annuler</button><button type="button" class="btn">Connecter l'écran</button>`);
  return win('', 'Connecter un écran', '',
    `<p class="wz-lead">Saisissez le code à 6 chiffres affiché sur l'écran.</p>
     <input class="wz-code" placeholder="000000" maxlength="6" inputmode="numeric" aria-label="Code">
     ${field("Nom de l'écran", '<input placeholder="Ex. Accueil, salle de pause">')}${field('Liste de lecture', sel(LISTS))}
     ${fold('help', help, "L'écran n'affiche pas de code ?", 'Installer le player', `<p class="wz-hint" style="margin:0 0 10px">Installez le player une fois sur l'écran : il affichera son code.</p>${picks}`)}
     ${fold('more', more, 'Plus d\'options', 'Orientation, fenêtre de test', `${field('Orientation', seg('Paysage', 'Portrait', orient === 'l', 'orient'))}${row('Plein écran', 'Coupé : le player s\'ouvre en fenêtre, pour tester sur un PC.', sw(true))}`)}`,
    `<small class="wz-price">15.90 CHF par mois, au prorata</small><button type="button" class="btn ghost" data-a="go" data-v="menu">Annuler</button><button type="button" class="btn" data-a="t" data-t="Écran connecté : sa carte apparaît dans la page">Connecter</button>`);
}

/* ----- Modifier l'écran (Éditer + Paramètres) ----- */
function edit() {
  if (ver === 'old') return win('wide', 'Accueil', 'Deux fenêtres aujourd\'hui : « Éditer l\'écran » (ci-dessous) et « Paramètres de l\'écran » (menu ⋯)',
    `<div class="wz-two"><div>${tv('Menu du jour', 'g3')}</div><div>
       <div class="wz-tabs"><button type="button" class="on">${ico('monitor', 15)} Écran</button><button type="button">Bandeaux</button><button type="button">${ico('grid', 15)} Widgets</button></div>
       ${field('Liste de lecture', sel(LISTS))}${field('Zone', sel(['Défaut']))}${field('Découpage de l\'écran', sel(['Plein écran', '2 zones', '3 zones']))}
       <div class="wz-old2"><b>Paramètres de l'écran</b><small>Affichage : orientation, résolution, miroir horizontal, miroir vertical · Appareil : démarrage automatique, afficher dans une fenêtre, moniteur</small></div></div></div>`,
    `<button type="button" class="btn ghost" data-a="go" data-v="menu">Annuler</button><button type="button" class="btn ghost">Enregistrer</button><button type="button" class="btn">Enregistrer et publier</button>`);
  return win('wide', 'Modifier l\'écran', 'Accueil · Android TV',
    `<div class="wz-two"><div>${tv('Menu du jour', 'g3', orient === 'p')}<p class="wz-hint" style="text-align:center">Ce que l'écran affichera</p></div><div>
       ${field('Nom', '<input value="Accueil">')}${field('Liste de lecture', sel(LISTS))}${field('Orientation', seg('Paysage', 'Portrait', orient === 'l', 'orient'))}
       ${fold('more', more, 'Bandeaux et widgets', 'Aucun', `<p class="wz-hint" style="margin:0">Heure, météo ou message par-dessus la liste. ${'<button type="button" class="es-rl2" data-a="t" data-t="Ouvre le choix des bandeaux et des widgets">Ajouter…</button>'}</p>`)}
       ${fold('adv', adv, 'Avancé', 'Résolution, miroir, démarrage', `${field('Résolution', sel(['Automatique (1920 × 1080 détectée)', '1920 × 1080', '3840 × 2160']))}${row('Miroir horizontal', '', sw(false))}${row('Miroir vertical', '', sw(false))}${row('Démarrage automatique', 'Le player revient tout seul après une coupure.', sw(true))}`)}
     </div></div>`,
    `<button type="button" class="btn ghost" data-a="go" data-v="menu">Annuler</button><button type="button" class="btn ghost" data-a="t" data-t="Enregistré, sans publier">Enregistrer</button><button type="button" class="btn publish-btn" data-a="t" data-t="Enregistré et publié sur Accueil">${ico('upload', 16)} Publier</button>`);
}

/* ----- Borne interactive ----- */
function kiosk() {
  const pv = `<div class="wz-seg2">${seg('Accueil', 'Inactivité', ktab === 'home', 'ktab')}</div>${ktab === 'home' ? `<div class="wz-tv p"><div class="ec-tvw p"><div class="ec-tv" style="flex-direction:column;gap:2px;padding:3px"><span class="es-z g1"></span><span class="es-z g3"></span><span class="es-z g2"></span></div><span class="ec-neck"></span><span class="ec-base"></span></div></div>` : tv('Promotions', 'g2', true)}`;
  if (ver === 'old') return win('wide', 'Borne entrée Sud', 'Une fenêtre à deux onglets, plus une fenêtre « Paramètres » à trois onglets',
    `<div class="wz-two"><div>${pv}</div><div>
       <div class="wz-tabs"><button type="button" class="on">${ico('monitor', 15)} Écran</button><button type="button">${ico('grid', 15)} Widgets</button></div>
       <h4 class="wz-h4">Liste interactive</h4>${field('Changer de liste', sel(['Accueil du bâtiment', 'Menu de la cafétéria']))}
       <h4 class="wz-h4">Format de l'écran</h4>${field('Orientation', sel(['Portrait', 'Paysage']))}
       <h4 class="wz-h4">Inactivité</h4>${field('Liste de lecture', sel(LISTS))}${field('Découpage de l\'écran', sel(['Plein écran', '2 zones']))}${field('Bouton « Touchez l\'écran pour commencer »', sel(['Carte', 'Bandeau', 'Bouton']))}
       <div class="wz-old2"><b>Paramètres (autre fenêtre)</b><small>Visiteur : retours automatiques, accessibilité, session · Verrouillage : sortie, accès technicien · Appareil : résolution, veille, mode d'affichage</small></div></div></div>`,
    `<button type="button" class="btn ghost" data-a="go" data-v="menu">Annuler</button><button type="button" class="btn ghost">Paramètres…</button><button type="button" class="btn">Enregistrer</button>`);
  return win('wide', 'Modifier la borne', 'Borne entrée Sud · Windows',
    `<div class="wz-two"><div>${pv}</div><div>
       ${field('Nom', '<input value="Borne entrée Sud">')}${field('Liste interactive', sel(['Accueil du bâtiment', 'Menu de la cafétéria']))}${field('Liste de lecture quand personne ne touche', sel(LISTS))}
       ${fold('more', more, 'Écran d\'attente', 'Bouton « Touchez l\'écran », widgets', `${field('Bouton « Touchez l\'écran pour commencer »', sel(['Carte', 'Bandeau', 'Bouton']))}<p class="wz-hint" style="margin:0">Widgets par-dessus la diffusion : <button type="button" class="es-rl2" data-a="t" data-t="Ouvre le choix des widgets">Ajouter…</button></p>`)}
       ${fold('adv', adv, 'Avancé', 'Retours automatiques, verrouillage, appareil', `${field('Retour à l\'accueil après', sel(['1 minute', '2 minutes', '5 minutes']))}${field('Retour à la diffusion après', sel(['2 minutes', '5 minutes']))}${row('Verrouiller la borne', 'Empêche le visiteur d\'en sortir.', sw(true))}${field('Orientation', seg('Paysage', 'Portrait', false, 'noop'))}${row('Repasser en écran de diffusion', 'La liste interactive est conservée.', '<button type="button" class="btn ghost sm">Repasser…</button>')}`)}
     </div></div>`,
    `<button type="button" class="btn ghost" data-a="go" data-v="menu">Annuler</button><button type="button" class="btn" data-a="t" data-t="Borne enregistrée">Enregistrer</button>`);
}

/* ----- Contenus d'une application ----- */
function contents() {
  const act = items.filter(i => i.on).length;
  const head = `<header class="es-head"><div class="ap-hd"><span class="ap-ic big" style="background:#4B92D4">☀</span><div><h1>Météo</h1><p class="es-meta"><span>${ver === 'new' ? `${items.length} contenus · ${act} actifs` : 'Infos pratiques · version 1.2'}</span></p></div></div>
    <div class="es-act"><button type="button" class="es-ib" aria-label="Configurer">${ico('sliders', 18)}</button><button type="button" class="es-ib" aria-label="Plus">${ico('dots', 18)}</button></div></header>`;
  if (ver === 'old') return head + `<div class="wz-bar"><span>${items.length} contenus · ${act} actifs</span><span style="flex:1"></span><button type="button" class="btn ghost sm">Tout activer</button><button type="button" class="btn ghost sm">Tout désactiver</button></div>
    <div class="wz-tblw"><table class="wz-tbl"><thead><tr><th>Contenu</th><th>Type</th><th>Listes de lecture</th><th class="n">Écrans</th><th>Ajouté le</th><th>État</th><th>Actif</th></tr></thead><tbody>
    ${items.map(i => `<tr><td><span class="wz-mini ${i.g}"></span><b>${i.name}</b></td><td>${i.t}</td><td>${i.lists ? (i.lists === 1 ? 'Menu du jour' : i.lists + ' listes') : '—'}</td><td class="n">${i.scr}</td><td>${i.d}</td><td><span class="wz-pill ${i.scr ? 'ok' : ''}">${i.scr ? 'Diffusé' : 'Pas diffusé'}</span></td><td>${sw(i.on, 'ion' + i.id)}</td></tr>`).join('')}</tbody></table></div>`;
  return head + `<div class="ar-list">${items.map(i => `<div class="ar ${i.on ? '' : 'off'}"><span class="ar-th ${i.g}">10°</span>
      <div class="ar-n"><div class="lc-nm"><span class="lc-name" title="Renommer">${i.name}</span></div><small>${!i.on ? "Désactivé : n'apparaît plus nulle part" : i.scr ? `Dans ${pl(i.lists, 'liste')} · sur ${pl(i.scr, 'écran')}` : 'Pas encore diffusé'}</small></div>
      ${sw(i.on, 'ion' + i.id, 'Actif')}<div class="lc-kw"><button type="button" class="kebab-btn" aria-label="Actions" data-a="t" data-t="Menu : Modifier, Dupliquer, Supprimer">${ico('dots', 18)}</button></div></div>`).join('')}</div>`;
}

function render() {
  document.body.className = 'v-' + ver;
  $('#page').innerHTML = view === 'contents' ? contents() : bg(view === 'menu') + (view === 'menu' ? '' : ({ pair, edit, kiosk })[view]());
  $('#mk-view').querySelectorAll('.mk-btn').forEach(b => b.classList.toggle('on', b.dataset.v === view));
}
document.addEventListener('click', e => {
  if (e.target.closest('.mk-note, .sidebar, .qbar')) return;
  if (e.target.closest('.wz-win input, .wz-win select')) return;
  const a = e.target.closest('[data-a]'); if (!a) return;
  e.preventDefault();
  const k = a.dataset.a;
  if (k === 'go') { view = a.dataset.v; adv = more = help = false; }
  else if (k === 't') toast(a.dataset.t);
  else if (k === 'adv') adv = !adv;
  else if (k === 'more') more = !more;
  else if (k === 'help') help = !help;
  else if (k === 'orient') orient = a.dataset.v;
  else if (k === 'ktab') ktab = a.dataset.v === 'l' ? 'home' : 'idle';
  else if (k.startsWith('ion')) { const it = items.find(x => x.id == k.slice(3)); it.on = !it.on; }
  else return;
  render();
});
function segm(id, fn) { $(id).addEventListener('click', e => { const b = e.target.closest('.mk-btn'); if (!b) return; $(id).querySelectorAll('.mk-btn').forEach(x => x.classList.toggle('on', x === b)); fn(b.dataset.v); render(); }); }
segm('#mk-ver', v => ver = v);
segm('#mk-view', v => { view = v; adv = more = help = false; });
render();
</script>
</body>
</html>
