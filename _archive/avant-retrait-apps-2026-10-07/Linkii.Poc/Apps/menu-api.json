{
  "id": "menu-api",
  "name": "Menu restaurant API",
  "version": "1.0.0",
  "category": "Données",
  "icon": "🍽️",
  "kind": "builtin",
  "summary": "Le menu du jour d'un restaurant ou d'une cantine, lu depuis une API.",
  "description": "Indiquez l'adresse d'une API qui renvoie les menus en JSON : une liste de plats (date, catégorie, plat, prix, allergènes), ou une liste de jours contenant leurs plats. Les noms de champs usuels (date, plat, prix, allergènes…) sont reconnus automatiquement ; sinon, indiquez-les. Une clé ou un jeton d'accès peut être fourni. L'API est interrogée par le serveur (toutes les 5 minutes au plus) : l'adresse et la clé ne sont jamais envoyées à l'écran, qui garde la dernière version reçue sans connexion.",
  "placements": [
    "full",
    "top-left",
    "top-right",
    "bottom-left",
    "bottom-right"
  ],
  "provider": "menu-api",
  "data": true,
  "refreshSec": 300,
  "settings": [
    {
      "key": "title",
      "label": "Titre affiché",
      "type": "text",
      "default": "Menu du jour",
      "maxLength": 80
    },
    {
      "key": "url",
      "label": "Adresse de l'API",
      "type": "secret",
      "required": true,
      "placeholder": "https://api.restaurant.example/menus",
      "help": "Réponse JSON attendue, par exemple : [{ \"date\": \"2026-10-12\", \"categorie\": \"Plat\", \"plat\": \"Filet de perche\", \"prix\": 12.5, \"allergenes\": [\"poisson\"] }]. L'adresse est chiffrée et reste sur le serveur."
    },
    {
      "key": "auth",
      "label": "Authentification",
      "type": "select",
      "default": "none",
      "options": [
        { "value": "none", "label": "Aucune" },
        { "value": "bearer", "label": "Jeton (Authorization: Bearer)" },
        { "value": "header", "label": "Clé d'API dans un en-tête" }
      ]
    },
    {
      "key": "headerName",
      "label": "Nom de l'en-tête",
      "type": "text",
      "default": "X-API-Key",
      "showIf": "auth=header",
      "maxLength": 40
    },
    {
      "key": "token",
      "label": "Clé ou jeton d'accès",
      "type": "secret",
      "required": true,
      "showIf": "auth!=none",
      "help": "Chiffré et conservé sur le serveur."
    },
    {
      "key": "listPath",
      "label": "Chemin de la liste",
      "type": "text",
      "placeholder": "data.menus",
      "maxLength": 120,
      "help": "Facultatif : où trouver la liste dans la réponse. Vide : détecté automatiquement."
    },
    {
      "key": "mapping",
      "label": "Noms des champs",
      "type": "select",
      "default": "auto",
      "options": [
        { "value": "auto", "label": "Reconnaissance automatique" },
        { "value": "custom", "label": "Je les indique" }
      ]
    },
    { "key": "fDate", "label": "Champ de la date", "type": "text", "placeholder": "date", "showIf": "mapping=custom", "maxLength": 40 },
    { "key": "fCategory", "label": "Champ de la catégorie", "type": "text", "placeholder": "categorie", "showIf": "mapping=custom", "maxLength": 40 },
    { "key": "fName", "label": "Champ du plat", "type": "text", "placeholder": "plat", "showIf": "mapping=custom", "maxLength": 40 },
    { "key": "fPrice", "label": "Champ du prix", "type": "text", "placeholder": "prix", "showIf": "mapping=custom", "maxLength": 40 },
    { "key": "fAllergens", "label": "Champ des allergènes", "type": "text", "placeholder": "allergenes", "showIf": "mapping=custom", "maxLength": 40 },
    {
      "key": "showPrice",
      "label": "Afficher les prix",
      "type": "bool",
      "default": "true"
    },
    {
      "key": "showAllergens",
      "label": "Afficher les allergènes",
      "type": "bool",
      "default": "true"
    }
  ]
}
