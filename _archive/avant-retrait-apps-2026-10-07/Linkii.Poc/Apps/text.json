{
  "id": "text",
  "name": "Texte / annonce",
  "version": "1.0.0",
  "category": "Communication",
  "icon": "📝",
  "kind": "nocode",
  "summary": "Une annonce de votre composition : titre, texte, couleurs et période de validité.",
  "description": "Aucun fichier à préparer : saisissez le message, choisissez les couleurs. En bandeau, l'annonce reste affichée en permanence. Avec une période de validité, elle apparaît et disparaît toute seule. Fonctionne sans connexion internet.",
  "placements": [
    "full",
    "top-left",
    "top-right",
    "bottom-left",
    "bottom-right",
    "top",
    "bottom"
  ],
  "validity": true,
  "settings": [
    {
      "key": "title",
      "label": "Titre",
      "type": "text",
      "maxLength": 120,
      "placeholder": "Ex. : Fermeture exceptionnelle"
    },
    {
      "key": "body",
      "label": "Texte",
      "type": "textarea",
      "required": true,
      "maxLength": 1000,
      "placeholder": "Le message à afficher…"
    },
    {
      "key": "bg",
      "label": "Couleur de fond",
      "type": "color",
      "default": "#0B1F3A"
    },
    {
      "key": "fg",
      "label": "Couleur du texte",
      "type": "color",
      "default": "#ffffff"
    },
    {
      "key": "size",
      "label": "Taille du texte",
      "type": "select",
      "default": "m",
      "options": [
        {
          "value": "s",
          "label": "Petite"
        },
        {
          "value": "m",
          "label": "Moyenne"
        },
        {
          "value": "l",
          "label": "Grande"
        },
        {
          "value": "xl",
          "label": "Très grande"
        }
      ]
    },
    {
      "key": "align",
      "label": "Alignement",
      "type": "select",
      "default": "center",
      "options": [
        {
          "value": "center",
          "label": "Centré"
        },
        {
          "value": "left",
          "label": "À gauche"
        }
      ]
    },
    {
      "key": "validFrom",
      "label": "Afficher à partir du",
      "type": "date",
      "help": "Facultatif."
    },
    {
      "key": "validTo",
      "label": "Afficher jusqu'au (inclus)",
      "type": "date",
      "help": "Facultatif."
    }
  ]
}
