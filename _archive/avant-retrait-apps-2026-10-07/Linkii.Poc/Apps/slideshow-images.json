{
  "id": "slideshow-images",
  "name": "Diaporama images",
  "version": "1.0.0",
  "category": "Médias",
  "icon": "🖼️",
  "kind": "builtin",
  "defaultOn": true,
  "summary": "Plusieurs images de la médiathèque, en fondu, dans l'ordre choisi.",
  "description": "Choisissez les images dans la médiathèque et leur ordre. Dans une boucle de plusieurs contenus, l'écran passe au suivant après la dernière image ; seul, le diaporama recommence.",
  "duration": "content",
  "placements": ["full", "top-left", "top-right", "bottom-left", "bottom-right"],
  "settings": [
    { "key": "medias", "label": "Images", "type": "medias", "accept": "image", "required": true, "maxLength": 20000 },
    { "key": "interval", "label": "Durée de chaque image (secondes)", "type": "number", "default": "8", "min": 2, "max": 600, "required": true },
    {
      "key": "fit", "label": "Cadrage", "type": "select", "default": "contain",
      "options": [
        { "value": "contain", "label": "Images entières (bandes si besoin)" },
        { "value": "cover", "label": "Remplir l'écran (rogne les bords)" }
      ]
    },
    { "key": "shuffle", "label": "Ordre aléatoire", "type": "bool", "default": "false" }
  ]
}
