@* Logo + nom du revendeur (white-label). Sans revendeur : wordmark Linkii. *@
@if (R?.LogoUrl != null)
{
    <img src="@R.LogoUrl" height="@Size" style="max-width:150px;object-fit:contain" alt="@R.DisplayName" />
    <span>@R.DisplayName</span>
}
else if (R == null || R.IsDefault)
{
    <Logo />
}
else
{
    <span class="mark">@R.DisplayName[..1].ToUpperInvariant()</span>
    <span>@R.DisplayName</span>
}

@code {
    [Parameter] public Reseller? R { get; set; }
    [Parameter] public int Size { get; set; } = 30;
}
