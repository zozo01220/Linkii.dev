@inherits LayoutComponentBase

<HeadContent>
    <style>:root { --brand: @(Brand?.BrandColor ?? "#0B1F3A"); }</style>
</HeadContent>

<div class="wz auth">
    <div class="wz-blobs"><i></i></div>
    <div class="auth-card">
        <div class="brand"><BrandMark R="Brand" Size="40" /></div>
        @Body
        @if (Brand is { ShowPoweredBy: true, IsDefault: false })
        {
            <p class="powered">Propulsé par Linkii</p>
        }
    </div>
</div>

@code {
    [CascadingParameter] private HttpContext? Http { get; set; }
    private Reseller? Brand => Http?.Items["reseller"] as Reseller;
}
