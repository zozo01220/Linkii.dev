@page "/apps/{AppId}"
@attribute [Microsoft.AspNetCore.Authorization.Authorize(Policy = "ClientSpace")]
@inject AppService Svc
@inject NavigationManager Nav

@if (app == null)
{
    <div class="empty"><div class="big">App introuvable</div><a class="btn" href="/settings?tab=applications">Retour aux applications</a></div>
}
else
{
    <div class="page-head">
        <div class="row" style="gap:16px">
            <AppIcon Id="@app.Id" />
            <div>
                <h1>@app.Name</h1>
                <p class="sub">@app.Category · version @app.Version</p>
            </div>
        </div>
        <div class="row">
            <a class="btn ghost" href="/settings?tab=applications">Retour aux applications</a>
            @if (installed) { <a class="btn" href="/playlists">Utiliser dans une playlist</a> }
            else { <button class="btn" @onclick="Install">Activer l'application</button> }
        </div>
    </div>

    <div class="card" style="max-width:720px"><AppDetailBody App="app" /></div>
}

@code {
    [Parameter] public string AppId { get; set; } = "";
    private AppManifest? app;
    private bool installed;

    protected override void OnParametersSet()
    {
        app = Svc.Find(AppId);
        installed = app != null && Svc.IsInstalled(app.Id);
    }

    private void Install()
    {
        Svc.Install(AppId);
        installed = true;   // elle apparaît maintenant dans le panneau Apps des playlists
    }
}
