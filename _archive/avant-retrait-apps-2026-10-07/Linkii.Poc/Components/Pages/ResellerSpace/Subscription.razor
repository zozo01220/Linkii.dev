@page "/reseller/subscription"
@attribute [Microsoft.AspNetCore.Authorization.Authorize(Policy = "ResellerSpace")]
@inject JsonStore Root
@inject TenantContext Ctx

<div class="page-head">
    <div>
        <h1>Abonnement</h1>
        <p class="sub">Votre forfait chez Linkii. Ce que vous facturez à vos clients reste de votre côté : Linkii ne le voit pas. Les montants et les quantités incluses seront définis plus tard.</p>
    </div>
</div>

<div class="card" style="margin-bottom:18px">
    <h3>Écrans comptés</h3>
    <p class="hint">Écrans appairés, tous clients confondus.</p>
    <div style="font-size:38px;font-weight:800">@rows.Sum(r => r.Screens)</div>
</div>

<table class="tbl">
    <thead><tr><th>Client</th><th class="num">Écrans appairés</th></tr></thead>
    <tbody>
    @foreach (var r in rows) { <tr><td>@r.Name</td><td class="num">@r.Screens</td></tr> }
    @if (rows.Count == 0) { <tr><td colspan="2">Aucun client.</td></tr> }
    </tbody>
</table>

@code {
    private record Row(string Name, int Screens);
    private List<Row> rows = new();

    protected override void OnInitialized()
    {
        var rid = Ctx.RequireResellerId();
        rows = Root.Read(d => d.Clients.Where(c => c.ResellerId == rid).OrderBy(c => c.Name)
            .Select(c => new Row(c.Name, d.Screens.Count(s => s.ClientId == c.Id && s.Token != null))).ToList());
    }
}
