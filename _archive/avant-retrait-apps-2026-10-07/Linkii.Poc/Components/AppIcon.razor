@inject AppService Svc
@* Icône d'une app : glyphe en traits fins par défaut, logo reconnaissable pour YouTube. Repli sur l'emoji du manifeste. *@
@if (Tile) { <span class="app-ico @(Small ? "sm" : "") @(Id == "youtube" ? "yt" : "")">@Glyph</span> } else { @Glyph }

@code {
    [Parameter] public string? Id { get; set; }
    [Parameter] public bool Tile { get; set; } = true;
    [Parameter] public bool Small { get; set; }
    [Parameter] public int Size { get; set; } = 24;

    private RenderFragment Glyph => b =>
    {
        if (Id == "youtube")
        {
            var w = (int)Math.Round(Size * 1.4);
            b.AddMarkupContent(0, $"<svg width=\"{w}\" height=\"{Size}\" viewBox=\"0 0 34 24\" role=\"img\" aria-label=\"YouTube\"><rect width=\"34\" height=\"24\" rx=\"6.5\" fill=\"#FF0000\"/><path d=\"M13.5 6.8v10.4L22.5 12z\" fill=\"#fff\"/></svg>");
            return;
        }
        var name = Id switch
        {
            "text" => "type", "rss" => "rss", "agenda" => "calendar", "clock" => "clock", "weather" => "sun", "weather-forecast" => "cloud", "webpage" => "globe", "menu-csv" or "menu-api" => "utensils", _ => null
        };
        if (name != null) { b.OpenComponent<Ico>(1); b.AddComponentParameter(2, nameof(Ico.Name), name); b.AddComponentParameter(3, nameof(Ico.Size), Size); b.CloseComponent(); }
        else b.AddContent(4, Svc.Find(Id)?.Icon ?? "🧩");
    };
}
